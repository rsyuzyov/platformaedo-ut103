
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	Ссылки = Новый Массив;
	Если ТипЗнч(ПараметрКоманды) = Тип("Массив") Тогда
		Для Каждого Элемент Из ПараметрКоманды Цикл
			Ссылки.Добавить(Элемент);
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(ПараметрКоманды) Тогда
		Ссылки.Добавить(ПараметрКоманды);
	КонецЕсли;
	Если Ссылки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Результаты = ПЭДО_Клиент.Доп_ОтправитьМассивПоЭДО(Ссылки);

	Отправлено = 0;
	Внимание = 0;
	Ошибок = 0;
	Детали = "";
	Для Каждого Результат Из Результаты Цикл
		Если Результат.Статус = "Отправлен" Тогда
			Отправлено = Отправлено + 1;
		ИначеЕсли Результат.Статус = "Ошибка" Тогда
			Ошибок = Ошибок + 1;
			Детали = Детали + Символы.ПС + Строка(Результат.Ссылка) + " — ошибка: " + Результат.Сообщение;
		Иначе
			Внимание = Внимание + 1;
			Детали = Детали + Символы.ПС + Строка(Результат.Ссылка) + " — " + Результат.Статус + ": " + Результат.Сообщение;
		КонецЕсли;
	КонецЦикла;

	Сообщить("Отправка по ЭДО: отправлено " + Отправлено
		+ ", требует внимания/отсеяно " + Внимание
		+ ", ошибок " + Ошибок + Детали);

КонецПроцедуры
