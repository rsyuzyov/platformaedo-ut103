#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Запросы карточки к оператору. Выполняются фоновым заданием, поэтому параметры и результат
// не зависят от формы: форма передает реквизиты структурой и сама раскладывает ответ по таблицам.
//
// Параметры:
//  Вид - Строка - "История", "ДокументыКонтрагента" или "Адреса".
//  Параметры - Структура - см. ПараметрыЗапроса.
//
// Возвращаемое значение:
//  Структура - Таблица (ТаблицаЗначений), Сообщение (Строка); у истории еще ТекущийСтатус
//  и КолонкаОбновлена.
Функция ВыполнитьЗапрос(Знач Вид, Знач Параметры) Экспорт

	Если Вид = "История" Тогда
		Возврат ИсторияОтправок(Параметры);
	ИначеЕсли Вид = "ДокументыКонтрагента" Тогда
		Возврат ДокументыКонтрагента(Параметры);
	ИначеЕсли Вид = "Адреса" Тогда
		Возврат АдресаКонтрагента(Параметры);
	КонецЕсли;

	ВызватьИсключение "Неизвестный запрос карточки ЭДО: " + Вид;

КонецФункции

// Параметры запросов карточки. Каждый запрос читает свою часть, лишние поля не мешают.
Функция ПараметрыЗапроса() Экспорт

	Возврат Новый Структура("Документ, Контрагент, ИдентификаторЭДО, ОператорЭДО, ТекущийСтатус,
		|НачалоПериода, КонецПериода");

КонецФункции

// Организация документа карточки: к оператору карточка ходит от ее учетной записи.
// Без документа - от первой учетной записи, как регламент связей: адрес и связь хранятся у контрагента.
Функция ОрганизацияКарточки(Знач Документ) Экспорт

	Если ЗначениеЗаполнено(Документ) Тогда
		Возврат ЭДО_Сервер.ОрганизацияДокумента(Документ);
	КонецЕсли;
	Если ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Возврат ЭДО_Сервер.УчетныеЗаписиЭДО()[0].Организация;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ЗначениеСвойства(Знач Объект, Знач Свойство) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Значения.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК Значения
		|ГДЕ
		|	Значения.Объект = &Объект
		|	И Значения.Свойство = &Свойство");
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Строка(Выборка.Значение));
	КонецЕсли;
	Возврат "";

КонецФункции

// Адрес ЭДО, привязанный к контрагенту в базе.
Функция ИдентификаторКонтрагента(Знач Контрагент) Экспорт

	Свойство = ЭДО_Сервер.СвойствоОбъектов("ЭДО_АдресКонтрагента");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат "";
	КонецЕсли;

	Возврат ЗначениеСвойства(Контрагент, Свойство);

КонецФункции

#КонецОбласти

#Область ИсторияОтправок

Функция ИсторияОтправок(Знач Параметры)

	// Собираем в таблицу значений, а не в реквизит формы: у ДанныеФормыКоллекция нет Сортировать.
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Создан", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("Оператор", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Тип", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Причина", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)));
	Таблица.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(30)));

	Результат = Новый Структура("Таблица, Сообщение, ТекущийСтатус, КолонкаОбновлена",
		Таблица, "", Параметры.ТекущийСтатус, Ложь);
	ДокументСсылка = Параметры.Документ;
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Результат;
	КонецЕсли;

	Организация = ОрганизацияКарточки(ДокументСсылка);
	ПредупреждениеКПП = "";

	Попытка
		Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Ложь, Организация) Тогда
			Результат.Сообщение = "Не удалось получить токен Платформы - история не загружена.";
			ЗавершитьИсторию(Результат, ДокументСсылка);
			Возврат Результат;
		КонецЕсли;
		Токен = ЭДО_Сервер.ТекущийТокен(Организация);

		Соединение = ЭДО_Сервер.СоединениеСОператором(20);

		// История ищется по всем адресам контрагента, а не только по привязанному сейчас: документ уходил
		// на адрес, привязанный тогда. Несколько recipient_id оператор принимает одним запросом.
		ТекущийАдрес = СокрЛП(Параметры.ИдентификаторЭДО);
		СписокАдресов = Новый Массив;
		Если ЗначениеЗаполнено(ТекущийАдрес) Тогда
			СписокАдресов.Добавить(ТекущийАдрес);
		КонецЕсли;
		НеполныйСписок = Ложь;

		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
		Заголовки.Вставить("accept", "application/json;charset=UTF-8");
		Реквизиты = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(ДокументСсылка.Контрагент, "ИНН, КПП");
		// Идентификаторы у оператора регистронезависимы, а в базе лежат в любом регистре.
		Для Каждого АдресКарточки Из ПривязанныеАдресаПоИНН(Реквизиты.ИНН) Цикл
			Если НЕ АдресЕстьВСписке(СписокАдресов, АдресКарточки) Тогда
				СписокАдресов.Добавить(АдресКарточки);
			КонецЕсли;
		КонецЦикла;
		Если ЗначениеЗаполнено(СокрЛП(Реквизиты.ИНН)) Тогда
			// Реестр ФНС отвечает быстро, его спрашиваем при каждом открытии; статусы связей - на закладке "Операторы".
			Попытка
				Реестр = АдресаКонтрагентаИзРеестра(Соединение, Заголовки,
					СокрЛП(Реквизиты.ИНН), СокрЛП(Реквизиты.КПП), Организация);
				ПредупреждениеКПП = ПредупреждениеОКПП(Реквизиты.КПП, Реестр);
				Если Реестр.Ошибка Тогда
					НеполныйСписок = Истина;
				Иначе
					Для Каждого АдресРеестра Из Реестр.Адреса Цикл
						Если НЕ АдресЕстьВСписке(СписокАдресов, АдресРеестра) Тогда
							СписокАдресов.Добавить(СокрЛП(АдресРеестра));
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			Исключение
				НеполныйСписок = Истина;
			КонецПопытки;
		Иначе
			НеполныйСписок = Истина;
		КонецЕсли;

		Если СписокАдресов.Количество() = 0 Тогда
			Результат.Сообщение = "У контрагента нет ни привязанного адреса ЭДО, ни адресов в реестре ФНС -"
				+ " искать в Платформе не по чему."
				+ ?(ЗначениеЗаполнено(ПредупреждениеКПП), Символы.ПС + ПредупреждениеКПП, "");
			ЗавершитьИсторию(Результат, ДокументСсылка);
			Возврат Результат;
		КонецЕсли;

		// Интервал дат обязателен (без него HTTP 400) и не шире 31 дня, поэтому период режется на окна.
		Финиш = НачалоДня(ТекущаяУниверсальнаяДата());
		// День запаса слева: дата накладной местная, а окно запроса в UTC.
		НачалоПоиска = НачалоДня(ДокументСсылка.Дата) - 86400;
		// Потолок глубины - полгода: дальше история не нужна, а каждый запрос стоит времени.
		ГраницаПоиска = Финиш - 185 * 86400;
		ПоискУсечен = Ложь;
		Если НачалоПоиска < ГраницаПоиска Тогда
			НачалоПоиска = ГраницаПоиска;
			ПоискУсечен = Истина;
		КонецЕсли;
		Окна = Новый Массив;
		НачалоОкна = НачалоПоиска;
		Пока НачалоОкна <= Финиш Цикл
			КонецОкна = НачалоОкна + 30 * 86400;
			Если КонецОкна > Финиш Тогда
				КонецОкна = Финиш;
			КонецЕсли;
			Окна.Добавить(Новый Структура("Нач, Кон", НачалоОкна, КонецОкна));
			НачалоОкна = КонецОкна + 86400;
		КонецЦикла;

		ХвостАдресов = "";
		Для Каждого АдресПоиска Из СписокАдресов Цикл
			ХвостАдресов = ХвостАдресов + "&recipient_id=" + АдресПоиска;
		КонецЦикла;

		НомерНакладной = СокрЛП(ДокументСсылка.Номер);
		ДатаНакладной = Формат(ДокументСсылка.Дата, "ДФ=dd.MM.yyyy");
		Операторы = ЭДО_Сервер.ОператорыЭДО();

		// ИННПокупателей: идентификатор карточки -> ИНН покупателя из нее, чтобы не выдать экземпляр
		// прежнего контрагента за отправку текущему.
		Контекст = Новый Структура("Токен, Организация, ИННПокупателей", Токен, Организация, Новый Соответствие);
		Обход = ПрочитатьКарточки(Соединение, Контекст, ХвостАдресов, Окна, Таблица, Операторы,
			НомерНакладной, ДатаНакладной);
		ВыборкаОборвалась = Обход.Оборвалось;
		Результат.Сообщение = Обход.Сообщение;

		// Документ мог уйти на адрес, которого нет ни у контрагента, ни в реестре ФНС. Последняя попытка -
		// сплошной обход периода без фильтра по получателю; он дороже, поэтому только когда иначе пусто.
		СплошнойОбход = Ложь;
		Если Таблица.Количество() = 0 И НЕ ВыборкаОборвалась Тогда
			ОбходСплошной = ПрочитатьКарточки(Соединение, Контекст, "", Окна, Таблица, Операторы,
				НомерНакладной, ДатаНакладной);
			ВыборкаОборвалась = ОбходСплошной.Оборвалось;
			Если ЗначениеЗаполнено(ОбходСплошной.Сообщение) Тогда
				Результат.Сообщение = ОбходСплошной.Сообщение;
			КонецЕсли;
			СплошнойОбход = (Таблица.Количество() > 0);
		КонецЕсли;

		Таблица.Сортировать("Создан Убыв");

		// Причины отказа в самой карточке нет - добираем ее из цепочки документа.
		ДополнитьПричинамиИзЦепочек(Таблица, Организация);

		// Контрагента в документе меняют и после отправки, а номер и дата те же: история находит экземпляр
		// прежнего покупателя. Покупатель экземпляра - в самой карточке, сверяем по ИНН.
		ИННКонтрагента = СокрЛП(Реквизиты.ИНН);
		Для Каждого СтрокаИстории Из Таблица Цикл
			ИННКарточки = Контекст.ИННПокупателей.Получить(СтрокаИстории.Идентификатор);
			Если ЗначениеЗаполнено(ИННКарточки) И ЗначениеЗаполнено(ИННКонтрагента)
				И ИННКарточки <> ИННКонтрагента Тогда
				СтрокаИстории.Причина = Лев("Другой покупатель (ИНН " + ИННКарточки + ")"
					+ ?(ЗначениеЗаполнено(СтрокаИстории.Причина), ": " + СтрокаИстории.Причина, ""), 500);
			КонецЕсли;
		КонецЦикла;

		Если Таблица.Количество() = 0 Тогда
			Если НЕ ВыборкаОборвалась Тогда
				Результат.Сообщение = "В Платформе по этой накладной отправок не найдено - искали и по адресам"
					+ " контрагента (" + СписокАдресов.Количество() + "), и сплошным обходом периода."
					+ ?(НеполныйСписок, " Реестр ФНС не ответил, список адресов может быть неполным.", "")
					+ ?(ПоискУсечен, " Искали за последние полгода: документ старше.", "");
			КонецЕсли;
		Иначе
			ОписатьПоследнююОтправку(Результат, ДокументСсылка, Контекст, ТекущийАдрес, Параметры.ОператорЭДО,
				ИННКонтрагента, СплошнойОбход);
		КонецЕсли;

	Исключение
		Результат.Сообщение = "Ошибка обращения к Платформе: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Если ЗначениеЗаполнено(ПредупреждениеКПП) Тогда
		Результат.Сообщение = ПредупреждениеКПП
			+ ?(ЗначениеЗаполнено(Результат.Сообщение), Символы.ПС + Результат.Сообщение, "");
	КонецЕсли;
	ЗавершитьИсторию(Результат, ДокументСсылка);

	Возврат Результат;

КонецФункции

// Статус в шапке, сообщение о последней отправке и свежий статус в колонке "ЭДО".
Процедура ОписатьПоследнююОтправку(Результат, Знач ДокументСсылка, Знач Контекст, Знач ТекущийАдрес,
	Знач ОператорЭДО, Знач ИННКонтрагента, Знач СплошнойОбход)

	Таблица = Результат.Таблица;

	// Актуальный экземпляр выбирается по тому же правилу, что в регламенте сверки статусов.
	Последняя = Таблица[0];
	Для Каждого СтрокаИстории Из Таблица Цикл
		Если ЭДО_Регламенты.ЭкземплярАктуальнее(СтрокаИстории.Статус, СтрокаИстории.Создан,
			Последняя.Статус, Последняя.Создан) Тогда
			Последняя = СтрокаИстории;
		КонецЕсли;
	КонецЦикла;
	ИННПоследней = Контекст.ИННПокупателей.Получить(Последняя.Идентификатор);
	ДругойПокупатель = ЗначениеЗаполнено(ИННПоследней) И ЗначениеЗаполнено(ИННКонтрагента)
		И ИННПоследней <> ИННКонтрагента;

	// Хвост статуса пересобираем, а не дописываем: история перечитывается при каждом обновлении формы.
	ТекущийСтатус = Результат.ТекущийСтатус;
	ПозицияХвоста = Найти(ТекущийСтатус, "  ·  в Платформе: ");
	Если ПозицияХвоста > 0 Тогда
		ТекущийСтатус = Лев(ТекущийСтатус, ПозицияХвоста - 1);
	КонецЕсли;
	Результат.ТекущийСтатус = ТекущийСтатус + "  ·  в Платформе: " + Последняя.Статус
		+ " от " + Формат(Последняя.Создан, "ДФ=dd.MM.yyyy HH:mm")
		+ ?(ДругойПокупатель, " другому покупателю", "")
		+ ?(Таблица.Количество() > 1, "  (отправок: " + Таблица.Количество() + ")", "");

	Сообщение = Последняя.Причина;
	Если СплошнойОбход Тогда
		Сообщение = "Отправка найдена сплошным обходом: ее получателя нет ни у контрагента"
			+ " сейчас, ни в реестре ФНС."
			+ ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");
	КонецЕсли;
	// Сказать прямо, что документ ушел не на тот адрес, что привязан сейчас.
	Если ЗначениеЗаполнено(ТекущийАдрес)
		И ЗначениеЗаполнено(Последняя.Адрес)
		И ВРег(Последняя.Адрес) <> ВРег(ТекущийАдрес) Тогда
		Сообщение = "Последняя отправка ушла на другой адрес: " + Последняя.Оператор
			+ " (" + Последняя.Адрес + "). Сейчас у контрагента привязан " + ОператорЭДО + "."
			+ ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");
	КонецЕсли;

	// Колонку "ЭДО" ведет регламент, и она отстает от оператора. Раз карточка спросила его вживую,
	// свежий статус пишем в колонку сразу. Статус экземпляра другого покупателя в колонку не пишем.
	ОбновленнаяКолонка = "";
	Если ДругойПокупатель Тогда
		Сообщение = "Контрагента в документе сменили после отправки: последний экземпляр ушел"
			+ " покупателю с ИНН " + ИННПоследней + ", а в документе сейчас «"
			+ Строка(ДокументСсылка.Контрагент) + "» (ИНН " + ИННКонтрагента + ")."
			+ " Статус «" + Последняя.Статус + "» относится к тому экземпляру;"
			+ " текущему контрагенту документ не отправлялся."
			+ ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");
	Иначе
		ОбновленнаяКолонка = ЗаписатьСтатусПлатформыВКолонку(ДокументСсылка, Последняя.Статус, Сообщение,
			Последняя.Идентификатор);
	КонецЕсли;
	Если ЗначениеЗаполнено(ОбновленнаяКолонка) Тогда
		Сообщение = "Колонка «ЭДО» обновлена: " + ОбновленнаяКолонка
			+ ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");
		Результат.КолонкаОбновлена = Истина;
	КонецЕсли;

	Результат.Сообщение = Сообщение;

КонецПроцедуры

// Единственный выход истории: у заполнения три точки возврата, и строка СБИС должна
// появляться во всех - в том числе когда Платформа вообще не ответила.
Процедура ЗавершитьИсторию(Результат, Знач ДокументСсылка)

	Если ДобавитьОтправкуСБИС(Результат.Таблица, ДокументСсылка) Тогда
		Результат.Сообщение = "Была отправка через СБИС (старая интеграция): в Платформе её нет по устройству,"
			+ " показана отдельной строкой и без времени отправки."
			+ ?(ЗначениеЗаполнено(Результат.Сообщение), Символы.ПС + Результат.Сообщение, "");
	КонецЕсли;

	Результат.Таблица.Сортировать("Создан Убыв");

КонецПроцедуры

Функция ДобавитьОтправкуСБИС(Таблица, Знач ДокументСсылка)

	// Отправок старой интеграции со СБИС у оператора нет, след остается только в свойствах документа.
	// Без этой строки документ, отправленный до перехода, выглядит неотправленным.
	СтатусСБИС = "";
	ИдСБИС = "";
	Попытка
		СвойствоСтатусаСБИС = ЭДО_Сервер.СвойствоОбъектов("ДокументСБИС_Статус");
		Если СвойствоСтатусаСБИС <> Неопределено И НЕ СвойствоСтатусаСБИС.Пустая() Тогда
			СтатусСБИС = СокрЛП(ЗначениеСвойства(ДокументСсылка, СвойствоСтатусаСБИС));
		КонецЕсли;
		СвойствоИдаСБИС = ЭДО_Сервер.СвойствоОбъектов("ДокументСБИС_Ид");
		Если СвойствоИдаСБИС <> Неопределено И НЕ СвойствоИдаСБИС.Пустая() Тогда
			ИдСБИС = СокрЛП(ЗначениеСвойства(ДокументСсылка, СвойствоИдаСБИС));
		КонецЕсли;
	Исключение
		// История у оператора важнее: остаемся без строки СБИС, но карточку не роняем.
		Возврат Ложь;
	КонецПопытки;

	Если НЕ ЗначениеЗаполнено(СтатусСБИС) И НЕ ЗначениеЗаполнено(ИдСБИС) Тогда
		Возврат Ложь;
	КонецЕсли;

	СтрокаСБИС = Таблица.Добавить();
	// Времени отправки в базе нет (UUID в ДокументСБИС_Ид дает время создания документа), поэтому
	// ставим дату документа и говорим об этом прямо.
	СтрокаСБИС.Создан = НачалоДня(ДокументСсылка.Дата);
	СтрокаСБИС.Оператор = "СБИС";
	// Статусы СБИС - свободный текст: в колонку идет короткая часть, целиком - в причину.
	СтрокаСБИС.Статус = ?(ВРег(Лев(СтатусСБИС, 6)) = "ОШИБКА", "Ошибка", Лев(СтатусСБИС, 50));
	СтрокаСБИС.Тип = "старая интеграция";
	СтрокаСБИС.Причина = "Отправка через СБИС. Время отправки в базе не хранится - показана дата"
		+ " документа."
		+ ?(ЗначениеЗаполнено(СтатусСБИС), " Статус СБИС: " + СтатусСБИС + ".", "")
		+ ?(ЗначениеЗаполнено(ИдСБИС), " Ид СБИС: " + ИдСБИС + ".", "");
	// Идентификатор пустой намеренно: по нему кнопки XML, печатной формы и сайта ходят к оператору,
	// а карточки СБИС там нет.

	Возврат Истина;

КонецФункции

Функция ПрочитатьКарточки(Соединение, Контекст, Знач ХвостАдресов, Знач Окна, Таблица, Знач Операторы,
	Знач НомерНакладной, Знач ДатаНакладной)

	// Обходит период окнами и страницами, добирая в Таблицу карточки этой накладной.
	// Токен живет в Контексте: при 401 он перевыпускается здесь, и новый нужен вызывающему.
	Итог = Новый Структура("Оборвалось, Сообщение", Ложь, "");
	РазмерСтраницы = 100;
	ГидОрганизации = ЭДО_Сервер.ГидОрганизации(Контекст.Организация);

	Для Каждого ОкноПериода Из Окна Цикл
		ОтДата = Формат(ОкноПериода.Нач, "ДФ=yyyy-MM-dd") + "T00:00:00.000Z";
		ДоДата = Формат(ОкноПериода.Кон, "ДФ=yyyy-MM-dd") + "T23:59:59.000Z";

		// Общего числа карточек оператор не сообщает - листаем, пока страница полная.
		Для НомерСтраницы = 0 По 9 Цикл
			Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/documents?created_from=" + ОтДата
				+ "&created_till=" + ДоДата
				+ "&sender_id=" + ГидОрганизации
				+ ХвостАдресов
				+ "&page=" + НомерСтраницы + "&page_size=" + РазмерСтраницы;

			Карточки = Неопределено;
			БылоНеПринятиеТокена = Ложь;
			// При авариях оператора часть запросов виснет по таймауту - три попытки.
			Для НомерПопытки = 1 По 3 Цикл
				ЗапросПлатформы = Новый HTTPЗапрос(Путь);
				ЗапросПлатформы.Заголовки.Вставить("Authorization", "Bearer " + Контекст.Токен);
				ЗапросПлатформы.Заголовки.Вставить("accept", "application/json;charset=UTF-8");
				Попытка
					ОтветПлатформы = Соединение.Получить(ЗапросПлатформы);
				Исключение
					Продолжить;
				КонецПопытки;
				Если ОтветПлатформы.КодСостояния = 401 Тогда
					// ОбеспечитьТокен(Ложь) проверяет только наличие токена, 401 лечится перевыпуском.
					// Не помог и перевыпуск - сообщаем об этом, а не о таймауте.
					БылоНеПринятиеТокена = Истина;
					ЭДО_Сервер.ОбеспечитьТокен(Истина, Контекст.Организация);
					Контекст.Токен = ЭДО_Сервер.ТекущийТокен(Контекст.Организация);
					Продолжить;
				КонецЕсли;
				БылоНеПринятиеТокена = Ложь;
				Если ОтветПлатформы.КодСостояния <> 200 Тогда
					Итог.Сообщение = "Платформа ответила HTTP " + ОтветПлатформы.КодСостояния + ": "
						+ Лев(ОтветПлатформы.ПолучитьТелоКакСтроку("UTF-8"), 200);
					Итог.Оборвалось = Истина;
					Прервать;
				КонецЕсли;
				ЧтениеОтвета = Новый ЧтениеJSON;
				ЧтениеОтвета.УстановитьСтроку(ОтветПлатформы.ПолучитьТелоКакСтроку("UTF-8"));
				Карточки = ПрочитатьJSON(ЧтениеОтвета, Ложь);
				ЧтениеОтвета.Закрыть();
				Прервать;
			КонецЦикла;

			Если Итог.Оборвалось Тогда
				Прервать;
			КонецЕсли;
			Если Карточки = Неопределено Тогда
				Если БылоНеПринятиеТокена Тогда
					Итог.Сообщение = "Платформа не приняла токен (HTTP 401), и перевыпустить его не удалось."
						+ " История не загружена - проверьте подпись и настройки ЭДО.";
				Иначе
					Итог.Сообщение = "Платформа не отвечает (таймаут). Нажмите «Обновить»;"
						+ " статус в шапке взят из базы.";
				КонецЕсли;
				Итог.Оборвалось = Истина;
				Прервать;
			КонецЕсли;

			Для Каждого Карточка Из Карточки Цикл
				ДобавитьКарточкуНакладной(Карточка, Контекст, Таблица, Операторы, НомерНакладной, ДатаНакладной);
			КонецЦикла;

			Если Карточки.Количество() < РазмерСтраницы Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если Итог.Оборвалось Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

Процедура ДобавитьКарточкуНакладной(Знач Карточка, Контекст, Таблица, Знач Операторы,
	Знач НомерНакладной, Знач ДатаНакладной)

	Если НЕ Карточка.Свойство("invoice") ИЛИ Карточка["invoice"] = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Счет = Карточка["invoice"];
	НомерКарточки = ?(Счет.Свойство("num"), СокрЛП(Строка(Счет["num"])), "");
	ДатаКарточки = ?(Счет.Свойство("date"), СокрЛП(Строка(Счет["date"])), "");
	// Ключ - номер и дата: номер накладной повторяется по годам.
	Если НомерКарточки <> НомерНакладной ИЛИ ДатаКарточки <> ДатаНакладной Тогда
		Возврат;
	КонецЕсли;

	// Адрес получателя карточки - ответ "куда ушел документ"; оператор опознается по первым трем символам.
	АдресПолучателя = "";
	Если Карточка.Свойство("recipient") И Карточка["recipient"] <> Неопределено
		И Карточка["recipient"].Свойство("id") Тогда
		АдресПолучателя = СокрЛП(Строка(Карточка["recipient"]["id"]));
	КонецЕсли;
	// Ид приходит числом: Строка() вставила бы разделители групп, и запрос по нему получил бы HTTP 400.
	ИдентификаторКарточки = ?(Карточка.Свойство("id"), Формат(Карточка["id"], "ЧГ=0"), "");
	// При сплошном обходе та же карточка может прийти повторно - не задваиваем.
	Если ЗначениеЗаполнено(ИдентификаторКарточки)
		И Таблица.НайтиСтроки(Новый Структура("Идентификатор", ИдентификаторКарточки)).Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ИдентификаторКарточки)
		И Счет.Свойство("buyer") И Счет["buyer"] <> Неопределено
		И Счет["buyer"].Свойство("inn") Тогда
		Контекст.ИННПокупателей.Вставить(ИдентификаторКарточки, СокрЛП(Строка(Счет["buyer"]["inn"])));
	КонецЕсли;

	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Идентификатор = ИдентификаторКарточки;
	// ЩА 15.10.2026 [yan]: итоговое состояние экземпляра (newStatus): у аннулированного status
	// остается ACCEPTED, и карточка показала бы подписанный документ и вернула бы его в колонку.
	НоваяСтрока.Статус = ЭДО_Сервер.СтатусКарточкиОператора(Карточка);
	НоваяСтрока.Тип = ?(Карточка.Свойство("type"), Строка(Карточка["type"]), "");
	НоваяСтрока.Создан = ДатаИзISO(?(Карточка.Свойство("created"), Строка(Карточка["created"]), ""));
	НоваяСтрока.Причина = ЭДО_Сервер.ПричинаКарточкиОператора(Карточка);
	НоваяСтрока.Адрес = АдресПолучателя;
	НоваяСтрока.Оператор = ЭДО_Сервер.ИмяОператораЭДО(АдресПолучателя, Операторы);

КонецПроцедуры

Функция ДатаИзISO(Знач Текст)

	// Оператор отдает UTC вида 2026-08-21T07:11:36.448710Z, показываем местное время.
	Если СтрДлина(Текст) < 19 Тогда
		Возврат '00010101';
	КонецЕсли;
	Попытка
		ДатаUTC = Дата(Число(Сред(Текст, 1, 4)), Число(Сред(Текст, 6, 2)), Число(Сред(Текст, 9, 2)),
			Число(Сред(Текст, 12, 2)), Число(Сред(Текст, 15, 2)), Число(Сред(Текст, 18, 2)));
	Исключение
		Возврат '00010101';
	КонецПопытки;
	Возврат МестноеВремя(ДатаUTC);

КонецФункции

Процедура ДополнитьПричинамиИзЦепочек(Таблица, Знач Организация)

	// Причины отказа в карточке документа нет - она лежит в цепочке (document-flows).
	// Чтение цепочек в ядре, им же пользуется разбор центра управления.
	Идентификаторы = Новый Массив;
	Для Каждого СтрокаИстории Из Таблица Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаИстории.Причина)
			И ЗначениеЗаполнено(СтрокаИстории.Идентификатор) Тогда
			Идентификаторы.Добавить(СтрокаИстории.Идентификатор);
		КонецЕсли;
	КонецЦикла;

	// ЩА 15.10.2026 [yan]: с организацией документа - в базе с несколькими учетными записями без нее
	// токен не выбрать, и история падала «организация для операции не указана».
	Причины = ЭДО_Сервер.ПричиныОтказаПоИдентификаторам(Идентификаторы, Организация);
	Для Каждого СтрокаИстории Из Таблица Цикл
		ТекстПричины = Причины.Получить(СтрокаИстории.Идентификатор);
		Если ЗначениеЗаполнено(ТекстПричины) Тогда
			СтрокаИстории.Причина = ТекстПричины;
		КонецЕсли;
		// ЩА 15.10.2026 [yan]: отказ фиксации - причины в цепочке оператора нет, она из Честного знака.
		// Общий текст оператора («Document processing was failed») - тоже повод спросить ЧЗ (ревью Codex 694);
		// ответ ЧЗ заменяет его, только если причина пришла.
		Если ВРег(СтрокаИстории.Статус) = "FIXATION_FAILED"
			И (НЕ ЗначениеЗаполнено(СтрокаИстории.Причина)
				ИЛИ СтрНайти(СтрокаИстории.Причина, "Document processing was failed") > 0) Тогда
			Попытка
				ПричинаЧЗ = ЭДО_Сервер.ПричинаОтказаФиксацииЧЗ(СтрокаИстории.Идентификатор, Организация);
				Если ЗначениеЗаполнено(ПричинаЧЗ.Текст) Тогда
					СтрокаИстории.Причина = ПричинаЧЗ.Текст;
				КонецЕсли;
			Исключение
				Если НЕ ЗначениеЗаполнено(СтрокаИстории.Причина) Тогда
					СтрокаИстории.Причина = "Причину из Честного знака получить не удалось: "
						+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				КонецЕсли;
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращает записанный текст или пустую строку, если менять нечего.
Функция ЗаписатьСтатусПлатформыВКолонку(Знач ДокументСсылка, Знач СтатусПлатформы, Сообщение, Знач ИдЭкземпляра = "")

	// Карта статусов общая с регламентом сверки: он узнает свои значения точным сравнением,
	// и расхождение копий выключило бы строку из его ведения.
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) ИЛИ НЕ ЗначениеЗаполнено(СтатусПлатформы) Тогда
		Возврат "";
	КонецЕсли;

	КартаСтатусов = ЭДО_Регламенты.КартаСтатусовПлатформы();

	НовыйТекст = КартаСтатусов.Получить(ВРег(СокрЛП(СтатусПлатформы)));
	Если НовыйТекст = Неопределено Тогда
		// Незнакомый статус показываем как есть, как и регламент.
		НовыйТекст = СокрЛП(СтатусПлатформы);
	КонецЕсли;
	// Ресурс "Значение" регистра - Строка(50), длинное режется молча.
	НовыйТекст = Лев(НовыйТекст, 50);
	// Открытый запрос контрагента на аннулирование важнее статуса карточки - как у регламента.
	НовыйТекст = ЭДО_Сервер.ТекстКолонкиСУчетомЗапросаАннулирования(ДокументСсылка, НовыйТекст, , , ИдЭкземпляра);

	СвойствоСтатуса = ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние");
	Если СвойствоСтатуса = Неопределено ИЛИ СвойствоСтатуса.Пустая() Тогда
		Возврат "";
	КонецЕсли;

	ТекущийТекст = "";
	НаборСтатуса = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	НаборСтатуса.Отбор.Объект.Установить(ДокументСсылка);
	НаборСтатуса.Отбор.Свойство.Установить(СвойствоСтатуса);
	НаборСтатуса.Прочитать();
	Для Каждого ЗаписьСтатуса Из НаборСтатуса Цикл
		ТекущийТекст = СокрЛП(Строка(ЗаписьСтатуса.Значение));
	КонецЦикла;

	Если ТекущийТекст = НовыйТекст Тогда
		Возврат "";
	КонецЕсли;

	// "Отправка не требуется" не трогаем никогда: по этому тексту документ исключается из очереди.
	Если ТекущийТекст = ЭДО_Сервер.ТекстСтатусаОтправкаНеТребуется() Тогда
		Возврат "";
	КонецЕсли;

	// Открытие карточки пишет в регистр, а открывают ее и пользователи без прав на запись:
	// ошибку показываем в сообщении, но карточку не роняем.
	Попытка
		ЭДО_Сервер.ЗаписатьЧитаемыйСтатус(ДокументСсылка, НовыйТекст);
	Исключение
		Сообщение = "Колонка «ЭДО» не обновлена: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");
		Возврат "";
	КонецПопытки;

	Возврат НовыйТекст;

КонецФункции

#КонецОбласти

#Область ДокументыКонтрагента

// Документы контрагента за период; куда каждый ушел - по карточке у оператора.
Функция ДокументыКонтрагента(Знач Параметры)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Документ");
	Таблица.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Оператор", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Результат = Новый Структура("Таблица, Сообщение", Таблица, "");

	Если НЕ ЗначениеЗаполнено(Параметры.Контрагент) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Данные = ЭДО_Витрина.ДокументыКонтрагентаСМаршрутом(Параметры.Контрагент,
			НачалоДня(Параметры.НачалоПериода), КонецДня(Параметры.КонецПериода));
	Исключение
		Результат.Сообщение = "Документы контрагента не собраны: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Для Каждого СтрокаДанных Из Данные.Документы Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Документ = СтрокаДанных.Документ;
		НоваяСтрока.Статус = СтрокаДанных.Состояние;
		НоваяСтрока.Адрес = СтрокаДанных.Адрес;
		НоваяСтрока.Оператор = СтрокаДанных.Оператор;
		Если ЗначениеЗаполнено(СтрокаДанных.ИдОператора) И НЕ ЗначениеЗаполнено(СтрокаДанных.Адрес) Тогда
			НоваяСтрока.Оператор = "оператор не ответил";
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(Данные.Ошибка) Тогда
		Результат.Сообщение = "Документы контрагента: " + Данные.Ошибка + ".";
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область АдресаКонтрагента

// Адреса контрагента из реестра ФНС со статусами связей.
Функция АдресаКонтрагента(Знач Параметры)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Текущий", Новый ОписаниеТипов("Булево"));   // ЩА 15.10.2026 [yan]: галочка, а не «да»
	Таблица.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Оператор", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Связь", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(30)));
	Таблица.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));
	Результат = Новый Структура("Таблица, Сообщение", Таблица, "");

	Контрагент = Параметры.Контрагент;
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Результат.Сообщение = "Контрагент не определён.";
		Возврат Результат;
	КонецЕсли;

	Реквизиты = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(Контрагент, "ИНН, КПП");
	ИНН = СокрЛП(Реквизиты.ИНН);
	Если НЕ ЗначениеЗаполнено(ИНН) Тогда
		Результат.Сообщение = "У контрагента не заполнен ИНН - искать в реестре не по чему.";
		Возврат Результат;
	КонецЕсли;

	Организация = ОрганизацияКарточки(Параметры.Документ);
	Дополнение = "";
	Попытка
		Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Ложь, Организация) Тогда
			Результат.Сообщение = "Не удалось получить токен Платформы.";
			Возврат Результат;
		КонецЕсли;

		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
		Заголовки.Вставить("accept", "application/json;charset=UTF-8");
		Соединение = ЭДО_Сервер.СоединениеСОператором(20);

		Реестр = АдресаКонтрагентаИзРеестра(Соединение, Заголовки, ИНН, СокрЛП(Реквизиты.КПП), Организация);
		Если Реестр.Ошибка Тогда
			Дополнение = "Реестр ФНС не ответил - список может быть неполным.";
		КонецЕсли;
		ПредупреждениеКПП = ПредупреждениеОКПП(Реквизиты.КПП, Реестр);
		Если ЗначениеЗаполнено(ПредупреждениеКПП) Тогда
			Дополнение = СокрЛП(Дополнение + " " + ПредупреждениеКПП);
		КонецЕсли;

		ГидОрганизации = ЭДО_Сервер.ГидОрганизации(Организация);
		Связи = Новый Соответствие;
		Если Реестр.Адреса.Количество() > 0 Тогда
			Попытка
				Связи = ЭДО_Сервер.СтатусыСвязейЭДО(Соединение, Заголовки, ГидОрганизации, Реестр.Адреса);
			Исключение
				Дополнение = СокрЛП(Дополнение + " Статусы связей получить не удалось.");
			КонецПопытки;
		КонецЕсли;

		Текущий = ИдентификаторКонтрагента(Контрагент);
		Операторы = ЭДО_Сервер.ОператорыЭДО();
		Для Каждого Адрес Из Реестр.Адреса Цикл
			НоваяСтрока = Таблица.Добавить();
			НоваяСтрока.Адрес = Адрес;
			НоваяСтрока.Оператор = ЭДО_Сервер.ИмяОператораЭДО(Адрес, Операторы);
			НоваяСтрока.Текущий = (ВРег(СокрЛП(Адрес)) = ВРег(СокрЛП(Текущий)));
			Связь = ЭДО_Сервер.СостояниеСвязи(Связи, Адрес);
			// Нет записи - не значит "связи нет": у пары абонентов одного оператора роуминговой записи
			// не бывает, слать можно, а приглашение не нужно.
			Если Связь <> Неопределено Тогда
				НоваяСтрока.Связь = Строка(Связь.Статус);
			ИначеЕсли АдресВнутриНашегоОператора(Адрес, ГидОрганизации) Тогда
				НоваяСтрока.Связь = "внутри Платформы, приглашение не нужно";
			Иначе
				НоваяСтрока.Связь = "нет связи";
			КонецЕсли;
		КонецЦикла;

		// Адрес, привязанный в базе, мог не попасть в реестр - показываем его отдельной строкой.
		Если ЗначениеЗаполнено(Текущий) И НЕ АдресЕстьВСписке(Таблица.ВыгрузитьКолонку("Адрес"), Текущий) Тогда
			НоваяСтрока = Таблица.Добавить();
			НоваяСтрока.Адрес = Текущий;
			НоваяСтрока.Оператор = ЭДО_Сервер.ИмяОператораЭДО(Текущий, Операторы);
			НоваяСтрока.Текущий = Истина;
			НоваяСтрока.Связь = ?(АдресВнутриНашегоОператора(Текущий, ГидОрганизации),
				"внутри Платформы, приглашение не нужно", "нет связи");
			НоваяСтрока.Наименование = "привязан в базе, в реестре по ИНН/КПП не найден";
		КонецЕсли;

	Исключение
		Таблица.Очистить();
		Результат.Сообщение = "Ошибка обращения к Платформе: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Таблица.Сортировать("Текущий Убыв, Оператор Возр");

	Если Таблица.Количество() = 0 Тогда
		Результат.Сообщение = СокрЛП("В реестре ФНС по ИНН " + ИНН + " адресов не нашлось. " + Дополнение);
	Иначе
		Результат.Сообщение = СокрЛП("Адресов найдено: " + Таблица.Количество() + ". " + Дополнение);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Адрес у того же оператора, что и мы. Роуминговой связи для такой пары не бывает,
// обмен идет напрямую, а приглашение туда бесполезно и на живой связи опасно.
Функция АдресВнутриНашегоОператора(Знач Адрес, Знач ГидОрганизации)

	Проверяемый = ВРег(СокрЛП(Адрес));
	НашГид = ВРег(СокрЛП(Строка(ГидОрганизации)));
	Если СтрДлина(Проверяемый) < 3 ИЛИ СтрДлина(НашГид) < 3 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Лев(Проверяемый, 3) = Лев(НашГид, 3);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АдресаКонтрагентаИзРеестра(Соединение, Заголовки, Знач ИНН, Знач КПП, Знач Организация)

	// Пустой ответ реестра не значит "адресов нет": так же он отвечает на протухший токен. На пустой
	// ответ перевыпускаем токен и спрашиваем еще раз, теперь со сверкой КПП по ЕГРЮЛ.
	Реестр = ЭДО_Сервер.АдресаИзРеестраФНС(Соединение, Заголовки, ИНН, КПП);
	Если Реестр.Ошибка ИЛИ Реестр.Адреса.Количество() = 0 Тогда
		Если ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация) Тогда
			Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
		КонецЕсли;
		Реестр = ЭДО_Сервер.АдресаИзРеестраФНС(Соединение, Заголовки, ИНН, КПП, ЭДО_Сервер.НоваяСверкаЕГРЮЛ(1));
	КонецЕсли;
	Возврат Реестр;

КонецФункции

Функция ПредупреждениеОКПП(Знач КПП, Знач Реестр)

	Если НЕ ЗначениеЗаполнено(Реестр.КППЕГРЮЛ) ИЛИ Реестр.КППЕГРЮЛ = СокрЛП(КПП) Тогда
		Возврат "";
	КонецЕсли;

	// У обособленного подразделения код причины постановки на учет (5 и 6 разряды КПП) не равен 01,
	// а в ЕГРЮЛ стоит КПП головной организации. Расхождение тут законно, править карточку не надо.
	КППКарточки = СокрЛП(КПП);
	Если СтрДлина(КППКарточки) = 9 И Сред(КППКарточки, 5, 2) <> "01" Тогда
		Возврат "КПП в карточке контрагента (" + КППКарточки + ") - это КПП обособленного подразделения,"
			+ " в ЕГРЮЛ у головной организации " + Реестр.КППЕГРЮЛ + ": адреса ЭДО искали по головному.";
	КонецЕсли;

	Возврат "КПП в карточке контрагента (" + КППКарточки + ") не совпадает с ЕГРЮЛ (" + Реестр.КППЕГРЮЛ + "):"
		+ " адреса ЭДО искали по КПП из ЕГРЮЛ. Исправьте КПП в карточке контрагента, иначе устаревший"
		+ " уйдет покупателем в УПД.";

КонецФункции

Функция АдресЕстьВСписке(Знач Список, Знач Адрес)

	Искомый = ВРег(СокрЛП(Адрес));
	Для Каждого АдресСписка Из Список Цикл
		Если ВРег(СокрЛП(АдресСписка)) = Искомый Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ПривязанныеАдресаПоИНН(Знач ИНН)

	// У одного ИНН бывает несколько карточек контрагента с разными адресами, а адрес, привязанный
	// руками, в реестре ФНС может не значиться.
	Адреса = Новый Массив;
	Свойство = ЭДО_Сервер.СвойствоОбъектов("ЭДО_АдресКонтрагента");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() ИЛИ НЕ ЗначениеЗаполнено(ИНН) Тогда
		Возврат Адреса;
	КонецЕсли;

	// Два запроса вместо соединения: измерение "Объект" составное.
	ЗапросКонтрагентов = Новый Запрос(
		"ВЫБРАТЬ Контрагенты.Ссылка КАК Ссылка
		|ИЗ Справочник.Контрагенты КАК Контрагенты
		|ГДЕ Контрагенты.ИНН = &ИНН");
	ЗапросКонтрагентов.УстановитьПараметр("ИНН", СокрЛП(ИНН));
	СписокКонтрагентов = ЗапросКонтрагентов.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Если СписокКонтрагентов.Количество() = 0 Тогда
		Возврат Адреса;
	КонецЕсли;

	ЗапросЗначений = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ Значения.Значение КАК Значение
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов КАК Значения
		|ГДЕ Значения.Объект В (&Список) И Значения.Свойство = &Свойство");
	ЗапросЗначений.УстановитьПараметр("Список", СписокКонтрагентов);
	ЗапросЗначений.УстановитьПараметр("Свойство", Свойство);
	Выборка = ЗапросЗначений.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗначениеАдреса = СокрЛП(Строка(Выборка.Значение));
		Если ЗначениеЗаполнено(ЗначениеАдреса) И Адреса.Найти(ЗначениеАдреса) = Неопределено Тогда
			Адреса.Добавить(ЗначениеАдреса);
		КонецЕсли;
	КонецЦикла;

	Возврат Адреса;

КонецФункции

#КонецОбласти

#КонецЕсли
