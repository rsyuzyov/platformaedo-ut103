// ЩА 20.10.2026 [yan]: карточка входящего документа ЭДО (Центр управления -> Входящие -> двойной щелчок).
// Просмотр документа, печатная форма оператора, ход документа и ответы человека: подписать, отказать,
// запросить уточнение, предложить аннулирование, создать или привязать поступление. Каждое действие
// с подписью - только после подтверждения пользователя.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры,
		"Ид, Организация, Вид, Номер, Дата, Продавец, ИННПродавца, ГидПродавца, Статус, Версия, ЭтоУКД, ФункцияДокумента, Документ");
	Если НЕ ЗначениеЗаполнено(Ид) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Вид) Тогда
		Вид = ЭДО_Сервер.ВидВходящегоДокумента(ФункцияДокумента, ЭтоУКД);
	КонецЕсли;
	Заголовок = Вид + " № " + Номер + " от " + Формат(Дата, "ДФ=dd.MM.yyyy") + " - " + Продавец;
	Просмотр = "<html><body style=""font-family:Arial;color:#555;padding:20px"">Загружаю документ…</body></html>";
	ОбновитьСостояние();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Документ и ход читаются у оператора после открытия: форма появляется сразу, даже если оператор медлит.
	ПодключитьОбработчикОжидания("ЗагрузитьИзПлатформы", 0.1, Истина);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьВыполнить(Команда)
	ЗагрузитьИзПлатформы();
КонецПроцедуры

&НаКлиенте
Процедура ПечатнаяФормаВыполнить(Команда)

	Состояние("Входящий документ", , "Запрашиваю печатную форму у оператора…");
	Ответ = ПечатнаяФормаНаСервере();
	Состояние();
	Если НЕ Ответ.Успех Тогда
		ПоказатьПредупреждение(, Ответ.Текст);
		Возврат;
	КонецЕсли;
	// Перехват обоснован: файл получен, а открыть его не дала рабочая станция (нет программы для PDF и т.п.) -
	// говорим пользователю, где он лежит.
	ИмяФайла = КаталогВременныхФайлов() + "ЭДО_" + Вид + "_" + СтрЗаменить(СтрЗаменить(Номер, "/", "-"), "\", "-") + "_" + Ид + ".pdf";
	Попытка
		ПолучитьИзВременногоХранилища(Ответ.Адрес).Записать(ИмяФайла);
		ЗапуститьПриложение(ИмяФайла);
	Исключение
		ПоказатьПредупреждение(, "Печатная форма получена, но не открылась: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ Символы.ПС + "Файл: " + ИмяФайла);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПодписатьВыполнить(Команда)
	ПоказатьВопрос(Новый ОписаниеОповещения("ПодписатьЗавершение", ЭтотОбъект),
		"Подписать " + Вид + " № " + Номер + " от " + Продавец + " подписью " + Организация + "?",
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьЗавершение(Ответ, Параметр) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Состояние("Входящий документ", , "Подписываю…");
	ПоказатьИтог(ПодписатьНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура ОтказатьВПодписиВыполнить(Команда)
	ПоказатьВводСтроки(Новый ОписаниеОповещения("ОтказатьВПодписиЗавершение", ЭтотОбъект), "",
		"Причина отказа в подписи (её прочитает продавец)", 500, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОтказатьВПодписиЗавершение(Причина, Параметр) Экспорт
	Если НЕ ЗначениеЗаполнено(Причина) Тогда
		Возврат;
	КонецЕсли;
	Состояние("Входящий документ", , "Отправляю отказ…");
	ПоказатьИтог(ОтказатьНаСервере(Причина));
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьУточнениеВыполнить(Команда)
	ПоказатьВводСтроки(Новый ОписаниеОповещения("ЗапроситьУточнениеЗавершение", ЭтотОбъект), "",
		"Что нужно уточнить или исправить (текст прочитает продавец)", 1000, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьУточнениеЗавершение(ТекстУточнения, Параметр) Экспорт
	Если НЕ ЗначениеЗаполнено(ТекстУточнения) Тогда
		Возврат;
	КонецЕсли;
	Состояние("Входящий документ", , "Отправляю запрос уточнения…");
	ПоказатьИтог(УточнениеНаСервере(ТекстУточнения));
КонецПроцедуры

&НаКлиенте
Процедура АннулироватьВыполнить(Команда)
	Причины = Новый СписокЗначений;
	Для Каждого Причина Из ПричиныАннулирования() Цикл
		Причины.Добавить(Причина);
	КонецЦикла;
	Причины.Добавить("", "Другая причина…");
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("АннулироватьВыборПричины", ЭтотОбъект), Причины, Элементы.ПолеПросмотр);
КонецПроцедуры

&НаКлиенте
Процедура АннулироватьВыборПричины(Выбранный, Параметр) Экспорт
	Если Выбранный = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Выбранный.Значение) Тогда
		АннулироватьЗавершение(Выбранный.Значение, Неопределено);
	Иначе
		ПоказатьВводСтроки(Новый ОписаниеОповещения("АннулироватьЗавершение", ЭтотОбъект), "",
			"Причина аннулирования (её прочитает продавец)", 500, Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура АннулироватьЗавершение(Причина, Параметр) Экспорт
	Если НЕ ЗначениеЗаполнено(Причина) Тогда
		Возврат;
	КонецЕсли;
	Состояние("Входящий документ", , "Отправляю предложение об аннулировании…");
	ПоказатьИтог(АннулироватьНаСервере(Причина));
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПоступлениеВыполнить(Команда)
	Если ЗначениеЗаполнено(Документ) Тогда
		ПоказатьЗначение(, Документ);
		Возврат;
	КонецЕсли;
	Если ЭтоУКД Тогда
		ПоказатьПредупреждение(, "По корректировочному документу поступление не создаётся.");
		Возврат;
	КонецЕсли;
	Состояние("Входящий документ", , "Создаю поступление…");
	ПоказатьИтог(СоздатьПоступлениеНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура ПривязатьКПоступлениюВыполнить(Команда)
	Если ЗначениеЗаполнено(Документ) Тогда
		ПоказатьПредупреждение(, "Входящий уже связан с документом " + Документ);
		Возврат;
	КонецЕсли;
	Список = ПоступленияДляПривязки();
	Если Список.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Поступлений этой организации от поставщика за 10 дней вокруг даты документа,"
			+ " не связанных с другими входящими, нет");
		Возврат;
	КонецЕсли;
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПривязатьКПоступлениюЗавершение", ЭтотОбъект), Список, Элементы.ПолеПросмотр);
КонецПроцедуры

&НаКлиенте
Процедура ПривязатьКПоступлениюЗавершение(Выбранный, Параметр) Экспорт
	Если Выбранный = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПоказатьИтог(ПривязатьНаСервере(Выбранный.Значение));
КонецПроцедуры

&НаКлиенте
Процедура ДокументНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если ЗначениеЗаполнено(Документ) Тогда
		ПоказатьЗначение(, Документ);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗагрузитьИзПлатформы()
	Состояние("Входящий документ", , "Загружаю документ у оператора…");
	ЗагрузитьИзПлатформыНаСервере();
	Состояние();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьИзПлатформыНаСервере()

	ПросмотрДокумента = ЭДО_Сервер.ПросмотрВходящегоHTML(Ид, Организация);
	Просмотр = ПросмотрДокумента.HTML;
	Сообщения = Новый Массив;
	Если НЕ ПросмотрДокумента.Успех Тогда
		Сообщения.Добавить(ПросмотрДокумента.Текст);
	КонецЕсли;

	Ход.Очистить();
	// Перехват обоснован: ход документа - справка; оператор не ответил - строка в карточке, подробно - в ЖР.
	Попытка
		ХодДокумента = ЭДО_Сервер.ХодДокументаОператора(Ид, Организация);
		Для Каждого Шаг Из ХодДокумента.Шаги Цикл
			ЗаполнитьЗначенияСвойств(Ход.Добавить(), Шаг, "Время, Шаг, Статус");
		КонецЦикла;
		Если ЗначениеЗаполнено(ХодДокумента.Ошибка) Тогда
			Сообщения.Добавить("Ход документа: " + ХодДокумента.Ошибка);
		КонецЕсли;
		НовыйСтатус = ЭДО_Сервер.СтатусВходящегоУОператора(Ид, Организация);
		Если НовыйСтатус <> Неопределено Тогда
			Статус = НовыйСтатус;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Ход входящего " + Ид + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Сообщения.Добавить("Ход документа не загружен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		Идентификаторы = Новый Массив;
		Идентификаторы.Добавить(Ид);
		Найденный = ЭДО_Сервер.ДокументыПоВходящим(Идентификаторы).Получить(Ид);
		Если ТипЗнч(Найденный) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			Документ = Найденный;
		КонецЕсли;
	КонецЕсли;
	ОбновитьСостояние(СтрСоединить(Сообщения, Символы.ПС));

КонецПроцедуры

// Доступность команд по статусу у оператора: подписать, отказать и запросить уточнение можно, пока
// документ ждет ответа (SENT, DELIVERED); аннулировать - подписанный (ACCEPTED).
&НаСервере
Процедура ОбновитьСостояние(Знач ТекстСообщения = "")
	СостояниеЭДО = ЭДО_Сервер.ТекстСтатусаВходящего(Статус);
	ЖдетОтвета = (ВРег(Статус) = "SENT" ИЛИ ВРег(Статус) = "DELIVERED");
	НужнаПодпись = ЭДО_Сервер.ВходящийЖдетПодписиПокупателя(ФункцияДокумента);
	Элементы.КнопкаПодписать.Доступность = ЖдетОтвета И НужнаПодпись;
	Элементы.КнопкаОтказать.Доступность = ЖдетОтвета И НужнаПодпись;
	Элементы.КнопкаУточнение.Доступность = ЖдетОтвета;
	Элементы.КнопкаАннулировать.Доступность = (ВРег(Статус) = "ACCEPTED");
	Элементы.КнопкаСоздатьПоступление.Доступность = НЕ ЭтоУКД;
	Элементы.КнопкаПривязать.Доступность = НЕ ЭтоУКД И НЕ ЗначениеЗаполнено(Документ);
	Элементы.НадписьСообщение.Заголовок = ТекстСообщения;
	Элементы.НадписьСообщение.Видимость = ЗначениеЗаполнено(ТекстСообщения);
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИтог(Знач Итог)
	Состояние();
	ПоказатьПредупреждение(, Итог.Текст);
	ЗагрузитьИзПлатформы();
	Оповестить("ЭДО_ВходящийИзменен", Ид);
КонецПроцедуры

&НаСервере
Функция ПечатнаяФормаНаСервере()
	Ответ = ЭДО_Сервер.ПечатнаяФормаВходящего(Ид, Организация);
	Итог = Новый Структура("Успех, Текст, Адрес", Ответ.Успех, Ответ.Текст, "");
	Если Ответ.Успех Тогда
		Итог.Адрес = ПоместитьВоВременноеХранилище(Ответ.Данные, УникальныйИдентификатор);
	КонецЕсли;
	Возврат Итог;
КонецФункции

&НаСервере
Функция ПодписатьНаСервере()
	Возврат ЭДО_Сервер.ПодписатьВходящийВручную(Ид, Организация, Версия, ЭтоУКД, ФункцияДокумента);
КонецФункции

&НаСервере
Функция ОтказатьНаСервере(Знач Причина)
	Возврат ЭДО_Сервер.ОтказатьВПодписиВходящего(Ид, Организация, Причина);
КонецФункции

&НаСервере
Функция УточнениеНаСервере(Знач ТекстУточнения)
	Возврат ЭДО_Сервер.ЗапроситьУточнениеВходящего(Ид, Организация, ТекстУточнения, ГидПродавца);
КонецФункции

&НаСервереБезКонтекста
Функция ПричиныАннулирования()
	Возврат ЭДО_Сервер.ТиповыеПричиныАннулирования();
КонецФункции

&НаСервере
Функция АннулироватьНаСервере(Знач Причина)
	Возврат ЭДО_Сервер.ПредложитьАннулирование(Ид, Причина, , Организация);
КонецФункции

&НаСервере
Функция СоздатьПоступлениеНаСервере()
	Итог = ЭДО_Сервер.СоздатьДокументПоВходящему(Ид, Организация, Статус);
	Если Итог.Успех И ТипЗнч(Итог.Документ) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		Документ = Итог.Документ;
	КонецЕсли;
	Возврат Новый Структура("Успех, Текст", Итог.Успех,
		Итог.Текст + ?(Итог.Сообщения.Количество() > 0, Символы.ПС + СтрСоединить(Итог.Сообщения, Символы.ПС), ""));
КонецФункции

&НаСервере
Функция ПоступленияДляПривязки()
	Список = Новый СписокЗначений;
	ОдинВходящий = Новый Массив;
	ОдинВходящий.Добавить(Новый Структура("Ид, Организация, ИННПродавца, Номер, Дата", Ид, Организация, ИННПродавца, Номер, Дата));
	Наборы = Новый Массив;
	Наборы.Добавить(Новый Структура("ПоНомеру, Документы", Истина,
		ЭДО_Сервер.ДокументыКандидатыПоВходящим(ОдинВходящий, Истина).Получить(Ид)));
	Наборы.Добавить(Новый Структура("ПоНомеру, Документы", Ложь,
		ЭДО_Сервер.ДокументыКандидатыПоВходящим(ОдинВходящий, Ложь).Получить(Ид)));
	Для Каждого Набор Из Наборы Цикл
		Если Набор.Документы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Кандидат Из Набор.Документы Цикл
			Если Список.НайтиПоЗначению(Кандидат) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Реквизиты = Новый Структура("НомерВходящегоДокумента, СуммаДокумента", "", 0);
			ЗаполнитьЗначенияСвойств(Реквизиты, Кандидат);
			Список.Добавить(Кандидат, Строка(Кандидат) + ", вх. № " + СокрЛП(Реквизиты.НомерВходящегоДокумента) + ", "
				+ Формат(Реквизиты.СуммаДокумента, "ЧДЦ=2; ЧН=0") + ?(Набор.ПоНомеру, " - номер совпадает", ""));
		КонецЦикла;
	КонецЦикла;
	Возврат Список;
КонецФункции

&НаСервере
Функция ПривязатьНаСервере(Знач Кандидат)
	Итог = ЭДО_Сервер.ПривязатьВходящийКДокументу(Ид, Организация, Кандидат, Статус);
	Если Итог.Успех И ТипЗнч(Итог.Документ) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		Документ = Итог.Документ;
	КонецЕсли;
	Возврат Новый Структура("Успех, Текст", Итог.Успех,
		Итог.Текст + ?(Итог.Сообщения.Количество() > 0, Символы.ПС + СтрСоединить(Итог.Сообщения, Символы.ПС), ""));
КонецФункции

#КонецОбласти
