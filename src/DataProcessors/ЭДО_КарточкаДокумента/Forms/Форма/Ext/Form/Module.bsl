// Адрес у того же оператора, что и мы. Роуминговой связи для такой пары не бывает,
// обмен идет напрямую, а приглашение туда бесполезно и на живой связи опасно.
&НаСервере
Функция АдресВнутриНашегоОператора(Знач Адрес)

	Проверяемый = ВРег(СокрЛП(Адрес));
	НашГид = ВРег(СокрЛП(Строка(ЭДО_Сервер.ГидОрганизации(ОрганизацияКарточки()))));
	Если СтрДлина(Проверяемый) < 3 ИЛИ СтрДлина(НашГид) < 3 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Лев(Проверяемый, 3) = Лев(НашГид, 3);

