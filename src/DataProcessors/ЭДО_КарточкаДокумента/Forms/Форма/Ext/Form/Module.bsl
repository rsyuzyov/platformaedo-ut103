&НаСервереБезКонтекста
Процедура ЗаписатьСвойство(Объект, Свойство, Значение)

	// Своя копия: такая процедура ядра не экспортная.
	Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Объект);
	Набор.Отбор.Свойство.Установить(Свойство);
	Запись = Набор.Добавить();
	Запись.Объект = Объект;
	Запись.Свойство = Свойство;
	Запись.Значение = Значение;
	Набор.Записать();

КонецПроцедуры

&НаКлиенте
Функция ЕстьИдентификаторКарточки(ТекущиеДанные)

	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Сначала выберите строку в истории отправок:"
			+ " XML, ссылка и печатная форма берутся по конкретной отправке.");
		Возврат Ложь;
	КонецЕсли;
	Если ЭтоСтрокаХодаЗапроса(ТекущиеДанные) Тогда
		ПоказатьПредупреждение(, "Эта строка показывает ход запроса к оператору, а не отправку."
			+ " Дождитесь истории отправок или нажмите ""Обновить"".");
		Возврат Ложь;
	КонецЕсли;
	// Судим по типу строки, а не по оператору: оператор здесь - оператор получателя,
	// и у контрагента в роуминге СБИС он тоже "СБИС".
	Если СокрЛП(ТекущиеДанные.Тип) = "старая интеграция" Тогда
		ПоказатьПредупреждение(, "Это отправка через СБИС (старая интеграция)."
			+ " XML, ссылка в личный кабинет и печатная форма есть только у отправок"
			+ " через Платформу ЭДО.");
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(СокрЛП(ТекущиеДанные.Идентификатор)) Тогда
		ПоказатьПредупреждение(, "У этой строки нет идентификатора карточки в Платформе —"
			+ " показывать нечего.");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаСервере
Функция СодержимоеКарточкиНаСервере(Знач ИдентификаторКарточки, Знач Вид)

	// Вид = "xml" - исходный подписанный титул, который ушел контрагенту;
	// Вид = "pdf" - печатная форма с меткой ЭДО (метод v4, отдельный от контента).
	Итог = Новый Структура("Ошибка, Текст, Адрес", "", "", "");

	Если Вид = "pdf" Тогда
		ПутьЗапроса = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v4/documents/"
			+ СокрЛП(ИдентификаторКарточки) + "/watermarked-content";
		ТипСодержимого = "";
	Иначе
		ПутьЗапроса = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/documents/"
			+ СокрЛП(ИдентификаторКарточки) + "/content";
		ТипСодержимого = "application/xml";
	КонецЕсли;

	ОтветПлатформы = ПолучитьОтПлатформыНаСервере(ПутьЗапроса, ТипСодержимого);
	Если ЗначениеЗаполнено(ОтветПлатформы.Ошибка) Тогда
		Итог.Ошибка = ОтветПлатформы.Ошибка;
		Возврат Итог;
	КонецЕсли;
	Если ОтветПлатформы.Данные = Неопределено ИЛИ ОтветПлатформы.Данные.Размер() = 0 Тогда
		Итог.Ошибка = "Платформа вернула пустое содержимое карточки "
			+ СокрЛП(ИдентификаторКарточки) + ".";
		Возврат Итог;
	КонецЕсли;

	Если Вид = "pdf" Тогда
		Итог.Адрес = ПоместитьВоВременноеХранилище(ОтветПлатформы.Данные, УникальныйИдентификатор);
	Иначе
		// Титул ФНС приходит в windows-1251; если пролог говорит UTF-8, перечитываем те же байты.
		ТекстТитула = ПолучитьСтрокуИзДвоичныхДанных(ОтветПлатформы.Данные, "windows-1251");
		Если Найти(ВРег(Лев(ТекстТитула, 200)), "UTF-8") > 0 Тогда
			ТекстТитула = ПолучитьСтрокуИзДвоичныхДанных(ОтветПлатформы.Данные, "UTF-8");
		КонецЕсли;
		Итог.Текст = ТекстТитула;
	КонецЕсли;

	Возврат Итог;

КонецФункции

&НаСервере
Функция ПолучитьОтПлатформыНаСервере(Знач ПутьЗапроса, Знач ТипСодержимого)

	Итог = Новый Структура("Ошибка, Данные", "", Неопределено);

	Попытка
		Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Ложь, ОрганизацияКарточки()) Тогда
			Итог.Ошибка = "Не удалось получить токен Платформы.";
			Возврат Итог;
		КонецЕсли;
		ТокенПлатформы = ЭДО_Сервер.ТекущийТокен(ОрганизацияКарточки());

		СоединениеСПлатформой = ЭДО_Сервер.СоединениеСОператором(30);

		// ОбеспечитьТокен(Ложь) проверяет только наличие токена, а он живет 15 минут - 401 лечится перевыпуском.
		Для НомерПопытки = 1 По 2 Цикл
			ЗапросКПлатформе = Новый HTTPЗапрос(ПутьЗапроса);
			ЗапросКПлатформе.Заголовки.Вставить("Authorization", "Bearer " + ТокенПлатформы);
			Если ЗначениеЗаполнено(ТипСодержимого) Тогда
				ЗапросКПлатформе.Заголовки.Вставить("accept", ТипСодержимого);
			КонецЕсли;

			ОтветСервиса = СоединениеСПлатформой.Получить(ЗапросКПлатформе);

			Если ОтветСервиса.КодСостояния = 401 И НомерПопытки = 1 Тогда
				ЭДО_Сервер.ОбеспечитьТокен(Истина, ОрганизацияКарточки());
				ТокенПлатформы = ЭДО_Сервер.ТекущийТокен(ОрганизацияКарточки());
				Продолжить;
			КонецЕсли;
			Если ОтветСервиса.КодСостояния <> 200 Тогда
				Итог.Ошибка = "Платформа ответила HTTP " + ОтветСервиса.КодСостояния + ": "
					+ Лев(ОтветСервиса.ПолучитьТелоКакСтроку("UTF-8"), 200);
				Возврат Итог;
			КонецЕсли;

			Итог.Данные = ОтветСервиса.ПолучитьТелоКакДвоичныеДанные();
			Возврат Итог;
		КонецЦикла;

		Итог.Ошибка = "Платформа не приняла токен (HTTP 401), и перевыпустить его не удалось.";
	Исключение
		Итог.Ошибка = "Не удалось обратиться к Платформе: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область Аннулирование

&НаКлиенте
Процедура АннулироватьОтправку(Команда)

	ТекущиеДанные = Элементы.История.ТекущиеДанные;
	Если НЕ ЕстьИдентификаторКарточки(ТекущиеДанные) Тогда
		Возврат;
	КонецЕсли;

	// Аннулировать можно только то, что дошло до контрагента. Черновик, ошибка отправки
	// и отказ юридической силы не имеют, а уже запрошенное аннулирование повторять незачем.
	Статус = ВРег(СокрЛП(ТекущиеДанные.Статус));
	Если СтрНайти(",SENT,DELIVERED,ACCEPTED,", "," + Статус + ",") = 0 Тогда
		ПоказатьПредупреждение(, "Аннулировать можно только отправленный, доставленный или принятый экземпляр."
			+ " У выбранного статус " + ТекущиеДанные.Статус + ".");
		Возврат;
	КонецЕсли;

	Варианты = Новый СписокЗначений;
	Для Каждого Причина Из ПричиныАннулированияНаСервере() Цикл
		Варианты.Добавить(Причина);
	КонецЦикла;
	Варианты.Добавить("", "Другая причина...");

	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("АннулироватьВыборПричины", ЭтотОбъект,
		СокрЛП(ТекущиеДанные.Идентификатор)), Варианты);

КонецПроцедуры

&НаКлиенте
Процедура АннулироватьВыборПричины(Выбор, ИдКарточки) Экспорт

	Если Выбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Выбор.Значение) Тогда
		АннулироватьВводПричины(Выбор.Значение, ИдКарточки);
	Иначе
		ПоказатьВводСтроки(Новый ОписаниеОповещения("АннулироватьВводПричины", ЭтотОбъект, ИдКарточки),
			"", "Причина аннулирования (ее прочитает контрагент)", 1000, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АннулироватьВводПричины(Причина, ИдКарточки) Экспорт

	Если НЕ ЗначениеЗаполнено(Причина) Тогда
		Возврат;
	КонецЕсли;

	ДанныеАннулирования = Новый Структура("ИдКарточки, Причина", ИдКарточки, Причина);
	ПоказатьВопрос(Новый ОписаниеОповещения("АннулироватьЗавершение", ЭтотОбъект, ДанныеАннулирования),
		"Контрагенту уйдет предложение об аннулировании экземпляра " + ИдКарточки + ":" + Символы.ПС
		+ Причина + Символы.ПС + Символы.ПС
		+ "Документ станет аннулированным только после подтверждения контрагентом."
		+ " Для маркированного товара аннулирование в ЭДО не отменяет передачу в Честном знаке." + Символы.ПС + Символы.ПС
		+ "Отправить?", РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура АннулироватьЗавершение(Ответ, ДанныеАннулирования) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние("Состояние ЭДО", , "Отправляю предложение об аннулировании…");
	Итог = АннулироватьНаСервере(ДанныеАннулирования.ИдКарточки, ДанныеАннулирования.Причина);
	Состояние();
	ОповеститьФормуДокумента();
	ОбновитьПослеДействия(Итог.Текст);

	Если Итог.Успех Тогда
		ПоказатьОповещениеПользователя("Аннулирование", , Итог.Текст);
	Иначе
		ПоказатьПредупреждение(, Итог.Текст);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПринятьАннулирование(Команда)

	ПоказатьВопрос(Новый ОписаниеОповещения("ПринятьАннулированиеЗавершение", ЭтотОбъект),
		"Контрагент просит аннулировать документ:" + Символы.ПС + ЗапросАннулирования + Символы.ПС + Символы.ПС
		+ "Если принять, документ у оператора станет аннулированным. Взамен контрагенту обычно нужен"
		+ " исправленный документ." + Символы.ПС + Символы.ПС + "Принять аннулирование?",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПринятьАннулированиеЗавершение(Ответ, Параметр) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ПоказатьИтогОтвета(ОтветитьНаЗапросНаСервере(Истина, ""));

КонецПроцедуры

&НаКлиенте
Процедура ОтклонитьАннулирование(Команда)

	ПоказатьВводСтроки(Новый ОписаниеОповещения("ОтклонитьАннулированиеЗавершение", ЭтотОбъект),
		"", "Причина отказа (ее прочитает контрагент)", 1000, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОтклонитьАннулированиеЗавершение(Причина, Параметр) Экспорт

	Если НЕ ЗначениеЗаполнено(Причина) Тогда
		Возврат;
	КонецЕсли;
	ПоказатьИтогОтвета(ОтветитьНаЗапросНаСервере(Ложь, Причина));

КонецПроцедуры

&НаКлиенте
Процедура СнятьПаузу(Команда)

	ПоказатьВопрос(Новый ОписаниеОповещения("СнятьПаузуЗавершение", ЭтотОбъект),
		"Возобновить отправку контрагенту " + КонтрагентПредставление + "?" + Символы.ПС + Символы.ПС
		+ "Причина паузы: " + ПаузаОтправки, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СнятьПаузуЗавершение(Ответ, Параметр) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	СнятьПаузуНаСервере();
	ОповеститьФормуДокумента();
	ПоказатьОповещениеПользователя("Отправка возобновлена", , КонтрагентПредставление);

КонецПроцедуры

&НаСервере
Процедура СнятьПаузуНаСервере()

	ЭДО_Сервер.ВозобновитьОтправкуКонтрагенту(КонтрагентКарточки());
	ЗаполнитьИзБазы();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИтогОтвета(Итог)

	ОповеститьФормуДокумента();
	ОбновитьПослеДействия(Итог.Текст);

	Если Итог.Успех Тогда
		ПоказатьОповещениеПользователя("Запрос на аннулирование", , Итог.Текст);
	Иначе
		ПоказатьПредупреждение(, Итог.Текст);
	КонецЕсли;

КонецПроцедуры

// Форма документа держит гиперссылку "Состояние ЭДО" и перечитывает ее по этому оповещению.
&НаКлиенте
Процедура ОповеститьФормуДокумента()

	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;
	Оповестить("ОбновитьСостояниеЭД", , ДокументСсылка);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПричиныАннулированияНаСервере()

	Возврат ЭДО_Сервер.ТиповыеПричиныАннулирования();

КонецФункции

&НаСервере
Функция АннулироватьНаСервере(Знач ИдКарточки, Знач Причина)

	Итог = ЭДО_Сервер.ПредложитьАннулирование(ИдКарточки, Причина, ДокументСсылка);
	ОбновитьФормуПослеДействия(Итог);
	Возврат Итог;

КонецФункции

&НаСервере
Функция ОтветитьНаЗапросНаСервере(Знач Принять, Знач Причина)

	Итог = ЭДО_Сервер.ОтветитьНаЗапросАннулирования(ДокументСсылка, Принять, Причина);
	ОбновитьФормуПослеДействия(Итог);
	Возврат Итог;

КонецФункции

// Перечитывание формы не должно съесть итог действия. История от оператора перечитывается
// следом фоновым заданием, см. ОбновитьПослеДействия.
&НаСервере
Процедура ОбновитьФормуПослеДействия(Итог)

	Попытка
		ЗаполнитьИзБазы();
	Исключение
		Итог.Текст = Итог.Текст + " Данные формы обновить не удалось: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + " Нажмите «Обновить».";
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ЗапросыКОператору

// Запросы к оператору идут фоновыми заданиями, форма опрашивает их раз в секунду.
// До ответа таблица показывает строку хода запроса, по ответу - данные или текст ошибки.

&НаКлиенте
Процедура ЗагрузитьИсторию()

	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;

	НачатьЗапрос("История");

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДокументыКонтрагента()

	Если НЕ ЗначениеЗаполнено(КонтрагентСсылка) ИЛИ ДокументыКонтрагентаЗагружены Тогда
		Возврат;
	КонецЕсли;

	ДокументыКонтрагентаЗагружены = Истина;
	НачатьЗапрос("ДокументыКонтрагента");

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьАдреса()

	Если НЕ ЗначениеЗаполнено(КонтрагентСсылка) ИЛИ АдресаЗагружены Тогда
		Возврат;
	КонецЕсли;

	АдресаЗагружены = Истина;
	НачатьЗапрос("Адреса");

КонецПроцедуры

// Итог действия показывается первым в поле "Сообщение", история перечитывается по факту действия.
&НаКлиенте
Процедура ОбновитьПослеДействия(Знач ТекстИтога)

	УстановитьЧастьСообщения("Действие", ТекстИтога);
	ЗагрузитьИсторию();

КонецПроцедуры

// Повторный запрос того же вида отменяет прежний: его ответ уже не нужен.
&НаКлиенте
Процедура НачатьЗапрос(Знач Вид)

	Если ЗапросыВРаботе = Неопределено Тогда
		ЗапросыВРаботе = Новый Соответствие;
	КонецЕсли;

	ПрежнийЗапрос = ЗапросыВРаботе.Получить(Вид);
	ЗапросыВРаботе.Удалить(Вид);
	ЗапросВРаботе = НачатьЗапросНаСервере(Вид, ПрежнийЗапрос);
	Если ЗапросВРаботе.Выполнен Тогда
		ЗавершитьЗапрос(Вид, ЗапросВРаботе.Итог);
		Возврат;
	КонецЕсли;

	ЗапросыВРаботе.Вставить(Вид, ЗапросВРаботе);
	ПодключитьОбработчикОжидания("ПроверитьЗапросы", 1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗапросы()

	Если ЗапросыВРаботе = Неопределено ИЛИ ЗапросыВРаботе.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Сначала легкая проверка без контекста формы: пока задания идут, данные формы на сервер не гоняем.
	Если ЕстьЗавершенныеЗадания(ЗапросыВРаботе) Тогда
		ЗавершенныеЗапросы = ЗавершенныеЗапросыНаСервере(ЗапросыВРаботе);
		Для Каждого ЗавершенныйЗапрос Из ЗавершенныеЗапросы Цикл
			ЗапросыВРаботе.Удалить(ЗавершенныйЗапрос.Ключ);
			ЗавершитьЗапрос(ЗавершенныйЗапрос.Ключ, ЗавершенныйЗапрос.Значение);
		КонецЦикла;
	КонецЕсли;

	Если ЗапросыВРаботе.Количество() > 0 Тогда
		ПодключитьОбработчикОжидания("ПроверитьЗапросы", 1, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьЗапрос(Знач Вид, Знач Итог)

	УстановитьЧастьСообщения(Вид, Итог.Текст);
	Если Итог.КолонкаОбновлена Тогда
		ОповеститьФормуДокумента();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ЗапросИдет(Знач Вид)

	Возврат ЗапросыВРаботе <> Неопределено И ЗапросыВРаботе.Получить(Вид) <> Неопределено;

КонецФункции

// Строка хода запроса или его ошибки: ни статуса, ни типа отправки у нее нет.
&НаКлиенте
Функция ЭтоСтрокаХодаЗапроса(СтрокаИстории)

	Возврат НЕ ЗначениеЗаполнено(СтрокаИстории.Статус) И НЕ ЗначениеЗаполнено(СтрокаИстории.Тип);

КонецФункции

// Поле "Сообщение" собирают несколько запросов, и отвечают они в любом порядке. Каждый пишет
// свою часть, а поле складывается заново: итог действия первым, дальше в порядке закладок.
&НаКлиенте
Процедура УстановитьЧастьСообщения(Знач Источник, Знач Текст)

	Если ЧастиСообщения = Неопределено Тогда
		ЧастиСообщения = Новый Соответствие;
	КонецЕсли;
	ЧастиСообщения.Вставить(Источник, СокрЛП(Текст));

	ЗаполненныеЧасти = Новый Массив;
	Для Каждого ИмяИсточника Из СтрРазделить("Действие,История,ДокументыКонтрагента,Адреса", ",") Цикл
		ТекстЧасти = ЧастиСообщения.Получить(ИмяИсточника);
		Если ЗначениеЗаполнено(ТекстЧасти) Тогда
			ЗаполненныеЧасти.Добавить(ТекстЧасти);
		КонецЕсли;
	КонецЦикла;
	Сообщение = СтрСоединить(ЗаполненныеЧасти, Символы.ПС);

КонецПроцедуры

&НаСервере
Функция НачатьЗапросНаСервере(Знач Вид, Знач ПрежнийЗапрос)

	Если ПрежнийЗапрос <> Неопределено Тогда
		ОтменитьЗадание(ПрежнийЗапрос.ИдентификаторЗадания);
	КонецЕсли;

	ПоказатьСтрокуЗапроса(Вид, "Идет получение данных от оператора...");

	ПараметрыЗапроса = Обработки.ЭДО_КарточкаДокумента.ПараметрыЗапроса();
	ПараметрыЗапроса.Документ = ДокументСсылка;
	ПараметрыЗапроса.Контрагент = КонтрагентСсылка;
	ПараметрыЗапроса.ИдентификаторЭДО = ИдентификаторЭДО;
	ПараметрыЗапроса.ОператорЭДО = ОператорЭДО;
	ПараметрыЗапроса.ТекущийСтатус = ТекущийСтатус;
	ПараметрыЗапроса.НачалоПериода = НачалоПериодаДокументов;
	ПараметрыЗапроса.КонецПериода = КонецПериодаДокументов;

	ЗапросВРаботе = Новый Структура("Выполнен, Итог, ИдентификаторЗадания, АдресРезультата", Ложь);
	ЗапросВРаботе.АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);

	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(Вид);
	ПараметрыЗадания.Добавить(ПараметрыЗапроса);
	ПараметрыЗадания.Добавить(ЗапросВРаботе.АдресРезультата);
	Попытка
		Задание = ФоновыеЗадания.Выполнить("ЭДО_Сервер.ВыполнитьЗапросКарточкиЭДО", ПараметрыЗадания, ,
			"Карточка ЭДО: " + Вид);
		ЗапросВРаботе.ИдентификаторЗадания = Задание.УникальныйИдентификатор;
		Возврат ЗапросВРаботе;
	Исключение
		// Задание не запустилось - запрос выполняется здесь же: форма замрет на время ответа, но данные будут.
		ЗаписьЖурналаРегистрации("ЭДО.КарточкаДокумента", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Фоновое задание запроса " + Вид + " не запустилось: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ТекстОшибки = "";
	Результат = Неопределено;
	Попытка
		Результат = Обработки.ЭДО_КарточкаДокумента.ВыполнитьЗапрос(Вид, ПараметрыЗапроса);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	ЗапросВРаботе.Выполнен = Истина;
	ЗапросВРаботе.Итог = ПрименитьРезультат(Вид, Результат, ТекстОшибки);

	Возврат ЗапросВРаботе;

КонецФункции

&НаСервере
Функция ЗавершенныеЗапросыНаСервере(Знач Запросы)

	ЗавершенныеЗапросы = Новый Соответствие;
	Для Каждого ЭлементЗапроса Из Запросы Цикл
		ЗапросВРаботе = ЭлементЗапроса.Значение;
		СостояниеЗапроса = СостояниеЗадания(ЗапросВРаботе.ИдентификаторЗадания);
		Если СостояниеЗапроса.Активно Тогда
			Продолжить;
		КонецЕсли;

		ТекстОшибки = СостояниеЗапроса.Ошибка;
		Результат = Неопределено;
		Если НЕ ЗначениеЗаполнено(ТекстОшибки) Тогда
			Результат = ПолучитьИзВременногоХранилища(ЗапросВРаботе.АдресРезультата);
			Если Результат = Неопределено Тогда
				ТекстОшибки = "фоновое задание завершилось без результата.";
			КонецЕсли;
		КонецЕсли;
		УдалитьИзВременногоХранилища(ЗапросВРаботе.АдресРезультата);

		ЗавершенныеЗапросы.Вставить(ЭлементЗапроса.Ключ, ПрименитьРезультат(ЭлементЗапроса.Ключ, Результат, ТекстОшибки));
	КонецЦикла;

	Возврат ЗавершенныеЗапросы;

КонецФункции

// Раскладывает ответ запроса по реквизитам формы. Возврат: Структура (Текст - часть поля "Сообщение";
// КолонкаОбновлена - история записала свежий статус в колонку "ЭДО", форме документа пора перечитаться).
&НаСервере
Функция ПрименитьРезультат(Знач Вид, Знач Результат, Знач ТекстОшибки)

	Итог = Новый Структура("Текст, КолонкаОбновлена", "", Ложь);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Итог.Текст = "Ошибка получения данных от оператора: " + ТекстОшибки;
		ПоказатьСтрокуЗапроса(Вид, Итог.Текст);
		Возврат Итог;
	КонецЕсли;

	ЗначениеВРеквизитФормы(Результат.Таблица, Вид);
	Итог.Текст = Результат.Сообщение;
	Если Вид = "История" Тогда
		ТекущийСтатус = Результат.ТекущийСтатус;
		Итог.КолонкаОбновлена = Результат.КолонкаОбновлена;
	КонецЕсли;

	// Пустая таблица без объяснения выглядит как зависший запрос.
	Если Результат.Таблица.Количество() = 0 Тогда
		ПоказатьСтрокуЗапроса(Вид, ?(ЗначениеЗаполнено(Результат.Сообщение),
			СтрПолучитьСтроку(Результат.Сообщение, 1), "Данных нет."));
	КонецЕсли;

	Возврат Итог;

КонецФункции

&НаСервере
Процедура ПоказатьСтрокуЗапроса(Знач Вид, Знач Текст)

	Если Вид = "История" Тогда
		История.Очистить();
		История.Добавить().Причина = Лев(Текст, 500);
	ИначеЕсли Вид = "ДокументыКонтрагента" Тогда
		ДокументыКонтрагента.Очистить();
		ДокументыКонтрагента.Добавить().Статус = Лев(Текст, 50);
	ИначеЕсли Вид = "Адреса" Тогда
		Адреса.Очистить();
		Адреса.Добавить().Наименование = Лев(Текст, 200);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьЗавершенныеЗадания(Знач Запросы)

	Для Каждого ЭлементЗапроса Из Запросы Цикл
		Если НЕ СостояниеЗадания(ЭлементЗапроса.Значение.ИдентификаторЗадания).Активно Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция СостояниеЗадания(Знач ИдентификаторЗадания)

	СостояниеЗапроса = Новый Структура("Активно, Ошибка", Ложь, "");
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Если Задание = Неопределено Тогда
		СостояниеЗапроса.Ошибка = "фоновое задание запроса не найдено.";
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		СостояниеЗапроса.Активно = Истина;
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
		Если Задание.ИнформацияОбОшибке = Неопределено Тогда
			СостояниеЗапроса.Ошибка = "фоновое задание завершилось аварийно.";
		Иначе
			СостояниеЗапроса.Ошибка = КраткоеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
		КонецЕсли;
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
		СостояниеЗапроса.Ошибка = "запрос отменен.";
	КонецЕсли;

	Возврат СостояниеЗапроса;

КонецФункции

&НаСервереБезКонтекста
Процедура ОтменитьЗадание(Знач ИдентификаторЗадания)

	Если ИдентификаторЗадания = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Если Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Задание.Отменить();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
