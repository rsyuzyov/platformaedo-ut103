// Документы контрагента за период; куда каждый ушел - по карточке у оператора.
&НаСервере
Процедура ЗаполнитьДокументыКонтрагентаНаСервере()

	ДокументыКонтрагента.Очистить();
	ДокументыКонтрагентаЗагружены = Истина;
	Если НЕ ЗначениеЗаполнено(КонтрагентСсылка) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Данные = ЭДО_Витрина.ДокументыКонтрагентаСМаршрутом(КонтрагентСсылка,
			НачалоДня(НачалоПериодаДокументов), КонецДня(КонецПериодаДокументов));
	Исключение
		Сообщение = "Документы контрагента не собраны: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");
		Возврат;
	КонецПопытки;

	Для Каждого СтрокаДанных Из Данные.Документы Цикл
		НоваяСтрока = ДокументыКонтрагента.Добавить();
		НоваяСтрока.Документ = СтрокаДанных.Документ;
		НоваяСтрока.Статус = СтрокаДанных.Состояние;
		НоваяСтрока.Адрес = СтрокаДанных.Адрес;
		НоваяСтрока.Оператор = СтрокаДанных.Оператор;
		Если ЗначениеЗаполнено(СтрокаДанных.ИдОператора) И НЕ ЗначениеЗаполнено(СтрокаДанных.Адрес) Тогда
			НоваяСтрока.Оператор = "оператор не ответил";
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(Данные.Ошибка) Тогда
		Сообщение = "Документы контрагента: " + Данные.Ошибка + "."
			+ ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВыбратьДокументНаСервере(Знач Документ)

	ДокументСсылка = Документ;
	История.Очистить();
	// ЩА 23.10.2026 [yan], ревью Codex (КАТАП №24): связи на «Операторах» - по организации документа; адреса,
	// загруженные без документа (по всем организациям), перечитываются при следующем открытии закладки.
	Адреса.Очистить();
	АдресаЗагружены = Ложь;
