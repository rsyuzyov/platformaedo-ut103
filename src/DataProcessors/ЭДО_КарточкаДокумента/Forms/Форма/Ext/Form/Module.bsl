#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Карточка обслуживает любой документ, отправляемый по ЭДО: накладную, акт сверки,
	// корректировку. Поэтому параметр один и тип у него - набор ссылок на документы,
	// а не конкретный вид.
	ДокументСсылка = Параметры.Документ;

	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Заголовок = "Состояние ЭДО: " + Строка(ДокументСсылка);

	ЗаполнитьИзБазы();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// В Платформу ходим ПОСЛЕ отрисовки окна, а не в ПриСозданииНаСервере.
	// При аварии оператора один запрос висит до 20 с, а с ретраями дольше - форма
	// просто не открывалась бы, и пользователь не увидел бы даже того, что уже есть в базе.
	// Отложенный обработчик показывает шапку сразу, а историю дозаполняет следом.
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		ПодключитьОбработчикОжидания("ЗагрузитьИзПлатформыОтложенно", 0.2, Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьИзПлатформы(Команда)

	ЗагрузитьИзПлатформыОтложенно();

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьДокумент(Команда)

	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		ПоказатьПредупреждение(, "Накладной еще нет: заявка не отгружена, отправлять в ЭДО нечего.");
		Возврат;
	КонецЕсли;

	// У акта сверки нет ни "подписанного экземпляра", ни истории СБИС - вопрос про
	// переотправку строится по той же истории Платформы, что и у накладной.

	// Текст вопроса - по ФАКТИЧЕСКОЙ истории отправок, а не по колонке "ЭДО": колонку пишет
	// регламент раз в час, и в момент нажатия она может отставать.
	ПодписанныйЭкземпляр = "";
	Последняя = Неопределено;
	Для Каждого СтрокаИстории Из История Цикл
		Если ВРег(СокрЛП(СтрокаИстории.Статус)) = "ACCEPTED" Тогда
			ПодписанныйЭкземпляр = СтрокаИстории.Оператор;
		КонецЕсли;
		Если Последняя = Неопределено ИЛИ СтрокаИстории.Создан > Последняя.Создан Тогда
			Последняя = СтрокаИстории;
		КонецЕсли;
	КонецЦикла;

	Куда = ?(ЗначениеЗаполнено(ОператорЭДО), " (" + ОператорЭДО + ")", "");
	Если ЗначениеЗаполнено(ПодписанныйЭкземпляр) Тогда
 // Третий случай, которого нет в постановке, но без него кнопка опасна: контрагент
 // уже ПОДПИСАЛ экземпляр, и переотправка даст ему второй УПД на ту же отгрузку.
		Текст = "Контрагент уже ПОДПИСАЛ этот документ (" + ПодписанныйЭкземпляр + ")." + Символы.ПС
			+ "Переотправка создаст у него второй экземпляр на ту же отгрузку." + Символы.ПС + Символы.ПС
			+ "Все равно отправить" + Куда + "?";
	ИначеЕсли Последняя <> Неопределено Тогда
		Текст = "Документ уже отправлен: " + Последняя.Статус + " от "
			+ Формат(Последняя.Создан, "ДФ=dd.MM.yyyy HH:mm")
			+ ?(ЗначениеЗаполнено(Последняя.Оператор), ", " + Последняя.Оператор, "") + "." + Символы.ПС + Символы.ПС
			+ "Переотправить" + Куда + "?";
	Иначе
		Текст = "Отправить документ в ЭДО" + Куда + "?";
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("ОтправитьДокументЗавершение", ЭтотОбъект),
		Текст, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьДокументЗавершение(Ответ, Параметр) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние("Состояние ЭДО", , "Отправляю в Платформу…");
	ИтогОтправки = ОтправитьНаСервере();
	Состояние();

	// Два отказа человек вправе снять сам: документ старше даты начала работы с оператором
	// и документ, уходивший через СБИС. Оба говорят об одном - он мог уйти прежним каналом,
	// а знает об этом не механизм, а человек, у которого на руках переписка с контрагентом.
	// Спрашиваем ЗДЕСЬ, а не до отправки: до неё неизвестно, упрётся документ в эту
	// причину или в какую-то другую, а лишний вопрос на каждой отправке никто не читает.
	Если НЕ ИтогОтправки.Успех И ГейтПреодолимОператором(ИтогОтправки.КодПричины) Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ОтправитьПреодолевГейтЗавершение", ЭтотОбъект,
				ИтогОтправки.КодПричины),
			ИтогОтправки.Текст + Символы.ПС + Символы.ПС
			+ "Если документ уже был принят контрагентом по прежнему каналу, у него появится"
			+ " второй экземпляр на ту же отгрузку." + Символы.ПС + Символы.ПС
			+ "Все равно отправить?",
			РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;

	// Поле "Сообщение" - ПОСЛЕДНИЙ элемент формы, под двумя растянутыми таблицами
	// (история отправок и связи), высотой в три строки. При обычном размере окна оно
	// уходит за нижний край: результат туда писался и раньше, но пользователь его не
	// видел - кнопка выглядела зависшей (обращение оператора 04.09.2026).
	// итог показываем явно, а в поле он остается как история.
	// Удержание и ошибка разведены намеренно: "документ не отправлен, и это решение
	// механизма" - не то же самое, что "отправка сломалась".
	Если ИтогОтправки.Успех Тогда
		ПоказатьОповещениеПользователя("Отправлен в ЭДО", , ИтогОтправки.Текст);
	Иначе
		ПоказатьПредупреждение(, ИтогОтправки.Заголовок + ": " + ИтогОтправки.Текст);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ГейтПреодолимОператором(Знач КодПричины)

	Возврат КодПричины = "ДатаНачалаОтправки" ИЛИ КодПричины = "ОтправлялсяЧерезСБИС";

КонецФункции

&НаКлиенте
Процедура ОтправитьПреодолевГейтЗавершение(Ответ, КодПричины) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние("Состояние ЭДО", , "Отправляю в Платформу…");
	ИтогОтправки = ОтправитьНаСервере(КодПричины);
	Состояние();

	Если ИтогОтправки.Успех Тогда
		ПоказатьОповещениеПользователя("Отправлен в ЭДО", , ИтогОтправки.Текст);
	Иначе
		ПоказатьПредупреждение(, ИтогОтправки.Заголовок + ": " + ИтогОтправки.Текст);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьАдреса(Команда)

	// В поле "Сообщение" пишут ТРИ механизма, и раньше каждый затирал предыдущий: причина
	// пустой истории исчезала ровно в тот момент, когда пользователь жал "Обновить список",
	// чтобы разобраться. Дописываем, а не заменяем.
	Состояние("Состояние ЭДО", , "Спрашиваю реестр ФНС…");
	ПрежнееСообщение = Сообщение;
	Сообщение = ЗагрузитьАдресаНаСервере()
		+ ?(ЗначениеЗаполнено(ПрежнееСообщение), Символы.ПС + ПрежнееСообщение, "");
	Состояние();

КонецПроцедуры

&НаКлиенте
Процедура ПривязатьАдрес(Команда)

	ТекущиеДанные = Элементы.Адреса.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Сначала выберите строку в списке адресов.");
		Возврат;
	КонецЕсли;
	Если СокрЛП(ТекущиеДанные.Адрес) = СокрЛП(ИдентификаторЭДО) Тогда
		ПоказатьПредупреждение(, "Этот адрес уже привязан.");
		Возврат;
	КонецЕсли;

	// Ручной выбор ЗАКРЕПЛЯЕТ адрес: иначе ближайший прогон PEDO-UpdateLinks вернёт свой.
	Текст = "Привязать контрагенту адрес" + Символы.ПС + ТекущиеДанные.Адрес + Символы.ПС
		+ "(" + ТекущиеДанные.Оператор + ", связь: " + ТекущиеДанные.Связь + ")?" + Символы.ПС + Символы.ПС
		+ "Адрес будет закреплён — регламент обновления связей его больше не поменяет.";
	ПоказатьВопрос(Новый ОписаниеОповещения("ПривязатьАдресЗавершение", ЭтотОбъект, ТекущиеДанные.Адрес),
		Текст, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПривязатьАдресЗавершение(Ответ, Адрес) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Сообщение = ПривязатьАдресНаСервере(Адрес);
	ЗагрузитьИзПлатформыОтложенно();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьXMLОтправки(Команда)

	ТекущиеДанные = Элементы.История.ТекущиеДанные;
	Если НЕ ЕстьИдентификаторКарточки(ТекущиеДанные) Тогда
		Возврат;
	КонецЕсли;

	Состояние("Состояние ЭДО", , "Забираю XML из Платформы…");
	ОтветПлатформы = СодержимоеКарточкиНаСервере(ТекущиеДанные.Идентификатор, "xml");
	Состояние();

	Если ЗначениеЗаполнено(ОтветПлатформы.Ошибка) Тогда
		ПоказатьПредупреждение(, ОтветПлатформы.Ошибка);
		Возврат;
	КонецЕсли;

	// Показываем в окне текстового документа, а не файлом на диске (решение оператора 25.08):
	// XML смотрят глазами и тут же закрывают, а сохранить его можно из самого окна.
	ДокументXML = Новый ТекстовыйДокумент;
	ДокументXML.УстановитьТекст(ОтветПлатформы.Текст);
	ДокументXML.ТолькоПросмотр = Истина;
	ДокументXML.Показать("XML отправки " + СокрЛП(ТекущиеДанные.Идентификатор));

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНаСайте(Команда)

	ТекущиеДанные = Элементы.История.ТекущиеДанные;
	Если НЕ ЕстьИдентификаторКарточки(ТекущиеДанные) Тогда
		Возврат;
	КонецЕсли;

	// Ссылка КОРОТКАЯ, без гидов. Сначала я добавляла `?sender-gid=&recipient-gid=` -
	// их читает `useDocumentLinkHandler` в коде самого ЛК, чтобы выбрать компанию при
	// мультилогине. Проверка оператора в бою 25.08 показала обратное: с параметрами страница
	// НЕ открывается, без них открывается. Вывод из чужого кода проиграл проверке фактом.
	СсылкаНаДокумент = "https://edo.platformaofd.ru/outgoing/" + СокрЛП(ТекущиеДанные.Идентификатор);

	// ПерейтиПоНавигационнойСсылке доступен из УПРАВЛЯЕМЫХ форм в любом режиме приложения
	// и недоступен из обычных. Граница проходит по типу формы, а не по режиму запуска
	// и не по клиенту.
	//
	// Эта форма управляемая, поэтому метод здесь доступен всегда. Ветка с ЗапуститьПриложение
	// оставлена для случая, когда тот же код вызывается из обычной формы: там метода нет,
	// и ссылку отдаём оболочке ОС, которая откроет браузер по умолчанию.
#Если ТолстыйКлиентОбычноеПриложение Тогда
	ЗапуститьПриложение(СсылкаНаДокумент);
#Иначе
	ПерейтиПоНавигационнойСсылке(СсылкаНаДокумент);
#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура ПечатнаяФормаПлатформы(Команда)

	ТекущиеДанные = Элементы.История.ТекущиеДанные;
	Если НЕ ЕстьИдентификаторКарточки(ТекущиеДанные) Тогда
		Возврат;
	КонецЕсли;

	Состояние("Состояние ЭДО", , "Запрашиваю печатную форму…");
	ОтветПлатформы = СодержимоеКарточкиНаСервере(ТекущиеДанные.Идентификатор, "pdf");
	Состояние();

	Если ЗначениеЗаполнено(ОтветПлатформы.Ошибка) Тогда
		ПоказатьПредупреждение(, ОтветПлатформы.Ошибка);
		Возврат;
	КонецЕсли;

	Попытка
		ДанныеПечати = ПолучитьИзВременногоХранилища(ОтветПлатформы.Адрес);
		ИмяФайлаПечати = КаталогВременныхФайлов() + "ПлатформаЭДО_"
			+ СокрЛП(ТекущиеДанные.Идентификатор) + ".pdf";
		ДанныеПечати.Записать(ИмяФайлаПечати);
		ЗапуститьПриложение(ИмяФайлаПечати);
	Исключение
		ПоказатьПредупреждение(, "Печатная форма получена, но открыть ее не удалось: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗагрузитьИзПлатформыОтложенно()

	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;

	Состояние("Состояние ЭДО", , "Запрашиваю Платформу…");
	ЗаполнитьИзПлатформыНаСервере();
	Состояние();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзБазы()

	// Подпись поля зависит от вида документа: "Накладная" для реализации, "Акт сверки" для акта.
	Элементы.Накладная.Заголовок = ?(ЭтоАктСверки(), "Акт сверки", "Накладная");

	Накладная = СокрЛП(ДокументСсылка.Номер) + " от " + Формат(ДокументСсылка.Дата, "ДФ=dd.MM.yyyy");
	КонтрагентПредставление = Строка(ДокументСсылка.Контрагент);

	// статус, который показывает колонка "ЭДО": его пишет регламент PEDO-StatusSync
	СвойствоСтатус = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_Состояние");
	Если СвойствоСтатус <> Неопределено И НЕ СвойствоСтатус.Пустая() Тогда
		ТекущийСтатус = ЗначениеСвойства(ДокументСсылка, СвойствоСтатус);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекущийСтатус) Тогда
		ТекущийСтатус = "в ЭДО не отправлялся";
	КонецЕсли;

	// статус соглашения (связи) с контрагентом
	// Метода ЭДО_Сервер.СтатусСвязиЭДО в боевой сборке расширения (1.0.4.0) НЕТ, хотя
	// в исходниках он есть - падать из-за него нельзя, значение достаём и напрямую из свойства.
	Соглашение = "";
	Попытка
		Соглашение = Строка(ЭДО_Сервер.СтатусСвязиЭДО(ДокументСсылка.Контрагент));
	Исключение
		СвойствоСвязи = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_СтатусСвязи");
		Если СвойствоСвязи <> Неопределено И НЕ СвойствоСвязи.Пустая() Тогда
			Соглашение = ЗначениеСвойства(ДокументСсылка.Контрагент, СвойствоСвязи);
		КонецЕсли;
	КонецПопытки;
	СтатусСоглашения = ПредставлениеСоглашения(Соглашение);

	// привязанный адрес ЭДО и его оператор (постановка оператора 23.08)
	ИдентификаторЭДО = ИдентификаторКонтрагента(ДокументСсылка.Контрагент);
	ОператорЭДО = ИмяОператора(ИдентификаторЭДО);

КонецПроцедуры

&НаСервере
Функция ЭтоАктСверки()
	Возврат ЗначениеЗаполнено(ДокументСсылка)
		И ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АктСверкиВзаиморасчетов");
КонецФункции

&НаСервере
Функция ЗначениеСвойства(Объект, Свойство)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Значения.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК Значения
		|ГДЕ
		|	Значения.Объект = &Объект
		|	И Значения.Свойство = &Свойство");
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Строка(Выборка.Значение));
	КонецЕсли;
	Возврат "";

КонецФункции

&НаСервере
Функция ПредставлениеСоглашения(Знач Код)

	Код = ВРег(СокрЛП(Код));
	Если Код = "ESTABLISHED" Тогда
		Возврат "ESTABLISHED — связь установлена, отправлять можно";
	ИначеЕсли Код = "NO_CONTACT" Тогда
		Возврат "NO_CONTACT — приглашение не принято, документы не дойдут";
	ИначеЕсли Код = "BROKEN" Тогда
		Возврат "BROKEN — связь разорвана, нужно повторное приглашение";
	ИначеЕсли НЕ ЗначениеЗаполнено(Код) Тогда
		Возврат "неизвестно — связь ни разу не проверялась";
	КонецЕсли;
	Возврат Код;

КонецФункции

&НаСервере
Процедура ЗаполнитьИзПлатформыНаСервере()

	// Собираем в обычную таблицу значений, а не прямо в реквизит формы: реквизит-таблица
	// в управляемой форме - ДанныеФормыКоллекция, а у неё нет методов таблицы значений
	// (в том числе Сортировать). В форму кладём готовое через ЗначениеВРеквизитФормы.
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Создан", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("Оператор", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Тип", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Причина", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)));
	Таблица.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(30)));

	Сообщение = "";

	Попытка
		Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Ложь) Тогда
			Сообщение = "Не удалось получить токен Платформы — история не загружена.";
			ЗавершитьИсторию(Таблица);
			Возврат;
		КонецЕсли;
		Токен = ЭДО_Сервер.ТекущийТокен();
		НашГид = ЭДО_Сервер.ГидОрганизации();

		Защита = Новый ЗащищенноеСоединениеOpenSSL(Новый СертификатКлиентаWindows(), Неопределено);
		Соединение = Новый HTTPСоединение("edo.platformaofd.ru", 443, , , , 20, Защита);

 // История ищется по ВСЕМ адресам контрагента, а не по привязанному сейчас.
 // Отправка уходит на тот адрес, что был привязан ТОГДА; адрес потом меняют (клиент
 // перешел к другому оператору) - и история по текущему адресу пуста ровно в том
 // случае, ради которого карточку и открывают.
 // Платформа принимает несколько recipient_id в одном запросе и отдает объединение
 // (проверено 25.08.2026: 2 + 2 карточки = 4) - лишних запросов это не стоит.
		ТекущийАдрес = СокрЛП(ИдентификаторЭДО);
		СписокАдресов = Новый Массив;
		Если ЗначениеЗаполнено(ТекущийАдрес) Тогда
			СписокАдресов.Добавить(ТекущийАдрес);
		КонецЕсли;
		НеполныйСписок = Ложь;

		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
		Заголовки.Вставить("accept", "application/json;charset=UTF-8");
		Реквизиты = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(ДокументСсылка.Контрагент, "ИНН, КПП");
		Для Каждого АдресКарточки Из ПривязанныеАдресаПоИНН(Реквизиты.ИНН) Цикл
			Если СписокАдресов.Найти(АдресКарточки) = Неопределено Тогда
				СписокАдресов.Добавить(АдресКарточки);
			КонецЕсли;
		КонецЦикла;
		Если ЗначениеЗаполнено(СокрЛП(Реквизиты.ИНН)) Тогда
 // Реестр ФНС отвечает за ~0,2 с, поэтому его можно спрашивать при каждом открытии;
 // статусы связей (пачками по 50) остаются на кнопке "Обновить список".
			Попытка
				Реестр = АдресаКонтрагентаИзРеестра(Соединение, Заголовки,
					СокрЛП(Реквизиты.ИНН), СокрЛП(Реквизиты.КПП));
				Если Реестр.Ошибка Тогда
					НеполныйСписок = Истина;
				Иначе
					Для Каждого АдресРеестра Из Реестр.Адреса Цикл
						Если СписокАдресов.Найти(СокрЛП(АдресРеестра)) = Неопределено Тогда
							СписокАдресов.Добавить(СокрЛП(АдресРеестра));
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			Исключение
				НеполныйСписок = Истина;
			КонецПопытки;
		Иначе
			НеполныйСписок = Истина;
		КонецЕсли;

		Если СписокАдресов.Количество() = 0 Тогда
			Сообщение = "У контрагента нет ни привязанного адреса ЭДО, ни адресов в реестре ФНС —"
				+ " искать в Платформе не по чему.";
			ЗавершитьИсторию(Таблица);
			Возврат;
		КонецЕсли;

 // Интервал дат в запросе ОБЯЗАТЕЛЕН - без него Платформа отвечает 400.
 // И он не может быть шире 31 дня: "Time interval must be less than or equals to
 // 31 days" (проверено 25.08.2026 - 30 дней проходит, 31 уже нет) - длинный период
 // режем на окна. Дефект виден только на документе старше месяца: на свежих запрос
 // проходит, и до сих пор это не всплывало.
		Финиш = НачалоДня(ТекущаяУниверсальнаяДата());
 // день запаса слева: дата накладной местная, а окно запроса - UTC
		НачалоПоиска = НачалоДня(ДокументСсылка.Дата) - 86400;
 // потолок глубины - 6 окон: дальше история не нужна, а запросы стоят времени открытия
		ГраницаПоиска = Финиш - 185 * 86400;
		ПоискУсечен = Ложь;
		Если НачалоПоиска < ГраницаПоиска Тогда
			НачалоПоиска = ГраницаПоиска;
			ПоискУсечен = Истина;
		КонецЕсли;
		Окна = Новый Массив;
		НачалоОкна = НачалоПоиска;
		Пока НачалоОкна <= Финиш Цикл
			КонецОкна = НачалоОкна + 30 * 86400;
			Если КонецОкна > Финиш Тогда
				КонецОкна = Финиш;
			КонецЕсли;
			Окна.Добавить(Новый Структура("Нач, Кон", НачалоОкна, КонецОкна));
			НачалоОкна = КонецОкна + 86400;
		КонецЦикла;

		ХвостАдресов = "";
		Для Каждого АдресПоиска Из СписокАдресов Цикл
			ХвостАдресов = ХвостАдресов + "&recipient_id=" + АдресПоиска;
		КонецЦикла;

		НомерНакладной = СокрЛП(ДокументСсылка.Номер);
		ДатаНакладной = Формат(ДокументСсылка.Дата, "ДФ=dd.MM.yyyy");
		Операторы = ТаблицаОператоров();
		РазмерСтраницы = 100;
		ВыборкаОборвалась = Ложь;

		Контекст = Новый Структура("Токен", Токен);
		Обход = ПрочитатьКарточки(Соединение, Контекст, ХвостАдресов, Окна, Таблица, Операторы,
			НомерНакладной, ДатаНакладной);
		ВыборкаОборвалась = Обход.Оборвалось;
		Сообщение = Обход.Сообщение;

 // Документ мог уйти на адрес, которого нет НИ у контрагента сейчас, НИ в реестре ФНС -
 // это отдельный живой класс ("рабочий адрес расходится с фактическим маршрутом").
 // По адресам такую отправку не найти вовсе - последняя попытка: тот же период сплошным
 // обходом без фильтра по получателю. Стоит дороже, поэтому только когда иначе пусто.
		СплошнойОбход = Ложь;
		Если Таблица.Количество() = 0 И НЕ ВыборкаОборвалась Тогда
			ОбходСплошной = ПрочитатьКарточки(Соединение, Контекст, "", Окна, Таблица, Операторы,
				НомерНакладной, ДатаНакладной);
			ВыборкаОборвалась = ОбходСплошной.Оборвалось;
			Если ЗначениеЗаполнено(ОбходСплошной.Сообщение) Тогда
				Сообщение = ОбходСплошной.Сообщение;
			КонецЕсли;
			СплошнойОбход = (Таблица.Количество() > 0);
		КонецЕсли;

		Таблица.Сортировать("Создан Убыв");

 // Причина отказа в самой карточке отсутствует - добираем ее из цепочки документа.
		ДополнитьПричинамиИзЦепочек(Соединение, Контекст, Таблица);

		Если Таблица.Количество() = 0 Тогда
			Если НЕ ВыборкаОборвалась Тогда
				Сообщение = "В Платформе по этой накладной отправок не найдено — искали и по адресам"
					+ " контрагента (" + СписокАдресов.Количество() + "), и сплошным обходом периода."
					+ ?(НеполныйСписок, " ⚠ Реестр ФНС не ответил, список адресов может быть неполным.", "")
					+ ?(ПоискУсечен, " ⚠ Искали за последние полгода: документ старше.", "");
			КонецЕсли;
		Иначе
 // Актуальна самая свежая карточка: переотправка создаёт новую, а прежние остаются
 // в своих статусах и никуда не деваются - ради этого история и показывается.
			Последняя = Таблица[0];
 // Пересобираем хвост, а не дописываем: ЗаполнитьИзПлатформыНаСервере зовётся
	// и при открытии, и при "Обновить", и после каждой отправки - дописывание давало
	// "в Платформе: ... в Платформе: ... в Платформе: ..." по числу нажатий (07.09).
	ПозХвоста = Найти(ТекущийСтатус, "  ·  в Платформе: ");
	Если ПозХвоста > 0 Тогда
		ТекущийСтатус = Лев(ТекущийСтатус, ПозХвоста - 1);
	КонецЕсли;
	ТекущийСтатус = ТекущийСтатус + "  ·  в Платформе: " + Последняя.Статус
				+ " от " + Формат(Последняя.Создан, "ДФ=dd.MM.yyyy HH:mm")
				+ ?(Таблица.Количество() > 1, "  (отправок: " + Таблица.Количество() + ")", "");
			Сообщение = Последняя.Причина;
			Если СплошнойОбход Тогда
				Сообщение = "Отправка найдена сплошным обходом: ее получателя нет ни у контрагента"
					+ " сейчас, ни в реестре ФНС."
					+ ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");
			КонецЕсли;
 // Главное, ради чего история берется по всем адресам: сказать прямо, что документ
 // ушел не туда, куда контрагент привязан сейчас.
			Если ЗначениеЗаполнено(ТекущийАдрес)
				И ЗначениеЗаполнено(Последняя.Адрес)
				И ВРег(Последняя.Адрес) <> ВРег(ТекущийАдрес) Тогда
				Сообщение = "Последняя отправка ушла на другой адрес: " + Последняя.Оператор
					+ " (" + Последняя.Адрес + "). Сейчас у контрагента привязан " + ОператорЭДО + "."
					+ ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");
			КонецЕсли;

 // Колонка "ЭДО" в списке ведется регламентом раз в час и потому отстает от Платформы
 // до часа: бухгалтер видит "Отправляется", когда документ уже завернут. Раз карточка
 // все равно спросила Платформу вживую - дописываем свежий статус сразу
 // (просьба оператора 25.08.2026).
			ОбновленнаяКолонка = ЗаписатьСтатусПлатформыВКолонку(Последняя.Статус);
			Если ЗначениеЗаполнено(ОбновленнаяКолонка) Тогда
				Сообщение = "Колонка «ЭДО» обновлена: " + ОбновленнаяКолонка
					+ ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");
			КонецЕсли;
		КонецЕсли;

	Исключение
		Сообщение = "Ошибка обращения к Платформе: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЗавершитьИсторию(Таблица);

КонецПроцедуры

&НаСервере
Процедура ЗавершитьИсторию(Таблица)

	// Единственный выход истории в форму: у процедуры заполнения три точки возврата, и строка
	// СБИС должна появляться во всех - в том числе когда Платформа вообще не ответила.
	Если ДобавитьОтправкуСБИС(Таблица) Тогда
		Сообщение = "Была отправка через СБИС (старая интеграция): в Платформе её нет по устройству,"
			+ " показана отдельной строкой и без времени отправки."
			+ ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");
	КонецЕсли;

	Таблица.Сортировать("Создан Убыв");
	ЗначениеВРеквизитФормы(Таблица, "История");

КонецПроцедуры

&НаСервере
Функция ДобавитьОтправкуСБИС(Таблица)

	// Отправок старой интеграции со СБИС в API Платформы нет ВООБЩЕ - это другой канал,
	// и появиться там они не могут. След остаётся только в базе, свойствами объекта
	// (в prodline 185 766 документов с отметкой СБИС против 3 692 с ОФД_ЭДО_*).
	// Без этой строки карточка документа, отправленного до перехода, выглядит так, будто
	// отправки не было вовсе - ровно на это и пожаловался оператор 26.08.2026.
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	СтатусСБИС = "";
	ИдСБИС = "";
	Попытка
		СвойствоСтатусаСБИС = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ДокументСБИС_Статус");
		Если СвойствоСтатусаСБИС <> Неопределено И НЕ СвойствоСтатусаСБИС.Пустая() Тогда
			СтатусСБИС = СокрЛП(ЗначениеСвойства(ДокументСсылка, СвойствоСтатусаСБИС));
		КонецЕсли;
		СвойствоИдаСБИС = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ДокументСБИС_Ид");
		Если СвойствоИдаСБИС <> Неопределено И НЕ СвойствоИдаСБИС.Пустая() Тогда
			ИдСБИС = СокрЛП(ЗначениеСвойства(ДокументСсылка, СвойствоИдаСБИС));
		КонецЕсли;
	Исключение
 // история Платформы важнее: молча остаёмся без строки СБИС, но карточку не роняем
		Возврат Ложь;
	КонецПопытки;

	Если НЕ ЗначениеЗаполнено(СтатусСБИС) И НЕ ЗначениеЗаполнено(ИдСБИС) Тогда
		Возврат Ложь;
	КонецЕсли;

	СтрокаСБИС = Таблица.Добавить();
	// Времени ОТПРАВКИ в базе нет: регистр ЗначенияСвойствОбъектов непериодический, а UUID
	// в ДокументСБИС_Ид - версии 1 и разбирается в момент СОЗДАНИЯ документа, а не отправки
	// (замер 26.08.2026: 06.08 14:07 при документе от 14:07:30) - ставим дату документа
	// и говорим об этом прямо, а не выдаём время создания за время отправки.
	СтрокаСБИС.Создан = НачалоДня(ДокументСсылка.Дата);
	СтрокаСБИС.Оператор = "СБИС";
	// Статусы СБИС - свободный текст, включая "Ошибка: ..." на сотни знаков; к статусам Платформы
	// они не сводятся - в колонку идёт короткая часть, целиком текст уходит в причину.
	СтрокаСБИС.Статус = ?(ВРег(Лев(СтатусСБИС, 6)) = "ОШИБКА", "Ошибка", Лев(СтатусСБИС, 50));
	СтрокаСБИС.Тип = "старая интеграция";
	СтрокаСБИС.Причина = "Отправка через СБИС. Время отправки в базе не хранится — показана дата"
		+ " документа."
		+ ?(ЗначениеЗаполнено(СтатусСБИС), " Статус СБИС: " + СтатусСБИС + ".", "")
		+ ?(ЗначениеЗаполнено(ИдСБИС), " Ид СБИС: " + ИдСБИС + ".", "");
	// Идентификатор оставлен пустым НАМЕРЕННО: по нему кнопки "Открыть XML", "Печатная форма"
	// и "Открыть на сайте" ходят в Платформу, а карточки СБИС там нет.

	Возврат Истина;

КонецФункции

&НаСервере
Функция АдресаКонтрагентаИзРеестра(Соединение, Заголовки, Знач ИНН, Знач КПП)

	// Пустой список от реестра НЕ значит "адресов нет": с протухшим токеном вендорская
	// функция отвечает ровно так же - Ошибка = Нет и ноль адресов (замер 25.08.2026).
	// А токен живет 15 минут при обновлении раз в час - в карточке он протухший почти
	// всегда. Поэтому на пустой ответ перевыпускаем токен и спрашиваем еще раз.
	Реестр = ЭДО_Сервер.АдресаИзРеестраФНС(Соединение, Заголовки, ИНН, КПП);
	Если Реестр.Ошибка ИЛИ Реестр.Адреса.Количество() = 0 Тогда
		Если ЭДО_Сервер.ОбеспечитьТокен(Истина) Тогда
			Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен());
			Реестр = ЭДО_Сервер.АдресаИзРеестраФНС(Соединение, Заголовки, ИНН, КПП);
		КонецЕсли;
	КонецЕсли;
	Возврат Реестр;

КонецФункции

&НаСервере
Функция ПрочитатьКарточки(Соединение, Контекст, ХвостАдресов, Окна, Таблица, Операторы,
	Знач НомерНакладной, Знач ДатаНакладной)

	// Обходит период окнами и страницами, добирая в Таблицу карточки этой накладной.
	// Токен живет в Контексте, а не в параметре: при 401 он перевыпускается прямо здесь,
	// и вызывающему нужен уже новый - иначе второй обход снова упрется в 401.
	Итог = Новый Структура("Оборвалось, Сообщение", Ложь, "");
	РазмерСтраницы = 100;

	Для Каждого ОкноПериода Из Окна Цикл
		ОтДата = Формат(ОкноПериода.Нач, "ДФ=yyyy-MM-dd") + "T00:00:00.000Z";
		ДоДата = Формат(ОкноПериода.Кон, "ДФ=yyyy-MM-dd") + "T23:59:59.000Z";

 // Страницы: за длинный период 100 карточек не хватает, а "сколько всего" Платформа
 // не сообщает - идем, пока страница полная.
		Для Страница = 0 По 9 Цикл
			Путь = "/document/public/api/v3/documents?created_from=" + ОтДата
				+ "&created_till=" + ДоДата
				+ "&sender_id=" + ЭДО_Сервер.ГидОрганизации()
				+ ХвостАдресов
				+ "&page=" + Страница + "&page_size=" + РазмерСтраницы;

			Карточки = Неопределено;
			БылоНеПринятиеТокена = Ложь;
 // У Платформы бывают аварии, когда треть запросов виснет по таймауту - три попытки.
			Для НомерПопытки = 1 По 3 Цикл
				ЗапросПлатформы = Новый HTTPЗапрос(Путь);
				ЗапросПлатформы.Заголовки.Вставить("Authorization", "Bearer " + Контекст.Токен);
				ЗапросПлатформы.Заголовки.Вставить("accept", "application/json;charset=UTF-8");
				Попытка
					ОтветПлатформы = Соединение.Получить(ЗапросПлатформы);
				Исключение
					Продолжить;
				КонецПопытки;
				Если ОтветПлатформы.КодСостояния = 401 Тогда
 // ОбеспечитьТокен(Ложь) отвечает "Да" по факту НАЛИЧИЯ токена, а он может быть
 // протухшим - 401 здесь штатное дело, лечится перевыпуском. А вот если и
 // перевыпуск не помог - это надо сказать прямо, а не выдавать за таймаут.
					БылоНеПринятиеТокена = Истина;
					ЭДО_Сервер.ОбеспечитьТокен(Истина);
					Контекст.Токен = ЭДО_Сервер.ТекущийТокен();
					Продолжить;
				КонецЕсли;
				БылоНеПринятиеТокена = Ложь;
				Если ОтветПлатформы.КодСостояния <> 200 Тогда
					Итог.Сообщение = "Платформа ответила HTTP " + ОтветПлатформы.КодСостояния + ": "
						+ Лев(ОтветПлатформы.ПолучитьТелоКакСтроку("UTF-8"), 200);
					Итог.Оборвалось = Истина;
					Прервать;
				КонецЕсли;
				ЧтениеОтвета = Новый ЧтениеJSON;
				ЧтениеОтвета.УстановитьСтроку(ОтветПлатформы.ПолучитьТелоКакСтроку("UTF-8"));
				Карточки = ПрочитатьJSON(ЧтениеОтвета, Ложь);
				ЧтениеОтвета.Закрыть();
				Прервать;
			КонецЦикла;

			Если Итог.Оборвалось Тогда
				Прервать;
			КонецЕсли;
			Если Карточки = Неопределено Тогда
				Если БылоНеПринятиеТокена Тогда
					Итог.Сообщение = "Платформа не приняла токен (HTTP 401), и перевыпустить его не удалось."
						+ " История не загружена — проверьте подпись и настройки ЭДО.";
				Иначе
					Итог.Сообщение = "Платформа не отвечает (таймаут). Нажмите «Обновить»;"
						+ " статус в шапке взят из базы.";
				КонецЕсли;
				Итог.Оборвалось = Истина;
				Прервать;
			КонецЕсли;

			Для Каждого Карточка Из Карточки Цикл
				Если НЕ Карточка.Свойство("invoice") ИЛИ Карточка["invoice"] = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Счет = Карточка["invoice"];
				НомерКарточки = ?(Счет.Свойство("num"), СокрЛП(Строка(Счет["num"])), "");
				ДатаКарточки = ?(Счет.Свойство("date"), СокрЛП(Строка(Счет["date"])), "");
 // Ключ - номер И дата: номер накладной повторяется по годам.
				Если НомерКарточки <> НомерНакладной ИЛИ ДатаКарточки <> ДатаНакладной Тогда
					Продолжить;
				КонецЕсли;

 // Адрес получателя КАРТОЧКИ - это и есть ответ "куда ушел документ";
 // имени оператора в ответе API нет, оно опознается по первым трем символам.
				АдресПолучателя = "";
				Если Карточка.Свойство("recipient") И Карточка["recipient"] <> Неопределено
					И Карточка["recipient"].Свойство("id") Тогда
					АдресПолучателя = СокрЛП(Строка(Карточка["recipient"]["id"]));
				КонецЕсли;
 // Ид приходит ЧИСЛОМ, и Строка() вставляет разделители групп ("170 381 707").
 // В колонке это косметика, а в пути запроса Платформа отвечает 400 - только Формат.
				ИдентификаторКарточки = ?(Карточка.Свойство("id"), Формат(Карточка["id"], "ЧГ=0"), "");
 // при сплошном обходе та же карточка может прийти повторно - не задваиваем
				Если ЗначениеЗаполнено(ИдентификаторКарточки)
					И Таблица.НайтиСтроки(Новый Структура("Идентификатор", ИдентификаторКарточки)).Количество() > 0 Тогда
					Продолжить;
				КонецЕсли;

				НоваяСтрока = Таблица.Добавить();
				НоваяСтрока.Идентификатор = ИдентификаторКарточки;
				НоваяСтрока.Статус = ?(Карточка.Свойство("status"), Строка(Карточка["status"]), "");
				НоваяСтрока.Тип = ?(Карточка.Свойство("type"), Строка(Карточка["type"]), "");
				НоваяСтрока.Создан = ДатаИзISO(?(Карточка.Свойство("created"), Строка(Карточка["created"]), ""));
				НоваяСтрока.Причина = ПричинаКарточки(Карточка);
				НоваяСтрока.Адрес = АдресПолучателя;
				НоваяСтрока.Оператор = ИмяОператораПоТаблице(АдресПолучателя, Операторы);
			КонецЦикла;

			Если Карточки.Количество() < РазмерСтраницы Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если Итог.Оборвалось Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

&НаСервере
Функция ПричинаКарточки(Карточка)

	// У SENDING_FAILURE_ACK причина лежит в reason ВЕРХНЕГО уровня, а у прочих - в extra.reason.
	// Читая только extra.reason, получаешь пустоту ровно там, где причина и нужна.
	Если Карточка.Свойство("extra") И Карточка["extra"] <> Неопределено
		И Карточка["extra"].Свойство("reason") Тогда
		Значение = Строка(Карточка["extra"]["reason"]);
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Лев(Значение, 500);
		КонецЕсли;
	КонецЕсли;
	Если Карточка.Свойство("reason") И Карточка["reason"] <> Неопределено Тогда
		Возврат Лев(Строка(Карточка["reason"]), 500);
	КонецЕсли;
	Возврат "";

КонецФункции

&НаСервере
Функция ДатаИзISO(Знач Текст)

	// Платформа отдаёт UTC вида 2026-08-21T07:11:36.448710Z.
	// Показываем МЕСТНОЕ время: разъезд на пять часов при разборе инцидента стоит дорого.
	Если СтрДлина(Текст) < 19 Тогда
		Возврат '00010101';
	КонецЕсли;
	Попытка
		ДатаUTC = Дата(Число(Сред(Текст, 1, 4)), Число(Сред(Текст, 6, 2)), Число(Сред(Текст, 9, 2)),
			Число(Сред(Текст, 12, 2)), Число(Сред(Текст, 15, 2)), Число(Сред(Текст, 18, 2)));
	Исключение
		Возврат '00010101';
	КонецПопытки;
	Возврат МестноеВремя(ДатаUTC);

КонецФункции

&НаСервереБезКонтекста
Функция ИдентификаторКонтрагента(Контрагент)

	Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_АдресКонтрагента");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Значения.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК Значения
		|ГДЕ
		|	Значения.Объект = &Объект
		|	И Значения.Свойство = &Свойство");
	Запрос.УстановитьПараметр("Объект", Контрагент);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Строка(Выборка.Значение));
	КонецЕсли;
	Возврат "";

КонецФункции

&НаСервереБезКонтекста
Функция ТаблицаОператоров()

	// Имени оператора в ответе API НЕТ - оно опознается по первым трем символам адреса.
	// Таблица "код название" лежит в макете "СлужебныеДанные" обработки вендора
	// (27 строк: 2VO Платформа ЭДО, 2BE СБИС, 2AL Такском, 2BM Диадок, 2AE Калуга-Астрал...).
	// Макет читается ОДИН раз на всю историю: строк в ней бывает десяток, а чтение макета
	// на каждую строку - это лишние секунды на открытии карточки.
	Операторы = Новый Соответствие;
	Попытка
		Макет = Обработки.ЭДО_ПлатформаЭДО.ПолучитьМакет("СлужебныеДанные");
	Исключение
		Возврат Операторы;
	КонецПопытки;

	Для НомерСтроки = 1 По Макет.ВысотаТаблицы Цикл
		Код = ВРег(СокрЛП(Макет.Область(НомерСтроки, 1, НомерСтроки, 1).Текст));
		Представление = СокрЛП(Макет.Область(НомерСтроки, 2, НомерСтроки, 2).Текст);
		Если СтрДлина(Код) = 3 И ЗначениеЗаполнено(Представление) Тогда
			Операторы.Вставить(Код, Представление);
		КонецЕсли;
	КонецЦикла;

	Возврат Операторы;

КонецФункции

&НаСервереБезКонтекста
Функция ИмяОператораПоТаблице(Знач Адрес, Операторы)

	// Дефиса после кода может не быть: у СБИС адрес выглядит как "2BE140397E1B..." -
	// поэтому режем ровно три символа, а не до разделителя.
	Адрес = СокрЛП(Адрес);
	Если СтрДлина(Адрес) < 3 Тогда
		Возврат "";
	КонецЕсли;
	Код = ВРег(Лев(Адрес, 3));

	Если Операторы.Количество() = 0 Тогда
		Возврат Код;
	КонецЕсли;
	Представление = Операторы.Получить(Код);
	Возврат ?(Представление = Неопределено, Код + " (оператор не опознан)", Представление);

КонецФункции

&НаСервереБезКонтекста
Функция ИмяОператора(Знач Адрес)

	Возврат ИмяОператораПоТаблице(Адрес, ТаблицаОператоров());

КонецФункции

&НаСервере
Функция ОтправитьНаСервере(Знач ПреодолеваемыйГейт = "")

	ИтогОтправки = Новый Структура("Успех, Заголовок, Текст, КодПричины",
		Ложь, "Документ не отправлен", "", "");

	СвойствоСтатус = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_КодСостояния");
	ПрежнийСтатус = "";
	Если СвойствоСтатус <> Неопределено И НЕ СвойствоСтатус.Пустая() Тогда
		ПрежнийСтатус = ЗначениеСвойства(ДокументСсылка, СвойствоСтатус);
	КонецЕсли;

	Если ЗначениеЗаполнено(ПрежнийСтатус) Тогда
		КодСтатуса = 0;
		Попытка
			КодСтатуса = Число(ПрежнийСтатус);
		Исключение
			КодСтатуса = 0;
		КонецПопытки;
		Если КодСтатуса = 1 Тогда
			Сообщение = "Документ прямо сейчас взят в отправку другим сеансом (регламент или соседний"
				+ " пользователь). Подождите и нажмите «Обновить».";
			ИтогОтправки.Текст = Сообщение;
			Возврат ИтогОтправки;
		ИначеЕсли КодСтатуса = 10 Тогда
 // Статус 10 - связь оборвалась ДО получения id: POST мог пройти и не вернуть ответ.
 // Автоматический повтор здесь запрещен, он и есть источник дублей.
			Сообщение = "Прошлая отправка оборвалась, и неизвестно, создался ли экземпляр у оператора."
				+ " Сверьте документ по номеру накладной в личном кабинете и снимите отметку вручную —"
				+ " автоматический повтор здесь запрещен, он даст дубль.";
			ИтогОтправки.Текст = Сообщение;
			Возврат ИтогОтправки;
		КонецЕсли;
 // Без снятия отметки ОтправитьПоЭДО отвечает "Документ уже отправлялся (статус ЭДО 40)"
 // и ничего не делает. ОсвободитьДокумент для этого не годится: она снимает только
 // свою отметку "взят" (статус 1).
		Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
		Набор.Отбор.Объект.Установить(ДокументСсылка);
		Набор.Отбор.Свойство.Установить(СвойствоСтатус);
		Набор.Записать();
	КонецЕсли;

	Итог = "";
	Успех = Ложь;
	// "Не отправлен по решению механизма" - это НЕ поломка: удержание до выяснения канала,
	// отсев (отправка не требуется) и занятость документа другим сеансом. Ошибкой считаем
	// только сбой отправки, иначе пользователь идет чинить то, что работает как задумано.
	ЭтоОшибка = Истина;
	Попытка
 // У акта сверки другой формат ФНС и свой сборщик XML - движок вендора в этой
 // ветке не участвует, поэтому и точка входа в ядре отдельная.
		Разрешения = ЭДО_Сервер.НовыеРазрешенияОператора();
		Разрешения.ОтправитьРаньшеДатыНачала = (ПреодолеваемыйГейт = "ДатаНачалаОтправки");
		Разрешения.ОтправитьПовторноПослеСБИС = (ПреодолеваемыйГейт = "ОтправлялсяЧерезСБИС");
		РезультатОтправки = ?(ЭтоАктСверки(),
			ЭДО_Сервер.ОтправитьАктСверкиПоЭДО(ДокументСсылка),
			ЭДО_Сервер.ОтправитьПоЭДО(ДокументСсылка, , Разрешения));
 // Код причины есть не у всех точек входа (у акта сверки своя) - читаем через Свойство.
		КодОтказа = "";
		РезультатОтправки.Свойство("КодПричины", КодОтказа);
		ИтогОтправки.КодПричины = КодОтказа;
		Успех = (РезультатОтправки.Статус = "Отправлен");
		ЭтоОшибка = НЕ Успех
			И РезультатОтправки.Статус <> "ТребуетВнимания"
			И РезультатОтправки.Статус <> "Отсеян"
			И РезультатОтправки.Статус <> "Пропущен";
 // Пользователю нужна ПРИЧИНА, а не внутренний статус механизма: "Пропущен",
 // "Отсеян", "ТребуетВнимания" ему ничего не говорят и путают (замечание оператора
 // 07.09). Статус остаётся в журнале регистрации и в служебных сообщениях.
		Итог = ?(ЗначениеЗаполнено(РезультатОтправки.Сообщение), РезультатОтправки.Сообщение,
			?(Успех, "Отправлен", "Механизм отправки документ не пропустил"))
			+ ?(ЗначениеЗаполнено(РезультатОтправки.ИдДокумента),
				" (карточка " + Строка(РезультатОтправки.ИдДокумента) + ")", "");
	Исключение
		Итог = "Ошибка отправки: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Отметку сняли ДО отправки, и если отправка не удалась, документ остается "никогда не
	// отправлявшимся" - ближайший прогон очереди отправит его сам, хотя экземпляр у оператора
	// уже есть. Возвращаем прежний статус на место.
	Если НЕ Успех И ЗначениеЗаполнено(ПрежнийСтатус) И СвойствоСтатус <> Неопределено Тогда
		Если НЕ ЗначениеЗаполнено(ЗначениеСвойства(ДокументСсылка, СвойствоСтатус)) Тогда
			ЗаписатьСвойство(ДокументСсылка, СвойствоСтатус, ПрежнийСтатус);
			Итог = Итог + " Прежняя отметка отправки возвращена на место.";
		КонецЕсли;
	КонецЕсли;

	// Перечитывание формы не имеет права съесть результат отправки: обращение к Платформе
	// здесь уже вторично (документ отправлен или удержан), а упасть оно может - таймаут,
	// отозванный токен. Раньше такое исключение уносило с собой и текст итога.
	Попытка
		ЗаполнитьИзБазы();
		ЗаполнитьИзПлатформыНаСервере();
	Исключение
		Итог = Итог + " Данные формы обновить не удалось: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + " Нажмите «Обновить».";
	КонецПопытки;
	Сообщение = Итог + ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");

	ИтогОтправки.Успех = Успех;
	ИтогОтправки.Текст = Итог;
	Если Успех Тогда
		ИтогОтправки.Заголовок = "Отправлен в ЭДО";
	ИначеЕсли ЭтоОшибка Тогда
		ИтогОтправки.Заголовок = "Ошибка отправки";
	Иначе
		ИтогОтправки.Заголовок = "Документ не отправлен";
	КонецЕсли;

	Возврат ИтогОтправки;

КонецФункции

&НаСервереБезКонтекста
Функция ПривязанныеАдресаПоИНН(Знач ИНН)

	// У одного ИНН в базе бывает НЕСКОЛЬКО карточек контрагента (у Сагдиева "кэш" и "регион"),
	// и привязанный адрес у них может отличаться. Реестр ФНС такие адреса обычно отдает,
	// но не обязан: адрес, привязанный в базе руками, в реестре может не значиться вовсе.
	Адреса = Новый Массив;
	Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_АдресКонтрагента");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() ИЛИ НЕ ЗначениеЗаполнено(ИНН) Тогда
		Возврат Адреса;
	КонецЕсли;

	// два запроса вместо соединения: измерение "Объект" составное, и соединять его с конкретным
	// справочником - лишний риск на ровном месте
	ЗапросКонтрагентов = Новый Запрос(
		"ВЫБРАТЬ Контрагенты.Ссылка КАК Ссылка
		|ИЗ Справочник.Контрагенты КАК Контрагенты
		|ГДЕ Контрагенты.ИНН = &ИНН");
	ЗапросКонтрагентов.УстановитьПараметр("ИНН", СокрЛП(ИНН));
	СписокКонтрагентов = ЗапросКонтрагентов.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Если СписокКонтрагентов.Количество() = 0 Тогда
		Возврат Адреса;
	КонецЕсли;

	ЗапросЗначений = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ Значения.Значение КАК Значение
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов КАК Значения
		|ГДЕ Значения.Объект В (&Список) И Значения.Свойство = &Свойство");
	ЗапросЗначений.УстановитьПараметр("Список", СписокКонтрагентов);
	ЗапросЗначений.УстановитьПараметр("Свойство", Свойство);
	Выборка = ЗапросЗначений.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Значение = СокрЛП(Строка(Выборка.Значение));
		Если ЗначениеЗаполнено(Значение) И Адреса.Найти(Значение) = Неопределено Тогда
			Адреса.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Адреса;

КонецФункции

&НаСервере
Функция ЗагрузитьАдресаНаСервере()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Текущий", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(3)));
	Таблица.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Оператор", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Связь", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(30)));
	Таблица.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));

	Контрагент = КонтрагентКарточки();
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		ЗначениеВРеквизитФормы(Таблица, "Адреса");
		Возврат "Контрагент не определён.";
	КонецЕсли;

	Реквизиты = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(Контрагент, "ИНН, КПП");
	ИНН = СокрЛП(Реквизиты.ИНН);
	Если НЕ ЗначениеЗаполнено(ИНН) Тогда
		ЗначениеВРеквизитФормы(Таблица, "Адреса");
		Возврат "У контрагента не заполнен ИНН — искать в реестре не по чему.";
	КонецЕсли;

	Дополнение = "";
	Попытка
		Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Ложь) Тогда
			ЗначениеВРеквизитФормы(Таблица, "Адреса");
			Возврат "Не удалось получить токен Платформы.";
		КонецЕсли;

		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен());
		Заголовки.Вставить("accept", "application/json;charset=UTF-8");
		Защита = Новый ЗащищенноеСоединениеOpenSSL(Новый СертификатКлиентаWindows(), Неопределено);
		Соединение = Новый HTTPСоединение("edo.platformaofd.ru", 443, , , , 20, Защита);

		Реестр = АдресаКонтрагентаИзРеестра(Соединение, Заголовки, ИНН, СокрЛП(Реквизиты.КПП));
		Если Реестр.Ошибка Тогда
			Дополнение = "Реестр ФНС не ответил — список может быть неполным.";
		КонецЕсли;

		Связи = Новый Соответствие;
		Если Реестр.Адреса.Количество() > 0 Тогда
			Попытка
				Связи = ЭДО_Сервер.СтатусыСвязейЭДО(Соединение, Заголовки, ЭДО_Сервер.ГидОрганизации(), Реестр.Адреса);
			Исключение
				Дополнение = СокрЛП(Дополнение + " Статусы связей получить не удалось.");
			КонецПопытки;
		КонецЕсли;

		Текущий = ИдентификаторКонтрагента(Контрагент);
		Операторы = ТаблицаОператоров();
		Для Каждого Адрес Из Реестр.Адреса Цикл
			НоваяСтрока = Таблица.Добавить();
			НоваяСтрока.Адрес = Адрес;
			НоваяСтрока.Оператор = ИмяОператораПоТаблице(Адрес, Операторы);
			НоваяСтрока.Текущий = ?(ВРег(СокрЛП(Адрес)) = ВРег(СокрЛП(Текущий)), "да", "");
			Связь = Связи.Получить(Адрес);
 // Пустая запись != "связи нет": у пары абонентов ОДНОГО оператора (2VO 2VO)
 // роуминговой записи не бывает вовсе, а слать при этом можно.
			НоваяСтрока.Связь = ?(Связь = Неопределено, "—", Строка(Связь.Статус));
		КонецЦикла;

 // адрес, привязанный в базе, мог не попасть в реестр - показываем его отдельной строкой,
 // иначе непонятно, откуда взялся текущий идентификатор
		Если ЗначениеЗаполнено(Текущий) И Таблица.НайтиСтроки(Новый Структура("Адрес", Текущий)).Количество() = 0 Тогда
			НоваяСтрока = Таблица.Добавить();
			НоваяСтрока.Адрес = Текущий;
			НоваяСтрока.Оператор = ИмяОператораПоТаблице(Текущий, Операторы);
			НоваяСтрока.Текущий = "да";
			НоваяСтрока.Связь = "—";
			НоваяСтрока.Наименование = "привязан в базе, в реестре по ИНН/КПП не найден";
		КонецЕсли;

	Исключение
		ЗначениеВРеквизитФормы(Таблица, "Адреса");
		Возврат "Ошибка обращения к Платформе: " + ОписаниеОшибки();
	КонецПопытки;

	Таблица.Сортировать("Текущий Убыв, Оператор Возр");
	ЗначениеВРеквизитФормы(Таблица, "Адреса");

	Если Таблица.Количество() = 0 Тогда
		Возврат СокрЛП("В реестре ФНС по ИНН " + ИНН + " адресов не нашлось. " + Дополнение);
	КонецЕсли;
	Возврат СокрЛП("Адресов найдено: " + Таблица.Количество() + ". " + Дополнение);

КонецФункции

&НаСервере
Функция ПривязатьАдресНаСервере(Знач Адрес)

	Контрагент = КонтрагентКарточки();
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат "Контрагент не определён — привязывать некому.";
	КонецЕсли;

	Адрес = СокрЛП(Адрес);
	СвИд = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_АдресКонтрагента");
	Если СвИд = Неопределено ИЛИ СвИд.Пустая() Тогда
		Возврат "Не найдено свойство ЭДО_АдресКонтрагента.";
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаписатьСвойство(Контрагент, СвИд, Адрес);

 // Закрепление обязательно: без него регламент PEDO-UpdateLinks вернёт свой адрес
 // ближайшей ночью, и ручной выбор окажется бесполезным (решение оператора 23.08).
		СвЗакр = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_АдресЗакреплён");
		Если СвЗакр <> Неопределено И НЕ СвЗакр.Пустая() Тогда
			ЗаписатьСвойство(Контрагент, СвЗакр, Истина);
		КонецЕсли;
		СвОсн = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_ЗакреплениеОснование");
		Если СвОсн <> Неопределено И НЕ СвОсн.Пустая() Тогда
			ЗаписатьСвойство(Контрагент, СвОсн,
				"выбран вручную (" + Строка(ПараметрыСеанса.ТекущийПользователь) + ", "
				+ Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") + ")");
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Возврат "Не удалось записать адрес: " + ОписаниеОшибки();
	КонецПопытки;

	ЗаполнитьИзБазы();
	Возврат "Адрес привязан и закреплён: " + Адрес + " (" + ИмяОператора(Адрес) + ").";

КонецФункции

&НаСервере
Функция КонтрагентКарточки()

	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат ДокументСсылка.Контрагент;
	КонецЕсли;

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьСвойство(Объект, Свойство, Значение)

	// у расширения такая процедура есть, но она не экспортная - повторяем у себя
	Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Объект);
	Набор.Отбор.Свойство.Установить(Свойство);
	Запись = Набор.Добавить();
	Запись.Объект = Объект;
	Запись.Свойство = Свойство;
	Запись.Значение = Значение;
	Набор.Записать();

КонецПроцедуры

&НаКлиенте
Функция ЕстьИдентификаторКарточки(ТекущиеДанные)

	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Сначала выберите строку в истории отправок:"
			+ " XML, ссылка и печатная форма берутся по конкретной отправке.");
		Возврат Ложь;
	КонецЕсли;
	Если СокрЛП(ТекущиеДанные.Оператор) = "СБИС" Тогда
		ПоказатьПредупреждение(, "Это отправка через СБИС (старая интеграция)."
			+ " XML, ссылка в личный кабинет и печатная форма есть только у отправок"
			+ " через Платформу ЭДО.");
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(СокрЛП(ТекущиеДанные.Идентификатор)) Тогда
		ПоказатьПредупреждение(, "У этой строки нет идентификатора карточки в Платформе —"
			+ " показывать нечего.");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаСервере
Функция СодержимоеКарточкиНаСервере(Знач ИдентификаторКарточки, Знач Вид)

	// Вид = "xml" - исходный подписанный титул, который ушел контрагенту;
	// Вид = "pdf" - печатная форма с меткой ЭДО (метод v4, отдельный от контента).
	Итог = Новый Структура("Ошибка, Текст, Адрес", "", "", "");

	Если Вид = "pdf" Тогда
		ПутьЗапроса = "/document/public/api/v4/documents/"
			+ СокрЛП(ИдентификаторКарточки) + "/watermarked-content";
		ТипСодержимого = "";
	Иначе
		ПутьЗапроса = "/document/public/api/v3/documents/"
			+ СокрЛП(ИдентификаторКарточки) + "/content";
		ТипСодержимого = "application/xml";
	КонецЕсли;

	ОтветПлатформы = ПолучитьОтПлатформыНаСервере(ПутьЗапроса, ТипСодержимого);
	Если ЗначениеЗаполнено(ОтветПлатформы.Ошибка) Тогда
		Итог.Ошибка = ОтветПлатформы.Ошибка;
		Возврат Итог;
	КонецЕсли;
	Если ОтветПлатформы.Данные = Неопределено ИЛИ ОтветПлатформы.Данные.Размер() = 0 Тогда
		Итог.Ошибка = "Платформа вернула пустое содержимое карточки "
			+ СокрЛП(ИдентификаторКарточки) + ".";
		Возврат Итог;
	КонецЕсли;

	Если Вид = "pdf" Тогда
		Итог.Адрес = ПоместитьВоВременноеХранилище(ОтветПлатформы.Данные, УникальныйИдентификатор);
	Иначе
 // Титул ФНС отдается в windows-1251. Кодировку не угадываем: если пролог говорит иначе,
 // перечитываем те же байты, а не показываем кракозябры.
		ТекстТитула = ПолучитьСтрокуИзДвоичныхДанных(ОтветПлатформы.Данные, "windows-1251");
		Если Найти(ВРег(Лев(ТекстТитула, 200)), "UTF-8") > 0 Тогда
			ТекстТитула = ПолучитьСтрокуИзДвоичныхДанных(ОтветПлатформы.Данные, "UTF-8");
		КонецЕсли;
		Итог.Текст = ТекстТитула;
	КонецЕсли;

	Возврат Итог;

КонецФункции

&НаСервере
Функция ПолучитьОтПлатформыНаСервере(Знач ПутьЗапроса, Знач ТипСодержимого)

	Итог = Новый Структура("Ошибка, Данные", "", Неопределено);

	Попытка
		Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Ложь) Тогда
			Итог.Ошибка = "Не удалось получить токен Платформы.";
			Возврат Итог;
		КонецЕсли;
		ТокенПлатформы = ЭДО_Сервер.ТекущийТокен();

		ЗащитаСоединения = Новый ЗащищенноеСоединениеOpenSSL(Новый СертификатКлиентаWindows(), Неопределено);
		СоединениеСПлатформой = Новый HTTPСоединение("edo.platformaofd.ru", 443, , , , 30, ЗащитаСоединения);

 // ОбеспечитьТокен(Ложь) отвечает "Да" по факту НАЛИЧИЯ токена, а он живет 15 минут
 // при обновлении раз в час - 401 здесь штатное дело и лечится перевыпуском.
		Для НомерПопытки = 1 По 2 Цикл
			ЗапросКПлатформе = Новый HTTPЗапрос(ПутьЗапроса);
			ЗапросКПлатформе.Заголовки.Вставить("Authorization", "Bearer " + ТокенПлатформы);
			Если ЗначениеЗаполнено(ТипСодержимого) Тогда
				ЗапросКПлатформе.Заголовки.Вставить("accept", ТипСодержимого);
			КонецЕсли;

			ОтветСервиса = СоединениеСПлатформой.Получить(ЗапросКПлатформе);

			Если ОтветСервиса.КодСостояния = 401 И НомерПопытки = 1 Тогда
				ЭДО_Сервер.ОбеспечитьТокен(Истина);
				ТокенПлатформы = ЭДО_Сервер.ТекущийТокен();
				Продолжить;
			КонецЕсли;
			Если ОтветСервиса.КодСостояния <> 200 Тогда
				Итог.Ошибка = "Платформа ответила HTTP " + ОтветСервиса.КодСостояния + ": "
					+ Лев(ОтветСервиса.ПолучитьТелоКакСтроку("UTF-8"), 200);
				Возврат Итог;
			КонецЕсли;

			Итог.Данные = ОтветСервиса.ПолучитьТелоКакДвоичныеДанные();
			Возврат Итог;
		КонецЦикла;

		Итог.Ошибка = "Платформа не приняла токен (HTTP 401), и перевыпустить его не удалось.";
	Исключение
		Итог.Ошибка = "Не удалось обратиться к Платформе: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Итог;

КонецФункции

&НаСервере
Процедура ДополнитьПричинамиИзЦепочек(Соединение, Контекст, Таблица)

	// Причины отказа в самой карточке документа НЕТ вовсе - ни `reason`, ни
	// `documentState.comment` (замер 25.08.2026 на боевом SENDING_FAILED). Она лежит
	// в ЦЕПОЧКЕ: `document-flows` отдает документ вместе с подчиненными, и среди них
	// квитанция `SENDING_FAILURE_ACK` с полным текстом отказа ФЛК.
	// Прежний записанный путь "искать квитанции списком documents?type=SENDING_FAILURE_ACK"
	// для этого НЕ годится: в таких квитанциях нет узла `invoice`, связать их с накладной
	// по номеру нечем - проверено, среди 85 квитанций за сутки нужная не находится.
	ПачкаИдентификаторов = Новый Массив;
	СтрокиПоИдентификатору = Новый Соответствие;
	Для Каждого СтрокаИстории Из Таблица Цикл
		Если ЗначениеЗаполнено(СтрокаИстории.Причина)
			ИЛИ НЕ ЗначениеЗаполнено(СтрокаИстории.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		ПачкаИдентификаторов.Добавить(СтрокаИстории.Идентификатор);
		СтрокиПоИдентификатору.Вставить(СтрокаИстории.Идентификатор, СтрокаИстории);
	КонецЦикла;

	Если ПачкаИдентификаторов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// page_size у document-flows не больше 50, иначе HTTP 400 "must be less than or equal to 50".
	// Две попытки, а не одна: токен живет 15 минут при обновлении раз в час, и 401 здесь
	// штатное дело. Поймано прогоном на живых данных - с одной попыткой причина молча
	// не подтягивалась бы ровно тогда, когда карточку открывают спустя время после регламента.
	ОтветЦепочек = Неопределено;
	Для НомерПопытки = 1 По 2 Цикл
		ЗапросЦепочек = Новый HTTPЗапрос("/document/public/api/v3/document-flows?id="
			+ СтрСоединить(ПачкаИдентификаторов, ",") + "&page=0&page_size=50");
		ЗапросЦепочек.Заголовки.Вставить("Authorization", "Bearer " + Контекст.Токен);
		ЗапросЦепочек.Заголовки.Вставить("accept", "application/json;charset=UTF-8");

		Попытка
			ОтветЦепочек = Соединение.Получить(ЗапросЦепочек);
		Исключение
 // Причина - дополнение к истории, а не сама история: молча остаемся без нее.
			Возврат;
		КонецПопытки;

		Если ОтветЦепочек.КодСостояния = 401 И НомерПопытки = 1 Тогда
			ЭДО_Сервер.ОбеспечитьТокен(Истина);
			Контекст.Токен = ЭДО_Сервер.ТекущийТокен();
			Продолжить;
		КонецЕсли;
		Прервать;
	КонецЦикла;

	Если ОтветЦепочек = Неопределено ИЛИ ОтветЦепочек.КодСостояния <> 200 Тогда
		Возврат;
	КонецЕсли;

	ЧтениеЦепочек = Новый ЧтениеJSON;
	ЧтениеЦепочек.УстановитьСтроку(ОтветЦепочек.ПолучитьТелоКакСтроку("UTF-8"));
	Цепочки = ПрочитатьJSON(ЧтениеЦепочек, Ложь);
	ЧтениеЦепочек.Закрыть();
	Если Цепочки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Цепочка Из Цепочки Цикл
		Если НЕ Цепочка.Свойство("id") ИЛИ НЕ Цепочка.Свойство("slaves")
			ИЛИ Цепочка["slaves"] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаЦепочки = СтрокиПоИдентификатору.Получить(Формат(Цепочка["id"], "ЧГ=0"));
		Если СтрокаЦепочки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Подчиненный Из Цепочка["slaves"] Цикл
			ТекстПричины = ПричинаКарточки(Подчиненный);
			Если ЗначениеЗаполнено(ТекстПричины) Тогда
				СтрокаЦепочки.Причина = Лев(ТекстПричины, 500);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ЗаписатьСтатусПлатформыВКолонку(Знач СтатусПлатформы)

	// Возвращает записанный текст, либо пустую строку, если ничего менять не потребовалось.
	//
	// Карта статусов продублирована из регламента `status-sync.bsl` - в расширении
	// "ПлатформаЭДО" ее нет, она живет только в скрипте на хосте. Тексты обязаны совпадать
	// ДОСЛОВНО: механизмы узнают свои значения точным сравнением, и расхождение в одну букву
	// означает, что регламент сочтет строку чужой и перестанет ее вести.
	// Правильное место для карты - экспортная функция расширения; вынести отдельной задачей.
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) ИЛИ НЕ ЗначениеЗаполнено(СтатусПлатформы) Тогда
		Возврат "";
	КонецЕсли;

	КартаСтатусов = Новый Соответствие;
	КартаСтатусов.Вставить("NEW",                    "Отправляется");
	КартаСтатусов.Вставить("AWAIT_PAYMENT",          "Отправляется");
	КартаСтатусов.Вставить("SENT_TO_OPERATOR",       "Отправляется");
	КартаСтатусов.Вставить("SENT",                   "Отправлен");
	КартаСтатусов.Вставить("DELIVERED",              "Доставлен");
	КартаСтатусов.Вставить("ACCEPTED",               "Принят");
	КартаСтатусов.Вставить("REJECTED",               "Отказ контрагента");
	КартаСтатусов.Вставить("SENDING_FAILED",         "Ошибка: не отправлен");
	КартаСтатусов.Вставить("CANCELLED",              "Аннулирован");
	КартаСтатусов.Вставить("CANCELLATION_REQUESTED", "Запрошено аннулирование");

	НовыйТекст = КартаСтатусов.Получить(ВРег(СокрЛП(СтатусПлатформы)));
	Если НовыйТекст = Неопределено Тогда
 // незнакомый статус показываем как есть, а не прячем - так же поступает регламент
		НовыйТекст = СокрЛП(СтатусПлатформы);
	КонецЕсли;
	// Ресурс "Значение" регистра - Строка(50), длинное режется молча.
	НовыйТекст = Лев(НовыйТекст, 50);

	СвойствоСтатуса = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_Состояние");
	Если СвойствоСтатуса = Неопределено ИЛИ СвойствоСтатуса.Пустая() Тогда
		Возврат "";
	КонецЕсли;

	ТекущийТекст = "";
	НаборСтатуса = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	НаборСтатуса.Отбор.Объект.Установить(ДокументСсылка);
	НаборСтатуса.Отбор.Свойство.Установить(СвойствоСтатуса);
	НаборСтатуса.Прочитать();
	Для Каждого ЗаписьСтатуса Из НаборСтатуса Цикл
		ТекущийТекст = СокрЛП(Строка(ЗаписьСтатуса.Значение));
	КонецЦикла;

	Если ТекущийТекст = НовыйТекст Тогда
		Возврат "";
	КонецЕсли;

	// "Отправка не требуется" не трогаем НИКОГДА: этот текст служит фильтром отбора
	// очереди отправки, и его перезапись вернула бы документ в очередь.
	Если ТекущийТекст = ЭДО_Сервер.ТекстСтатусаОтправкаНеТребуется() Тогда
		Возврат "";
	КонецЕсли;

	// Открытие карточки становится ПИШУЩИМ действием, а открывают ее и пользователи
	// с урезанными правами. Без обертки отсутствие права на регистр уронило бы всю форму -
	// поэтому ошибку записи показываем в "Сообщении", но карточку не роняем.
	Попытка
		ЭДО_Сервер.ЗаписатьЧитаемыйСтатус(ДокументСсылка, НовыйТекст);
	Исключение
		Сообщение = "Колонка «ЭДО» не обновлена: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");
		Возврат "";
	КонецПопытки;

	Возврат НовыйТекст;

КонецФункции

#КонецОбласти
