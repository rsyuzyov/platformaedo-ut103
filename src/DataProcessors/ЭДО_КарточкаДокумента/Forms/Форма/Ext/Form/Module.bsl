&НаСервере
Функция ДатаИзISO(Знач Текст)

	// Платформа отдаёт UTC вида 2026-08-21T07:11:36.448710Z.
	// Показываем МЕСТНОЕ время: разъезд на пять часов при разборе инцидента стоит дорого.
	Если СтрДлина(Текст) < 19 Тогда
		Возврат '00010101';
	КонецЕсли;
	Попытка
		ДатаUTC = Дата(Число(Сред(Текст, 1, 4)), Число(Сред(Текст, 6, 2)), Число(Сред(Текст, 9, 2)),
			Число(Сред(Текст, 12, 2)), Число(Сред(Текст, 15, 2)), Число(Сред(Текст, 18, 2)));
	Исключение
		Возврат '00010101';
	КонецПопытки;
	Возврат МестноеВремя(ДатаUTC);

КонецФункции

&НаСервереБезКонтекста
Функция ИдентификаторКонтрагента(Контрагент)

	Свойство = ЭДО_Сервер.СвойствоОбъектов("ЭДО_АдресКонтрагента");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Значения.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК Значения
		|ГДЕ
		|	Значения.Объект = &Объект
		|	И Значения.Свойство = &Свойство");
	Запрос.УстановитьПараметр("Объект", Контрагент);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Строка(Выборка.Значение));
	КонецЕсли;
	Возврат "";

КонецФункции

&НаСервереБезКонтекста
Функция ТаблицаОператоров()

	Возврат ЭДО_Сервер.ОператорыЭДО();

КонецФункции

// Адрес у того же оператора, что и мы. Роуминговой связи для такой пары не бывает,
// обмен идет напрямую, а приглашение туда бесполезно и на живой связи опасно.
&НаСервере
Функция АдресВнутриНашегоОператора(Знач Адрес)

	Проверяемый = ВРег(СокрЛП(Адрес));
	НашГид = ВРег(СокрЛП(Строка(ЭДО_Сервер.ГидОрганизации(ОрганизацияКарточки()))));
	Если СтрДлина(Проверяемый) < 3 ИЛИ СтрДлина(НашГид) < 3 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Лев(Проверяемый, 3) = Лев(НашГид, 3);

