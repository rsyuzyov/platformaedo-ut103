// ЩА 15.10.2026 [yan]: ход отправки читается из Платформы один раз за открытие карточки:
// идентификатор экземпляра -> Массив шагов. Нужен свежий - карточку переоткрывают.
&НаКлиенте
Перем КэшХодаДокумента;

#Область ОбработчикиСобытийФормы

// ЩА 15.10.2026 [yan]: таблица адресов только для просмотра - стандартная кнопка «Изменить» в ней
// ничего не делала (адрес привязывается кнопкой «Привязать выбранный»); привязанный адрес - жирным.
&НаСервере
Процедура НастроитьТаблицуАдресов()

	Элементы.Адреса.ТолькоПросмотр = Истина;

	Элемент = УсловноеОформление.Элементы.Добавить();
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Адреса.Текущий");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	// Жирный шрифт - из стиля конфигурации: ЖирныйШрифтБЭД есть в УТАП, но не в каждой базе (в КАТАП нет).
	// Нет элемента стиля - строка без выделения, но карточка открывается.
	ЭлементСтиля = Метаданные.ЭлементыСтиля.Найти("ЖирныйШрифтБЭД");
	Если ЭлементСтиля = Неопределено Тогда
		УсловноеОформление.Элементы.Удалить(Элемент);
		Возврат;
	КонецЕсли;
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ЭлементСтиля.Значение);
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("Адреса");

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Карточка обслуживает любой документ ЭДО: накладную, акт сверки, корректировку.
	// Без документа она открывается по контрагенту, документ выбирается в его списке.
	ДокументСсылка = Параметры.Документ;
	КонтрагентСсылка = Параметры.Контрагент;
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		КонтрагентСсылка = ДокументСсылка.Контрагент;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДокументСсылка) И НЕ ЗначениеЗаполнено(КонтрагентСсылка) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	КонецПериодаДокументов = НачалоДня(ТекущаяДатаСеанса());
	НачалоПериодаДокументов = КонецПериодаДокументов - 89 * 86400;
	НастроитьТаблицуАдресов();   // ЩА 15.10.2026 [yan]

	ЗаполнитьИзБазы();
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаКонтрагент;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// К оператору идем после отрисовки окна: при его аварии запрос висит до 20 с, и форма не открылась бы
	// вовсе. Шапка из базы видна сразу, история дозаполняется следом.
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		ПодключитьОбработчикОжидания("ЗагрузитьИзПлатформыОтложенно", 0.2, Истина);
	Иначе
		ПодключитьОбработчикОжидания("ЗагрузитьКонтрагентаОтложенно", 0.2, Истина);
	КонецЕсли;

КонецПроцедуры

// Закладки "Контрагент" и "Операторы" заполняются при первом переходе на них: документы за период
// и адреса из реестра стоят запросов к оператору, а карточку чаще открывают ради одного документа.
&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)

	Если ТекущаяСтраница = Элементы.СтраницаКонтрагент Тогда
		ЗагрузитьКонтрагентаОтложенно();
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаОператоры Тогда
		ЗагрузитьАдресаОтложенно();
	КонецЕсли;

КонецПроцедуры

// Выбор документа в списке контрагента наполняет закладку "Документ".
&НаКлиенте
Процедура ДокументыКонтрагентаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ДокументыКонтрагента.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда
		Возврат;
	КонецЕсли;

	ВыбратьДокументНаСервере(ТекущиеДанные.Документ);
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаДокумент;
	ЗагрузитьИзПлатформыОтложенно();

КонецПроцедуры

&НаКлиенте
Процедура НакладнаяОткрытие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		ОткрытьЗначение(ДокументСсылка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПредставлениеОткрытие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если ЗначениеЗаполнено(КонтрагентСсылка) Тогда
		ОткрытьЗначение(КонтрагентСсылка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьДокументКонтрагента(Команда)

	ТекущиеДанные = Элементы.ДокументыКонтрагента.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда
		Возврат;
	КонецЕсли;
	ОткрытьЗначение(ТекущиеДанные.Документ);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИзПлатформы(Команда)

	ЗагрузитьИзПлатформыОтложенно();
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаКонтрагент Тогда
		ДокументыКонтрагентаЗагружены = Ложь;
		ЗагрузитьКонтрагентаОтложенно();
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаОператоры Тогда
		ПоказатьАдреса(Неопределено);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДокументыКонтрагента(Команда)

	Если НачалоПериодаДокументов > КонецПериодаДокументов Тогда
		ПоказатьПредупреждение(, "Начало периода позже его конца.");
		Возврат;
	КонецЕсли;

	Состояние("Состояние ЭДО", , "Собираю документы контрагента...");
	ЗаполнитьДокументыКонтрагентаНаСервере();
	Состояние();

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьДокумент(Команда)

	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		ПоказатьПредупреждение(, "Накладной еще нет: заявка не отгружена, отправлять в ЭДО нечего.");
		Возврат;
	КонецЕсли;

	// Текст вопроса - по фактической истории отправок (у акта сверки так же), а не по колонке "ЭДО":
	// колонку пишет регламент, и в момент нажатия она может отставать.
	ПодписанныйЭкземпляр = "";
	Последняя = Неопределено;
	Для Каждого СтрокаИстории Из История Цикл
		Если ВРег(СокрЛП(СтрокаИстории.Статус)) = "ACCEPTED" Тогда
			ПодписанныйЭкземпляр = СтрокаИстории.Оператор;
		КонецЕсли;
		Если Последняя = Неопределено ИЛИ СтрокаИстории.Создан > Последняя.Создан Тогда
			Последняя = СтрокаИстории;
		КонецЕсли;
	КонецЦикла;

	Куда = ?(ЗначениеЗаполнено(ОператорЭДО), " (" + ОператорЭДО + ")", "");
	Если ЗначениеЗаполнено(ПодписанныйЭкземпляр) Тогда
		// Контрагент уже подписал экземпляр: переотправка даст ему второй УПД на ту же отгрузку.
		Текст = "Контрагент уже ПОДПИСАЛ этот документ (" + ПодписанныйЭкземпляр + ")." + Символы.ПС
			+ "Переотправка создаст у него второй экземпляр на ту же отгрузку." + Символы.ПС + Символы.ПС
			+ "Все равно отправить" + Куда + "?";
	ИначеЕсли Последняя <> Неопределено И НЕ ЭДО_Сервер.КарточкаЖивая(Последняя.Статус, "") Тогда
		// Мертвый экземпляр (не доставлен, отклонен, аннулирован) у контрагента не действует:
		// "уже отправлен" здесь вводит в заблуждение, человек боится дубля, которого не будет.
		Текст = "Прошлая отправка не дошла до контрагента: " + Последняя.Статус + " от "
			+ Формат(Последняя.Создан, "ДФ=dd.MM.yyyy HH:mm")
			+ ?(ЗначениеЗаполнено(Последняя.Оператор), ", " + Последняя.Оператор, "") + "." + Символы.ПС + Символы.ПС
			+ "Отправить заново" + Куда + "?";
	ИначеЕсли Последняя <> Неопределено Тогда
		Текст = "Документ уже отправлен: " + Последняя.Статус + " от "
			+ Формат(Последняя.Создан, "ДФ=dd.MM.yyyy HH:mm")
			+ ?(ЗначениеЗаполнено(Последняя.Оператор), ", " + Последняя.Оператор, "") + "." + Символы.ПС + Символы.ПС
			+ "Переотправить" + Куда + "?";
	Иначе
		Текст = "Отправить документ в ЭДО" + Куда + "?";
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("ОтправитьДокументЗавершение", ЭтотОбъект),
		Текст, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьДокументЗавершение(Ответ, Параметр) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние("Состояние ЭДО", , "Отправляю в Платформу…");
	ИтогОтправки = ОтправитьНаСервере();
	Состояние();
	ОповеститьФормуДокумента();

	ПоказатьИтогОтправки(ИтогОтправки, "");

КонецПроцедуры

// Преодолимый гейт (документ старше начала работы с оператором, уходил через СБИС, прежний экземпляр
// не доставлен) человек вправе снять сам. Спрашиваем после отправки: до нее неизвестно, в какую причину
// упрется документ. СнятыеГейты - коды, уже снятые человеком (через запятую): документ может упереться
// во второй гейт, и повторная отправка передает оба (ЩА 21.10.2026 [yan]).
&НаКлиенте
Процедура ПоказатьИтогОтправки(ИтогОтправки, СнятыеГейты)

	Если ИтогОтправки.ГейтПреодолим Тогда
		Если ИтогОтправки.КодПричины = "НедоставленныйЭкземпляр" Тогда
			Пояснение = "Отправляйте повторно, только если контрагент подтвердил, что документа у него нет:"
				+ " у абонентов Платформы и ЭДО Лайт статус SENT бывает окончательным. Прежний экземпляр"
				+ " лучше предложить аннулировать, иначе при его доставке у контрагента будет два документа.";
		Иначе
			Пояснение = "Если документ уже был принят контрагентом по прежнему каналу, у него появится"
				+ " второй экземпляр на ту же отгрузку.";
		КонецЕсли;
		ПоказатьВопрос(Новый ОписаниеОповещения("ОтправитьПреодолевГейтЗавершение", ЭтотОбъект,
				?(ЗначениеЗаполнено(СнятыеГейты), СнятыеГейты + ",", "") + ИтогОтправки.КодПричины),
			ИтогОтправки.Текст + Символы.ПС + Символы.ПС + Пояснение + Символы.ПС + Символы.ПС
			+ "Все равно отправить?",
			РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;

	// Итог показываем окном: поле "Сообщение" внизу формы при обычном размере окна не видно.
	// Заголовок итога различает удержание механизмом и ошибку отправки.
	Если ИтогОтправки.Успех Тогда
		ПоказатьОповещениеПользователя("Отправлен в ЭДО", , ИтогОтправки.Текст);
	Иначе
		ПоказатьПредупреждение(, ИтогОтправки.Заголовок + ": " + ИтогОтправки.Текст);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьПреодолевГейтЗавершение(Ответ, СнятыеГейты) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние("Состояние ЭДО", , "Отправляю в Платформу…");
	ИтогОтправки = ОтправитьНаСервере(СнятыеГейты);
	Состояние();

	ПоказатьИтогОтправки(ИтогОтправки, СнятыеГейты);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьИсправление(Команда)

	ТекущиеДанные = Элементы.История.ТекущиеДанные;
	Если НЕ ЕстьИдентификаторКарточки(ТекущиеДанные) Тогда
		Возврат;
	КонецЕсли;

	// Исправляется экземпляр, дошедший до контрагента: черновик и отказ исправлять нечего.
	Статус = ВРег(СокрЛП(ТекущиеДанные.Статус));
	Если СтрНайти(",SENT,DELIVERED,ACCEPTED,", "," + Статус + ",") = 0 Тогда
		ПоказатьПредупреждение(, "Исправление отправляется к отправленному, доставленному или принятому экземпляру."
			+ " У выбранного статус " + ТекущиеДанные.Статус + ".");
		Возврат;
	КонецЕсли;

	ДанныеИсправления = Новый Структура("ИдКарточки, НомерИсправления, ДатаИсправления",
		СокрЛП(ТекущиеДанные.Идентификатор), 1, ДатаСеансаНаСервере());
	ПоказатьВводЧисла(Новый ОписаниеОповещения("ОтправитьИсправлениеВводНомера", ЭтотОбъект, ДанныеИсправления),
		ДанныеИсправления.НомерИсправления, "Номер исправления (1, если исправлений еще не было)", 3, 0);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьИсправлениеВводНомера(НомерИсправления, ДанныеИсправления) Экспорт

	Если НомерИсправления = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НомерИсправления < 1 ИЛИ НомерИсправления > 999 Тогда
		ПоказатьПредупреждение(, "Номер исправления - целое число от 1 до 999.");
		Возврат;
	КонецЕсли;

	ДанныеИсправления.НомерИсправления = НомерИсправления;
	ПоказатьВводДаты(Новый ОписаниеОповещения("ОтправитьИсправлениеВводДаты", ЭтотОбъект, ДанныеИсправления),
		ДанныеИсправления.ДатаИсправления, "Дата исправления", ЧастиДаты.Дата);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьИсправлениеВводДаты(ДатаИсправления, ДанныеИсправления) Экспорт

	Если НЕ ЗначениеЗаполнено(ДатаИсправления) Тогда
		Возврат;
	КонецЕсли;

	ДанныеИсправления.ДатаИсправления = ДатаИсправления;
	ПоказатьВопрос(Новый ОписаниеОповещения("ОтправитьИсправлениеЗавершение", ЭтотОбъект, ДанныеИсправления),
		"Контрагенту уйдет исправительный УПД N " + Формат(ДанныеИсправления.НомерИсправления, "ЧГ=0")
		+ " от " + Формат(ДатаИсправления, "ДФ=dd.MM.yyyy") + " к экземпляру " + ДанныеИсправления.ИдКарточки
		+ "." + Символы.ПС + Символы.ПС
		+ "Номер и дата счета-фактуры останутся прежними, товары и коды маркировки возьмутся"
		+ " из документа в его текущем виде. Контрагенту нужно будет подписать исправление." + Символы.ПС + Символы.ПС
		+ "Отправить?", РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьИсправлениеЗавершение(Ответ, ДанныеИсправления) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние("Состояние ЭДО", , "Отправляю исправление в Платформу...");
	Итог = ОтправитьИсправлениеНаСервере(ДанныеИсправления.ИдКарточки,
		ДанныеИсправления.НомерИсправления, ДанныеИсправления.ДатаИсправления);
	Состояние();
	ОповеститьФормуДокумента();

	Если Итог.Успех Тогда
		ПоказатьОповещениеПользователя(Итог.Заголовок, , Итог.Текст);
	Иначе
		ПоказатьПредупреждение(, Итог.Заголовок + ": " + Итог.Текст);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьАдреса(Команда)

	// В поле "Сообщение" пишут несколько механизмов: дописываем, а не заменяем, иначе причина
	// пустой истории пропадает при "Обновить список".
	Состояние("Состояние ЭДО", , "Спрашиваю реестр ФНС…");
	ПрежнееСообщение = Сообщение;
	Сообщение = ЗагрузитьАдресаНаСервере()
		+ ?(ЗначениеЗаполнено(ПрежнееСообщение), Символы.ПС + ПрежнееСообщение, "");
	Состояние();

КонецПроцедуры

// ЩА 23.10.2026 [yan], ревью Codex (КАТАП №24): связь строки адреса по колонкам организаций - «Лион - нет;
// ТД ЛИОН - есть»; прежнее поле «Связь» заполнено только у карточки без колонок организаций.
&НаКлиенте
Функция СвязиСтрокиТекстом(ДанныеСтроки)
	Части = Новый Массив;
	Номер = 1;
	Колонка = Элементы.Найти("КолонкаСвязь" + Номер);
	Пока Колонка <> Неопределено И Колонка.Видимость Цикл
		Части.Добавить(СтрЗаменить(Колонка.Заголовок, "Связь: ", "") + " - " + ДанныеСтроки["Связь" + Номер]);
		Номер = Номер + 1;
		Колонка = Элементы.Найти("КолонкаСвязь" + Номер);
	КонецЦикла;
	Возврат ?(Части.Количество() = 0, ДанныеСтроки.Связь, СтрСоединить(Части, "; "));
КонецФункции

&НаКлиенте
Процедура ПривязатьАдрес(Команда)

	ТекущиеДанные = Элементы.Адреса.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Сначала выберите строку в списке адресов.");
		Возврат;
	КонецЕсли;
	// Ручной выбор закрепляет адрес, иначе регламент обновления связей вернет свой.
	// Текущий адрес без закрепления тоже можно закрепить: без этого адреса вне автовыбора удерживаются.
	Если СокрЛП(ТекущиеДанные.Адрес) = СокрЛП(ИдентификаторЭДО) Тогда
		Если АдресЗакреплёнНаСервере() Тогда
			ПоказатьПредупреждение(, "Этот адрес уже привязан и закреплён.");
			Возврат;
		КонецЕсли;
		Текст = "Закрепить текущий адрес контрагента" + Символы.ПС + ТекущиеДанные.Адрес + Символы.ПС
			+ "(" + ТекущиеДанные.Оператор + ", связь: " + СвязиСтрокиТекстом(ТекущиеДанные) + ")?" + Символы.ПС + Символы.ПС
			+ "Регламент обновления связей его больше не поменяет, отправка на него перестанет удерживаться.";
	Иначе
		Текст = "Привязать контрагенту адрес" + Символы.ПС + ТекущиеДанные.Адрес + Символы.ПС
			+ "(" + ТекущиеДанные.Оператор + ", связь: " + СвязиСтрокиТекстом(ТекущиеДанные) + ")?" + Символы.ПС + Символы.ПС
			+ "Адрес будет закреплён — регламент обновления связей его больше не поменяет.";
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("ПривязатьАдресЗавершение", ЭтотОбъект, ТекущиеДанные.Адрес),
		Текст, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПривязатьАдресЗавершение(Ответ, Адрес) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Сообщение = ПривязатьАдресНаСервере(Адрес);
	ЗагрузитьИзПлатформыОтложенно();
	ПоказатьАдреса(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьXMLОтправки(Команда)

	ТекущиеДанные = Элементы.История.ТекущиеДанные;
	Если НЕ ЕстьИдентификаторКарточки(ТекущиеДанные) Тогда
		Возврат;
	КонецЕсли;

	Состояние("Состояние ЭДО", , "Забираю XML из Платформы…");
	ОтветПлатформы = СодержимоеКарточкиНаСервере(ТекущиеДанные.Идентификатор, "xml");
	Состояние();

	Если ЗначениеЗаполнено(ОтветПлатформы.Ошибка) Тогда
		ПоказатьПредупреждение(, ОтветПлатформы.Ошибка);
		Возврат;
	КонецЕсли;

	// Окно текстового документа, а не файл на диске: XML смотрят и закрывают, сохранить можно из окна.
	ДокументXML = Новый ТекстовыйДокумент;
	ДокументXML.УстановитьТекст(ОтветПлатформы.Текст);
	ДокументXML.ТолькоПросмотр = Истина;
	ДокументXML.Показать("XML отправки " + СокрЛП(ТекущиеДанные.Идентификатор));

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНаСайте(Команда)

