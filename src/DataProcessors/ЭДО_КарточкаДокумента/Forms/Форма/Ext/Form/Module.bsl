&НаСервереБезКонтекста
Функция ПривязанныеАдресаПоИНН(Знач ИНН)

	// У одного ИНН бывает несколько карточек контрагента с разными адресами, а адрес, привязанный
	// руками, в реестре ФНС может не значиться.
	Адреса = Новый Массив;
	Свойство = ЭДО_Сервер.СвойствоОбъектов("ЭДО_АдресКонтрагента");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() ИЛИ НЕ ЗначениеЗаполнено(ИНН) Тогда
		Возврат Адреса;
	КонецЕсли;

	// Два запроса вместо соединения: измерение "Объект" составное.
	ЗапросКонтрагентов = Новый Запрос(
		"ВЫБРАТЬ Контрагенты.Ссылка КАК Ссылка
		|ИЗ Справочник.Контрагенты КАК Контрагенты
		|ГДЕ Контрагенты.ИНН = &ИНН");
	ЗапросКонтрагентов.УстановитьПараметр("ИНН", СокрЛП(ИНН));
	СписокКонтрагентов = ЗапросКонтрагентов.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Если СписокКонтрагентов.Количество() = 0 Тогда
		Возврат Адреса;
	КонецЕсли;

	ЗапросЗначений = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ Значения.Значение КАК Значение
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов КАК Значения
		|ГДЕ Значения.Объект В (&Список) И Значения.Свойство = &Свойство");
	ЗапросЗначений.УстановитьПараметр("Список", СписокКонтрагентов);
	ЗапросЗначений.УстановитьПараметр("Свойство", Свойство);
	Выборка = ЗапросЗначений.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Значение = СокрЛП(Строка(Выборка.Значение));
		Если ЗначениеЗаполнено(Значение) И Адреса.Найти(Значение) = Неопределено Тогда
			Адреса.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Адреса;

КонецФункции

&НаСервере
Функция ЗагрузитьАдресаНаСервере()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Текущий", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(3)));
	Таблица.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Оператор", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Связь", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(30)));
	Таблица.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));

	Контрагент = КонтрагентКарточки();
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		ЗначениеВРеквизитФормы(Таблица, "Адреса");
		Возврат "Контрагент не определён.";
	КонецЕсли;

	Реквизиты = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(Контрагент, "ИНН, КПП");
	ИНН = СокрЛП(Реквизиты.ИНН);
	Если НЕ ЗначениеЗаполнено(ИНН) Тогда
		ЗначениеВРеквизитФормы(Таблица, "Адреса");
		Возврат "У контрагента не заполнен ИНН — искать в реестре не по чему.";
	КонецЕсли;

	Дополнение = "";
	Попытка
		Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Ложь, ОрганизацияКарточки()) Тогда
			ЗначениеВРеквизитФормы(Таблица, "Адреса");
			Возврат "Не удалось получить токен Платформы.";
		КонецЕсли;

		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(ОрганизацияКарточки()));
		Заголовки.Вставить("accept", "application/json;charset=UTF-8");
		Соединение = ЭДО_Сервер.СоединениеСОператором(20);

		Реестр = АдресаКонтрагентаИзРеестра(Соединение, Заголовки, ИНН, СокрЛП(Реквизиты.КПП));
		Если Реестр.Ошибка Тогда
			Дополнение = "Реестр ФНС не ответил — список может быть неполным.";
		КонецЕсли;
		ПредупреждениеКПП = ПредупреждениеОКПП(Реквизиты.КПП, Реестр);
		Если ЗначениеЗаполнено(ПредупреждениеКПП) Тогда
			Дополнение = СокрЛП(Дополнение + " " + ПредупреждениеКПП);
		КонецЕсли;

		Связи = Новый Соответствие;
		Если Реестр.Адреса.Количество() > 0 Тогда
			Попытка
				Связи = ЭДО_Сервер.СтатусыСвязейЭДО(Соединение, Заголовки, ЭДО_Сервер.ГидОрганизации(ОрганизацияКарточки()), Реестр.Адреса);
			Исключение
				Дополнение = СокрЛП(Дополнение + " Статусы связей получить не удалось.");
			КонецПопытки;
		КонецЕсли;

		Текущий = ИдентификаторКонтрагента(Контрагент);
		Операторы = ТаблицаОператоров();
		Для Каждого Адрес Из Реестр.Адреса Цикл
			НоваяСтрока = Таблица.Добавить();
			НоваяСтрока.Адрес = Адрес;
			НоваяСтрока.Оператор = ИмяОператораПоТаблице(Адрес, Операторы);
			НоваяСтрока.Текущий = ?(ВРег(СокрЛП(Адрес)) = ВРег(СокрЛП(Текущий)), "да", "");
			Связь = ЭДО_Сервер.СостояниеСвязи(Связи, Адрес);
			// Нет записи - не значит "связи нет": у пары абонентов одного оператора роуминговой записи
			// не бывает, слать можно, а приглашение не нужно.
			Если Связь <> Неопределено Тогда
				НоваяСтрока.Связь = Строка(Связь.Статус);
			ИначеЕсли АдресВнутриНашегоОператора(Адрес) Тогда
				НоваяСтрока.Связь = "внутри Платформы, приглашение не нужно";
			Иначе
				НоваяСтрока.Связь = "нет связи";
			КонецЕсли;
		КонецЦикла;

		// Адрес, привязанный в базе, мог не попасть в реестр - показываем его отдельной строкой.
		Если ЗначениеЗаполнено(Текущий) И НЕ АдресЕстьВСписке(Таблица.ВыгрузитьКолонку("Адрес"), Текущий) Тогда
			НоваяСтрока = Таблица.Добавить();
			НоваяСтрока.Адрес = Текущий;
			НоваяСтрока.Оператор = ИмяОператораПоТаблице(Текущий, Операторы);
			НоваяСтрока.Текущий = "да";
			НоваяСтрока.Связь = ?(АдресВнутриНашегоОператора(Текущий),
				"внутри Платформы, приглашение не нужно", "нет связи");
			НоваяСтрока.Наименование = "привязан в базе, в реестре по ИНН/КПП не найден";
		КонецЕсли;

	Исключение
		ЗначениеВРеквизитФормы(Таблица, "Адреса");
		Возврат "Ошибка обращения к Платформе: " + ОписаниеОшибки();
	КонецПопытки;

	Таблица.Сортировать("Текущий Убыв, Оператор Возр");
	ЗначениеВРеквизитФормы(Таблица, "Адреса");

	Если Таблица.Количество() = 0 Тогда
		Возврат СокрЛП("В реестре ФНС по ИНН " + ИНН + " адресов не нашлось. " + Дополнение);
	КонецЕсли;
	Возврат СокрЛП("Адресов найдено: " + Таблица.Количество() + ". " + Дополнение);

КонецФункции

&НаСервере
Функция ПривязатьАдресНаСервере(Знач Адрес)

	Контрагент = КонтрагентКарточки();
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат "Контрагент не определён — привязывать некому.";
	КонецЕсли;

	Адрес = СокрЛП(Адрес);
	СвИд = ЭДО_Сервер.СвойствоОбъектов("ЭДО_АдресКонтрагента");
	Если СвИд = Неопределено ИЛИ СвИд.Пустая() Тогда
		Возврат "Не найдено свойство ЭДО_АдресКонтрагента.";
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаписатьСвойство(Контрагент, СвИд, ВРег(Адрес));

		// Закрепление обязательно, иначе регламент обновления связей вернет свой адрес.
		СвЗакр = ЭДО_Сервер.СвойствоОбъектов("ЭДО_АдресЗакреплён");
		Если СвЗакр <> Неопределено И НЕ СвЗакр.Пустая() Тогда
			ЗаписатьСвойство(Контрагент, СвЗакр, Истина);
		КонецЕсли;
		СвОсн = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ЗакреплениеОснование");
		Если СвОсн <> Неопределено И НЕ СвОсн.Пустая() Тогда
			ЗаписатьСвойство(Контрагент, СвОсн,
				"выбран вручную (" + Строка(ПараметрыСеанса.ТекущийПользователь) + ", "
				+ Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") + ")");
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Возврат "Не удалось записать адрес: " + ОписаниеОшибки();
	КонецПопытки;

	ЗаполнитьИзБазы();
	Возврат "Адрес привязан и закреплён: " + Адрес + " (" + ИмяОператора(Адрес) + ").";

КонецФункции

// Организация документа карточки: к оператору карточка ходит от ее учетной записи.
// Без документа - от первой учетной записи, как регламент связей: адрес и связь хранятся у контрагента.
&НаСервере
Функция ОрганизацияКарточки()

	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат ЭДО_Сервер.ОрганизацияДокумента(ДокументСсылка);
	КонецЕсли;
	Если ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Возврат ЭДО_Сервер.УчетныеЗаписиЭДО()[0].Организация;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

&НаСервере
Функция КонтрагентКарточки()

	Если ЗначениеЗаполнено(КонтрагентСсылка) Тогда
		Возврат КонтрагентСсылка;
	КонецЕсли;

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьСвойство(Объект, Свойство, Значение)

	// Своя копия: такая процедура ядра не экспортная.
	Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Объект);
	Набор.Отбор.Свойство.Установить(Свойство);
	Запись = Набор.Добавить();
	Запись.Объект = Объект;
	Запись.Свойство = Свойство;
	Запись.Значение = Значение;
	Набор.Записать();

КонецПроцедуры

&НаКлиенте
Функция ЕстьИдентификаторКарточки(ТекущиеДанные)

	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Сначала выберите строку в истории отправок:"
			+ " XML, ссылка и печатная форма берутся по конкретной отправке.");
		Возврат Ложь;
	КонецЕсли;
	// Судим по типу строки, а не по оператору: оператор здесь - оператор получателя,
	// и у контрагента в роуминге СБИС он тоже "СБИС".
	Если СокрЛП(ТекущиеДанные.Тип) = "старая интеграция" Тогда
		ПоказатьПредупреждение(, "Это отправка через СБИС (старая интеграция)."
			+ " XML, ссылка в личный кабинет и печатная форма есть только у отправок"
			+ " через Платформу ЭДО.");
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(СокрЛП(ТекущиеДанные.Идентификатор)) Тогда
		ПоказатьПредупреждение(, "У этой строки нет идентификатора карточки в Платформе —"
			+ " показывать нечего.");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаСервере
Функция СодержимоеКарточкиНаСервере(Знач ИдентификаторКарточки, Знач Вид)

	// Вид = "xml" - исходный подписанный титул, который ушел контрагенту;
	// Вид = "pdf" - печатная форма с меткой ЭДО (метод v4, отдельный от контента).
	Итог = Новый Структура("Ошибка, Текст, Адрес", "", "", "");

	Если Вид = "pdf" Тогда
		ПутьЗапроса = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v4/documents/"
			+ СокрЛП(ИдентификаторКарточки) + "/watermarked-content";
		ТипСодержимого = "";
	Иначе
		ПутьЗапроса = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/documents/"
			+ СокрЛП(ИдентификаторКарточки) + "/content";
		ТипСодержимого = "application/xml";
	КонецЕсли;

	ОтветПлатформы = ПолучитьОтПлатформыНаСервере(ПутьЗапроса, ТипСодержимого);
	Если ЗначениеЗаполнено(ОтветПлатформы.Ошибка) Тогда
		Итог.Ошибка = ОтветПлатформы.Ошибка;
		Возврат Итог;
	КонецЕсли;
	Если ОтветПлатформы.Данные = Неопределено ИЛИ ОтветПлатформы.Данные.Размер() = 0 Тогда
		Итог.Ошибка = "Платформа вернула пустое содержимое карточки "
			+ СокрЛП(ИдентификаторКарточки) + ".";
		Возврат Итог;
	КонецЕсли;

	Если Вид = "pdf" Тогда
		Итог.Адрес = ПоместитьВоВременноеХранилище(ОтветПлатформы.Данные, УникальныйИдентификатор);
	Иначе
		// Титул ФНС приходит в windows-1251; если пролог говорит UTF-8, перечитываем те же байты.
		ТекстТитула = ПолучитьСтрокуИзДвоичныхДанных(ОтветПлатформы.Данные, "windows-1251");
		Если Найти(ВРег(Лев(ТекстТитула, 200)), "UTF-8") > 0 Тогда
			ТекстТитула = ПолучитьСтрокуИзДвоичныхДанных(ОтветПлатформы.Данные, "UTF-8");
		КонецЕсли;
		Итог.Текст = ТекстТитула;
	КонецЕсли;

	Возврат Итог;

КонецФункции

&НаСервере
Функция ПолучитьОтПлатформыНаСервере(Знач ПутьЗапроса, Знач ТипСодержимого)

	Итог = Новый Структура("Ошибка, Данные", "", Неопределено);

	Попытка
		Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Ложь, ОрганизацияКарточки()) Тогда
			Итог.Ошибка = "Не удалось получить токен Платформы.";
			Возврат Итог;
		КонецЕсли;
		ТокенПлатформы = ЭДО_Сервер.ТекущийТокен(ОрганизацияКарточки());

		СоединениеСПлатформой = ЭДО_Сервер.СоединениеСОператором(30);

		// ОбеспечитьТокен(Ложь) проверяет только наличие токена, а он живет 15 минут - 401 лечится перевыпуском.
		Для НомерПопытки = 1 По 2 Цикл
			ЗапросКПлатформе = Новый HTTPЗапрос(ПутьЗапроса);
			ЗапросКПлатформе.Заголовки.Вставить("Authorization", "Bearer " + ТокенПлатформы);
			Если ЗначениеЗаполнено(ТипСодержимого) Тогда
				ЗапросКПлатформе.Заголовки.Вставить("accept", ТипСодержимого);
			КонецЕсли;

			ОтветСервиса = СоединениеСПлатформой.Получить(ЗапросКПлатформе);

			Если ОтветСервиса.КодСостояния = 401 И НомерПопытки = 1 Тогда
				ЭДО_Сервер.ОбеспечитьТокен(Истина, ОрганизацияКарточки());
				ТокенПлатформы = ЭДО_Сервер.ТекущийТокен(ОрганизацияКарточки());
				Продолжить;
			КонецЕсли;
			Если ОтветСервиса.КодСостояния <> 200 Тогда
				Итог.Ошибка = "Платформа ответила HTTP " + ОтветСервиса.КодСостояния + ": "
					+ Лев(ОтветСервиса.ПолучитьТелоКакСтроку("UTF-8"), 200);
				Возврат Итог;
			КонецЕсли;

			Итог.Данные = ОтветСервиса.ПолучитьТелоКакДвоичныеДанные();
			Возврат Итог;
		КонецЦикла;

		Итог.Ошибка = "Платформа не приняла токен (HTTP 401), и перевыпустить его не удалось.";
	Исключение
		Итог.Ошибка = "Не удалось обратиться к Платформе: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Итог;

КонецФункции

&НаСервере
Процедура ДополнитьПричинамиИзЦепочек(Соединение, Контекст, Таблица)

	// Причины отказа в карточке документа нет - она лежит в цепочке (document-flows).
	// Чтение цепочек в ядре, им же пользуется разбор центра управления.
	Идентификаторы = Новый Массив;
	Для Каждого СтрокаИстории Из Таблица Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаИстории.Причина)
			И ЗначениеЗаполнено(СтрокаИстории.Идентификатор) Тогда
			Идентификаторы.Добавить(СтрокаИстории.Идентификатор);
		КонецЕсли;
	КонецЦикла;

	Причины = ЭДО_Сервер.ПричиныОтказаПоИдентификаторам(Идентификаторы);
	Для Каждого СтрокаИстории Из Таблица Цикл
		ТекстПричины = Причины.Получить(СтрокаИстории.Идентификатор);
		Если ЗначениеЗаполнено(ТекстПричины) Тогда
			СтрокаИстории.Причина = ТекстПричины;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ЗаписатьСтатусПлатформыВКолонку(Знач СтатусПлатформы)

	// Возвращает записанный текст или пустую строку, если менять нечего.
	// Карта статусов общая с регламентом сверки: он узнает свои значения точным сравнением,
	// и расхождение копий выключило бы строку из его ведения.
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) ИЛИ НЕ ЗначениеЗаполнено(СтатусПлатформы) Тогда
		Возврат "";
	КонецЕсли;

	КартаСтатусов = ЭДО_Регламенты.КартаСтатусовПлатформы();

	НовыйТекст = КартаСтатусов.Получить(ВРег(СокрЛП(СтатусПлатформы)));
	Если НовыйТекст = Неопределено Тогда
		// Незнакомый статус показываем как есть, как и регламент.
		НовыйТекст = СокрЛП(СтатусПлатформы);
	КонецЕсли;
	// Ресурс "Значение" регистра - Строка(50), длинное режется молча.
	НовыйТекст = Лев(НовыйТекст, 50);
	// Открытый запрос контрагента на аннулирование важнее статуса карточки - как у регламента.
	НовыйТекст = ЭДО_Сервер.ТекстКолонкиСУчетомЗапросаАннулирования(ДокументСсылка, НовыйТекст);

	СвойствоСтатуса = ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние");
	Если СвойствоСтатуса = Неопределено ИЛИ СвойствоСтатуса.Пустая() Тогда
		Возврат "";
	КонецЕсли;

	ТекущийТекст = "";
	НаборСтатуса = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	НаборСтатуса.Отбор.Объект.Установить(ДокументСсылка);
	НаборСтатуса.Отбор.Свойство.Установить(СвойствоСтатуса);
	НаборСтатуса.Прочитать();
	Для Каждого ЗаписьСтатуса Из НаборСтатуса Цикл
		ТекущийТекст = СокрЛП(Строка(ЗаписьСтатуса.Значение));
	КонецЦикла;

	Если ТекущийТекст = НовыйТекст Тогда
		Возврат "";
	КонецЕсли;

	// "Отправка не требуется" не трогаем никогда: по этому тексту документ исключается из очереди.
	Если ТекущийТекст = ЭДО_Сервер.ТекстСтатусаОтправкаНеТребуется() Тогда
		Возврат "";
	КонецЕсли;

	// Открытие карточки пишет в регистр, а открывают ее и пользователи без прав на запись:
	// ошибку показываем в "Сообщении", но карточку не роняем.
	Попытка
		ЭДО_Сервер.ЗаписатьЧитаемыйСтатус(ДокументСсылка, НовыйТекст);
	Исключение
		Сообщение = "Колонка «ЭДО» не обновлена: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");
		Возврат "";
	КонецПопытки;

	Возврат НовыйТекст;

КонецФункции

#КонецОбласти

#Область Аннулирование

&НаКлиенте
Процедура АннулироватьОтправку(Команда)

	ТекущиеДанные = Элементы.История.ТекущиеДанные;
	Если НЕ ЕстьИдентификаторКарточки(ТекущиеДанные) Тогда
		Возврат;
	КонецЕсли;

	// Аннулировать можно только то, что дошло до контрагента. Черновик, ошибка отправки
	// и отказ юридической силы не имеют, а уже запрошенное аннулирование повторять незачем.
	Статус = ВРег(СокрЛП(ТекущиеДанные.Статус));
	Если СтрНайти(",SENT,DELIVERED,ACCEPTED,", "," + Статус + ",") = 0 Тогда
		ПоказатьПредупреждение(, "Аннулировать можно только отправленный, доставленный или принятый экземпляр."
			+ " У выбранного статус " + ТекущиеДанные.Статус + ".");
		Возврат;
	КонецЕсли;

	Варианты = Новый СписокЗначений;
	Для Каждого Причина Из ПричиныАннулированияНаСервере() Цикл
		Варианты.Добавить(Причина);
	КонецЦикла;
	Варианты.Добавить("", "Другая причина...");

	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("АннулироватьВыборПричины", ЭтотОбъект,
		СокрЛП(ТекущиеДанные.Идентификатор)), Варианты);

КонецПроцедуры

&НаКлиенте
Процедура АннулироватьВыборПричины(Выбор, ИдКарточки) Экспорт

	Если Выбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Выбор.Значение) Тогда
		АннулироватьВводПричины(Выбор.Значение, ИдКарточки);
	Иначе
		ПоказатьВводСтроки(Новый ОписаниеОповещения("АннулироватьВводПричины", ЭтотОбъект, ИдКарточки),
			"", "Причина аннулирования (ее прочитает контрагент)", 1000, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АннулироватьВводПричины(Причина, ИдКарточки) Экспорт

	Если НЕ ЗначениеЗаполнено(Причина) Тогда
		Возврат;
	КонецЕсли;

	ДанныеАннулирования = Новый Структура("ИдКарточки, Причина", ИдКарточки, Причина);
	ПоказатьВопрос(Новый ОписаниеОповещения("АннулироватьЗавершение", ЭтотОбъект, ДанныеАннулирования),
		"Контрагенту уйдет предложение об аннулировании экземпляра " + ИдКарточки + ":" + Символы.ПС
		+ Причина + Символы.ПС + Символы.ПС
		+ "Документ станет аннулированным только после подтверждения контрагентом."
		+ " Для маркированного товара аннулирование в ЭДО не отменяет передачу в Честном знаке." + Символы.ПС + Символы.ПС
		+ "Отправить?", РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура АннулироватьЗавершение(Ответ, ДанныеАннулирования) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние("Состояние ЭДО", , "Отправляю предложение об аннулировании…");
	Итог = АннулироватьНаСервере(ДанныеАннулирования.ИдКарточки, ДанныеАннулирования.Причина);
	Состояние();
	ОповеститьФормуДокумента();

	Если Итог.Успех Тогда
		ПоказатьОповещениеПользователя("Аннулирование", , Итог.Текст);
	Иначе
		ПоказатьПредупреждение(, Итог.Текст);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПринятьАннулирование(Команда)

	ПоказатьВопрос(Новый ОписаниеОповещения("ПринятьАннулированиеЗавершение", ЭтотОбъект),
		"Контрагент просит аннулировать документ:" + Символы.ПС + ЗапросАннулирования + Символы.ПС + Символы.ПС
		+ "Если принять, документ у оператора станет аннулированным. Взамен контрагенту обычно нужен"
		+ " исправленный документ." + Символы.ПС + Символы.ПС + "Принять аннулирование?",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПринятьАннулированиеЗавершение(Ответ, Параметр) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ПоказатьИтогОтвета(ОтветитьНаЗапросНаСервере(Истина, ""));

КонецПроцедуры

&НаКлиенте
Процедура ОтклонитьАннулирование(Команда)

	ПоказатьВводСтроки(Новый ОписаниеОповещения("ОтклонитьАннулированиеЗавершение", ЭтотОбъект),
		"", "Причина отказа (ее прочитает контрагент)", 1000, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОтклонитьАннулированиеЗавершение(Причина, Параметр) Экспорт

	Если НЕ ЗначениеЗаполнено(Причина) Тогда
		Возврат;
	КонецЕсли;
	ПоказатьИтогОтвета(ОтветитьНаЗапросНаСервере(Ложь, Причина));

КонецПроцедуры

&НаКлиенте
Процедура СнятьПаузу(Команда)

	ПоказатьВопрос(Новый ОписаниеОповещения("СнятьПаузуЗавершение", ЭтотОбъект),
		"Возобновить отправку контрагенту " + КонтрагентПредставление + "?" + Символы.ПС + Символы.ПС
		+ "Причина паузы: " + ПаузаОтправки, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СнятьПаузуЗавершение(Ответ, Параметр) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	СнятьПаузуНаСервере();
	ОповеститьФормуДокумента();
	ПоказатьОповещениеПользователя("Отправка возобновлена", , КонтрагентПредставление);

КонецПроцедуры

&НаСервере
Процедура СнятьПаузуНаСервере()

	ЭДО_Сервер.ВозобновитьОтправкуКонтрагенту(КонтрагентКарточки());
	ЗаполнитьИзБазы();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИтогОтвета(Итог)

	ОповеститьФормуДокумента();

	Если Итог.Успех Тогда
		ПоказатьОповещениеПользователя("Запрос на аннулирование", , Итог.Текст);
	Иначе
		ПоказатьПредупреждение(, Итог.Текст);
	КонецЕсли;

КонецПроцедуры

// Форма документа держит гиперссылку "Состояние ЭДО" и перечитывает ее по этому оповещению.
&НаКлиенте
Процедура ОповеститьФормуДокумента()

	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;
	Оповестить("ОбновитьСостояниеЭД", , ДокументСсылка);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПричиныАннулированияНаСервере()

	Возврат ЭДО_Сервер.ТиповыеПричиныАннулирования();

КонецФункции

&НаСервере
Функция АннулироватьНаСервере(Знач ИдКарточки, Знач Причина)

	Итог = ЭДО_Сервер.ПредложитьАннулирование(ИдКарточки, Причина, ДокументСсылка);
	ОбновитьФормуПослеДействия(Итог);
	Возврат Итог;

КонецФункции

&НаСервере
Функция ОтветитьНаЗапросНаСервере(Знач Принять, Знач Причина)

	Итог = ЭДО_Сервер.ОтветитьНаЗапросАннулирования(ДокументСсылка, Принять, Причина);
	ОбновитьФормуПослеДействия(Итог);
	Возврат Итог;

КонецФункции

// Перечитывание формы не должно съесть итог действия: Платформа может не ответить на обновление.
&НаСервере
Процедура ОбновитьФормуПослеДействия(Итог)

	Попытка
		ЗаполнитьИзБазы();
		ЗаполнитьИзПлатформыНаСервере();
	Исключение
		Итог.Текст = Итог.Текст + " Данные формы обновить не удалось: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + " Нажмите «Обновить».";
	КонецПопытки;
	Сообщение = Итог.Текст + ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");

КонецПроцедуры

