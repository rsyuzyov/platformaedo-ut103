КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументИзБазы()

	Заголовок = "Состояние ЭДО: " + Строка(?(ЗначениеЗаполнено(ДокументСсылка), ДокументСсылка, КонтрагентСсылка));

	// Подпись поля зависит от вида документа: "Накладная" для реализации, "Акт сверки" для акта.
	Элементы.Накладная.Заголовок = ?(ЭтоАктСверки(), "Акт сверки", "Накладная");

	ЗапросАннулирования = "";
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Накладная = "не выбран: выберите документ в списке на закладке ""Контрагент""";
		ТекущийСтатус = "";
		СтатусЧЗ = "";
		Элементы.ГруппаЗапросАннулирования.Видимость = Ложь;
		Возврат;
	КонецЕсли;

	Накладная = СокрЛП(ДокументСсылка.Номер) + " от " + Формат(ДокументСсылка.Дата, "ДФ=dd.MM.yyyy");

	// Статус из колонки "ЭДО", ее ведет регламент сверки статусов.
	ТекущийСтатус = "";
	СвойствоСтатус = ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние");
	Если СвойствоСтатус <> Неопределено И НЕ СвойствоСтатус.Пустая() Тогда
		ТекущийСтатус = ЗначениеСвойства(ДокументСсылка, СвойствоСтатус);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекущийСтатус) Тогда
		ТекущийСтатус = "в ЭДО не отправлялся";
	КонецЕсли;

	// Фиксация пива в ГИС МТ: свойство ведет регламент сверки статусов, карточка его только показывает.
	СтатусЧЗ = "";
	СвойствоЧЗ = ЭДО_Сервер.СвойствоОбъектов("ЭДО_СтатусГИСМТ");
	Если СвойствоЧЗ <> Неопределено И НЕ СвойствоЧЗ.Пустая() Тогда
		СтатусЧЗ = ЗначениеСвойства(ДокументСсылка, СвойствоЧЗ);
	КонецЕсли;
	СтатусЧЗ = ЭДО_Сервер.ТекстЧестногоЗнакаДляПоказа(СтатусЧЗ, Истина);   // ЩА 15.10.2026 [yan]
	Если НЕ ЗначениеЗаполнено(СтатусЧЗ) Тогда
		СтатусЧЗ = "не запрашивался";
	КонецЕсли;

	// Входящий запрос контрагента на аннулирование, его ставит сторож.
	СвойствоЗапрос = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ЗапросАннулирования");
	Если СвойствоЗапрос <> Неопределено И НЕ СвойствоЗапрос.Пустая() Тогда
		ЗапросАннулирования = СокрЛП(Строка(ЗначениеСвойства(ДокументСсылка, СвойствоЗапрос)));
	КонецЕсли;
	Элементы.ГруппаЗапросАннулирования.Видимость = ЗначениеЗаполнено(ЗапросАннулирования);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКонтрагентаИзБазы()

	КонтрагентПредставление = Строка(КонтрагентСсылка);

	// Статус связи с контрагентом. Запасной путь - прямо из свойства: в ранних сборках
	// метода ЭДО_Сервер.СтатусСвязиЭДО не было.
	Соглашение = "";
	Попытка
		// Связь пары «организация документа - контрагент», как в отборе очереди.
		ОрганизацияСвязи = Неопределено;
		Если ЗначениеЗаполнено(ДокументСсылка) И ЭДО_Сервер.ЕстьРеквизитДокумента(ДокументСсылка, "Организация") Тогда
			ОрганизацияСвязи = ДокументСсылка.Организация;
		КонецЕсли;
		Соглашение = Строка(ЭДО_Сервер.СтатусСвязиЭДО(КонтрагентСсылка, ОрганизацияСвязи));
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ЗаполнитьКонтрагентаИзБазы: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		СвойствоСвязи = ЭДО_Сервер.СвойствоОбъектов("ЭДО_СтатусСвязи");
		Если СвойствоСвязи <> Неопределено И НЕ СвойствоСвязи.Пустая() Тогда
			Соглашение = ЗначениеСвойства(КонтрагентСсылка, СвойствоСвязи);
		КонецЕсли;
	КонецПопытки;
	СтатусСоглашения = ПредставлениеСоглашения(Соглашение);

	// Привязанный адрес ЭДО и его оператор.
	ИдентификаторЭДО = ИдентификаторКонтрагента(КонтрагентСсылка);
	ОператорЭДО = ИмяОператора(ИдентификаторЭДО);

	// Снимая адрес без замены (ЭДО Лайт), регламент связей оставляет статус связи снятого адреса.
	Если НЕ ЗначениеЗаполнено(ИдентификаторЭДО) Тогда
		СтатусСоглашения = "адреса ЭДО нет, отправлять некуда"
			+ ?(ЗначениеЗаполнено(Соглашение), " (статус " + ВРег(СокрЛП(Соглашение)) + " относится к прежнему адресу)", "");
	КонецЕсли;

	// Пауза отправки контрагенту: причина вместе с датой постановки.
	ПаузаОтправки = ЭДО_Сервер.ПричинаПаузыКонтрагента(КонтрагентКарточки());
	Элементы.ГруппаПауза.Видимость = ЗначениеЗаполнено(ПаузаОтправки);

КонецПроцедуры

&НаСервере
Функция ЭтоАктСверки()
	Возврат ЗначениеЗаполнено(ДокументСсылка)
		И ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АктСверкиВзаиморасчетов");
КонецФункции

&НаСервере
Функция ЗначениеСвойства(Объект, Свойство)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Значения.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК Значения
		|ГДЕ
		|	Значения.Объект = &Объект
		|	И Значения.Свойство = &Свойство");
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Строка(Выборка.Значение));
	КонецЕсли;
	Возврат "";

КонецФункции

&НаСервере
Функция ПредставлениеСоглашения(Знач Код)

	Код = ВРег(СокрЛП(Код));
	Если Код = "ESTABLISHED" Тогда
		Возврат "ESTABLISHED — связь установлена, отправлять можно";
	ИначеЕсли Код = "NO_CONTACT" Тогда
		Возврат "NO_CONTACT — приглашение не принято, документы не дойдут";
	ИначеЕсли Код = "BROKEN" Тогда
		Возврат "BROKEN — связь разорвана, нужно повторное приглашение";
	ИначеЕсли НЕ ЗначениеЗаполнено(Код) Тогда
		Возврат "неизвестно — связь ни разу не проверялась";
	КонецЕсли;
	Возврат Код;

КонецФункции

&НаСервере
Процедура ЗаполнитьИзПлатформыНаСервере()

	Таблица = НоваяТаблицаИстории();

	Сообщение = "";
	ПредупреждениеКПП = "";

	Попытка
		Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Ложь, ОрганизацияКарточки()) Тогда
			Сообщение = "Не удалось получить токен Платформы — история не загружена.";
			ЗавершитьИсторию(Таблица);
			Возврат;
		КонецЕсли;
		Токен = ЭДО_Сервер.ТекущийТокен(ОрганизацияКарточки());
		НашГид = ЭДО_Сервер.ГидОрганизации(ОрганизацияКарточки());

		Соединение = ЭДО_Сервер.СоединениеСОператором(20);

		// История ищется по всем адресам контрагента, а не только по привязанному сейчас: документ уходил
		// на адрес, привязанный тогда. Несколько recipient_id оператор принимает одним запросом.
		ТекущийАдрес = СокрЛП(ИдентификаторЭДО);
		СписокАдресов = Новый Массив;
		Если ЗначениеЗаполнено(ТекущийАдрес) Тогда
			СписокАдресов.Добавить(ТекущийАдрес);
		КонецЕсли;
		НеполныйСписок = Ложь;

		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
		Заголовки.Вставить("accept", "application/json;charset=UTF-8");
		Реквизиты = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(ДокументСсылка.Контрагент, "ИНН, КПП");
		// Идентификаторы у оператора регистронезависимы, а в базе лежат в любом регистре.
		Для Каждого АдресКарточки Из ПривязанныеАдресаПоИНН(Реквизиты.ИНН) Цикл
			Если НЕ АдресЕстьВСписке(СписокАдресов, АдресКарточки) Тогда
				СписокАдресов.Добавить(АдресКарточки);
			КонецЕсли;
		КонецЦикла;
		Если ЗначениеЗаполнено(СокрЛП(Реквизиты.ИНН)) Тогда
			// Реестр ФНС отвечает быстро, его спрашиваем при каждом открытии; статусы связей - по кнопке "Обновить список".
			Попытка
				Реестр = АдресаКонтрагентаИзРеестра(Соединение, Заголовки,
					СокрЛП(Реквизиты.ИНН), СокрЛП(Реквизиты.КПП));
				ПредупреждениеКПП = ПредупреждениеОКПП(Реквизиты.КПП, Реестр);
				Если Реестр.Ошибка Тогда
					НеполныйСписок = Истина;
				Иначе
					Для Каждого АдресРеестра Из Реестр.Адреса Цикл
						Если НЕ АдресЕстьВСписке(СписокАдресов, АдресРеестра) Тогда
							СписокАдресов.Добавить(СокрЛП(АдресРеестра));
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			Исключение
				ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ЗаполнитьИзПлатформыНаСервере: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
				НеполныйСписок = Истина;
			КонецПопытки;
		Иначе
			НеполныйСписок = Истина;
		КонецЕсли;

		Если СписокАдресов.Количество() = 0 Тогда
			Сообщение = "У контрагента нет ни привязанного адреса ЭДО, ни адресов в реестре ФНС —"
				+ " искать в Платформе не по чему."
				+ ?(ЗначениеЗаполнено(ПредупреждениеКПП), Символы.ПС + ПредупреждениеКПП, "");
			ЗавершитьИсторию(Таблица);
			Возврат;
		КонецЕсли;

		// Интервал дат обязателен (без него HTTP 400) и не шире 31 дня, поэтому период режется на окна.
		Финиш = НачалоДня(ТекущаяУниверсальнаяДата());
		// День запаса слева: дата накладной местная, а окно запроса в UTC.
		НачалоПоиска = НачалоДня(ДокументСсылка.Дата) - 86400;
		// Потолок глубины - полгода: дальше история не нужна, а каждый запрос стоит времени открытия.
		ГраницаПоиска = Финиш - 185 * 86400;
		ПоискУсечен = Ложь;
		Если НачалоПоиска < ГраницаПоиска Тогда
			НачалоПоиска = ГраницаПоиска;
			ПоискУсечен = Истина;
		КонецЕсли;
		Окна = Новый Массив;
		НачалоОкна = НачалоПоиска;
		Пока НачалоОкна <= Финиш Цикл
			КонецОкна = НачалоОкна + 30 * 86400;
			Если КонецОкна > Финиш Тогда
				КонецОкна = Финиш;
			КонецЕсли;
			Окна.Добавить(Новый Структура("Нач, Кон", НачалоОкна, КонецОкна));
			НачалоОкна = КонецОкна + 86400;
		КонецЦикла;

		ХвостАдресов = "";
		Для Каждого АдресПоиска Из СписокАдресов Цикл
			ХвостАдресов = ХвостАдресов + "&recipient_id=" + АдресПоиска;
		КонецЦикла;

		НомерНакладной = СокрЛП(ДокументСсылка.Номер);
		// У формализованного акта сверки дата в карточке - день формирования файла, а не дата акта:
		// по дате такой акт не найти, и карточка выдала бы отправленный акт за неотправленный.
		ДатаНакладной = ?(ЭтоАктСверки(), "", Формат(ДокументСсылка.Дата, "ДФ=dd.MM.yyyy"));
		Операторы = ТаблицаОператоров();
		РазмерСтраницы = 100;
		ВыборкаОборвалась = Ложь;

		// ИННПокупателей: идентификатор карточки -> ИНН покупателя из нее, чтобы не выдать экземпляр
		// прежнего контрагента за отправку текущему.
		Контекст = Новый Структура("Токен, ИННПокупателей", Токен, Новый Соответствие);
		Обход = ПрочитатьКарточки(Соединение, Контекст, ХвостАдресов, Окна, Таблица, Операторы,
			НомерНакладной, ДатаНакладной);
		ВыборкаОборвалась = Обход.Оборвалось;
		Сообщение = Обход.Сообщение;

		// Документ мог уйти на адрес, которого нет ни у контрагента, ни в реестре ФНС. Последняя попытка -
		// сплошной обход периода без фильтра по получателю; он дороже, поэтому только когда иначе пусто.
		СплошнойОбход = Ложь;
		Если Таблица.Количество() = 0 И НЕ ВыборкаОборвалась Тогда
			ОбходСплошной = ПрочитатьКарточки(Соединение, Контекст, "", Окна, Таблица, Операторы,
				НомерНакладной, ДатаНакладной);
			ВыборкаОборвалась = ОбходСплошной.Оборвалось;
			Если ЗначениеЗаполнено(ОбходСплошной.Сообщение) Тогда
				Сообщение = ОбходСплошной.Сообщение;
			КонецЕсли;
			СплошнойОбход = (Таблица.Количество() > 0);
		КонецЕсли;

		// ЩА 23.10.2026 [yan]: перебор оборвался (HTTP не 200, таймаут), не найдя ничего, - показанный список
		// не трогаем вовсе (реквизит История остается прежним), меняется только сообщение. Иначе кнопка
		// превращала заполненную карточку в пустую (23.10, ЛП-00057250: 400 от оператора); повторный запрос
		// текущего экземпляра здесь не делаем - при недоступном операторе он стер бы список так же (ревью Codex 957).
		Если ВыборкаОборвалась И Таблица.Количество() = 0 Тогда
			Сообщение = "Полный поиск по номеру накладной не выполнен, показана прежняя история: " + Сообщение;
			Возврат;
		КонецЕсли;
		ОписаниеПоиска = "искали и по адресам контрагента (" + СписокАдресов.Количество() + "), и сплошным обходом периода."
			+ ?(НеполныйСписок, " ⚠ Реестр ФНС не ответил, список адресов может быть неполным.", "")
			+ ?(ПоискУсечен, " ⚠ Искали за последние полгода: документ старше.", "");
		// ЩА 23.10.2026 [yan]: ноль находок по номеру - тоже не повод стирать список: экземпляр, показанный
		// по идентификатору, у оператора есть, просто за потолком выдачи (Лион-Трейд: 1000+ документов в окне,
		// ЛП-00057250 23.10). Прежняя история остается, в сообщении - чем искали.
		Если Таблица.Количество() = 0 И История.Количество() > 0 Тогда
			Сообщение = "В Платформе по номеру накладной отправок не найдено — " + ОписаниеПоиска
				+ " Сохранена ранее показанная история."
				+ ?(ЗначениеЗаполнено(ПредупреждениеКПП), Символы.ПС + ПредупреждениеКПП, "");
			Возврат;
		КонецЕсли;
		ЗавершитьЗаполнениеИзПлатформы(Соединение, Контекст, Таблица, ТекущийАдрес, Реквизиты.ИНН, ОписаниеПоиска, СплошнойОбход);

	Исключение
		Сообщение = "Ошибка обращения к Платформе: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Если ЗначениеЗаполнено(ПредупреждениеКПП) Тогда
		Сообщение = ПредупреждениеКПП + ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");
	КонецЕсли;
	ЗавершитьИсторию(Таблица);

КонецПроцедуры

// ЩА 23.10.2026 [yan]: открытие формы и «Обновить» - без перебора списков у оператора. Текущий экземпляр
// документа известен (ЭДО_ИдентификаторДокумента): один запрос по нему дает состояние, сумму и цепочку.
// Перебор по номеру и адресам (ЗаполнитьИзПлатформыНаСервере) остался за кнопкой «Запросить историю»:
// он нужен, когда экземпляров несколько или документ уходил мимо расширения, а стоит десятков запросов
// списков - у покупателя с тысячами документов в окне (Лион-Трейд) экземпляр в них и не попадал.
&НаСервере
Процедура ЗаполнитьТекущийЭкземплярНаСервере()

	Таблица = НоваяТаблицаИстории();
	Сообщение = "";
	Попытка
		ИдТекущего = ИдентификаторТекущегоЭкземпляра();
		Если НЕ ЗначениеЗаполнено(ИдТекущего) Тогда
			Сообщение = "У документа нет идентификатора у оператора - через Платформу он не отправлялся."
				+ " Отправки по номеру накладной - кнопкой «Запросить историю».";
			ЗавершитьИсторию(Таблица);
			Возврат;
		КонецЕсли;
		Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Ложь, ОрганизацияКарточки()) Тогда
			Сообщение = "Не удалось получить токен Платформы — история не загружена.";
			ЗавершитьИсторию(Таблица);
			Возврат;
		КонецЕсли;
		Токен = ЭДО_Сервер.ТекущийТокен(ОрганизацияКарточки());
		Соединение = ЭДО_Сервер.СоединениеСОператором(20);
		Контекст = Новый Структура("Токен, ИННПокупателей", Токен, Новый Соответствие);

		ЗапросПлатформы = Новый HTTPЗапрос(ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/documents?id="
			+ ИдТекущего + "&page_size=10");
		ЗапросПлатформы.Заголовки.Вставить("Authorization", "Bearer " + Контекст.Токен);
		ЗапросПлатформы.Заголовки.Вставить("accept", "application/json;charset=UTF-8");
		ОтветПлатформы = Соединение.Получить(ЗапросПлатформы);
		Если ОтветПлатформы.КодСостояния = 401 Тогда
			// Токен протух (после блокировки оператора - у обеих учетных записей): перевыпуск и один повтор.
			ЭДО_Сервер.ОбеспечитьТокен(Истина, ОрганизацияКарточки());
			Контекст.Токен = ЭДО_Сервер.ТекущийТокен(ОрганизацияКарточки());
			ЗапросПлатформы.Заголовки.Вставить("Authorization", "Bearer " + Контекст.Токен);
			ОтветПлатформы = Соединение.Получить(ЗапросПлатформы);
		КонецЕсли;
		Если ОтветПлатформы.КодСостояния <> 200 Тогда
			Сообщение = "Платформа ответила HTTP " + ОтветПлатформы.КодСостояния + " на запрос экземпляра " + ИдТекущего
				+ ": " + Лев(ОтветПлатформы.ПолучитьТелоКакСтроку("UTF-8"), 200) + " Нажмите «Обновить»; статус в шапке взят из базы.";
			ЗавершитьИсторию(Таблица);
			Возврат;
		КонецЕсли;
		ЧтениеОтвета = Новый ЧтениеJSON;
		ЧтениеОтвета.УстановитьСтроку(ОтветПлатформы.ПолучитьТелоКакСтроку("UTF-8"));
		Карточки = ПрочитатьJSON(ЧтениеОтвета, Ложь);
		ЧтениеОтвета.Закрыть();
		Если ТипЗнч(Карточки) = Тип("Массив") Тогда
			Операторы = ТаблицаОператоров();
			Для Каждого Карточка Из Карточки Цикл
				Если ТипЗнч(Карточка) = Тип("Структура") Тогда
					ДобавитьСтрокуИстории(Таблица, Карточка, Контекст, Операторы);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Реквизиты = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(ДокументСсылка.Контрагент, "ИНН");
		ЗавершитьЗаполнениеИзПлатформы(Соединение, Контекст, Таблица, СокрЛП(ИдентификаторЭДО), Реквизиты.ИНН,
			"у оператора нет экземпляра " + ИдТекущего + " (удален или идентификатор от другого контура)."
			+ " Отправки по номеру накладной - кнопкой «Запросить историю».", Ложь);
	Исключение
		Сообщение = "Ошибка обращения к Платформе: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	ЗавершитьИсторию(Таблица);

КонецПроцедуры

// Идентификатор текущего экземпляра у оператора из свойства документа (как читает его сверка).
&НаСервере
Функция ИдентификаторТекущегоЭкземпляра()

	СвойствоИд = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если СвойствоИд = Неопределено ИЛИ СвойствоИд.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	Значение = ЭДО_Сервер.ЗначениеСвойстваОбъекта(ДокументСсылка, СвойствоИд);
	// Неразрывные пробелы появляются, если идентификатор когда-то записали форматом числа.
	Возврат СокрЛП(СтрЗаменить(Строка(Значение), Символы.НПП, ""));

КонецФункции

&НаСервере
Функция НоваяТаблицаИстории()

	// Собираем в таблицу значений, а не в реквизит формы: у ДанныеФормыКоллекция нет Сортировать.
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Создан", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("Оператор", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Тип", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Причина", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)));
	Таблица.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(30)));
	Таблица.Колонки.Добавить("СтатусПоРусски", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));   // ЩА 15.10.2026 [yan]
	Таблица.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	Возврат Таблица;

КонецФункции

// ЩА 23.10.2026 [yan]: общий хвост заполнения из Платформы (полного перебора и запроса по идентификатору):
// причины из цепочек, сверка покупателя по ИНН, статус в шапке, колонка «ЭДО». ОписаниеПоиска - чем искали,
// для сообщения «не найдено».
&НаСервере
Процедура ЗавершитьЗаполнениеИзПлатформы(Соединение, Контекст, Таблица, Знач ТекущийАдрес, Знач ИННКонтрагента,
	Знач ОписаниеПоиска, Знач СплошнойОбход)

		Таблица.Сортировать("Создан Убыв");

		// Причины отказа в самой карточке нет - добираем ее из цепочки документа.
		ДополнитьПричинамиИзЦепочек(Соединение, Контекст, Таблица);

		// Контрагента в документе меняют и после отправки, а номер и дата те же: история находит экземпляр
		// прежнего покупателя. Покупатель экземпляра - в самой карточке, сверяем по ИНН.
		ИННКонтрагента = СокрЛП(ИННКонтрагента);
		Для Каждого СтрокаИстории Из Таблица Цикл
			ИННКарточки = Контекст.ИННПокупателей.Получить(СтрокаИстории.Идентификатор);
			Если ЗначениеЗаполнено(ИННКарточки) И ЗначениеЗаполнено(ИННКонтрагента)
				И ИННКарточки <> ИННКонтрагента Тогда
				СтрокаИстории.Причина = Лев("Другой покупатель (ИНН " + ИННКарточки + ")"
					+ ?(ЗначениеЗаполнено(СтрокаИстории.Причина), ": " + СтрокаИстории.Причина, ""), 500);
			КонецЕсли;
		КонецЦикла;

		Если Таблица.Количество() = 0 Тогда
			Если НЕ ЗначениеЗаполнено(Сообщение) Тогда
				Сообщение = "В Платформе по этой накладной отправок не найдено — " + ОписаниеПоиска;
			КонецЕсли;
		Иначе
			// Актуальный экземпляр выбирается по тому же правилу, что в регламенте сверки статусов.
			Последняя = Таблица[0];
			Для Каждого СтрокаИстории Из Таблица Цикл
				// Акт сверки - по правилу пересадки ид (подписанный сильнее живого дубля), УПД - как прежде.
				Если ?(ЭтоАктСверки(),
					ЭДО_Регламенты.ЭкземплярПредпочтительнее(СтрокаИстории.Статус, СтрокаИстории.Создан,
						Последняя.Статус, Последняя.Создан),
					ЭДО_Регламенты.ЭкземплярАктуальнее(СтрокаИстории.Статус, СтрокаИстории.Создан,
						Последняя.Статус, Последняя.Создан)) Тогда
					Последняя = СтрокаИстории;
				КонецЕсли;
			КонецЦикла;
			ИННПоследней = Контекст.ИННПокупателей.Получить(Последняя.Идентификатор);
			ДругойПокупатель = ЗначениеЗаполнено(ИННПоследней) И ЗначениеЗаполнено(ИННКонтрагента)
				И ИННПоследней <> ИННКонтрагента;
			// Хвост статуса пересобираем, а не дописываем: процедура вызывается при каждом обновлении формы.
	ПозХвоста = Найти(ТекущийСтатус, "  ·  в Платформе: ");
	Если ПозХвоста > 0 Тогда
		ТекущийСтатус = Лев(ТекущийСтатус, ПозХвоста - 1);
	КонецЕсли;
	ТекущийСтатус = ТекущийСтатус + "  ·  в Платформе: " + Последняя.Статус
				+ " от " + Формат(Последняя.Создан, "ДФ=dd.MM.yyyy HH:mm")
				+ ?(ДругойПокупатель, " другому покупателю", "")
				+ ?(Таблица.Количество() > 1, "  (отправок: " + Таблица.Количество() + ")", "");
			Сообщение = Последняя.Причина;
			Если СплошнойОбход Тогда
				Сообщение = "Отправка найдена сплошным обходом: ее получателя нет ни у контрагента"
					+ " сейчас, ни в реестре ФНС."
					+ ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");
			КонецЕсли;
			// Сказать прямо, что документ ушел не на тот адрес, что привязан сейчас.
			Если ЗначениеЗаполнено(ТекущийАдрес)
				И ЗначениеЗаполнено(Последняя.Адрес)
				И ВРег(Последняя.Адрес) <> ВРег(ТекущийАдрес) Тогда
				Сообщение = "Последняя отправка ушла на другой адрес: " + Последняя.Оператор
					+ " (" + Последняя.Адрес + "). Сейчас у контрагента привязан " + ОператорЭДО + "."
					+ ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");
			КонецЕсли;

			// Колонку "ЭДО" ведет регламент, и она отстает от оператора. Раз карточка спросила его вживую,
			// свежий статус пишем в колонку сразу.
			Если ДругойПокупатель Тогда
				// Статус экземпляра другого покупателя в колонку не пишем.
				Сообщение = "Контрагента в документе сменили после отправки: последний экземпляр ушел"
					+ " покупателю с ИНН " + ИННПоследней + ", а в документе сейчас «"
					+ Строка(ДокументСсылка.Контрагент) + "» (ИНН " + ИННКонтрагента + ")."
					+ " Статус «" + Последняя.Статус + "» относится к тому экземпляру;"
					+ " текущему контрагенту документ не отправлялся."
					+ ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");
				ОбновленнаяКолонка = "";
			Иначе
				ЭкземплярКолонки = ?(ЭтоАктСверки(), ЭкземплярДляКолонки(Таблица, Последняя), Последняя);
				ОбновленнаяКолонка = ЗаписатьСтатусПлатформыВКолонку(ЭкземплярКолонки.Статус,
					ЭкземплярКолонки.Идентификатор, ЭкземплярКолонки.Причина);
			КонецЕсли;
			Если ЗначениеЗаполнено(ОбновленнаяКолонка) Тогда
				Сообщение = "Колонка «ЭДО» обновлена: " + ОбновленнаяКолонка
					+ ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");
			КонецЕсли;
		КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗавершитьИсторию(Таблица)

	// Единственный выход истории в форму: у процедуры заполнения три точки возврата, и строка
	// СБИС должна появляться во всех - в том числе когда Платформа вообще не ответила.
	Если ДобавитьОтправкуСБИС(Таблица) Тогда
		Сообщение = "Была отправка через СБИС (старая интеграция): в Платформе её нет по устройству,"
			+ " показана отдельной строкой и без времени отправки."
			+ ?(ЗначениеЗаполнено(Сообщение), Символы.ПС + Сообщение, "");
	КонецЕсли;

	Таблица.Сортировать("Создан Убыв");
	ЗначениеВРеквизитФормы(Таблица, "История");

КонецПроцедуры

&НаСервере
Функция ДобавитьОтправкуСБИС(Таблица)

	// Отправок старой интеграции со СБИС у оператора нет, след остается только в свойствах документа.
	// Без этой строки документ, отправленный до перехода, выглядит неотправленным.
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	СтатусСБИС = "";
	ИдСБИС = "";
	Попытка
		СвойствоСтатусаСБИС = ЭДО_Сервер.СвойствоОбъектов("ДокументСБИС_Статус");
		Если СвойствоСтатусаСБИС <> Неопределено И НЕ СвойствоСтатусаСБИС.Пустая() Тогда
			СтатусСБИС = СокрЛП(ЗначениеСвойства(ДокументСсылка, СвойствоСтатусаСБИС));
		КонецЕсли;
		СвойствоИдаСБИС = ЭДО_Сервер.СвойствоОбъектов("ДокументСБИС_Ид");
		Если СвойствоИдаСБИС <> Неопределено И НЕ СвойствоИдаСБИС.Пустая() Тогда
			ИдСБИС = СокрЛП(ЗначениеСвойства(ДокументСсылка, СвойствоИдаСБИС));
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ДобавитьОтправкуСБИС: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		// История у оператора важнее: остаемся без строки СБИС, но карточку не роняем.
		Возврат Ложь;
	КонецПопытки;

	Если НЕ ЗначениеЗаполнено(СтатусСБИС) И НЕ ЗначениеЗаполнено(ИдСБИС) Тогда
		Возврат Ложь;
	КонецЕсли;

	СтрокаСБИС = Таблица.Добавить();
	// Времени отправки в базе нет (UUID в ДокументСБИС_Ид дает время создания документа), поэтому
	// ставим дату документа и говорим об этом прямо.
	СтрокаСБИС.Создан = НачалоДня(ДокументСсылка.Дата);
	СтрокаСБИС.Оператор = "СБИС";
	// Статусы СБИС - свободный текст: в колонку идет короткая часть, целиком - в причину.
	СтрокаСБИС.Статус = ?(ВРег(Лев(СтатусСБИС, 6)) = "ОШИБКА", "Ошибка", Лев(СтатусСБИС, 50));
	СтрокаСБИС.Тип = "старая интеграция";
	СтрокаСБИС.Причина = "Отправка через СБИС. Время отправки в базе не хранится — показана дата"
		+ " документа."
		+ ?(ЗначениеЗаполнено(СтатусСБИС), " Статус СБИС: " + СтатусСБИС + ".", "")
		+ ?(ЗначениеЗаполнено(ИдСБИС), " Ид СБИС: " + ИдСБИС + ".", "");
	// Идентификатор пустой намеренно: по нему кнопки XML, печатной формы и сайта ходят к оператору,
	// а карточки СБИС там нет.

	Возврат Истина;

КонецФункции

&НаСервере
Функция АдресаКонтрагентаИзРеестра(Соединение, Заголовки, Знач ИНН, Знач КПП)

	// Пустой ответ реестра не значит "адресов нет": так же он отвечает на протухший токен. На пустой
	// ответ перевыпускаем токен и спрашиваем еще раз, теперь со сверкой КПП по ЕГРЮЛ.
	Реестр = ЭДО_Сервер.АдресаИзРеестраФНС(Соединение, Заголовки, ИНН, КПП);
	Если Реестр.Ошибка ИЛИ Реестр.Адреса.Количество() = 0 Тогда
		Если ЭДО_Сервер.ОбеспечитьТокен(Истина, ОрганизацияКарточки()) Тогда
			Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(ОрганизацияКарточки()));
		КонецЕсли;
		Реестр = ЭДО_Сервер.АдресаИзРеестраФНС(Соединение, Заголовки, ИНН, КПП, ЭДО_Сервер.НоваяСверкаЕГРЮЛ(1));
	КонецЕсли;
	Возврат Реестр;

КонецФункции

&НаСервере
Функция ПредупреждениеОКПП(Знач КПП, Знач Реестр)

	Если НЕ ЗначениеЗаполнено(Реестр.КППЕГРЮЛ) ИЛИ Реестр.КППЕГРЮЛ = СокрЛП(КПП) Тогда
		Возврат "";
	КонецЕсли;

	// У обособленного подразделения код причины постановки на учет (5 и 6 разряды КПП) не равен 01,
	// а в ЕГРЮЛ стоит КПП головной организации. Расхождение тут законно, править карточку не надо.
	КППКарточки = СокрЛП(КПП);
	Если СтрДлина(КППКарточки) = 9 И Сред(КППКарточки, 5, 2) <> "01" Тогда
		Возврат "КПП в карточке контрагента (" + КППКарточки + ") - это КПП обособленного подразделения,"
			+ " в ЕГРЮЛ у головной организации " + Реестр.КППЕГРЮЛ + ": адреса ЭДО искали по головному.";
	КонецЕсли;

	Возврат "КПП в карточке контрагента (" + КППКарточки + ") не совпадает с ЕГРЮЛ (" + Реестр.КППЕГРЮЛ + "):"
		+ " адреса ЭДО искали по КПП из ЕГРЮЛ. Исправьте КПП в карточке контрагента, иначе устаревший"
		+ " уйдет покупателем в УПД.";

КонецФункции

&НаСервере
Функция ПрочитатьКарточки(Соединение, Контекст, ХвостАдресов, Окна, Таблица, Операторы,
	Знач НомерНакладной, Знач ДатаНакладной)

	// Обходит период окнами и страницами, добирая в Таблицу карточки этой накладной.
	// Токен живет в Контексте: при 401 он перевыпускается здесь, и новый нужен вызывающему.
	Итог = Новый Структура("Оборвалось, Сообщение", Ложь, "");
	// ЩА 23.10.2026 [yan]: у оператора предел (page + 1) * page_size <= 1000 (HTTP 400 сверх него; проверено
	// 23.10: 9/100 и 0/1000 - 200, 5/200 и 1/1000 - 400). Окно видит не больше 1000 карточек при любом
	// размере страницы, поэтому берем их одной страницей: 1 запрос на окно вместо 10. 200 с 10 страницами
	// давало 400 на 6-й и стирало историю.
	РазмерСтраницы = 1000;
	ПределСтраниц = 1000 / РазмерСтраницы;

	Для Каждого ОкноПериода Из Окна Цикл
		ОтДата = Формат(ОкноПериода.Нач, "ДФ=yyyy-MM-dd") + "T00:00:00.000Z";
		ДоДата = Формат(ОкноПериода.Кон, "ДФ=yyyy-MM-dd") + "T23:59:59.000Z";

		// Общего числа карточек оператор не сообщает - листаем, пока страница полная и позволяет предел.
		Для Страница = 0 По ПределСтраниц - 1 Цикл
			Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/documents?created_from=" + ОтДата
				+ "&created_till=" + ДоДата
				+ "&sender_id=" + ЭДО_Сервер.ГидОрганизации(ОрганизацияКарточки())
				+ ХвостАдресов
				+ "&page=" + Формат(Страница, "ЧН=0; ЧГ=0") + "&page_size=" + Формат(РазмерСтраницы, "ЧГ=0");   // ЩА 23.10.2026 [yan]: без разделителя разрядов (ревью Codex 957)

			Карточки = Неопределено;
			БылоНеПринятиеТокена = Ложь;
			// При авариях оператора часть запросов виснет по таймауту - три попытки.
			Для НомерПопытки = 1 По 3 Цикл
				ЗапросПлатформы = Новый HTTPЗапрос(Путь);
				ЗапросПлатформы.Заголовки.Вставить("Authorization", "Bearer " + Контекст.Токен);
				ЗапросПлатформы.Заголовки.Вставить("accept", "application/json;charset=UTF-8");
				Попытка
					ОтветПлатформы = Соединение.Получить(ЗапросПлатформы);
				Исключение
					ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ПрочитатьКарточки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
					Продолжить;
				КонецПопытки;
				Если ОтветПлатформы.КодСостояния = 401 Тогда
					// ОбеспечитьТокен(Ложь) проверяет только наличие токена, 401 лечится перевыпуском.
					// Не помог и перевыпуск - сообщаем об этом, а не о таймауте.
					БылоНеПринятиеТокена = Истина;
					ЭДО_Сервер.ОбеспечитьТокен(Истина, ОрганизацияКарточки());
					Контекст.Токен = ЭДО_Сервер.ТекущийТокен(ОрганизацияКарточки());
					Продолжить;
				КонецЕсли;
				БылоНеПринятиеТокена = Ложь;
				Если ОтветПлатформы.КодСостояния <> 200 Тогда
					Итог.Сообщение = "Платформа ответила HTTP " + ОтветПлатформы.КодСостояния + ": "
						+ Лев(ОтветПлатформы.ПолучитьТелоКакСтроку("UTF-8"), 200);
					Итог.Оборвалось = Истина;
					Прервать;
				КонецЕсли;
				ЧтениеОтвета = Новый ЧтениеJSON;
				ЧтениеОтвета.УстановитьСтроку(ОтветПлатформы.ПолучитьТелоКакСтроку("UTF-8"));
				Карточки = ПрочитатьJSON(ЧтениеОтвета, Ложь);
				ЧтениеОтвета.Закрыть();
				Прервать;
			КонецЦикла;

			Если Итог.Оборвалось Тогда
				Прервать;
			КонецЕсли;
			Если Карточки = Неопределено Тогда
				Если БылоНеПринятиеТокена Тогда
					Итог.Сообщение = "Платформа не приняла токен (HTTP 401), и перевыпустить его не удалось."
						+ " История не загружена — проверьте подпись и настройки ЭДО.";
				Иначе
					Итог.Сообщение = "Платформа не отвечает (таймаут). Нажмите «Обновить»;"
						+ " статус в шапке взят из базы.";
				КонецЕсли;
				Итог.Оборвалось = Истина;
				Прервать;
			КонецЕсли;

			Для Каждого Карточка Из Карточки Цикл
				Если НЕ Карточка.Свойство("invoice") ИЛИ Карточка["invoice"] = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Счет = Карточка["invoice"];
				НомерКарточки = ?(Счет.Свойство("num"), СокрЛП(Строка(Счет["num"])), "");
				ДатаКарточки = ?(Счет.Свойство("date"), СокрЛП(Строка(Счет["date"])), "");
				// Ключ - номер и дата: номер накладной повторяется по годам. Без даты (акт сверки) номер
				// однозначен в окне поиска, которое начинается с даты документа.
				Если НомерКарточки <> НомерНакладной
					ИЛИ (ЗначениеЗаполнено(ДатаНакладной) И ДатаКарточки <> ДатаНакладной) Тогда
					Продолжить;
				КонецЕсли;

				ДобавитьСтрокуИстории(Таблица, Карточка, Контекст, Операторы);
			КонецЦикла;

			Если Карточки.Количество() < РазмерСтраницы Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если Итог.Оборвалось Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// ЩА 23.10.2026 [yan]: карточка оператора - строка истории. Вынесено из ПрочитатьКарточки: тот же разбор
// нужен запросу по идентификатору текущего экземпляра (открытие формы без перебора списков).
&НаСервере
Процедура ДобавитьСтрокуИстории(Таблица, Знач Карточка, Контекст, Знач Операторы)

	// Адрес получателя карточки - ответ "куда ушел документ"; оператор опознается по первым трем символам.
	АдресПолучателя = "";
	Если Карточка.Свойство("recipient") И Карточка["recipient"] <> Неопределено
		И Карточка["recipient"].Свойство("id") Тогда
		АдресПолучателя = СокрЛП(Строка(Карточка["recipient"]["id"]));
	КонецЕсли;
	// Ид приходит числом: Строка() вставила бы разделители групп, и запрос по нему получил бы HTTP 400.
	ИдентификаторКарточки = ?(Карточка.Свойство("id"), Формат(Карточка["id"], "ЧГ=0"), "");
	// При сплошном обходе та же карточка может прийти повторно - не задваиваем.
	Если ЗначениеЗаполнено(ИдентификаторКарточки)
		И Таблица.НайтиСтроки(Новый Структура("Идентификатор", ИдентификаторКарточки)).Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ИдентификаторКарточки)
		И Карточка.Свойство("invoice") И Карточка["invoice"] <> Неопределено
		И Карточка["invoice"].Свойство("buyer") И Карточка["invoice"]["buyer"] <> Неопределено
		И Карточка["invoice"]["buyer"].Свойство("inn") Тогда
		Контекст.ИННПокупателей.Вставить(ИдентификаторКарточки,
			СокрЛП(Строка(Карточка["invoice"]["buyer"]["inn"])));
	КонецЕсли;

	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Идентификатор = ИдентификаторКарточки;
	// ЩА 15.10.2026 [yan]: итоговое состояние экземпляра (newStatus): у аннулированного status
	// остается ACCEPTED, и карточка показала бы подписанный документ и вернула бы его в колонку.
	НоваяСтрока.Статус = ЭДО_Сервер.СтатусКарточкиОператора(Карточка);
	// ЩА 15.10.2026 [yan]: состояние словами рядом с кодом API и сумма, с которой экземпляр ушел.
	НоваяСтрока.СтатусПоРусски = СтатусПоРусски(НоваяСтрока.Статус);
	Сумма = ЭДО_Сервер.СуммаКарточкиОператора(Карточка);
	НоваяСтрока.Сумма = ?(Сумма = Неопределено, 0, Сумма);
	НоваяСтрока.Тип = ?(Карточка.Свойство("type"), Строка(Карточка["type"]), "");
	НоваяСтрока.Создан = ДатаИзISO(?(Карточка.Свойство("created"), Строка(Карточка["created"]), ""));
	НоваяСтрока.Причина = ПричинаКарточки(Карточка);
	НоваяСтрока.Адрес = АдресПолучателя;
	НоваяСтрока.Оператор = ИмяОператораПоТаблице(АдресПолучателя, Операторы);

КонецПроцедуры

// ++ ЩА 15.10.2026 [yan]: состояние словами - те же тексты, что в колонке «ЭДО».
&НаСервереБезКонтекста
Функция СтатусПоРусски(Знач КодAPI)

	Текст = ЭДО_Регламенты.КартаСтатусовПлатформы().Получить(ВРег(СокрЛП(КодAPI)));
	Возврат ?(Текст = Неопределено, СокрЛП(КодAPI), Текст);

КонецФункции

// Ход выбранной отправки: оператор отдает всю цепочку документа (подтверждения, подпись или отказ
// контрагента, аннулирование) со временем каждого шага. Читается при выборе строки истории.
&НаКлиенте
Процедура ИсторияПриАктивизацииСтроки(Элемент)

	ОтключитьОбработчикОжидания("ПоказатьХодВыбраннойОтправки");
	ПодключитьОбработчикОжидания("ПоказатьХодВыбраннойОтправки", 0.3, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьХодВыбраннойОтправки() Экспорт

	ТекущиеДанные = Элементы.История.ТекущиеДанные;
	ИдЭкземпляра = ?(ТекущиеДанные = Неопределено, "", СокрЛП(ТекущиеДанные.Идентификатор));
	Если КэшХодаДокумента = Неопределено Тогда
		КэшХодаДокумента = Новый Соответствие;
	КонецЕсли;
	Шаги = Неопределено;
	Если ЗначениеЗаполнено(ИдЭкземпляра) Тогда
		Шаги = КэшХодаДокумента.Получить(ИдЭкземпляра);
		Если Шаги = Неопределено Тогда
			Шаги = ХодДокументаНаСервере(ИдЭкземпляра);
			КэшХодаДокумента.Вставить(ИдЭкземпляра, Шаги);
		КонецЕсли;
	КонецЕсли;

	ХодДокумента.Очистить();
	Если Шаги <> Неопределено Тогда
		Для Каждого Шаг Из Шаги Цикл
			ЗаполнитьЗначенияСвойств(ХодДокумента.Добавить(), Шаг);
		КонецЦикла;
	КонецЕсли;
	Элементы.ГруппаХодДокумента.Заголовок = ?(ЗначениеЗаполнено(ИдЭкземпляра),
		"Ход документа (отправка " + ИдЭкземпляра + ")", "Ход документа (выбранная отправка)");

КонецПроцедуры

// Честный знак спрашиваем только у документа с фиксацией: без нее вход в ГИС МТ - лишняя подпись и ошибка в ЖР.
&НаСервере
Функция ДокументуНуженЧестныйЗнак()

	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	СвойствоЧЗ = ЭДО_Сервер.СвойствоОбъектов("ЭДО_СтатусГИСМТ");
	Если СвойствоЧЗ = Неопределено ИЛИ СвойствоЧЗ.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	СтатусЧЗ = СокрЛП(Строка(ЗначениеСвойства(ДокументСсылка, СвойствоЧЗ)));
	Возврат ЗначениеЗаполнено(СтатусЧЗ) И СтатусЧЗ <> ЭДО_Сервер.ТекстСтатусаГИСМТНеТребуется();

КонецФункции

// Шаги цепочки у оператора; ошибка чтения - одной строкой-шагом.
&НаСервере
Функция ХодДокументаНаСервере(Знач ИдЭкземпляра)

	Попытка
		Ход = ЭДО_Сервер.ХодДокументаОператора(ИдЭкземпляра, ОрганизацияКарточки(), ДокументуНуженЧестныйЗнак());
	Исключение
		Ход = Новый Структура("Шаги, Ошибка", Новый Массив, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Шаги = Ход.Шаги;
	Если ЗначениеЗаполнено(Ход.Ошибка) Тогда
		Шаги.Добавить(Новый Структура("Время, Шаг, Тип, Статус", Дата(1, 1, 1), Ход.Ошибка, "", ""));
	КонецЕсли;
	Возврат Шаги;

КонецФункции
