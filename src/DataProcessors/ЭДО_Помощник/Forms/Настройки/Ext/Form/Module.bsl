// Настройки расширения "ЦентрУправленияЭДО": одно место, где видно и правится всё,
// от чего зависит работа отправки.
//
// Форма ничего не знает про состав ОБЩИХ настроек: и поля, и проверка готовности идут
// от реестра `ЭДО_Сервер.ОписаниеНастроекЭДО()`. Добавил параметр в реестр -
// он появляется в проверке сам; на форму остаётся добавить только поле.
//
// Всё, что относится к КОНКРЕТНОЙ организации (сертификат подписанта, идентификатор
// участника, МЧД, разрешение отправки), с 17.09.2026 живёт не здесь, а в отдельной
// учетной записи организации - см. карточку "УчетнаяЗапись". Эта форма только
// показывает список учетных записей (таблица только читает) и открывает карточку
// на добавление/изменение/удаление. Причина переноса: у организации может быть
// несколько разных сертификатов и МЧД, а общая настройка одна на всю базу.
//
// Общие настройки пишутся в ОБЩЕЕ хранилище (пользователь ""), а не в персональное.
// До 22.08.2026 отпечаток подписанта лежал в настройках того, кто его задал: работало
// лишь потому, что настраивал и отправлял один служебный пользователь, а у бухгалтера
// из его сеанса подпись не находилась.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПрочитатьНастройкиВФорму();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
// Как у любой формы: «Записать и закрыть» / «Записать» / «Проверить», без окна «записано».
Процедура ЗаписатьНастройки(Команда)
	ЗаписатьНастройкиНаСервере();
	Оповестить("ЭДО_НастройкиИзменены");
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	ЗаписатьНастройкиНаСервере();
	Оповестить("ЭДО_НастройкиИзменены");
	Закрыть();
КонецПроцедуры

// «Проверить» перечитывает настройки из хранилища - и до этой правки молча затирала всё,
// что человек набрал, но ещё не записал. Проверить можно только записанное, поэтому
// при незаписанных изменениях спрашиваем.
// Незаписанное определяется сравнением полей с хранилищем, а не флагом Модифицированность:
// у формы обработки без основного реквизита платформа этот флаг при вводе не ставит.
// Таблица учетных записей в это сравнение НЕ входит: она правится и пишется только
// через карточку, отдельно от общих полей, поэтому незаписанных изменений по ней
// в этой форме просто не бывает.
&НаКлиенте
Процедура ПроверитьГотовность(Команда)
	Если ЕстьНезаписанныеИзменения() Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПроверитьГотовностьЗавершение", ЭтотОбъект),
			"Есть незаписанные изменения. Проверяется только то, что записано." + Символы.ПС
			+ "Записать настройки и проверить?", РежимДиалогаВопрос.ДаНетОтмена);
		Возврат;
	КонецЕсли;
	ПрочитатьНастройкиВФорму();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьГотовностьЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаписатьНастройкиНаСервере();
		Оповестить("ЭДО_НастройкиИзменены");
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		// проверяем записанное, введённое в полях не трогаем
		ЗаполнитьСостояниеГотовности();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗавестиСвойства(Команда)
	Вопрос = "Завести недостающие свойства объектов? Существующие не изменяются.";
	ПоказатьВопрос(Новый ОписаниеОповещения("ЗавестиСвойстваЗавершение", ЭтотОбъект),
		Вопрос, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ЗавестиСвойстваЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, ЗавестиСвойстваНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВОбщие(Команда)
	// Разовая операция для баз, настроенных до 22.08.2026: поднимает персональные
	// значения в общие, чтобы настройки видел не только тот, кто их задавал.
	ПоказатьПредупреждение(, ПеренестиВОбщиеНаСервере());
КонецПроцедуры

// Сбрасываются настройки с умолчанием в коде (список - ЭДО_Сервер.ИменаНастроекСбросаПоУмолчанию)
// и таблица операторов. Прочие поля формы, в том числе незаписанные, не трогаются.
&НаКлиенте
Процедура СброситьНастройкиПоУмолчанию(Команда)

	Изменения = ИзмененияПриСбросеНастроекНаСервере();
	Если Изменения.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Настройки и так по умолчанию, сбрасывать нечего.");
		Возврат;
	КонецЕсли;

	Вопрос = "Вернуть настройки ЭДО к значениям по умолчанию?" + Символы.ПС + Символы.ПС
		+ "- " + СтрСоединить(Изменения, Символы.ПС + "- ") + Символы.ПС + Символы.ПС
		+ "Записанные значения будут удалены, начнут действовать умолчания расширения. "
		+ "Учетные записи, сертификаты, МЧД, адреса и даты не изменятся.";
	ПоказатьВопрос(Новый ОписаниеОповещения("СброситьНастройкиПоУмолчаниюЗавершение", ЭтотОбъект),
		Вопрос, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СброситьНастройкиПоУмолчаниюЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Сброшено = СброситьНастройкиПоУмолчаниюНаСервере();
	Если Сброшено.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Настройки и так по умолчанию, сбрасывать нечего.");
		Возврат;
	КонецЕсли;
	Оповестить("ЭДО_НастройкиИзменены");
	ПоказатьПредупреждение(, "Настройки ЭДО возвращены к значениям по умолчанию:" + Символы.ПС
		+ "- " + СтрСоединить(Сброшено, Символы.ПС + "- "));

КонецПроцедуры

// Учетные записи организаций - таблица только показывает, всё правится в карточке.

&НаКлиенте
Процедура ДобавитьУчетнуюЗапись(Команда)
	ОткрытьКарточкуУчетнойЗаписи(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьУчетнуюЗапись(Команда)
	СтрокаТекущая = Элементы.УчетныеЗаписи.ТекущиеДанные;
	Если СтрокаТекущая = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите строку таблицы.");
		Возврат;
	КонецЕсли;
	ОткрытьКарточкуУчетнойЗаписи(СтрокаТекущая.Организация);
КонецПроцедуры

// Двойной щелчок и Enter по строке таблицы - то же самое, что кнопка "Изменить".
&НаКлиенте
// ⚠️ Второй параметр события - идентификатор строки (число), а не её данные.
Процедура УчетныеЗаписиВыбор(Элемент, ВыбраннаяСтрока, ПоляСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Данные = УчетныеЗаписи.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОткрытьКарточкуУчетнойЗаписи(Данные.Организация);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКарточкуУчетнойЗаписи(Организация)
	// «Параметры» — свойство самой формы, присваивать его нельзя: «Поле объекта недоступно для записи»
	ПараметрыКарточки = Новый Структура("Организация", Организация);
	ОткрытьФорму("Обработка.ЭДО_Помощник.Форма.УчетнаяЗапись", ПараметрыКарточки, ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьУчетнуюЗапись(Команда)
	СтрокаТекущая = Элементы.УчетныеЗаписи.ТекущиеДанные;
	Если СтрокаТекущая = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите строку таблицы.");
		Возврат;
	КонецЕсли;
	Вопрос = "Удалить учётную запись организации «" + СтрокаТекущая.Организация + "»?";
	ДополнительныеПараметры = Новый Структура("Организация", СтрокаТекущая.Организация);
	ПоказатьВопрос(Новый ОписаниеОповещения("УдалитьУчетнуюЗаписьЗавершение", ЭтотОбъект, ДополнительныеПараметры),
		Вопрос, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьУчетнуюЗаписьЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	УдалитьУчетнуюЗаписьНаСервере(ДополнительныеПараметры.Организация);
	ЗаполнитьУчетныеЗаписи();
	ЗаполнитьСостояниеГотовности();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьГотовностьУчетнойЗаписи(Команда)
	СтрокаТекущая = Элементы.УчетныеЗаписи.ТекущиеДанные;
	Если СтрокаТекущая = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите строку таблицы.");
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, ГотовностьУчетнойЗаписиНаСервере(СтрокаТекущая.Организация));
КонецПроцедуры

// Карточка учетной записи закрылась с записью - перечитываем таблицу и готовность.
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ЭДО_УчетнаяЗаписьИзменена" Тогда
		ЗаполнитьУчетныеЗаписиНаСервере();
		ЗаполнитьСостояниеГотовности();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПрочитатьНастройкиВФорму()

	ГлубинаДнейОтправки     = ЭДО_Сервер.НастройкаЭДО("ГлубинаДнейОтправки");
	ЛимитДокументовЗаПрогон = ЭДО_Сервер.НастройкаЭДО("ЛимитДокументовЗаПрогон");
	ПрочиеНашиАдресаЭДО     = ЭДО_Сервер.НастройкаЭДО("ПрочиеНашиАдресаЭДО");
	ГотовыеСтатусыЗаказа    = ЭДО_Сервер.НастройкаЭДО("ГотовыеСтатусыЗаказа");
	ГлубинаДнейСинхронизацииСтатусов = ЭДО_Сервер.НастройкаЭДО("ГлубинаДнейСинхронизацииСтатусов");
	ТаймаутHTTPСек          = ЭДО_Сервер.НастройкаЭДО("ТаймаутHTTPСек");
	ДатаНачалаАвтоотправкиУКД   = ЭДО_Сервер.ДатаНачалаАвтоотправкиУКД();
	ПаузаПередОтправкойУКДМинут = ЭДО_Сервер.НастройкаЭДО("ПаузаПередОтправкойУКДМинут");
	НастройкиОператоров = ЭДО_Сервер.НастройкиОператоровЭДОТекстом();

	ЗаполнитьДействующееОкно();
	ЗаполнитьУчетныеЗаписи();
	ЗаполнитьСостояниеГотовности();
КонецПроцедуры

// Какое окно отбора получится из двух ограничений - показываем, чтобы не считать в уме.
// Дата начала у каждой организации своя, здесь - самая ранняя из учетных записей.
&НаСервере
Процедура ЗаполнитьДействующееОкно()
	ДатаНачалаРанняя = ЭДО_Сервер.РанняяДатаНачалаОтправки();
	Граница = ЭДО_Сервер.НижняяГраницаОтбора();
	ДействующееОкно = "с " + Формат(Граница, "ДФ=dd.MM.yyyy")
		+ ?(ЗначениеЗаполнено(ДатаНачалаРанняя) И Граница = НачалоДня(ДатаНачалаРанняя),
			" (по дате начала организации)", " (по глубине в днях)");
КонецПроцедуры

// Отличается ли хоть одно ОБЩЕЕ поле формы от записанного в хранилище.
// Учетные записи организаций не сравниваются: таблица только показывает, изменения
// в неё приходят исключительно из карточки и пишутся сразу.
&НаСервере
Функция ЕстьНезаписанныеИзменения()
	Возврат ГлубинаДнейОтправки <> ЭДО_Сервер.НастройкаЭДО("ГлубинаДнейОтправки")
		ИЛИ ЛимитДокументовЗаПрогон <> ЭДО_Сервер.НастройкаЭДО("ЛимитДокументовЗаПрогон")
		ИЛИ СокрЛП(ПрочиеНашиАдресаЭДО) <> ЭДО_Сервер.НастройкаЭДО("ПрочиеНашиАдресаЭДО")
		ИЛИ СокрЛП(ГотовыеСтатусыЗаказа) <> ЭДО_Сервер.НастройкаЭДО("ГотовыеСтатусыЗаказа")
		ИЛИ ГлубинаДнейСинхронизацииСтатусов <> ЭДО_Сервер.НастройкаЭДО("ГлубинаДнейСинхронизацииСтатусов")
		ИЛИ ТаймаутHTTPСек <> ЭДО_Сервер.НастройкаЭДО("ТаймаутHTTPСек")
		ИЛИ ДатаНачалаАвтоотправкиУКД <> ЭДО_Сервер.ДатаНачалаАвтоотправкиУКД()
		ИЛИ ПаузаПередОтправкойУКДМинут <> ЭДО_Сервер.НастройкаЭДО("ПаузаПередОтправкойУКДМинут")
		ИЛИ СокрЛП(НастройкиОператоров) <> ЭДО_Сервер.НастройкиОператоровЭДОТекстом();
КонецФункции

&НаСервере
Процедура ЗаполнитьСостояниеГотовности()
	Недостающее = ЭДО_Сервер.НедостающиеНастройкиЭДО();
	Если Недостающее.Количество() = 0 Тогда
		СостояниеГотовности = "Всё настроено — отправка работать может.";
	Иначе
		СостояниеГотовности = "Отправка НЕ РАБОТАЕТ, пока не устранено:" + Символы.ПС
			+ "• " + СтрСоединить(Недостающее, Символы.ПС + "• ");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиНаСервере()
	ЭДО_Сервер.УстановитьНастройкуЭДО("ГлубинаДнейОтправки", ГлубинаДнейОтправки);
	ЭДО_Сервер.УстановитьНастройкуЭДО("ЛимитДокументовЗаПрогон", ЛимитДокументовЗаПрогон);
	ЭДО_Сервер.УстановитьНастройкуЭДО("ПрочиеНашиАдресаЭДО", СокрЛП(ПрочиеНашиАдресаЭДО));
	ЭДО_Сервер.УстановитьНастройкуЭДО("ГотовыеСтатусыЗаказа", СокрЛП(ГотовыеСтатусыЗаказа));
	ЭДО_Сервер.УстановитьНастройкуЭДО("ГлубинаДнейСинхронизацииСтатусов", ГлубинаДнейСинхронизацииСтатусов);
	ЭДО_Сервер.УстановитьНастройкуЭДО("ТаймаутHTTPСек", ТаймаутHTTPСек);
	ЭДО_Сервер.УстановитьНастройкуЭДО("ДатаНачалаАвтоотправкиУКД", НачалоДня(ДатаНачалаАвтоотправкиУКД));
	ЭДО_Сервер.УстановитьНастройкуЭДО("ПаузаПередОтправкойУКДМинут", ПаузаПередОтправкойУКДМинут);
	// Таблицу операторов пишем, только когда ее меняли: иначе умолчания закрепились бы в хранилище.
	Если СокрЛП(НастройкиОператоров) <> ЭДО_Сервер.НастройкиОператоровЭДОТекстом() Тогда
		ЭДО_Сервер.ЗаписатьНастройкиОператоровЭДОИзТекста(НастройкиОператоров);
	КонецЕсли;
	ПрочитатьНастройкиВФорму();
КонецПроцедуры

&НаСервере
Функция ЗавестиСвойстваНаСервере()
	Итог = ЭДО_Сервер.ОбеспечитьСвойстваОбъектов();
	ЗаполнитьСостояниеГотовности();
	Возврат СтрСоединить(Итог, Символы.ПС);
КонецФункции

&НаСервере
Функция ПеренестиВОбщиеНаСервере()
	Итог = ЭДО_Сервер.ПеренестиНастройкиВОбщие();
	ПрочитатьНастройкиВФорму();
	Возврат СтрСоединить(Итог, Символы.ПС);
КонецФункции

&НаСервереБезКонтекста
Функция ИзмененияПриСбросеНастроекНаСервере()
	Возврат ЭДО_Сервер.ИзмененияПриСбросеНастроекЭДО();
КонецФункции

// Перечитываются только сброшенные поля: имена реквизитов формы совпадают с именами настроек.
&НаСервере
Функция СброситьНастройкиПоУмолчаниюНаСервере()

	Сброшено = ЭДО_Сервер.СброситьНастройкиЭДОПоУмолчанию();

	Для Каждого ИмяНастройки Из ЭДО_Сервер.ИменаНастроекСбросаПоУмолчанию() Цикл
		ЭтотОбъект[ИмяНастройки] = ЭДО_Сервер.НастройкаЭДО(ИмяНастройки);
	КонецЦикла;
	НастройкиОператоров = ЭДО_Сервер.НастройкиОператоровЭДОТекстом();
	ЗаполнитьДействующееОкно();
	ЗаполнитьСостояниеГотовности();

	Возврат Сброшено;

КонецФункции

&НаСервере
Процедура ЗаполнитьУчетныеЗаписиНаСервере()
	ЗаполнитьУчетныеЗаписи();
КонецПроцедуры

// Строит таблицу формы из ЭДО_Сервер.УчетныеЗаписиЭДО() - той же функции, которой пользуется
// сама отправка. Показанное здесь и то, что реально проверяется перед отправкой, - одно и то же.
&НаСервере
Процедура ЗаполнитьУчетныеЗаписи()

	УчетныеЗаписи.Очистить();

	Для Каждого Запись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
		Строка = УчетныеЗаписи.Добавить();
		Строка.Организация            = Запись.Организация;
		Строка.Оператор                = Запись.Оператор;
		Строка.Сертификат              = ПредставлениеСертификатаКратко(Запись.Отпечаток);
		Строка.Подписант                = ПредставлениеТипаПодписанта(Запись.ТипПодписанта);
		Строка.НомерМЧД                = Запись.НомерМЧД;
		Строка.ОтправлятьСДаты          = Запись.ДатаНачалаОтправки;
		Строка.ИдентификаторУчастника  = Запись.ИдентификаторУчастника;

		Претензии = ЭДО_Сервер.НедостаткиУчетнойЗаписиЭДО(Запись);
		Если Претензии.Количество() = 0 Тогда
			Строка.Готовность = "готова";
		Иначе
			Строка.Готовность = СтрСоединить(Претензии, "; ");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредставлениеСертификатаКратко(Знач Отпечаток)
	Состояние = ЭДО_Сервер.СостояниеСертификатаПоОтпечатку(Отпечаток, Ложь);
	Если НЕ Состояние.Задан Тогда
		Возврат "не задан";
	ИначеЕсли НЕ Состояние.Найден Тогда
		Возврат "не установлен у сервера";
	ИначеЕсли Состояние.Просрочен Тогда
		Возврат Состояние.Субъект + " (ПРОСРОЧЕН)";
	КонецЕсли;
	Возврат Состояние.Субъект + " — до " + Формат(Состояние.ДействителенПо, "ДФ=dd.MM.yyyy");
КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеТипаПодписанта(Знач ТипПодписанта)
	Если ТипПодписанта = "ЮЛ" Тогда
		Возврат "Юридическое лицо";
	ИначеЕсли ТипПодписанта = "ИП" Тогда
		Возврат "Индивидуальный предприниматель";
	ИначеЕсли ТипПодписанта = "ФЛ" Тогда
		Возврат "Физическое лицо по МЧД";
	КонецЕсли;
	Возврат ТипПодписанта;
КонецФункции

&НаСервере
Процедура УдалитьУчетнуюЗаписьНаСервере(Организация)
	Записи = ЭДО_Сервер.СохраненныеУчетныеЗаписиЭДО();
	Оставшиеся = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Если Запись.Организация <> Организация Тогда
			Оставшиеся.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	ЭДО_Сервер.ЗаписатьУчетныеЗаписиЭДО(Оставшиеся);
КонецПроцедуры

&НаСервере
Функция ГотовностьУчетнойЗаписиНаСервере(Организация)
	Запись = ЭДО_Сервер.УчетнаяЗаписьЭДО(Организация);
	Если Запись = Неопределено Тогда
		Возврат "Учетная запись не найдена.";
	КонецЕсли;
	Претензии = ЭДО_Сервер.НедостаткиУчетнойЗаписиЭДО(Запись);
	Если Претензии.Количество() = 0 Тогда
		Возврат "Учетная запись организации «" + Строка(Организация) + "» готова к отправке.";
	КонецЕсли;
	Возврат "Не готова:" + Символы.ПС + "• " + СтрСоединить(Претензии, Символы.ПС + "• ");
КонецФункции

#КонецОбласти
