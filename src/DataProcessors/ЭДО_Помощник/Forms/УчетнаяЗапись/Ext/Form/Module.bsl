// Карточка учетной записи ОДНОЙ организации у оператора ЭДО (17.09.2026).
//
// Всё, что относится к организации - сертификат подписанта, идентификатор участника,
// МЧД, разрешение отправки, - живёт здесь, а не разбросано по общим настройкам
// и справочнику "Организации". Список карточек показывает форма настроек
// (таблица "Учётные записи организаций"), сама карточка правит ровно одну запись.
//
// Параметр открытия: Организация (СправочникСсылка.Организации либо Неопределено).
// Неопределено - создаём новую запись, поле "Организация" доступно для выбора.
// Задана - открываем существующую, поле "Организация" не даём менять (иначе можно
// было бы породить вторую запись для той же организации - см. ПриСозданииНаСервере).
//
// Данные хранятся ДВУМЯ разными механизмами, и это намеренно:
// - всё про оператора (сертификат, МЧД, идентификатор, хост, дата начала) - в массиве
//   учетных записей ЭДО_Сервер.УчетныеЗаписиЭДО()/ЗаписатьУчетныеЗаписиЭДО();
// - разрешение отправки ("ЭДО_РазрешенаОтправка") - в регистре свойств объектов,
//   как обычное свойство организации: так его видит и типовой отбор, и старая
//   логика ЭДО_Сервер.ОрганизацииСРазрешеннойОтправкой(), написанная до появления
//   учетных записей. Если свойство ещё не заведено (старая база) - запись
//   учетной записи всё равно проходит, но флаг молча не пишется, а карточка
//   честно говорит об этом в блоке "Готовность записи".

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Организация = Параметры.Организация;

	Если ЗначениеЗаполнено(Организация) Тогда
		// существующая запись - организацию не даём поменять, иначе получим вторую
		// запись на ту же организацию вместо правки этой
		Элементы.Организация.Доступность = Ложь;
		ПрочитатьЗаписьВФорму(Организация);
	Иначе
		Оператор = "Платформа";
		ТипПодписанта = "ЮЛ";
		Хост = "api.platformaofd.ru";
	КонецЕсли;

	// доступность полей МЧД при создании — прямо здесь: клиентскую процедуру с сервера не позвать
	Элементы.НомерМЧД.Доступность = (ТипПодписанта = "ФЛ");
	Элементы.ДатаМЧД.Доступность = (ТипПодписанта = "ФЛ");
	ОбновитьСведенияОСертификате(Ложь);
	ЗаполнитьГотовностьЗаписи();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	Если ЗаписатьНаКлиенте() Тогда
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)
	ЗаписатьНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура Проверить(Команда)
	ЗаполнитьГотовностьЗаписи();
	// Молчаливый пересчёт блока внизу выглядит как «кнопка не работает» — говорим результат окном.
	ПоказатьПредупреждение(, ГотовностьЗаписи, , "Проверка учётной записи");
КонецПроцедуры

&НаКлиенте
Процедура ТипПодписантаПриИзменении(Элемент)
	ОбновитьДоступностьПолейМЧД();
КонецПроцедуры

&НаКлиенте
Процедура ОтпечатокНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Список = СертификатыСервераСписком();
	Если Список.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "У учётки сервера 1С не установлено ни одного сертификата."
			+ " Ставить надо в хранилище ТОЙ учётки, под которой работает служба кластера.");
		Возврат;
	КонецЕсли;
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ВыбратьСертификатЗавершение", ЭтотОбъект),
		Список, , Список[0]);
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСертификатЗавершение(ЭлементСписка, ДополнительныеПараметры) Экспорт
	Если ЭлементСписка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Отпечаток = ЭлементСписка.Значение;
	ОбновитьСведенияОСертификате(Ложь);
	ЗаполнитьГотовностьЗаписи();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСертификат(Команда)
	// сетевая проверка: ходит к УЦ за списком отзыва
	ОбновитьСведенияОСертификате(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьМЧД(Команда)
	Итог = ПроверитьМЧДНаСервере();
	Если НЕ Итог.Успех Тогда
		ПоказатьПредупреждение(, Итог.Текст);
		Возврат;
	КонецЕсли;

	ДатаМЧД = НачалоДня(Итог.ДатаНачала);

	Строки = Новый Массив;
	Строки.Добавить("Действует с " + Формат(Итог.ДатаНачала, "ДФ=dd.MM.yyyy")
		+ " по " + Формат(Итог.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	Строки.Добавить("Статус: " + Итог.Статус);
	Строки.Добавить("");
	Строки.Добавить("Полномочия:");
	Строки.Добавить(Итог.Полномочия);

	ПоказатьПредупреждение(, СтрСоединить(Строки, Символы.ПС));
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ЗаписатьНаКлиенте()
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ПоказатьПредупреждение(, "Не выбрана организация.");
		Возврат Ложь;
	КонецЕсли;
	Итог = ЗаписатьНаСервере();
	Если НЕ Итог.Успех Тогда
		ПоказатьПредупреждение(, Итог.Сообщение);
		Возврат Ложь;
	КонецЕсли;
	Оповестить("ЭДО_УчетнаяЗаписьИзменена");
	Возврат Истина;
КонецФункции

&НаСервере
Функция ЗаписатьНаСервере()

	Результат = Новый Структура("Успех, Сообщение", Истина, "");

	// Новая запись по организации, у которой запись уже есть, - не дублируем,
	// а предупреждаем и переключаемся на правку существующей.
	Существующая = ЭДО_Сервер.УчетнаяЗаписьЭДО(Организация);
	Если Существующая <> Неопределено И Элементы.Организация.Доступность = Истина Тогда
		Элементы.Организация.Доступность = Ложь;
		ПрочитатьЗаписьВФорму(Организация);
		Результат.Успех = Ложь;
		Результат.Сообщение = "У организации «" + Строка(Организация) + "» уже есть учетная запись."
			+ " Открыта она - правьте её, вторую заводить не нужно.";
		Возврат Результат;
	КонецЕсли;

	Записи = ЭДО_Сервер.СохраненныеУчетныеЗаписиЭДО();
	Найдена = Ложь;
	Для Каждого Запись Из Записи Цикл
		Если Запись.Организация = Организация Тогда
			ПеренестиПоляФормыВЗапись(Запись);
			Найдена = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ Найдена Тогда
		НоваяЗапись = ЭДО_Сервер.НоваяУчетнаяЗаписьЭДО();
		НоваяЗапись.Организация = Организация;
		ПеренестиПоляФормыВЗапись(НоваяЗапись);
		Записи.Добавить(НоваяЗапись);
	КонецЕсли;
	ЭДО_Сервер.ЗаписатьУчетныеЗаписиЭДО(Записи);

	СообщениеОСвойстве = ЗаписатьФлагРазрешеннойОтправки();
	Если ЗначениеЗаполнено(СообщениеОСвойстве) Тогда
		Результат.Сообщение = СообщениеОСвойстве;
	КонецЕсли;

	ЗаполнитьГотовностьЗаписи();
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ПеренестиПоляФормыВЗапись(Запись)
	Запись.Отпечаток              = СокрЛП(Отпечаток);
	Запись.ИдентификаторУчастника = СокрЛП(ИдентификаторУчастника);
	Запись.ТипПодписанта           = ТипПодписанта;
	Запись.НомерМЧД                = СокрЛП(НомерМЧД);
	Запись.ДатаМЧД                 = ДатаМЧД;
	Запись.ДолжностьПодписанта    = СокрЛП(ДолжностьПодписанта);
	Запись.Оператор                = СокрЛП(Оператор);
	Запись.ДатаНачалаОтправки      = ОтправлятьСДаты;
	Запись.Хост                    = СокрЛП(Хост);
КонецПроцедуры

// Разрешение отправки - отдельное свойство ОРГАНИЗАЦИИ, а не поле учетной записи:
// его же читает старая логика (ОрганизацииСРазрешеннойОтправкой, типовой отбор к отправке).
// Возврат: "" если записали, иначе текст причины, почему не получилось.
&НаСервере
Функция ЗаписатьФлагРазрешеннойОтправки()
	Свойство = ЭДО_Сервер.СвойствоОбъектов("ЭДО_РазрешенаОтправка");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат "Свойство «ЭДО_РазрешенаОтправка» не заведено в базе — флаг «Разрешена отправка»"
			+ " НЕ записан. Сначала выполните «Завести свойства» в форме настроек.";
	КонецЕсли;
	ЭДО_Сервер.ЗаписатьФлагСвойства(Организация, Свойство, РазрешенаОтправка);
	Возврат "";
КонецФункции

&НаСервере
Процедура ПрочитатьЗаписьВФорму(Знач ОрганизацияЗаписи)

	Запись = ЭДО_Сервер.УчетнаяЗаписьЭДО(ОрганизацияЗаписи);
	Если Запись = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Отпечаток              = Запись.Отпечаток;
	ИдентификаторУчастника = Запись.ИдентификаторУчастника;
	ТипПодписанта           = ?(ЗначениеЗаполнено(Запись.ТипПодписанта), Запись.ТипПодписанта, "ЮЛ");
	НомерМЧД                = Запись.НомерМЧД;
	ДатаМЧД                 = Запись.ДатаМЧД;
	ДолжностьПодписанта    = Запись.ДолжностьПодписанта;
	Оператор                = ?(ЗначениеЗаполнено(Запись.Оператор), Запись.Оператор, "Платформа");
	ОтправлятьСДаты         = Запись.ДатаНачалаОтправки;
	Хост                    = Запись.Хост;

	Свойство = ЭДО_Сервер.СвойствоОбъектов("ЭДО_РазрешенаОтправка");
	Если Свойство <> Неопределено И НЕ Свойство.Пустая() Тогда
		РазрешенаОтправка = ЭДО_Сервер.ФлагСвойстваВключён(
			ЭДО_Сервер.ЗначениеСвойстваОбъекта(ОрганизацияЗаписи, Свойство));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьПолейМЧД()
	ДоступноМЧД = (ТипПодписанта = "ФЛ");
	Элементы.НомерМЧД.Доступность = ДоступноМЧД;
	Элементы.ДатаМЧД.Доступность = ДоступноМЧД;
КонецПроцедуры

&НаСервере
Функция СертификатыСервераСписком()
	Список = Новый СписокЗначений;
	Для Каждого С Из ЭДО_Сервер.УстановленныеСертификатыПодписи() Цикл
		Список.Добавить(С.Отпечаток, С.Представление);
	КонецЦикла;
	Возврат Список;
КонецФункции

&НаСервере
Процедура ОбновитьСведенияОСертификате(ПроверятьОтзыв)
	Состояние = ЭДО_Сервер.СостояниеСертификатаПоОтпечатку(Отпечаток, ПроверятьОтзыв);
	СведенияОСертификате = СтроковыеСведенияОСертификате(Состояние);
КонецПроцедуры

&НаСервереБезКонтекста
Функция СтроковыеСведенияОСертификате(Состояние)
	Если НЕ Состояние.Задан Тогда
		Возврат "Отпечаток не задан — нажмите «Выбрать сертификат».";
	КонецЕсли;
	Если НЕ Состояние.Найден Тогда
		Возврат "🔴 " + Состояние.Описание;
	КонецЕсли;

	Текст = Состояние.Субъект + Символы.ПС + Состояние.Описание;
	Если Состояние.Отозван ИЛИ Состояние.Просрочен Тогда
		Возврат "🔴 " + Текст;
	ИначеЕсли Состояние.ДнейОсталось <= 30 Тогда
		Возврат "⚠️ Сертификат кончается меньше чем через месяц — пора перевыпускать." + Символы.ПС + Текст;
	КонецЕсли;
	Возврат Текст;
КонецФункции

// Проверка МЧД в реестре ФНС (m4d.nalog.gov.ru): запрос 1 без авторизации отдаёт даты
// и статус, запрос 2 (нужен ИНН представителя из выбранного сертификата) - полномочия.
// Оба запроса читаются как обычный сетевой сбой - ни один не должен ронять карточку.
// Возврат: Структура (Успех, Текст, ДатаНачала, ДатаОкончания, Статус, Полномочия).
&НаСервере
Функция ПроверитьМЧДНаСервере()

	Итог = Новый Структура("Успех, Текст, ДатаНачала, ДатаОкончания, Статус, Полномочия",
		Ложь, "", Дата(1, 1, 1), Дата(1, 1, 1), "", "");

	Номер = СокрЛП(НомерМЧД);
	Если НЕ ЗначениеЗаполнено(Номер) Тогда
		Итог.Текст = "Укажите номер МЧД.";
		Возврат Итог;
	КонецЕсли;

	ТаймаутСек = ЭДО_Сервер.НастройкаЭДО("ТаймаутHTTPСек");

	Попытка
		Соединение = Новый HTTPСоединение("m4d.nalog.gov.ru", 443, , , , ТаймаутСек,
			Новый ЗащищенноеСоединениеOpenSSL());

		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Accept", "*/*");
		// ⚠️ Реестр ФНС отвечает 403 на подпись «1C+Enterprise» в User-Agent (проверено 17.09.2026:
		//    та же ссылка без него или с браузерной подписью - 200). Подписываемся как браузер.
		Заголовки.Вставить("User-Agent", "Mozilla/5.0");
		Запрос = Новый HTTPЗапрос("/api/v1/poar-portal/get_info_short?dovelGuid=" + Номер, Заголовки);
		Ответ = Соединение.Получить(Запрос);
		Тело = Ответ.ПолучитьТелоКакСтроку("UTF-8");

		Если Ответ.КодСостояния = 404 Тогда
			Итог.Текст = "Доверенность с таким номером в реестре не найдена.";
			Возврат Итог;
		КонецЕсли;
		Если Ответ.КодСостояния <> 200 Тогда
			Итог.Текст = "Реестр ФНС ответил HTTP " + Ответ.КодСостояния + ": " + Лев(Тело, 300);
			Возврат Итог;
		КонецЕсли;

		Данные = ДанныеJSON(Тело);
		Если Данные = Неопределено Тогда
			Итог.Текст = "Реестр ФНС вернул нечитаемый ответ: " + Лев(Тело, 300);
			Возврат Итог;
		КонецЕсли;

		Итог.ДатаНачала     = ДатаИзJSON(Строка(Данные.Получить("startDateTime")));
		Итог.ДатаОкончания  = ДатаИзJSON(Строка(Данные.Получить("endDateTime")));
		Статус = Данные.Получить("status");
		Если ТипЗнч(Статус) = Тип("Соответствие") Тогда
			Итог.Статус = Строка(Статус.Получить("status"));
		КонецЕсли;

	Исключение
		Итог.Текст = "Запрос к реестру ФНС не выполнен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Итог;
	КонецПопытки;

	// Запрос 2 - полномочия. Нужен ИНН представителя из сертификата, выбранного
	// в поле "Отпечаток" - если сертификата нет или в нём нет ИНН, второй запрос
	// не имеет смысла, и об этом надо честно сказать, а не считать МЧД непроверенной.
	ИННПредставителя = ИННИзОтпечатка(Отпечаток);
	Если НЕ ЗначениеЗаполнено(ИННПредставителя) Тогда
		Итог.Успех = Истина;
		Итог.Полномочия = "не запрошены — не выбран сертификат или в нём нет ИНН представителя";
		Возврат Итог;
	КонецЕсли;

	ИННОрганизации = СокрЛП(Организация.ИНН);

	Попытка
		ТелоЗапроса = "{""guid"":""" + Номер + """,""innP"":""" + ИННОрганизации
			+ """,""innR"":""" + ИННПредставителя + """}";

		ЗаголовкиПолномочий = Новый Соответствие;
		ЗаголовкиПолномочий.Вставить("Content-Type", "application/json");
		ЗаголовкиПолномочий.Вставить("Accept", "*/*");
		ЗаголовкиПолномочий.Вставить("User-Agent", "Mozilla/5.0");
		ЗапросПолномочий = Новый HTTPЗапрос("/api/v1/poar-portal/get_info_full_no_personal", ЗаголовкиПолномочий);
		ЗапросПолномочий.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		ОтветПолномочий = Соединение.ВызватьHTTPМетод("POST", ЗапросПолномочий);
		ТелоПолномочий = ОтветПолномочий.ПолучитьТелоКакСтроку("UTF-8");

		Если ОтветПолномочий.КодСостояния = 404 Тогда
			ДанныеОшибки = ДанныеJSON(ТелоПолномочий);
			Если ДанныеОшибки <> Неопределено И ЗначениеЗаполнено(ДанныеОшибки.Получить("reason")) Тогда
				Итог.Полномочия = "не получены: " + Строка(ДанныеОшибки.Получить("reason"));
			Иначе
				Итог.Полномочия = "не получены: HTTP 404";
			КонецЕсли;
		ИначеЕсли ОтветПолномочий.КодСостояния <> 200 Тогда
			Итог.Полномочия = "не получены: HTTP " + ОтветПолномочий.КодСостояния + " " + Лев(ТелоПолномочий, 300);
		Иначе
			ДанныеПолномочий = ДанныеJSON(ТелоПолномочий);
			Если ДанныеПолномочий = Неопределено Тогда
				Итог.Полномочия = "получен нечитаемый ответ: " + Лев(ТелоПолномочий, 300);
			Иначе
				СтрокиПолномочий = Новый Массив;
				СобратьПолномочия(ДанныеПолномочий, "", СтрокиПолномочий);
				Если СтрокиПолномочий.Количество() = 0 Тогда
					Итог.Полномочия = "в ответе не найдено узнаваемых полей полномочий";
				Иначе
					Итог.Полномочия = СтрСоединить(СтрокиПолномочий, Символы.ПС);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

	Исключение
		Итог.Полномочия = "не получены: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Итог.Успех = Истина;
	Возврат Итог;

КонецФункции

// ИНН представителя из сертификата по отпечатку. 12 цифр - это ИНН физлица,
// у организаций (10 цифр) представитель по МЧД не бывает. Отпечаток не задан,
// сертификат не установлен или ИНН в нём нет - пустая строка, вызывающий код
// сам решает, что делать (второй запрос просто не отправляется).
&НаСервере
Функция ИННИзОтпечатка(Знач Отпечаток)
	Отпечаток = СокрЛП(Отпечаток);
	Если НЕ ЗначениеЗаполнено(Отпечаток) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		МенеджерКриптографии = Новый МенеджерКриптографии("", "", 80);
		Хранилище = МенеджерКриптографии.ПолучитьХранилищеСертификатов(
			ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
		Сертификат = Хранилище.НайтиПоОтпечатку(Base64Значение(Отпечаток));
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ИННИзОтпечатка: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат "";
	КонецПопытки;
	Если Сертификат = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ИменаИНН = Новый Массив;
	ИменаИНН.Добавить("ИНН");
	ИменаИНН.Добавить("INN");
	ИменаИНН.Добавить("OID1_2_643_3_131_1_1");
	ИменаИНН.Добавить("OID1_2_643_100_4");

	Для Каждого Имя Из ИменаИНН Цикл
		ИНН = ЭДО_Сервер.ПолеСубъектаСертификата(Сертификат.Субъект, Имя);
		Если СтрДлина(СокрЛП(ИНН)) = 12 Тогда
			Возврат СокрЛП(ИНН);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Разбор JSON строкой в Соответствие. Неопределено - если тело не JSON вовсе.
&НаСервереБезКонтекста
Функция ДанныеJSON(Знач Тело)
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Тело);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ДанныеJSON: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат Неопределено;
	КонецПопытки;
	Возврат ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные, Неопределено);
КонецФункции

// Дата из строки вида "2023-08-17T21:00:00.0000000Z" - берём первые 19 символов
// (ГГГГ-ММ-ДДЧЧЧ:ММ:СС), остального XMLЗначение не просит.
&НаСервереБезКонтекста
Функция ДатаИзJSON(Знач Строка)
	Строка = СокрЛП(Строка);
	Если СтрДлина(Строка) < 19 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Возврат XMLЗначение(Тип("Дата"), Лев(Строка, 19));
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ДатаИзJSON: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат Дата(1, 1, 1);
	КонецПопытки;
КонецФункции

// Человекочитаемый текст полномочий из ответа ФНС. Точной структуры ответа нет -
// обходим Соответствие/Массив рекурсивно и печатаем то, что похоже на полномочие
// (ключи с "ower"/"uthorit"/"олномоч"/"code"/"text"/"name"), с ограничением строк -
// ответ бывает многословным, а карточке нужна суть, а не всё дерево целиком.
&НаСервереБезКонтекста
Процедура СобратьПолномочия(Знач Данные, Знач Отступ, СтрокиРезультата)
	Если СтрокиРезультата.Количество() >= 40 Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Для Каждого Элемент Из Данные Цикл
			Ключ = Строка(Элемент.Ключ);
			НижнийКлюч = НРег(Ключ);
			Если СтрНайти(НижнийКлюч, "ower") > 0 ИЛИ СтрНайти(НижнийКлюч, "uthorit") > 0
				ИЛИ СтрНайти(Ключ, "олномоч") > 0 ИЛИ СтрНайти(НижнийКлюч, "code") > 0
				ИЛИ СтрНайти(НижнийКлюч, "text") > 0 ИЛИ СтрНайти(НижнийКлюч, "name") > 0 Тогда
				Если ТипЗнч(Элемент.Значение) = Тип("Строка") ИЛИ ТипЗнч(Элемент.Значение) = Тип("Число")
					ИЛИ ТипЗнч(Элемент.Значение) = Тип("Булево") Тогда
					СтрокиРезультата.Добавить(Отступ + Ключ + ": " + Строка(Элемент.Значение));
				КонецЕсли;
			КонецЕсли;
			СобратьПолномочия(Элемент.Значение, Отступ + "  ", СтрокиРезультата);
			Если СтрокиРезультата.Количество() >= 40 Тогда
				Возврат;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Данные) = Тип("Массив") Тогда
		Для Каждого ЭлементМассива Из Данные Цикл
			СобратьПолномочия(ЭлементМассива, Отступ, СтрокиРезультата);
			Если СтрокиРезультата.Количество() >= 40 Тогда
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Готовность СОБСТВЕННО ЗАПИСИ (без записи в базу) - собирается из того, что введено
// в полях формы прямо сейчас, а не из того, что записано. Проверяет то же самое, чем
// потом будет судить сама отправка (ЭДО_Сервер.НедостаткиУчетнойЗаписиЭДО), но на
// временной структуре - иначе пришлось бы записывать черновик, чтобы его проверить.
&НаСервере
Процедура ЗаполнитьГотовностьЗаписи()

	Черновик = ЭДО_Сервер.НоваяУчетнаяЗаписьЭДО();
	Черновик.Организация            = Организация;
	Черновик.Отпечаток              = Отпечаток;
	Черновик.ИдентификаторУчастника = ИдентификаторУчастника;
	Черновик.ТипПодписанта           = ТипПодписанта;
	Черновик.НомерМЧД                = НомерМЧД;
	Черновик.ДатаМЧД                 = ДатаМЧД;
	Черновик.ДолжностьПодписанта    = ДолжностьПодписанта;
	Черновик.Оператор                = Оператор;
	Черновик.ДатаНачалаОтправки      = ОтправлятьСДаты;
	Черновик.Хост                    = Хост;

	Претензии = ЭДО_Сервер.НедостаткиУчетнойЗаписиЭДО(Черновик);

	Если НЕ РазрешенаОтправка Тогда
		Претензии.Добавить("не поставлен флаг «Разрешена отправка» — документы организации"
			+ " по ЭДО не пойдут, даже если всё остальное готово");
	КонецЕсли;

	Свойство = ЭДО_Сервер.СвойствоОбъектов("ЭДО_РазрешенаОтправка");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Претензии.Добавить("свойство «ЭДО_РазрешенаОтправка» не заведено в базе — флаг"
			+ " «Разрешена отправка» при записи не сохранится");
	КонецЕсли;

	Если Претензии.Количество() = 0 Тогда
		ГотовностьЗаписи = "Готова.";
	Иначе
		ГотовностьЗаписи = "• " + СтрСоединить(Претензии, Символы.ПС + "• ");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
