////////////////////////////////////////////////////////////////////////////////
// Настройки ЭДО: флаги ЭДО контрагентов галочками (ЩА 15.10.2026 [yan], решение владельца).
// Форма только показывает и собирает изменения; чтение, проверка прав, запись и история -
// в ЭДО_НастройкиКонтрагентов. Без права менять форма открывается на просмотр.
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Перем ЗакрытиеПодтверждено;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	МесяцевОтгрузок = 3;
	МожноМенять = ЭДО_НастройкиКонтрагентов.МожноМенять();
	НастроитьДоступность();
	НастроитьУсловноеОформление();
	ЗаполнитьСписок();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗакрытиеПодтверждено = Истина ИЛИ НЕ ЕстьИзменения() Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	Если ЗавершениеРаботы Тогда
		ТекстПредупреждения = "Изменения настроек ЭДО не записаны.";
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект),
		"Изменения настроек ЭДО не записаны. Записать?", РежимДиалогаВопрос.ДаНетОтмена);

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Ответ, Параметр) Экспорт

	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Если НЕ ЗаписатьИзмененияНаКлиенте() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ЗакрытиеПодтверждено = Истина;
	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	Если ЕстьИзменения() Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ОбновитьЗавершение", ЭтотОбъект),
			"Изменения не записаны и пропадут при обновлении списка. Обновить?", РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	ЗаполнитьСписок();

КонецПроцедуры

&НаКлиенте
Процедура ФлагПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Контрагенты.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.Изменен = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПаузаПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Контрагенты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные.Изменен = Истина;
	Если НЕ ТекущиеДанные.Пауза Тогда
		ТекущиеДанные.ПричинаПаузы = "";
		Возврат;
	КонецЕсли;
	// Причину паузы увидит бухгалтерия в колонке «ЭДО», по ней же решают, когда снимать.
	Строки = Новый Массив;
	Строки.Добавить(Элементы.Контрагенты.ТекущаяСтрока);
	ЗапроситьПричинуПаузы(Строки);

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентыПриАктивизацииСтроки(Элемент)

	ОтключитьОбработчикОжидания("ПоказатьИсториюТекущего");
	ПодключитьОбработчикОжидания("ПоказатьИсториюТекущего", 0.3, Истина);

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	// Галочки переключаются по щелчку; карточку контрагента открывает двойной щелчок по прочим колонкам.
	Если Поле = Элементы.КонтрагентыКонтрагент ИЛИ Поле = Элементы.КонтрагентыИНН
		ИЛИ Поле = Элементы.КонтрагентыАдресЭДО ИЛИ Поле = Элементы.КонтрагентыПричинаПаузы Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьСостояниеЭДОВыполнить(Неопределено);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьВыполнить(Команда)

	ЗаписатьИзмененияНаКлиенте();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВыполнить(Команда)

	ОтборПриИзменении(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗавершение(Ответ, Параметр) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьСписок();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВыделенныеВыполнить(Команда)

	Если НЕ МожноМенять Тогда
		Возврат;
	КонецЕсли;
	Если Элементы.Контрагенты.ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выделите контрагентов в списке.");
		Возврат;
	КонецЕсли;
	Варианты = Новый СписокЗначений;
	Для Каждого ОписаниеФлага Из ОписаниеФлаговНаСервере() Цикл
		Варианты.Добавить(ОписаниеФлага.Колонка + "|1", ОписаниеФлага.Представление + ": включить");
		Варианты.Добавить(ОписаниеФлага.Колонка + "|0", ОписаниеФлага.Представление + ": выключить");
	КонецЦикла;
	Варианты.Добавить("Пауза|1", "Пауза: поставить");
	Варианты.Добавить("Пауза|0", "Пауза: снять");
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ИзменитьВыделенныеЗавершение", ЭтотОбъект), Варианты);

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВыделенныеЗавершение(Выбор, Параметр) Экспорт

	Если Выбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Части = СтрРазделить(Выбор.Значение, "|");
	Колонка = Части[0];
	Включить = (Части[1] = "1");
	Строки = Новый Массив;
	Для Каждого Идентификатор Из Элементы.Контрагенты.ВыделенныеСтроки Цикл
		СтрокаСписка = Контрагенты.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаСписка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаСписка[Колонка] <> Включить Тогда
			СтрокаСписка[Колонка] = Включить;
			СтрокаСписка.Изменен = Истина;
			Если Колонка = "Пауза" И НЕ Включить Тогда
				СтрокаСписка.ПричинаПаузы = "";
			КонецЕсли;
			Строки.Добавить(Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Если Колонка = "Пауза" И Включить И Строки.Количество() > 0 Тогда
		ЗапроситьПричинуПаузы(Строки);
		Возврат;
	КонецЕсли;
	ПоказатьОповещениеПользователя("Настройки ЭДО", , "Изменено строк: " + Строки.Количество()
		+ ". Не забудьте записать изменения.");

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСостояниеЭДОВыполнить(Команда)

	ТекущиеДанные = Элементы.Контрагенты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЭДО_Клиент.ОткрытьКарточкуКонтрагентаЭДО(ТекущиеДанные.Контрагент, ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗапроситьПричинуПаузы(Строки)

	ПоказатьВводСтроки(Новый ОписаниеОповещения("ЗапроситьПричинуПаузыЗавершение", ЭтотОбъект, Строки),
		"", "Причина паузы (ее увидит бухгалтерия)", 150, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьПричинуПаузыЗавершение(Причина, Строки) Экспорт

	// Без причины паузу не ставим: строки возвращаются в прежнее состояние.
	Для Каждого Идентификатор Из Строки Цикл
		СтрокаСписка = Контрагенты.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаСписка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Причина) Тогда
			СтрокаСписка.ПричинаПаузы = СокрЛП(Причина);
		Иначе
			СтрокаСписка.Пауза = Ложь;
			СтрокаСписка.ПричинаПаузы = "";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ЕстьИзменения()

	Возврат Контрагенты.НайтиСтроки(Новый Структура("Изменен", Истина)).Количество() > 0;

КонецФункции

&НаКлиенте
Функция ЗаписатьИзмененияНаКлиенте()

	Если НЕ ЕстьИзменения() Тогда
		ПоказатьОповещениеПользователя("Настройки ЭДО", , "Изменений нет.");
		Возврат Истина;
	КонецЕсли;
	Итог = ЗаписатьИзмененияНаСервере();
	Если Итог.Ошибки.Количество() > 0 Тогда
		ПоказатьПредупреждение(, "Записано изменений: " + Итог.Записано + "." + Символы.ПС
			+ "Не удалось:" + Символы.ПС + СтрСоединить(Итог.Ошибки, Символы.ПС));
		Возврат Ложь;
	КонецЕсли;
	ПоказатьОповещениеПользователя("Настройки ЭДО", , "Записано изменений: " + Итог.Записано);
	ПоказатьИсториюТекущего();
	Возврат Истина;

КонецФункции

&НаСервере
Функция ЗаписатьИзмененияНаСервере()

	// На сервер уходят только поля, которые пользователь поменял, и то, что он видел до правки:
	// сервер не перезапишет чужое изменение, сделанное после чтения списка.
	Изменения = Новый Массив;
	Для Каждого СтрокаСписка Из Контрагенты.НайтиСтроки(Новый Структура("Изменен", Истина)) Цикл
		Исходные = ЗначениеИзСтрокиВнутр(СтрокаСписка.Исходные);
		Было = Новый Структура;
		Стало = Новый Структура;
		Для Каждого Поле Из Исходные Цикл
			Если СтрокаСписка[Поле.Ключ] <> Поле.Значение Тогда
				Было.Вставить(Поле.Ключ, Поле.Значение);
				Стало.Вставить(Поле.Ключ, СтрокаСписка[Поле.Ключ]);
			КонецЕсли;
		КонецЦикла;
		Если Стало.Свойство("Пауза") Тогда
			Стало.Вставить("ПричинаПаузы", СтрокаСписка.ПричинаПаузы);
		КонецЕсли;
		Если Стало.Количество() > 0 Тогда
			Изменения.Добавить(Новый Структура("Контрагент, Было, Стало", СтрокаСписка.Контрагент, Было, Стало));
		КонецЕсли;
	КонецЦикла;
	Итог = ЭДО_НастройкиКонтрагентов.ЗаписатьИзменения(Изменения);

	// Незаписанные строки (конфликт, ошибка) сохраняют правку пользователя и то, что он видел до нее;
	// остальное перечитывается из базы - в строках то, что записалось.
	Незаписанные = Новый Массив;
	Для Каждого Контрагент Из Итог.НеЗаписаны Цикл
		Для Каждого СтрокаСписка Из Контрагенты.НайтиСтроки(Новый Структура("Контрагент", Контрагент)) Цикл
			Правка = Новый Структура("Контрагент, ИНН, АдресЭДО, АдресЗакреплен, Автоотправка, ПриемУПД, ПриемУКД,
				|СверкаУПД, Пауза, ПричинаПаузы, Исходные");
			ЗаполнитьЗначенияСвойств(Правка, СтрокаСписка);
			Незаписанные.Добавить(Правка);
		КонецЦикла;
	КонецЦикла;
	ЗаполнитьСписок();
	Для Каждого Правка Из Незаписанные Цикл
		Найденные = Контрагенты.НайтиСтроки(Новый Структура("Контрагент", Правка.Контрагент));
		СтрокаСписка = ?(Найденные.Количество() > 0, Найденные[0], Контрагенты.Вставить(0));
		ЗаполнитьЗначенияСвойств(СтрокаСписка, Правка);
		СтрокаСписка.Изменен = Истина;
	КонецЦикла;
	Возврат Итог;

КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеФлаговНаСервере()

	Возврат ЭДО_НастройкиКонтрагентов.ОписаниеФлагов();

КонецФункции

&НаСервере
Процедура ЗаполнитьСписок()

	ТекущийКонтрагент = Неопределено;
	Если Элементы.Контрагенты.ТекущаяСтрока <> Неопределено Тогда
		ТекущаяСтрокаСписка = Контрагенты.НайтиПоИдентификатору(Элементы.Контрагенты.ТекущаяСтрока);
		Если ТекущаяСтрокаСписка <> Неопределено Тогда
			ТекущийКонтрагент = ТекущаяСтрокаСписка.Контрагент;
		КонецЕсли;
	КонецЕсли;

	Контрагенты.Очистить();
	Список = ЭДО_НастройкиКонтрагентов.СписокКонтрагентов(Поиск, МесяцевОтгрузок, ТолькоСНастройками);
	Для Каждого Данные Из Список.Строки Цикл
		СтрокаСписка = Контрагенты.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСписка, Данные);
		// Что пользователь видел до правки: по этому сервер узнает чужое изменение при записи.
		СтрокаСписка.Исходные = ЗначениеВСтрокуВнутр(Новый Структура("Автоотправка, ПриемУПД, ПриемУКД, СверкаУПД, Пауза",
			Данные.Автоотправка, Данные.ПриемУПД, Данные.ПриемУКД, Данные.СверкаУПД, Данные.Пауза));
	КонецЦикла;

	Если ТекущийКонтрагент <> Неопределено Тогда
		Найденные = Контрагенты.НайтиСтроки(Новый Структура("Контрагент", ТекущийКонтрагент));
		Если Найденные.Количество() > 0 Тогда
			Элементы.Контрагенты.ТекущаяСтрока = Найденные[0].ПолучитьИдентификатор();
		КонецЕсли;
	КонецЕсли;
	Элементы.Контрагенты.Заголовок = "Контрагенты (" + Контрагенты.Количество()
		+ ?(Список.Обрезан, "+, уточните отбор", "") + ")";

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИсториюТекущего() Экспорт

	ТекущиеДанные = Элементы.Контрагенты.ТекущиеДанные;
	ЗаполнитьИсторию(?(ТекущиеДанные = Неопределено, Неопределено, ТекущиеДанные.Контрагент));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИсторию(Знач Контрагент)

	История.Очистить();
	Для Каждого Запись Из ЭДО_НастройкиКонтрагентов.ИсторияКонтрагента(Контрагент) Цикл
		ЗаполнитьЗначенияСвойств(История.Добавить(), Запись);
	КонецЦикла;
	Элементы.ГруппаИстория.Заголовок = "История изменений в этой базе" + ?(ЗначениеЗаполнено(Контрагент),
		": " + Строка(Контрагент), "");

КонецПроцедуры

// Без права менять - только просмотр: галочки недоступны, команды изменения скрыты.
&НаСервере
Процедура НастроитьДоступность()

	Элементы.НадписьТолькоПросмотр.Видимость = НЕ МожноМенять;
	Для Каждого ИмяЭлемента Из СтрРазделить("КонтрагентыАвтоотправка,КонтрагентыПриемУПД,КонтрагентыПриемУКД,"
		+ "КонтрагентыСверкаУПД,КонтрагентыПауза", ",") Цикл
		Элементы[ИмяЭлемента].ТолькоПросмотр = НЕ МожноМенять;
	КонецЦикла;
	// Свойство не заведено в базе - колонку не изменить, иначе запись строки отказала бы.
	Для Каждого Колонка Из ЭДО_НастройкиКонтрагентов.НезаведенныеФлаги() Цикл
		ЭлементКолонки = Элементы["Контрагенты" + Колонка];
		ЭлементКолонки.ТолькоПросмотр = Истина;
		ЭлементКолонки.Подсказка = "Свойство не заведено в базе: заведите свойства в настройках ЭДО.";
	КонецЦикла;
	Элементы.КнопкаЗаписать.Видимость = МожноМенять;
	Элементы.КнопкаИзменитьВыделенные.Видимость = МожноМенять;

КонецПроцедуры

// Измененные, но не записанные строки - светло-желтым фоном; контрагент на паузе - цветом особого текста.
&НаСервере
Процедура НастроитьУсловноеОформление()

	Элемент = УсловноеОформление.Элементы.Добавить();
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
