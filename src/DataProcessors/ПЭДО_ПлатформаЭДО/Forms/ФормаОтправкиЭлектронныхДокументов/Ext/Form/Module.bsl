			Отбор.Вставить(Колонка, ТаблицаНеформализованныхДляОтображения.НайтиПоИдентификатору(Строка)[Колонка]);
		КонецЦикла;
	
		СоответствующиеСтрокиОсновнойТаблицы = ТаблицаНеформализованных.НайтиСтроки(Отбор);
		
