Функция ЗагрузитьДокументыВСервисЭДО()
	
	ЗарегистрированыОшибкиЗагрузки = Ложь;
	
	Для Каждого ДокументВладелецПакета из ДокументыНаОтправку Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("ДокументВладелецПакета", ДокументВладелецПакета.Документ);
		
		ФормализованныеДокументыПакета			= ТаблицаФормализованных.НайтиСтроки(Отбор);
		НеформализованныеДокументыПакета		= ТаблицаНеформализованных.НайтиСтроки(Отбор);
		НеформализованныеИзФайлаДокументыПакета	= ТаблицаНеформализованныхИзФайлов.НайтиСтроки(Отбор);
				
		// Формализованные.	
		Для Каждого ФормализованныйДокумент из ФормализованныеДокументыПакета Цикл
			
			Если ЗначениеЗаполнено(ФормализованныйДокумент.ИдентификаторДокумента) Тогда
				Продолжить;
			КонецЕсли;
			
			ЗарегистрированаОшибкаЗагрузки = ЗагрузитьФормализованныйДокумент(ФормализованныйДокумент);
			Если ЗарегистрированаОшибкаЗагрузки = Истина Тогда
				ЗарегистрированыОшибкиЗагрузки = Истина;
				ФормализованныйДокумент.ЗафиксированаОшибка = Истина;
				ДокументВладелецПакета.ЗафиксированаОшибка = Истина;
			КонецЕсли;	
			
		КонецЦикла;
		
		// Неформализованные.		
		Для Каждого НеформализованныйДокумент из НеформализованныеДокументыПакета Цикл
			
			Если ЗначениеЗаполнено(НеформализованныйДокумент.ИдентификаторДокумента) Тогда
				Продолжить;
			КонецЕсли;
			
			ЗарегистрированаОшибкаЗагрузки = ЗагрузитьНеформализованныйДокумент(НеформализованныйДокумент, ДокументВладелецПакета, Ложь);	
			Если ЗарегистрированаОшибкаЗагрузки = Истина Тогда
				ЗарегистрированыОшибкиЗагрузки = Истина;
				НеформализованныйДокумент.ЗафиксированаОшибка = Истина;
				ДокументВладелецПакета.ЗафиксированаОшибка = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		// Неформализованные из файла.
		Для Каждого НеформализованныйДокументИзФайла из НеформализованныеИзФайлаДокументыПакета Цикл
			
			Если ЗначениеЗаполнено(НеформализованныйДокументИзФайла.ИдентификаторДокумента) Тогда
				Продолжить;
			КонецЕсли;
			
			ЗарегистрированаОшибкаЗагрузки = ЗагрузитьНеформализованныйДокумент(НеформализованныйДокументИзФайла, ДокументВладелецПакета, Истина);	
			Если ЗарегистрированаОшибкаЗагрузки = Истина Тогда
				ЗарегистрированыОшибкиЗагрузки = Истина;
				НеформализованныйДокументИзФайла.ЗафиксированаОшибка = Истина;
				ДокументВладелецПакета.ЗафиксированаОшибка = Истина;
			КонецЕсли;
			
		КонецЦикла;	
		
	КонецЦикла;
	
	Возврат ЗарегистрированыОшибкиЗагрузки;
	
КонецФункции

