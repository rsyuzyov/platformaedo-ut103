&НаКлиенте
Процедура ДополнитьСписокПодборомДокументов(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ОбработкаВыбораТипаДанных", ЭтотОбъект);
		
	СписокТипов.ПоказатьВыборЭлемента(Оповещение, "Выбор типа данных");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораТипаДанных(ВыбранныйЭлемент, СписокПараметров) Экспорт
	
	Если ВыбранныйЭлемент <> Неопределено Тогда
				
		ИмяОткрываемойФормы = "Документ."+ПолучитьИмяОбъектаМетаданных(ВыбранныйЭлемент.Значение)+".ФормаВыбора";
		
		ПараметрыПодбора = Новый Структура;    
    	ПараметрыПодбора.Вставить("ЗакрыватьПриВыборе", Истина);
    	ПараметрыПодбора.Вставить("МножественныйВыбор", Истина);
		
		Если ПроверитьНаличиеРеквизитаОбъекта(ВыбранныйЭлемент.Значение, "Контрагент") Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Контрагент", Элементы.ТаблицаДокументыНаОтправку.ТекущиеДанные.Получатель);
			ПараметрыПодбора.Вставить("Отбор", ПараметрыОтбора);
		КонецЕсли;
		
		Оповещение = Новый ОписаниеОповещения("ОписаниеЗакрытияФормыВыбораНеформализованных", ЭтотОбъект);				
		ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыПодбора, ЭтаФорма, , , , Оповещение);
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеЗакрытияФормыВыбораНеформализованных(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатЗакрытия = Неопределено Тогда
		
		Для Каждого ОбъектДляПФ из РезультатЗакрытия Цикл
			СписокОбъектовДляВыбораПФ.Добавить(ОбъектДляПФ);
		КонецЦикла;	
		
		ПараметрыОткрытияФормы = Новый Структура();
		ПараметрыОткрытияФормы.Вставить("ЭкземплярДокумента", РезультатЗакрытия[0]);
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОписаниеЗакрытияФормыВыбораПФ", ЭтаФорма);
		ОткрытьФорму(ИмяОбработки + ".Форма.ФормаВыбораПФДляНеформалки", ПараметрыОткрытияФормы, ЭтаФорма, , , , ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеЗакрытияФормыВыбораПФ(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
		
	Если НЕ РезультатЗакрытия = Неопределено Тогда
		
		Для Каждого ОбъектПФ из СписокОбъектовДляВыбораПФ Цикл
			
			ДокументИсточникПечати	= ОбъектПФ.Значение;
			ПолучательПоДокументу	= Элементы.ТаблицаДокументыНаОтправку.ТекущиеДанные.Получатель;
			ИдентификаторПолучателя	= Элементы.ТаблицаДокументыНаОтправку.ТекущиеДанные.ИдентификаторПолучателя;
			
			Для Каждого ПФ из РезультатЗакрытия Цикл
				
				Если ЗначениеЗаполнено(ПФ.Идентификатор) И ЗначениеЗаполнено(ПФ.МенеджерПечати) Тогда
					
					НоваяСтрока = ТаблицаНеформализованных.Добавить();
					
					НоваяСтрока.ДокументВладелецПакета		= Элементы.ТаблицаДокументыНаОтправку.ТекущиеДанные.Документ;
					НоваяСтрока.Документ					= ДокументИсточникПечати;
					НоваяСтрока.ПредставлениеПечатнойФормы	= ПФ.Представление;
					НоваяСтрока.ФорматФайла					= ПФ.ФорматФайла;
					НоваяСтрока.ИмяМенеджераПечати			= ПФ.МенеджерПечати;
					НоваяСтрока.ИмяМакета					= ПФ.Идентификатор;
					НоваяСтрока.ДополнительныеПараметры		= ПФ.ДополнительныеПараметры;
					НоваяСтрока.ВидДокумента				= "Неформализованный";
					
				КонецЕсли;
				
			КонецЦикла;	
			
		КонецЦикла;	
			
	КонецЕсли;
	
	СписокОбъектовДляВыбораПФ.Очистить();
	
	ОтобразитьДокументыВыбранногоВладельца();
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ТаблицаНеформализованныхПередУдалением(Элемент, Отказ)
		
	УдаляемыйДокумент = Элемент.ТекущиеДанные;
	
