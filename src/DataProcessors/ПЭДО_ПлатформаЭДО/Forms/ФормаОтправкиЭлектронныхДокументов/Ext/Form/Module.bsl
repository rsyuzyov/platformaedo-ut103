Функция СформироватьФайлыПодписейДокументов()
	
	ЗарегистрированыОшибкиФормирования = Ложь;
	
	Для Каждого ДокументВладелецПакета из ДокументыНаОтправку Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("ДокументВладелецПакета", ДокументВладелецПакета.Документ);
		
		ФормализованныеДокументыПакета			= ТаблицаФормализованных.НайтиСтроки(Отбор);
		НеформализованныеДокументыПакета		= ТаблицаНеформализованных.НайтиСтроки(Отбор);
		НеформализованныеИзФайлаДокументыПакета	= ТаблицаНеформализованныхИзФайлов.НайтиСтроки(Отбор);
		
		Менеджер			= ПолучитьМенеджерКриптографии();
		ЭЦП					= ПолучитьЭЦППоОтпечатку(Менеджер, Base64Значение(ОтпечатокСертификатаBase64));
		ПарольСертификата	= ПарольДоступаКЗакрытомуКлючу;
		
		// Формализованные.	
		Для Каждого ФормализованныйДокумент из ФормализованныеДокументыПакета Цикл
			
			Если ЗначениеЗаполнено(ФормализованныйДокумент.ПолноеИмяФайлаПодписи) Тогда
				Продолжить;
			КонецЕсли;	
			
			СтруктураОписанияДокумента = ФормализованныйДокумент.СтруктураОписанияДокумента;		
			
			Если ПодписантСоответсвуетЭЦП(СтруктураОписанияДокумента.Подписант, ЭЦП) Тогда				
				ИмяФайлаПодписи = ПодписатьДокумент(СтруктураОписанияДокумента.ИмяФайла, ФормализованныйДокумент.ПолноеИмяФайла, Менеджер, ЭЦП, ПарольСертификата, ".signature.p7b");
				Если НЕ ЗначениеЗаполнено(ИмяФайлаПодписи) Тогда
					Сообщить("Не удалось сформировать файл подписи для формализованного эл. документа формата """+ФормализованныйДокумент.ПредставлениеФормата+""" по документу "+ФормализованныйДокумент.Документ+".");
					ЗарегистрированыОшибкиФормирования = Истина;
					ФормализованныйДокумент.ЗафиксированаОшибка = Истина;
					ДокументВладелецПакета.ЗафиксированаОшибка = Истина;
					Продолжить;	
				КонецЕсли;	
			Иначе
				Сообщить("Подписант не соответствует используемой ЭЦП.");
				ЗарегистрированыОшибкиФормирования = Истина;
				ФормализованныйДокумент.ЗафиксированаОшибка = Истина;
				ДокументВладелецПакета.ЗафиксированаОшибка = Истина;
				Продолжить;
			КонецЕсли;
			
			ФормализованныйДокумент.ПолноеИмяФайлаПодписи = ИмяФайлаПодписи;
			
		КонецЦикла;
		
		// Неформализованные.		
		Для Каждого НеформализованныйДокумент из НеформализованныеДокументыПакета Цикл
			
			Если ЗначениеЗаполнено(НеформализованныйДокумент.ПолноеИмяФайлаПодписи) Тогда
				Продолжить;
			КонецЕсли;
			
			Файл = Новый Файл(НеформализованныйДокумент.ПолноеИмяФайла);
			ИмяФайла = Файл.Имя;
			ИмяФайлаПодписи = ПодписатьДокумент(ИмяФайла, НеформализованныйДокумент.ПолноеИмяФайла, Менеджер, ЭЦП, ПарольСертификата, ".signature.p7b");
			Если НЕ ЗначениеЗаполнено(ИмяФайлаПодписи) Тогда
				Сообщить("Не удалось сформировать файл подписи для неформализованного эл. документа по документу "+НеформализованныйДокумент.Документ+
						+Символы.ПС+"при помощи печатной формы """+НеформализованныйДокумент.ПредставлениеПечатнойФормы+""".");
				ЗарегистрированыОшибкиФормирования = Истина;
				НеформализованныйДокумент.ЗафиксированаОшибка = Истина;
				ДокументВладелецПакета.ЗафиксированаОшибка = Истина;
				Продолжить;	
			КонецЕсли;
			
			НеформализованныйДокумент.ПолноеИмяФайлаПодписи = ИмяФайлаПодписи;
			
		КонецЦикла;
		
		// Неформализованные из файла.
		Для Каждого НеформализованныйДокументИзФайла из НеформализованныеИзФайлаДокументыПакета Цикл
			
			Если ЗначениеЗаполнено(НеформализованныйДокументИзФайла.ПолноеИмяФайлаПодписи) Тогда
				Продолжить;
			КонецЕсли;
			
			Файл = Новый Файл(НеформализованныйДокументИзФайла.ПолноеИмяФайла);
			ИмяФайла = Файл.Имя;
			ИмяФайлаПодписи = ПодписатьДокумент(ИмяФайла, НеформализованныйДокументИзФайла.ПолноеИмяФайла, Менеджер, ЭЦП, ПарольСертификата, ".signature.p7b");
			Если НЕ ЗначениеЗаполнено(ИмяФайлаПодписи) Тогда
				Сообщить("Не удалось сформировать файл подписи для неформализованного эл. документа по документу"
							+Символы.ПС+"из файла по адресу """+НеформализованныйДокументИзФайла.ПутьКФайлу+""".");
				ЗарегистрированыОшибкиФормирования = Истина;
				НеформализованныйДокументИзФайла.ЗафиксированаОшибка = Истина;
				ДокументВладелецПакета.ЗафиксированаОшибка = Истина;
				Продолжить;	
			КонецЕсли;
			
			НеформализованныйДокументИзФайла.ПолноеИмяФайлаПодписи = ИмяФайлаПодписи;
			
		КонецЦикла;	
		
	КонецЦикла;
	
	Возврат ЗарегистрированыОшибкиФормирования;
	
КонецФункции

