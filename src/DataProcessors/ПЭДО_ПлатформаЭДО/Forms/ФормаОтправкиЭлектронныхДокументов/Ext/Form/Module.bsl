	СоответствиеТиповMIME.Вставить("xpm", "image/x-xpixmap");
	СоответствиеТиповMIME.Вставить("xsl", "text/x-xslt");
	СоответствиеТиповMIME.Вставить("xslfo", "text/x-xslfo");
	СоответствиеТиповMIME.Вставить("xslt", "text/x-xslt");
	СоответствиеТиповMIME.Вставить("xwd", "image/x-xwindowdump");
	СоответствиеТиповMIME.Вставить("z", "application/x-compress");
	СоответствиеТиповMIME.Вставить("zabw", "application/x-abiword");
	СоответствиеТиповMIME.Вставить("zip", "application/zip");
	СоответствиеТиповMIME.Вставить("zoo", "application/x-zoo");
	
	Возврат СоответствиеТиповMIME;
	
КонецФункции

#Область РаботаСШаблонамиПакетов

Функция ПолучитьСписокВыбораШаблонов(Контрагент = Неопределено)
	
	Элементы.ВыбранныйШаблон.СписокВыбора.Очистить();
	ШаблоныПоОрганизацииИПолучателю = Новый Массив;
	
	ВсеШаблоны = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки",
	"СписокШаблоновПакетов",
	"Содержит список шаблонов пакетов ЭД",
	ПолучитьТекущегоПользователя()); 
	
	Если НЕ ВсеШаблоны = Неопределено тогда
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("Организация", ЭтотОбъект.Организация); 
		
		Если ЗначениеЗаполнено(Контрагент) тогда
			СтруктураПоиска.Вставить("Контрагент", Контрагент);
		КонецЕсли; 
		
		НайденныеСтроки = ВсеШаблоны.НайтиСтроки(СтруктураПоиска);
		
		Для каждого Строка из НайденныеСтроки цикл
			
			СтруктураСтроки = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Строка);
			ШаблоныПоОрганизацииИПолучателю.Добавить(СтруктураСтроки)
			
		КонецЦикла  
		
	КонецЕсли;
	
	Возврат ШаблоныПоОрганизацииИПолучателю; 
	
КонецФункции

Процедура ЗаполнитьСпискиДокументовПоШаблону(ДокВладелецПакета)
	
	ТаблицаНеформализованных.Очистить();
	
	ТекущийШаблон = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки",
	ЭтотОбъект.ВыбранныйШаблон,
	"Содержит шаблоны пакетов ЭД",
	ПолучитьТекущегоПользователя());
	
	
	НастройкиПоиска = ТекущийШаблон.ТаблицаНастроекПоиска;
	
	Массив = Новый Массив;
	Массив.Добавить(Тип("Булево"));
	ОписаниеТипов = Новый ОписаниеТипов(Массив);
	НастройкиПоиска.Колонки.Добавить("ОбработкаЗавершена", ОписаниеТипов);
	
	МассивСвязанныхДокументов = КритерииОтбора.СвязанныеДокументы.Найти(ДокВладелецПакета);
    МассивДокументовКДобавлению = Новый Массив;
	
	Для каждого Строка из НастройкиПоиска цикл
		
		//Проверяем применимость к документу-основанию
		
		Если НЕ ТипЗнч(ДокВладелецПакета) = Тип(Строка.ТипДокумента) тогда
			
			Продолжить
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Строка.ОбработкаЗавершена) И Строка.ОбработкаЗавершена = Истина тогда
			
			Продолжить 
			
		КонецЕсли;
		
		//Ищем связанные объекты	 
		
		Для каждого Док из МассивСвязанныхДокументов цикл
			
			Если ТипЗнч(Док) = Тип(Строка.ТипСвязанногоДокумента) тогда 
				
				СтруктураДокумента = Новый Структура;
				ДоступныеКомандыПечати = ПолучитьКомандыПечатиПоОбъекту(Док.Метаданные());
				
				ОтборСтрокКомандПФ = Новый Структура;
				ОтборСтрокКомандПФ.Вставить("УникальныйИдентификатор", Строка.ПечатнаяФорма);
				//ОтборСтрокКомандПФ.Вставить("УникальныйИдентификатор", Строка.УникальныйИдентификаторПФ);
				
				ДанныеПФ = ДоступныеКомандыПечати.НайтиСтроки(ОтборСтрокКомандПФ);
				
				Если НЕ ДанныеПФ.Количество() > 1 тогда
					ДанныеПФ = ДанныеПФ[0];
				Иначе
					ОбщегоНазначения.СообщитьПользователю("Ошибка поиска печатной формы. Проверьте настройки шаблона");
					Возврат
				КонецЕсли;
				
				СтруктураДокумента.Вставить("Документ", Док);
				СтруктураДокумента.Вставить("ФорматФайла", Строка.ФорматФайла);
				СтруктураДокумента.Вставить("ИмяМенеджераПечати", ДанныеПФ.МенеджерПечати);
				СтруктураДокумента.Вставить("ИмяМакета", ДанныеПФ.Идентификатор);
				СтруктураДокумента.Вставить("ПредставлениеПечатнойФормы", ДанныеПФ.Представление);
				СтруктураДокумента.Вставить("ДополнительныеПараметры", ДанныеПФ.ДополнительныеПараметры);
				СтруктураДокумента.Вставить("Номер", Док.Номер);
				СтруктураДокумента.Вставить("Дата",  Док.Дата); 
				
				Если ЗначениеЗаполнено(Строка.ВидНеформализованного) тогда
					СтруктураДокумента.Вставить("ВидДокумента", Строка.ВидНеформализованного);
				Иначе
					СтруктураДокумента.Вставить("ВидДокумента", "Неформализованный");
				КонецЕсли; 
			
				СтруктураДокумента.Вставить("ДокументВладелецПакета", ДокВладелецПакета);
				СтруктураДокумента.Вставить("ЗафиксированаОшибка", Ложь);
				
				МассивДокументовКДобавлению.Добавить(СтруктураДокумента); 
				
			КонецЕсли 
			
		КонецЦикла;	
		
		Строка.ОбработкаЗавершена = Истина;
		
	КонецЦикла;
	
	//Заполняем ссылки на связанные объекты, заполняем печатные формы
	Для каждого СтруктураДокумента из МассивДокументовКДобавлению цикл
		
		ДублиСтрок = ТаблицаНеформализованных.НайтиСтроки(СтруктураДокумента);
		
		Если ДублиСтрок.Количество() = 0 тогда
			НСтр = ТаблицаНеформализованных.Добавить();
			ЗаполнитьЗначенияСвойств(НСтр, СтруктураДокумента);
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКомандыПечатиПоОбъекту(Метаданные) Экспорт

	мДанные = Новый Массив;	
	мДанные.Добавить(Метаданные);
	
	НайденныеКомандыПечати = УправлениеПечатью.КомандыПечатиФормы("ФормаЭлемента", мДанные);
	
	Возврат НайденныеКомандыПечати;

КонецФункции

#КонецОбласти

&НаСервере
Процедура ОпределитьИспользованиеТестовогоКонтура()

	Объект.ЭтоТестоваяОбработка = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", 	// Ключ объекта
				"ЭтоТестовыйКонтур",																// Ключ настройки 
				"Служебный параметр, определяющий соединение с тестовым контуром", 					// описание настройки
				ПолучитьТекущегоПользователя());
				
				
	Если Объект.ЭтоТестоваяОбработка = Неопределено тогда
		
		Объект.ЭтоТестоваяОбработка = Ложь;
		
	КонецЕсли; 
		
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыВыгрузки

&НаКлиенте
Процедура ОтправитьПакеты(Команда)
	
	ПроверитьИУдалитьПустыеПакеты();
	
	ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
	ПараметрыЗапроса.Параметры.Вставить("<gid>", ИдентификаторОрганизации);
	
	ИнформацияОбОтправителе = ВыполнитьЗапросAPI("API_ИнформацияОбАбоненте", ПараметрыЗапроса);
			
	Если ИнформацияОбОтправителе.Ошибка Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось получить информацию по отправителю "+Организация+" с идентификатором "+ИдентификаторОрганизации+".";
		Сообщение.Сообщить();
		Элементы.КнопкаОтправить.Доступность = Ложь;
		Возврат;				
	КонецЕсли;
	
	// Создаем документы.		
	ЗарегистрированыОшибкиФормирования = СформироватьДокументы(); 
	
	Если ЗарегистрированыОшибкиФормирования = Истина Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Символы.ПС+"Отправка не была произведена."
				+Символы.ПС+"Устраните причины ошибок, либо удалите проблемные строки.";
		Сообщение.Сообщить();
		ОтобразитьДокументыВыбранногоВладельца();
		ЗафиксироватьСтатусыФормализованныхДокументов();
		Возврат;
	КонецЕсли;
	
	// Формируем файлы подписей.
	ЗарегистрированыОшибкиФормированияПодписей = СформироватьФайлыПодписейДокументов(); 
	
	Если ЗарегистрированыОшибкиФормированияПодписей = Истина Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Символы.ПС+"Зафиксированы ошибки создания подписи для документов. Отправка не была произведена.";
		Сообщение.Сообщить();
		ОтобразитьДокументыВыбранногоВладельца();
		ЗафиксироватьСтатусыФормализованныхДокументов();
		Возврат;
	КонецЕсли;
	
	// Создаем электронные документы в сервисе ЭДО, загружаем контент без подписания.
	ЗарегистрированыОшибкиЗагрузкиДокументовВСервисЭДО = ЗагрузитьДокументыВСервисЭДО(); 
	
	Если ЗарегистрированыОшибкиЗагрузкиДокументовВСервисЭДО = Истина Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Символы.ПС+"Зафиксированы ошибки загрузки документов в сервис ЭДО. Отправка не была произведена.";
		Сообщение.Сообщить();
		ОтобразитьДокументыВыбранногоВладельца();
		ЗафиксироватьСтатусыФормализованныхДокументов();
		Возврат;
	КонецЕсли;
	
	Для Каждого ДокументВладелецПакета из ДокументыНаОтправку Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("ДокументВладелецПакета", ДокументВладелецПакета.Документ);
	
		ФормализованныеДокументыПакета			= ТаблицаФормализованных.НайтиСтроки(Отбор);
		НеформализованныеДокументыПакета		= ТаблицаНеформализованных.НайтиСтроки(Отбор);
		НеформализованныеИзФайлаДокументыПакета	= ТаблицаНеформализованныхИзФайлов.НайтиСтроки(Отбор);
		
		Если ФормализованныеДокументыПакета.Количество() = 0 И НеформализованныеДокументыПакета.Количество() = 0 И НеформализованныеИзФайлаДокументыПакета.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДокументВладелецПакета.УспешноОтправлен = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДокументВладелецПакета.ЗафиксированаОшибка = Ложь Тогда 
			
			ИдентификаторОтправителя = Формат(ИнформацияОбОтправителе.Результат[0].id, "ЧГ=0");
			
			// Оформляем пакет
			Если НЕ ЗначениеЗаполнено(ДокументВладелецПакета.ИдентификаторПакета) Тогда
			
				ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
				ПараметрыЗапроса.Параметры.Вставить("<subscriber-id>", ИдентификаторОтправителя);
				РезультатСозданияПакета = ВыполнитьЗапросAPI("API_СоздатьПакет", ПараметрыЗапроса);
				
				Если РезультатСозданияПакета.Ошибка = Истина Тогда
					ДокументВладелецПакета.ЗафиксированаОшибка = Истина;
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Не удалось сформировать пакет по документу "+ДокументВладелецПакета.Документ+"."
							+Символы.ПС+"Описание ошибки:"+Символы.ПС+РезультатСозданияПакета.Описание;
					Сообщение.Сообщить();
					ОтобразитьДокументыВыбранногоВладельца();
					ЗафиксироватьСтатусыФормализованныхДокументов();
					Продолжить;	
				КонецЕсли;
					
				ИдентификаторПакета = Формат(РезультатСозданияПакета.Результат.id, "ЧГ=0");
				ДокументВладелецПакета.ИдентификаторПакета = ИдентификаторПакета;
				
			Иначе
				
				ИдентификаторПакета = ДокументВладелецПакета.ИдентификаторПакета;
				
			КонецЕсли;
			
			// Создаем сообщение в пакете.
			Если НЕ ЗначениеЗаполнено(ДокументВладелецПакета.ИдентификаторСообщения) Тогда
				
				ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
				ПараметрыЗапроса.Параметры.Вставить("<subscriber-id>", ИдентификаторОтправителя);
				ПараметрыЗапроса.Параметры.Вставить("<bundle-id>", ИдентификаторПакета);
				РезультатСозданияСообщения = ВыполнитьЗапросAPI("API_СоздатьСообщениеВПакете", ПараметрыЗапроса);
				
				Если РезультатСозданияСообщения.Ошибка = Истина Тогда
					ДокументВладелецПакета.ЗафиксированаОшибка = Истина;
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Не удалось сформировать сообщение для пакета по документу "+ДокументВладелецПакета.Документ+"."
							+Символы.ПС+"Идентификатор пакета: "+ИдентификаторПакета+"."
							+Символы.ПС+"Описание ошибки:"+Символы.ПС+РезультатСозданияПакета.Описание;
					Сообщение.Сообщить();
					ОтобразитьДокументыВыбранногоВладельца();
					ЗафиксироватьСтатусыФормализованныхДокументов();
					Продолжить;	
				КонецЕсли;
				
				ИдентификаторСообщения = Формат(РезультатСозданияСообщения.Результат.id, "ЧГ=0");
				ДокументВладелецПакета.ИдентификаторСообщения = ИдентификаторСообщения;
				
			Иначе
				
				ИдентификаторСообщения = ДокументВладелецПакета.ИдентификаторСообщения;
			
			КонецЕсли;
			
			// Помещаем документы в сообщение.
			ЗарегистрированыОшибкиПомещенияДокументовВСообщениеПакета = ПоместитьДокументыВСообщение(ДокументВладелецПакета);
			
			Если ЗарегистрированыОшибкиПомещенияДокументовВСообщениеПакета = Истина Тогда
				ДокументВладелецПакета.ЗафиксированаОшибка = Истина;
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = Символы.ПС+"Зафиксированы ошибки помещения документов в сообщение пакета ЭДО. Отправка не была произведена.";
				Сообщение.Сообщить();
				ОтобразитьДокументыВыбранногоВладельца();
				ЗафиксироватьСтатусыФормализованныхДокументов();
				Возврат;
			КонецЕсли;
				
		КонецЕсли;	
			
	КонецЦикла;
	
	ПроверитьНаличиеОшибокВРанееОшибочныхПакетах();
	
	// Подписание документов.
	// Только при отсутствии ошибок.
	Отбор = Новый Структура;
	Отбор.Вставить("ЗафиксированаОшибка", Истина);
	
	ОшибкиОтправкиПакетов = ДокументыНаОтправку.НайтиСтроки(Отбор);
	
	Если ОшибкиОтправкиПакетов.Количество() = 0 Тогда
		
		Для Каждого ДокументВладелецПакета из ДокументыНаОтправку Цикл
			
			Если ДокументВладелецПакета.УспешноОтправлен = Истина Тогда
				Продолжить;
			КонецЕсли;	
			
			ЗафиксированыОшибкиПомещенияПодписейВСервисЭДО = ПодписатьДокументыСообщенияПакета(ДокументВладелецПакета);
			
			Если ЗафиксированыОшибкиПомещенияПодписейВСервисЭДО = Истина Тогда
				ДокументВладелецПакета.ЗафиксированаОшибка = Истина;
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = Символы.ПС+"Зафиксированы ошибки подписания документов в сообщении пакета ЭДО. Отправка не была завершена.";
				Сообщение.Сообщить();
				ОтобразитьДокументыВыбранногоВладельца();
				ЗафиксироватьСтатусыФормализованныхДокументов();
				Возврат;
			Иначе
				ДокументВладелецПакета.УспешноОтправлен = Истина;
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = Символы.ПС+"Пакет "+ДокументВладелецПакета.ИдентификаторПакета+" по документу """+ДокументВладелецПакета.Документ+""" был успешно сформирован и отправлен.";
				Сообщение.Сообщить();
			КонецЕсли;	
			
		КонецЦикла;
		
		// После подписания последнего документа из пакета, пакет отправляется автоматически.
		
	Иначе	
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Символы.ПС+"Для завершения отправки документов необходимо устранить причины ошибок или убрать проблемные документы из списка.";
		Сообщение.Сообщить();
		
	КонецЕсли;
	
	ОтобразитьДокументыВыбранногоВладельца();
	ЗафиксироватьСтатусыФормализованныхДокументов();
	
КонецПроцедуры

&НаКлиенте
Функция СформироватьДокументы()
	
	ЗарегистрированыОшибкиФормирования = Ложь;
	
	Для Каждого ДокументВладелецПакета из ДокументыНаОтправку Цикл	
		
		Если ЗначениеЗаполнено(ДокументВладелецПакета.ИдентификаторПолучателя) Тогда 
			
			Отбор = Новый Структура;
			Отбор.Вставить("ДокументВладелецПакета", ДокументВладелецПакета.Документ);
			
			ФормализованныеДокументыПакета			= ТаблицаФормализованных.НайтиСтроки(Отбор);
			НеформализованныеДокументыПакета		= ТаблицаНеформализованных.НайтиСтроки(Отбор);
			НеформализованныеИзФайлаДокументыПакета	= ТаблицаНеформализованныхИзФайлов.НайтиСтроки(Отбор);
			
			// Формализованные.	
			Для Каждого ФормализованныйДокумент из ФормализованныеДокументыПакета Цикл
				
				Если ЗначениеЗаполнено(ФормализованныйДокумент.ПолноеИмяФайла) Тогда
					Продолжить;
				КонецЕсли;	
				
				ОписаниеСформированногоФормализованногоДокумента = СформироватьФормализованыйДокумент(ДокументВладелецПакета.Документ, ФормализованныйДокумент.Документ, ФормализованныйДокумент.Формат, ФормализованныйДокумент.ФункцияУПД);
				
				Если ОписаниеСформированногоФормализованногоДокумента = Неопределено Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Не удалось сформировать формализованный эл. документ формата """+ФормализованныйДокумент.ПредставлениеФормата+""" по документу "+ФормализованныйДокумент.Документ+".";
					Сообщение.Сообщить();
					ЗарегистрированыОшибкиФормирования = Истина;
					ФормализованныйДокумент.ЗафиксированаОшибка = Истина;
					ДокументВладелецПакета.ЗафиксированаОшибка = Истина;
					Продолжить;
				КонецЕсли; 
				
				Если ОписаниеСформированногоФормализованногоДокумента.ОшибкиФормирования = Истина Тогда
					ФормализованныйДокумент.ЗафиксированаОшибка = Истина;
					ДокументВладелецПакета.ЗафиксированаОшибка = Истина;
					Продолжить;
				КонецЕсли;	
				
				ФормализованныйДокумент.СтруктураОписанияДокумента = ОписаниеСформированногоФормализованногоДокумента;
				
				Файл = Новый ТекстовыйДокумент();                           
				Файл.ДобавитьСтроку(ОписаниеСформированногоФормализованногоДокумента.Выгрузка);
				Попытка	
					Каталог 			= КаталогВременныхФайлов();
					ПолноеИмяФайла 		= Каталог + ОписаниеСформированногоФормализованногоДокумента.ИмяФайла +".xml";
					Файл.Записать(ПолноеИмяФайла, "windows-1251");
					ФормализованныйДокумент.ПолноеИмяФайла = ПолноеИмяФайла;
				Исключение
					ФормализованныйДокумент.СтруктураОписанияДокумента.СтатусЭДО = 24;
					Сообщить("Ошибка записи сформированного формализованного документа "+ФормализованныйДокумент.Документ+" в формате "+ФормализованныйДокумент.Формат+" в файл.");
					ЗарегистрированыОшибкиФормирования = Истина;
					ФормализованныйДокумент.ЗафиксированаОшибка = Истина;
					ДокументВладелецПакета.ЗафиксированаОшибка = Истина;
					Продолжить;
				КонецПопытки;
				
			КонецЦикла;
			
			// Неформализованные.		
			Для Каждого НеформализованныйДокумент из НеформализованныеДокументыПакета Цикл
				
				Если ЗначениеЗаполнено(НеформализованныйДокумент.ПолноеИмяФайла) Тогда
					Продолжить;
				КонецЕсли;
				
				ПутьКФайлуДокумента = СформироватьНеформализованныйДокумент(НеформализованныйДокумент);
				Если ПутьКФайлуДокумента = Неопределено Тогда
					НеформализованныйДокумент.ЗафиксированаОшибка = Истина;
					ДокументВладелецПакета.ЗафиксированаОшибка = Истина;
					ЗарегистрированыОшибкиФормирования = Истина;
					Продолжить;
				КонецЕсли;	
				НеформализованныйДокумент.ПолноеИмяФайла = ПутьКФайлуДокумента;
				
			КонецЦикла;
			
			// Неформализованные из файла.
			Для Каждого НеформализованныйДокументИзФайла из НеформализованныеИзФайлаДокументыПакета Цикл
				
				Если ЗначениеЗаполнено(НеформализованныйДокументИзФайла.ПолноеИмяФайла) Тогда
					Продолжить;
				КонецЕсли;
				
				Файл = Новый Файл(НеформализованныйДокументИзФайла.ПутьКФайлу);
				ФайлСуществует = Файл.Существует();
				
				Если НЕ ФайлСуществует Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = Сообщение.Текст = "Не обнаружен файл """+НеформализованныйДокументИзФайла.ПутьКФайлу+""","+Символы.ПС+"добавленный к документу "+ДокументВладелецПакета.Документ+".";
					Сообщение.Сообщить();
					НеформализованныйДокументИзФайла.ЗафиксированаОшибка = Истина;
					ДокументВладелецПакета.ЗафиксированаОшибка = Истина;
					ЗарегистрированыОшибкиФормирования = Истина;
					Продолжить;
				КонецЕсли;	
				НеформализованныйДокументИзФайла.ПолноеИмяФайла = НеформализованныйДокументИзФайла.ПутьКФайлу;
				
			КонецЦикла;	
			
		Иначе
		
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Пакет по документу "+ДокументВладелецПакета.Документ+" не может быть сформирован, поскольку для получателя "+ДокументВладелецПакета.Получатель+" не определен идентификатор абонента.";
			Сообщение.Сообщить();
			ЗарегистрированыОшибкиФормирования = Истина;
			Продолжить;
		
		КонецЕсли;	
			
	КонецЦикла;
	
	Возврат ЗарегистрированыОшибкиФормирования;
	
КонецФункции	

