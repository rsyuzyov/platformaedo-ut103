 
#Область СобытияФормы
	  
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ИмяОбработки") Тогда
		ИмяОбработки = Параметры.ИмяОбработки;
	КонецЕсли;
	
	Если Параметры.Свойство("АдресВременногоХранилищаКэш") Тогда
		АдресВременногоХранилищаКэш = Параметры.АдресВременногоХранилищаКэш;
	КонецЕсли;
	
	Если Параметры.Свойство("ПредставлениеТекущейКонфигурации") Тогда
		ПредставлениеТекущейКонфигурации = Параметры.ПредставлениеТекущейКонфигурации;
	КонецЕсли;
	
	Если Параметры.Свойство("AccessToken") Тогда
		AccessToken = Параметры.AccessToken;
	КонецЕсли;
	
	Если Параметры.Свойство("RefreshToken") Тогда
		RefreshToken = Параметры.RefreshToken;
	КонецЕсли;
	
	Если Параметры.Свойство("ИспользоватьПодписание") Тогда
		ИспользоватьПодписание = Параметры.ИспользоватьПодписание;
	КонецЕсли;
	
	Если Параметры.Свойство("ВерсияНастроекОбработки") Тогда
		ВерсияНастроекОбработки = Параметры.ВерсияНастроекОбработки;
	КонецЕсли;
	
	Если Параметры.Свойство("ОтпечатокСертификатаBase64") Тогда
		ОтпечатокСертификатаBase64 = Параметры.ОтпечатокСертификатаBase64;
	КонецЕсли;
	
	Если Параметры.Свойство("ПарольДоступаКЗакрытомуКлючу") Тогда
		ПарольДоступаКЗакрытомуКлючу = Параметры.ПарольДоступаКЗакрытомуКлючу;
	КонецЕсли;
	
	Если Параметры.Свойство("ТипСубъектаПодписанта") Тогда
		ТипСубъектаПодписанта = Параметры.ТипСубъектаПодписанта;
	КонецЕсли;
	
	Если Параметры.Свойство("МчдGUIDПодписанта") Тогда
		МчдGUIDПодписанта = Параметры.МчдGUIDПодписанта;
	КонецЕсли; 
	
	Если Параметры.Свойство("ДатаНачалаДействияМЧД") Тогда
		ДатаНачалаДействияМЧД = Параметры.ДатаНачалаДействияМЧД;
	КонецЕсли;	
	
	Если Параметры.Свойство("ДолжностьФизлица") Тогда
		ДолжностьФизлица = Параметры.ДолжностьФизлица;
	КонецЕсли;
	
	Если Параметры.Свойство("Организация") Тогда
		Организация = Параметры.Организация;
	КонецЕсли;
	
	Если Параметры.Свойство("ИдентификаторОрганизации") Тогда
		ИдентификаторОрганизации = Параметры.ИдентификаторОрганизации;
	КонецЕсли;
	
	Кэш = ЗагрузитьКэш();
	
	Если Параметры.Свойство("ТекущаяСтраница") Тогда
		ИмяТаблицыИсточника = Параметры.ТекущаяСтраница;
	КонецЕсли;
	
	Если Параметры.Свойство("ПрефиксКонфигурации") Тогда
		ПрефиксКонфигурации = Параметры.ПрефиксКонфигурации;
	КонецЕсли;
	
	Если Параметры.Свойство("ФорматВыгрузки") Тогда
		ФорматВыгрузки = Параметры.ФорматВыгрузки;
	Иначе
		ФорматВыгрузки = "";
	КонецЕсли;
	
	Если Параметры.Свойство("ПредставлениеФорматаВыгрузки") Тогда
		ПредставлениеФорматаВыгрузки = Параметры.ПредставлениеФорматаВыгрузки;
	Иначе
		ПредставлениеФорматаВыгрузки = "";
	КонецЕсли;
	
	Если Параметры.Свойство("ВерсияФорматаВыгрузки") Тогда
		ВерсияФорматаВыгрузки = Параметры.ВерсияФорматаВыгрузки;
	Иначе
		ВерсияФорматаВыгрузки = "";
	КонецЕсли;
	
	Для Каждого ДокументМетаданные Из Метаданные.Документы Цикл
		СписокТипов.Добавить(Тип("ДокументСсылка."+ДокументМетаданные.Имя));
	КонецЦикла;
	
	ОпределитьИспользованиеТестовогоКонтура();
	
	//Для Каждого ДокументМетаданные Из Метаданные.Справочники Цикл
	//	СписокТипов.Добавить(Тип("СправочникСсылка."+ДокументМетаданные.Имя));
	//КонецЦикла;
	
	РеквизитАбонент = Кэш.НастройкиОбъект.Получить(ПрефиксКонфигурации+"ПараметрыФормированияПакетов").СпискиДокументов[ИмяТаблицыИсточника].РеквизитПолучатель.НаименованиеРеквизита;
	
	МассивДокументовДляВыгрузки = Новый Массив;
	Если Параметры.Свойство("МассивДокументовДляВыгрузки") Тогда
		МассивДокументовДляВыгрузки = Параметры.МассивДокументовДляВыгрузки;
	КонецЕсли;
	
	Для Каждого СтруктураДокумента из МассивДокументовДляВыгрузки Цикл
				
		НоваяСтрока = ДокументыНаОтправку.Добавить();
		НоваяСтрока.Документ				= СтруктураДокумента.Ссылка;
		НоваяСтрока.Получатель				= ЗначениеРеквизитаОбъекта(НоваяСтрока.Документ, РеквизитАбонент);
		НоваяСтрока.ИдентификаторПолучателя	= ПолучитьИдентификаторЭДОИз1СПоСсылке(НоваяСтрока.Получатель);
		
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.ИдентификаторПолучателя) Тогда
			НоваяСтрока.ЗафиксированаОшибка = Истина;
		КонецЕсли;	
		
		НоваяСтрокаФормализованных = ТаблицаФормализованных.Добавить();
		
		НоваяСтрокаФормализованных.ДокументВладелецПакета	= СтруктураДокумента.Ссылка;
		НоваяСтрокаФормализованных.Документ					= СтруктураДокумента.Ссылка;
		НоваяСтрокаФормализованных.Формат					= ФорматВыгрузки;
		НоваяСтрокаФормализованных.ПредставлениеФормата		= ПредставлениеФорматаВыгрузки;
		НоваяСтрокаФормализованных.ВерсияФормата			= ВерсияФорматаВыгрузки; 
		
		Если Параметры.ФорматВыгрузки = "ON_NSCHFDOPPR" ИЛИ Параметры.ФорматВыгрузки = "ON_NKORSCHFDOPPR" Тогда
			Если ТипЗнч(СтруктураДокумента) = Тип("Структура") Тогда
				Если СтруктураДокумента.Свойство("Фактура") И ЗначениеЗаполнено(СтруктураДокумента.Фактура) Тогда
					НоваяСтрокаФормализованных.Документ = СтруктураДокумента.Фактура;
					НоваяСтрокаФормализованных.ФункцияУПД = ?(Параметры.ФорматВыгрузки = "ON_NKORSCHFDOPPR", "КСЧФДИС", "СЧФДОП");
				Иначе
					НоваяСтрокаФормализованных.ФункцияУПД = ?(Параметры.ФорматВыгрузки = "ON_NKORSCHFDOPPR", "ДИС", "ДОП");
				КонецЕсли;
				Если ТипЗнч(НоваяСтрокаФормализованных.ДокументВладелецПакета) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
					НоваяСтрокаФормализованных.ФункцияУПД = ?(Параметры.ФорматВыгрузки = "ON_NKORSCHFDOPPR", "КСЧФ", "СЧФ");
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
		
	КонецЦикла;
	
	//Получение шаблонов пакетов
	
	ТаблицаШаблонов = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки",
	"СписокШаблоновПакетов",
	"Содержит список шаблонов пакетов ЭД",
	ПолучитьТекущегоПользователя()); 
	
	Если НЕ ТаблицаШаблонов = Неопределено тогда
		
		МассивШаблонов = Новый Массив;
		
			Для каждого Строка из ТаблицаШаблонов цикл
			
				СтруктураСтроки = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Строка);
				МассивШаблонов.Добавить(СтруктураСтроки)
			
			КонецЦикла;  
	
		ЭтотОбъект.АдресВременногоХранилищаСписокШаблонов = ПоместитьВоВременноеХранилище(МассивШаблонов,ЭтаФорма.УникальныйИдентификатор);
			
	КонецЕсли;
	
КонецПроцедуры

