&НаСервере
Функция СформироватьФормализованыйДокумент(ДокументВладелец, Документ, ФорматВыгрузки, ФункцияУПД)

	ИмяНастройки = ИмяТаблицыИсточника + "_" + ФорматВыгрузки; 
	
	// Неловкое последствие легаси.
	Если ФункцияУПД = "СЧФДОП" ИЛИ ФункцияУПД = "КСЧФДИС" Тогда
		Если НЕ ДокументВладелец = Документ Тогда
			ПереченьДокументов = Новый ТаблицаЗначений;
			ПереченьДокументов.Колонки.Добавить("Ссылка");
			ПереченьДокументов.Колонки.Добавить("Фактура");
			НоваяСтрока = ПереченьДокументов.Добавить();
			НоваяСтрока.Ссылка = ДокументВладелец;
			НоваяСтрока.Фактура = Документ;
		Иначе
			ПереченьДокументов = Новый Массив;
			ПереченьДокументов.Добавить(Документ);
		КонецЕсли;
	Иначе
		ПереченьДокументов = Новый Массив;
		ПереченьДокументов.Добавить(Документ);
	КонецЕсли;	
	
	МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
	
	// Загружаем Кэш обработки из временного хранилища
	Кэш = ЗагрузитьКэш();
	
	//Результат = МодульОбъектаОбработки.ВыгрузитьМассивДокументов(ПереченьДокументов, ТипВыгрузки, Кэш);
	Результат = МодульОбъектаОбработки.ВыгрузитьМассивДокументов(ПереченьДокументов, Организация, ИмяНастройки, ФорматВыгрузки, Кэш, Истина, ФункцияУПД);
	
	Если Результат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Возвращаем результат выгрузки на клиент
	
	Если НЕ Результат.ВыгрузкаДокументов = Неопределено и Результат.ВыгрузкаДокументов.Количество() > 0 Тогда 
		Возврат Результат.ВыгрузкаДокументов[0];
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции

&НаКлиенте
Функция ЗагрузитьФормализованныйДокумент(СтрокаДокумента)
	
	ЗарегистрированаОшибкаЗагрузки = Ложь;
	
	ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса(); 
	ПараметрыЗапроса.Параметры.Вставить("<Тело>", СтрокаДокумента.ПолноеИмяФайла);  
	
	Если ЗначениеЗаполнено(ПредставлениеТекущейКонфигурации) Тогда
		ПараметрыЗапроса.Заголовки.Вставить("x-client-id", ПредставлениеТекущейКонфигурации);	
	КонецЕсли;	
	
	ЗагрузкаДокумента = ВыполнитьЗапросAPI("API_ЗагрузитьДокумент_ИмяФайлаТела", ПараметрыЗапроса);
	
	СтрокаДокумента.СтруктураОписанияДокумента.ЗагрузкаДокумента = ЗагрузкаДокумента;
	
	Если Не ЗагрузкаДокумента.Ошибка Тогда
		СтрокаДокумента.ИдентификаторДокумента = СтрЗаменить(Строка(ЗагрузкаДокумента.Результат.id)," ","");
		СтрокаДокумента.СтруктураОписанияДокумента.ИдентификаторЭДО = СтрокаДокумента.ИдентификаторДокумента;
		//Документ.СтатусЭДО = "Черновик";
		СтрокаДокумента.СтруктураОписанияДокумента.СтатусЭДО = 10;
	Иначе
		//Документ.СтатусЭДО = "Ошибка загрузки"; 
		СтрокаДокумента.СтруктураОписанияДокумента.СтатусЭДО = 21;
		ЗарегистрированаОшибкаЗагрузки = Истина; 
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось загрузить в сервис ЭДО формализованный эл. документ формата """+СтрокаДокумента.ПредставлениеФормата+""" по документу "+СтрокаДокумента.Документ+"."
				+Символы.ПС+"Техническое описание ошибки:"
				+Символы.ПС+ЗагрузкаДокумента.Описание;
	КонецЕсли;
	
	Возврат ЗарегистрированаОшибкаЗагрузки;
	
КонецФункции

&НаКлиенте
Функция СформироватьНеформализованныйДокумент(ОписаниеПФ)
	
	МассивОбъектов = Новый Массив();
	МассивОбъектов.Добавить(ОписаниеПФ.Документ);
	
	ИмяМенеджераПечати				= ОписаниеПФ.ИмяМенеджераПечати;
	ИменаМакетов					= ?(ИмяМенеджераПечати = "СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки", "ВнешняяПечатнаяФорма."+ОписаниеПФ.ИмяМакета, ОписаниеПФ.ИмяМакета);
	ИдентификаторОтправителя		= ИдентификаторОрганизации;
	ПараметрыПечати					= ?(ЗначениеЗаполнено(ОписаниеПФ.ДополнительныеПараметры), ОписаниеПФ.ДополнительныеПараметры, Новый Структура());
	ФорматФайла						= ?(ЗначениеЗаполнено(ОписаниеПФ.ФорматФайла), ОписаниеПФ.ФорматФайла, "pdf");
	ТипФорматаФайла					= ТипФайлаТабличногоДокумента.PDF;
	ДопустимыеТипыОбъектовПечати	= Неопределено;
	ИмяФайла						= СтрЗаменить(ОписаниеПФ.Документ, ":", ".")+" "+ИменаМакетов;
	
	ТабличныйДокументРезультат = ВызовФормированияПечатныхФормБСП(ИмяМенеджераПечати, ИменаМакетов, МассивОбъектов, ПараметрыПечати, ДопустимыеТипыОбъектовПечати);
	Если ТабличныйДокументРезультат = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Печатная форма """+ОписаниеПФ.ПредставлениеПечатнойФормы+""" по документу """+ОписаниеПФ.Документ+""""
		+Символы.ПС+"не была сформирована."
		+Символы.ПС+"Не удалось сформировать табличный документ.";
		Сообщение.Сообщить();
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТабличныйДокументРезультат.ВысотаТаблицы = 0 Тогда
		// Пустой табличный документ.
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Печатная форма """+ОписаниеПФ.ПредставлениеПечатнойФормы+""" по документу """+ОписаниеПФ.Документ+""""
		+Символы.ПС+"не была сформирована."
		+Символы.ПС+"Эта печатная форма к указанному документу не применяется.";
		Сообщение.Сообщить();
		Возврат Неопределено;
	КонецЕсли;	
	
	Если ФорматФайла = "xlsx" Тогда
		ТипФорматаФайла = ТипФайлаТабличногоДокумента.XLSX;
	ИначеЕсли ФорматФайла = "docx" Тогда
		ТипФорматаФайла = ТипФайлаТабличногоДокумента.DOCX;
	ИначеЕсли ФорматФайла = "pdf" Тогда
		ТипФорматаФайла = ТипФайлаТабличногоДокумента.PDF;
	КонецЕсли;
	
	ПутьКОтправляемомуНеформализованномуОбъекту = КаталогВременныхФайлов()+ИмяФайла+"."+ФорматФайла;
	ТабличныйДокументРезультат.Записать(ПутьКОтправляемомуНеформализованномуОбъекту, ТипФорматаФайла);
	
	Возврат ПутьКОтправляемомуНеформализованномуОбъекту; 
	
КонецФункции	

&НаКлиенте
Функция ЗагрузитьНеформализованныйДокумент(СтрокаДокумента, СтрокаДокументаВладельцаПакета, НеформализованныйИзФайла)
	
	ЗарегистрированаОшибкаЗагрузки = Ложь;
	
	ПутьКОтправляемомуФайлу = СтрокаДокумента.ПолноеИмяФайла;
	
	Файл = Новый Файл(ПутьКОтправляемомуФайлу);
	ИмяФайла = Файл.Имя;
	
	ИдентификаторОтправителя = ИдентификаторОрганизации;
	ИдентификаторПолучателя = СтрокаДокументаВладельцаПакета.ИдентификаторПолучателя;
	
	РасширениеФайла = Прав(ПутьКОтправляемомуФайлу, СтрДлина(ПутьКОтправляемомуФайлу)-СтрНайти(ПутьКОтправляемомуФайлу, ".", НаправлениеПоиска.СКонца));
	ТипыMIME = ЗаполнитьСоответствиеТиповMIME();
	ТипКонтентаMIME = ТипыMIME.Получить(РасширениеФайла);
	
	ТипДокумента = "UNFORMALIZED";
	ВидДокумента = ?(ЗначениеЗаполнено(СтрокаДокумента.ВидДокумента), СтрокаДокумента.ВидДокумента, "Неформализованный");
	ЗаголовокДокумента = ?(ЗначениеЗаполнено(СтрокаДокумента.Заголовок), СтрокаДокумента.ВидДокумента, ИмяФайла);
	НомерДокумента = ?(ЗначениеЗаполнено(СтрокаДокумента.Номер), СтрокаДокумента.Номер, "");
	ДатаДокумента = ?(ЗначениеЗаполнено(СтрокаДокумента.Дата), СтрокаДокумента.Дата, "");
	
	ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();	    
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписьJSON.ЗаписатьИмяСвойства("senderGid");
	ЗаписьJSON.ЗаписатьЗначение(ИдентификаторОтправителя); 
	ЗаписьJSON.ЗаписатьИмяСвойства("recipientGid");
	ЗаписьJSON.ЗаписатьЗначение(ИдентификаторПолучателя); 
	ЗаписьJSON.ЗаписатьИмяСвойства("type");
	ЗаписьJSON.ЗаписатьЗначение(ТипДокумента);
	Если ЗначениеЗаполнено(ЗаголовокДокумента) Тогда
		ЗаписьJSON.ЗаписатьИмяСвойства("topic");
		ЗаписьJSON.ЗаписатьЗначение(ЗаголовокДокумента);
	КонецЕсли;
	Если ЗначениеЗаполнено(НомерДокумента) Тогда
		ЗаписьJSON.ЗаписатьИмяСвойства("docNum");
		ЗаписьJSON.ЗаписатьЗначение(НомерДокумента);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаДокумента) Тогда
		ЗаписьJSON.ЗаписатьИмяСвойства("docDate");
		ЗаписьJSON.ЗаписатьЗначение(Строка(Формат(ДатаДокумента, "ДФ=dd.MM.yyyy")));
	КонецЕсли;
	Если ЗначениеЗаполнено(ВидДокумента) Тогда
		ЗаписьJSON.ЗаписатьИмяСвойства("labels");
		ЗаписьJSON.ЗаписатьНачалоМассива();
		ЗаписьJSON.ЗаписатьЗначение(""+ВидДокумента+"");
		ЗаписьJSON.ЗаписатьКонецМассива();
	КонецЕсли;
	
	ЗаписьJSON.ЗаписатьКонецОбъекта();	    
	СтрокаТела = СтрЗаменить(ЗаписьJSON.Закрыть(), "\", "");
	
	ПараметрыЗапроса.Параметры.Вставить("<Тело>", СтрокаТела);
	
	Если ЗначениеЗаполнено(ПредставлениеТекущейКонфигурации) Тогда
		ПараметрыЗапроса.Заголовки.Вставить("x-client-id", ПредставлениеТекущейКонфигурации);	
	КонецЕсли;
		
	РезультатОтправкиНеформализованногоДокумента = ВыполнитьЗапросAPI("API_ЗагрузитьДокумент_ТелоИзСтроки", ПараметрыЗапроса);
	
	Если НЕ РезультатОтправкиНеформализованногоДокумента.Ошибка Тогда
		
		ДвоичнаяСтрокаФайла = Новый ДвоичныеДанные(ПутьКОтправляемомуФайлу);
		
		ИдентификаторПодготовленногоНеформализованногоДокумента = Формат(РезультатОтправкиНеформализованногоДокумента.Результат.id, "ЧГ=0");
		
		ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
		ПараметрыЗапроса.Параметры.Вставить("<document_id>", ИдентификаторПодготовленногоНеформализованногоДокумента);
		ПараметрыЗапроса.Параметры.Вставить("<Тело>", ДвоичнаяСтрокаФайла);
		ПараметрыЗапроса.Заголовки.Вставить("Content-Type", ТипКонтентаMIME);
		РезультатЗагрузкиКонтента = ВыполнитьЗапросAPI("API_ЗагрузитьКонтентВДокумент", ПараметрыЗапроса);
		
		Если НЕ РезультатЗагрузкиКонтента.Ошибка Тогда
			
			СтрокаДокумента.ИдентификаторДокумента = ИдентификаторПодготовленногоНеформализованногоДокумента;
			
		Иначе
			
			ЗарегистрированаОшибкаЗагрузки = Истина;
			
		КонецЕсли;	
		
	Иначе
		
		ЗарегистрированаОшибкаЗагрузки = Истина;
		
	КонецЕсли;
	
	Если ЗарегистрированаОшибкаЗагрузки Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Если НеформализованныйИзФайла = Ложь Тогда 
			Сообщение.Текст = "Не удалось загрузить неформализованный эл. документ по документу "+СтрокаДокумента.Документ+","
						+Символы.ПС+"созданному при помощи печатной формы """+СтрокаДокумента.ПредставлениеПечатнойФормы+"""."
						+Символы.ПС+"Техническое описание ошибки:"
						+Символы.ПС+РезультатОтправкиНеформализованногоДокумента.Описание;
		Иначе
			Сообщение.Текст = "Не удалось загрузить неформализованный эл. документ по документу из файла """+СтрокаДокумента.ПутьКФайлу+"""."
						+Символы.ПС+"Техническое описание ошибки:"
						+Символы.ПС+РезультатОтправкиНеформализованногоДокумента.Описание;
		КонецЕсли;
		Сообщение.Сообщить();
		
	КонецЕсли;	
	
	Возврат ЗарегистрированаОшибкаЗагрузки;
	
КонецФункции

&НаКлиенте
Функция ПоместитьДокументВСообщение(ИдДокумента, ИдСообщения, ИдПакета)
	
	ЗарегистрированаОшибкаПомещенияДокументаВСообщение = Ложь;
	
	ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
	ПараметрыЗапроса.Параметры.Вставить("<documentId>", ИдДокумента);
	ПараметрыЗапроса.Параметры.Вставить("<messageId>", ИдСообщения);
	
	ПомещениеДокументаВСообщение = ВыполнитьЗапросAPI("API_ПоместитьДокументВСообщение", ПараметрыЗапроса);
	
	Если ПомещениеДокументаВСообщение.Ошибка = Истина Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось поместить эл. документ в сообщение пакета."
					+Символы.ПС+"Идентификаторы:" 
					+Символы.ПС+"Документ " +ИдДокумента+ "."
					+Символы.ПС+"Сообщение " +ИдСообщения+ "."
					+Символы.ПС+"Пакет " +ИдПакета+ "."
					+Символы.ПС+"Техническое описание ошибки:"
					+Символы.ПС+ПомещениеДокументаВСообщение.Описание;
		Сообщение.Сообщить();
		
		ЗарегистрированаОшибкаПомещенияДокументаВСообщение = Истина;
		
	КонецЕсли;	
	
	Возврат ЗарегистрированаОшибкаПомещенияДокументаВСообщение;
	
КонецФункции

&НаКлиенте
Функция ПрикрепитьПодписьКДокументу(Документ, ЭтоФормализованныйДокумент)
	
	ИдДокумента = Документ.ИдентификаторДокумента;
	
	Если ЭтоФормализованныйДокумент = Истина Тогда
		
		ИмяФайлаПодписи = Документ.ПолноеИмяФайлаПодписи;
		
		ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
		ПараметрыЗапроса.Параметры.Вставить("<document_id>", ИдДокумента); 
		
		ПодписьДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаПодписи); 
		
		ЭлектроннаяПодписьCMSBase64 = Base64Строка(ПодписьДвоичныеДанные);
		ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ПС, "");
		ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ВК, "");
		ЭлектроннаяПодписьCMSвDERвURL = КодироватьBase64СтрокуВСтрокуURLНаСервере(ЭлектроннаяПодписьCMSBase64);
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("value", ЭлектроннаяПодписьCMSBase64);
		Если ТипСубъектаПодписанта = "ФЛ" Тогда
			СтруктураPOA = Новый Структура;
			СтруктураPOA.Вставить("number", МчдGUIDПодписанта);
			СтруктураДанных.Вставить("poa", СтруктураPOA);
		КонецЕсли;
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
		СтрокаТелаДляПередачиПодписи = ЗаписьJSON.Закрыть();
		ПараметрыЗапроса.Параметры.Вставить("<Тело>", СтрокаТелаДляПередачиПодписи);
		РезультатПодписанияДокумента = ВыполнитьЗапросAPI("API_ПрикрепитьПодписьКДокументу" ,ПараметрыЗапроса);
		
		Документ.СтруктураОписанияДокумента.ПодписаниеДокумента = РезультатПодписанияДокумента;
		
		Если Не РезультатПодписанияДокумента.Ошибка Тогда
			//Документ.СтатусЭДО = "Отправлен";
			Документ.СтруктураОписанияДокумента.СтатусЭДО = 40;
			Возврат Ложь;
		Иначе         				
			//Документ.СтатусЭДО = "Ошибка подписания";
			Документ.СтруктураОписанияДокумента.СтатусЭДО = 23;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не удалось прикрепить подготовленный файл подписи к электронному документу с идентификатором "+ИдДокумента+"."
						+Символы.ПС+"Техническое описание ошибки:"
						+Символы.ПС+РезультатПодписанияДокумента.Описание;
			Сообщение.Сообщить();
			Возврат Истина;
		КонецЕсли;
		
	Иначе
		
		ИмяФайлаПодписи = Документ.ПолноеИмяФайлаПодписи;
		
		ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
		ПараметрыЗапроса.Параметры.Вставить("<document_id>", ИдДокумента);
		
		ПодписьДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаПодписи); 
		
		ЭлектроннаяПодписьCMSBase64 = Base64Строка(ПодписьДвоичныеДанные);
		ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ПС, "");
		ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ВК, "");
		ЭлектроннаяПодписьCMSвDERвURL = КодироватьBase64СтрокуВСтрокуURLНаСервере(ЭлектроннаяПодписьCMSBase64);
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("value", ЭлектроннаяПодписьCMSBase64);
		Если ТипСубъектаПодписанта = "ФЛ" Тогда
			СтруктураPOA = Новый Структура;
			СтруктураPOA.Вставить("number", МчдGUIDПодписанта);
			СтруктураДанных.Вставить("poa", СтруктураPOA);
		КонецЕсли;
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
		СтрокаТелаДляПередачиПодписи = ЗаписьJSON.Закрыть();
		ПараметрыЗапроса.Параметры.Вставить("<Тело>", СтрокаТелаДляПередачиПодписи);
		
		РезультатПодписанияДокумента = ВыполнитьЗапросAPI("API_ПрикрепитьПодписьКДокументу", ПараметрыЗапроса);
		
		Если Не РезультатПодписанияДокумента.Ошибка Тогда
			Возврат Ложь;
		Иначе         				
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не удалось прикрепить подготовленный файл подписи к электронному документу с идентификатором "+ИдДокумента+"."
						+Символы.ПС+"Техническое описание ошибки:"
						+Символы.ПС+РезультатПодписанияДокумента.Описание;
			Сообщение.Сообщить();
			Возврат Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции	

&НаКлиенте
Процедура ЗафиксироватьСтатусыФормализованныхДокументов()
	
	Для Каждого ДокументВладелецПакета из ДокументыНаОтправку Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("ДокументВладелецПакета", ДокументВладелецПакета.Документ);
		
		ФормализованныеДокументыПакета = ТаблицаФормализованных.НайтиСтроки(Отбор);
		
		Для Каждого ФормализованныйДокумент из ФормализованныеДокументыПакета Цикл
			
			Если ЗначениеЗаполнено(ФормализованныйДокумент.СтруктураОписанияДокумента) Тогда
				ЗафиксироватьСтатусФормализованногоДокумента(ФормализованныйДокумент.СтруктураОписанияДокумента);
			КонецЕсли;	
			
		КонецЦикла;	
		
	КонецЦикла;	
	
КонецПроцедуры	

