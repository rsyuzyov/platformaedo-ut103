#Область СобытияЭлементовФормы

&НаКлиенте
Процедура ТаблицаДокументыНаОтправкуПриАктивизацииСтроки(Элемент)
	
	ОтобразитьДокументыВыбранногоВладельца();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументыНаОтправкуПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьДокументыВыбранногоВладельца()
	
	Если Элементы.ТаблицаДокументыНаОтправку.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ВыбранныйДокумент = Элементы.ТаблицаДокументыНаОтправку.ТекущиеДанные.Документ;
	ПолучательВыбранногоДокумента = Элементы.ТаблицаДокументыНаОтправку.ТекущиеДанные.Получатель;
	
	
	ОпределитьАбонентаВыбранногоДокумента(ВыбранныйДокумент);
	
	ТаблицаФормализованныхДляОтображения.Очистить();
	ТаблицаНеформализованныхДляОтображения.Очистить();
	ТаблицаНеформализованныхИзФайловДляОтображения.Очистить();
	
	Отбор = Новый Структура;
	Отбор.Вставить("ДокументВладелецПакета", ВыбранныйДокумент);
	ФормализованныеДокументыПоВладельцу = ТаблицаФормализованных.НайтиСтроки(Отбор);
	НеформализованныеДокументыПоВладельцу = ТаблицаНеформализованных.НайтиСтроки(Отбор);
	НеформализованныеДокументыИзФайловПоВладельцу = ТаблицаНеформализованныхИзФайлов.НайтиСтроки(Отбор);

	Для Каждого Документ из ФормализованныеДокументыПоВладельцу Цикл
		НоваяСтрока = ТаблицаФормализованныхДляОтображения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Документ);
	КонецЦикла;
	
	Для Каждого Документ из НеформализованныеДокументыПоВладельцу Цикл
		НоваяСтрока = ТаблицаНеформализованныхДляОтображения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Документ);
	КонецЦикла;
	
	Для Каждого Документ из НеформализованныеДокументыИзФайловПоВладельцу Цикл
		НоваяСтрока = ТаблицаНеформализованныхИзФайловДляОтображения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Документ);
	КонецЦикла;
	
	Если Элементы.ТаблицаДокументыНаОтправку.ТекущиеДанные.УспешноОтправлен = Истина Тогда
		Элементы.ТаблицаФормализованных.ТолькоПросмотр = Истина;
		Элементы.ТаблицаНеформализованных.ТолькоПросмотр = Истина;
		Элементы.ФайлыНаОтправку.ТолькоПросмотр = Истина;
		Элементы.ТаблицаНеформализованныхДополнитьСписокПодборомДокументов.Доступность = Ложь;
		Элементы.ФайлыНаОтправкуКнопкаДобавитьФайлы.Доступность = Ложь;
	Иначе
		Элементы.ТаблицаФормализованных.ТолькоПросмотр = Ложь;
		Элементы.ТаблицаНеформализованных.ТолькоПросмотр = Ложь;
		Элементы.ФайлыНаОтправку.ТолькоПросмотр = Ложь;
		Элементы.ТаблицаНеформализованныхДополнитьСписокПодборомДокументов.Доступность = Истина;
		Элементы.ФайлыНаОтправкуКнопкаДобавитьФайлы.Доступность = Истина;
	КонецЕсли;	
	
	СписокВыбораШаблонов = ПолучитьИзВременногоХранилища(ЭтотОбъект.АдресВременногоХранилищаСписокШаблонов);
	
	Элементы.ВыбранныйШаблон.СписокВыбора.Очистить();
	
	Для каждого Строка из СписокВыбораШаблонов цикл
		Если Строка.Организация = ЭтотОбъект.Организация тогда
			Если Строка.Контрагент = ПолучательВыбранногоДокумента тогда
				Элементы.ВыбранныйШаблон.СписокВыбора.Добавить(Строка.Наименование, Строка.Наименование);
			КонецЕсли;
	     КонецЕсли;
	КонецЦикла;
	
	//ВыбранныйШаблон = "";
	
КонецПроцедуры	

&НаКлиенте
Процедура УдалитьПакетИзСписка(Команда)
	
	ВыбранныйДокумент = Элементы.ТаблицаДокументыНаОтправку.ТекущиеДанные.Документ;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ДокументВладелецПакета", ВыбранныйДокумент);
	ФормализованныеДокументыПоВладельцу = ТаблицаФормализованных.НайтиСтроки(Отбор);
	НеформализованныеДокументыПоВладельцу = ТаблицаНеформализованных.НайтиСтроки(Отбор);
	НеформализованныеДокументыИзФайловПоВладельцу = ТаблицаНеформализованныхИзФайлов.НайтиСтроки(Отбор);

	Для Каждого Документ из ФормализованныеДокументыПоВладельцу Цикл
		ТаблицаФормализованных.Удалить(Документ);
	КонецЦикла;
	
	Для Каждого Документ из НеформализованныеДокументыПоВладельцу Цикл
		ТаблицаНеформализованных.Удалить(Документ);
	КонецЦикла;
	
	Для Каждого Документ из НеформализованныеДокументыИзФайловПоВладельцу Цикл
		ТаблицаНеформализованныхИзФайлов.Удалить(Документ);
	КонецЦикла;	
	
	ТаблицаФормализованныхДляОтображения.Очистить();
	ТаблицаНеформализованныхДляОтображения.Очистить();
	ТаблицаНеформализованныхИзФайловДляОтображения.Очистить();
	
	ПроверитьИУдалитьПустыеПакеты();
	
	//ОтобразитьДокументыВыбранногоВладельца();
	
КонецПроцедуры

