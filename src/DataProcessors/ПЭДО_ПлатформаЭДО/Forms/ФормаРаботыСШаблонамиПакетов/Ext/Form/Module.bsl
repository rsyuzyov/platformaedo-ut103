 Процедура СписокШаблоновПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	 Отказ = Истина;	 
 КонецПроцедуры
 
 Процедура ПослеЗакрытияФормыШаблона(ПараметрыЗакрытия, ДопПараметрыЗакрытия) Экспорт
	 
	 ОбновитьСписокШаблоновСервер();
	 ЭтотОбъект.ТекущаяСтрокаТаблицы = 0;
	 
 КонецПроцедуры
 
 Процедура ПослеЗакрытияФормыМассовогоСоздания(ПараметрыЗакрытия, ДопПараметрыЗакрытия) Экспорт
	 
 КонецПроцедуры
 
 Процедура ОбновитьСписокШаблоновСервер()
	 
	 ЭтотОбъект.СписокШаблонов.Очистить();
	 
	 ВсеШаблоны = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки",
	 "СписокШаблоновПакетов",
	 "Содержит список шаблонов пакетов ЭД",
	 ПолучитьТекущегоПользователя()); 
	 
	 СтруктураПоиска = Новый Структура;
	 СтруктураПоиска.Вставить("Организация", ЭтотОбъект.Организация);
	 
	 Если НЕ ТипЗнч(ВсеШаблоны) = Тип("Неопределено") тогда
		 ШаблоныПоОрганизации = ВсеШаблоны.НайтиСтроки(СтруктураПоиска);
	 Иначе
		 ИнициализироватьСписокШаблонов();
		 
		 ВсеШаблоны = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки",
		 "СписокШаблоновПакетов",
		 "Содержит список шаблонов пакетов ЭД",
		 ПолучитьТекущегоПользователя());
		 
		 ШаблоныПоОрганизации = ВсеШаблоны.НайтиСтроки(СтруктураПоиска);
	 КонецЕсли;
	 
	 Для каждого Строка из ШаблоныПоОрганизации цикл
		 
		 НСтр = ЭтотОбъект.СписокШаблонов.Добавить();
		 НСтр.Контрагент = Строка.Контрагент;
		 НСтр.ИНН = Строка.Контрагент.ИНН;
		 НСтр.КПП = Строка.Контрагент.КПП;
		 Попытка
			 НСтр.Наименование = Строка.Наименование;
		 Исключение 
			 НСтр.Наименование = Строка.ИДШаблона;
		 КонецПопытки;
	 КонецЦикла;
	 
	 
 КонецПроцедуры 
 
 Процедура ИнициализироватьСписокШаблонов()
	 
	 ВсеНастройки = Новый ТаблицаЗначений;
	 ВсеНастройки.Колонки.Добавить("Организация");
	 ВсеНастройки.Колонки.Добавить("Контрагент");
	 ВсеНастройки.Колонки.Добавить("Наименование");
	 
	 ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки",
	 "СписокШаблоновПакетов",
	 ВсеНастройки,
	 "Содержит шаблоны пакетов ЭД",
	 ПолучитьТекущегоПользователя());
	 
 КонецПроцедуры
 
 &НаСервереБезКонтекста
 Функция ПолучитьТекущегоПользователя()
	 
	 Возврат Неопределено;
	 
	 Если НЕ Метаданные.ОбщиеМодули.Найти("ПользователиИнформационнойБазы") = Неопределено Тогда
		 ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	 Иначе
		 ТекущийПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	 КонецЕсли;	
	 
	 Возврат ТекущийПользователь;
	 
 КонецФункции
 
 &НаКлиенте
 Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	 
	 ПередЗакрытиемСервер();
	 
 КонецПроцедуры 
 
 &НаСервере
 Процедура ПередЗакрытиемСервер()
	 
	 СтруктураФормы = Новый Структура;
	 
	 СтруктураФормы.Вставить("Организация",ЭтотОбъект.Организация);
	 
	 ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки",
	 "ДанныеФормыСпискаШаблонов",
	 СтруктураФормы,
	 "Содержит сохраняемые реквизиты",
	 ПолучитьТекущегоПользователя());
	 
	 
 КонецПроцедуры
 
 &НаКлиенте
 Процедура СписокШаблоновПередУдалением(Элемент, Отказ)
	 
	 СтруктураПоиска = Новый Структура;
	 
	 СтруктураПоиска = Новый Структура;
	 СтруктураПоиска.Вставить("Организация", ЭтотОбъект.Организация); 
	 СтруктураПоиска.Вставить("Наименование", Элементы.СписокШаблонов.ТекущиеДанные.Наименование); 
	 
	 УдалитьШаблоныСервер(СтруктураПоиска);
	 
 КонецПроцедуры  
 
 Процедура УдалитьШаблоныСервер(СтруктураПоиска)
	 
	 ВсеШаблоны = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки",
	 "СписокШаблоновПакетов",
	 "Содержит список шаблонов пакетов ЭД",
	 ПолучитьТекущегоПользователя());
	 
	 НайденныеШаблоны = ВсеШаблоны.НайтиСтроки(СтруктураПоиска);	
	 
	 Для каждого Строка из НайденныеШаблоны цикл
		 ВсеШаблоны.Удалить(Строка);
	 КонецЦикла;
	 
	 ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки",
	 "СписокШаблоновПакетов",
	 ВсеШаблоны,
	 "Содержит список шаблонов пакетов ЭД",
	 ПолучитьТекущегоПользователя());
	 
	 
 КонецПроцедуры
 
