	 ПараметрыОткрытияФормы.Вставить("ЭтоНовый", Ложь);
	 ПараметрыОткрытияФормы.Вставить("Контрагент", );
	 ПараметрыОткрытияФормы.Вставить("Организация", ЭтотОбъект.Организация);
	 ПараметрыОткрытияФормы.Вставить("Наименование");
	 
