 
 #Область ОбработчикиСобытийШапкиФормы
 
 &НаСервере
 Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	 
	 ЭтотОбъект.ИмяОбработки = РеквизитФормыВЗначение("Объект").Метаданные().ПолноеИмя();
	 
	 Если Параметры.Свойство(Организация) тогда
		 ЭтотОбъект.Организация = Параметры.Организация;
	 КонецЕсли; 
	 
	 КэшированныеРеквизиты = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки",
	 "ДанныеФормыСпискаШаблонов",
	 "Содержит сохраняемые реквизиты",
	 ПолучитьТекущегоПользователя()); 
	 
	 Если НЕ КэшированныеРеквизиты = Неопределено тогда
		 
		 ЭтотОбъект.Организация = КэшированныеРеквизиты.Организация;
		 
	 КонецЕсли;
	 
	 ОбновитьСписокШаблоновСервер();
	 
 КонецПроцедуры
 
 &НаКлиенте
 Процедура ОрганизацияПриИзменении(Элемент)
	 
	 ОбновитьСписокШаблоновСервер();
	 
 КонецПроцедуры  
 
 &НаКлиенте
 Процедура СписокШаблоновПриАктивизацииСтроки(Элемент)
	 ЭтотОбъект.Элементы.СписокШаблоновГрупповоеСозданиеШаблоновНаОсновании.Доступность = Истина;
	 ЭтотОбъект.ТекущаяСтрокаТаблицы = Элементы.СписокШаблонов.ТекущаяСтрока;
 КонецПроцедуры
 
 
 #КонецОбласти
 
 #Область ОбработчикиКомандФормы
 
 &НаКлиенте
 Процедура ГрупповоеСозданиеШаблоновНаОсновании(Команда)
	 
	 ВыбранныйШаблон = Элементы.СписокШаблонов.ВыделенныеСтроки[0];
	 
	 ПараметрыОткрытияФормы = Новый Структура;
	 ПараметрыОткрытияФормы.Вставить("ЭтоНовый", Истина);
	 ПараметрыОткрытияФормы.Вставить("ЭтоМассовоеСоздание", Истина);
	 ПараметрыОткрытияФормы.Вставить("Контрагент", "");
	 ПараметрыОткрытияФормы.Вставить("Организация", ЭтотОбъект.Организация);
	 
	 ОповещениОЗакрытии = Новый ОписаниеОповещения("ПослеЗакрытияФормыМассовогоСоздания", ЭтаФорма);
	 
	 ОткрытьФорму(ИмяОбработки + ".Форма.ФормаШаблонаПакета", ПараметрыОткрытияФормы, ЭтаФорма, , , ,ОповещениОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	 
	 
 КонецПроцедуры
 
 &НаКлиенте
 Процедура СоздатьНовыйШаблон(Команда)
	 
	 ПараметрыОткрытияФормы = Новый Структура;
	 ПараметрыОткрытияФормы.Вставить("ЭтоНовый", Истина);
	 ПараметрыОткрытияФормы.Вставить("Контрагент");
	 ПараметрыОткрытияФормы.Вставить("Организация", ЭтотОбъект.Организация);
	 
	 ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеЗакрытияФормыШаблона", ЭтаФорма);
	 
	 ОткрытьФорму(ИмяОбработки + ".Форма.ФормаШаблонаПакета", ПараметрыОткрытияФормы, ЭтаФорма, , , ,ОповещениеОЗакрытии , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	 
 КонецПроцедуры
 
 &НаКлиенте
 Процедура СозданиеШаблонаКопированием(Команда)
	 
	 ПараметрыОткрытияФормы = Новый Структура;
	 ДопПараметры = Новый Структура;
	 
	 ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗакрытияФормыШаблона", ЭтотОбъект, ДопПараметры);
	 
	 ПараметрыОткрытияФормы.Вставить("ЭтоНовый", Ложь);
	 ПараметрыОткрытияФормы.Вставить("Контрагент", );
	 ПараметрыОткрытияФормы.Вставить("Организация", ЭтотОбъект.Организация);
	 ПараметрыОткрытияФормы.Вставить("Наименование");
	 ПараметрыОткрытияФормы.Вставить("ЭтоКопирование", Истина);
	 
	 ЗаполнитьЗначенияСвойств(ПараметрыОткрытияФормы, Элементы.СписокШаблонов.ТекущиеДанные);
	 
	 ОткрытьФорму(ИмяОбработки + ".Форма.ФормаШаблонаПакета", ПараметрыОткрытияФормы, ЭтаФорма, , , ,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	 
 КонецПроцедуры
 
 
