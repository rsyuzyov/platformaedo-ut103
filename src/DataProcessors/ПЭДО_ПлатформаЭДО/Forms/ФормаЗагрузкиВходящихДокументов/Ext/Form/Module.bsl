
#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	АдресВременногоХранилищаКэш = Параметры.АдресВременногоХранилищаКэш;
	ПутьКФайлуЗагружаемогоДокумента = Параметры.ПутьКФайлуЗагружаемогоДокумента;
	ФорматЗагружаемогоЕдиничногоДокумента = Параметры.ФорматЗагружаемогоДокумента;
	ПрефиксКонфигурации = Параметры.ПрефиксКонфигурации;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИнициализацияКэш();
	
	ЭтаФорма.ПараметрыЗагрузкиНоменклатуры = Новый Структура;
	
	ЗарузкаЕдиничногоДокумента_ПоискИСопоставлениеНоменклатуры();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗарузкаЕдиничногоДокумента_ПоискИСопоставлениеНоменклатуры()
	
	ФайлДокументаДвоичныеДанные	= Новый ДвоичныеДанные(ПутьКФайлуЗагружаемогоДокумента);
	
	ЗагруженныйДокумент = Неопределено;
	
	СписокОбъектовПриемников = ПередЗагрузкой_ПодготовкаНаСервере(ФайлДокументаДвоичныеДанные);
		
	Если НЕ СписокОбъектовПриемников = Неопределено И СписокОбъектовПриемников.Количество() >= 2 Тогда
		Оповещение = Новый ОписаниеОповещения("ОповещениеПослеВыбораОбъектаПриемникаЗагружаемогоДокумента", ЭтотОбъект, ФайлДокументаДвоичныеДанные);
		ПоказатьВыборИзСписка(Оповещение, СписокОбъектовПриемников);
	ИначеЕсли НЕ СписокОбъектовПриемников = Неопределено И СписокОбъектовПриемников.Количество() = 1 Тогда
		ВариантПриемникаЗагрузкиЕдиничногоДокумента = СписокОбъектовПриемников[0].Значение;
		Если ТребуетсяСопоставлениеТоваров = Истина Тогда
			Элементы.ТаблицаСопоставленияНоменклатуры.Доступность = Истина;
			ПередЗагрузкой_ПрочитатьДанныеОТоварахНаСервере(ФайлДокументаДвоичныеДанные, ФорматЗагружаемогоЕдиничногоДокумента, ВариантПриемникаЗагрузкиЕдиничногоДокумента);
		КонецЕсли;
	Иначе	
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось определить список объектов приемников для загружаемого документа.";
		Сообщение.Сообщить();
		ЭтаФорма.Закрыть();
	КонецЕсли;
	
	Если ЭтаФорма.ТаблицаСопоставленияНоменклатуры.Количество() > 0 И НЕ ЭтаФорма.ИспользованияХранениеРезультатовСопоставленияВИБ Тогда
		ЗагрузитьИзПамятиТаблицуТоваровНаСервере(ФорматЗагружаемогоЕдиничногоДокумента);	
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеПослеВыбораОбъектаПриемникаЗагружаемогоДокумента(Результат, ФайлДокументаДвоичныеДанные) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВариантПриемникаЗагрузкиЕдиничногоДокумента = Результат.Значение;
	
	Если ТребуетсяСопоставлениеТоваров = Истина Тогда
		Элементы.ТаблицаСопоставленияНоменклатуры.Доступность = Истина;
		ПередЗагрузкой_ПрочитатьДанныеОТоварахНаСервере(ФайлДокументаДвоичныеДанные, ФорматЗагружаемогоЕдиничногоДокумента, ВариантПриемникаЗагрузкиЕдиничногоДокумента);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗарузкаЕдиничногоДокумента(Команда)
	
	ФайлДокументаДвоичныеДанные	= Новый ДвоичныеДанные(ПутьКФайлуЗагружаемогоДокумента);
	ЗагружаемыйФормат = ФорматЗагружаемогоЕдиничногоДокумента;
	ВариантПриемникаЗагрузки = ВариантПриемникаЗагрузкиЕдиничногоДокумента;
	
	Если ТребуетсяСопоставлениеТоваров = Истина Тогда
		ОтборСтрокБезСопоставления = Новый Структура;
		ОтборСтрокБезСопоставления.Вставить("Номенклатура", ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"));
		СтрокиБезСопоставления = ЭтаФорма.ТаблицаСопоставленияНоменклатуры.НайтиСтроки(ОтборСтрокБезСопоставления);
	КонецЕсли;
	
	Если ТребуетсяСопоставлениеТоваров = Истина И СтрокиБезСопоставления.Количество()>0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не все товарные позиции сопоставлены с номенклатурой в ИБ, документ не может быть загружен.";
		Сообщение.Сообщить();
	Иначе	
		ЗагруженныйДокумент = СформироватьЕдиничныйДокументПодготовкаНаСервере(ФайлДокументаДвоичныеДанные, ЗагружаемыйФормат, ВариантПриемникаЗагрузки);
	КонецЕсли;
	
	Если НЕ ЗагруженныйДокумент = Неопределено Тогда
		ПоказатьЗначение(, ЗагруженныйДокумент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСопоставленияНоменклатурыПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользованияХранениеРезультатовПоискаВИБПриИзменении(Элемент)
	
	Если ИспользованияХранениеРезультатовСопоставленияВИБ Тогда
		Элементы.СохранитьТаблицуТоваров.Доступность = Ложь;
		Элементы.ЗагрузитьИзПамятиТаблицуТоваров.Доступность = Ложь;
		Элементы.ТекстОписаниеХраненияРезультатовВИБ.Видимость = Истина;
		Элементы.ТаблицаСопоставленияНоменклатурыНоменклатура.ТолькоПросмотр = Истина;
		Элементы.ТаблицаСопоставленияНоменклатурыНоменклатура.ТолькоПросмотр = Ложь;
		Если НЕ Элементы.Найти("ТаблицаСопоставленияНоменклатурыСсылкаНаХранениеРезультатовПоиска") = Неопределено Тогда
			Элементы.ТаблицаСопоставленияНоменклатурыСсылкаНаХранениеРезультатовПоиска.Видимость = Истина;
			Элементы.ТаблицаСопоставленияНоменклатурыНоменклатура.ТолькоПросмотр = Истина;
		КонецЕсли;
	Иначе
		Элементы.СохранитьТаблицуТоваров.Доступность = Истина;
		Элементы.ЗагрузитьИзПамятиТаблицуТоваров.Доступность = Истина;
		Элементы.ТекстОписаниеХраненияРезультатовВИБ.Видимость = Ложь;
		Элементы.ТаблицаСопоставленияНоменклатурыНоменклатура.ТолькоПросмотр = Ложь;
		Элементы.ТаблицаСопоставленияНоменклатурыНоменклатура.ТолькоПросмотр = Истина;
		Если НЕ Элементы.Найти("ТаблицаСопоставленияНоменклатурыСсылкаНаХранениеРезультатовПоиска") = Неопределено Тогда
			Элементы.ТаблицаСопоставленияНоменклатурыСсылкаНаХранениеРезультатовПоиска.Видимость = Ложь;
			Элементы.ТаблицаСопоставленияНоменклатурыНоменклатура.ТолькоПросмотр = Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	ЗарузкаЕдиничногоДокумента_ПоискИСопоставлениеНоменклатуры();
	
КонецПроцедуры

