	Возврат Перечисления[ИмяПеречисления][ЗначениеПеречисления];
	
КонецФункции

&НаСервереБезКонтекста
Функция РассчитатьЗначениеРеквизитаПоМетодуРасчета(РеквизитXDTO, МетодРасчетаЗначения, XDTOСтруктураДанные = Неопределено, ОбъектПриемник = Неопределено, ЗаполняемаяСтрока = Неопределено, СообщатьОПустомРезультате = Истина, ВходящиеПеременные = Неопределено)
	
	ИмяРеквизитаПараметра = ?(РеквизитXDTO.Свойства().Получить("ИмяОбъектаМетаданных") = Неопределено, РеквизитXDTO.ИмяПараметра, РеквизитXDTO.ИмяОбъектаМетаданных);
	
	Если МетодРасчетаЗначения = "ФиксированноеЗначение" Тогда
		ЗначениеРеквизита = ПолучитьФиксированноеЗначение(РеквизитXDTO.Источник.ПутьКИсточнику, РеквизитXDTO.ТипЗначения, ИмяРеквизитаПараметра);
	ИначеЕсли МетодРасчетаЗначения = "ИзВходящихДанных" Тогда
		ЗначениеРеквизита = ПолучитьЗначениеИзВходящихДанных(XDTOСтруктураДанные, РеквизитXDTO.Источник.ПутьКИсточнику, РеквизитXDTO.ТипЗначения, ИмяРеквизитаПараметра);
	ИначеЕсли МетодРасчетаЗначения = "ИзРанееРассчитанныхДанных" Тогда
		ЗначениеРеквизита = ПолучитьЗначениеИзРанееРассчитанныхДанных(ОбъектПриемник, РеквизитXDTO.Источник.ПутьКИсточнику, ИмяРеквизитаПараметра, ЗаполняемаяСтрока, ВходящиеПеременные);	
	ИначеЕсли МетодРасчетаЗначения = "ПоискПоИндексированнымРеквизитам" Тогда
		ЗначениеРеквизита = ПолучитьРезультатПоискаПоИндексированнымРеквизитам(XDTOСтруктураДанные, РеквизитXDTO.Источник.РеквизитыПоиска, 
																			   РеквизитXDTO.Источник.ТипОбъектаМетаданных, РеквизитXDTO.Источник.ИмяОбъектаМетаданных, 
																			   ОбъектПриемник, ЗаполняемаяСтрока, СообщатьОПустомРезультате);
	ИначеЕсли МетодРасчетаЗначения = "РезультатЗапроса" Тогда	
		ЗначениеРеквизита = ПолучитьРезультатЗапроса(XDTOСтруктураДанные, РеквизитXDTO.Источник.ТекстЗапроса, РеквизитXDTO.ТипЗначения, 
													 РеквизитXDTO.Источник.ПараметрыЗапроса, ОбъектПриемник, ЗаполняемаяСтрока, ИмяРеквизитаПараметра, СообщатьОПустомРезультате);
	ИначеЕсли МетодРасчетаЗначения = "РезультатВыполненияКода" Тогда
		ЗначениеРеквизита = ПолучитьРезультатВыполненияКода(XDTOСтруктураДанные, РеквизитXDTO.Источник.ТекстФункции, РеквизитXDTO.ТипЗначения, 
															РеквизитXDTO.Источник.ВходящиеПараметры, ОбъектПриемник, ЗаполняемаяСтрока, ИмяРеквизитаПараметра, СообщатьОПустомРезультате, ВходящиеПеременные);
	ИначеЕсли МетодРасчетаЗначения = "СсылкаНаНовыйОбъект" Тогда
		ЗначениеРеквизита = СоздатьПолучитьСсылкуНаНовыйОбъект(XDTOСтруктураДанные, РеквизитXDTO.ТипЗначения, РеквизитXDTO.Источник.РеквизитыНовогоОбъекта, РеквизитXDTO.Источник.ТипОбъектаМетаданных, 
															РеквизитXDTO.Источник.ИмяОбъектаМетаданных, ОбъектПриемник, ЗаполняемаяСтрока, ИмяРеквизитаПараметра,СообщатьОПустомРезультате, ВходящиеПеременные);													
	ИначеЕсли МетодРасчетаЗначения = "Константа" Тогда
		ЗначениеРеквизита = ПолучитьЗначениеКонстанты(РеквизитXDTO.ИмяОбъектаМетаданных);
	ИначеЕсли МетодРасчетаЗначения = "Перечисление" Тогда	
		ЗначениеРеквизита = ПолучитьЗначениеПеречисления(РеквизитXDTO.Источник.ИмяОбъектаМетаданных, РеквизитXDTO.Источник.ПутьКИсточнику)	
	ИначеЕсли МетодРасчетаЗначения = "Неопределено" Тогда
		Возврат Неопределено;	
	Иначе	
		ЗначениеРеквизита = Неопределено;
	КонецЕсли;
	
	Возврат ЗначениеРеквизита; 
	
КонецФункции

&НаСервереБезКонтекста
Функция ПроверкаСуществованияРеквизита(ОбъектМетаданных, РеквизитXDTO)
	
	Если РеквизитXDTO.СтандартныйРеквизит = "Ложь" Тогда	
		// Нестандартный.
		Если ОбъектМетаданных.Реквизиты.Найти(РеквизитXDTO.ИмяОбъектаМетаданных) = Неопределено Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст =	"При проверке существования реквизита """+РеквизитXDTO.ИмяОбъектаМетаданных+""" объекта метаданных """+ОбъектМетаданных+""" произошла ошибка."+Символы.ПС+
								"Реквизит """+РеквизитXDTO.ИмяОбъектаМетаданных+""" отсутствует в списке реквизитов объекта метаданных."+Символы.ПС+
								"Проверьте корректность файла настройки загрузки.";
			Сообщение.Сообщить();
			Возврат Ложь;
		КонецЕсли;
	ИначеЕсли РеквизитXDTO.СтандартныйРеквизит = "Истина" Тогда
		// Стандартный.
		Попытка
			ПроверяемыйСтандартныйРеквизит = ОбъектМетаданных.СтандартныеРеквизиты[РеквизитXDTO.ИмяОбъектаМетаданных];
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст =	"При проверке существования реквизита """+РеквизитXDTO.ИмяОбъектаМетаданных+""" объекта метаданных """+ОбъектМетаданных+""" произошла ошибка."+Символы.ПС+
								"Реквизит """+РеквизитXDTO.ИмяОбъектаМетаданных+""" заявлен как стандартный реквизит объекта метаданных, однако в списке стандартных реквизитов отсутствует."+
								Символы.ПС+"Проверьте корректность файла настройки загрузки.";
			Сообщение.Сообщить();
			Возврат Ложь;
		КонецПопытки;	
	Иначе
		// Внештатная ситуация.
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст =	"Неожиданная ошибка при проверке существования реквизита """+РеквизитXDTO.ИмяОбъектаМетаданных+""" объекта метаданных """+ОбъектМетаданных+"""."+Символы.ПС+
							"Проверьте корректность файла настройки загрузки.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция РезультатОбработкиУсловия(XDTOСтруктураДанные, ОписаниеОбъектаПоНастройке, ОбъектПриемник, ЗаполняемаяСтрока = Неопределено, ВходящиеПеременные = Неопределено)
	
	Если НЕ ОписаниеОбъектаПоНастройке.Свойства().Получить("УсловияЗагрузкиСтроки") = Неопределено Тогда 
		Условия = ОписаниеОбъектаПоНастройке.УсловияЗагрузкиСтроки;	
	ИначеЕсли НЕ ОписаниеОбъектаПоНастройке.Свойства().Получить("УсловияЗаполнения") = Неопределено Тогда 
		Условия = ОписаниеОбъектаПоНастройке.УсловияЗаполнения;	
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Условия.Условие) = Тип("СписокXDTO") Тогда
		
		Для Каждого Условие из Условия.Условие Цикл
			
			ЗначениеУсловия		= РассчитатьЗначениеРеквизитаПоМетодуРасчета(Условие, Условие.Источник.МетодРасчетаЗначения, XDTOСтруктураДанные, ОбъектПриемник, ЗаполняемаяСтрока, , ВходящиеПеременные);
			ПризнакСравнения	= РассчитатьЗначениеРеквизитаПоМетодуРасчета(Условие.ПризнакСравнения, Условие.ПризнакСравнения.Источник.МетодРасчетаЗначения, XDTOСтруктураДанные, ОбъектПриемник, ЗаполняемаяСтрока, , ВходящиеПеременные); 
			
			Если НЕ Условие.Свойства().Получить("СравнениеНЕ") = Неопределено И Условие.СравнениеНЕ = "Истина" Тогда
				// Если совпадают - не загружаем.
				Если ЗначениеУсловия = ПризнакСравнения Тогда
					Возврат Ложь;	
				КонецЕсли;	
			Иначе
				// Если совпадают - загружаем.
				Если НЕ ЗначениеУсловия = ПризнакСравнения Тогда
					Возврат Ложь;	
				КонецЕсли;
			КонецЕсли;	
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Условия.Условие) = Тип("ОбъектXDTO") Тогда
		
		Условие = Условия.Условие;
		
		ЗначениеУсловия		= РассчитатьЗначениеРеквизитаПоМетодуРасчета(Условие, Условие.Источник.МетодРасчетаЗначения, XDTOСтруктураДанные, ОбъектПриемник, ЗаполняемаяСтрока, , ВходящиеПеременные);
		ПризнакСравнения	= РассчитатьЗначениеРеквизитаПоМетодуРасчета(Условие.ПризнакСравнения, Условие.ПризнакСравнения.Источник.МетодРасчетаЗначения, XDTOСтруктураДанные, ОбъектПриемник, ЗаполняемаяСтрока, , ВходящиеПеременные); 
		
		Если НЕ Условие.Свойства().Получить("СравнениеНЕ") = Неопределено И Условие.СравнениеНЕ = "Истина" Тогда
			// Если совпадают - не загружаем.
			Если ЗначениеУсловия = ПризнакСравнения Тогда
				Возврат Ложь;	
			КонецЕсли;	
		Иначе
			// Если совпадают - загружаем.
			Если НЕ ЗначениеУсловия = ПризнакСравнения Тогда
				Возврат Ложь;	
			КонецЕсли;
		КонецЕсли;	
				
	КонецЕсли;	
	
	Возврат Истина;
		
КонецФункции

#КонецОбласти

#Область РаботаСИнформациейОТоварах

&НаСервере
Процедура ПрочитатьНастройкиРаботыСНоменклатуройНаСервере(ФайлНастроекРаботыСНоменклатуройДвоичныеДанные)
	
	ПутьКВременномуФайлуНастроекРаботыСНоменклатуройНаСервере	= КаталогВременныхФайлов()+"НастройкиРаботыСНоменклатурой.xml";	
	
	ФайлНастроекРаботыСНоменклатуройДвоичныеДанные.Записать(ПутьКВременномуФайлуНастроекРаботыСНоменклатуройНаСервере);
	
	ЧтениеXML = Новый ЧтениеXML();
	ЧтениеXML.ОткрытьФайл(ПутьКВременномуФайлуНастроекРаботыСНоменклатуройНаСервере);
	XDTOСтруктураНастройкиПоискаНоменклатуры = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкой_ПрочитатьДанныеОТоварахНаСервере(ФайлДокументаДвоичныеДанные, ЗагружаемыйФормат, ВаримантПриемникаЗагрузки)
	
	#Область ЧтениеФайловНастроек
	
	Адрес = АдресВременногоХранилищаКэш;
	
	Кэш = ПолучитьИзВременногоХранилища(Адрес);
		
	НастройкаЗагрузкиОбъектXDTO = Кэш.НастройкиОбъект[Кэш.ПрефиксКонфигурации+"НастройкиЗагрузки"];		
	ОписаниеЗагрузкиПоФормату = НастройкаЗагрузкиОбъектXDTO.ЗагружаемыеФорматы[ЗагружаемыйФормат];
	
	ИмяНастройкиСопоставленияНоменклатуры = ОписаниеЗагрузкиПоФормату[ВаримантПриемникаЗагрузки].ИмяНастройкиСопоставленияНоменклатуры; 
	
	XDTOСтруктураНастройкаРаботыСНоменклатурой = Кэш.НастройкиОбъект[ИмяНастройкиСопоставленияНоменклатуры];
		
	#КонецОбласти
	
	#Область ЧтениеИПроверкаНастройки
	
	НастройкаСоответствуетКонфигурации = XDTOСтруктураНастройкаРаботыСНоменклатурой.ПрефиксКонфигурации = ПрефиксКонфигурации;
	
	Если НЕ НастройкаСоответствуетКонфигурации Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Файл настройки загрузки документа не соответствует текущей конфигурации программы.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	СправочникНоменклатурыОпределен									= Ложь;
	ОбъектХраненияРезультатовСопоставленияОпределен					= Ложь;
	ОбъектПризнакаИспользованияХраненияРезультатовПоискаОпределен	= Ложь;
	ЗначениеПризнакаИспользования									= Неопределено;
	//ИспользованияХранениеРезультатовСопоставленияВИБ				= Ложь;
	
	МассивРеквизитов = Новый Массив;
	
	// Проверяем наличие объекта хранения данных по номенклатуре, объявленного в настройке.
	Если Метаданные[XDTOСтруктураНастройкаРаботыСНоменклатурой.ОбъектПоиска.ТипОбъектаМетаданных].Найти(XDTOСтруктураНастройкаРаботыСНоменклатурой.ОбъектПоиска.ИмяОбъектаМетаданных) = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст =	"Описанный в настройке работы с номенклатурой объект метаданных "
		+XDTOСтруктураНастройкаРаботыСНоменклатурой.ОбъектПоиска.ТипОбъектаМетаданных+"."
		+XDTOСтруктураНастройкаРаботыСНоменклатурой.ОбъектПоиска.ИмяОбъектаМетаданных+" не обнаружен!";
		Сообщение.Сообщить();
		Возврат;
	Иначе
		СправочникНоменклатурыОпределен = Истина;
		ПараметрыЗагрузкиНоменклатуры.Вставить("ИмяСправочникаНоменклатуры", XDTOСтруктураНастройкаРаботыСНоменклатурой.ОбъектПоиска.ИмяОбъектаМетаданных);
	КонецЕсли;
	
	ОбъектХраненияXDTO = XDTOСтруктураНастройкаРаботыСНоменклатурой.ОбъектХраненияРезультатовСопоставления;
	ОбъектХраненияИспользуется = ОбъектХраненияXDTO.Используется = "Истина"; 
	
	Если ОбъектХраненияИспользуется Тогда 
		
		// Проверяем наличие объявленного в настройке объекта хранения результатов поиска.
		Если НЕ Метаданные[ОбъектХраненияXDTO.ТипОбъектаМетаданных].Найти(ОбъектХраненияXDTO.ИмяОбъектаМетаданных) = Неопределено Тогда
			ОбъектХраненияРезультатовСопоставленияОпределен = Истина;
			ПараметрыЗагрузкиНоменклатуры.Вставить("ОбъектХраненияНоменклатурыПоставщиков", XDTOСтруктураНастройкаРаботыСНоменклатурой.ОбъектХраненияРезультатовСопоставления.ИмяОбъектаМетаданных);
		Иначе
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст =	"Описанный в настройке работы с номенклатурой объект метаданных "
			+ОбъектХраненияXDTO.ТипОбъектаМетаданных+"."+ОбъектХраненияXDTO.ИмяОбъектаМетаданных+" не обнаружен!";
			Сообщение.Сообщить();
			Возврат;
		КонецЕсли;
		
		
		// Проверяем значение признака использования, сравниваем его с ожидаемым, при котором признак считается активированным.
		// Если признак не объявлен, выбор его использования/неиспользования остаётся за пользователем.
		Если НЕ ОбъектХраненияXDTO.Свойства().Получить("ПризнакИспользования") = Неопределено Тогда
			
			ПризнакИспользованияХраненияРезультатовСопоставленияXDTO = ОбъектХраненияXDTO.ПризнакИспользования.Признак;
			ПризнакСравненияХраненияРезультатовСопоставленияXDTO = ОбъектХраненияXDTO.ПризнакИспользования.ПризнакСравнения;
			
			ПризнакИспользованияХраненияРезультатовСопоставленияЗначение = РассчитатьЗначениеРеквизитаПоМетодуРасчета(ПризнакИспользованияХраненияРезультатовСопоставленияXDTO, ПризнакИспользованияХраненияРезультатовСопоставленияXDTO.Источник.МетодРасчетаЗначения);
			ПризнакСравненияХраненияРезультатовСопоставленияЗначение = РассчитатьЗначениеРеквизитаПоМетодуРасчета(ПризнакСравненияХраненияРезультатовСопоставленияXDTO, ПризнакСравненияХраненияРезультатовСопоставленияXDTO.Источник.МетодРасчетаЗначения);
			
			Если ПризнакИспользованияХраненияРезультатовСопоставленияЗначение = ПризнакСравненияХраненияРезультатовСопоставленияЗначение Тогда
				ИспользованияХранениеРезультатовСопоставленияВИБ = Истина;
			Иначе
				ИспользованияХранениеРезультатовСопоставленияВИБ = Ложь;
			КонецЕсли;
			
		Иначе
			
			Элементы.ИспользуетсяХранениеРезультатовПоискаВИБ.ТолькоПросмотр = Ложь;
			
		КонецЕсли;	
		
		
		// Проверяем заполнение параметра "ИмяРеквизитаОбъектаХраненияДляОпределенияТовара".
		// Он нужен для понимания, в каком, собственно, реквизите объекта хранения результатов сопоставления лежит ссылка на саму норменклатуру.
		// Если объект хранения результатов сопоставления сам и есть номенклатура, нужно просто указать реквизит "Ссылка". 
		Если ОбъектХраненияXDTO.Свойства().Получить("ИмяРеквизитаОбъектаХраненияДляОпределенияТовара") = Неопределено Тогда
			ОбъектПризнакаИспользованияХраненияРезультатовПоискаОпределен = Ложь;
			Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Не удалось определить реквизит объекта хранения сопоставления товаров, по которому определяется ссылка на номенклатуру в 1С."
				+Символы.ПС+"Функция неактивна.";
				Сообщение.Сообщить();
		Иначе
			ЭтаФорма.ПараметрыЗагрузкиНоменклатуры.Вставить("ИмяРеквизитаОбъектаХраненияДляОпределенияТовара", ОбъектХраненияXDTO.ИмяРеквизитаОбъектаХраненияДляОпределенияТовара);	
		КонецЕсли;
		
		// Проверяем заполнение параметра "ИмяРеквизитаОбъектаХраненияДляОпределенияПоставщикаТовара".
		// Он нужен для понимания, в каком реквизите объекта хранения результатов сопоставления лежит ссылка на его владельца (Контрагента или Партнера).
		// Наличие реквизита предполагается обязательным. Если его нет, не используйте объект хранения результатов сопоставления.  
		Если ОбъектХраненияXDTO.Свойства().Получить("ИмяРеквизитаОбъектаХраненияДляОпределенияТовара") = Неопределено Тогда
			ОбъектПризнакаИспользованияХраненияРезультатовПоискаОпределен = Ложь;
			Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Не удалось определить реквизит объекта хранения сопоставления товаров, по которому определяется ссылка поставщика товара по документу в 1С."
				+Символы.ПС+"Функция неактивна.";
				Сообщение.Сообщить();
		Иначе
			ЭтаФорма.ПараметрыЗагрузкиНоменклатуры.Вставить("ИмяРеквизитаОбъектаХраненияДляОпределенияПоставщикаТовара", ОбъектХраненияXDTO.ИмяРеквизитаОбъектаХраненияДляОпределенияПоставщикаТовара);	
		КонецЕсли;
		
	КонецЕсли;
	
	#КонецОбласти
	
	#Область РеквизитыИЭлементыФормы
	
	Если ТаблицаСопоставленияНоменклатуры.Количество() = 0 Тогда
		
		РеквизитПоставщикаПоДокументуОпределен = Ложь;
		РеквизитСсылкиНаНоменклатуруОпределен = Ложь;
		РеквизитСсылкиНаХранениеРезультатовПоискаОпределен = Ложь;
		ХарактеристикиСуществуютИИспользуются = ХарактеристикиСуществуютИИспользуются();
		
		Для Каждого РеквизитФормы из ЭтаФорма.ПолучитьРеквизиты("ТаблицаСопоставленияНоменклатуры") Цикл
			Если РеквизитФормы.Имя = "Номенклатура" Тогда
				РеквизитСсылкиНаНоменклатуруОпределен = Истина;
			ИначеЕсли РеквизитФормы.Имя = "СсылкаНаХранениеРезультатовПоиска" Тогда	
				РеквизитСсылкиНаХранениеРезультатовПоискаОпределен = Истина;
			ИначеЕсли РеквизитФормы.Имя = "ПоставщикПоДокументу" Тогда
				РеквизитПоставщикаПоДокументуОпределен = Истина;
			КонецЕсли;	
		КонецЦикла;	
		
		// Создание и фиксирование необходимых реквизитов.
		Если НЕ РеквизитПоставщикаПоДокументуОпределен Тогда
			МассивРеквизитов.Добавить(Новый РеквизитФормы("ПоставщикПоДокументу", Новый ОписаниеТипов(XDTOСтруктураНастройкаРаботыСНоменклатурой.ОбщиеПараметрыСопоставления.ПоставщикТовара.ТипЗначения), 
			"ТаблицаСопоставленияНоменклатуры", "Поставщик по документу"));
			РеквизитПоставщикаПоДокументуОпределен = Истина;
		КонецЕсли;
		
		Если НЕ XDTOСтруктураНастройкаРаботыСНоменклатурой.ОбщиеПараметрыСопоставления.Свойства().Получить("ПартнерПоПоставщикуТовара") = Неопределено Тогда
			МассивРеквизитов.Добавить(Новый РеквизитФормы("ПартнерПоПоставщикуТовара", Новый ОписаниеТипов(XDTOСтруктураНастройкаРаботыСНоменклатурой.ОбщиеПараметрыСопоставления.ПартнерПоПоставщикуТовара.ТипЗначения), 
			"ТаблицаСопоставленияНоменклатуры", "Партнер поставщика по документу"));
			РеквизитПоставщикаПоДокументуОпределен = Истина;	
		КонецЕсли;
		
		Если СправочникНоменклатурыОпределен И НЕ РеквизитСсылкиНаНоменклатуруОпределен Тогда 
			МассивРеквизитов.Добавить(Новый РеквизитФормы("Номенклатура", Новый ОписаниеТипов(XDTOСтруктураНастройкаРаботыСНоменклатурой.ОбъектПоиска.ТипЗначения), 
			"ТаблицаСопоставленияНоменклатуры", "Ссылка на товар в БД"));
		КонецЕсли;
		
		Если СправочникНоменклатурыОпределен И НЕ РеквизитСсылкиНаХранениеРезультатовПоискаОпределен Тогда
		//Если СправочникНоменклатурыОпределен И ИспользованияХранениеРезультатовСопоставленияВИБ И НЕ РеквизитСсылкиНаХранениеРезультатовПоискаОпределен Тогда 
			ТипыСсылкиНаХранениеРезультатовПоиска = Новый Массив;
			ТипыСсылкиНаХранениеРезультатовПоиска.Добавить(Тип(ОбъектХраненияXDTO.ТипЗначения));
			ТипыСсылкиНаХранениеРезультатовПоиска.Добавить(Тип("Строка"));
			МассивРеквизитов.Добавить(Новый РеквизитФормы("СсылкаНаХранениеРезультатовПоиска", 
			Новый ОписаниеТипов(ТипыСсылкиНаХранениеРезультатовПоиска), 
			"ТаблицаСопоставленияНоменклатуры", 
			Метаданные[ОбъектХраненияXDTO.ТипОбъектаМетаданных].Найти(ОбъектХраненияXDTO.ИмяОбъектаМетаданных).ПредставлениеОбъекта));
		КонецЕсли;
		
		Если ХарактеристикиСуществуютИИспользуются Тогда
			МассивРеквизитов.Добавить(Новый РеквизитФормы("ХарактеристикаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"),
				"ТаблицаСопоставленияНоменклатуры", "Характеристика"));	
		КонецЕсли;	
			
		ИзменитьРеквизиты(МассивРеквизитов);
		
		// Создание элементов форм под реквизиты.
		Если РеквизитПоставщикаПоДокументуОпределен И ЭтаФорма.Элементы.Найти("ТаблицаСопоставленияНоменклатурыПоставщикПоДокументу") = Неопределено Тогда 
			НовыйЭлемент = Элементы.Добавить("ТаблицаСопоставленияНоменклатурыПоставщикПоДокументу", Тип("ПолеФормы"), Элементы.ТаблицаСопоставленияНоменклатуры);       
			НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
			НовыйЭлемент.ПутьКДанным = "ТаблицаСопоставленияНоменклатуры.ПоставщикПоДокументу";
			НовыйЭлемент.ТолькоПросмотр = Истина;
		КонецЕсли;	
		
		Если СправочникНоменклатурыОпределен И ЭтаФорма.Элементы.Найти("ТаблицаСопоставленияНоменклатурыНоменклатура") = Неопределено Тогда 
			НовыйЭлемент = Элементы.Добавить("ТаблицаСопоставленияНоменклатурыНоменклатура", Тип("ПолеФормы"), Элементы.ТаблицаСопоставленияНоменклатуры);       
			НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
			НовыйЭлемент.ПутьКДанным = "ТаблицаСопоставленияНоменклатуры.Номенклатура";
			НовыйЭлемент.УстановитьДействие("НачалоВыбора", "ПередВыборомСсылкиНаНоменклатуру");
			НовыйЭлемент.УстановитьДействие("ПриИзменении", "ПриИзмененииСсылкиНаНоменклатуру");
			НовыйЭлемент.КнопкаВыпадающегоСписка = Ложь;
			НовыйЭлемент.КнопкаСоздания = Ложь;
			НовыйЭлемент.РежимВыбораИзСписка = Ложь;
			НовыйЭлемент.ОтображениеКнопкиВыбора = ОтображениеКнопкиВыбора.ОтображатьВПолеВвода;
			НовыйЭлемент.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
			НовыйЭлемент.РедактированиеТекста = Ложь;
		КонецЕсли;
		
		Если ХарактеристикиСуществуютИИспользуются Тогда
			НовыйЭлемент = Элементы.Добавить("ТаблицаСопоставленияНоменклатурыХарактеристика", Тип("ПолеФормы"), Элементы.ТаблицаСопоставленияНоменклатуры);       
			НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
			НовыйЭлемент.ПутьКДанным = "ТаблицаСопоставленияНоменклатуры.ХарактеристикаНоменклатуры";
			НовыйЭлемент.ОтображениеКнопкиВыбора = ОтображениеКнопкиВыбора.ОтображатьВПолеВвода;
			НовыйЭлемент.КнопкаВыпадающегоСписка = Ложь;
			НовыйЭлемент.РежимВыбораИзСписка = Ложь;
			НовыйЭлемент.РедактированиеТекста = Ложь;
			НовыйЭлемент.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
			НовыйЭлемент.УстановитьДействие("НачалоВыбора", "ПередВыборомСсылкиНаХарактеристику");
		КонецЕсли;
		
		Если СправочникНоменклатурыОпределен И ЭтаФорма.Элементы.Найти("ТаблицаСопоставленияНоменклатурыСсылкаНаХранениеРезультатовПоиска") = Неопределено Тогда 
			НовыйЭлемент = Элементы.Добавить("ТаблицаСопоставленияНоменклатурыСсылкаНаХранениеРезультатовПоиска", Тип("ПолеФормы"), Элементы.ТаблицаСопоставленияНоменклатуры);       
			НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
			НовыйЭлемент.ПутьКДанным = "ТаблицаСопоставленияНоменклатуры.СсылкаНаХранениеРезультатовПоиска";
			НовыйЭлемент.УстановитьДействие("НачалоВыбора", "ПередВыборомСсылкиНаХранениеРезультатовПоиска");
			Если НЕ ИспользованияХранениеРезультатовСопоставленияВИБ Тогда
				НовыйЭлемент.Видимость = Ложь;	
			КонецЕсли;	
		КонецЕсли;
		
		Если ИспользованияХранениеРезультатовСопоставленияВИБ Тогда
			Элементы.СохранитьТаблицуТоваров.Доступность = Ложь;
			Элементы.ЗагрузитьИзПамятиТаблицуТоваров.Доступность = Ложь;
			Элементы.ТекстОписаниеХраненияРезультатовВИБ.Видимость = Истина;
			Элементы.ТекстОписаниеХраненияРезультатовВИБ.Заголовок = "Результаты выбора будут храниться в"+Символы.ПС+
																		"объекте """+ОбъектХраненияXDTO.ТипОбъектаМетаданных+""""+Символы.ПС+
																		"с именем """+Метаданные[ОбъектХраненияXDTO.ТипОбъектаМетаданных].Найти(ОбъектХраненияXDTO.ИмяОбъектаМетаданных).Синоним+""".";
			Элементы.ТаблицаСопоставленияНоменклатурыНоменклатура.ТолькоПросмотр = Истина;
			Элементы.ТаблицаСопоставленияНоменклатурыСсылкаНаХранениеРезультатовПоиска.ТолькоПросмотр = Ложь;
			Если ХарактеристикиСуществуютИИспользуются Тогда
				Элементы.ТаблицаСопоставленияНоменклатурыХарактеристика.ТолькоПросмотр = Истина;
			КонецЕсли;	
			//Элементы.ТаблицаСопоставленияНоменклатурыНоменклатура.ТолькоПросмотр = Истина;
		Иначе
			Элементы.СохранитьТаблицуТоваров.Доступность = Истина;
			Элементы.ЗагрузитьИзПамятиТаблицуТоваров.Доступность = Истина;
			Элементы.ТекстОписаниеХраненияРезультатовВИБ.Видимость = Ложь;
			Элементы.ТекстОписаниеХраненияРезультатовВИБ.Заголовок = "";
			Элементы.ТаблицаСопоставленияНоменклатурыНоменклатура.ТолькоПросмотр = Ложь;
			Если НЕ ЭтаФорма.Элементы.Найти("ТаблицаСопоставленияНоменклатурыСсылкаНаХранениеРезультатовПоиска") = Неопределено Тогда
				Элементы.ТаблицаСопоставленияНоменклатурыСсылкаНаХранениеРезультатовПоиска.ТолькоПросмотр = Истина;
			КонецЕсли;
			Если ХарактеристикиСуществуютИИспользуются Тогда
				Элементы.ТаблицаСопоставленияНоменклатурыХарактеристика.ТолькоПросмотр = Ложь;
			КонецЕсли;
			//Элементы.ТаблицаСопоставленияНоменклатурыНоменклатура.ТолькоПросмотр = Ложь;
			
		КонецЕсли;	
			
	КонецЕсли;
	
	#КонецОбласти
	
	#Область ЧтениеДанныхСтрок
	
	// Чтение данных документа.
	СоздатьФайлЗагружаемогоДокументаНаСервере(ФайлДокументаДвоичныеДанные);
	ЧтениеXML = Новый ЧтениеXML();
	ЧтениеXML.ОткрытьФайл(ПутьКВременномуФайлуДокументаНаСервере);
	Фабрика = Кэш.ФорматыОбъект[ЗагружаемыйФормат];
	XDTOСтруктураДанные = Фабрика.ПрочитатьXML(ЧтениеXML);	
	
	ТаблицаСопоставленияНоменклатуры.Очистить();
	
	// Вычисляем общие параметры сопоставления.
	ОбщиеПараметрыСопоставления = Новый Структура;
	Для Каждого XDTOПараметрСвойство из XDTOСтруктураНастройкаРаботыСНоменклатурой.ОбщиеПараметрыСопоставления.Свойства() Цикл
		Если XDTOПараметрСвойство.Форма = ФормаXML.Атрибут Тогда
			Продолжить;
		КонецЕсли;	
		XDTOПараметрСопоставления = XDTOСтруктураНастройкаРаботыСНоменклатурой.ОбщиеПараметрыСопоставления[XDTOПараметрСвойство.Имя];
		МетодРасчетаЗначения = XDTOПараметрСопоставления.Источник.МетодРасчетаЗначения;
		ЗначениеСопоставления = РассчитатьЗначениеРеквизитаПоМетодуРасчета(XDTOПараметрСопоставления, МетодРасчетаЗначения, XDTOСтруктураДанные, ОбщиеПараметрыСопоставления);
		ОбщиеПараметрыСопоставления.Вставить(XDTOПараметрСвойство.Имя, ЗначениеСопоставления);
	КонецЦикла;	
		
	// Читаем данные по каждой строке документа.
	Если ТипЗнч(XDTOСтруктураДанные.Документ.ТаблСчФакт.СведТов) = Тип("СписокXDTO") Тогда 
		
		#Область ЕслиМногоСтрок
		
		Для Каждого Строка из XDTOСтруктураДанные.Документ.ТаблСчФакт.СведТов Цикл
			
			РезультатовСопоставленияЗначение = Неопределено;
			НоменклатураРезультатаСопоставления = Неопределено;
			
			НоваяСтрокаСопоставления = ТаблицаСопоставленияНоменклатуры.Добавить();
			
			НоваяСтрокаСопоставления.ПоставщикПоДокументу = ОбщиеПараметрыСопоставления.ПоставщикТовара;
			Если ОбщиеПараметрыСопоставления.Свойство("ПартнерПоПоставщикуТовара") Тогда
				НоваяСтрокаСопоставления.ПартнерПоПоставщикуТовара = ОбщиеПараметрыСопоставления.ПартнерПоПоставщикуТовара;
			КонецЕсли;	
			НоваяСтрокаСопоставления.НаименованиеИзДокумента = СокрЛП(Строка.НаимТов);
			Если НЕ Строка.Свойства().Получить("ДопСведТов") = Неопределено Тогда
				Если НЕ Строка.ДопСведТов.Свойства().Получить("КодТов") = Неопределено Тогда 
					НоваяСтрокаСопоставления.КодТовараИзДокумента =  Строка.ДопСведТов.КодТов;
				КонецЕсли;
				Если НЕ Строка.ДопСведТов.Свойства().Получить("АртикулТов") = Неопределено Тогда
					НоваяСтрокаСопоставления.АртикулТовараИзДокумента = Строка.ДопСведТов.АртикулТов;
				КонецЕсли;
			КонецЕсли;
			
			// Ищем соответствия в хранящихся результатах.
			Если ИспользованияХранениеРезультатовСопоставленияВИБ Тогда
				
				МетодРасчетаЗначения = ОбъектХраненияXDTO.Источник.МетодРасчетаЗначения;
				РезультатовСопоставленияЗначение = РассчитатьЗначениеРеквизитаПоМетодуРасчета(ОбъектХраненияXDTO, МетодРасчетаЗначения, Строка, ОбщиеПараметрыСопоставления, , Ложь);
				Если НЕ РезультатовСопоставленияЗначение = Неопределено Тогда
					Если ОбъектХраненияXDTO.ИмяРеквизитаОбъектаХраненияДляОпределенияТовара = "" Тогда
						НоменклатураРезультатаСопоставления = РезультатовСопоставленияЗначение;
					Иначе	
						НоменклатураРезультатаСопоставления = РезультатовСопоставленияЗначение[ОбъектХраненияXDTO.ИмяРеквизитаОбъектаХраненияДляОпределенияТовара];
					КонецЕсли;
					Если ХарактеристикиСуществуютИИспользуются() Тогда
						ХарактеристикаРезультатаСопоставления = РезультатовСопоставленияЗначение.Характеристика;
					КонецЕсли;	
				КонецЕсли;	
				
				Если НЕ РезультатовСопоставленияЗначение = Неопределено Тогда
					НоваяСтрокаСопоставления.СсылкаНаХранениеРезультатовПоиска = РезультатовСопоставленияЗначение;
					Если ХарактеристикиСуществуютИИспользуются() Тогда
						НоваяСтрокаСопоставления.ХарактеристикаНоменклатуры = ХарактеристикаРезультатаСопоставления;
					КонецЕсли;
				Иначе
					НоваяСтрокаСопоставления.СсылкаНаХранениеРезультатовПоиска = "Щелкните, чтобы создать";
				КонецЕсли;
				
				Если НЕ НоменклатураРезультатаСопоставления = Неопределено Тогда
					НоваяСтрокаСопоставления.Номенклатура = НоменклатураРезультатаСопоставления;
				КонецЕсли;	
				
			КонецЕсли;		
			
		КонецЦикла;
		
		#КонецОбласти
		
	Иначе
		
		#Область ЕслиОднаСтрока
		
		Строка = XDTOСтруктураДанные.Документ.ТаблСчФакт.СведТов;
		
		РезультатовСопоставленияЗначение = Неопределено;
		НоменклатураРезультатаСопоставления = Неопределено;
		
		НоваяСтрокаСопоставления = ТаблицаСопоставленияНоменклатуры.Добавить();
		
		НоваяСтрокаСопоставления.ПоставщикПоДокументу = ОбщиеПараметрыСопоставления.ПоставщикТовара;
		Если ОбщиеПараметрыСопоставления.Свойство("ПартнерПоПоставщикуТовара") Тогда
			НоваяСтрокаСопоставления.ПартнерПоПоставщикуТовара = ОбщиеПараметрыСопоставления.ПартнерПоПоставщикуТовара;
		КонецЕсли;	
		НоваяСтрокаСопоставления.НаименованиеИзДокумента = СокрЛП(Строка.НаимТов);
		Если НЕ Строка.Свойства().Получить("ДопСведТов") = Неопределено Тогда
			Если НЕ Строка.ДопСведТов.Свойства().Получить("КодТов") = Неопределено Тогда 
				НоваяСтрокаСопоставления.КодТовараИзДокумента =  Строка.ДопСведТов.КодТов;
			КонецЕсли;
			Если НЕ Строка.ДопСведТов.Свойства().Получить("АртикулТов") = Неопределено Тогда
				НоваяСтрокаСопоставления.АртикулТовараИзДокумента = Строка.ДопСведТов.АртикулТов;
			КонецЕсли;
		КонецЕсли;
		
		// Ищем соответствия в хранящихся результатах.
		Если ИспользованияХранениеРезультатовСопоставленияВИБ Тогда
			
			МетодРасчетаЗначения = ОбъектХраненияXDTO.Источник.МетодРасчетаЗначения;
			РезультатовСопоставленияЗначение = РассчитатьЗначениеРеквизитаПоМетодуРасчета(ОбъектХраненияXDTO, МетодРасчетаЗначения, Строка, ОбщиеПараметрыСопоставления, , Ложь);
			Если НЕ РезультатовСопоставленияЗначение = Неопределено Тогда
				Если ОбъектХраненияXDTO.ИмяРеквизитаОбъектаХраненияДляОпределенияТовара = "" Тогда
					НоменклатураРезультатаСопоставления = РезультатовСопоставленияЗначение;
				Иначе	
					НоменклатураРезультатаСопоставления = РезультатовСопоставленияЗначение[ОбъектХраненияXDTO.ИмяРеквизитаОбъектаХраненияДляОпределенияТовара];
				КонецЕсли;
				Если ХарактеристикиСуществуютИИспользуются Тогда
					ХарактеристикаРезультатаСопоставления = РезультатовСопоставленияЗначение.Характеристика;
				КонецЕсли;	
			КонецЕсли;
			
			Если НЕ РезультатовСопоставленияЗначение = Неопределено Тогда
				НоваяСтрокаСопоставления.СсылкаНаХранениеРезультатовПоиска = РезультатовСопоставленияЗначение;
				Если ХарактеристикиСуществуютИИспользуются() Тогда
					НоваяСтрокаСопоставления.ХарактеристикаНоменклатуры = ХарактеристикаРезультатаСопоставления;
				КонецЕсли;
			Иначе
				НоваяСтрокаСопоставления.СсылкаНаХранениеРезультатовПоиска = "Щелкните, чтобы создать";
			КонецЕсли;
			
			Если НЕ НоменклатураРезультатаСопоставления = Неопределено Тогда
				НоваяСтрокаСопоставления.Номенклатура = НоменклатураРезультатаСопоставления;
			КонецЕсли;	
			
		КонецЕсли;	
		
		#КонецОбласти
		
	КонецЕсли;
	
	#КонецОбласти
	
КонецПроцедуры
	
#КонецОбласти

#Область РаботаСМарками

&НаСервереБезКонтекста
Процедура ОбработатьИЗаполнитьИнформациюПоМаркам(ОбъектПриемник, XDTOСтруктураДанные, ФорматДокумента)

	Если НЕ ЗначениеЗаполнено(ФорматДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Если Метаданные.Константы.Найти("ВестиУчетОбувнойПродукцииИСМП") = Неопределено И Метаданные.Константы.Найти("ВестиУчетТабачнойПродукцииМОТП") = Неопределено 
		И Метаданные.Константы.Найти("ВестиУчетМаркируемойПродукцииИСМП") = Неопределено И Метаданные.Константы.Найти("ВестиУчетМаркировкиПродукцииВГИСМ") = Неопределено Тогда
		// Учет по маркам не поддерживается.
		Возврат;
	КонецЕсли;

	// УПД статуса 1 и статуса 2.
	Если ФорматДокумента = "ON_NSCHFDOPPR" Тогда
		
		СтрокиТоваров = XDTOСтруктураДанные.Документ.ТаблСчФакт.СведТов;
		
		Если ТипЗнч(СтрокиТоваров) = Тип("СписокXDTO") Тогда
			
			Для Каждого СтрокаТовара из XDTOСтруктураДанные.Документ.ТаблСчФакт.СведТов Цикл
				ОбработатьМаркиСтроки(ОбъектПриемник, СтрокаТовара);	
			КонецЦикла;	
			
		ИначеЕсли ТипЗнч(СтрокиТоваров) = Тип("ОбъектXDTO") Тогда
			
			СтрокаТовара = XDTOСтруктураДанные.Документ.ТаблСчФакт.СведТов;			
			ОбработатьМаркиСтроки(ОбъектПриемник, СтрокаТовара);	
			
		КонецЕсли;	
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбработатьМаркиСтроки(ОбъектПриемник, XDTOСтруктураДанныеСтрокиТоваров)
	
	Если XDTOСтруктураДанныеСтрокиТоваров.Свойства().Получить("ДопСведТов") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// ГТИН
	Если НЕ XDTOСтруктураДанныеСтрокиТоваров.ДопСведТов.Свойства().Получить("ГТИН") = Неопределено Тогда	
		Если НЕ СокрЛП(XDTOСтруктураДанныеСтрокиТоваров.ДопСведТов.ГТИН) = "" Тогда 
			ДобавитьШтриход(ОбъектПриемник, "02"+XDTOСтруктураДанныеСтрокиТоваров.ДопСведТов.ГТИН+"37"+XDTOСтруктураДанныеСтрокиТоваров.КолТов);
			Возврат;
		КонецЕсли;  	
	КонецЕсли;
	
	Если XDTOСтруктураДанныеСтрокиТоваров.ДопСведТов.Свойства().Получить("НомСредИдентТов") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеИдентификацииТоваров = XDTOСтруктураДанныеСтрокиТоваров.ДопСведТов.НомСредИдентТов;
	
	Если ТипЗнч(ДанныеИдентификацииТоваров) = Тип("СписокXDTO") Тогда
		
		Для Каждого ЭлементДанныхИдентификацииТоваров из XDTOСтруктураДанныеСтрокиТоваров.ДопСведТов.НомСредИдентТов Цикл
			ОбработатьЭлементДанныхИдентификацииТоваров(ОбъектПриемник, ЭлементДанныхИдентификацииТоваров);
		КонецЦикла; 
		
	ИначеЕсли ТипЗнч(ДанныеИдентификацииТоваров) = Тип("ОбъектXDTO") Тогда
		
		ЭлементДанныхИдентификацииТоваров = XDTOСтруктураДанныеСтрокиТоваров.ДопСведТов.НомСредИдентТов;
		ОбработатьЭлементДанныхИдентификацииТоваров(ОбъектПриемник, ЭлементДанныхИдентификацииТоваров);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбработатьЭлементДанныхИдентификацииТоваров(ОбъектПриемник, XDTOСтруктураДанныеИдентификацииТоваров)
	
	// Уникальный идентификатор всей транспортной упаковки.
	Если НЕ XDTOСтруктураДанныеИдентификацииТоваров.Свойства().Получить("ИдентТрансУпак") = Неопределено Тогда
		
		Если НЕ СокрЛП(XDTOСтруктураДанныеИдентификацииТоваров.ИдентТрансУпак) = "" Тогда
			ДобавитьШтриход(ОбъектПриемник, XDTOСтруктураДанныеИдентификацииТоваров.ИдентТрансУпак);
			Возврат;
		КонецЕсли;	
		
	КонецЕсли;
	
	// Контрольные идентификационные знаки товаров.
	Если НЕ XDTOСтруктураДанныеИдентификацииТоваров.Свойства().Получить("КИЗ") = Неопределено Тогда
		
		Если ТипЗнч(XDTOСтруктураДанныеИдентификацииТоваров.КИЗ) = Тип("СписокXDTO") Тогда
		
			Для Каждого КИЗТовара из XDTOСтруктураДанныеИдентификацииТоваров.КИЗ Цикл
				Если НЕ СокрЛП(КИЗТовара) = "" Тогда
					ДобавитьШтриход(ОбъектПриемник, КИЗТовара)
				КонецЕсли;	
			КонецЦикла; 
		
		ИначеЕсли ТипЗнч(XDTOСтруктураДанныеИдентификацииТоваров.КИЗ) = Тип("Строка") И НЕ СокрЛП(XDTOСтруктураДанныеИдентификацииТоваров.КИЗ) = "" Тогда
		
			ДобавитьШтриход(ОбъектПриемник, XDTOСтруктураДанныеИдентификацииТоваров.КИЗ);
		
		КонецЕсли; 
		
		Возврат;
		
	КонецЕсли;
	
	// Уникальные идентификаторы вторичной (потребительской)/третичной (заводской, транспортной) упаковки.
	Если НЕ XDTOСтруктураДанныеИдентификацииТоваров.Свойства().Получить("НомУпак") = Неопределено Тогда
		
		Если ТипЗнч(XDTOСтруктураДанныеИдентификацииТоваров.НомУпак) = Тип("СписокXDTO") Тогда
		
			Для Каждого НомУпакТовара из XDTOСтруктураДанныеИдентификацииТоваров.НомУпак Цикл
				Если НЕ СокрЛП(НомУпакТовара) = "" Тогда
					ДобавитьШтриход(ОбъектПриемник, НомУпакТовара)
				КонецЕсли;	
			КонецЦикла; 
		
		ИначеЕсли ТипЗнч(XDTOСтруктураДанныеИдентификацииТоваров.НомУпак) = Тип("Строка") И НЕ СокрЛП(XDTOСтруктураДанныеИдентификацииТоваров.НомУпак) = "" Тогда
		
			ДобавитьШтриход(ОбъектПриемник, XDTOСтруктураДанныеИдентификацииТоваров.НомУпак);
		
		КонецЕсли; 
		
		Возврат;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьШтриход(ОбъектПриемник, Штрихкод)

	НоваяСтрокаШтрихкодов = ОбъектПриемник.ШтрихкодыУпаковок.Добавить();
	НоваяСтрокаШтрихкодов.ЗначениеШтрихкода = Штрихкод;
	
КонецПроцедуры	
	
#КонецОбласти
