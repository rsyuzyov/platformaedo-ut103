&НаСервере
Процедура СохранитьИзмененияНаСервере()
	
Если НЕ ЭтотОбъект.ЭтоМассовоеСоздание тогда
	Если ЭтотОбъект.ЭтоНовый тогда;
		Если НЕ НаименованиеУникально() тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Наименование уже используется.";
			Сообщение.Сообщить();
			Возврат
		КонецЕсли;	
	КонецЕсли;
	
	//Проверка заполненности 
	СтруктураДанных = ПолучитьСтруктуруДанныхФормы(); 
	//Если СтруктураДанных.Наименование = "" ИЛИ
	//	НЕ ЗначениеЗаполнено(СтруктураДанных.Организация) ИЛИ
	//	НЕ ЗначениеЗаполнено(СтруктураДанных.Контрагент) ИЛИ
	
	
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки",
	ЭтотОбъект.Наименование,
	СтруктураДанных,
	"Содержит шаблоны пакетов ЭД",
	ПолучитьТекущегоПользователя());
	ПроверитьИЗаполнитьСвязанныеРеквизиты();
	Если ЭтотОбъект.ЭтоНовый = Истина ИЛИ НаименованиеИзменено() = Истина тогда
		
		ВсеНастройки = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки",
		"СписокШаблоновПакетов",
		"Содержит список шаблонов пакетов ЭД",
		ПолучитьТекущегоПользователя());
		
		//Первое заполнение
		Если ТипЗнч(ВсеНастройки) = Неопределено тогда
			
			ИнициализироватьСписокШаблонов();
			
			ВсеНастройки = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки",
			"СписокШаблоновПакетов",
			"Содержит список шаблонов пакетов ЭД",
			ПолучитьТекущегоПользователя());
			
			
		КонецЕсли;
				
		НСтр = ВсеНастройки.Добавить(); 
		НСтр.Организация = ЭтотОбъект.Организация;
		НСтр.Контрагент = ЭтотОбъект.Контрагент;
		НСтр.Наименование = ЭтотОбъект.Наименование;
		
		ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки",
		"СписокШаблоновПакетов",
		ВсеНастройки,
		"Содержит шаблоны пакетов ЭД",
		ПолучитьТекущегоПользователя()); 
		
	КонецЕсли
Иначе
	
	ОбработатьМассовоеСозданиеШаблонов()
	
КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьМассовоеСозданиеШаблонов()

	ТаблицаОрганизаций = ЭтотОбъект.ВыбранныеОрганизации.Выгрузить();
	ТаблицаКонтрагентов = ЭтотОбъект.ВыбранныеКонтрагенты.Выгрузить();
	
	Для каждого Строка из ТаблицаКонтрагентов цикл
		Если НЕ ЗначениеЗаполнено(Строка.Контрагент) тогда
			ТаблицаКонтрагентов.Удалить(Строка);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого Строка из ТаблицаОрганизаций цикл
		 Если НЕ ЗначениеЗаполнено(Строка.Организация) тогда
			ТаблицаОрганизаций.Удалить(Строка);
		КонецЕсли;
	КонецЦикла;
	
	ВсеНастройки = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки",
	"СписокШаблоновПакетов",
	"Содержит список шаблонов пакетов ЭД",
	ПолучитьТекущегоПользователя());
	
	Если ТипЗнч(ВсеНастройки) = Неопределено тогда
		
		ИнициализироватьСписокШаблонов();
		
		ВсеНастройки = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки",
		"СписокШаблоновПакетов",
		"Содержит список шаблонов пакетов ЭД",
		ПолучитьТекущегоПользователя());
		
		
	КонецЕсли;
	
	ПроверитьИЗаполнитьСвязанныеРеквизиты();
	
	Для каждого СтрокаОрганизаций из ТаблицаОрганизаций цикл
		Для каждого СтрокаКонтрагентов из ТаблицаКонтрагентов цикл
			
			//Добавляем настройку в общий список
			НСтр = ВсеНастройки.Добавить();
			НСтр.Организация = СтрокаОрганизаций.Организация;
			НСтр.Контрагент = СтрокаКонтрагентов.Контрагент;
			НаименованиеНастройки = Строка(СтрокаКонтрагентов.Контрагент.Наименование) + "_" + 
			Строка(СтрокаОрганизаций.Организация.Наименование) + "_" + Строка(ВсеНастройки.Количество());
			НСтр.Наименование = НаименованиеНастройки;
			
			СтруктураНастройки = ПолучитьСтруктуруДанныхФормы();
			СтруктураНастройки.Наименование = НаименованиеНастройки;
			СтруктураНастройки.Контрагент = СтрокаКонтрагентов.Контрагент;
			
			//Записываем настройку в Хранилище
			ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки",
			НаименованиеНастройки,
			СтруктураНастройки,
			"Содержит шаблоны пакетов ЭД",
			ПолучитьТекущегоПользователя());
			
		КонецЦикла;
		
	КонецЦикла;
	
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки",
	"СписокШаблоновПакетов",
	ВсеНастройки,
	"Содержит шаблоны пакетов ЭД",
	ПолучитьТекущегоПользователя());
	
КонецПроцедуры

Функция НаименованиеУникально()
	
	Рез = Ложь;
	
	ВсеНастройки = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки",
	"СписокШаблоновПакетов",
	"Содержит список шаблонов пакетов ЭД",
	ПолучитьТекущегоПользователя()); 
	
	Если НЕ ТипЗнч(ВсеНастройки) = Тип("ТаблицаЗначений") тогда
		ИнициализироватьСписокШаблонов();
	КонецЕсли;
		
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Наименование", ЭтотОбъект.Наименование);
		
	НайденнаяНастройка = ВсеНастройки.НайтиСтроки(СтруктураПоиска); 
		
	Если ТипЗнч(НайденнаяНастройка) = Тип("Массив")  тогда 
		Если НайденнаяНастройка.Количество() = 0 тогда
		Рез = Истина;
		КонецЕсли
	Иначе
		Рез = Ложь;
	КонецЕсли;
	
	Возврат Рез
	
КонецФункции

Функция НаименованиеИзменено()
	Возврат Ложь;	
КонецФункции
	
Процедура ИнициализироватьСписокШаблонов()
		
	ВсеНастройки = Новый ТаблицаЗначений;
	ВсеНастройки.Колонки.Добавить("Организация");
	ВсеНастройки.Колонки.Добавить("Контрагент");
	ВсеНастройки.Колонки.Добавить("Наименование");
		
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки",
	"СписокШаблоновПакетов",
	ВсеНастройки,
	"Содержит шаблоны пакетов ЭД",
	ПолучитьТекущегоПользователя());
		
КонецПроцедуры
		
Функция ПолучитьСтруктуруДанныхФормы()
		
	Рез = Новый Структура;
		
	Рез.Вставить("Организация", ЭтотОбъект.Организация);
	Рез.Вставить("Контрагент",  ЭтотОбъект.Контрагент);
	
	Если НЕ ЭтотОбъект.ЭтоМассовоеСоздание = Истина тогда
		Рез.Вставить("Наименование", ЭтотОбъект.Наименование); 
	Иначе
		Рез.Вставить("Наименование", ); 
	КонецЕсли;
	
		Рез.Вставить("ТаблицаНастроекПоиска", ЭтотОбъект.ТаблицаТиповДокументов.Выгрузить());

	Возврат Рез
		
КонецФункции
	
&НаСервереБезКонтекста
Функция ПолучитьТекущегоПользователя()
	
	Возврат Неопределено;
	
	Если НЕ Метаданные.ОбщиеМодули.Найти("ПользователиИнформационнойБазы") = Неопределено Тогда
		ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Иначе
		ТекущийПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	КонецЕсли;	
	
	Возврат ТекущийПользователь;
	
КонецФункции

#КонецОбласти

&НаКлиенте
Процедура ТаблицаТиповДокументовТипСвязанногоДокументаПредставлениеПриИзменении(Элемент)
	
	Элементы.ТаблицаТиповДокументов.ТекущиеДанные.ТипСвязанногоДокумента = Элементы.ТаблицаТиповДокументов.ТекущиеДанные.ТипСвязанногоДокументаПредставление;
	ПФЗначение = Элементы.ТаблицаТиповДокументов.ТекущиеДанные.ТипСвязанногоДокумента;
    ЭлементСписка = Элементы.ТаблицаТиповДокументовТипСвязанногоДокументаПредставление.СписокВыбора.НайтиПоЗначению(ПФЗначение);
	Элементы.ТаблицаТиповДокументов.ТекущиеДанные.ТипСвязанногоДокументаПредставление = ЭлементСписка.Представление;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТиповДокументовПечатнаяФормаПредставлениеПриИзменении(Элемент)
	
	Элементы.ТаблицаТиповДокументов.ТекущиеДанные.ПечатнаяФорма = Элементы.ТаблицаТиповДокументов.ТекущиеДанные.ПечатнаяФормаПредставление;
	ПФЗначение = Элементы.ТаблицаТиповДокументов.ТекущиеДанные.ПечатнаяФорма;
    ЭлементСписка = Элементы.ТаблицаТиповДокументовПечатнаяФормаПредставление.СписокВыбора.НайтиПоЗначению(ПФЗначение);
	Элементы.ТаблицаТиповДокументов.ТекущиеДанные.ПечатнаяФормаПредставление = ЭлементСписка.Представление;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТиповДокументовПечатнаяФормаПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ПроверитьИЗаполнитьСвязанныеРеквизиты();
	
	КомандыПечати = ПолучитьКомандыПечатиБезКонтекста(Элементы.ТаблицаТиповДокументов.ТекущиеДанные.ТипСвязанногоДокумента);
	
	Элементы.ТаблицаТиповДокументовПечатнаяФормаПредставление.СписокВыбора.Очистить();
	
	Для каждого Строка из КомандыПечати цикл
		Элементы.ТаблицаТиповДокументовПечатнаяФормаПредставление.СписокВыбора.Добавить(Строка.УникальныйИдентификатор, Строка.Представление);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьИЗаполнитьСвязанныеРеквизиты()
	
	Для каждого Строка из ТаблицаТиповДокументов цикл
		Если Строка.ТипСвязанногоДокумента = "" И Строка.ТипСвязанногоДокументаПредставление <> "" тогда
			
			Строка.ТипСвязанногоДокумента = Строка.ТипСвязанногоДокументаПредставление;
			
		КонецЕсли;
		
		Если Строка.ПечатнаяФорма = "" И Строка.ПечатнаяФормаПредставление <> 0 тогда
			
			Строка.ПечатнаяФорма = Строка.ПечатнаяФормаПредставление;
			
		КонецЕсли;
		
		Если Строка.ТипДокумента = "" И Строка.ТипДокументаПредставление <> "" тогда

	        Строка.ТипСвязанногоДокумента = Строка.ТипСвязанногоДокументаПредставление;
			
		КонецЕсли;
		
		Если СтрНайти(Строка.ТипСвязанногоДокумента, " ") <> 0 тогда 
			
			КешЗначения = Строка.ТипСвязанногоДокумента;
			Строка.ТипСвязанногоДокумента = Строка.ТипСвязанногоДокументаПредставление;
			Строка.ТипСвязанногоДокументаПредставление = КешЗначения;
			
		КонецЕслИ;
		
		Если СтрНайти(Строка.ТипДокумента, " ") <> 0 тогда
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКомандыПечатиБезКонтекста(ОбъектМетаданных)
	
	Рез = Новый Массив;
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип(ОбъектМетаданных));
	
	мДанные = Новый Массив;	
	мДанные.Добавить(ОбъектМетаданных);
	
	ОбъектМетаданных = "";
	
	НайденныеКомандыПечати = УправлениеПечатью.КомандыПечатиФормы("ФормаЭлемента", мДанные);		
	
	НайденныеКомандыПечати.Свернуть("Идентификатор,Представление,УникальныйИдентификатор");
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(НайденныеКомандыПечати);

КонецФункции

&НаКлиенте
Процедура ТаблицаТиповДокументовФорматДокументаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Форматы = ПолучитьРазрешенныеФорматы(Элементы.ТаблицаТиповДокументов.ТекущиеДанные.ТипДокумента);
	Элементы.ТаблицаТиповДокументовФорматДокумента.СписокВыбора.Очистить();	
		
	Для каждого Строка из Форматы цикл
		
		Элементы.ТаблицаТиповДокументовФорматДокумента.СписокВыбора.Добавить(Строка.Значение, Строка.Представление);
		
	КонецЦикла;
	
КонецПроцедуры 

Функция ПолучитьРазрешенныеФорматы(ТипДокумента)
	
	Кэш = ЗагрузитьКэш();
	
	СписокФорматов = Кэш.ДоступныеФорматы.Получить(СтрЗаменить(ТипДокумента, "ДокументСсылка.", ""));
	
	Возврат СписокФорматов;
	
КонецФункции

&НаСервере
Функция ИННКППОрганизации(ВыбОрганизация)

	ИНН = ВыбОрганизация.ИНН;
	КПП = ВыбОрганизация.КПП;
	
	Структура = Новый Структура;
	Структура.Вставить("ИНН", ИНН);
	Структура.Вставить("КПП", КПП);
	
 	Возврат Структура 		

КонецФункции  

 &НаСервере
Функция ИННКППКонтрагента(ВыбКонтрагент)

	ИНН = ВыбКонтрагент.ИНН;
	КПП = ВыбКонтрагент.КПП;
	
	Структура = Новый Структура;
	Структура.Вставить("ИНН", ИНН);
	Структура.Вставить("КПП", КПП);
	
 	Возврат Структура 		

КонецФункции  


#КонецОбласти

#Область ОбработчикиМассовогоСоздания

&НаКлиенте
Процедура ВыбранныеОрганизацииОрганизацияПриИзменении(Элемент)
	
	ВыбОрганизация = Элементы.ВыбранныеОрганизации.ТекущиеДанные.Организация;
	СтруктураДанных = ИННКППОрганизации(ВыбОрганизация);
	
	Элементы.ВыбранныеОрганизации.ТекущиеДанные.ИНН = СтруктураДанных.ИНН;
	Элементы.ВыбранныеОрганизации.ТекущиеДанные.КПП = СтруктураДанных.КПП;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныеКонтрагентыКонтрагентПриИзменении(Элемент)   
	
	ВыбКонтрагент = Элементы.ВыбранныеКонтрагенты.ТекущиеДанные.Контрагент;
	СтруктураДанных = ИННКППКонтрагента(ВыбКонтрагент);
	
	Элементы.ВыбранныеКонтрагенты.ТекущиеДанные.ИНН = СтруктураДанных.ИНН;
	Элементы.ВыбранныеКонтрагенты.ТекущиеДанные.КПП = СтруктураДанных.КПП; 
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТиповДокументовМассовоеСозданиеПечатнаяФормаПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	КомандыПечати = ПолучитьКомандыПечатиБезКонтекста(Элементы.ТаблицаТиповДокументовМассовоеСоздание.ТекущиеДанные.ТипСвязанногоДокумента);
	
	Элементы.ТаблицаТиповДокументовМассовоеСозданиеПечатнаяФормаПредставление.СписокВыбора.Очистить();
	
	Для каждого Строка из КомандыПечати цикл
		Элементы.ТаблицаТиповДокументовМассовоеСозданиеПечатнаяФормаПредставление.СписокВыбора.Добавить(Строка.УникальныйИдентификатор, Строка.Представление);
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТиповДокументовМассовоеСозданиеТипСвязанногоДокументаПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	 ПараметрыПоиска = Новый Структура;
	 ПараметрыПоиска.Вставить("ДокРодитель", ЭтаФорма.Элементы.ТаблицаТиповДокументовМассовоеСоздание.ТекущиеДанные.ТипДокумента);
	
	 МассивТипов = ПолучитьМассивРазрешенныхТипов(ПараметрыПоиска, Истина);
	 
	 ЭтаФорма.Элементы.ТаблицаТиповДокументовМассовоеСозданиеТипСвязанногоДокументаПредставление.СписокВыбора.Очистить();
	 
	 Для каждого Тип из МассивТипов цикл
		 
		 ЭтаФорма.Элементы.ТаблицаТиповДокументовМассовоеСозданиеТипСвязанногоДокументаПредставление.СписокВыбора.Добавить(Тип.Значение, Тип.Представление);		 
		 
	 КонецЦикла;
	 
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТиповДокументовМассовоеСозданиеФорматДокументаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Форматы = ПолучитьРазрешенныеФорматы(Элементы.ТаблицаТиповДокументовМассовоеСоздание.ТекущиеДанные.ТипДокумента);
	Элементы.ТаблицаТиповДокументовМассовоеСозданиеФорматДокумента.СписокВыбора.Очистить();	
		
