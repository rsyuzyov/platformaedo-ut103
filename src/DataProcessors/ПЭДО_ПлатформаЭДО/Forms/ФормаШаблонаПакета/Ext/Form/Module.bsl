&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Организация") тогда	
		ЭтотОбъект.Организация = Параметры.Организация;
	КонецЕсли;
	
	Если Параметры.Свойство("Контрагент") тогда	
		ЭтотОбъект.Контрагент = Параметры.Контрагент;
	КонецЕсли;
   
	Если Параметры.Свойство("ЭтоНовый") тогда
		ЭтотОбъект.ЭтоНовый = Параметры.ЭтоНовый;
	КонецЕсли;
	
	Если Параметры.Свойство("ЭтоМассовоеСоздание") тогда
		ЭтаФорма.Элементы.ГруппаОсновноеОкно.Видимость = Ложь;
		ЭтаФорма.Элементы.ГруппаМассовоеСоздание.Видимость = Истина;
		ЭтотОбъект.ЭтоМассовоеСоздание = Истина;
	КонецЕсли;
	
	Если Параметры.Свойство("ЭтоКопирование" )тогда
		ЭтотОбъект.ЭтоКопирование = Параметры.ЭтоКопирование;
	КонецЕсли;
	
	Если НЕ Параметры.ЭтоНовый тогда
		
		ЭтотОбъект.Наименование = Параметры.Наименование;
	
		Настройка = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки",
		ЭтотОбъект.Наименование,
		"Содержит шаблоны пакетов ЭД",
		ПолучитьТекущегоПользователя());
		
		ТаблицаТиповДокументов.Загрузить(Настройка.ТаблицаНастроекПоиска);
		
		Если ЭтотОбъект.ЭтоКопирование тогда
			ЭтотОбъект.Наименование = "";
		КонецЕсли;
		
	ИначеЕсли Параметры.ЭтоНовый тогда	
		
		//ЭтотОбъект.Элементы.Контрагент.ТолькоПросмотр = Ложь;
		
	КонецЕсли;
	
	ЗаполнитьРазрешенныеТипыИзНастройки();
	
КонецПроцедуры

