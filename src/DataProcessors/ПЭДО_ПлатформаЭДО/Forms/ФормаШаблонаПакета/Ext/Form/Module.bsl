&НаСервере
Функция ПолучитьДоступныеОрганизации1С()
	
	ЗапросОрганизаций = Новый Запрос;
	ЗапросОрганизаций.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка,
	|	Организации.ПометкаУдаления,
	|	Организации.Предопределенный,
	|	Организации.ИНН,
	|	Организации.КПП
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ПометкаУдаления = ЛОЖЬ";
	
	Результат = ЗапросОрганизаций.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Результат = Результат.Выбрать();
		МассивОрганизаций = Новый Массив;
		Пока Результат.Следующий() Цикл
			ДанныеПоОрганизации = Новый Структура;
			ДанныеПоОрганизации.Вставить("Ссылка", Результат.Ссылка);
			ДанныеПоОрганизации.Вставить("ИНН", Результат.ИНН);
			ДанныеПоОрганизации.Вставить("КПП", Результат.КПП);
			МассивОрганизаций.Добавить(ДанныеПоОрганизации);	
		КонецЦикла;
		Возврат МассивОрганизаций; 
	Иначе	
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции	

// Функция загрузки Кэш
// Если значение реквизита формы "АдресВременногоХранилищаКэш" заполнено, то берем Кэш из временного хранилища (ШтатныйЗапуск())
&НаСервере
Функция ЗагрузитьКэш(Откат = Ложь)       
	
	Если ЗначениеЗаполнено(ЭтаФорма.АдресВременногоХранилищаКэш) и Не Откат Тогда
		
		Кэш = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресВременногоХранилищаКэш);
		
		Если НЕ ЗначениеЗаполнено(Кэш) Тогда
			МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
			Кэш = МодульОбъектаОбработки.Инициализация(Откат);
			ЗначениеВРеквизитФормы(МодульОбъектаОбработки, "Объект");
		КонецЕсли;	
		
		Возврат Кэш;
		
	Иначе
		
		МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
		Кэш = МодульОбъектаОбработки.Инициализация(Откат);
		ЗначениеВРеквизитФормы(МодульОбъектаОбработки, "Объект"); 
		
		Возврат Кэш;
		
	КонецЕсли;
	
КонецФункции

// Функция сохранения Кэш в процессе работы
// В текущий Кэш записываем только требуемые для выгрузки настройки, остальные динамически подргружаем по мере необходимости
&НаСервере
Процедура СохранитьКэш(Кэш)
	
	// Удаляем предыдущее значение Кэш из временного хранилища
	Если ЗначениеЗаполнено(ЭтаФорма.АдресВременногоХранилищаКэш) Тогда
		//УдалитьИзВременногоХранилища(ЭтаФорма.АдресВременногоХранилищаКэш);
		Адрес = ЭтаФорма.АдресВременногоХранилищаКэш;
	Иначе
		Адрес = ЭтаФорма.УникальныйИдентификатор;
	КонецЕсли;
	
	// Записываем новое значение Кэш во временное хранилище
	ЭтаФорма.АдресВременногоХранилищаКэш = ПоместитьВоВременноеХранилище(Кэш, Адрес);	
	
КонецПроцедуры

