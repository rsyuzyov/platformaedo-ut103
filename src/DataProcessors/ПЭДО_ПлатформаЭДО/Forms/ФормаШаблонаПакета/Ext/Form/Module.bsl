&НаСервере
Процедура ЗаполнитьРазрешенныеТипыИзНастройки()
	
	РеестрДокументов = "Конфигурация";
	
	// Получаем данные из настроек и обновляем Кэш
	Кэш = ЗагрузитьКэш();
	
	Если НЕ Кэш = Неопределено Тогда	
		
		МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
		Настройка = МодульОбъектаОбработки.ПолучитьОбъектНастройкиПоИмениМетаданных(РеестрДокументов, Кэш);
		
		Если НЕ Настройка.СпискиДокументов.Свойства().Получить("СписокДокументов") = Неопределено Тогда
			
			
			Если ТипЗнч(Настройка.СпискиДокументов.СписокДокументов) = Тип("СписокXDTO") Тогда
				// Несколько списков документов
				СписокДокументов = Настройка.СпискиДокументов.ПолучитьСписок("СписокДокументов");
			Иначе
				// Один список документов
				СписокДокументов = Новый Массив;
				СписокДокументов.Добавить(Настройка.СпискиДокументов.СписокДокументов);
			КонецЕсли; 
			
			СписокТипов = Новый СписокЗначений;
			
			Для каждого Список из СписокДокументов цикл
				
				СписокТипов.Добавить(Тип("ДокументСсылка." + Список.ОсновнаяТаблица), Список.ОсновнаяТаблица);
               
			КонецЦикла;
				
			ЭтотОбъект.ДоступныеТипыДокументов = СписокТипов;
			
			Для Каждого Список из СписокДокументов Цикл
				
				// Распаковываем список доступных форматов для списка документов в Кэш
				Если ТипЗнч(Список.ФорматыДляВыгрузки.Формат) = Тип("СписокXDTO") Тогда
					// Несколько форматов
					СписокДоступныхФорматов = Список.ФорматыДляВыгрузки.ПолучитьСписок("Формат");
				Иначе
					// Один формат
					СписокДоступныхФорматов = Новый Массив;
					СписокДоступныхФорматов.Добавить(Список.ФорматыДляВыгрузки.Формат);
				КонецЕсли; 		
				
				СписокЗначений = Новый СписокЗначений;
				Индекс = 0;
				Для Каждого Формат из СписокДоступныхФорматов Цикл			
					СписокЗначений.Вставить(Индекс, Формат.Значение, Формат.Представление);
					Индекс = Индекс + 1; 
				КонецЦикла;
				Кэш.ДоступныеФорматы.Вставить(Список.Наименование, СписокЗначений)
				
			КонецЦикла
		КонецЕсли;
	КонецЕсли;
	
	СохранитьКэш(Кэш);
	
	СпискиДокументов = ЭтотОбъект.ДоступныеТипыДокументов;
	СписокДокументов = Новый Массив; 
		
	Для Каждого Список из СпискиДокументов цикл
			
		ЭтаФорма.Элементы.ТаблицаТиповДокументовТипДокументаПредставление.СписокВыбора.Добавить("ДокументСсылка." + Список.Представление, Список.Значение); 
		
		Если ЭтотОбъект.ЭтоМассовоеСоздание тогда
			ЭтаФорма.Элементы.ТаблицаТиповДокументовМассовоеСозданиеТипДокументаПредставление.СписокВыбора.Добавить("ДокументСсылка." + Список.Представление, Список.Значение);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивРазрешенныхТипов(ДанныеВыбора, ЭтоСвязанныйДокумент)
	
	СписокДокументов = Новый Массив;
	
	Если Не ЭтоСвязанныйДокумент тогда
		//Основной документ пакета
		СпискиДокументов = ЭтотОбъект.ДоступныеТипыДокументов;
		СписокДокументов = Новый Массив; 
		
		Для Каждого Список из СпискиДокументов цикл
			
			СписокДокументов.Добавить(Тип("ДокументСсылка." + Список.Представление));
			
		КонецЦикла;
		
	Иначе
		//Связанный документ
		
		СписокДокументов = Новый СписокЗначений;
		
		Для Каждого Элемент Из Метаданные.КритерииОтбора.СвязанныеДокументы.Состав Цикл
			Если Элемент.Тип.СодержитТип(Тип(ДанныеВыбора.ДокРодитель)) Тогда
				
				ПолноеИмя = Элемент.ПолноеИмя();
				МДанные = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
				
				Если СтрНайти(ПолноеИмя, "Справочник") <> 0  тогда
					Продолжить
				КонецЕсли;
				
				Если СтрНайти(ПолноеИмя, "ТабличнаяЧасть") <> 0 тогда
					СписокДокументов.Добавить("ДокументСсылка." + Элемент.Родитель().Родитель().Имя, Элемент.Родитель().Родитель().Синоним);
				Иначе
					СписокДокументов.Добавить("ДокументСсылка." + Элемент.Родитель().Имя, Элемент.Родитель().Синоним);
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
		
	КонецЕсли;
	
	Возврат СписокДокументов;
	
КонецФункции

