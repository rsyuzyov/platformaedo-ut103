					Сообщение.Сообщить();
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = РезультатПодписанияДокумента.Описание;
					Сообщение.Сообщить();
				Иначе
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Входящее предложение об аннулировании с идентификатором " +ИдентификаторПредложенияОбАннулировании+ " было успешно отклонено.";
					Сообщение.Сообщить();
				КонецЕсли;	
				
				УдалитьФайлы(ИмяФайлаПодписи);
				
			КонецЕсли;
			
		Иначе
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не удалось скачать уведомление об уточнении покупателя для предложения об аннулировании с идентификатором "+ИдентификаторПредложенияОбАннулировании+"."+Символы.ПС+"Описание ошибки:"+Символы.ПС+РезультатФормированияУОУ.Описание;
			Сообщение.Сообщить();
			Возврат;
			
		КонецЕсли;	
		
	Иначе	
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось сформировать уведомление об уточнении покупателя для предложения об аннулировании с идентификатором "+ИдентификаторПредложенияОбАннулировании+"."+Символы.ПС+"Описание ошибки:"+Символы.ПС+РезультатФормированияУОУ.Описание;
		Сообщение.Сообщить();
		Возврат;
		
	КонецЕсли;	
	
КонецПроцедуры	

#КонецОбласти

#Область АктуальнаяПроцедураОтклоненияАннулирования_С_УС

&НаКлиенте
Процедура ОтклонитьПредложениеОбАннулированииДокументовЧерезAPI(СтруктураОписанияДокумента, ТекстПричиныОтказа) Экспорт
	
	ИдентификаторДокумента = СтруктураОписанияДокумента.ИдентификаторДокумента;
	
	Интеграция			= ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	Менеджер			= ПолучитьМенеджерКриптографии();
	Сертификат			= ПолучитьЭЦППоОтпечатку(Менеджер, Base64Значение(ОтпечатокСертификатаBase64));
	
	СубъектСертификата	= Сертификат.Субъект;
	
	Если НЕ РаботаемПоУС Тогда
	// Удалить++
	// После полного перехода на УС.
	
		ФамилияСубъекта		= СубъектСертификата.SN;
		ИмяОтчествоСубъекта = СтрРазделить(СубъектСертификата.GN, " ");
		ИмяСубъекта			= ИмяОтчествоСубъекта[0];
		ОтчествоСубъекта 	= ИмяОтчествоСубъекта[1];
		ДолжностьСубъекта	= ?(СубъектСертификата.Свойство("T"), ?(СубъектСертификата.T = "", "Индивидуальный предприниматель", СубъектСертификата.T), "Индивидуальный предприниматель");
		
