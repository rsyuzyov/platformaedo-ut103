#КонецОбласти

#Область РаботаСоСпискамиДокументов

// Процедура заполнения динамического списка 
&НаСервере
Процедура ЗаполнитьДинамическиеСписки(РеестрДокументов = "Конфигурация")
	
	Страницы = Элементы.Добавить("Страницы",	Тип("ГруппаФормы"),  ЭтаФорма);
	Страницы.Вид                = ВидГруппыФормы.Страницы;
	Страницы.Заголовок          = "Страницы";
	Страницы.ОтображениеСтраниц	= ОтображениеСтраницФормы.ЗакладкиСправаГоризонтально;
	Страницы.УстановитьДействие ("ПриСменеСтраницы", "ПриСменеСтраницы");
	
	// Добавляем старницы для документов, для которых возможна отправка.
	ДобавитьСпискиДокументовНаОтправку(Страницы, РеестрДокументов);
	
	// Добавляем страницу для исходящих документов
	ДобавитьСписокИсходящихДокументов(Страницы);
	
	// Добавляем страницу для входящих документов
	ДобавитьСписокВходящихДокументов(Страницы);
	
КонецПроцедуры 

&НаСервере
Процедура ДобавитьСпискиДокументовНаОтправку(Страницы, РеестрДокументов)

	// Получаем данные из настроек и обновляем Кэш
	Кэш = ЗагрузитьКэш();
	
	Если Кэш = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
	Настройка = МодульОбъектаОбработки.ПолучитьОбъектНастройкиПоИмениМетаданных(РеестрДокументов, Кэш);
	
	Если Настройка.СпискиДокументов.Свойства().Получить("СписокДокументов") = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если ТипЗнч(Настройка.СпискиДокументов.СписокДокументов) = Тип("СписокXDTO") Тогда
		// Несколько списков документов
		СписокДокументов = Настройка.СпискиДокументов.ПолучитьСписок("СписокДокументов");
	Иначе
		// Один список документов
		СписокДокументов = Новый Массив;
		СписокДокументов.Добавить(Настройка.СпискиДокументов.СписокДокументов);
	КонецЕсли; 	
	
	Для Каждого Список из СписокДокументов Цикл
		
		// Распаковываем список доступных форматов для списка документов в Кэш
		Если ТипЗнч(Список.ФорматыДляВыгрузки.Формат) = Тип("СписокXDTO") Тогда
			// Несколько форматов
			СписокДоступныхФорматов = Список.ФорматыДляВыгрузки.ПолучитьСписок("Формат");
		Иначе
			// Один формат
			СписокДоступныхФорматов = Новый Массив;
			СписокДоступныхФорматов.Добавить(Список.ФорматыДляВыгрузки.Формат);
		КонецЕсли; 		
		//СписокДоступныхФорматов = Список.ФорматыДляВыгрузки.ПолучитьСписок("Формат");
		
		СписокЗначений = Новый СписокЗначений;
		Индекс = 0;
		Для Каждого Формат из СписокДоступныхФорматов Цикл			
			СписокЗначений.Вставить(Индекс, Формат.Значение, Формат.Представление);
			Индекс = Индекс + 1; 
		КонецЦикла;
		Кэш.ДоступныеФорматы.Вставить(Список.Наименование, СписокЗначений);
		// Распаковываем список доступных форматов для списка документов в Кэш
		
		// Получаем и формулируем параметры запроса динамического списка.
		ПараметрыЗапроса = Новый Соответствие;
		Для Каждого Свойство ИЗ Список.ПараметрыЗапроса.Свойства() Цикл
			ИмяПараметра = Свойство.Имя;
			ИсточникДанныхДляПараметра = Список.ПараметрыЗапроса[Свойство.Имя].ИсточникДанныхДляПараметра;
			Если ИсточникДанныхДляПараметра = "ХранениеИнформации1С" Тогда
				ПутьКЗначениюПараметраВ1С = Настройка.ХранениеИнформации1С[Список.ПараметрыЗапроса[ИмяПараметра].ПутьКЗначению1С];
				ЗапросПараметра = Новый Запрос;
				ЗапросПараметра.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				                        |	ИсточникЗначенияПараметра.Ссылка
				                        |ИЗ
				                        |	"+ПутьКЗначениюПараметраВ1С.ИмяОбъектаМетаданных+"."+ПутьКЗначениюПараметраВ1С.Путь+" КАК ИсточникЗначенияПараметра
				                        |ГДЕ
				                        |	ИсточникЗначенияПараметра.Наименование = """+ПутьКЗначениюПараметраВ1С.Наименование+""""
										+?(ПутьКЗначениюПараметраВ1С.ТипОбъектаМетаданных = "Справочники" ИЛИ ПутьКЗначениюПараметраВ1С.ТипОбъектаМетаданных = "Документы" ИЛИ ПутьКЗначениюПараметраВ1С.ТипОбъектаМетаданных = "Обработки" ИЛИ ПутьКЗначениюПараметраВ1С.ТипОбъектаМетаданных = "ПланыВидовХарактеристик", Символы.ПС+"И ИсточникЗначенияПараметра.ПометкаУдаления = Ложь", "");
				ЗначениеПараметра = ЗапросПараметра.Выполнить().Выгрузить()[0].Ссылка;
				ПараметрыЗапроса.Вставить(ИмяПараметра, ЗначениеПараметра);
			ИначеЕсли ИсточникДанныхДляПараметра = "ФормаОбработки" Тогда
				ЗначениеПараметра = ЭтаФорма[Список.ПараметрыЗапроса[ИмяПараметра].ПутьКЗначению1С];
				ПараметрыЗапроса.Вставить(ИмяПараметра, ЗначениеПараметра);
			КонецЕсли;	
		КонецЦикла;	
		
		Страница = Элементы.Добавить(Список.Наименование, Тип("ГруппаФормы"), Страницы);
		Страница.Вид              = ВидГруппыФормы.Страница;
		Страница.Заголовок        = Список.Представление;
		
		// Группа для пользовательских фильтров
		ГруппаФильтров = Элементы.Добавить("ГруппаФильтров" + Список.Наименование, Тип("ГруппаФормы"), Страница);  
		ГруппаФильтров.Вид					= ВидГруппыФормы.ОбычнаяГруппа;  
		ГруппаФильтров.Группировка			= ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;      
		ГруппаФильтров.Заголовок    		= "ГруппаФильтров" + Список.Наименование; 
		ГруппаФильтров.ОтображатьЗаголовок	= Ложь;
		// Группа для пользовательских фильтров  
		
		ТекстЗапроса = Список.ЗапросСпискаДокументов;
		
		// Создаем реквизит формы динамического списка
		ДобавляемыеРеквизиты	= Новый Массив; 	
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Список.Наименование, Новый ОписаниеТипов("ДинамическийСписок")));	
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		
		ЭтаФорма[Список.Наименование].ПроизвольныйЗапрос	= Истина;
		ЭтаФорма[Список.Наименование].ТекстЗапроса			= ТекстЗапроса;
		
		//	Заполним параметры запроса динамического списка.
		Для каждого ПараметрЗапроса ИЗ ПараметрыЗапроса Цикл 
			ЭтаФорма[Список.Наименование].Параметры.УстановитьЗначениеПараметра(ПараметрЗапроса.Ключ, ПараметрЗапроса.Значение);
		КонецЦикла;
		
		ЭтаФорма[Список.Наименование].ОсновнаяТаблица = "Документ." + Список.ОсновнаяТаблица; 
		//ЭтаФорма[Список.Наименование].АвтоЗаполнениеДоступныхПолей = Ложь;
		//ЭтаФорма[Список.Наименование].ПолучениеПредставленийДляНевидимыхПолей = Ложь;
		//ЭтаФорма[Список.Наименование].ДинамическоеСчитываниеДанных = Ложь;
		// Создаем реквизит формы динамического списка   	
		
		//Создание элементов формы : список
		ДинамическийСписок = Элементы.Добавить("ДинамическийСписок"+Список.Наименование, Тип("ТаблицаФормы"), Страница);
		ДинамическийСписок.ПутьКДанным                   	= Список.Наименование;
		ДинамическийСписок.Отображение                   	= ОтображениеТаблицы.Список;
		//ДинамическийСписок.Отображение                   	= ОтображениеТаблицы.ИерархическийСписок;
		ДинамическийСписок.ПоложениеУправленияПоиском    	= ПоложениеУправленияПоиском.Авто;
		ДинамическийСписок.ПоложениеСостоянияПросмотра   	= ПоложениеСостоянияПросмотра.Авто;
		ДинамическийСписок.ПоложениеСтрокиПоиска         	= ПоложениеСтрокиПоиска.Авто;
		ДинамическийСписок.ПоложениеКоманднойПанели      	= ПоложениеКоманднойПанелиЭлементаФормы.Авто;
		ДинамическийСписок.ПутьКДаннымКартинкиСтроки		= "";
		//ДинамическийСписок.ДинамическоеСчитываниеДанных		= Истина;
		
		ДинамическийСписок.УстановитьДействие("ПриПолученииДанныхНаСервере", "ОбработкаПолученияДанныхДинамическогоСписка");
		
		//Создание элементов формы  : список
		
		
		// Добавление колонок из настроек
		СписокКолонки = Список.КолонкиСпискаДокументов.ПолучитьСписок("Колонка");
		
		Для Каждого Колонка из СписокКолонки Цикл
			// Колонки добавлены в порядке строк в файле настроек
			АтрибутыКолонки = Колонка.Свойства();
			
			НоваяКолонка = Элементы.Добавить(Список.Наименование + Колонка.ИсточникДанных, Тип(Колонка.Тип), ДинамическийСписок);    
			
			Если АтрибутыКолонки.Получить("Вид") <> Неопределено Тогда
				НоваяКолонка.Вид = ВидПоляФормы[Колонка.Вид];
			КонецЕсли;
			
			НоваяКолонка.ПутьКДанным                = Список.Наименование + "." + Колонка.ИсточникДанных;
			НоваяКолонка.Видимость                	= Булево(Колонка.Видимость);
			НоваяКолонка.Заголовок                  = Колонка.Имя;  	
			
			// Добавление условного форматирования для статусов документов			
			Если Колонка.ИсточникДанных = "ДокументСтатус" Тогда				
				Элементы[Список.Наименование + Колонка.ИсточникДанных].СписокВыбора.Очистить();
				Статусы = ПолучитьСписокСтатусовЭДО();
				
				Для Каждого Статус Из Статусы Цикл
					Элементы[Список.Наименование + Колонка.ИсточникДанных].СписокВыбора.Добавить(Статус.Значение, Статус.Представление);
				КонецЦикла;    		
				
				ДобавитьУсловноеОформлениеТекстаДляСпискаВыбора(Элементы[Список.Наименование + Колонка.ИсточникДанных]); 				
			КонецЕсли;
			
		КонецЦикла;
		// Добавление колонок из настроек 
		
		
		// Установка обязательного использования для основного поля
		// Необходимо для корректной работы стандартного функционала динамического списка
		ЭтаФорма[Список.Наименование].УстановитьОбязательноеИспользование("Ссылка", Истина);
		
		// Добавление команду для обновления пользовательских настроек на форме		
		ДинамическийСписок.УстановитьДействие("ПриОбновленииСоставаПользовательскихНастроекНаСервере", "ПриОбновленииСоставаПользовательскихНастроекНаСервере");
		
		// Добавляем стандартный фильтр в динамический список по статусу документа 
		КомпоновщикНастроек = ЭтаФорма[Список.Наименование].КомпоновщикНастроек; 
		//КомпоновщикНастроек.Настройки.Отбор.ДоступныеПоляОтбора.Элементы.Найти("ДокументСтатус").ДоступныеЗначения = Статусы;
		
		ПользовательскийОтбор = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки);
		ФильтрСтатус = ПользовательскийОтбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ФильтрСтатус.ИдентификаторПользовательскойНастройки = Новый УникальныйИдентификатор();
		ФильтрСтатус.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ДокументСтатус");
		ФильтрСтатус.ВидСравнения 	= ВидСравненияКомпоновкиДанных.Равно;
		ФильтрСтатус.Использование 	= Ложь;
		ФильтрСтатус.ПравоеЗначение = 1;
		ФильтрСтатус.Представление 	= "Статус ЭДО";
		ФильтрСтатус.ПредставлениеПользовательскойНастройки = "Статус ЭДО";    		
		// Добавляем стандартный фильтр в динамический список по статусу документа
		
		КнопкаОбновитьВыделенныеДокументыСписка = ЭтаФорма.Элементы.Вставить(Список.Наименование+"КнопкаОбновитьСтатусыВыделенныхДокументов", Тип("КнопкаФормы"), ДинамическийСписок.КоманднаяПанель); 
		КнопкаОбновитьВыделенныеДокументыСписка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		КнопкаОбновитьВыделенныеДокументыСписка.ИмяКоманды = "ОбновитьСтатусыВыделенныхДокументов";
		
		КнопкаОбновитьВыделенныеДокументыСписка = ЭтаФорма.Элементы.Вставить(Список.Наименование+"КнопкаОткрытьФормуПредпросмотраДокумента", Тип("КнопкаФормы"), ДинамическийСписок.КоманднаяПанель); 
		КнопкаОбновитьВыделенныеДокументыСписка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		КнопкаОбновитьВыделенныеДокументыСписка.ИмяКоманды = "ОткрытьФормуПредпросмотраДокумента";
		
		КнопкаОбновитьВыделенныеДокументыСписка = ЭтаФорма.Элементы.Вставить(Список.Наименование+"КнопкаУдалитьЧерновики", Тип("КнопкаФормы"), ДинамическийСписок.КоманднаяПанель); 
		КнопкаОбновитьВыделенныеДокументыСписка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		КнопкаОбновитьВыделенныеДокументыСписка.ИмяКоманды = "УдалитьОтправленныеДокументы";
		
	КонецЦикла; 
	
	// Добавляем фильтры на форму 
	ПриОбновленииСоставаПользовательскихНастроекНаСервере(Ложь); 

	СохранитьКэш(Кэш);
	
КонецПроцедуры	

&НаСервере
Процедура ДобавитьСписокИсходящихДокументов(Страницы)
	
	// Страница.
    Страница = Элементы.Добавить("ИсхДокументы", Тип("ГруппаФормы"), Страницы);
    Страница.Вид              = ВидГруппыФормы.Страница;
    Страница.Заголовок        = "Исходящие документы";

	// Создание реквизитов формы.
	МассивРеквизитов = Новый Массив;
	
	// Реквизит списка значений для выбора и хранения состава выводимых колонок списка.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СписокЗначений"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ВыводимыеКолонкиСпискаИсходящих", ОписаниеТипов, , , Истина));
	
	// Фиксация новых реквизитов формы.
	ИзменитьРеквизиты(МассивРеквизитов);
	
	МассивРеквизитов = Новый Массив;
	
	// Реквизит таблицы.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("ТаблицаЗначений"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ИсхДокументы", ОписаниеТипов, "", "ТЗН"));
	
	// Колонки таблицы
	КД = Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя); 
	МассивКД = Новый Массив;
	МассивКД.Добавить(Тип("Дата"));
	ОписаниеТиповДата = Новый ОписаниеТипов(МассивКД, , ,КД);
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ДатаСоздания", ОписаниеТиповДата, "Дата создания");
	ТЗ.Колонки.Добавить("ДатаПодписания", ОписаниеТиповДата, "Дата подписания");
	ТЗ.Колонки.Добавить("id", , "Идентификатор");
	ТЗ.Колонки.Добавить("ТипДокумента", , "Тип документа");
	ТЗ.Колонки.Добавить("НомерДокумента", , "Номер документа");
	ТЗ.Колонки.Добавить("ДатаДокумента", , "Дата документа");
	ТЗ.Колонки.Добавить("Заголовок", , "Заголовок");
	ТЗ.Колонки.Добавить("СтатусЭДО", , "Числовой статус");
	ТЗ.Колонки.Добавить("ПредставлениеСтатусаЭДО", , "Статус");
	ТЗ.Колонки.Добавить("Контрагент", , "Контрагент");
	ТЗ.Колонки.Добавить("Организация", , "Организация");
	ТЗ.Колонки.Добавить("СуммаДокумента", , "Сумма");
	ТЗ.Колонки.Добавить("СуммаНДСДокумента", , "НДС");
	ТЗ.Колонки.Добавить("СсылкаНаДокумент", , "Ссылка");
	ТЗ.Колонки.Добавить("ФорматДокумента", , "Формат");
	ТЗ.Колонки.Добавить("fileIdДокумента", , "Идентификатор файла");
	ТЗ.Колонки.Добавить("recipientIdДокумента", , "Идентификатор получателя");
	ТЗ.Колонки.Добавить("ПричинаОтклоненияДокумента", , "Причина отклонения");
	ТЗ.Колонки.Добавить("ИдентификаторНеподписанногоИзвещения", , "Идентификатор неподписанного извещения");
	
	Для Каждого Колонка Из ТЗ.Колонки Цикл
	    МассивРеквизитов.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "ИсхДокументы"));
		ЭтаФорма.ВыводимыеКолонкиСпискаИсходящих.Добавить(Колонка.Имя, Колонка.Заголовок);
	КонецЦикла;
	
	// Реквизит списка значений для отбора исходящих по организации.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СписокЗначений"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	МассивРеквизитов.Добавить(Новый РеквизитФормы("СписокКолонокДляНастройкиСортировкиИсходящих", ОписаниеТипов));
	
	// Реквизит периода для отбора исходящих по организации.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СтандартныйПериод"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ПериодДляФильтраИсходящих", ОписаниеТипов, , "Период"));
	
	// Реквизит списка значений для отбора исходящих по организации.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СписокЗначений"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ОрганизацииДляФильтраИсходящих", ОписаниеТипов, , "Организации"));
	
	// Реквизит списка значений для отбора исходящих по контрагентам.
	МассивРеквизитов.Добавить(Новый РеквизитФормы("КонтрагентыДляФильтраИсходящих", ОписаниеТипов, , "Контрагенты"));
	
	// Реквизит фильтра по статусам документов.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	МассивРеквизитов.Добавить(Новый РеквизитФормы("СтатусДляФильтраИсходящих", ОписаниеТипов, , "Статус")); 
	
	// Реквизит фильтра по типу документов.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ТипыДокументовДляФильтраИсходящих", ОписаниеТипов, , "Типы"));

	// Реквизит фильтра по наличию в документах маркировки.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Число"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	МассивРеквизитов.Добавить(Новый РеквизитФормы("НаличиеМаркировкиДляФильтраИсходящих", ОписаниеТипов, , "Наличие маркировки"));
	
	// Реквизит описания причины отклонения выделенного исходящего документа.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ПричинаОтклоненияВыделенногоИсходящего", ОписаниеТипов, , "Причина отклонения"));
	
	// Реквизит описания номера МЧД выделенного исходящего документа.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	МассивРеквизитов.Добавить(Новый РеквизитФормы("НомерМЧДВыделенногоИсходящего", ОписаниеТипов, , "Номер МЧД"));
	
	// Фиксация новых реквизитов формы.
	ИзменитьРеквизиты(МассивРеквизитов); 
	
	// Заполнение списка организаций для фильтра исходящих.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.Организации"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	ЭтаФорма.ОрганизацииДляФильтраИсходящих.ТипЗначения = ОписаниеТипов;
	Если НЕ Организация.Пустая() Тогда
		ЭтаФорма.ОрганизацииДляФильтраИсходящих.Добавить(Организация);
	Иначе	
		ЗапросОрганизаций = Новый Запрос;
		ЗапросОрганизаций.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		                          |	Организации.Ссылка,
		                          |	Организации.ПометкаУдаления,
		                          |	Организации.Предопределенный
		                          |ИЗ
		                          |	Справочник.Организации КАК Организации
		                          |ГДЕ
		                          |	Организации.ПометкаУдаления = ЛОЖЬ
		                          |	И Организации.Предопределенный = ЛОЖЬ";
		ВыборкаОрганизаций = ЗапросОрганизаций.Выполнить().Выбрать();
		Пока ВыборкаОрганизаций.Следующий() Цикл
			ЭтаФорма.ОрганизацииДляФильтраИсходящих.Добавить(ВыборкаОрганизаций.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
	// Определение типа для реквизита отбора по контрагентам.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.Контрагенты"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	ЭтаФорма.КонтрагентыДляФильтраИсходящих.ТипЗначения = ОписаниеТипов;
	
	// Заполнение первоначального значения периода отбора.
	ЭтаФорма.ПериодДляФильтраИсходящих.Вариант = ВариантСтандартногоПериода.Сегодня;
		
	// Создание элементов Формы.
	// Группа фильтров для таблицы исходящих.
	ГруппаФильтровИсходящих = Элементы.Добавить("ФильтрыИсходящихДокументов", Тип("ГруппаФормы"), Страница);
	ГруппаФильтровИсходящих.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаФильтровИсходящих.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаФильтровИсходящих.ОтображатьЗаголовок = Ложь; 
	ГруппаФильтровИсходящих.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаФильтровИсходящих.РастягиватьПоГоризонтали = Истина;
	
	// Поле фильтра исходящих по периоду.
	ПолеФильтраИсходящихПоСтатусам = ЭтаФорма.Элементы.Добавить("ФильтрИсходящихПоПериоду", Тип("ДекорацияФормы"), ГруппаФильтровИсходящих);
	ПолеФильтраИсходящихПоСтатусам.Заголовок = "За период: Сегодня";
	ПолеФильтраИсходящихПоСтатусам.Гиперссылка = Истина;
	ПолеФильтраИсходящихПоСтатусам.УстановитьДействие("Нажатие", "ПериодДляФильтраИсходящихНажатие");
	
	// Поле фильтра исходящих по организации.
	ПолеФильтраИсходящихПоОрганизациям = ЭтаФорма.Элементы.Добавить("ФильтрИсходящихПоОрганизациям", Тип("ПолеФормы"), ГруппаФильтровИсходящих);
	ПолеФильтраИсходящихПоОрганизациям.Вид = ВидПоляФормы.ПолеВвода;
