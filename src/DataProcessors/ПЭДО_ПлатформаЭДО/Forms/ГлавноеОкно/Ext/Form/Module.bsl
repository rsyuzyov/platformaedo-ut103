	Если Кэш.НастройкиОбъект[Кэш.ПрефиксКонфигурации+"НастройкиЗагрузки"] = Неопределено Тогда				
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не обнаружена настройка загрузки объектов """+Кэш.ПрефиксКонфигурации+"НастройкиЗагрузки"+"""";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
		
