		ОбщегоНазначенияВызовСервера.ХранилищеНастроекДанныхФормСохранить(ИмяОбработки, "ВыводимыеКолонкиСпискаИсходящих", ЭтаФорма.ВыводимыеКолонкиСпискаИсходящих, , ПолучитьТекущегоПользователя());
	Иначе	
		ЭтаФорма.ВыводимыеКолонкиСпискаИсходящих = ВыводимыеКолонкиСпискаИсходящих_Сохраненное;	
	КонецЕсли;
	
	ОбновитьВидимостьКолонокСпискаИсходящих();
	
	Статусы = ПолучитьСписокСтатусовЭДО();
	Для Каждого Статус Из Статусы Цикл
		Элементы.ТаблицаИсходящих_СтатусЭДО.СписокВыбора.Добавить(Статус.Значение, Статус.Представление);
	КонецЦикла;
	ДобавитьУсловноеОформлениеТекстаДляСпискаВыбора(Элементы.ТаблицаИсходящих_СтатусЭДО);
	
	ЗначениеВРеквизитФормы(ТЗ, "ИсхДокументы");
	
	// Кнопка вызова формы настройки сортировки.
	КомандаОткрытьФормуНастройкиСортировкиИсходящих = ЭтаФорма.Команды.Добавить("ОткрытьФормуНастройкиСортировкиИсходящих");
	КомандаОткрытьФормуНастройкиСортировкиИсходящих.Действие = "ОткрытьФормуНастройкиСортировки";
	КомандаОткрытьФормуНастройкиСортировкиИсходящих.Заголовок = "Сортировка";
	КнопкаОткрытьФормуНастройкиСортировкиИсходящих = ЭтаФорма.Элементы.Вставить("КнопкаВОткрытьФормуНастройкиСортировкиИсходящих", Тип("КнопкаФормы"), ТаблицаИсходящих.КонтекстноеМеню); 
	КнопкаОткрытьФормуНастройкиСортировкиИсходящих.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	КнопкаОткрытьФормуНастройкиСортировкиИсходящих.ИмяКоманды = "ОткрытьФормуНастройкиСортировкиИсходящих";
	
	// Кнопка выгрузки таблицы в файл.
	КомандаВыгрузитьСписокИсходящихВФайл = ЭтаФорма.Команды.Добавить("ВыгрузитьСписокИсходящихВФайл");
	КомандаВыгрузитьСписокИсходящихВФайл.Действие = "ВыгрузитьСписокИсходящихВходящихВФайл";
	КомандаВыгрузитьСписокИсходящихВФайл.Заголовок = "Выгрузить таблицу";
	КнопкаВыгрузитьСписокИсходящихВФайл = ЭтаФорма.Элементы.Вставить("КнопкаВыгрузитьСписокИсходящихВФайл", Тип("КнопкаФормы"), ТаблицаИсходящих.КонтекстноеМеню); 
	КнопкаВыгрузитьСписокИсходящихВФайл.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	КнопкаВыгрузитьСписокИсходящихВФайл.ИмяКоманды = "ВыгрузитьСписокИсходящихВФайл";
	
	// Кнопка выбора визуализируемых колонок списка исходящих.
	КомандаВыгрузитьСписокИсходящихВФайл = ЭтаФорма.Команды.Добавить("ВыбратьКолонкиСпискаИсходящих");
	КомандаВыгрузитьСписокИсходящихВФайл.Действие = "ВыбратьКолонкиСпискаИсходящих";
	КомандаВыгрузитьСписокИсходящихВФайл.Заголовок = "Состав колонок";
	КнопкаВыгрузитьСписокИсходящихВФайл = ЭтаФорма.Элементы.Вставить("КнопкаВыбратьКолонкиСпискаИсходящих", Тип("КнопкаФормы"), ТаблицаИсходящих.КонтекстноеМеню); 
	КнопкаВыгрузитьСписокИсходящихВФайл.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	КнопкаВыгрузитьСписокИсходящихВФайл.ИмяКоманды = "ВыбратьКолонкиСпискаИсходящих";
	
	// Поле причины отклонения исходящего документа.
	ПолеПричинаОтклоненияВыделенногоИсходящего = ЭтаФорма.Элементы.Добавить("ПричинаОтклоненияВыделенногоИсходящего", Тип("ПолеФормы"), Страница);
	ПолеПричинаОтклоненияВыделенногоИсходящего.Вид = ВидПоляФормы.ПолеВвода;
	ПолеПричинаОтклоненияВыделенногоИсходящего.Заголовок = "Причина отклонения";
	ПолеПричинаОтклоненияВыделенногоИсходящего.ПутьКДанным = "ПричинаОтклоненияВыделенногоИсходящего";
	ПолеПричинаОтклоненияВыделенногоИсходящего.ТолькоПросмотр = Истина;
	ПолеПричинаОтклоненияВыделенногоИсходящего.Видимость = Ложь;
	ПолеПричинаОтклоненияВыделенногоИсходящего.АвтоМаксимальнаяШирина = Ложь;
	
	// Поле номера МЧД исходящего документа.
	ПолеНомерМЧДВыделенногоИсходящего = ЭтаФорма.Элементы.Добавить("НомерМЧДВыделенногоИсходящего", Тип("ПолеФормы"), Страница);
	ПолеНомерМЧДВыделенногоИсходящего.Вид = ВидПоляФормы.ПолеВвода;
	ПолеНомерМЧДВыделенногоИсходящего.Заголовок = "Номер МЧД";                                                                  
	ПолеНомерМЧДВыделенногоИсходящего.ПутьКДанным = "НомерМЧДВыделенногоИсходящего";
	ПолеНомерМЧДВыделенногоИсходящего.ТолькоПросмотр = Истина;
	ПолеНомерМЧДВыделенногоИсходящего.Видимость = Ложь;
	ПолеНомерМЧДВыделенногоИсходящего.АвтоМаксимальнаяШирина = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСписокВходящихДокументов(Страницы)
	
	// Страница.
    Страница = Элементы.Добавить("ВхДокументы", Тип("ГруппаФормы"), Страницы);
    Страница.Вид              = ВидГруппыФормы.Страница;
    Страница.Заголовок        = "Входящие документы";  

	// Создание реквизитов формы.
	
	МассивРеквизитов = Новый Массив;
	
	// Реквизит списка значений для выбора и хранения состава выводимых колонок списка.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СписокЗначений"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ВыводимыеКолонкиСпискаВходящих", ОписаниеТипов, , , Истина));
	
	// Фиксация новых реквизитов формы.
	ИзменитьРеквизиты(МассивРеквизитов);
	
	МассивРеквизитов = Новый Массив;
	
	// Реквизит таблицы.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("ТаблицаЗначений"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ВхДокументы", ОписаниеТипов, "", "ТЗН"));
	
	// Колонки таблицы
	КД = Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя); 
	МассивКД = Новый Массив;
	МассивКД.Добавить(Тип("Дата"));
	ОписаниеТиповДата = Новый ОписаниеТипов(МассивКД, , ,КД);	
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ДатаСоздания", ОписаниеТиповДата, "Дата создания");
	ТЗ.Колонки.Добавить("ДатаПодписания", ОписаниеТиповДата, "Дата подписания");
	ТЗ.Колонки.Добавить("id", , "Идентификатор");
	ТЗ.Колонки.Добавить("ТипДокумента", , "Тип документа");
	ТЗ.Колонки.Добавить("НомерДокумента", , "Номер документа");
	ТЗ.Колонки.Добавить("ДатаДокумента", , "Дата документа");
	ТЗ.Колонки.Добавить("Заголовок", , "Заголовок");
	ТЗ.Колонки.Добавить("СтатусЭДО", , "Числовой статус");
	ТЗ.Колонки.Добавить("ПредставлениеСтатусаЭДО", , "Статус");
	ТЗ.Колонки.Добавить("Контрагент", , "Контрагент");
	ТЗ.Колонки.Добавить("Организация", , "Организация");
	ТЗ.Колонки.Добавить("СуммаДокумента", , "Сумма");
	ТЗ.Колонки.Добавить("СуммаНДСДокумента", , "НДС");
	ТЗ.Колонки.Добавить("ФорматДокумента", , "Формат");
	ТЗ.Колонки.Добавить("ВерсияФормата", , "Версия формата");
	ТЗ.Колонки.Добавить("fileIdДокумента", , "Идентификатор файла");
	ТЗ.Колонки.Добавить("senderIdДокумента", , "Идентификатор отправителя");
	ТЗ.Колонки.Добавить("ПричинаОтклоненияДокумента", , "Причина отклонения");
	ТЗ.Колонки.Добавить("Односторонний", , "Односторонний");
	
	Для Каждого Колонка Из ТЗ.Колонки Цикл
	    МассивРеквизитов.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "ВхДокументы"));
		ЭтаФорма.ВыводимыеКолонкиСпискаВходящих.Добавить(Колонка.Имя, Колонка.Заголовок);
	КонецЦикла;
	
	// Реквизит списка значений для отбора исходящих по организации.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СписокЗначений"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	МассивРеквизитов.Добавить(Новый РеквизитФормы("СписокКолонокДляНастройкиСортировкиВходящих", ОписаниеТипов));
	
	// Реквизит периода для отбора входящих по организации.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СтандартныйПериод"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ПериодДляФильтраВходящих", ОписаниеТипов, , "Период"));
	
	// Реквизит списка значений для отбора входящих по организации.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СписокЗначений"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ОрганизацииДляФильтраВходящих", ОписаниеТипов, , "Организации"));
	
	// Реквизит списка значений для отбора входящих по контрагентам.
	МассивРеквизитов.Добавить(Новый РеквизитФормы("КонтрагентыДляФильтраВходящих", ОписаниеТипов, , "Контрагенты"));
	
	// Реквизит фильтра по статусам документов.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	МассивРеквизитов.Добавить(Новый РеквизитФормы("СтатусДляФильтраВходящих", ОписаниеТипов, , "Статус")); 
	
	// Реквизит фильтра по типу документов.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ТипыДокументовДляФильтраВходящих", ОписаниеТипов, , "Типы"));

	// Реквизит фильтра по наличию в документах маркировки.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Число"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	МассивРеквизитов.Добавить(Новый РеквизитФормы("НаличиеМаркировкиДляФильтраВходящих", ОписаниеТипов, , "Наличие маркировки"));
	
	// Реквизит описания причины отклонения выделенного исходящего документа.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ПричинаОтклоненияВыделенногоВходящего", ОписаниеТипов, , "Причина отклонения"));
	
	// Реквизит описания номера МЧД выделенного исходящего документа.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	МассивРеквизитов.Добавить(Новый РеквизитФормы("НомерМЧДВыделенногоВходящего", ОписаниеТипов, , "Номер МЧД"));
	
	// Фиксация новых реквизитов формы.
	ИзменитьРеквизиты(МассивРеквизитов); 
	
	// Заполнение списка организаций для фильтра входящих.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.Организации"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	ЭтаФорма.ОрганизацииДляФильтраВходящих.ТипЗначения = ОписаниеТипов;
	Если НЕ Организация.Пустая() Тогда
		ЭтаФорма.ОрганизацииДляФильтраВходящих.Добавить(Организация);
	Иначе	
		ЗапросОрганизаций = Новый Запрос;
		ЗапросОрганизаций.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		                          |	Организации.Ссылка,
		                          |	Организации.ПометкаУдаления,
	    	                      |	Организации.Предопределенный
	    	                      |ИЗ
	    	                      |	Справочник.Организации КАК Организации
	    	                      |ГДЕ
	    	                      |	Организации.ПометкаУдаления = ЛОЖЬ
	    	                      |	И Организации.Предопределенный = ЛОЖЬ";
		ВыборкаОрганизаций = ЗапросОрганизаций.Выполнить().Выбрать();
		Пока ВыборкаОрганизаций.Следующий() Цикл
			ЭтаФорма.ОрганизацииДляФильтраВходящих.Добавить(ВыборкаОрганизаций.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
	// Определение типа для реквизита отбора по контрагентам.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.Контрагенты"));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	ЭтаФорма.КонтрагентыДляФильтраВходящих.ТипЗначения = ОписаниеТипов;
	
	// Заполнение первоначального значения периода отбора.
	ЭтаФорма.ПериодДляФильтраВходящих.Вариант = ВариантСтандартногоПериода.Сегодня;
		
	// Создание элементов Формы.
	// Группа фильтров для таблицы входящих.
	ГруппаФильтровВходящих = Элементы.Добавить("ФильтрыВходящихДокументов", Тип("ГруппаФормы"), Страница);
	ГруппаФильтровВходящих.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаФильтровВходящих.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаФильтровВходящих.ОтображатьЗаголовок = Ложь; 
	ГруппаФильтровВходящих.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаФильтровВходящих.РастягиватьПоГоризонтали = Истина;
	
	// Поле фильтра входящих по периоду.
	ПолеФильтраВходящихПоСтатусам = ЭтаФорма.Элементы.Добавить("ФильтрВходящихПоПериоду", Тип("ДекорацияФормы"), ГруппаФильтровВходящих);
	ПолеФильтраВходящихПоСтатусам.Заголовок = "За период: Сегодня";
	ПолеФильтраВходящихПоСтатусам.Гиперссылка = Истина;
	ПолеФильтраВходящихПоСтатусам.УстановитьДействие("Нажатие", "ПериодДляФильтраВходящихНажатие");
	
	// Поле фильтра входящих по организации.
	ПолеФильтраВходящихПоОрганизациям = ЭтаФорма.Элементы.Добавить("ФильтрВходящихПоОрганизациям", Тип("ПолеФормы"), ГруппаФильтровВходящих);
	ПолеФильтраВходящихПоОрганизациям.Вид = ВидПоляФормы.ПолеВвода;
	ПолеФильтраВходящихПоОрганизациям.Заголовок = "Организации";
	ПолеФильтраВходящихПоОрганизациям.ПутьКДанным = "ОрганизацииДляФильтраВходящих";
	//ПолеФильтраВходящихПоОрганизациям.УстановитьДействие("ПриИзменении", "ОбновитьСписокВходящихДокументовОбщее");
	ПолеФильтраВходящихПоОрганизациям.Доступность = Ложь;
	ПолеФильтраВходящихПоОрганизациям.Видимость = Ложь;
	
	// Поле фильтра входящих по контрагентам.
