		СтруктураХранения1С = ПолучитьСтруктуруХранения1С();
		СвойствоИдентификатор = СтруктураХранения1С.СвойствоИдентификатор;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ДополнительныеСведения.Значение КАК Идентификатор,
	               |	ДополнительныеСведения.Объект КАК Ссылка
	               |ИЗ
	               |	РегистрСведений.ЗначенияСвойствОбъектов КАК ДополнительныеСведения
	               |ГДЕ
	               |	ДополнительныеСведения.Свойство = &СвойствоИдентификатор
	               |	И ДополнительныеСведения.Значение В(&МассивИдентификаторов)";
	
	Запрос.УстановитьПараметр("МассивИдентификаторов", МассивИдентификаторов);
	Запрос.УстановитьПараметр("СвойствоИдентификатор", СвойствоИдентификатор);
	Результат = Запрос.Выполнить().Выбрать();
	
	ДокументыПоИдентификаторам = Новый Соответствие;
	
	Пока Результат.Следующий() Цикл 
		
		ДокументыПоИдентификаторам.Вставить(Результат.Идентификатор, Результат.Ссылка);
		
	КонецЦикла;
	
	Возврат ДокументыПоИдентификаторам;
	
КонецФункции	

&НаСервере
Функция ПолучитьСсылкуНаУчастникаПоИдентификаторуЭДО(Идентификатор, СвойствоИдентификатор = Неопределено, ЭтоОрганизация = Ложь)
	
	Если СвойствоИдентификатор = Неопределено Тогда
		СтруктураХранения1С = ПолучитьСтруктуруХранения1С();
		СвойствоИдентификатор = СтруктураХранения1С.СвойствоИдентификаторУчастника;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	ДополнительныеСведения.Объект КАК Ссылка
	               |ИЗ
	               |	РегистрСведений.ЗначенияСвойствОбъектов КАК ДополнительныеСведения
	               |ГДЕ
	               |	ДополнительныеСведения.Свойство = &СвойствоИдентификатор
	               |	И ДополнительныеСведения.Значение = &Идентификатор
	               |	И ДополнительныеСведения.Объект ССЫЛКА Справочник."+?(ЭтоОрганизация, "Организации", "Контрагенты");
	Запрос.УстановитьПараметр("СвойствоИдентификатор", СвойствоИдентификатор);
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Результат = Результат.Выбрать();
		Результат.Следующий();
		Возврат Результат.Ссылка;
	Иначе	
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции	

&НаСервере
Функция ПолучитьДоступныеОрганизации1С()
	
	ЗапросОрганизаций = Новый Запрос;
	ЗапросОрганизаций.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                          |	Организации.Ссылка,
	                          |	Организации.ПометкаУдаления,
	                          |	Организации.Предопределенный,
	                          |	Организации.ИНН,
	                          |	Организации.КПП
	                          |ИЗ
	                          |	Справочник.Организации КАК Организации
	                          |ГДЕ
	                          |	Организации.ПометкаУдаления = ЛОЖЬ";
	
	Результат = ЗапросОрганизаций.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Результат = Результат.Выбрать();
		МассивОрганизаций = Новый Массив;
		Пока Результат.Следующий() Цикл
			ДанныеПоОрганизации = Новый Структура;
			ДанныеПоОрганизации.Вставить("Ссылка", Результат.Ссылка);
			ДанныеПоОрганизации.Вставить("ИНН", Результат.ИНН);
			ДанныеПоОрганизации.Вставить("КПП", Результат.КПП);
			МассивОрганизаций.Добавить(ДанныеПоОрганизации);	
		КонецЦикла;
		Возврат МассивОрганизаций; 
	Иначе	
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции	

&НаСервере
Функция ПолучитьИдентификаторЭДОИз1СПоСсылке(Ссылка) Экспорт
	
	СтруктураХранения1С = ПолучитьСтруктуруХранения1С();
	СвойствоИдентификатор = СтруктураХранения1С.СвойствоИдентификаторУчастника;
	
	Если СвойствоИдентификатор = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не удалось определить дополнительное свойство для хранения идентификатора участника ЭДО. Отправка невозморжна.";
		Сообщение.Сообщить();
		Возврат Неопределено;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ДополнительныеСведения.Значение КАК Идентификатор
	|ИЗ
	|	РегистрСведений."+СтруктураХранения1С.НаименованиеРегистра+ " КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Свойство.Наименование = &НаименованиеСвойства
	|	И ДополнительныеСведения.Объект = &Ссылка";	
	Запрос.УстановитьПараметр("НаименованиеСвойства", СвойствоИдентификатор.Наименование);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Результат = Результат.Выбрать();
		Результат.Следующий();
		Возврат СокрЛП(Результат.Идентификатор);
	Иначе
		Возврат "";
	КонецЕсли;	
		
КонецФункции

&НаСервере
Функция ПолучитьИННКППНаименованиеУчастника(Участник)
	
	СтруктураОписанияУчастника = Новый Структура;
	СтруктураОписанияУчастника.Вставить("ИНН", Участник.ИНН);
	СтруктураОписанияУчастника.Вставить("КПП", Участник.КПП);
	СтруктураОписанияУчастника.Вставить("Наименование", Участник.Наименование);
	
	Возврат СтруктураОписанияУчастника;
	
КонецФункции

&НаСервере
Функция СоздатьИдентификаторЭДО(Участник)
	
	МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
	Идентификатор = МодульОбъектаОбработки.СоздатьИдентификаторЭДО(Участник); 
	
	Возврат Идентификатор;
	
КонецФункции

// Процедура для записи обновленных идентификаторов участников ЭДО
&НаСервере
Процедура ОбновитьИдентификаторыУчастниковЭДОНаСервере(СписокУчастников)
	
	Адрес = ЭтаФорма.АдресВременногоХранилищаКэш;
	
	ИмяМетаданных = "Конфигурация";
	Кэш = ПолучитьИзВременногоХранилища(Адрес);    
	
	Если Кэш.НастройкиОбъект[Кэш.ПрефиксКонфигурации+ИмяМетаданных] = Неопределено Тогда				
		ИнициализацияКэш(Истина);
		Кэш = ПолучитьИзВременногоХранилища(Адрес);		
	КонецЕсли;
	
	Настройка = Кэш.НастройкиОбъект[Кэш.ПрефиксКонфигурации+ИмяМетаданных].ХранениеИнформации1С;
	
	СтрокаВызоваСвойство 	= 	Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.ТипОбъектаМетаданных + "." + 
	Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Путь + ".НайтиПоНаименованию(" + Символ(034) + 
	Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Наименование + Символ(034) + ")";
	
	СвойствоСсылка = Вычислить(СтрокаВызоваСвойство);
	Если ЗначениеЗаполнено(СвойствоСсылка) Тогда
		
		Для Каждого Участник из СписокУчастников Цикл
			
			// Если контрагент не найден в ЭДО, то оставляем идентификатор, созданный вручную
			Если Участник.Идентификатор = "" Тогда  				
				Продолжить;				
			КонецЕсли;    			
			
			РегистрСведений 	= РегистрыСведений[Настройка.Путь];
			МенеджерЗаписи 		= РегистрСведений.СоздатьМенеджерЗаписи();
			
			МенеджерЗаписи.Объект	= Участник.Ссылка;
			МенеджерЗаписи.Свойство	= СвойствоСсылка;
			МенеджерЗаписи.Прочитать();
			
			Если МенеджерЗаписи.Выбран() Тогда
				
				Если МенеджерЗаписи.Значение <> Участник.Идентификатор Тогда
					МенеджерЗаписи.Значение = Участник.Идентификатор;				
					МенеджерЗаписи.Записать();
				КонецЕсли;
				
			Иначе
				
				МенеджерЗаписи.Объект	= Участник.Ссылка;
				МенеджерЗаписи.Свойство	= СвойствоСсылка;
				МенеджерЗаписи.Значение = Участник.Идентификатор;				
				МенеджерЗаписи.Записать();
				
			КонецЕсли;
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Идентификатор участника "+Участник.Ссылка+"("+Участник.ИНН+"/"+?(НЕ Участник.КПП = "", Участник.КПП, "без КПП")+") обновлен: "+Участник.Идентификатор;
			Сообщение.Сообщить();
			
		КонецЦикла;	
	Иначе 
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Возникла ошибка при обновлении идентификаторов контрагентов/организаций - не найдено свойство для хранения идентификаторов в 1С";
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область KeycloakВзаимодействие

&НаКлиенте
Функция RefreshTokens(RefreshToken)
	
	scope = "openid+groups+organization%3Aorg+upid+organization%3Aorg.write+profile+email";
	
	СтрокаПараметров = "grant_type=refresh_token&client_id=1c-sso&refresh_token="+RefreshToken+"&scope="+scope;
		
	headers = Новый Соответствие;
	headers.Вставить("Content-Type", "application/x-www-form-urlencoded");
	
	HTTPСоединение = Новый HTTPСоединение(""+ВедущийФрагментАдресаKeycloak+".platformaofd.ru", 443 ,,,, 15, Новый ЗащищенноеСоединениеOpenSSL);
	СтрокаЗапроса = "realms/"+realmФрагментАдресаKeycloak+"/protocol/openid-connect/token";
	
	Запрос = Новый HTTPЗапрос(СтрокаЗапроса, headers);
	
	Запрос.УстановитьТелоИзСтроки(СтрокаПараметров, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(Запрос);
	
	Если HTTPОтвет.КодСостояния = 200 Тогда
		Ответ = HTTPОтвет.ПолучитьТелоКакСтроку();
		Ответ = СтрЗаменить(Ответ, "not-before-policy", "not_before_policy");
		ЧтениеJSON = новый ЧтениеJSON();
		ЧтениеJSON.УстановитьСтроку(Ответ);
		Tokens = ПрочитатьJSON(ЧтениеJSON, Ложь);
		Возврат Tokens;
	 Иначе
		Сообщить("Произошла ошибка обращения к серверу," + "Токен не получен" +
				Символы.ПС + "Статус ответа сервера: " + HTTPОтвет.КодСостояния);
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

