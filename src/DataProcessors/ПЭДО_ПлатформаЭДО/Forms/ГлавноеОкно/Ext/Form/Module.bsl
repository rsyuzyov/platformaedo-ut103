&НаКлиенте
Процедура ОписаниеЗакрытияФормыВыбораДокументовДляМасовойОтправкиНеформалки(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатЗакрытия = Неопределено Тогда
		
		Для Каждого ОписаниеПФ из РезультатЗакрытия Цикл
			
			Если НЕ ЗначениеЗаполнено(ОписаниеПФ.ИдентификаторПолучателя) Тогда	
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Печатная форма """+ОписаниеПФ.ПредставлениеПечатнойФормы+""" по документу """+ОписаниеПФ.Документ+""""
						+Символы.ПС+"для получателя """+ОписаниеПФ.Получатель+""" не была сформирована и отправлена."
						+Символы.ПС+"Не задан идентификатор получателя. Обновите идентификатор контрагента через форму работы с абонентами.";
				Сообщение.Сообщить();
				Продолжить;	
			КонецЕсли;
			
			МассивОбъектов = Новый Массив();
			МассивОбъектов.Добавить(ОписаниеПФ.Документ);
	
			ИмяМенеджераПечати				= ОписаниеПФ.ИмяМенеджераПечати;
    		ИменаМакетов					= ?(ИмяМенеджераПечати = "СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки", "ВнешняяПечатнаяФорма."+ОписаниеПФ.ИмяМакета, ОписаниеПФ.ИмяМакета);
			ИдентификаторОтправителя		= ИдентификаторОрганизации;
			ИдентификаторПолучателя			= ОписаниеПФ.ИдентификаторПолучателя;
			ПараметрыПечати					= ?(ЗначениеЗаполнено(ОписаниеПФ.ДополнительныеПараметры), ОписаниеПФ.ДополнительныеПараметры, Новый Структура());
			ФорматФайла						= ?(ЗначениеЗаполнено(ОписаниеПФ.ФорматФайла), ОписаниеПФ.ФорматФайла, "pdf");
			ТипФорматаФайла					= ТипФайлаТабличногоДокумента.PDF;
			ДопустимыеТипыОбъектовПечати	= Неопределено;
			ИмяФайла						= СтрЗаменить(ОписаниеПФ.Документ, ":", ".")+" "+ИменаМакетов;
			
			ТабличныйДокументРезультат = ВызовФормированияПечатныхФормБСП(ИмяМенеджераПечати, ИменаМакетов, МассивОбъектов, ПараметрыПечати, ДопустимыеТипыОбъектовПечати);
			Если ТабличныйДокументРезультат = Неопределено Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Печатная форма """+ОписаниеПФ.ПредставлениеПечатнойФормы+""" по документу """+ОписаниеПФ.Документ+""""
						+Символы.ПС+"для получателя """+ОписаниеПФ.Получатель+""" не была сформирована и отправлена."
						+Символы.ПС+"Не удалось сформировать табличный документ.";
				Сообщение.Сообщить();
				Продолжить;
			КонецЕсли;
			
			Если ТабличныйДокументРезультат.ВысотаТаблицы = 0 Тогда
				// Пустой табличный документ.
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Печатная форма """+ОписаниеПФ.ПредставлениеПечатнойФормы+""" по документу """+ОписаниеПФ.Документ+""""
						+Символы.ПС+"для получателя """+ОписаниеПФ.Получатель+""" не была сформирована и отправлена."
						+Символы.ПС+"Эта печатная форма к указанному документу не применяется.";
				Сообщение.Сообщить();
				Продолжить;
			КонецЕсли;	
			
			Если ФорматФайла = "xlsx" Тогда
				ТипФорматаФайла = ТипФайлаТабличногоДокумента.XLSX;
			ИначеЕсли ФорматФайла = "docx" Тогда
				ТипФорматаФайла = ТипФайлаТабличногоДокумента.DOCX;
			ИначеЕсли ФорматФайла = "pdf" Тогда
				ТипФорматаФайла = ТипФайлаТабличногоДокумента.PDF;
			КонецЕсли;
			
			ПутьКОтправляемомуНеформализованномуОбъекту = КаталогВременныхФайлов()+ИмяФайла+"."+ФорматФайла;
			ТабличныйДокументРезультат.Записать(ПутьКОтправляемомуНеформализованномуОбъекту, ТипФорматаФайла);
			
			ОписаниеДокумента = Новый Структура;
			ОписаниеДокумента.Вставить("Заголовок", ОписаниеПФ.Заголовок);
			ОписаниеДокумента.Вставить("Номер", ОписаниеПФ.Номер);
			ОписаниеДокумента.Вставить("Дата", ОписаниеПФ.Дата);
			ОписаниеДокумента.Вставить("ВидДокумента", ОписаниеПФ.ВидДокумента); 
			ОписаниеДокумента.Вставить("ЗапрашиватьОтветнуюПодпись", ОписаниеПФ.ЗапрашиватьОтветнуюПодпись);
			
			СформироватьИОтправитьНеформализованныйДокументЧерезAPI(ПутьКОтправляемомуНеформализованномуОбъекту, ИдентификаторОтправителя, ИдентификаторПолучателя, Ложь, ИмяФайла, ОписаниеДокумента);	
			
			УдалитьФайлы(ПутьКОтправляемомуНеформализованномуОбъекту);
			
		КонецЦикла;		
			
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СкачатьДокументы

&НаКлиенте
Процедура СкачатьДокументы(Команда)
	
	// Определяем, входящие или исходящие документы требуется скачать.
	Если ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ИсхДокументы" Тогда
		МассивВыделенныхСтрок = Элементы["ТаблицаИсходящих"].ВыделенныеСтроки;
	ИначеЕсли ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ВхДокументы" Тогда
		МассивВыделенныхСтрок = Элементы["ТаблицаВходящих"].ВыделенныеСтроки;
	Иначе
		Возврат;
	КонецЕсли;
	
	//Массив, содержащий пути к документам для помещения в ZIP-архив
	МассивДокументов = Новый массив;
	
	Если МассивВыделенныхСтрок.Количество() <> 0 Тогда
		
		МассивИдентификаторов = Новый Массив;
		
		// Массив структур "Идентификатор ЭДО + статус ЭДО"
		Для Каждого Строка Из МассивВыделенныхСтрок Цикл
			ДанныеСтроки = ЭтаФорма[?(ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ИсхДокументы", "ИсхДокументы", "ВхДокументы")].НайтиПоИдентификатору(Строка);
			СтруктураИдентификатора = Новый Структура();
			СтруктураИдентификатора.Вставить("Идентификатор", ДанныеСтроки.id);
			СтруктураИдентификатора.Вставить("Статус", ДанныеСтроки.СтатусЭДО);
			СтруктураИдентификатора.Вставить("Неформализованный", ?(ДанныеСтроки.ТипДокумента = "Неформализованный", Истина, Ложь));
			СтруктураИдентификатора.Вставить("fileIdДокумента", ДанныеСтроки.fileIdДокумента);
			МассивИдентификаторов.Добавить(СтруктураИдентификатора);			
		КонецЦикла;	
		
		ПутьККаталогу = "";
		
		Для Каждого Элемент из МассивИдентификаторов Цикл 
			
			// Получение контента документа.
			ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса(); 
			ПараметрыЗапроса.Параметры.Вставить("<document_id>", Элемент.Идентификатор); 
			
			Если НЕ Элемент.Неформализованный Тогда
				ПолучениеКонтентаДокумента = ВыполнитьЗапросAPI("API_ПолучитьКонтентДокумента", ПараметрыЗапроса);
			Иначе
				ПолучениеКонтентаДокумента = ВыполнитьЗапросAPI("API_ПолучитьКонтентДокументаСWatermark", ПараметрыЗапроса);
				Если ПолучениеКонтентаДокумента.Ошибка И ПолучениеКонтентаДокумента.КодСостояния = 415 Тогда
					ПолучениеКонтентаДокумента = ВыполнитьЗапросAPI("API_ПолучитьКонтентДокумента", ПараметрыЗапроса);
				КонецЕсли;	
			КонецЕсли;	
			
			Если ПолучениеКонтентаДокумента.Ошибка Тогда  
				
				Сообщить("При попытке скачивания документа произошла ошибка:" + Элемент.Идентификатор + "(" + ПолучениеКонтентаДокумента.Описание + ")");
				
			Иначе
				
				СтруктураВозврата = ЗаписатьКонтентДокументаВФайл(ПутьККаталогу, ПолучениеКонтентаДокумента, Элемент);
				Если НЕ СтруктураВозврата.Свойство("Ошибка") тогда
					МассивДокументов.Добавить(ПутьККаталогу+"\"+Элемент.fileIdДокумента+"."+ СтруктураВозврата.ТипФайла);
				КонецЕсли;
				                   	
			КонецЕсли;
			
			// Получение pdf-версии документа. Только для формализованных.
			Если НЕ Элемент.Неформализованный Тогда
				
				ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса(); 
				ПараметрыЗапроса.Параметры.Вставить("<document_id>", Элемент.Идентификатор); 
				ПараметрыЗапроса.Заголовки.Вставить("accept", "application/pdf");
				
				ПолучениеКонтентаДокумента = ВыполнитьЗапросAPI("API_ПолучитьКонтентДокументаСWatermark", ПараметрыЗапроса);
				
				Если ПолучениеКонтентаДокумента.Ошибка Тогда
					Сообщить("При попытке скачивания документа в формате PDF произошла ошибка:" + Элемент.Идентификатор + "(" + ПолучениеКонтентаДокумента.Описание + ")");
				Иначе			
					ТипФайла = "pdf";
					ПолучениеКонтентаДокумента.Результат.Записать(ПутьККаталогу+"\"+Элемент.fileIdДокумента+"."+ТипФайла);
					МассивДокументов.Добавить(ПутьККаталогу+"\"+Элемент.fileIdДокумента+"."+ТипФайла);
				КонецЕсли;
			КонецЕсли;	
			
			//Получение квитанций
			ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
			ПараметрыЗапроса.Параметры.Вставить("<id>", Элемент.Идентификатор);
			
			ПолучениеЦепочкиДокумента = ВыполнитьЗапросAPI("API_ПолучитьЦепочкиДокументов", ПараметрыЗапроса);
			
			Если ПолучениеЦепочкиДокумента.Ошибка Тогда
				Сообщить("При попытке получения титула покупателя по документу произошла ошибка:" + Элемент.Идентификатор + "(" + ПолучениеЦепочкиДокумента.Описание + ")");
			Иначе
				
				ЦепочкаДокумента = ПолучениеЦепочкиДокумента.Результат[0];
				
				Если НЕ ЦепочкаДокумента.Свойство("slaves") = Ложь тогда	
					Если НЕ ЦепочкаДокумента.Свойство("slaves") = Неопределено Тогда
						
						Для Каждого ПодчиненныйДокумент Из ЦепочкаДокумента.slaves Цикл  
							
							ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
							ПараметрыЗапроса.Параметры.Вставить("<document_id>", Формат(ПодчиненныйДокумент.id, "ЧГ=0"));
							ПолучениеПодчиненногоДокумента = ВыполнитьЗапросAPI("API_ПолучитьКонтентДокумента", ПараметрыЗапроса);
							
							Если ПолучениеПодчиненногоДокумента.Ошибка Тогда
								Сообщить("При попытке скачивания подписи документа произошла ошибка:" + Элемент.Идентификатор + "(" + ПолучениеПодчиненногоДокумента.Описание + ")");
							Иначе
								
								Если НЕ ПутьККаталогу = "" Тогда
									ТипыФайловMIME = ЗаполнитьОбратноеСоответствиеТиповMIME();
									ТипФайла = ТипыФайловMIME.Получить(ПолучениеПодчиненногоДокумента.Тип);
									Если ТипФайла = Неопределено Тогда
										Сообщение = Новый СообщениеПользователю;
										Сообщение.Текст = "Для MIME-типа """+ПолучениеПодчиненногоДокумента.Тип+""" неизвестен соответствующий тип файла.";
										Сообщение.Сообщить();
										Возврат;
									КонецЕсли;
									ПутьСохранения = ПутьККаталогу+"\"+ПодчиненныйДокумент.fileId+"." + ТипФайла;
									ПолучениеПодчиненногоДокумента.Результат.Записать(ПутьСохранения);
									МассивДокументов.Добавить(ПутьСохранения);
								КонецЕсли;	
								
							КонецЕсли;
						КонецЦикла;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			
			// Если документ в статусе "Черновик", подпись выгружать не нужно.
			Если Элемент.Статус = 10 Тогда
				Продолжить;
			КонецЕсли;	
			
			// Получение подписи документа.
			ПолучениеПодписиДокумента = ВыполнитьЗапросAPI("API_ПолучитьПодписьДокумента", ПараметрыЗапроса);
			
			Если ПолучениеПодписиДокумента.Ошибка Тогда
				Сообщить("При попытке скачивания подписи документа произошла ошибка:" + Элемент.Идентификатор + "(" + ПолучениеПодписиДокумента.Описание + ")");
			Иначе
				
				Если НЕ ПутьККаталогу = "" Тогда
					ПолучениеПодписиДокумента.Результат.Записать(ПутьККаталогу+"\"+Элемент.fileIdДокумента+".p7s"); 
					МассивДокументов.Добавить(ПутьККаталогу+"\"+Элемент.fileIdДокумента+"."+"p7s");
				Иначе	
					Сообщить("Каталог для выгрузки не был выбран.");
					Возврат;
				КонецЕсли;	
				
			КонецЕсли;
			
			// Если документ подписан получателем, требуется скачать и его подпись.
			Если Элемент.Статус = 70 Тогда
				
				ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
				ПараметрыЗапроса.Параметры.Вставить("<id>", Элемент.Идентификатор);
				
				ПолучениеЦепочкиДокумента = ВыполнитьЗапросAPI("API_ПолучитьЦепочкиДокументов", ПараметрыЗапроса);
				
				Если ПолучениеЦепочкиДокумента.Ошибка Тогда
					Сообщить("При попытке получения титула покупателя по документу произошла ошибка:" + Элемент.Идентификатор + "(" + ПолучениеЦепочкиДокумента.Описание + ")");
				Иначе
					
					ЦепочкаДокумента = ПолучениеЦепочкиДокумента.Результат[0];
					
					// Ищем в цепочке титул покупателя.
					Если НЕ ЦепочкаДокумента.Свойство("slaves") = Неопределено Тогда
						
						Для Каждого ПодчиненныйДокумент Из ЦепочкаДокумента.slaves Цикл
							
							Если НЕ ЦепочкаДокумента.type = "UNFORMALIZED" И НЕ Прав(ПодчиненныйДокумент.type, 3) = "POK" И НЕ Прав(ПодчиненныйДокумент.type, 7) = "POKMARK" И НЕ ПодчиненныйДокумент.type = "DP_REZRUZAK" И НЕ ПодчиненныйДокумент.type = "DP_PRIRASXDOP" Тогда
								
								Продолжить;	
								
							ИначеЕсли ЦепочкаДокумента.type = "UNFORMALIZED" И НЕ ПодчиненныйДокумент.type = "UNFORMALIZED" Тогда	
								
								Продолжить;
								
							Иначе
								
								// Получаем подпись титула. 
								ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
								ПараметрыЗапроса.Параметры.Вставить("<document_id>", Формат(ПодчиненныйДокумент.id, "ЧГ=0"));
								ПолучениеПодписиДокумента = ВыполнитьЗапросAPI("API_ПолучитьПодписьДокумента", ПараметрыЗапроса);
								
								Если ПолучениеПодписиДокумента.Ошибка Тогда
									Сообщить("При попытке скачивания подписи документа произошла ошибка:" + Элемент.Идентификатор + "(" + ПолучениеПодписиДокумента.Описание + ")");
								Иначе
									
									Если НЕ ПутьККаталогу = "" Тогда
										ПолучениеПодписиДокумента.Результат.Записать(ПутьККаталогу+"\"+ПодчиненныйДокумент.fileId+".p7s"); 
										МассивДокументов.Добавить(ПутьККаталогу+"\"+ПодчиненныйДокумент.fileId+"."+"p7s");
									КонецЕсли;	
									
								КонецЕсли;
								
								Прервать;
								
							КонецЕсли;
							
						КонецЦикла;
						
					КонецЕсли;	
					
				КонецЕсли;	
				
			КонецЕсли;
			
			//Получение протокола ЭДО
			ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса(); 
			ПараметрыЗапроса.Параметры.Вставить("<document_id>", Элемент.Идентификатор); 
			
			ПолучениеПротоколаЭДО = ВыполнитьЗапросAPI("API_ПолучитьПротоколЭДОДокумента", ПараметрыЗапроса); 
			
			Если ПолучениеПротоколаЭДО.Ошибка тогда 
				Сообщить("При получении протокола ЭДО произошла ошибка:" + Элемент.Идентификатор + "(" + ПолучениеПротоколаЭДО.Описание + ")");
			Иначе
				Если НЕ ПутьККаталогу = "" Тогда
					ПолучениеПротоколаЭДО.Результат.Записать(ПутьККаталогу+"\"+Элемент.Идентификатор+ "(protocol)" + ".pdf"); 
					МассивДокументов.Добавить(ПутьККаталогу+"\"+Элемент.Идентификатор+ "(protocol)" +".pdf");
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если СкачиватьВАрхив тогда
			СохранитьКакАрхив(ПутьККаталогу, МассивДокументов)
		КонецЕсли;
		
	Иначе 
		Сообщить("Выберите хотя бы 1 документ для скачивания с помощью выделения строк (зажав на клавишу 'Ctrl' или 'Shift' можно выделить несколько документов).");
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СкачатьPDFДокументов(Команда)
	
	// Определяем, входящие или исходящие документы требуется скачать.
	Если ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ИсхДокументы" Тогда
		МассивВыделенныхСтрок = Элементы["ТаблицаИсходящих"].ВыделенныеСтроки;
	ИначеЕсли ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ВхДокументы" Тогда
		МассивВыделенныхСтрок = Элементы["ТаблицаВходящих"].ВыделенныеСтроки;
	Иначе
		Возврат;
	КонецЕсли;
	
	Если МассивВыделенныхСтрок.Количество() <> 0 Тогда
		
		МассивИдентификаторов = Новый Массив;
		
		// Массив структур "Идентификатор ЭДО + статус ЭДО"
		Для Каждого Строка Из МассивВыделенныхСтрок Цикл
			ДанныеСтроки = ЭтаФорма[?(ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ИсхДокументы", "ИсхДокументы", "ВхДокументы")].НайтиПоИдентификатору(Строка);
			СтруктураИдентификатора = Новый Структура();
			СтруктураИдентификатора.Вставить("Идентификатор", ДанныеСтроки.id);
			СтруктураИдентификатора.Вставить("Статус", ДанныеСтроки.СтатусЭДО);
			СтруктураИдентификатора.Вставить("Неформализованный", ?(ДанныеСтроки.ТипДокумента = "Неформализованный", Истина, Ложь));
			СтруктураИдентификатора.Вставить("fileIdДокумента", ДанныеСтроки.fileIdДокумента);
			МассивИдентификаторов.Добавить(СтруктураИдентификатора);			
		КонецЦикла;	
		
		ПутьККаталогу = "";
		МассивДляАрхива = Новый Массив;
		
		Для Каждого Элемент из МассивИдентификаторов Цикл 
			
			// Получение pdf-версии документа. Только для формализованных.
			Если НЕ Элемент.Неформализованный Тогда
				
				ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса(); 
				ПараметрыЗапроса.Параметры.Вставить("<document_id>", Элемент.Идентификатор); 
				ПараметрыЗапроса.Заголовки.Вставить("accept", "application/pdf");
				
				ПолучениеКонтентаДокумента = ВыполнитьЗапросAPI("API_ПолучитьКонтентДокументаСWatermark", ПараметрыЗапроса);
				
				Если ПолучениеКонтентаДокумента.Ошибка Тогда
					Сообщить("При попытке скачивания документа в формате PDF произошла ошибка:" + Элемент.Идентификатор + "(" + ПолучениеКонтентаДокумента.Описание + ")");
				Иначе
					
					Если ПутьККаталогу = "" Тогда
						РежимДиалога = РежимДиалогаВыбораФайла.ВыборКаталога; 
						ДиалогОткрытия = Новый ДиалогВыбораФайла(РежимДиалога); 
						ДиалогОткрытия.Каталог = ""; 
						ДиалогОткрытия.МножественныйВыбор = Ложь; 
						ДиалогОткрытия.Заголовок = "Выберите каталог";
						Если ДиалогОткрытия.Выбрать() Тогда
							ПутьККаталогу = ДиалогОткрытия.Каталог;
						КонецЕсли;
					КонецЕсли;
					
					ТипФайла = "pdf";
					ПолучениеКонтентаДокумента.Результат.Записать(ПутьККаталогу+"\"+Элемент.fileIdДокумента+"."+ТипФайла);
					
					Если СкачиватьВАрхив тогда
						МассивДляАрхива.Добавить(ПутьККаталогу+"\"+Элемент.fileIdДокумента+"."+ТипФайла);
					КонецЕсли
					
				КонецЕсли;
			Иначе
				Сообщить("Скачивание в формате PDF доступно только для формализованных документов");
			КонецЕсли;					
		КонецЦикла; 
		Если СкачиватьВАрхив тогда
			СохранитьКакАрхив(ПутьККаталогу, МассивДляАрхива);
		КонецЕсли;
	Иначе 
		Сообщить("Выберите хотя бы 1 документ для скачивания с помощью выделения строк (зажав на клавишу 'Ctrl' или 'Shift' можно выделить несколько документов).");
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

