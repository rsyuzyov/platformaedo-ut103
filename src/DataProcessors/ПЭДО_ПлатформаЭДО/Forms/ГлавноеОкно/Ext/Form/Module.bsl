// Функция возвращает ссылки на записи контрагентов для обновления
&НаСервере
Функция ПолучитьСписокКонтрагентовДляОбновления() Экспорт 
	
	Адрес = ЭтаФорма.АдресВременногоХранилищаКэш;
	
	ИмяМетаданных = "Конфигурация";
	
	Кэш = ПолучитьИзВременногоХранилища(Адрес);	
	Если Кэш = Неопределено Тогда
		ИнициализацияКэш(Истина);
		Кэш = ПолучитьИзВременногоХранилища(Адрес);
	КонецЕсли;		
	
	Если Кэш.НастройкиОбъект[Кэш.ПрефиксКонфигурации+ИмяМетаданных] = Неопределено Тогда				
		ИнициализацияКэш(Истина);
		Кэш = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаКэш);		
	КонецЕсли;
	
	Настройка = Кэш.НастройкиОбъект[Кэш.ПрефиксКонфигурации+ИмяМетаданных].ХранениеИнформации1С;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДополнительныеСведения.Объект КАК Ссылка,
	|	ДополнительныеСведения.Объект.ИНН КАК ИНН,
	|	ДополнительныеСведения.Объект.КПП КАК КПП
	|ИЗ
	|	" + Настройка.ТипОбъектаМетаданных + "."+Настройка.Путь+ " КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Свойство.Наименование = &НаименованиеСвойства";
	
	Запрос.УстановитьПараметр("НаименованиеСвойства", Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Наименование);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Массив = Новый Массив;
	
	Пока Результат.Следующий() Цикл
		
		Структура = Новый Структура; 		
		Структура.Вставить("Ссылка",	Результат.Ссылка);
		Структура.Вставить("ИНН", 		Результат.ИНН);
		Структура.Вставить("КПП",		Результат.КПП);
		
		Массив.Добавить(Структура);
		
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

// Функция возвращает количество записей регистра сведений, требуемых для обновления
&НаСервере
Функция ПолучитьКоличествоЗаписейСправочника(ДополнительныеПараметры) Экспорт 
	
	Адрес = ДополнительныеПараметры.АдресВременногоХранилищаКэш;
	
	ИмяМетаданных = "Конфигурация";
	Кэш = ПолучитьИзВременногоХранилища(Адрес);
	
	Если Кэш = Неопределено Тогда
		ИнициализацияКэш(Истина);
		Кэш = ПолучитьИзВременногоХранилища(Адрес);
	КонецЕсли;
	
	Если Кэш.НастройкиОбъект[Кэш.ПрефиксКонфигурации+ИмяМетаданных] = Неопределено Тогда				
		ИнициализацияКэш(Истина);
		Кэш = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаКэш);		
	КонецЕсли;
	
	Настройка = Кэш.НастройкиОбъект[Кэш.ПрефиксКонфигурации+ИмяМетаданных].ХранениеИнформации1С;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КОЛИЧЕСТВО(ДополнительныеСведения.Объект) КАК Всего
	|ИЗ
	|	" + Настройка.ТипОбъектаМетаданных + "."+Настройка.Путь+ " КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Свойство.Наименование = &НаименованиеСвойства";
	
	Запрос.УстановитьПараметр("НаименованиеСвойства", Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Наименование);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.Всего;
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ПеревестиСтатусAPIвСтатус1С(СтатусAPI)
	
	//На 19.02.2020 возможные статусы: NEW, DELETED, SIGNED, SENT, DELIVERED, ACCEPTED, REJECTED.
	Если СтатусAPI = "NEW" Тогда //Новый.
		Возврат 10; //Черновик
	ИначеЕсли СтатусAPI = "SIGNED" Тогда //Подписан отправителем, но не отправлен.
		Возврат 10;  //Черновик
	ИначеЕсли СтатусAPI = "AWAIT_PAYMENT" Тогда //Ожидает оплаты
		Возврат 11;
	ИначеЕсли СтатусAPI = "SENDING" Тогда //В процессе отправки
		Возврат 12;	
	ИначеЕсли СтатусAPI = "CANCELLED" Тогда //АннулированПредложено аннулирование
		Возврат 13;	
	ИначеЕсли СтатусAPI = "PreCancelledByThem" Тогда //Предложено аннулирование со стороны контрагента
		Возврат 14;
	ИначеЕсли СтатусAPI = "PreCancelledByUs" Тогда //Предложено аннулирование со стороны организации
		Возврат 15;
	ИначеЕсли СтатусAPI = "PreCancelled" Тогда //В списке отобразился сторонний документ, по нему предложено аннулирование
		Возврат 16;
	ИначеЕсли СтатусAPI = "CORRECTION_REQUESTED" Тогда // Запрос на уточнение
		Возврат 17;	
	ИначеЕсли СтатусAPI = "SENDING_FAILED" Тогда //Неизвестная и неожиданная ошибка.
		Возврат 22;
	ИначеЕсли СтатусAPI = "SENT" Тогда //Отправлен.
		Возврат 40; //Отправлен
	ИначеЕсли СтатусAPI = "DELIVERED" Тогда //Доставлен.
		Возврат 50; //Доставлен
	ИначеЕсли СтатусAPI = "SENT_TO_OPERATOR" Тогда //Отправлен оператору. Далее не ушел.
		Возврат 55;
	ИначеЕсли СтатусAPI = "ACCEPTED" Тогда //Подписан получателем.
		Возврат 70; //Подписан
	ИначеЕсли СтатусAPI = "REJECTED" Тогда //Отклонён.
		Возврат 60; //Отклонён                     	
	ИначеЕсли СтатусAPI = "DELETED" Тогда //Удалён.
		Возврат 90;	//Удалён
	КонецЕсли;
	
КонецФункции

