				//Квитанция
				IDКвитанции = "";
				КвитанцияУжеСуществуетИПодписана = Ложь;
				
				ПараметрыЗапросаФормированияКвитанции = ПолучитьШаблонПараметровЗапроса();
				ПараметрыЗапросаФормированияКвитанции.Параметры.Вставить("<document_id>", Идентификатор.Ключ);
				ПараметрыЗапросаФормированияКвитанции.Параметры.Вставить("<Тело>", СтрокаТелаДляФормированияКвитанций);
				РезультатФормированияКвитанции = ВыполнитьЗапросAPI("API_СформироватьКвитанциюОПолучении", ПараметрыЗапросаФормированияКвитанции);
				
				Если РезультатФормированияКвитанции.Ошибка Тогда				
					Если РезультатФормированияКвитанции.КодСостояния = 409 и НЕ Найти(РезультатФормированияКвитанции.Описание, "already exists and signed") = 0 Тогда 
						
						КвитанцияУжеСуществуетИПодписана = Истина;
						
					Иначе
						
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = "Не удалось сформировать техн. квитанцию для неформализованного документа с идентификатором "+Идентификатор.Ключ+"."+Символы.ПС+"Описание ошибки:";
						Сообщение.Сообщить();
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = РезультатФормированияКвитанции.Описание;
						Сообщение.Сообщить();
						Продолжить;
						
					КонецЕсли;				
				КонецЕсли;
				
				Если НЕ КвитанцияУжеСуществуетИПодписана Тогда
					
					IDКвитанции = Строка(Формат(РезультатФормированияКвитанции.Результат.id, "ЧГ="));	
					ПараметрыЗапросаПолученияКонтента = ПолучитьШаблонПараметровЗапроса();
					ПараметрыЗапросаПолученияКонтента.Параметры.Вставить("<document_id>", IDКвитанции);
					РезультатПолученияКонтента = ВыполнитьЗапросAPI("API_ПолучитьКонтентДокумента", ПараметрыЗапросаПолученияКонтента);
					
					Если РезультатПолученияКонтента.Ошибка Тогда
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = РезультатПолученияКонтента.Описание;
						Сообщение.Сообщить();
						Продолжить;
					КонецЕсли;	
					
					ВременныйФайл = ПолучитьИмяВременногоФайла("xml");
					РезультатПолученияКонтента.Результат.Записать(ВременныйФайл);
					Файл = Новый Файл(ВременныйФайл);
					
					Если НЕ Файл.Существует() Тогда
						
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = "Не удалось сохранить сформированный файл первой техн. квитанции для документа с идентификатором "+Идентификатор.Ключ+".";
						Сообщение.Сообщить();
						Продолжить;
						
					Иначе
						
						ПарольСертификата = ПарольДоступаКЗакрытомуКлючу;			
						
						ИмяФайлаПодписи = ПодписатьДокумент(Файл.ИмяБезРасширения, ВременныйФайл, Менеджер, Сертификат, ПарольСертификата, ".signature.p7b");				
						
						ПараметрыЗапросаПодписиКвитанции = ПолучитьШаблонПараметровЗапроса();
						ПараметрыЗапросаПодписиКвитанции.Параметры.Вставить("<document_id>", IDКвитанции);
						
						ПодписьДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаПодписи); 
						
						ЭлектроннаяПодписьCMSBase64 = Base64Строка(ПодписьДвоичныеДанные);
						ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ПС, "");
						ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ВК, "");
						ЭлектроннаяПодписьCMSвDERвURL = КодироватьBase64СтрокуВСтрокуURLНаСервере(ЭлектроннаяПодписьCMSBase64);
						
						СтруктураДанных = Новый Структура;
						СтруктураДанных.Вставить("value", ЭлектроннаяПодписьCMSBase64);
						Если ТипСубъектаПодписанта = "ФЛ" Тогда
							СтруктураPOA = Новый Структура;
							СтруктураPOA.Вставить("number", МчдGUIDПодписанта);
							СтруктураДанных.Вставить("poa", СтруктураPOA);
						КонецЕсли;
						ЗаписьJSON = Новый ЗаписьJSON;
						ЗаписьJSON.УстановитьСтроку();
						ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
						СтрокаТелаДляПередачиПодписи = ЗаписьJSON.Закрыть();
						ПараметрыЗапросаПодписиКвитанции.Параметры.Вставить("<Тело>", СтрокаТелаДляПередачиПодписи);
						
						РезультатПодписанияДокумента = ВыполнитьЗапросAPI("API_ПрикрепитьПодписьКДокументу", ПараметрыЗапросаПодписиКвитанции);
						
						Если РезультатПодписанияДокумента.Ошибка Тогда
							Сообщение = Новый СообщениеПользователю;
							Сообщение.Текст = "Техн. квитанция с идентификатором "+IDКвитанции+" была успешно сформирована, но не смолга быть подписана. Квитанции для документа с идентификатором " +Идентификатор.Ключ+Символы.ПС+ "Описание ошибки подписания:";
							Сообщение.Сообщить();
							Сообщение = Новый СообщениеПользователю;
							Сообщение.Текст = РезультатПодписанияДокумента.Описание;
							Сообщение.Сообщить();
							Продолжить;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
				// Удалить--
				// После 01.04.2026 квитанции не используются, используются УС --
				
			Иначе
				
				ID_УС1999 = "";
				УСУжеСуществует = Ложь;
				
				// Проверка наличия ИОП или УС 1999.
				IDДокумента = Формат(Идентификатор.Ключ, "ЧГ=");
				ПараметрыЗапросаЦепочкиДокумента = ПолучитьШаблонПараметровЗапроса();
				ПараметрыЗапросаЦепочкиДокумента.Параметры.Вставить("<id>", IDДокумента);
				РезультатЗапросаЦепочкиДокумента = ВыполнитьЗапросAPI("API_ПолучитьЦепочкиДокументов", ПараметрыЗапросаЦепочкиДокумента);
				
				Если РезультатЗапросаЦепочкиДокумента.Ошибка Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Для документа с идентификатором " +IDДокумента+" не удалось получить цепочку подчиненных документов."+Символы.ПС+ "Описание ошибки:";
					Сообщение.Сообщить();
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = РезультатЗапросаЦепочкиДокумента.Описание;
					Сообщение.Сообщить();
					Продолжить;				
				КонецЕсли;
				
				Если НЕ РезультатЗапросаЦепочкиДокумента.Результат.Количество() = 0 Тогда
					
					Если РезультатЗапросаЦепочкиДокумента.Результат[0].Свойство("slaves") И НЕ РезультатЗапросаЦепочкиДокумента.Результат[0].slaves.Количество() = 0 Тогда
						
						Для Каждого ПодчиненныйДокумент из РезультатЗапросаЦепочкиДокумента.Результат[0].slaves Цикл
							Если ПодчиненныйДокумент.type = "DP_IZVPOL" Тогда
								// Это ИОП по старому стандарту.
								// Удалить++
								Если ПодчиненныйДокумент.newStatus = "SENT" Тогда
									Если НЕ ТекущаяДата() >= РаботаПоУС_ДатаНачала Тогда
										УСУжеСуществует = Истина;
										Прервать;
									КонецЕсли;	
								КонецЕсли;
								// Удалить--
							ИначеЕсли ПодчиненныйДокумент.type = "DP_UNISOOBSCH" Тогда
								Если ПодчиненныйДокумент.newStatus = "SENT" И ПодчиненныйДокумент.universalMessageInfo.status = "ACK" Тогда
									УСУжеСуществует = Истина;
									Прервать;
								КонецЕсли;	
							КонецЕсли;	
						КонецЦикла;
						
					КонецЕсли;	
					
				КонецЕсли;
				
				Если НЕ УСУжеСуществует Тогда 
				
					СтрокаТелаДляФормированияУС = СоставитьУниверсальноеСообщение(Идентификатор.Значение.ИдентификаторОрганизации, Идентификатор.Значение.ИдентификаторКонтрагента, "ACK", СубъектСертификата);

					ПараметрыЗапросаФормированияКвитанции = ПолучитьШаблонПараметровЗапроса();
					ПараметрыЗапросаФормированияКвитанции.Параметры.Вставить("<document_id>", Идентификатор.Ключ);
					ПараметрыЗапросаФормированияКвитанции.Параметры.Вставить("<Тело>", СтрокаТелаДляФормированияУС);
					
					РезультатФормированияУС = ВыполнитьЗапросAPI("API_СформироватьУниверсальноеСообщение", ПараметрыЗапросаФормированияКвитанции);
					
					Если РезультатФормированияУС.Ошибка = Истина Тогда 
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = "Не удалось сформировать универсальное сообщение с уведомлением о получении для документа с идентификатором "+Идентификатор.Ключ+"."+Символы.ПС+"Описание ошибки:";
						Сообщение.Сообщить();
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = РезультатФормированияКвитанции1.Описание;
						Сообщение.Сообщить();
						Продолжить;
					КонецЕсли;	
				
				КонецЕсли;
				
			КонецЕсли;
			
			//Подписание документа.
			Если Идентификатор.Значение.Односторонний = Истина Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрыЗапросаПолученияКонтента = ПолучитьШаблонПараметровЗапроса();
			ПараметрыЗапросаПолученияКонтента.Параметры.Вставить("<document_id>", Идентификатор.Ключ);
			РезультатПолученияКонтента = ВыполнитьЗапросAPI("API_ПолучитьКонтентДокумента", ПараметрыЗапросаПолученияКонтента);
			
			Если РезультатПолученияКонтента.Ошибка Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = РезультатПолученияКонтента.Описание;
				Сообщение.Сообщить();
				Продолжить;
			КонецЕсли;
			
			ТипыФайловMIME = ЗаполнитьОбратноеСоответствиеТиповMIME();
			ТипФайла = ТипыФайловMIME.Получить(РезультатПолученияКонтента.Тип);
			Если ТипФайла = Неопределено Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Не удалось сохранить неформализованный файл документа с идентификатором "+Идентификатор.Ключ+".";
				Сообщение.Сообщить();
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Для MIME-типа """+РезультатПолученияКонтента.Тип+""" неизвестен соответствующий тип файла.";
				Сообщение.Сообщить();
				Продолжить;
			КонецЕсли;
			
			ВременныйФайл = ПолучитьИмяВременногоФайла(ТипФайла);
			РезультатПолученияКонтента.Результат.Записать(ВременныйФайл);
			Файл = Новый Файл(ВременныйФайл);
			
			Если НЕ Файл.Существует() Тогда
				
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Не удалось сохранить неформализованный файл документа с идентификатором "+Идентификатор.Ключ+".";
				Сообщение.Сообщить();
				Продолжить;
				
			Иначе
				
				ПарольСертификата = ПарольДоступаКЗакрытомуКлючу;			
				
				ИмяФайлаПодписи = ПодписатьДокумент(Файл.ИмяБезРасширения, ВременныйФайл, Менеджер, Сертификат, ПарольСертификата, ".signature.p7b");				
				
				ПараметрыПодписания = ПолучитьШаблонПараметровЗапроса();
				ПараметрыПодписания.Параметры.Вставить("<document_id>", Идентификатор.Ключ);
				
				ПодписьДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаПодписи); 
				
				ЭлектроннаяПодписьCMSBase64 = Base64Строка(ПодписьДвоичныеДанные);
				ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ПС, "");
				ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ВК, "");
				ЭлектроннаяПодписьCMSвDERвURL = КодироватьBase64СтрокуВСтрокуURLНаСервере(ЭлектроннаяПодписьCMSBase64);
				
				СтруктураДанных = Новый Структура;
				СтруктураДанных.Вставить("value", ЭлектроннаяПодписьCMSBase64);
				Если ТипСубъектаПодписанта = "ФЛ" Тогда
					СтруктураPOA = Новый Структура;
					СтруктураPOA.Вставить("number", МчдGUIDПодписанта);
					СтруктураДанных.Вставить("poa", СтруктураPOA);
				КонецЕсли;
				ЗаписьJSON = Новый ЗаписьJSON;
				ЗаписьJSON.УстановитьСтроку();
				ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
				СтрокаТелаДляПередачиПодписи = ЗаписьJSON.Закрыть();
				ПараметрыПодписания.Параметры.Вставить("<Тело>", СтрокаТелаДляПередачиПодписи);
				
				РезультатПодписанияДокумента = ВыполнитьЗапросAPI("API_ПрикрепитьПодписьКДокументу", ПараметрыПодписания);
				
				Если РезультатПодписанияДокумента.Ошибка Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Документ с идентификатором " +Идентификатор.Ключ+" не был подписан."+Символы.ПС+ "Описание ошибки подписания:";
					Сообщение.Сообщить();
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = РезультатПодписанияДокумента.Описание;
					Сообщение.Сообщить();
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьИзвещенияЧерезAPI(СписокИдентификаторовДокументов, ДатаПодписания = "") Экспорт // Удалить
	
	// После 01.04.2016 станет обязательно. УС ++
	Если РаботаемПоУС Тогда
		Сообщить("В режиме работы с УС, извещения неактуальны.");
		Возврат;
	КонецЕсли;
	// После 01.04.2016 станет обязательно. УС --
	
	Интеграция			= ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	Менеджер			= ПолучитьМенеджерКриптографии();
	Сертификат			= ПолучитьЭЦППоОтпечатку(Менеджер, Base64Значение(ОтпечатокСертификатаBase64));
	СубъектСертификата	= Сертификат.Субъект;
	
	ФамилияСубъекта			= СубъектСертификата.SN;
	ИмяОтчествоСубъекта 	= СтрРазделить(СубъектСертификата.GN, " ");
	ИмяСубъекта				= ИмяОтчествоСубъекта[0];
	ОтчествоСубъекта 		= ИмяОтчествоСубъекта[1];
	ДолжностьСубъекта		= ?(СубъектСертификата.Свойство("T"), ?(СубъектСертификата.T = "", "Индивидуальный предприниматель", СубъектСертификата.T), "Индивидуальный предприниматель");	
	
	// После 01.04.2016 станет нет нужно. УС ++
	Если НЕ РаботаемПоУС Тогда
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("position", ДолжностьСубъекта);
		СтруктураФИО = Новый Структура;
		СтруктураФИО.Вставить("first", ИмяСубъекта);            
		СтруктураФИО.Вставить("last", ФамилияСубъекта);
		СтруктураФИО.Вставить("middle", ОтчествоСубъекта);
		СтруктураДанных.Вставить("person", СтруктураФИО);	
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
		СтрокаТелаДляФормированияКвитанций = ЗаписьJSON.Закрыть();
	КонецЕсли;
	// После 01.04.2016 станет не нужно. УС --
	
	Для Каждого Идентификатор из СписокИдентификаторовДокументов Цикл
		
		//Квитанция
		IDКвитанции = "";
		КвитанцияУжеСуществуетИПодписана = Ложь;
		
		ПараметрыЗапросаФормированияКвитанции = ПолучитьШаблонПараметровЗапроса();
		ПараметрыЗапросаФормированияКвитанции.Параметры.Вставить("<document_id>", Идентификатор);
		ПараметрыЗапросаФормированияКвитанции.Параметры.Вставить("<Тело>", СтрокаТелаДляФормированияКвитанций);
		РезультатФормированияКвитанции = ВыполнитьЗапросAPI("API_СформироватьКвитанциюОПолучении", ПараметрыЗапросаФормированияКвитанции);
		
		Если РезультатФормированияКвитанции.Ошибка Тогда				
			Если РезультатФормированияКвитанции.КодСостояния = 409 и НЕ Найти(РезультатФормированияКвитанции.Описание, "already exists and signed") = 0 Тогда 
				
				КвитанцияУжеСуществуетИПодписана = Истина;
				
			Иначе
				
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Не удалось сформировать техн. квитанцию для неформализованного документа с идентификатором "+Идентификатор+"."+Символы.ПС+"Описание ошибки:";
				Сообщение.Сообщить();
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = РезультатФормированияКвитанции.Описание;
				Сообщение.Сообщить();
				Продолжить;
				
			КонецЕсли;				
		КонецЕсли;
		
