&НаКлиенте
Функция СкопироватьКоллекцию(ВходящаяКоллекция)
	
	Если ТипЗнч(ВходящаяКоллекция) = Тип("Структура") Тогда
		НоваяКоллекция = Новый Структура;
	ИначеЕсли ТипЗнч(ВходящаяКоллекция) = Тип("Соответствие") Тогда
		НоваяКоллекция = Новый Соответствие;
	КонецЕсли;
	
	Для Каждого ЭлементКоллекции из ВходящаяКоллекция Цикл
		
		Если ТипЗнч(ЭлементКоллекции.Значение) = Тип("Структура") ИЛИ ТипЗнч(ЭлементКоллекции.Значение) = Тип("Соответствие") Тогда				
			Значение = СкопироватьКоллекцию(ЭлементКоллекции.Значение);			
			НоваяКоллекция.Вставить(ЭлементКоллекции.Ключ, Значение);	
		Иначе
			НоваяКоллекция.Вставить(ЭлементКоллекции.Ключ, ЭлементКоллекции.Значение);
		КонецЕсли;
		
    КонецЦикла;
	
	Возврат НоваяКоллекция;
	
КонецФункции

&НаСервере
Функция Транслит(ВходящаяСтрока)
	
	ИтоговаяСтрока = "";
	
	СимволыТранслит = Новый Соответствие; 
	
	АнглийскиеБуквы = "A" "B" "V" "G" "D" "E" "Zh" "Z" "I" "Y" "K" "L" "M" "N" "O" "P" "R" "S" "T" "U" "F" "Kh" "Ts" "Ch" "Sh" "Shch" "" "Y" "" "E" "Yu" "Ya" "a" "b" "v" "g" "d" "e" "zh" "z" "i" "y" "k" "l" "m" "n" "o" "p" "r" "s" "t" "u" "f" "kh" "ts" "ch" "sh" "shch" "" "y" "" "e" "yu" "ya";
	
	Для КодБуквы = КодСимвола("А") По КодСимвола("я") Цикл
		СимволыТранслит.Вставить(Символ(КодБуквы), СтрПолучитьСтроку(АнглийскиеБуквы, КодБуквы - КодСимвола("А") + 1));
	КонецЦикла;
	
	СимволыТранслит.Вставить("ё","yo");
	СимволыТранслит.Вставить("Ё","Yo");
	
	Для Символ = 1 По СтрДлина(ВходящаяСтрока) Цикл
		Буква = Сред(ВходящаяСтрока, Символ, 1);
		БукваТранслит = СимволыТранслит.Получить(Буква);
		ИтоговаяСтрока = ИтоговаяСтрока + ?(БукваТранслит = Неопределено, Буква, БукваТранслит);
	КонецЦикла;
	
	Возврат ИтоговаяСтрока;
	
КонецФункции

