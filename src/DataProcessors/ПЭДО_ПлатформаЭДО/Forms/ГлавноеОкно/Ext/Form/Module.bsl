Функция ОпределитьНаправленностьДокумента(Элемент) 
	
	//Истина - oneWay = true
	//Ложь - по умолчанию
	Результат = Ложь;
	
	Если Элемент.type = "UNFORMALIZED" Тогда 
		Результат = Элемент.unformalizedDocInfo.oneWay; 
	Иначе
		
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		
		Макет = ОбработкаОбъект.ПолучитьМакет("СлужебныеДанные"); 
		
		Построитель = Новый ПостроительЗапроса;
		Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(Макет.Область("НастройкиФорматовДокументов"));
		Построитель.ДобавлениеПредставлений = ТипДобавленияПредставлений.НеДобавлять;
		Построитель.ЗаполнитьНастройки();
		Построитель.Выполнить();
		
		ТЗ = Построитель.Результат.Выгрузить(); 
		
		НайденнаяСтрока = ТЗ.Найти(Элемент.type);
		
		Если НЕ НайденнаяСтрока = Неопределено Тогда 
		
			Если НайденнаяСтрока.Односторонний = "+" И НайденнаяСтрока.Двусторонний = "+" тогда	
				//Доработать
				Результат = Ложь;
			ИначеЕсли НайденнаяСтрока.Односторонний = "+" И НайденнаяСтрока.Двусторонний = "-" тогда 
				Результат = Истина;	
			ИначеЕсли НайденнаяСтрока.Двусторонний = "+" И НайденнаяСтрока.Односторонний = "-" тогда
				Если Элемент.type = "ON_NSCHFDOPPR" ИЛИ Элемент.type = "ON_NKORSCHFDOPPR" Тогда
					Если Элемент.extra.function = "СЧФ" ИЛИ Элемент.extra.function = "КСЧФ" Тогда
						Результат = Истина;
					КонецЕсли;
				Иначе
					Результат = Ложь;
				КонецЕсли;	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

