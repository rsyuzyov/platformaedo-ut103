#Область ИнтеграцияAPI

&НаКлиенте
Процедура ВыгрузитьЧерезAPI(МассивДокументов, AccessToken) Экспорт
	
	ХранениеИнформацииВ1С = Ложь;
	
	// Получаем структуру свойств из настроек Кэш
	СтруктураХранения1С = ПолучитьСтруктуруХранения1С();
	Интеграция 			= ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	
	// Если по каким-то причинам не удалось найти свойства, то ничего не сохраняем
	Если 	СтруктураХранения1С <> Неопределено и ЗначениеЗаполнено(СтруктураХранения1С.СвойствоИдентификатор) и
		ЗначениеЗаполнено(СтруктураХранения1С.СвойствоСтатус) Тогда
		
		ХранениеИнформацииВ1С = Истина;
		
	КонецЕсли;
	
	Сообщить("Отправка документов начата: " + Строка(ТекущаяДата()));
	Для Каждого Документ из МассивДокументов Цикл
		
		Если Документ.ОшибкиФормирования = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Если Документ.Неформализованный = Ложь Тогда
			
			//Формализованный.
			
			ДокументВыгрузки = Документ.Ссылка;
			
			Если Документ.ФорматФормализованного = "ON_NSCHFDOPPR" ИЛИ Документ.ФорматФормализованного = "ON_NKORSCHFDOPPR" Тогда			
				Если ОбъектПрисутствуетВМетаданных("Документ.СчетФактураВыданный") Тогда
					Если ТипЗнч(ДокументВыгрузки) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
						Если ОбъектПрисутствуетВМетаданных("Документ.СчетФактураВыданный.ДокументОснование") Тогда
							ДокументВыгрузки = ЗначениеРеквизитаОбъекта(ДокументВыгрузки, "ДокументОснование");							
						ИначеЕсли ОбъектПрисутствуетВМетаданных("Документ.СчетФактураВыданный.ТабличныеЧасти.ДокументыОснования") Тогда
							Если Документ.ДокументыОснования.Количество() = 1 Тогда
								ДокументВыгрузки = Документ.ДокументыОснования[0].ДокументОснование; 
							КонецЕсли;	
						КонецЕсли;	
					КонецЕсли;		
				ИначеЕсли НЕ ОбъектПрисутствуетВМетаданных("Документ.СчетФактура") Тогда				
					Если ТипЗнч(ДокументВыгрузки) = Тип("ДокументСсылка.СчетФактура") Тогда
						Если ОбъектПрисутствуетВМетаданных("Документ.СчетФактура.ДокументОснование") Тогда
							ДокументВыгрузки = ЗначениеРеквизитаОбъекта(ДокументВыгрузки, "ДокументОснование");
						ИначеЕсли ОбъектПрисутствуетВМетаданных("Документ.СчетФактура.ТабличныеЧасти.ДокументыОснования") Тогда
							Если Документ.ДокументыОснования.Количество() = 1 Тогда
								ДокументВыгрузки = Документ.ДокументыОснования[0].ДокументОснование;
							КонецЕсли;	
						КонецЕсли;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
			
			ИдентификаторОтправителяСоответствуетОтправителю = ИдентификаторСоответствуетУчастнику1С(Документ.ОтправительСсылка, Документ.ИдентификаторОтправителя, Документ.Ссылка, Истина);
			ИдентификаторПолучателяСоответствуетПолучателю = ИдентификаторСоответствуетУчастнику1С(Документ.ПолучательСсылка, Документ.ИдентификаторПолучателя, Документ.Ссылка);
			
			Если ИдентификаторОтправителяСоответствуетОтправителю = Ложь ИЛИ ИдентификаторПолучателяСоответствуетПолучателю = Ложь Тогда
				Продолжить;
			КонецЕсли;	
			
			Файл = Новый ТекстовыйДокумент();                           
			Файл.ДобавитьСтроку(Документ.Выгрузка);
			Попытка
				
				Каталог 			= КаталогВременныхФайлов();
				ПолноеИмяФайла 		= Каталог + Документ.ИмяФайла +".xml";
				Файл.Записать(ПолноеИмяФайла, "windows-1251");
				
				Документ.ПолноеИмяФайла = ПолноеИмяФайла;
				
			Исключение  
				//Документ.СтатусЭДО = "Ошибка записи документа";
				Документ.СтатусЭДО = 24;
				
				Если ХранениеИнформацииВ1С Тогда   		
					// Статус документа
					ПараметрыЗаписи = ПолучитьСтруктуруПараметровЗаписиВРегистрСведений();
					
					ПараметрыЗаписи.НаименованиеРегистра	= СтруктураХранения1С.НаименованиеРегистра;
					ПараметрыЗаписи.Объект 					= Документ.Ссылка;
					ПараметрыЗаписи.Свойство 				= СтруктураХранения1С.СвойствоСтатус;
					ПараметрыЗаписи.Значение 				= Документ.СтатусЭДО;
					
					Документ.ХранениеИнформации1С.СтатусЭДО = ЗаписьВРегистрСведений(ПараметрыЗаписи);
					// Статус документа   
				КонецЕсли;  
				
				Сообщить("Ошибка записи документа");
				Продолжить;
			КонецПопытки;  
			
			ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса(); 
			ПараметрыЗапроса.Параметры.Вставить("<Тело>", ПолноеИмяФайла);  
			
			Если ЗначениеЗаполнено(ПредставлениеТекущейКонфигурации) Тогда
				ПараметрыЗапроса.Заголовки.Вставить("x-client-id", ПредставлениеТекущейКонфигурации);	
			КонецЕсли;	
			
			ЗагрузкаДокумента = ВыполнитьЗапросAPI("API_ЗагрузитьДокумент_ИмяФайлаТела", ПараметрыЗапроса);
			
			Документ.ЗагрузкаДокумента = ЗагрузкаДокумента;
			
			Если Не ЗагрузкаДокумента.Ошибка Тогда
				Документ.ИдентификаторЭДО = СтрЗаменить(Строка(ЗагрузкаДокумента.Результат.id)," ","");
				//Документ.СтатусЭДО = "Черновик";
				Документ.СтатусЭДО = 10;
			Иначе
				//Документ.СтатусЭДО = "Ошибка загрузки"; 
				Документ.СтатусЭДО = 21;
				Если ХранениеИнформацииВ1С Тогда
					// Статус документа
					ПараметрыЗаписи = ПолучитьСтруктуруПараметровЗаписиВРегистрСведений();
					
					ПараметрыЗаписи.НаименованиеРегистра	= СтруктураХранения1С.НаименованиеРегистра;
					ПараметрыЗаписи.Объект 					= Документ.Ссылка;
					ПараметрыЗаписи.Свойство 				= СтруктураХранения1С.СвойствоСтатус;
					ПараметрыЗаписи.Значение 				= Документ.СтатусЭДО;
					
					Документ.ХранениеИнформации1С.СтатусЭДО = ЗаписьВРегистрСведений(ПараметрыЗаписи);
					// Статус документа 
				КонецЕсли; 
				Сообщить(ЗагрузкаДокумента.Описание);
				Продолжить;
			КонецЕсли;      		
			
			Если ХранениеИнформацииВ1С Тогда
				// Статус документа
				ПараметрыЗаписи = ПолучитьСтруктуруПараметровЗаписиВРегистрСведений();
				
				ПараметрыЗаписи.НаименованиеРегистра	= СтруктураХранения1С.НаименованиеРегистра;
				ПараметрыЗаписи.Объект 					= Документ.Ссылка;
				ПараметрыЗаписи.Свойство 				= СтруктураХранения1С.СвойствоСтатус;
				ПараметрыЗаписи.Значение 				= Документ.СтатусЭДО;
				
				Документ.ХранениеИнформации1С.СтатусЭДО = ЗаписьВРегистрСведений(ПараметрыЗаписи);
				// Статус документа 
				
				// Идентификатор документа
				ПараметрыЗаписи = ПолучитьСтруктуруПараметровЗаписиВРегистрСведений();
				
				ПараметрыЗаписи.НаименованиеРегистра	= СтруктураХранения1С.НаименованиеРегистра;
				ПараметрыЗаписи.Объект 					= Документ.Ссылка;
				ПараметрыЗаписи.Свойство 				= СтруктураХранения1С.СвойствоИдентификатор;
				ПараметрыЗаписи.Значение 				= Документ.ИдентификаторЭДО;
				
				Документ.ХранениеИнформации1С.СтатусЭДО = ЗаписьВРегистрСведений(ПараметрыЗаписи);
				// Идентификатор документа 			
			КонецЕсли;
			
			Если ИспользоватьПодписание Тогда
				
				Менеджер 	= ПолучитьМенеджерКриптографии();
				ЭЦП			= ПолучитьЭЦППоОтпечатку(Менеджер, Base64Значение(ОтпечатокСертификатаBase64));			
				
				Если ПодписантСоответсвуетЭЦП(Документ.Подписант, ЭЦП) Тогда
					ПарольСертификата = ПарольДоступаКЗакрытомуКлючу;				
					ИмяФайлаПодписи = ПодписатьДокумент(Документ.ИмяФайла, Документ.ПолноеИмяФайла, Менеджер, ЭЦП, ПарольСертификата, ".signature.p7b");
				Иначе
					Сообщить("Подписант не соответствует используемой ЭЦП.");
					Продолжить;
				КонецЕсли; 
				
				Если ИмяФайлаПодписи = Неопределено Тогда
					Продолжить;				
				КонецЕсли;
				
				ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
				ПараметрыЗапроса.Параметры.Вставить("<document_id>", Документ.ИдентификаторЭДО); 
				
				ПодписьДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаПодписи); 
				
				ЭлектроннаяПодписьCMSBase64 = Base64Строка(ПодписьДвоичныеДанные);
				ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ПС, "");
				ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ВК, "");
				ЭлектроннаяПодписьCMSвDERвURL = КодироватьBase64СтрокуВСтрокуURLНаСервере(ЭлектроннаяПодписьCMSBase64);
				
				СтруктураДанных = Новый Структура;
				СтруктураДанных.Вставить("value", ЭлектроннаяПодписьCMSBase64);
				Если ТипСубъектаПодписанта = "ФЛ" Тогда
					СтруктураPOA = Новый Структура;
					СтруктураPOA.Вставить("number", МчдGUIDПодписанта);
					СтруктураДанных.Вставить("poa", СтруктураPOA);
				КонецЕсли;
				ЗаписьJSON = Новый ЗаписьJSON;
				ЗаписьJSON.УстановитьСтроку();
				ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
				СтрокаТелаДляПередачиПодписи = ЗаписьJSON.Закрыть();
				ПараметрыЗапроса.Параметры.Вставить("<Тело>", СтрокаТелаДляПередачиПодписи);
				ПодписаниеДокумента = ВыполнитьЗапросAPI("API_ПрикрепитьПодписьКДокументу" ,ПараметрыЗапроса);	
				
				Документ.ПодписаниеДокумента = ПодписаниеДокумента;
				
				Если Не ПодписаниеДокумента.Ошибка Тогда
					//Документ.СтатусЭДО = "Отправлен";
					Документ.СтатусЭДО = 40;
					//эво_ОбщегоНазначения.ЗаписатьСобытиеВЖурналСобытий(ДокументВыгрузки, "Документ успешно отправлен.", , Документ.ИдентификаторЭДО, "Документ успешно отправлен вручную через обработку ЭДО.", Истина, , ПользователиКлиентСервер.ТекущийПользователь(), Ложь, , Документ.ФорматФормализованного);
				Иначе         				
					//Документ.СтатусЭДО = "Ошибка подписания";
					Документ.СтатусЭДО = 23; 
					Сообщить(ПодписаниеДокумента.Описание);
				КонецЕсли; 
				
				Если ХранениеИнформацииВ1С Тогда
					// Статус документа
					ПараметрыЗаписи = ПолучитьСтруктуруПараметровЗаписиВРегистрСведений();
					
					ПараметрыЗаписи.НаименованиеРегистра	= СтруктураХранения1С.НаименованиеРегистра;
					ПараметрыЗаписи.Объект 					= Документ.Ссылка;
					ПараметрыЗаписи.Свойство 				= СтруктураХранения1С.СвойствоСтатус;
					ПараметрыЗаписи.Значение 				= Документ.СтатусЭДО;
					
					Документ.ХранениеИнформации1С.СтатусЭДО = ЗаписьВРегистрСведений(ПараметрыЗаписи);
					// Статус документа 
				КонецЕсли;
				
				УдалитьФайлы(ИмяФайлаПодписи);
				
			КонецЕсли;		
			
			УдалитьФайлы(ПолноеИмяФайла);   		
			
		Иначе
			
			// Неформалка.	
			Если Документ.ДвоичныеДанные = Ложь Тогда
				
				// Табличный документ.
				ТабличныйДокумент = Документ.Выгрузка;
				
				ЗапрашиваемыйФорматФайла = Документ.ФорматФайла;
				
				Если НЕ Лев(ЗапрашиваемыйФорматФайла, 1) = "." Тогда
					ЗапрашиваемыйФорматФайла = "."+ЗапрашиваемыйФорматФайла;
				КонецЕсли;	
				
				Если ЗапрашиваемыйФорматФайла = ".xlsx" Тогда
					ТипФорматаФайла = ТипФайлаТабличногоДокумента.XLSX;
					ФорматФайла = ЗапрашиваемыйФорматФайла;
				ИначеЕсли ЗапрашиваемыйФорматФайла = ".docx" Тогда
					ТипФорматаФайла = ТипФайлаТабличногоДокумента.DOCX;
					ФорматФайла = ЗапрашиваемыйФорматФайла;
				ИначеЕсли ЗапрашиваемыйФорматФайла = ".pdf" Тогда
					ТипФорматаФайла = ТипФайлаТабличногоДокумента.PDF;
					ФорматФайла = ".pdf";
				КонецЕсли;
				
				ИмяФайла = СтрЗаменить(Документ.ЗаголовокНеформализованного, ":", ".");
				
				ИдентификаторОтправителя	= Документ.ИдентификаторОтправителя;
				ИдентификаторПолучателя		= Документ.ИдентификаторПолучателя;
				
				// Проверяем указанные идентификаторы отправителя и получателя на существование и соответствие.
				ОтправительСсылка	= ПолучитьСсылкуНаУчастникаПоИдентификаторуЭДО(ИдентификаторОтправителя);
				ПолучательСсылка	= ПолучитьСсылкуНаУчастникаПоИдентификаторуЭДО(ИдентификаторПолучателя);
				
				ИдентификаторОтправителяСоответствуетОтправителю	= ИдентификаторСоответствуетУчастнику1С(ОтправительСсылка, ИдентификаторОтправителя, Документ.ЗаголовокНеформализованного, Истина);
				ИдентификаторПолучателяСоответствуетПолучателю		= ИдентификаторСоответствуетУчастнику1С(ПолучательСсылка, ИдентификаторПолучателя, Документ.ЗаголовокНеформализованного);
				
				Если ИдентификаторОтправителяСоответствуетОтправителю = Ложь ИЛИ ИдентификаторПолучателяСоответствуетПолучателю = Ложь Тогда 
               		Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Не удалось выгрузить неформализованный документ """+Документ.ЗаголовокНеформализованного+"""."+Символы.ПС;
					Сообщение.Сообщить();
					Продолжить;
				КонецЕсли;	
				
				ПутьКОтправляемомуНеформализованномуОбъекту = КаталогВременныхФайлов()+ИмяФайла+ФорматФайла;
				ТабличныйДокумент.Записать(ПутьКОтправляемомуНеформализованномуОбъекту, ТипФорматаФайла);
				
				СформироватьИОтправитьНеформализованныйДокументЧерезAPI(ПутьКОтправляемомуНеформализованномуОбъекту, ИдентификаторОтправителя, ИдентификаторПолучателя, Истина, ИмяФайла);	
				
				УдалитьФайлы(ПутьКОтправляемомуНеформализованномуОбъекту);
				
			Иначе
				
				// Задел на отправку произвольных файлов.
				
			КонецЕсли;	
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Сообщить("Отправка документов закончена: " + Строка(ТекущаяДата()));
	
	// Обновим динамический список, если была запись статусов в 1С
	Если ХранениеИнформацииВ1С Тогда
		ТекущаяСтраница = ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя;
		Элементы["ДинамическийСписок"+ТекущаяСтраница].Обновить();
	КонецЕсли;
	
	//Сообщить("Динамический список обновлен: " + Строка(ТекущаяДата()));
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправитьНеформализованныйДокументЧерезAPI(ПутьКОтправляемомуФайлу = "", ИдентификаторОтправителя = "", ИдентификаторПолучателя = "", ОтправкаДополнительногоОбъекта = Ложь, ИмяДокумента = "", СтруктураДопПарамтеровНеформализованногоДокумента = Неопределено) Экспорт  
		
	Если ПутьКОтправляемомуФайлу = "" Тогда
		Сообщение = Новый СообщениеПользователю;
		Если ЗначениеЗаполнено(ИмяДокумента) Тогда
			Сообщение.Текст = "Не был определен путь к отправляемому неформализованному документу """+ИмяДокумента+"""!";
		Иначе
			Сообщение.Текст = "Не был указан путь к отправляемому неформализованному объекту!";
		КонецЕсли;	
		Сообщение.Сообщить();
		Возврат; 	
	КонецЕсли;	
	
	Если ИдентификаторОтправителя = "" Тогда
		Сообщение = Новый СообщениеПользователю;
		Если ЗначениеЗаполнено(ИмяДокумента) Тогда 
			Сообщение.Текст = "Не был опеределен идентификатор отправителя отправляемого неформализованного документа """+ИмяДокумента+"""!";	
		Иначе
			Сообщение.Текст = "Не был опеределен идентификатор отправителя отправляемого неформализованного объекта!";
		КонецЕсли;	
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторОтправителя = "" Тогда
		Сообщение = Новый СообщениеПользователю;
		Если ЗначениеЗаполнено(ИмяДокумента) Тогда
			Сообщение.Текст = "Не был опеределен идентификатор получателя отправляемого неформализованного документа """+ИмяДокумента+"""!";
		Иначе
			Сообщение.Текст = "Не был опеределен идентификатор получателя отправляемого неформализованного объекта!";
		КонецЕсли;	
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	РасширениеФайла = Прав(ПутьКОтправляемомуФайлу, СтрДлина(ПутьКОтправляемомуФайлу)-СтрНайти(ПутьКОтправляемомуФайлу, ".", НаправлениеПоиска.СКонца));
	ТипыMIME = ЗаполнитьСоответствиеТиповMIME();
	ТипКонтентаMIME = ТипыMIME.Получить(РасширениеФайла);
	
	Если ТипКонтентаMIME = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Расширение выбранного файла не поддерживается.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;	
	
	ТипДокумента = "UNFORMALIZED";
	ВидДокумента = "Неформализованный";
	ЗаголовокДокумента = ИмяДокумента;
	НомерДокумента = "";
	ДатаДокумента = "";
	
	Если НЕ СтруктураДопПарамтеровНеформализованногоДокумента = Неопределено Тогда
		ЗаголовокДокумента = СтруктураДопПарамтеровНеформализованногоДокумента.Заголовок;
		ВидДокумента = СтруктураДопПарамтеровНеформализованногоДокумента.ВидДокумента;
		НомерДокумента = СтруктураДопПарамтеровНеформализованногоДокумента.Номер;
		ДатаДокумента = СтруктураДопПарамтеровНеформализованногоДокумента.Дата; 
		ЗапрашиватьОтветнуюПодпись = СтруктураДопПарамтеровНеформализованногоДокумента.ЗапрашиватьОтветнуюПодпись;
	КонецЕсли;	
	
	ИмяФайла = Прав(Лев(ПутьКОтправляемомуФайлу, СтрДлина(ПутьКОтправляемомуФайлу)-(СтрДлина(РасширениеФайла)+1)), СтрДлина(Лев(ПутьКОтправляемомуФайлу, СтрДлина(ПутьКОтправляемомуФайлу)-(СтрДлина(РасширениеФайла)+1)))-СтрНайти(Лев(ПутьКОтправляемомуФайлу, СтрДлина(ПутьКОтправляемомуФайлу)-(СтрДлина(РасширениеФайла)+1)), "\", НаправлениеПоиска.СКонца));
	
	Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	
	ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();	    
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписьJSON.ЗаписатьИмяСвойства("senderGid");
	ЗаписьJSON.ЗаписатьЗначение(ИдентификаторОтправителя); 
	ЗаписьJSON.ЗаписатьИмяСвойства("recipientGid");
	ЗаписьJSON.ЗаписатьЗначение(ИдентификаторПолучателя); 
	ЗаписьJSON.ЗаписатьИмяСвойства("type");
	ЗаписьJSON.ЗаписатьЗначение(ТипДокумента);
	Если ЗначениеЗаполнено(ЗаголовокДокумента) Тогда
		ЗаписьJSON.ЗаписатьИмяСвойства("topic");
		ЗаписьJSON.ЗаписатьЗначение(ЗаголовокДокумента + "." + РасширениеФайла);
	КонецЕсли;
	Если ЗначениеЗаполнено(НомерДокумента) Тогда
		ЗаписьJSON.ЗаписатьИмяСвойства("docNum");
		ЗаписьJSON.ЗаписатьЗначение(НомерДокумента);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаДокумента) Тогда
		ЗаписьJSON.ЗаписатьИмяСвойства("docDate");
		ЗаписьJSON.ЗаписатьЗначение(Строка(Формат(ДатаДокумента, "ДФ=dd.MM.yyyy")));
	КонецЕсли;
	Если ЗначениеЗаполнено(ВидДокумента) Тогда
		ЗаписьJSON.ЗаписатьИмяСвойства("labels");
		ЗаписьJSON.ЗаписатьНачалоМассива();
		ЗаписьJSON.ЗаписатьЗначение(""+ВидДокумента+"");
		ЗаписьJSON.ЗаписатьКонецМассива();
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗапрашиватьОтветнуюПодпись) Тогда
		ЗаписьJSON.ЗаписатьИмяСвойства("oneWay");
		ЗаписьJSON.ЗаписатьЗначение(?(ЗапрашиватьОтветнуюПодпись = Истина, "false", "true"));
	КонецЕсли;
	
	ЗаписьJSON.ЗаписатьКонецОбъекта();	    
	СтрокаТела = СтрЗаменить(ЗаписьJSON.Закрыть(), "\", "");
	
	ПараметрыЗапроса.Параметры.Вставить("<Тело>", СтрокаТела);
	
	Если ЗначениеЗаполнено(ПредставлениеТекущейКонфигурации) Тогда
		ПараметрыЗапроса.Заголовки.Вставить("x-client-id", ПредставлениеТекущейКонфигурации);	
	КонецЕсли;
		
	РезультатОтправкиНеформализованногоДокумента = ВыполнитьЗапросAPI("API_ЗагрузитьДокумент_ТелоИзСтроки", ПараметрыЗапроса);
		
	Если НЕ РезультатОтправкиНеформализованногоДокумента.Ошибка Тогда
		
		ДвоичнаяСтрокаФайла = Новый ДвоичныеДанные(ПутьКОтправляемомуФайлу);
		
		ИдентификаторПодготовленногоНеформализованногоДокумента = Формат(РезультатОтправкиНеформализованногоДокумента.Результат.id, "ЧГ=0");
		
		ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
		ПараметрыЗапроса.Параметры.Вставить("<document_id>", ИдентификаторПодготовленногоНеформализованногоДокумента);
		ПараметрыЗапроса.Параметры.Вставить("<Тело>", ДвоичнаяСтрокаФайла);
		ПараметрыЗапроса.Заголовки.Вставить("Content-Type", ТипКонтентаMIME);
		РезультатЗагрузкиКонтента = ВыполнитьЗапросAPI("API_ЗагрузитьКонтентВДокумент", ПараметрыЗапроса);
		
		Если НЕ РезультатЗагрузкиКонтента.Ошибка Тогда		
			
			Если ИспользоватьПодписание Тогда
			
				Менеджер 	= ПолучитьМенеджерКриптографии();
				ЭЦП			= ПолучитьЭЦППоОтпечатку(Менеджер, Base64Значение(ОтпечатокСертификатаBase64));			
				
				ПарольСертификата = ПарольДоступаКЗакрытомуКлючу;
								
				ИмяФайлаПодписи = ПодписатьДокумент(ИмяФайла, ПутьКОтправляемомуФайлу, Менеджер, ЭЦП, ПарольСертификата, ".signature.p7b");
							
				ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
				ПараметрыЗапроса.Параметры.Вставить("<document_id>", ИдентификаторПодготовленногоНеформализованногоДокумента);
				
				ПодписьДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаПодписи);
				
				ЭлектроннаяПодписьCMSBase64 = Base64Строка(ПодписьДвоичныеДанные);
				ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ПС, "");
				ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ВК, "");
				ЭлектроннаяПодписьCMSвDERвURL = КодироватьBase64СтрокуВСтрокуURLНаСервере(ЭлектроннаяПодписьCMSBase64);
				
				СтруктураДанных = Новый Структура;
				СтруктураДанных.Вставить("value", ЭлектроннаяПодписьCMSBase64);
				Если ТипСубъектаПодписанта = "ФЛ" Тогда
					СтруктураPOA = Новый Структура;
					СтруктураPOA.Вставить("number", МчдGUIDПодписанта);
					СтруктураДанных.Вставить("poa", СтруктураPOA);
				КонецЕсли;
				ЗаписьJSON = Новый ЗаписьJSON;
				ЗаписьJSON.УстановитьСтроку();
				ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
				СтрокаТелаДляПередачиПодписи = ЗаписьJSON.Закрыть();
				ПараметрыЗапроса.Параметры.Вставить("<Тело>", СтрокаТелаДляПередачиПодписи);
				
				РезультатПодписанияДокумента = ВыполнитьЗапросAPI("API_ПрикрепитьПодписьКДокументу", ПараметрыЗапроса); 
				
				Если РезультатПодписанияДокумента.Ошибка Тогда
					Сообщение = Новый СообщениеПользователю;
					Если ЗначениеЗаполнено(ИмяДокумента) Тогда	
						Сообщение.Текст = "Неформализованный документ """+ИмяДокумента+""" успешно загружен, но не мог быть подписан. Идентификатор документа: " +ИдентификаторПодготовленногоНеформализованногоДокумента+Символы.ПС+ "Описание ошибки подписания:";	
					Иначе
						Сообщение.Текст = "Неформализованный объект успешно загружен, но не мог быть подписан. Идентификатор документа: " +ИдентификаторПодготовленногоНеформализованногоДокумента+Символы.ПС+ "Описание ошибки подписания:";
					КонецЕсли;	
					Сообщение.Сообщить();
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = РезультатПодписанияДокумента.Описание;
					Сообщение.Сообщить();
				Иначе
					Если ОтправкаДополнительногоОбъекта = Ложь Тогда
						Сообщение = Новый СообщениеПользователю; 
						Если ЗначениеЗаполнено(ИмяДокумента) Тогда
							Сообщение.Текст = "Неформализованный документ """+ИмяДокумента+""" успешно загружен и подписан. Идентификатор документа: " +ИдентификаторПодготовленногоНеформализованногоДокумента;
						Иначе	
							Сообщение.Текст = "Неформализованный объект успешно загружен и подписан. Идентификатор документа: " +ИдентификаторПодготовленногоНеформализованногоДокумента;
						КонецЕсли;	
						Сообщение.Сообщить();
						//эво_ОбщегоНазначения.ЗаписатьСобытиеВЖурналСобытий("Неформализованный документ """+ИмяДокумента+"""", "Документ успешно отправлен.", , ИдентификаторПодготовленногоНеформализованногоДокумента, "Неформализованный документ успешно отправлен вручную через обработку ЭДО.", Ложь, , ПользователиКлиентСервер.ТекущийПользователь(), Ложь, , РасширениеФайла);
					КонецЕсли;	
				КонецЕсли;	
							
				УдалитьФайлы(ИмяФайлаПодписи);
				
			Иначе
				
				Если ОтправкаДополнительногоОбъекта = Ложь Тогда
					Сообщение = Новый СообщениеПользователю;
					Если ЗначениеЗаполнено(ИмяДокумента) Тогда                                                                                                        
						Сообщение.Текст = "Неформализованный документ """+ИмяДокумента+""" успешно загружен. Идентификатор документа: " +ИдентификаторПодготовленногоНеформализованногоДокумента;	
					Иначе	
						Сообщение.Текст = "Неформализованный объект успешно загружен. Идентификатор документа: " +ИдентификаторПодготовленногоНеформализованногоДокумента;
					КонецЕсли;	
					Сообщение.Сообщить();
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Сообщение = Новый СообщениеПользователю;
			Если ЗначениеЗаполнено(ИмяДокумента) Тогда
				Сообщение.Текст = "При загрузке контента неформализованного документа """+ИмяДокумента+""" произошла ошибка. Идентификатор документа: " +ИдентификаторПодготовленногоНеформализованногоДокумента
										+Символы.ПС+"Описание ошибки:"
										+Символы.ПС+РезультатЗагрузкиКонтента.Описание;	
			Иначе
				Сообщение.Текст = РезультатЗагрузкиКонтента.Описание;	
			КонецЕсли;	
			Сообщение.Сообщить();
			
		КонецЕсли;	
					
	Иначе
		
		Сообщение = Новый СообщениеПользователю;
		Если ЗначениеЗаполнено(ИмяДокумента) Тогда
			Сообщение.Текст = "При попытке отправки неформализованного документа "+ИмяДокумента+" произошла ошибка."
									+Символы.ПС+"Описание ошибки:"
									+Символы.ПС+РезультатОтправкиНеформализованногоДокумента.Описание;
		Иначе
			Сообщение.Текст = РезультатОтправкиНеформализованногоДокумента.Описание;
		КонецЕсли;	
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры	

#Область УстаревшиеПроцедурыБезУС

&НаКлиенте
Процедура ПодписатьВходящиеДокументыЧерезAPI_НЕ_УС(СписокИдентификаторовДокументов, ДатаПодписания = "") Экспорт
	
	Если ДатаПодписания = "" Тогда
		ДатаПодписания = Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd");
	ИначеЕсли ДатаПодписания = Дата(1,1,1) Тогда
		ДатаПодписания = Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd");
	Иначе
		ДатаПодписания = Формат(ДатаПодписания, "ДФ=yyyy-MM-dd");
	КонецЕсли;	
	
	Интеграция			= ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	Менеджер			= ПолучитьМенеджерКриптографии();
	Сертификат			= ПолучитьЭЦППоОтпечатку(Менеджер, Base64Значение(ОтпечатокСертификатаBase64));
	СубъектСертификата	= Сертификат.Субъект;
	
	Сертификат_ИНН = "";		
	Если СубъектСертификата.Свойство("OID1_2_643_100_4") Тогда
		Сертификат_ИНН = СубъектСертификата.OID1_2_643_100_4;
	ИначеЕсли СубъектСертификата.Свойство("OID1_2_643_3_131_1_1") Тогда
		Сертификат_ИНН = СубъектСертификата.OID1_2_643_3_131_1_1;
	ИначеЕсли СубъектСертификата.Свойство("INNLE") Тогда
		Сертификат_ИНН = СубъектСертификата.INNLE;
	ИначеЕсли СубъектСертификата.Свойство("ИННЮЛ") Тогда
		Сертификат_ИНН = СубъектСертификата.ИННЮЛ;
	ИначеЕсли СубъектСертификата.Свойство("ИНН_ЮЛ") Тогда
		Сертификат_ИНН = СубъектСертификата.ИНН_ЮЛ;
	ИначеЕсли СубъектСертификата.Свойство("ИНН") Тогда
		Сертификат_ИНН = СубъектСертификата.ИНН;
	ИначеЕсли СубъектСертификата.Свойство("ИННОрганизации") Тогда
		Сертификат_ИНН = СубъектСертификата.ИННОрганизации;
	ИначеЕсли СубъектСертификата.Свойство("ИНН_Организации") Тогда
		Сертификат_ИНН = СубъектСертификата.ИНН_Организации;	
	КонецЕсли;
	
	ФамилияСубъекта			= СубъектСертификата.SN;
	ИмяОтчествоСубъекта 	= СтрРазделить(СубъектСертификата.GN, " ");
	ИмяСубъекта				= ИмяОтчествоСубъекта[0];
	ОтчествоСубъекта 		= ИмяОтчествоСубъекта[1];
	ДолжностьСубъекта		= ?(СубъектСертификата.Свойство("T"), ?(СубъектСертификата.T = "", "Индивидуальный предприниматель", СубъектСертификата.T), "Индивидуальный предприниматель");
    ТипСубъекта				= ТипСубъектаПодписанта;
	МчдGUID					= МчдGUIDПодписанта;
	ДатаВыдачиДоверенности	= ДатаНачалаДействияМЧД;
	НаименованиеОрганизации	= ?(СубъектСертификата.Свойство("CN"), СубъектСертификата.CN, "");
	Если НаименованиеОрганизации = "" И СубъектСертификата.Свойство("O") Тогда
		НаименованиеОрганизации = СубъектСертификата.O;
	КонецЕсли;
	СтруктураИННКППНаименованиеУчастника = ПолучитьИННКППНаименованиеУчастника(Организация);
	
	Если ТипСубъекта = "ФЛ" И НЕ ЗначениеЗаполнено(МчдGUID) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не указан номер МЧД для подписи физического лица.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;	
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("position", ДолжностьСубъекта);
	СтруктураФИО = Новый Структура;
	СтруктураФИО.Вставить("first", ИмяСубъекта);            
	СтруктураФИО.Вставить("last", ФамилияСубъекта);
	СтруктураФИО.Вставить("middle", ОтчествоСубъекта);
	СтруктураДанных.Вставить("person", СтруктураФИО);	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
	СтрокаТелаДляФормированияКвитанций = ЗаписьJSON.Закрыть();
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("type", "ТипТитула");
	СтруктураДанных.Вставить("date", ДатаПодписания);
	
	// signer
	СтруктураДанныхПодписанта = Новый Структура;
	СтруктураФИО = Новый Структура;
	СтруктураФИО.Вставить("first", ИмяСубъекта);            
	СтруктураФИО.Вставить("last", ФамилияСубъекта);
	СтруктураФИО.Вставить("middle", ОтчествоСубъекта);
	СтруктураДанныхПодписанта.Вставить("name", СтруктураФИО);
	Если НЕ НаименованиеОрганизации = "" Тогда
		СтруктураДанныхПодписанта.Вставить("orgName", НаименованиеОрганизации);
	КонецЕсли;
	Если НЕ ТипСубъекта = "ФЛ" Тогда
		СтруктураДанныхПодписанта.Вставить("position", ДолжностьСубъекта);
	КонецЕсли;
	Если ТипСубъекта = "ФЛ" Тогда
		СтруктураДанныхПодписанта.Вставить("poaId", МчдGUID);
		СтруктураДанныхПодписанта.Вставить("type", "FL");
		СтруктураДанныхПодписанта.Вставить("scopeOfAuthority", "TRANSACTION_AND_PROCESSING");
		СтруктураДанныхПодписанта.Вставить("status", "AUTHORIZED_INDIVIDUAL");
		СтруктураДанныхПодписанта.Вставить("authorityReason", "AUTHORIZED_INDIVIDUAL");
		Если ЗначениеЗаполнено(Сертификат_ИНН) Тогда 
			СтруктураДанныхПодписанта.Вставить("inn", Сертификат_ИНН);
		КонецЕсли;	
	КонецЕсли;	
	СтруктураДанных.Вставить("signer", СтруктураДанныхПодписанта);
	
	// 5.02 5.03
	Если ТипСубъекта = "ФЛ" Тогда
		СтруктураДанных.signer.Вставить("signingAuthorizationMethod", "MCHD_WITHIN_ELECTRONIC_DOCUMENTS");
		Если ЗначениеЗаполнено(ДатаВыдачиДоверенности) Тогда
			СтруктураДанных.Вставить("poaIssueDate", ДатаВыдачиДоверенности);
		Иначе
			ПараметрыЗапросаДанныхАбонента = ПолучитьШаблонПараметровЗапроса();
			ПараметрыЗапросаДанныхАбонента.Параметры.Вставить("<gid>", ИдентификаторОрганизации);
			РезультатЗапросаДанныхАбонента = ВыполнитьЗапросAPI("API_ИнформацияОбАбоненте", ПараметрыЗапросаДанныхАбонента);
			Если РезультатЗапросаДанныхАбонента.Ошибка = Истина Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Не удалось получить информацию об абоненте организации "+Организация+" с идентификатором "+ИдентификаторОрганизации+".";
				Сообщение.Сообщить();
				Возврат;
			ИначеЕсли НЕ ЗначениеЗаполнено(РезультатЗапросаДанныхАбонента.Результат) Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Не удалось получить информацию об абоненте организации "+Организация+" с идентификатором "+ИдентификаторОрганизации+".";
				Сообщение.Сообщить();
				Возврат;
			ИначеЕсли РезультатЗапросаДанныхАбонента.Результат.Количество() = 0 Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Не удалось получить информацию об абоненте организации "+Организация+" с идентификатором "+ИдентификаторОрганизации+".";
				Сообщение.Сообщить();
				Возврат;
			КонецЕсли;
			ИдентификаторАбонентаОрганизации = Формат(РезультатЗапросаДанныхАбонента.Результат[0].id, "ЧГ=0");
			ПараметрыЗапросаДанныхМЧД = ПолучитьШаблонПараметровЗапроса();
			ПараметрыЗапросаДанныхМЧД.Параметры.Вставить("<МчдGUID>",		МчдGUID);
			ПараметрыЗапросаДанныхМЧД.Параметры.Вставить("<issuer-inn>",	СтруктураИННКППНаименованиеУчастника.ИНН);
			ПараметрыЗапросаДанныхМЧД.Параметры.Вставить("<subscriber-id>",	ИдентификаторАбонентаОрганизации);
			РезультатЗапросаДанныхМЧД = ВыполнитьЗапросAPI("API_ПолучитьИнформациюПоМЧД", ПараметрыЗапросаДанныхМЧД);
			Если РезультатЗапросаДанныхМЧД.Ошибка = Истина Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Не удалось определить дату выдачи МЧД от организации "+Организация+" для подписи физического лица."
						+Символы.ПС+"Указанный номер доверенности: "+МчдGUID+".";
				Сообщение.Сообщить();
				Возврат;
			КонецЕсли;
			ДатаВыдачиДоверенности = РезультатЗапросаДанныхМЧД.Результат.content.документ.довер.свДов.датаВыдДовер;
			СтруктураДанных.Вставить("poaIssueDate", ДатаВыдачиДоверенности);
		КонецЕсли;	
	Иначе
		СтруктураДанных.signer.Вставить("signingAuthorizationMethod", "ELECTRONIC_SIGNATURE");
	КонецЕсли;
	
	// Details
	СтруктураDetails = Новый Структура;
	СтруктураDetails.Вставить("acceptanceType", "ACCEPTED");
	
	// 5.02 5.03 Details
	СтруктураDetails.Вставить("operationContent", "Принято без замечаний");
	// ON_AKTSVEROTP Details
	СтруктураDetails.Вставить("difference", "false");
	// receivingPerson
	СтруктураReceivingPerson = Новый Структура;
	СтруктураReceivingPerson.Вставить("type", ?(ТипСубъекта = "ФЛ", "FL", "LE"));
	СтруктураReceivingPerson.Вставить("name", СтруктураФИО);
	СтруктураReceivingPerson.Вставить("orgName", ?(ТипСубъекта = "ФЛ", СтруктураИННКППНаименованиеУчастника.Наименование, НаименованиеОрганизации));
	СтруктураReceivingPerson.Вставить("inn", Сертификат_ИНН);
	СтруктураReceivingPerson.Вставить("position", ?(ТипСубъекта = "ФЛ", ДолжностьФизлица, ДолжностьСубъекта));
	СтруктураDetails.Вставить("receivingPerson", СтруктураReceivingPerson);
	
	СтруктураДанных.Вставить("details", СтруктураDetails);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();                                               
	ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
	СтрокаТелаДляФормированияТитула = ЗаписьJSON.Закрыть();
	
	ПараметрыЗапросаФормированияТитула = ПолучитьШаблонПараметровЗапроса();
	
	Для Каждого Идентификатор из СписокИдентификаторовДокументов Цикл
		
		Если Идентификатор.Значение.ФорматДокумента = "ON_NSCHFDOPPR" И Идентификатор.Значение.ВерсияФормата = "5.02" Тогда 
			ТекущийТипТитупа = "UtdV0502Acceptance";
			СтрокаТелаДляФормированияТитула = СтрЗаменить(СтрокаТелаДляФормированияТитула, "ТипТитула", ТекущийТипТитупа);
		ИначеЕсли Идентификатор.Значение.ФорматДокумента = "ON_NSCHFDOPPR" И Идентификатор.Значение.ВерсияФормата = "5.03" Тогда 
			ТекущийТипТитупа = "UtdV0503Acceptance";
			СтрокаТелаДляФормированияТитула = СтрЗаменить(СтрокаТелаДляФормированияТитула, "ТипТитула", ТекущийТипТитупа);
		ИначеЕсли Идентификатор.Значение.ФорматДокумента = "ON_AKTSVEROTP" Тогда
			ТекущийТипТитупа = "ReconciliationAcceptance";
			СтрокаТелаДляФормированияТитула = СтрЗаменить(СтрокаТелаДляФормированияТитула, "ТипТитула", ТекущийТипТитупа);
		Иначе
			ТекущийТипТитупа = "UtdAcceptance";
			СтрокаТелаДляФормированияТитула = СтрЗаменить(СтрокаТелаДляФормированияТитула, "ТипТитула", ТекущийТипТитупа);	
		КонецЕсли;	
		
		ПараметрыЗапросаФормированияТитула.Параметры.Вставить("<Тело>", СтрокаТелаДляФормированияТитула);
		
		СтрокаТелаДляФормированияТитула = СтрЗаменить(СтрокаТелаДляФормированияТитула, ТекущийТипТитупа, "ТипТитула");
		
		Если Идентификатор.Значение.Формализованный = Истина Тогда //Формализованный 
						
			//1 квитанция
			IDКвитанции1 = "";
			Квитанция1УжеСуществуетИПодписана = Ложь;

			ПараметрыЗапросаФормированияКвитанции = ПолучитьШаблонПараметровЗапроса();
			ПараметрыЗапросаФормированияКвитанции.Параметры.Вставить("<document_id>", Идентификатор.Ключ);
			ПараметрыЗапросаФормированияКвитанции.Параметры.Вставить("<Тело>", СтрокаТелаДляФормированияКвитанций);
			
			РезультатФормированияКвитанции1 = ВыполнитьЗапросAPI("API_СформироватьКвитанциюОПолучении", ПараметрыЗапросаФормированияКвитанции);
			
			Если РезультатФормированияКвитанции1.Ошибка Тогда				
				Если РезультатФормированияКвитанции1.КодСостояния = 409 и НЕ Найти(РезультатФормированияКвитанции1.Описание, "already exists and signed") = 0 Тогда 
					
					Квитанция1УжеСуществуетИПодписана = Истина;
					//Ищем эту квитанцию, чтобы получить её id.
					ПараметрыЗапросаЦепочкиДокумента = ПолучитьШаблонПараметровЗапроса();
					ПараметрыЗапросаЦепочкиДокумента.Параметры.Вставить("<id>", Идентификатор.Ключ);
					
					// Цепочка подчинённых документов может не успеть сформироваться вовремя.
					ЦепочкаДокументаБылаПолучена = Ложь;
					КоличествоПопытокПолученияЦепочкиВходящегоДокумента = 0;
					Пока НЕ ЦепочкаДокументаБылаПолучена Цикл
					
						Если КоличествоПопытокПолученияЦепочкиВходящегоДокумента = 20 Тогда
							Прервать;	
						КонецЕсли;	
					
						РезультатЗапросаЦепочкиВходящегоДокумента = ВыполнитьЗапросAPI("API_ПолучитьЦепочкиДокументов", ПараметрыЗапросаЦепочкиДокумента);
					
						Если РезультатЗапросаЦепочкиВходящегоДокумента.Ошибка Тогда
							Сообщение = Новый СообщениеПользователю;
							Сообщение.Текст = "Для документа с идентификатором " +Идентификатор.Ключ+" не удалось получить цепочку подчиненных документов."+Символы.ПС+ "Описание ошибки:";
							Сообщение.Сообщить();
							Сообщение = Новый СообщениеПользователю;
							Сообщение.Текст = РезультатЗапросаЦепочкиВходящегоДокумента.Описание;
							Сообщение.Сообщить();
							Прервать;				
						КонецЕсли;
					
						// Проверяем наличие подчинённых документов у входящего документа.
						// Если подчинённых нет, значит они ещё не успели сформироваться, нужно запросить цепочку ещё раз.
						// Время формирования плавает и зависит от нагрузки, предсказать невозможно.
						Если НЕ РезультатЗапросаЦепочкиВходящегоДокумента.Результат[0].Свойство("slaves") Тогда 
							// Формируем запрос еще раз.
							КоличествоПопытокПолученияЦепочкиВходящегоДокумента = КоличествоПопытокПолученияЦепочкиВходящегоДокумента+1;
							Продолжить;
						Иначе
							ЦепочкаДокументаБылаПолучена = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
					Если НЕ ЦепочкаДокументаБылаПолучена Тогда
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = "Для документа с идентификатором " +Идентификатор.Ключ+" не удалось получить цепочку подчиненных документов."+Символы.ПС+
							"Не формируется цепочка подчинённых документов на стороне сервиса. Возможно, проводятся технические работы.";
						Сообщение.Сообщить();
						Продолжить;
					КонецЕсли;	
						
					МассивЦепочкиДокумента = РезультатЗапросаЦепочкиВходящегоДокумента.Результат[0].slaves;
					Для Каждого ЭлементЦепочки ИЗ МассивЦепочкиДокумента Цикл
						Если ЭлементЦепочки.type = "DP_IZVPOL" Тогда
							IDКвитанции1 = Строка(Формат(ЭлементЦепочки.id, "ЧГ="));
							Прервать;
						КонецЕсли;	
					КонецЦикла;
					
				Иначе
					
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Не удалось сформировать первую техн. квитанцию для документа с идентификатором "+Идентификатор.Ключ+"."+Символы.ПС+"Описание ошибки:";
					Сообщение.Сообщить();
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = РезультатФормированияКвитанции1.Описание;
					Сообщение.Сообщить();
					Продолжить;
					
				КонецЕсли;				
			КонецЕсли;
			
			Если НЕ Квитанция1УжеСуществуетИПодписана Тогда
				
				IDКвитанции1 = Строка(Формат(РезультатФормированияКвитанции1.Результат.id, "ЧГ="));	
				ПараметрыЗапросаПолученияКонтента = ПолучитьШаблонПараметровЗапроса();
				ПараметрыЗапросаПолученияКонтента.Параметры.Вставить("<document_id>", IDКвитанции1);
				РезультатПолученияКонтента = ВыполнитьЗапросAPI("API_ПолучитьКонтентДокумента", ПараметрыЗапросаПолученияКонтента);
				
				Если РезультатПолученияКонтента.Ошибка Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = РезультатПолученияКонтента.Описание;
					Сообщение.Сообщить();
					Продолжить;
				КонецЕсли;	
				
				ВременныйФайл = ПолучитьИмяВременногоФайла("xml");;
				РезультатПолученияКонтента.Результат.Записать(ВременныйФайл);
				Файл = Новый Файл(ВременныйФайл);
				
				Если НЕ Файл.Существует() Тогда
					
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Не удалось сохранить сформированный файл первой техн. квитанции для документа с идентификатором "+Идентификатор.Ключ+".";
					Сообщение.Сообщить();
					Продолжить;
					
				Иначе
					
					ПарольСертификата = ПарольДоступаКЗакрытомуКлючу;			
					
					ИмяФайлаПодписи = ПодписатьДокумент(Файл.ИмяБезРасширения, ВременныйФайл, Менеджер, Сертификат, ПарольСертификата, ".signature.p7b");				
					
					ПараметрыЗапросаПодписиКвитанции1 = ПолучитьШаблонПараметровЗапроса();
					ПараметрыЗапросаПодписиКвитанции1.Параметры.Вставить("<document_id>", IDКвитанции1);
					
					ПодписьДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаПодписи); 
					
					ЭлектроннаяПодписьCMSBase64 = Base64Строка(ПодписьДвоичныеДанные);
					ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ПС, "");
					ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ВК, "");
					ЭлектроннаяПодписьCMSвDERвURL = КодироватьBase64СтрокуВСтрокуURLНаСервере(ЭлектроннаяПодписьCMSBase64);
					
					СтруктураДанных = Новый Структура;
					СтруктураДанных.Вставить("value", ЭлектроннаяПодписьCMSBase64);
					Если ТипСубъектаПодписанта = "ФЛ" Тогда
						СтруктураPOA = Новый Структура;
						СтруктураPOA.Вставить("number", МчдGUIDПодписанта);
						СтруктураДанных.Вставить("poa", СтруктураPOA);
					КонецЕсли;
					ЗаписьJSON = Новый ЗаписьJSON;
