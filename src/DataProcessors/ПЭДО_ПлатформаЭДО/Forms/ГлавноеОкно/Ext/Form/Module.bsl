#Область КнопкиОбновить

&НаКлиенте
Процедура ОбновитьВсе(Команда)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Ответ = Вопрос("Длительность операции зависит от общего числа документов. Вы уверены?", Режим, 0);
	 
	Если Ответ = КодВозвратаДиалога.Нет Тогда
    	Возврат;
	КонецЕсли;
	
	ОбновитьСтатусыДокументов();
	Элементы.ДинамическийСписокРеализацияТоваровУслуг.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусыВыделенныхДокументов(Команда)
	
	Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);	
	Если Интеграция.СпособИнтеграции <> 2 Тогда //НЕ API
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Обновить статусы можно только при способе обмена 'API'. Измените способ обмена в настройках и повторите попытку.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	МассивДокументов = Элементы["ДинамическийСписок"+ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя].ВыделенныеСтроки;
	ОбновитьСтатусыСпискаДокументов(МассивДокументов, Интеграция);
	Элементы["ДинамическийСписок"+ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя].Обновить();
	
КонецПроцедуры

