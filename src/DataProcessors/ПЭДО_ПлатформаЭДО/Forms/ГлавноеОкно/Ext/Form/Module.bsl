										Если ТипФайла = Неопределено Тогда
											Сообщение = Новый СообщениеПользователю;
											Сообщение.Текст = "Для MIME-типа """+ПолучениеПодчиненногоДокумента.Тип+""" неизвестен соответствующий тип файла.";
											Сообщение.Сообщить();
											Возврат;
										КонецЕсли;
										ПутьСохранения = ПутьККаталогу+"\"+ПодчиненныйДокумент.fileId+"." + ТипФайла;
										ПолучениеПодчиненногоДокумента.Результат.Записать(ПутьСохранения);
										МассивДокументов.Добавить(ПутьСохранения);
									КонецЕсли;	
									
								КонецЕсли;
								
								Прервать;
								
							КонецЕсли;
							
						КонецЦикла;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;	
			
			
		КонецЦикла; 
		
		Если СкачиватьВАрхив тогда
			СохранитьКакАрхив(ПутьККаталогу, МассивДокументов); 
		КонецЕсли;
		
	Иначе 
		Сообщить("Выберите хотя бы 1 документ для скачивания с помощью выделения строк (зажав на клавишу 'Ctrl' или 'Shift' можно выделить несколько документов).");
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьКакАрхив(ПутьККаталогу, МассивДокументов)
	
	НаименованиеАрхива = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(МассивДокументов[0]).ИмяБезРасширения;
	
	Архив = Новый Файл(МассивДокументов[0]+".zip"); 
	Если Архив.Существует() тогда
		НаименованиеАрхива = НаименованиеАрхива + "(1)";
	КонецЕсли;
	
	Архив = Новый ЗаписьZipФайла(
	ПутьККаталогу+"\"+НаименованиеАрхива+".zip",
	"", // пароль на архив
	"", // комментарий к архиву
	МетодСжатияZIP.Сжатие,
	УровеньСжатияZIP.Оптимальный,
	МетодШифрованияZIP.Zip20
	);	
	
	Для каждого Док из МассивДокументов цикл
		Архив.Добавить(Док);	
	КонецЦикла;
	
	Архив.Записать();
	
	Для каждого Док из МассивДокументов цикл
		УдалитьФайлы(Док);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ЗаписатьКонтентДокументаВФайл(ПутьККаталогу, ПолучениеКонтентаДокумента, Элемент)
	
	СтруктураОтвета = Новый Структура;
	
	Если ПутьККаталогу = "" Тогда
		РежимДиалога = РежимДиалогаВыбораФайла.ВыборКаталога; 
		ДиалогОткрытия = Новый ДиалогВыбораФайла(РежимДиалога); 
		ДиалогОткрытия.Каталог = ""; 
		ДиалогОткрытия.МножественныйВыбор = Ложь; 
		ДиалогОткрытия.Заголовок = "Выберите каталог";
		Если ДиалогОткрытия.Выбрать() Тогда
			ПутьККаталогу = ДиалогОткрытия.Каталог;
		КонецЕсли;
	КонецЕсли;
	
	СтруктураОтвета.Вставить("ПутьККаталогу", ПутьККаталогу);
	
	Если НЕ ПутьККаталогу = "" Тогда
		ТипыФайловMIME = ЗаполнитьОбратноеСоответствиеТиповMIME();
		ТипФайла = ТипыФайловMIME.Получить(ПолучениеКонтентаДокумента.Тип);
		Если ТипФайла = Неопределено Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Для MIME-типа """+ПолучениеКонтентаДокумента.Тип+""" неизвестен соответствующий тип файла.";
			Сообщение.Сообщить();
			СтруктураОтвета.Вставить("Ошибка", Истина);
		КонецЕсли;
		ПолучениеКонтентаДокумента.Результат.Записать(ПутьККаталогу+"\"+Элемент.fileIdДокумента+"."+ТипФайла);
	Иначе
		Сообщить("Каталог для выгрузки не был выбран.");
		СтруктураОтвета.Вставить("Ошибка", Истина);
	КонецЕсли; 
	
	СтруктураОтвета.Вставить("ТипФайла", Типфайла);
	
	Возврат СтруктураОтвета
	
КонецФункции

#Конецобласти

#Область ИнтеграцияКаталог

// Выгружает документы в каталог
&НаКлиенте
Процедура ВыгрузитьВКаталог(МассивДокументов, КаталогОбмена) Экспорт
	
	Если НЕ ЗначениеЗаполнено(КаталогОбмена) Тогда
		Сообщить("Укажите в настройках каталог обмена для выгрузки!");
		Возврат;
	КонецЕсли;	
	
	ХранениеИнформацииВ1С = Ложь;
	
	// Получаем структуру свойств из настроек Кэш
	СтруктураХранения1С = ПолучитьСтруктуруХранения1С();
	
	// Если по каким-то причинам не удалось найти свойства, то ничего не сохраняем
	Если 	СтруктураХранения1С <> Неопределено и ЗначениеЗаполнено(СтруктураХранения1С.СвойствоИдентификатор) и
		ЗначениеЗаполнено(СтруктураХранения1С.СвойствоСтатус) Тогда
		
		ХранениеИнформацииВ1С = Истина;
		
	КонецЕсли;
	
	Для Каждого Документ из МассивДокументов Цикл
		
		Если Документ.ОшибкиФормирования = Истина Тогда
			Продолжить;
		КонецЕсли;	
		
		Если Документ.Неформализованный = Ложь Тогда
			
			//Формализованный.
			
			Файл = Новый ТекстовыйДокумент();                           
			Файл.ДобавитьСтроку(Документ.Выгрузка);
			Попытка
				Файл.Записать(КаталогОбмена + Документ.ИмяФайла +".xml", "windows-1251");
				//Документ.СтатусЭДО = "Выгружен в каталог";
				Документ.СтатусЭДО = 30;
			Исключение
				//Документ.СтатусЭДО = "Ошибка записи документа";
				Документ.СтатусЭДО = 24;
				Сообщить("Не удалось сохранить документ " + Строка(Документ.Ссылка) + " в каталог: " + КаталогОбмена + ". Проверьте права доступа к каталогу обмена.");
			КонецПопытки;
			
			// Получаем текущий статус, записанный в 1С.
			// Если текущий статус говорит о выгрузке в ЭДО через API, не нужно его замещать.
			// Идентификатор документа при выгрузке в каталог не исчезает.
			ДокументРанееБылВыгруженВЭДО = Ложь;
			ТекущийСтатусДокумента = "";
			МассивСсылокДокумента = Новый Массив;
			МассивСсылокДокумента.Добавить(Документ.Ссылка);
			СоответствиеСтатусаДокумента = ПолучитьСтатусыДокументовИз1С(МассивСсылокДокумента);
			Если СоответствиеСтатусаДокумента.Количество() > 0 Тогда
				ТекущийСтатусДокумента = СоответствиеСтатусаДокумента.Получить(Документ.Ссылка);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекущийСтатусДокумента) Тогда
				Если НЕ ТекущийСтатусДокумента = 1 ИЛИ ТекущийСтатусДокумента = 30 Тогда
					// Документ имеет статус выгрузки в ЭДО.
					ДокументРанееБылВыгруженВЭДО = Истина;
				КонецЕсли;	
			КонецЕсли;	
			
			Если ХранениеИнформацииВ1С И НЕ ДокументРанееБылВыгруженВЭДО Тогда 
				// Статус документа
				ПараметрыЗаписи = ПолучитьСтруктуруПараметровЗаписиВРегистрСведений();
				
				ПараметрыЗаписи.НаименованиеРегистра	= СтруктураХранения1С.НаименованиеРегистра;
				ПараметрыЗаписи.Объект 					= Документ.Ссылка;
				ПараметрыЗаписи.Свойство 				= СтруктураХранения1С.СвойствоСтатус;
				ПараметрыЗаписи.Значение 				= Документ.СтатусЭДО;
				
				Документ.ХранениеИнформации1С.СтатусЭДО = ЗаписьВРегистрСведений(ПараметрыЗаписи);
				// Статус документа    			
			КонецЕсли;
			
		Иначе
			
			// Неформалка.	
			Если Документ.ДвоичныеДанные = Ложь Тогда
				
				// Табличный документ.
				ТабличныйДокумент = Документ.Выгрузка;
				
				ЗапрашиваемыйФорматФайла = Документ.ФорматФайла;
				
				Если НЕ Лев(ЗапрашиваемыйФорматФайла, 1) = "." Тогда
					ЗапрашиваемыйФорматФайла = "."+ЗапрашиваемыйФорматФайла;
				КонецЕсли;	
				
				Если ЗапрашиваемыйФорматФайла = ".xlsx" Тогда
					ТипФорматаФайла = ТипФайлаТабличногоДокумента.XLSX;
					ФорматФайла = ЗапрашиваемыйФорматФайла;
				ИначеЕсли ЗапрашиваемыйФорматФайла = ".docx" Тогда
					ТипФорматаФайла = ТипФайлаТабличногоДокумента.DOCX;
					ФорматФайла = ЗапрашиваемыйФорматФайла;
				ИначеЕсли ЗапрашиваемыйФорматФайла = ".pdf" Тогда
					ТипФорматаФайла = ТипФайлаТабличногоДокумента.PDF;
					ФорматФайла = ".pdf";
				КонецЕсли;
				
				ИмяФайла = СтрЗаменить(Документ.ЗаголовокНеформализованного, ":", ".");
				
				ПутьКОтправляемомуНеформализованномуОбъекту = КаталогОбмена+ИмяФайла+ФорматФайла;
				ТабличныйДокумент.Записать(ПутьКОтправляемомуНеформализованномуОбъекту, ТипФорматаФайла);
				
			Иначе
				
				// Задел на отправку произвольных файлов.
				
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЦикла;	
	
	// Обновим динамический список, если была запись статусов в 1С
	Если ХранениеИнформацииВ1С Тогда
		ТекущаяСтраница = ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя;
		Элементы["ДинамическийСписок"+ТекущаяСтраница].Обновить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСоСтатусами
// В дальнейшем планируется перенести работу со статусами в модуль объекта

&НаСервереБезКонтекста
Функция ПолучитьСвойствоСтатусаНаСервере()
	// ⚠️ Правка расширения: БСП-шного ПВХ ДополнительныеРеквизитыИСведения в УТ 10.3 нет,
	//    свойства живут в ПланВидовХарактеристик.СвойстваОбъектов (см. ХранениеИнформации1С
	//    в настройке конфигурации). Без этой развилки «Удалить черновики» и работа со
	//    статусами падают: «Поле объекта не обнаружено (ДополнительныеРеквизитыИСведения)».
	ИмяПВХ = ?(Метаданные.ПланыВидовХарактеристик.Найти("ДополнительныеРеквизитыИСведения") = Неопределено,
		"СвойстваОбъектов", "ДополнительныеРеквизитыИСведения");
	Возврат ПланыВидовХарактеристик[ИмяПВХ].НайтиПоНаименованию("ОФД_ЭДО_СтатусДокумента");
КонецФункции

// Функция возвращает структуру параметров записи в регистр сведений
&НаКлиенте
Функция ПолучитьСтруктуруПараметровЗаписиВРегистрСведений() Экспорт
	
	ПараметрыЗаписи = Новый Структура;
	ПараметрыЗаписи.Вставить("НаименованиеРегистра", 	"");
	ПараметрыЗаписи.Вставить("Объект", 					Неопределено);
	ПараметрыЗаписи.Вставить("Свойство", 				Неопределено);
	ПараметрыЗаписи.Вставить("Значение", 				"");
	ПараметрыЗаписи.Вставить("СтатусЗаписи",			Ложь);
	
	Возврат ПараметрыЗаписи;
	
КонецФункции

// Функция делает запись в регистр сведений в соответствии с параметрами
// Результат работы функции записывается в эту же структуру в параметр "СтатусЗаписи"
// Структура записи сохраняется в структуре состояния документа для отчета
&НаСервереБезКонтекста
Функция ЗаписьВРегистрСведений(ПараметрыЗаписи) Экспорт 	
	
	НаборЗаписей = РегистрыСведений[ПараметрыЗаписи.НаименованиеРегистра].СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(ПараметрыЗаписи.Объект);
	НаборЗаписей.Отбор.Свойство.Установить(ПараметрыЗаписи.Свойство);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда		
		НоваяЗаписьНабора = НаборЗаписей.Добавить();
		НоваяЗаписьНабора.Объект	= ПараметрыЗаписи.Объект;
		НоваяЗаписьНабора.Свойство	= ПараметрыЗаписи.Свойство;
		НоваяЗаписьНабора.Значение	= ПараметрыЗаписи.Значение; 		
	Иначе
		НоваяЗаписьНабора = НаборЗаписей.Получить(0);
		// Защита от записи пустого значения, вместо полного
		Если ПараметрыЗаписи.Значение <> "" Тогда
			НоваяЗаписьНабора.Значение	= ПараметрыЗаписи.Значение; 		
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		НаборЗаписей.Записать(); 
		ПараметрыЗаписи.СтатусЗаписи = Истина;
	Исключение
		ПараметрыЗаписи.СтатусЗаписи = Ложь;
	КонецПопытки;
	
	Возврат ПараметрыЗаписи;
	
КонецФункции

// Процедура обновляет все статусы, зафиксированные после даты, указанной в реквизите формы "ПоследняяДатаОбновления".
&НаКлиенте
Процедура ОбновитьСтатусыДокументов() Экспорт
	
	Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);	
	Если Интеграция.СпособИнтеграции <> 2 Тогда //НЕ API
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Обновить статусы можно только при способе обмена 'API'. Измените способ обмена в настройках и повторите попытку.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	СтруктураХранения1С = ПолучитьСтруктуруХранения1С();
	
	ХранениеИнформацииВ1С = Ложь;
	СвойствоИдентификатор = Неопределено;
	СвойствоСтатус		  = Неопределено;
	
	// Если по каким-то причинам не удалось найти свойства, то ничего не сохраняем
	Если СтруктураХранения1С <> Неопределено И ЗначениеЗаполнено(СтруктураХранения1С.СвойствоИдентификатор) И
		ЗначениеЗаполнено(СтруктураХранения1С.СвойствоСтатус) Тогда				
		
		ХранениеИнформацииВ1С = Истина;
		СвойствоИдентификатор = СтруктураХранения1С.СвойствоИдентификатор;
		СвойствоСтатус		  = СтруктураХранения1С.СвойствоСтатус;				
	КонецЕсли;
	
	ВсеИзмененияОбработаны = Ложь;
	
	Если ПоследняяДатаОбновления = Дата(1,1,1) Тогда
		ПолучитьДатуПоследнегоОбновленияСтатусов();
	КонецЕсли;
	
	ДатаНачалаЭтапаОбновления = ПоследняяДатаОбновления;
	
	Пока НЕ ВсеИзмененияОбработаны Цикл
		РезультатПопыткиЭтапаОбновления = ОбновитьСтатусыДокументовВПределахДня(ДатаНачалаЭтапаОбновления, ХранениеИнформацииВ1С, СвойствоИдентификатор, СвойствоСтатус);
		Если НЕ РезультатПопыткиЭтапаОбновления.Ошибка Тогда
			Если КонецДня(ДатаНачалаЭтапаОбновления) = КонецДня(ТекущаяДата()) Тогда
				ВсеИзмененияОбработаны = Истина;
				ПоследняяДатаОбновления = РезультатПопыткиЭтапаОбновления.ДатаАктуальности;
			Иначе
				ДатаНачалаЭтапаОбновления = КонецДня(ДатаНачалаЭтапаОбновления) + 1;
			КонецЕсли;
		Иначе
			Сообщить(Символы.ПС+"В процессе обновления произошла ошибка."+Символы.ПС+"Текст ошибки: """+РезультатПопыткиЭтапаОбновления.Описание+"""."+Символы.ПС+"Статусы документов частично обновлены по "+РезультатПопыткиЭтапаОбновления.ДатаАктуальности+".");
			Если НЕ РезультатПопыткиЭтапаОбновления.ДатаАктуальности >= ПоследняяДатаОбновления Тогда
				ЗафиксироватьДатуОбновленияСтатусов(РезультатПопыткиЭтапаОбновления.ДатаАктуальности);
			КонецЕсли;
			Возврат;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Функция ОбновитьСтатусыДокументовВПределахДня(ДатаНачала, ХранениеИнформацииВ1С = Ложь, СвойствоИдентификатор = Неопределено, СвойствоСтатус = Неопределено) Экспорт
	
	// Мы не знаем, сколько всего результатов, поэтому проверяем все доступные страницы, начиная с 99.
	Страница = 99;
	
	ДатаОкончания = КонецДня(ДатаНачала);
	ДатаАктуальности = ДатаНачала;
	ПоследняяОбработаннаяДата = Неопределено;
	ДатаПоследнегоЭлемента = Неопределено;
	
	Пока НЕ Страница = -1 Цикл
		
		ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
		// Преобразование недоступно на веб-сервере, поэтому вывели преобразование на сервер.
		#Если ВебКлиент Тогда
		ПараметрыЗапроса.Параметры.Вставить("<from>", ПреобразоватьДатуВФорматISO(ДатаНачала));
		ПараметрыЗапроса.Параметры.Вставить("<to>", СтрЗаменить(ПреобразоватьДатуВФорматISO(ДатаОкончания), "Z", ".999999Z"));
		#Иначе
		ПараметрыЗапроса.Параметры.Вставить("<from>", ЗаписатьДатуJSON(ДатаНачала, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата));
		ПараметрыЗапроса.Параметры.Вставить("<to>", СтрЗаменить(ЗаписатьДатуJSON(ДатаОкончания, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата), "Z", ".999999Z"));
		#КонецЕсли
		
		РезультатПолученныеИзмененияДокументовЗаПериодПоСтранице = ВыполнитьЗапросAPI("API_ПолучитьИзмененияДокументовЗаПериодПоСтранице", ПараметрыЗапроса, Страница);
		
		РезультатПопыткиОбновления = Новый Структура("Ошибка, Описание, ДатаАктуальности");
		РезультатПопыткиОбновления.Ошибка = РезультатПолученныеИзмененияДокументовЗаПериодПоСтранице.Ошибка;
		РезультатПопыткиОбновления.Описание = РезультатПолученныеИзмененияДокументовЗаПериодПоСтранице.Описание;
		
		Если НЕ РезультатПолученныеИзмененияДокументовЗаПериодПоСтранице.Ошибка Тогда
			Если РезультатПолученныеИзмененияДокументовЗаПериодПоСтранице.Результат = Неопределено Тогда
				// Изменений на странице не обнаружено.
				Если Страница = 0 Тогда
					//Изменений за день вообще не обнаружено.
					ЗафиксироватьДатуОбновленияСтатусов(?(ДатаНачала = НачалоДня(ТекущаяДата()), ТекущаяДата(), ДатаОкончания));
					РезультатПопыткиОбновления.ДатаАктуальности = ТекущаяДата();
					Возврат РезультатПопыткиОбновления;
				КонецЕсли;
				Продолжить;
			Иначе
				// Обнаружены изменения. Страница не пустая.
				
				//Считаем полученные изменения.
				АктуальныеСтатусы = Неопределено;
				ТекущиеСтатусыДокументов = Неопределено;
				
				Если ХранениеИнформацииВ1С И НЕ СвойствоИдентификатор = Неопределено И НЕ СвойствоСтатус = Неопределено Тогда 
					
					АктуальныеСтатусы = Новый Соответствие;
					МассивИдентификаторов = Новый Массив;
					МассивДокументов = Новый Массив;
					
					//Метод API возврашает историю изменений в обратном хронологическом порядке, поэтому читать результат нужно с конца.
					Счетчик = РезультатПолученныеИзмененияДокументовЗаПериодПоСтранице.Результат.Количество() - 1;
					Пока НЕ Счетчик = -1 Цикл
						Элемент = РезультатПолученныеИзмененияДокументовЗаПериодПоСтранице.Результат[Счетчик];
						Если Элемент.Свойство("field") И (Элемент.field = "status" ИЛИ Элемент.field = "STATUS") Тогда
							МассивИдентификаторов.Добавить(Формат(Элемент.documentID, "ЧГ=0"));
							АктуальныеСтатусы.Вставить(Формат(Элемент.documentID, "ЧГ=0"), ПеревестиСтатусAPIвСтатус1С(Элемент.value));
							ДатаПоследнегоЭлемента = ПрочитатьДатуJSON(Элемент.created, ФорматДатыJSON.ISO);
						КонецЕсли;
						Счетчик = Счетчик - 1;
					КонецЦикла;
					
					Если МассивИдентификаторов.Количество() > 0 Тогда
						ДокументыПоИдентификаторам = ПолучитьДокументыПоИдентификаторам1С(МассивИдентификаторов, СвойствоИдентификатор);					
						ТекущиеСтатусыДокументов = ПолучитьСтатусыДокументовИз1С(МассивИдентификаторов, СвойствоСтатус, СвойствоИдентификатор, Истина);						
					КонецЕсли;
	
					
				Иначе
					
					// Здесь будет реализована альтернатива.
					
				КонецЕсли;
				
				//Фиксируется результат.
				Если НЕ АктуальныеСтатусы = Неопределено И НЕ ТекущиеСтатусыДокументов = Неопределено И АктуальныеСтатусы.Количество() > 0 Тогда
					ЗафиксироватьАктуальныеСтатусыВ1С(АктуальныеСтатусы, ТекущиеСтатусыДокументов, ДокументыПоИдентификаторам, Ложь, , СвойствоСтатус);
					ПоследняяОбработаннаяДата = ДатаПоследнегоЭлемента;
					ЗафиксироватьДатуОбновленияСтатусов(ПоследняяОбработаннаяДата);
				КонецЕсли;	
				
				Если Страница = 99 И РезультатПолученныеИзмененияДокументовЗаПериодПоСтранице.Результат.Количество() = 1000 Тогда
					//Лимит количества получаемых ответов достигнут (100 000).
					//Необходимо повторить запрос с учётом уже обработанного времени.
					Если НЕ ПоследняяОбработаннаяДата = Неопределено Тогда 
						ЗафиксироватьДатуОбновленияСтатусов(ПоследняяОбработаннаяДата);
						РезультатПопыткиПодэтапаОбновления = ОбновитьСтатусыДокументовВПределахДня(ПоследняяОбработаннаяДата, ХранениеИнформацииВ1С, СвойствоИдентификатор, СвойствоСтатус);
						Возврат РезультатПопыткиПодэтапаОбновления; 
					КонецЕсли;
				ИначеЕсли РезультатПолученныеИзмененияДокументовЗаПериодПоСтранице.Результат.Количество() < 1000 Тогда
					//Все доступные ответы обработаны.
					ЗафиксироватьДатуОбновленияСтатусов(ПоследняяОбработаннаяДата);
					РезультатПопыткиОбновления.ДатаАктуальности = ПоследняяОбработаннаяДата;
					Возврат РезультатПопыткиОбновления;
				КонецЕсли;	
			КонецЕсли;
		Иначе
			//Произошла ошибка.
			РезультатПопыткиОбновления.ДатаАктуальности = ДатаАктуальности;
			Возврат РезультатПопыткиОбновления;
		КонецЕсли;	
		
		Страница = Страница - 1;
		
	КонецЦикла;
	
КонецФункции	

// Процедура обновляет статусы документов по входящему массиву ссылок.
&НаКлиенте
Процедура ОбновитьСтатусыСпискаДокументов(МассивДокументов, Интеграция = Неопределено) Экспорт
	
	Если Интеграция = Неопределено Тогда
		Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	КонецЕсли;
	
	Если Интеграция.СпособИнтеграции <> 2 Тогда //НЕ API
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Обновить статусы можно только при способе обмена 'API'. Измените способ обмена в настройках и повторите попытку.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(МассивДокументов) = Тип("Массив") И МассивДокументов.Количество() > 0 Тогда
		
		// Получаем структуру свойств из настроек Кэш	
		СтруктураХранения1С = ПолучитьСтруктуруХранения1С();
		
		ХранениеИнформацииВ1С = Ложь;
		СвойствоИдентификатор = Неопределено;
		СвойствоСтатус		  = Неопределено;
		
		// Если по каким-то причинам не удалось найти свойства, то ничего не сохраняем
		Если СтруктураХранения1С <> Неопределено И ЗначениеЗаполнено(СтруктураХранения1С.СвойствоИдентификатор) И
			ЗначениеЗаполнено(СтруктураХранения1С.СвойствоСтатус) Тогда				
			
			ХранениеИнформацииВ1С = Истина;
			СвойствоИдентификатор = СтруктураХранения1С.СвойствоИдентификатор;
			СвойствоСтатус		  = СтруктураХранения1С.СвойствоСтатус;				
		КонецЕсли;
		
		СтрокаИдентификаторов = "";
		
		Если ХранениеИнформацииВ1С Тогда
			ИдентификаторыДокументов = ПолучитьИдентификаторыДокументовИз1С(МассивДокументов, СвойствоИдентификатор);
			Для Каждого Элемент из ИдентификаторыДокументов Цикл
				СтрокаИдентификаторов = СтрокаИдентификаторов + Элемент.Значение + ",";	
			КонецЦикла;			
		КонецЕсли;	
		
		ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
		ПараметрыЗапроса.Параметры.Вставить("<id>", СтрокаИдентификаторов); 
		
		РезультатПоискаДокументов = ВыполнитьЗапросAPI("API_ПолучитьСписокДокументов", ПараметрыЗапроса);
		
		Если НЕ РезультатПоискаДокументов.Ошибка Тогда
			
			Если РезультатПоискаДокументов.Результат = Неопределено Тогда
				// Пустой ответ, изменения не требуются.
				Возврат;
			КонецЕсли;	
			
			АктуальныеСтатусыДокументов = Новый Соответствие; 
			
			Для Каждого Документ из РезультатПоискаДокументов.Результат Цикл
				ИдентификаторДокументаОтвета = СокрЛП(Формат(Документ.id, "ЧДЦ=0; ЧГ=0"));
				АктуальныйСтатусОтвета = ПеревестиСтатусAPIвСтатус1С(Документ.status);
				АктуальныеСтатусыДокументов.Вставить(ИдентификаторДокументаОтвета, АктуальныйСтатусОтвета);	
			КонецЦикла;	
			
			Если ХранениеИнформацииВ1С Тогда
				
				ТекущиеСтатусыДокументов = ПолучитьСтатусыДокументовИз1С(МассивДокументов, СвойствоСтатус);				
					
			Иначе
				
				//Здесь будет реализована альтернатива.
				//Не будет. ДопСведения - безусловный стандарт, и их можно исползовать даже при отключенной функц. опции.
				
			КонецЕсли;
			
			Если НЕ АктуальныеСтатусыДокументов = Неопределено И НЕ ТекущиеСтатусыДокументов = Неопределено И АктуальныеСтатусыДокументов.Количество() > 0 Тогда
				ЗафиксироватьАктуальныеСтатусыВ1С(АктуальныеСтатусыДокументов, ТекущиеСтатусыДокументов, ИдентификаторыДокументов, Истина, СтруктураХранения1С, СвойствоСтатус);
			КонецЕсли;
			
		Иначе
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = РезультатПоискаДокументов.Описание;
			Сообщение.Сообщить();
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура ОбновитьСтатусыСпискаДокументовНаСервере(МассивДокументов) Экспорт
	
	МодульОбработки = РеквизитФормыВЗначение("Объект");
	МодульОбработки.ОбновитьСтатусыМассиваДокументовОрганизации(МассивДокументов, ПолучитьТекущегоПользователя(), AccessToken, RefreshToken);
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьДатуПоследнегоОбновленияСтатусов()
	
	УстановитьПривилегированныйРежим(Истина);

	ХешДанных = Новый ХешированиеДанных(ХешФункция.CRC32);
	ХешДанных.Добавить(AccessToken);
	СтрокаХешСумма = Формат(ХешДанных.ХешСумма, "ЧГ=0");
	
	ПоследняяДатаОбновления = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки",// Ключ объекта
	"ПоследняяДатаОбновления_"+СтрокаХешСумма,												// Ключ настройки 
	"Последняя дата обновления статусов для внешней обработки ОФД ЭДО.", 					// Описание настройки
	"ОФД_ЭДО_НастройкиОбработки");															// Пользователь
	
	Если ПоследняяДатаОбновления = Неопределено ИЛИ ПоследняяДатаОбновления = Дата(1,1,1) ИЛИ ПоследняяДатаОбновления < Дата(2019, 9, 1) Тогда
		ПоследняяДатаОбновления = Дата(2020, 3, 6); //Дата запуска сервиса.
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

&НаСервере
Процедура ЗафиксироватьДатуОбновленияСтатусов(Дата)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ХешДанных = Новый ХешированиеДанных(ХешФункция.CRC32);
	ХешДанных.Добавить(AccessToken);
	СтрокаХешСумма = Формат(ХешДанных.ХешСумма, "ЧГ=0");
	                                                
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", 		// Ключ объекта
	"ПоследняяДатаОбновления_"+СтрокаХешСумма,							// Ключ настройки 
	Дата,																// Настройка
	"Последняя дата обновления статусов для внешней обработки ОФД ЭДО.",// описание настройки
	"ОФД_ЭДО_НастройкиОбработки");										// Пользователь
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗафиксироватьАктуальныеСтатусыВ1С(АктуальныеСтатусы, ТекущиеСтатусы, СоответствиеIDДокументов, ОбновлениеПоСписку = Ложь, СтруктураХранения1С = Неопределено, СвойствоСтатус = Неопределено) Экспорт
	
	Если СтруктураХранения1С = Неопределено Тогда 
		СтруктураХранения1С = ПолучитьСтруктуруХранения1С();
	КонецЕсли;	
		
	Если СвойствоСтатус = Неопределено Тогда
		СвойствоСтатус = СтруктураХранения1С.СвойствоСтатус;
	Конецесли;	
	
	ПараметрыЗаписи = ПолучитьСтруктуруПараметровЗаписиВРегистрСведений();
	
	// При обновлении по списку документов мы отталкиваемся от списка ссылок, при общем обновлении от списка идентификаторов, вернувшихся с онлайн-сервива.
	// Этим обусловлена разница в обработке в обоих случаях, но в обоих случаях идёт работа с соответствиями, по общему принципу.
	
	Если ОбновлениеПоСписку Тогда
		СоответствиеОбхода = ТекущиеСтатусы;
		СоответствиеСравнения = АктуальныеСтатусы;
	Иначе
		СоответствиеОбхода = АктуальныеСтатусы;
		СоответствиеСравнения = ТекущиеСтатусы;
	КонецЕсли;
	
	Для Каждого Элемент из СоответствиеОбхода Цикл
		КлючСравнения = СоответствиеIDДокументов[Элемент.Ключ];
		Если НЕ КлючСравнения = Неопределено Тогда
			ЗначениеОбхода = Элемент.Значение;
			ЗначениеСравнения = СоответствиеСравнения[КлючСравнения];
			ЗначениеСравнения = ?(ЗначениеСравнения = Неопределено, 0, ЗначениеСравнения);
			
			Если НЕ ЗначениеОбхода = ЗначениеСравнения Тогда 
				//И (НЕ ЗначениеОбхода = Неопределено ИЛИ НЕ ЗначениеСравнения = Неопределено) Тогда
				
				//Если ОбновлениеПоСписку И ЗначениеСравнения = Неопределено Тогда
				//	// Ограниченный список + нет актуального статуса.
				//КонецЕсли;
				//Если НЕ ОбновлениеПоСписку И ЗначениеСравнения = Неопределено Тогда
				//	// Общий список + нет записанного статуса.
				//КонецЕсли;
				
				ТекущийСтатусОписываетВариациюОшибки = ?(ОбновлениеПоСписку, 
														?(ЗначениеСравнения = 10 И ЗначениеОбхода >= 20 И ЗначениеОбхода < 30, Истина, Ложь), 
														?(ЗначениеОбхода = 10 И ЗначениеСравнения >= 20 И ЗначениеСравнения < 30, Истина, Ложь));
				Если ТекущийСтатусОписываетВариациюОшибки Тогда
					//Статус на онлайне - черновик. Значит, отправка была невозможна. 
					//Статус в 1С - ошибка (возможны несколько типов), описывающая причину невозможности отправки.
					//В этом случае перезаписывать статус 1С на "Черновик" не требуется.
				Иначе
					//Обновляется статус в 1С.
					АктуальныйСтатусДокумента = ?(ОбновлениеПоСписку, ЗначениеСравнения, ЗначениеОбхода);
					
					Если НЕ АктуальныйСтатусДокумента = 0 Тогда					
						ПараметрыЗаписи.НаименованиеРегистра	= СтруктураХранения1С.НаименованиеРегистра;
						ПараметрыЗаписи.Объект 					= ?(ОбновлениеПоСписку, Элемент.Ключ, КлючСравнения);
						ПараметрыЗаписи.Свойство 				= СвойствоСтатус;
						ПараметрыЗаписи.Значение 				= АктуальныйСтатусДокумента;
						
						РезультатЗаписи = ЗаписьВРегистрСведений(ПараметрыЗаписи);					
					КонецЕсли;					
				КонецЕсли;										
			КонецЕсли;
			
		КонецЕсли;	
	КонецЦикла;	
	
	//Если ОбновлениеПоСписку Тогда
	//	
	//	Для Каждого Элемент из ТекущиеСтатусы Цикл
	//		ИдентификаторДокумента = СоответствиеIDДокументов[Элемент.Ключ];
	//		Если НЕ ИдентификаторДокумента = Неопределено Тогда
	//			ТекущийСтатусДокумента = Элемент.Значение;
	//			АктуальныйСтатусДокумента = АктуальныеСтатусы[ИдентификаторДокумента];
	//			Если НЕ ТекущийСтатусДокумента = АктуальныйСтатусДокумента И (НЕ ТекущийСтатусДокумента = Неопределено ИЛИ НЕ АктуальныйСтатусДокумента = Неопределено) Тогда
	//				Если АктуальныйСтатусДокумента = 10 И ТекущийСтатусДокумента >= 20 И ТекущийСтатусДокумента < 30 Тогда
	//					//Статус на онлайне - черновик. Значит, отправка была невозможна. 
