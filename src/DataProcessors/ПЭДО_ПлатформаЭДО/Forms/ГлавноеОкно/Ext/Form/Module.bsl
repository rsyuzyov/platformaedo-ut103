&НаКлиенте
Процедура ЗагрузитьВходящийДокумент(Команда)
		
	Если Элементы.ТаблицаВходящих.ТекущиеДанные.ТипДокумента = "Неформализованный" Тогда
		Возврат;
	КонецЕсли;
	
	//Если Элементы.ТаблицаВходящих.ТекущиеДанные.ФорматДокумента = "ON_NSCHFDOPPR" И НЕ Элементы.ТаблицаВходящих.ТекущиеДанные.ТипДокумента = "СЧФ" Тогда
		МассивСИдентификаторомЗагружаемогоДокумента = Новый Массив;
		МассивСИдентификаторомЗагружаемогоДокумента.Добавить(Элементы.ТаблицаВходящих.ТекущиеДанные.id);
		Документ1СПоИдентификаторуЭДО = ПолучитьДокументыПоИдентификаторам1С(МассивСИдентификаторомЗагружаемогоДокумента);
		//Если Документ1СПоИдентификаторуЭДО.Количество() = 0 Тогда 
			
			//ЗагрузитьВходящийДокументНаСервере();
			ПутьКФайлуЗагружаемогоДокумента = КаталогВременныхФайлов()+"\"+Элементы.ТаблицаВходящих.ТекущиеДанные.id+"."+"xml";
			
			// Получаем файл загружаемого документа.
			ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
			ПараметрыЗапроса.Заголовки.Вставить("accept", "accept: application/xml");
			ПараметрыЗапроса.Параметры.Вставить("<document_id>", Элементы.ТаблицаВходящих.ТекущиеДанные.id); 			
			ПолучениеКонтентаДокумента = ВыполнитьЗапросAPI("API_ПолучитьКонтентДокумента", ПараметрыЗапроса);
			
			Если ПолучениеКонтентаДокумента.Ошибка Тогда
				Сообщить("При попытке скачивания документа произошла ошибка:" + Элементы.ТаблицаВходящих.ТекущиеДанные.id + "(" + ПолучениеКонтентаДокумента.Описание + ")");
				Возврат;
			Иначе		
				ПолучениеКонтентаДокумента.Результат.Записать(ПутьКФайлуЗагружаемогоДокумента);	
			КонецЕсли;	
			
			ПараметрыОткрытияФормы = Новый Структура("АдресВременногоХранилищаКэш", АдресВременногоХранилищаКэш);
			ПараметрыОткрытияФормы.Вставить("ПутьКФайлуЗагружаемогоДокумента", ПутьКФайлуЗагружаемогоДокумента);
			ПараметрыОткрытияФормы.Вставить("ФорматЗагружаемогоДокумента", Элементы.ТаблицаВходящих.ТекущиеДанные.ФорматДокумента);
			ПараметрыОткрытияФормы.Вставить("ПрефиксКонфигурации", ПрефиксКонфигурации);
			
			ОткрытьФорму("ВнешняяОбработка.ОФД_ЭДО.Форма.ФормаЗагрузкиВходящихДокументов", ПараметрыОткрытияФормы,,,,,, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
			
		//Иначе
			
		//КонецЕсли;	
	//Иначе
	//	Сообщение = Новый СообщениеПользователю;
	//	Сообщение.Текст = "Тип документа не поддерживается для загрузки на данный момент.";
	//	Сообщение.Сообщить();
	//	Возврат;
	//КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьВходящийДокументНаСервере()
	
	Адрес = АдресВременногоХранилищаКэш;
	
	Кэш = ПолучитьИзВременногоХранилища(Адрес);
	
	Если Кэш = Неопределено Тогда
		ИнициализацияКэш(Истина);
		Кэш = ПолучитьИзВременногоХранилища(Адрес);
