Функция ИмяФайлаОбработки()

	Возврат ""; // ПЭДО: обработка живёт в расширении, файла .epf нет
	
КонецФункции

&НаСервереБезКонтекста
Процедура СохранитьПараметрыФоновыхЗаданийНаСервере(ПараметрыФоновыхЗаданий) Экспорт
	
	УстановитьПривилегированныйРежим(Истина); 
	
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки",				// Ключ объекта
	"ПараметрыФоновыхЗаданий",													// Ключ настройки 
	ПараметрыФоновыхЗаданий,													// Настройка
	"Параметры выполнения фоновых заданий при интераткивной работе.",			// описание настройки
	ПолучитьТекущегоПользователя()); 											// Пользователь	
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПараметрыФоновыхЗаданийНаСервере() Экспорт
	
	УстановитьПривилегированныйРежим(Истина); 
	
	СписокЗначений = ХранилищеОбщихНастроек.ПолучитьСписок("ОФД_ЭДО_НастройкиОбработки", ПолучитьТекущегоПользователя());
	ПараметрыФоновыхЗаданий = СписокЗначений.НайтиПоЗначению("ПараметрыФоновыхЗаданий");
	
	// Информация об интеграции уже есть в хранилище значений 
	Если ТипЗнч(ПараметрыФоновыхЗаданий) = Тип("ЭлементСпискаЗначений") Тогда
		
		Возврат ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", 	// Ключ объекта
		"ПараметрыФоновыхЗаданий",												// Ключ настройки 
		"Параметры выполнения фоновых заданий при интераткивной работе.", 		// описание настройки
		ПолучитьТекущегоПользователя()); 										// Пользователь
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли; 	
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТекущегоПользователя()
	
	Возврат Неопределено;
	
	Если НЕ Метаданные.ОбщиеМодули.Найти("ПользователиИнформационнойБазы") = Неопределено Тогда
		ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Иначе
		ТекущийПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	КонецЕсли;	
	
	Возврат ТекущийПользователь;
	
КонецФункции

