&НаКлиенте
Процедура ПроверитьИдентификаторыУчастниковЭДОПередОтправкой(МассивКонтрагентов = Неопределено)
	
	// Проверяем заполненность ИД организации.
	ИдентификаторОрганизации = ПолучитьИдентификаторЭДОИз1СПоСсылке(Организация);
	Если СпособИнтеграции = 1 Тогда
		// Каталог.
		Если ИдентификаторОрганизации = "" Тогда
			НовыйИдентификаторОрганизации = СоздатьИдентификаторЭДО(Организация);
			ДанныеОрганизации = Новый Массив;
			Структура = Новый Структура; 		
			Структура.Вставить("Ссылка",		Организация);
			ИННКППОрганизации = ПолучитьИННКППНаименованиеУчастника(Организация); 
			Структура.Вставить("ИНН", 			ИННКППОрганизации.ИНН);
			Структура.Вставить("КПП",			ИННКППОрганизации.КПП);
			Структура.Вставить("Идентификатор",	НовыйИдентификаторОрганизации);
			ДанныеОрганизации.Добавить(Структура);
			ОбновитьИдентификаторыУчастниковЭДОНаСервере(ДанныеОрганизации);
		КонецЕсли;	
	КонецЕсли;	
	
	Если МассивКонтрагентов = Неопределено Тогда	
		ТекущаяСтраница = ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя;
		МассивДокументов = Элементы["ДинамическийСписок"+ТекущаяСтраница].ВыделенныеСтроки; 
		МассивКонтрагентов = ПолучитьКонтрагентовПоВыделеннымДокументам(МассивДокументов);
	КонецЕсли;	
	
	ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса(); 		
	
	СписокКонтрагентов = Новый Массив;
	
	Для Каждого Элемент из МассивКонтрагентов Цикл
		ИдентификаторУчастника = ПолучитьИдентификаторЭДОИз1СПоСсылке(Элемент.Ссылка);
		// Начиная с версии 0.0.24а, обновляются перед отправкой только пустые идентификаторы.
		// Для остальных случаев используется форма поиска абонентов.
		Если ИдентификаторУчастника = "" Тогда
			Структура = Новый Структура; 		
			Структура.Вставить("Ссылка",		Элемент.Ссылка);
			Структура.Вставить("ИНН", 			Элемент.ИНН);
			Структура.Вставить("КПП",			Элемент.КПП);
			Структура.Вставить("Идентификатор",	"");
			СписокКонтрагентов.Добавить(Структура);
		КонецЕсли;	
	КонецЦикла;	
	
	// Запрашиваем с сервера для каждого контрагента ИНН и КПП
	Для Каждого Контрагент из СписокКонтрагентов Цикл
		
		Если СпособИнтеграции = 1 Тогда
			// Каталог
			
			НовыйИдентификаторКонтрагента = СоздатьИдентификаторЭДО(Контрагент.Ссылка); 
			Контрагент.Идентификатор = НовыйИдентификаторКонтрагента;
			
		Иначе	
			// API
			
			ПараметрыЗапроса.Параметры.Вставить("<inn>", Контрагент.ИНН);
			Если ЗначениеЗаполнено(Контрагент.КПП) Тогда
				ПараметрыЗапроса.Параметры.Вставить("<kpp>", Контрагент.КПП);
			КонецЕсли;	
			
			ИнформацияОКонтрагенте = ВыполнитьЗапросAPI("API_ИнформацияОбУчастникеЭДО", ПараметрыЗапроса);
			Контрагент.Вставить("ИнформацияОКонтрагенте", ИнформацияОКонтрагенте);
			
			Если Не ИнформацияОКонтрагенте.Ошибка Тогда
				
				// Такого контрагента нет в системе ЭДО
				Если ИнформацияОКонтрагенте.КодСостояния = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				// Контрагент найден
				Если ТипЗнч(ИнформацияОКонтрагенте.Результат) = Тип("Массив") И ИнформацияОКонтрагенте.Результат.Количество() <> 0 Тогда
					ИдентификаторКонтрагента = ИнформацияОКонтрагенте.Результат[0].gid;
					Контрагент.Идентификатор = ИдентификаторКонтрагента;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;  		
	
	ОбновитьИдентификаторыУчастниковЭДОНаСервере(СписокКонтрагентов);
	
КонецПроцедуры

&НаКлиенте
Функция ИдентификаторСоответствуетУчастнику1С(Участник, Идентификатор = Неопределено, Документ = Неопределено, ЭтоОтправитель = Ложь)
	
	Если НЕ ЗначениеЗаполнено(Участник) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ?(Документ = Неопределено, "", "При выгрузке документа """+Документ+""" обнаружена проблема."+Символы.ПС) 
			+"Не удалось найти абонента " + ?(ЭтоОтправитель, "ОТПРАВИТЕЛЯ (организации)", "ПОЛУЧАТЕЛЯ (контрагента)")
			+" по документу, проверьте заполнение идентификатора абонента.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	Если Идентификатор = Неопределено Тогда
		Идентификатор = ПолучитьИдентификаторЭДОИз1СПоСсылке(Участник);
	КонецЕсли;	
	
	ИННКППУчастника	= ПолучитьИННКППНаименованиеУчастника(Участник);
	ИННУчастника	= ИННКППУчастника.ИНН;
	КППУчастника	= ИННКППУчастника.КПП;
	
	ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
	ПараметрыЗапроса.Параметры.Вставить("<gid>", Идентификатор);	
			
	ИнформацияОбАбоненте = ВыполнитьЗапросAPI("API_ИнформацияОбУчастникеЭДО", ПараметрыЗапроса);
	
	Если НЕ ИнформацияОбАбоненте.Ошибка Тогда
		
		// Такого контрагента нет в системе ЭДО
		Если ИнформацияОбАбоненте.КодСостояния = 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ?(Документ = Неопределено, "", "При выгрузке документа """+Документ+""" обнаружена проблема."+Символы.ПС) 
				+"Не удалось найти абонента """ +Участник+ """ с идентификатором """ +Идентификатор+ """."
				+Символы.ПС+ "Если вы уверены в существовании абонента с таким идентификатором, воспользуйтесь формой работы"
				+Символы.ПС+ "с абонентами для отправки абоненту приглашения к ЭДО по этому идентификатору.";
			Сообщение.Сообщить();
			Возврат Ложь;
		КонецЕсли;
				
		// Контрагент найден
		Если ТипЗнч(ИнформацияОбАбоненте.Результат) = Тип("Массив") И ИнформацияОбАбоненте.Результат.Количество() <> 0 Тогда
			ИННАбонента	= ИнформацияОбАбоненте.Результат[0].details.inn;
			Если ИнформацияОбАбоненте.Результат[0].details.Свойство("kpp") Тогда 
				КППАбонента	= ИнформацияОбАбоненте.Результат[0].details.kpp;
			Иначе
				КППАбонента = "";	
			КонецЕсли;	
			Если ТипЗнч(ИнформацияОбАбоненте.Результат[0].details.name) = Тип("Структура") Тогда
				НаименованиеАбонента = ИнформацияОбАбоненте.Результат[0].details.name.last+" "+ИнформацияОбАбоненте.Результат[0].details.name.first+" "+ИнформацияОбАбоненте.Результат[0].details.name.middle;
			Иначе	
				НаименованиеАбонента = ИнформацияОбАбоненте.Результат[0].details.name;
			КонецЕсли;
			Если ИННУчастника = ИННАбонента Тогда
				Возврат Истина;
			Иначе
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ?(Документ = Неопределено, "", "При выгрузке документа """+Документ+""" обнаружена проблема."+Символы.ПС)
					+"Указанный идентификатор контрагента """ +Участник+ """ """ +Идентификатор+ """"
					+Символы.ПС+ "принадлежит не этому участнику ЭДО."
					+Символы.ПС+ "ИНН по данным 1С: " +ИННУчастника+". ("+Участник+")" 
					+Символы.ПС+ "ИНН участника ЭДО с указанным идентификатором: " +ИННАбонента+". ("+НаименованиеАбонента+")"
					+Символы.ПС+ "Воспользуйтесь формой работы с абонентами для определения корректного идентификатора.";
				Сообщение.Сообщить();
				Возврат Ложь;
			КонецЕсли;	
		Иначе
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ?(Документ = Неопределено, "", "При выгрузке документа """+Документ+""" обнаружена проблема."+Символы.ПС)
				+"Не удалось найти абонента """ +Участник+ """ с идентификатором """ +Идентификатор+ """."
				+Символы.ПС+ "Если вы уверены в существовании абонента с таким идентификатором, воспользуйтесь формой работы"
				+Символы.ПС+ "с абонентами для отправки абоненту приглашения к ЭДО по этому идентификатору.";
			Сообщение.Сообщить();
			Возврат Ложь;
		КонецЕсли;
		
	Иначе 
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ?(Документ = Неопределено, "", "При выгрузке документа """+Документ+""" обнаружена проблема."+Символы.ПС)
			+"Не удалочь получить информацию по абоненту """ +Участник+ """." +Символы.ПС+ "Описание ошибки получения:";
		Сообщение.Сообщить();
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ИнформацияОбАбоненте.Описание;
		Сообщение.Сообщить();
		Возврат Ложь;
		
	КонецЕсли;	
	
	Возврат Ложь;
	
КонецФункции	

// Функция возвращает результат любой функции обращения к API. Обращение к функциям напрямую возможно.
// Основная особенность функции - автоматический релогин, если метод требует авторизацию и первый ответ на запрос вернул ошибку 401.
// Автоматический релогин возможен только в том случае, если пользователь зарегистрировал свой сертификат в ЛК ЭДО.
&НаКлиенте
Функция ВыполнитьЗапросAPI(ИмяФункцииЗапроса, ВходящиеПараметрыЗапроса, Страница = Неопределено) Экспорт
	
	РезультатЗапроса = ПолучитьШаблонСтруктурыОтвета();
	РезультатЗапроса.Ошибка = Истина;
	
	ПараметрыЗапроса = СкопироватьКоллекцию(ВходящиеПараметрыЗапроса);
	
	Выполнить("РезультатЗапроса = "+ИмяФункцииЗапроса+"(ПараметрыЗапроса"+?(Страница = Неопределено, "", ", Страница")+");");
	
	Если РезультатЗапроса.КодСостояния = 401 ИЛИ РезультатЗапроса.КодСостояния = 500 Тогда
			
		// Ошибка авторизации.
		// Попытка обновить токен по сертификату.
		Если ИспользоватьПодписание = Истина И НЕ ЗначениеЗаполнено(RefreshToken) Тогда
			
			Если ПараметрыЗапроса.Свойство("Заголовки") И НЕ ПараметрыЗапроса.Заголовки.Получить("Authorization") = Неопределено Тогда	
				НовыйТокен = ПолучитьТокенПоОтпечаткуСертификата(Base64Значение(ОтпечатокСертификатаBase64), ПарольДоступаКЗакрытомуКлючу);
				Если НЕ НовыйТокен = Неопределено Тогда
					ПараметрыЗапроса = СкопироватьКоллекцию(ВходящиеПараметрыЗапроса);
					ПараметрыЗапроса.Заголовки.Вставить("Authorization", "Bearer "+ НовыйТокен);
					Выполнить("РезультатЗапроса = "+ИмяФункцииЗапроса+"(ПараметрыЗапроса"+?(Страница = Неопределено, "", ", Страница")+");");
					Если РезультатЗапроса.КодСостояния = 200 Тогда
						AccessToken = НовыйТокен;
						RefreshToken = "";
						СохранитьПараметрыАвторизацииИПодписанияОрганизации(Организация, AccessToken, RefreshToken, ИспользоватьПодписание, ОтпечатокСертификатаBase64, ПарольДоступаКЗакрытомуКлючу, ТипСубъектаПодписанта, МчдGUIDПодписанта, ДатаНачалаДействияМЧД, ДолжностьФизлица);
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(AccessToken) И ЗначениеЗаполнено(RefreshToken) Тогда 	
			
			Если ПараметрыЗапроса.Свойство("Заголовки") И НЕ ПараметрыЗапроса.Заголовки.Получить("Authorization") = Неопределено Тогда
				FreshTokens = RefreshTokens(RefreshToken);
				Если НЕ FreshTokens = Неопределено Тогда
					НовыйAccessToken = FreshTokens.access_token;
					НовыйRefreshToken = FreshTokens.refresh_token;
					AccessToken = НовыйAccessToken;
					RefreshToken = НовыйRefreshToken;
					ПараметрыЗапроса = СкопироватьКоллекцию(ВходящиеПараметрыЗапроса);
					ПараметрыЗапроса.Заголовки.Вставить("Authorization", "Bearer "+ AccessToken);
					Выполнить("РезультатЗапроса = "+ИмяФункцииЗапроса+"(ПараметрыЗапроса"+?(Страница = Неопределено, "", ", Страница")+");");
					Если РезультатЗапроса.КодСостояния = 200 Тогда	
						СохранитьПараметрыАвторизацииИПодписанияОрганизации(Организация, AccessToken, RefreshToken, ИспользоватьПодписание, ОтпечатокСертификатаBase64, ПарольДоступаКЗакрытомуКлючу, ТипСубъектаПодписанта, МчдGUIDПодписанта, ДатаНачалаДействияМЧД, ДолжностьФизлица);
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат РезультатЗапроса;
	
КонецФункции	

// Функция подготавливает шаблон параметров запроса
&НаКлиенте
Функция ПолучитьШаблонПараметровЗапроса() Экспорт
	
	Структура = Новый Структура;
	
	Структура.Вставить("Соединение", 	ПолучитьСоединение());
	Структура.Вставить("Заголовки", 	ПолучитьЗаголовки());
	Структура.Вставить("Параметры", 	Новый Соответствие);
	
	Возврат Структура;
	
КонецФункции

// Функция подготавливает шаблон структуры ответа
&НаКлиенте
Функция ПолучитьШаблонСтруктурыОтвета()
	
	Структура = Новый Структура();
	
	Структура.Вставить("Результат", 	Неопределено);
	Структура.Вставить("Ошибка", 		Ложь);
	Структура.Вставить("Описание", 		""); 
	Структура.Вставить("КодСостояния",	"");
	
	Возврат Структура;
	
КонецФункции // ПолучитьШаблонСтруктурыОтвета()

// Функция заполняет параметры запроса в строке запроса
&НаКлиенте
Функция ЗаполнитьПараметрыВЗапросе(СтрокаЗапроса, Параметры) Экспорт
	
	Для Каждого Параметр из Параметры Цикл
		
		СтрокаЗапроса = СтрЗаменить(СтрокаЗапроса, Параметр.Ключ, Параметр.Значение);
		
	КонецЦикла;	
	
	Возврат СтрокаЗапроса;
	
КонецФункции

// Функция обрабатывает ответ запроса по коду состояния
&НаКлиенте
Функция ОбработатьОтвет(Ответ, СтруктураОтвета, ЭтоФайл = Ложь) Экспорт 
	
	СтруктураОтвета.КодСостояния = Ответ.КодСостояния;
	ОтветОбработан = Ложь;
	Тело = Ответ.ПолучитьТелоКакСтроку();	
	
	ТекущаяДата = Строка(ТекущаяДата());
	
	Если СтруктураОтвета.КодСостояния = 200 Тогда
		
		Если Тело = "[]" или Тело = "" Тогда
			СтруктураОтвета.Описание 		= ТекущаяДата + " Пустой ответ.";
		Иначе 
			Если НЕ ЭтоФайл Тогда
				ЧтениеJSON = Новый ЧтениеJSON();
				ЧтениеJSON.УстановитьСтроку(Тело);
				СтруктураОтвета.Результат = ПрочитатьJSON(ЧтениеJSON);			
				ЧтениеJSON.Закрыть(); 
			Иначе
				ДвоичныеДанныеФайла = Ответ.ПолучитьТелоКакДвоичныеДанные();
				СтруктураОтвета.Результат = ДвоичныеДанныеФайла;
				СтруктураОтвета.Вставить("Тип", Ответ.Заголовки.Получить("Content-Type"));
			КонецЕсли;	
		КонецЕсли;
		
		Возврат СтруктураОтвета;
		
	КонецЕсли;
	
	
	Если СтруктураОтвета.КодСостояния = 201 Тогда 
		
		Если Тело = "[]" Тогда
			СтруктураОтвета.Описание 		= ТекущаяДата + " Вроде норм, но че-то непонятно.";
			СтруктураОтвета.КодСостояния 	= 0;
		Иначе 
			ЧтениеJSON = Новый ЧтениеJSON();
			ЧтениеJSON.УстановитьСтроку(Тело);
			СтруктураОтвета.Результат = ПрочитатьJSON(ЧтениеJSON);			
			ЧтениеJSON.Закрыть();  
		КонецЕсли;
		
		Возврат СтруктураОтвета;	
		
	КонецЕсли;
	
	
	Если СтруктураОтвета.КодСостояния = 400 Тогда
		СтруктураОтвета.Ошибка 		= Истина;
		СтруктураОтвета.Описание 	= ТекущаяДата + " Error 400. Ошибка выгружаемых данных." + ?(ЗначениеЗаполнено(Тело), " ("+Тело+")", ""); 	
		Возврат СтруктураОтвета; 	
	КонецЕсли;
	
	Если СтруктураОтвета.КодСостояния = 401 Тогда
		СтруктураОтвета.Ошибка 		= Истина;
		СтруктураОтвета.Описание 	= ТекущаяДата + " Error 401. Ошибка авторизации. Проверье авторизацию в разделе настройки и повторите запрос позднее." + ?(ЗначениеЗаполнено(Тело), " ("+Тело+")", "");		
		Возврат СтруктураОтвета;	
	КонецЕсли;	
	
	Если СтруктураОтвета.КодСостояния = 403 Тогда
		СтруктураОтвета.Ошибка 		= Истина;
		СтруктураОтвета.Описание 	= ТекущаяДата +" Error 403." + ?(ЗначениеЗаполнено(Тело), " ("+Тело+")", "");	
		Возврат СтруктураОтвета; 
	КонецЕсли; 	
	
	Если СтруктураОтвета.КодСостояния = 404 Тогда
		СтруктураОтвета.Ошибка 		= Истина;
		СтруктураОтвета.Описание 	= ТекущаяДата +" Error 404." + ?(ЗначениеЗаполнено(Тело), " ("+Тело+")", "");		
		Возврат СтруктураОтвета;		
	КонецЕсли;
	
	Если СтруктураОтвета.КодСостояния = 415 Тогда
		СтруктураОтвета.Ошибка 		= Истина;
		СтруктураОтвета.Описание 	= ТекущаяДата +" Error 415. Неподдерживаемый тип файла." + ?(ЗначениеЗаполнено(Тело), " ("+Тело+")", "");		
		Возврат СтруктураОтвета;		
	КонецЕсли;
	
	Если СтруктураОтвета.КодСостояния = 500 Тогда
		СтруктураОтвета.Ошибка 		= Истина;
		СтруктураОтвета.Описание 	= ТекущаяДата +" Error 500. Сервис недоступен. Повторите запрос позднее." + ?(ЗначениеЗаполнено(Тело), " ("+Тело+")", ""); 		
		Возврат СтруктураОтвета; 		
	КонецЕсли;
	
	Если СтруктураОтвета.КодСостояния = 204 Тогда
		СтруктураОтвета.Ошибка 		= Ложь;
		СтруктураОтвета.Описание 	= ТекущаяДата +" Успешно."; 		
		Возврат СтруктураОтвета; 		
	КонецЕсли;
	
	СтруктураОтвета.Ошибка 		= Истина;
	СтруктураОтвета.Описание 	= ТекущаяДата + " Error " + СтруктураОтвета.КодСостояния + ". Неизвестная ошибка сервиса." + ?(ЗначениеЗаполнено(Тело), " ("+Тело+")", "");      			
	Возврат СтруктураОтвета;
	
КонецФункции

// subscribers/le
&НаКлиенте
Функция API_ИнформацияОбАбоненте(Знач ПараметрыЗапроса) Экспорт
	
	СтрокаЗапроса = "/edm-subscriber/public/api/v3/subscribers";
	
	Счетчик = 1;
	Для Каждого ПараметрЗапроса из ПараметрыЗапроса.Параметры Цикл
		Если НЕ СтрНайти(СтрокаЗапроса, ПараметрЗапроса.Ключ) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ПараметрЗапроса.Значение = Неопределено И НЕ ПараметрЗапроса.Значение = Null И НЕ ПараметрЗапроса.Значение = "null" И НЕ ПараметрЗапроса.Значение = "Null" Тогда
			СтрокаЗапроса = СтрокаЗапроса + ?(Счетчик = 1, "?", ?(Счетчик = ПараметрыЗапроса.Количество(), "", "&")) + СтрЗаменить(СтрЗаменить(ПараметрЗапроса.Ключ, ">", ""), "<", "") + "=" +ПараметрЗапроса.Ключ;
		КонецЕсли;	
		Счетчик = Счетчик+1;
	КонецЦикла;
	
	СтрокаЗапроса = ЗаполнитьПараметрыВЗапросе(СтрокаЗапроса, ПараметрыЗапроса.Параметры);
	
	СтруктураОтвета = ПолучитьШаблонСтруктурыОтвета();
	
	Запрос = Новый HTTPЗапрос(СтрокаЗапроса, ПараметрыЗапроса.Заголовки);    	
	
	Ответ = ПараметрыЗапроса.Соединение.Получить(Запрос);
	СтруктураОтвета = ОбработатьОтвет(Ответ, СтруктураОтвета);
	
	Возврат СтруктураОтвета;     
	
КонецФункции

