// Функция переводит динамический список в таблицу значений
// Переводятся только выделенные пользователем строки динамического списка
// Разделяет данные на части (массовая выгрузка)
&НаСервере
Функция СписокВТЗнаСервере(МассивДокументов = Неопределено)
	
	ТекущаяСтраница = ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя;
	Схема = Элементы["ДинамическийСписок"+ТекущаяСтраница].ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	Настройки = Элементы["ДинамическийСписок"+ТекущаяСтраница].ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	Если МассивДокументов <> Неопределено Тогда
		// Отбор из динамического списка только выделенных строк
		НовыйЭлемент = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
		НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		НовыйЭлемент.ПравоеЗначение = МассивДокументов;
		НовыйЭлемент.Использование = Истина;	
		// Отбор из динамического списка только выделенных строк
	КонецЕсли;
	
	// Выгружаем все элементы динамического списка, основываясь на отборе пользователя на форме
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, , ,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ТаблицаРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	// Начальный функционал по массовой выгрузке документов
	// Отбираем столько документов, сколько указано в объеме единичной выгрузки
	// Работает только по кнопке "Выгрузить все"
	Если ОбъемЕдиничнойВыгрузки <> 0  и МассивДокументов = Неопределено Тогда
		
		МенВрТаб = Новый МенеджерВременныхТаблиц;
		ЗапросВременнойТаблицы = Новый Запрос;                    
		ЗапросВременнойТаблицы.МенеджерВременныхТаблиц = МенВрТаб;
		
		ЗапросВременнойТаблицы.Текст = "ВЫБРАТЬ *
		|ПОМЕСТИТЬ ВсеСтроки
		|ИЗ 
		|&ТаблицаЗначений КАК ТаблицаЗначений";
		ЗапросВременнойТаблицы.УстановитьПараметр("ТаблицаЗначений", ТаблицаРезультат);
		ЗапросВременнойТаблицы.Выполнить();
				
		ЗапросИтоговойВыгрузки = Новый Запрос;
		ЗапросИтоговойВыгрузки.МенеджерВременныхТаблиц = МенВрТаб;
		ЗапросИтоговойВыгрузки.Текст = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(ОбъемЕдиничнойВыгрузки, "ЧГ=0") + "
		|*
		|ИЗ
		|ВсеСтроки КАК ВсеСтроки";
		
		ТаблицаРезультат = ЗапросИтоговойВыгрузки.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

// Функция переводит динамический список в массив структур
// Переводятся только выделенные пользователем строки динамического списка
// Разделяет данные на части (массовая выгрузка)
&НаСервере
Функция СписокВМассивнаСервере(МассивДокументов = Неопределено)
	
	Таблица = СписокВТЗнаСервере(МассивДокументов);
	
	МассивРезультат = ОбщегоНазначения.ТаблицаЗначенийВМассив(Таблица);
	
	Возврат МассивРезультат; 
	
КонецФункции

&НаСервере
Функция ПолучитьКоличествоДокументовВОтборе()
	
	ТекущаяСтраница = ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя;
	Схема = Элементы["ДинамическийСписок"+ТекущаяСтраница].ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	Настройки = Элементы["ДинамическийСписок"+ТекущаяСтраница].ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	// Выгружаем все элементы динамического списка, основываясь на отборе пользователя на форме
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, , ,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ТаблицаРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);    
	
	Возврат ТаблицаРезультат.Количество();
	
КонецФункции

// Функция добавляет пользовательские фильтры к динамическому списку на форму
&НаСервере
Процедура ПриОбновленииСоставаПользовательскихНастроекНаСервере(СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Для Каждого Страница из ЭтаФорма.Элементы.Страницы.ПодчиненныеЭлементы Цикл 
		
		//ТекущаяСтраница = ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя;
		ТекущаяСтраница = Страница.Имя;
		
		Если ЭтаФорма.Элементы.Найти("ГруппаФильтров"+ ТекущаяСтраница) = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		//	Очищаем все созданные элементы с отборами, через удаление главной группы
		Для Каждого Эл Из Элементы["ГруппаФильтров"+ ТекущаяСтраница].ПодчиненныеЭлементы Цикл
			Элементы.Удалить(Эл);
		КонецЦикла;
		
		//	Получаем настройки, смотрим количество настроек
		Настройки = ЭтаФорма[ТекущаяСтраница].КомпоновщикНастроек.ПолучитьНастройки();	      
		КоличествоОтборов = Настройки.Отбор.Элементы.Количество();
		
		// Создаём главную группу
		ПолеОтборы 		= ЭтаФорма.Элементы.Добавить("ПолеОтборы"+ТекущаяСтраница, Тип("ГруппаФормы"), Элементы["ГруппаФильтров"+ТекущаяСтраница]);
		ПолеОтборы.Вид 	= ВидГруппыФормы.ОбычнаяГруппа;
		ПолеОтборы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		ПолеОтборы.ОтображатьЗаголовок = Ложь;
		
		//	Разделяем главную группу на 2 подгруппы, чтобы хватало места всем отборам
		ОтборыКолонка1 		= ЭтаФорма.Элементы.Добавить("ОтборыКолонка1"+ТекущаяСтраница, Тип("ГруппаФормы"), ПолеОтборы);
		ОтборыКолонка1.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ОтборыКолонка1.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		ОтборыКолонка1.ОтображатьЗаголовок 	= Ложь;
		ОтборыКолонка1.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
		
		ОтборыКолонка2		= ЭтаФорма.Элементы.Добавить("ОтборыКолонка2"+ТекущаяСтраница, Тип("ГруппаФормы"), ПолеОтборы);
		ОтборыКолонка2.Вид	= ВидГруппыФормы.ОбычнаяГруппа;
		ОтборыКолонка2.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		ОтборыКолонка2.ОтображатьЗаголовок	= Ложь;
		ОтборыКолонка2.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
		
		//	Разделяем имеющиеся отборы по колонкам, заполнение начнём с первой
		НастроекНаКолонку = Окр(КоличествоОтборов/2, 0, РежимОкругления.Окр15как20);	
		Колонка = ОтборыКолонка1;
		
		//	Начинаем добавлять настройки на форму
		НомерЭлемента = 0;
		Для каждого ЭлОтбора из Настройки.Отбор.Элементы Цикл
			
			//  Проверяем, не пора ли менять колонку
			Если НомерЭлемента = НастроекНаКолонку Тогда
				Колонка = ОтборыКолонка2;	
			КонецЕсли;
			
			//	Создаём группу под каждую настройку
			ПолеГруппыОтбора = ЭтаФорма.Элементы.Добавить("КомпоновщикНастроекПользовательскиеНастройкиЭлемент"+ТекущаяСтраница+НомерЭлемента, Тип("ГруппаФормы"), Колонка);
			ПолеГруппыОтбора.Вид = ВидГруппыФормы.ОбычнаяГруппа;
			ПолеГруппыОтбора.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
			ПолеГруппыОтбора.ОтображатьЗаголовок = Ложь;
			ПолеГруппыОтбора.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
			
			//	Создаём элементы с привязкой к настройкам компоновщика данных
			ПолеИспользование = ЭтаФорма.Элементы.Добавить("КомпоновщикНастроекПользовательскиеНастройкиЭлемент"+ТекущаяСтраница+НомерЭлемента+"Использование", Тип("ПолеФормы"), ПолеГруппыОтбора);
			ПолеИспользование.Вид = ВидПоляФормы.ПолеФлажка;
			ПолеИспользование.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
			ПолеИспользование.Заголовок = ?(ЭлОтбора.Представление = "", Строка(ЭлОтбора.ЛевоеЗначение), ЭлОтбора.Представление);
			ПолеИспользование.ПутьКДанным = ТекущаяСтраница + ".КомпоновщикНастроек.ПользовательскиеНастройки[0]["+НомерЭлемента+"].Использование";
			
			Если ЭлОтбора.Представление <> "Статус ЭДО" Тогда
				ПолеВидСравнения = ЭтаФорма.Элементы.Добавить("КомпоновщикНастроекПользовательскиеНастройкиЭлемент"+ТекущаяСтраница+НомерЭлемента+"ВидСравненияЭлементаОтбора", Тип("ПолеФормы"), ПолеГруппыОтбора);
				ПолеВидСравнения.Вид = ВидПоляФормы.ПолеВвода;
				ПолеВидСравнения.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
				ПолеВидСравнения.РастягиватьПоГоризонтали = Ложь;
				ПолеВидСравнения.ПутьКДанным = ТекущаяСтраница + ".КомпоновщикНастроек.ПользовательскиеНастройки[0]["+НомерЭлемента+"].ВидСравнения";
			КонецЕсли;
			
			ПолеЗначение = ЭтаФорма.Элементы.Добавить("КомпоновщикНастроекПользовательскиеНастройкиЭлемент"+ТекущаяСтраница+НомерЭлемента+"Значение", Тип("ПолеФормы"), ПолеГруппыОтбора);
			ПолеЗначение.Вид = ВидПоляФормы.ПолеВвода;
			ПолеЗначение.ВыбиратьТип = Ложь;
			ПолеЗначение.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
			ПолеЗначение.ПутьКДанным = ТекущаяСтраница + ".КомпоновщикНастроек.ПользовательскиеНастройки[0]["+НомерЭлемента+"].Значение";
			
			Если ЭлОтбора.Представление = "Статус ЭДО" Тогда
				ПолеЗначение.РежимВыбораИзСписка = Истина;
				ПолеЗначение.СписокВыбора.Очистить();
				//Добавляем стандартный фильтр в динамический список по статусу документа   
				Статусы = ПолучитьСписокСтатусовЭДО();
				
				//Для Каждого Статус из ЭлОтбора.ПравоеЗначение Цикл 
				//	ПолеЗначение.СписокВыбора.Добавить(Статус.Значение, Статус.Значение);	
				//КонецЦикла;
				
				Для Каждого Статус из Статусы Цикл 
					ПолеЗначение.СписокВыбора.Добавить(Статус.Значение, Статус.Представление);	
				КонецЦикла;
				
			КонецЕсли;
			
			НомерЭлемента = НомерЭлемента+1;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИсходящихВходящихВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	НомерМЧДПодписи = "";
	
	Если Элемент.ТекущиеДанные.Свойство("СсылкаНаДокумент") И НЕ Элемент.ТекущиеДанные.СсылкаНаДокумент = Неопределено Тогда
		ПоказатьЗначение(, Элемент.ТекущиеДанные.СсылкаНаДокумент);
	КонецЕсли;
	
	Если Элемент.ТекущиеДанные.ТипДокумента = "Неформализованный" Тогда
		
		// Получаем PDF с Watermark.
		ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
		ПараметрыЗапроса.Заголовки.Вставить("accept", "*/*");
		ПараметрыЗапроса.Параметры.Вставить("<document_id>", Элемент.ТекущиеДанные.id);
		РезультатПолученияКонтента = ВыполнитьЗапросAPI("API_ПолучитьКонтентДокументаСWatermark", ПараметрыЗапроса);
		Если РезультатПолученияКонтента.Ошибка И РезультатПолученияКонтента.КодСостояния = 415 Тогда
			РезультатПолученияКонтента = ВыполнитьЗапросAPI("API_ПолучитьКонтентДокумента", ПараметрыЗапроса);
		КонецЕсли;
		
		Если НЕ РезультатПолученияКонтента.Ошибка Тогда
			
			ТипыФайловMIME = ЗаполнитьОбратноеСоответствиеТиповMIME();
			ТипФайла = ТипыФайловMIME.Получить(РезультатПолученияКонтента.Тип);
			Если ТипФайла = Неопределено Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Для MIME-типа """+РезультатПолученияКонтента.Тип+""" неизвестен соответствующий тип файла.";
				Сообщение.Сообщить();
			КонецЕсли;	
			ВременныйФайл = ПолучитьИмяВременногоФайла(ТипФайла);
			РезультатПолученияКонтента.Результат.Записать(ВременныйФайл);
			Файл = Новый Файл(ВременныйФайл);
			Если НЕ Файл.Существует() Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Не удалось сохранить скачанный файл неформализованного документа.";
				Сообщение.Сообщить();
			Иначе
				ЗапуститьПриложение(СокрЛП(ВременныйФайл));
			КонецЕсли;	
			
		Иначе
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не удалось получить контент неформализованного документа."+Символы.ПС+"Описание ошибки:"+Символы.ПС+РезультатПолученияКонтента.Описание;
			Сообщение.Сообщить();
			
		КонецЕсли;	
		
	Иначе
		
		ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
		ПараметрыЗапроса.Заголовки.Вставить("accept", "application/pdf");
		ПараметрыЗапроса.Параметры.Вставить("<document_id>", Элемент.ТекущиеДанные.id);
		РезультатПолученияКонтента = ВыполнитьЗапросAPI("API_ПолучитьКонтентДокументаСWatermark", ПараметрыЗапроса);
		
		// Получаем XML.
		ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
		ПараметрыЗапроса.Заголовки.Вставить("accept", "accept: application/xml");
		ПараметрыЗапроса.Параметры.Вставить("<document_id>", Элемент.ТекущиеДанные.id);
		РезультатПолученияКонтентаXML = ВыполнитьЗапросAPI("API_ПолучитьКонтентДокумента", ПараметрыЗапроса);	
		
		// Получаем подпись JSON
		ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
		ПараметрыЗапроса.Параметры.Вставить("<document_id>", Элемент.ТекущиеДанные.id);
		РезультатПолученияПодписиJSON = ВыполнитьЗапросAPI("API_ПолучитьПодписьДокументаJSON", ПараметрыЗапроса);
		
		Если НЕ РезультатПолученияПодписиJSON.Ошибка Тогда
			Если ТипЗнч(РезультатПолученияПодписиJSON.Результат) = Тип("Структура") Тогда
				Если РезультатПолученияПодписиJSON.Результат.Свойство("poa") И НЕ РезультатПолученияПодписиJSON.Результат.poa = Неопределено Тогда
					НомерМЧДПодписи = Строка(РезультатПолученияПодписиJSON.Результат.poa.number);
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
		
		Если НЕ РезультатПолученияКонтента.Ошибка И НЕ РезультатПолученияКонтентаXML.Ошибка Тогда
			
			ВременныйФайлPDF = ПолучитьИмяВременногоФайла("pdf");
			РезультатПолученияКонтента.Результат.Записать(ВременныйФайлPDF);
			Файл = Новый Файл(ВременныйФайлPDF);
			Если НЕ Файл.Существует() Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Не удалось сохранить скачанный PDF-файл документа.";
				Сообщение.Сообщить();
				Возврат;
			КонецЕсли;
			
			ВременныйФайлXML = ПолучитьИмяВременногоФайла("xml");
			РезультатПолученияКонтентаXML.Результат.Записать(ВременныйФайлXML);
			Файл = Новый Файл(ВременныйФайлXML);
			Если НЕ Файл.Существует() Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Не удалось сохранить скачанный XML-файл документа.";
				Сообщение.Сообщить();
				Возврат;
			КонецЕсли;
			
			ПараметрыОповещения = Новый Структура;
			ПараметрыОповещения.Вставить("ФайлPDF", ВременныйФайлPDF);
			ПараметрыОповещения.Вставить("ФайлXML", ВременныйФайлXML);
			Оповещение = Новый ОписаниеОповещения("ОбработкаЗакрытияФормыПросмотраДокумента", ЭтотОбъект, ПараметрыОповещения);
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("ФайлPDF", ВременныйФайлPDF);
			ПараметрыОткрытия.Вставить("ФайлXML", ВременныйФайлXML);
			ПараметрыОткрытия.Вставить("НомерМЧДПодписи", НомерМЧДПодписи);
			ПараметрыОткрытия.Вставить("ПричинаОтклонения", Строка(Элемент.ТекущиеДанные.ПричинаОтклоненияДокумента));
			ОткрытьФорму("ВнешняяОбработка.ОФД_ЭДО.Форма.ФормаПросмотраДокумента", ПараметрыОткрытия,,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);	
			
		Иначе
			
			Если РезультатПолученияКонтента.Ошибка Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Не удалось получить контент документа в формате PDF."+Символы.ПС+"Описание ошибки:"+Символы.ПС+РезультатПолученияКонтента.Описание;
				Сообщение.Сообщить();
			КонецЕсли;
			Если РезультатПолученияКонтентаXML.Ошибка Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Не удалось получить контент документа в формате XML."+Символы.ПС+"Описание ошибки:"+Символы.ПС+РезультатПолученияКонтентаXML.Описание;
				Сообщение.Сообщить();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИсходящихВходящихАктивацияСтроки(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	НомерМЧДПодписи = "";
	ПричинаОтклоненияДокумента = "";
	
	ЭтаФорма.Элементы.КнопкаПодписать.Доступность = Истина;
	
	// Получаем подпись JSON
	ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
	ПараметрыЗапроса.Параметры.Вставить("<document_id>", Элемент.ТекущиеДанные.id);
	РезультатПолученияПодписиJSON = ВыполнитьЗапросAPI("API_ПолучитьПодписьДокументаJSON", ПараметрыЗапроса);
	
	Если НЕ РезультатПолученияПодписиJSON.Ошибка Тогда
		Если ТипЗнч(РезультатПолученияПодписиJSON.Результат) = Тип("Структура") Тогда
			Если РезультатПолученияПодписиJSON.Результат.Свойство("poa") И НЕ РезультатПолученияПодписиJSON.Результат.poa = Неопределено Тогда
				НомерМЧДПодписи = Строка(РезультатПолученияПодписиJSON.Результат.poa.number);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
	ПричинаОтклоненияДокумента = Строка(Элемент.ТекущиеДанные.ПричинаОтклоненияДокумента);
	
	Если Элемент.Имя = "ТаблицаИсходящих" Тогда
		ЭтаФорма.ПричинаОтклоненияВыделенногоИсходящего = ПричинаОтклоненияДокумента;
		ЭтаФорма.НомерМЧДВыделенногоИсходящего = НомерМЧДПодписи;                                                    
		Элементы.ПричинаОтклоненияВыделенногоИсходящего.Видимость = ЗначениеЗаполнено(ЭтаФорма.ПричинаОтклоненияВыделенногоИсходящего);
		Элементы.НомерМЧДВыделенногоИсходящего.Видимость = ЗначениеЗаполнено(ЭтаФорма.НомерМЧДВыделенногоИсходящего);
	ИначеЕсли Элемент.Имя = "ТаблицаВходящих" Тогда
		ЭтаФорма.ПричинаОтклоненияВыделенногоВходящего = ПричинаОтклоненияДокумента;
		ЭтаФорма.НомерМЧДВыделенногоВходящего = НомерМЧДПодписи;
		Элементы.ПричинаОтклоненияВыделенногоВходящего.Видимость = ЗначениеЗаполнено(ЭтаФорма.ПричинаОтклоненияВыделенногоВходящего);
		Элементы.НомерМЧДВыделенногоВходящего.Видимость = ЗначениеЗаполнено(ЭтаФорма.НомерМЧДВыделенногоВходящего); 
		// Удалить++
		//Если Элемент.ТекущиеДанные.Односторонний = Истина тогда
		//	ЭтаФорма.Элементы.КнопкаПодписать.Доступность = Ложь;
		//КонецЕсли;
		// Удалить--
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Функция ПроверитьПодчиненныеДокументыНаСтатусОжиданияОплаты(СтруктураДокумента)
	
	Статус = "";
	
	Если НЕ СтруктураДокумента.Свойство("slaves") Тогда
		Статус = СтруктураДокумента.status;
	Иначе
		Для Каждого ПодчиненныйДокумент из СтруктураДокумента.slaves Цикл
			Статус = ПроверитьПодчиненныеДокументыНаСтатусОжиданияОплаты(ПодчиненныйДокумент);
			Если Статус = "AWAIT_PAYMENT" ИЛИ Статус = "SENDING_FAILED" Тогда
				Прервать;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
	
	Возврат Статус;
	
КонецФункции

&НаКлиенте
Функция ПроверитьПодчиненныеДокументыНаПредложениеОбАннулировании(СтруктураДокумента, ИдОрганизации)
	
	СтатусАннулированияДокумента = "";
	
	Если СтруктураДокумента.Свойство("slaves") Тогда
		
		Для Каждого ПодчиненныйДокумент из СтруктураДокумента.slaves Цикл
			Если ПодчиненныйДокумент.type = "DP_PRANNUL" Тогда
				// Это предложение об аннулировании. 
				Если ПодчиненныйДокумент.status = "SENT" Тогда
					// Есть предложение об аннулировании. Оно порписано и не было отклонено.
					Если Формат(ПодчиненныйДокумент.sender.id, "ЧГ=0") = ИдОрганизации Тогда
						СтатусАннулированияДокумента = "PreCancelledByUs"; 
					ИначеЕсли Формат(ПодчиненныйДокумент.recipient.id, "ЧГ=0") = ИдОрганизации Тогда
						СтатусАннулированияДокумента = "PreCancelledByThem";
					Иначе
						СтатусАннулированияДокумента = "PreCancelled";
					КонецЕсли;	
					Прервать;
				ИначеЕсли ПодчиненныйДокумент.status = "ACCEPTED" Тогда 
					СтатусАннулированияДокумента = "CANCELLED"; 
					Прервать;	
				КонецЕсли;
				// Документы в ответе располагаются в обратном хронологическом порядке.
				// Следовательно, если мы нашли предложение об аннулировании, то оно и есть самое актуальное из возможных,
				// прочие просматривать нет необходимости.
				Прервать;
			КонецЕсли;	
		КонецЦикла;		
		
	КонецЕсли;	
	
	Возврат СтатусАннулированияДокумента;
	
КонецФункции

// Удалить++
&НаКлиенте
Функция ПроверитьПодчиненныеДокументыНаНеподписанныеИзвещенияОПолучении(СтруктураДокумента)
	
	ИдентификаторНеподписанногоИзвещенияОПолучении = "";
	
	Если СтруктураДокумента.Свойство("slaves") Тогда
		
		Для Каждого ПодчиненныйДокумент из СтруктураДокумента.slaves Цикл
			
			// С 01.04.2026 ИОП заменяются на УС с кодом 1999.
			
			// Поиск УС с кодом 1999 (status = "ACK")
			Если ПодчиненныйДокумент.type = "DP_UNISOOBSCH" Тогда
				Если ПодчиненныйДокумент.universalMessageInfo.status = "ACK" Тогда
					// Ответный ИОП не требуется.
					Прервать;
				КонецЕсли;
			КонецЕсли;
			
			// На всякий случай проболжаем искать ИОП старого образца. // Удалить после гарантированного отказа от ИОП.
			Если ПодчиненныйДокумент.type = "DP_PDPOL" Тогда
				Если ПодчиненныйДокумент.status = "SIGNED" Тогда
					ИдентификаторНеподписанногоИзвещенияОПолучении = Формат(ПодчиненныйДокумент.id, "ЧГ=0");
					Прервать;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;		
		
	КонецЕсли;	
	
	Возврат ИдентификаторНеподписанногоИзвещенияОПолучении;
	
КонецФункции
// Удалить--

&НаКлиенте
Функция ОпределитьПричинуОтклонения(ЦепочкаДокумента)

	ПричинаОтклонения = "Не указана.";
	
	Для каждого ПодчиненныйДокумент из ЦепочкаДокумента.slaves Цикл
		Если ПодчиненныйДокумент.type = "DP_UVUTOCH" Тогда
			Если ПодчиненныйДокумент.Свойство("extra") и ПодчиненныйДокумент.extra.Свойство("reason") Тогда
				Если ЗначениеЗаполнено(ПодчиненныйДокумент.extra.reason) Тогда
					ПричинаОтклонения = ПодчиненныйДокумент.extra.reason;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат ПричинаОтклонения; 
	
КонецФункции	
	
&НаКлиенте
Процедура ОбновитьВыбранныеВходящиеИсходящиеДокументы()
		
	Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);	
	Если Интеграция.СпособИнтеграции <> 2 Тогда //НЕ API
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Получить информацию по входящим документам можно только при способе обмена 'API'. Измените способ обмена в настройках и повторите попытку.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;	
	
	// Определяем, входящие или исходящие документы требуется скачать.
	Если ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ИсхДокументы" Тогда
		МассивВыделенныхСтрок = Элементы["ТаблицаИсходящих"].ВыделенныеСтроки;
	ИначеЕсли ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ВхДокументы" Тогда
		МассивВыделенныхСтрок = Элементы["ТаблицаВходящих"].ВыделенныеСтроки;
	Иначе
		Возврат;
	КонецЕсли;
	
	Если МассивВыделенныхСтрок.Количество() <> 0 Тогда		
		МассивИдентификаторов = Новый Массив;
		Для Каждого Строка Из МассивВыделенныхСтрок Цикл
			ИдентификаторДокументаСтроки = Новый Структура();
			ДанныеСтроки = ЭтаФорма[?(ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ИсхДокументы", "ИсхДокументы", "ВхДокументы")].НайтиПоИдентификатору(Строка);
			ИдентификаторДокументаСтроки.Вставить("ИдентификаторСтроки", Строка);
			ИдентификаторДокументаСтроки.Вставить("ИдентификаторДокумента", ДанныеСтроки.id);
			МассивИдентификаторов.Добавить(ИдентификаторДокументаСтроки);			
		КонецЦикла;		
	КонецЕсли;	
	
	ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
	
	Для Каждого ИдентификаторДокументаСтроки из МассивИдентификаторов Цикл 
		
		ИдентификаторДокумента	= ИдентификаторДокументаСтроки.ИдентификаторДокумента;
		ИдентификаторСтроки		= ИдентификаторДокументаСтроки.ИдентификаторСтроки;
		
		ПараметрыЗапроса.Параметры.Вставить("<id>", ИдентификаторДокумента);
		ЦепочкаДокумента = ВыполнитьЗапросAPI("API_ПолучитьЦепочкиДокументов", ПараметрыЗапроса);
		
		Если НЕ ЦепочкаДокумента.Ошибка Тогда
			
			Если ЦепочкаДокумента.Результат = Неопределено Тогда
				// Пустой ответ.
				Продолжить;
			КонецЕсли;
			
			АктуальныйСтатусДокумента = ЦепочкаДокумента.Результат[0].status;
			
			ИдПолучателяДокумента = ИдентификаторОрганизации;
			
			СтатусПодчиненногоДокумента = ПроверитьПодчиненныеДокументыНаСтатусОжиданияОплаты(ЦепочкаДокумента.Результат[0]);
			СтатусПредложенияОбАннулировании = ПроверитьПодчиненныеДокументыНаПредложениеОбАннулировании(ЦепочкаДокумента.Результат[0], ИдПолучателяДокумента);
			
			// Удалить++
			Если РаботаемПоУС Тогда
				Если ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ИсхДокументы" Тогда
					ИдентификаторИзвещенияОПолучении = ПроверитьПодчиненныеДокументыНаНеподписанныеИзвещенияОПолучении(ЦепочкаДокумента.Результат[0]);
				КонецЕсли;
			КонецЕсли;
			// Удалить--
			
			Если СтатусПредложенияОбАннулировании = ""  Тогда 
				АктуальныйСтатусДокумента = ?(СтатусПодчиненногоДокумента = "AWAIT_PAYMENT" ИЛИ СтатусПодчиненногоДокумента = "SENDING_FAILED", СтатусПодчиненногоДокумента, АктуальныйСтатусДокумента);
			Иначе
				АктуальныйСтатусДокумента = СтатусПредложенияОбАннулировании;
			КонецЕсли;
			
			ДанныеСтроки = ЭтаФорма[?(ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ИсхДокументы", "ИсхДокументы", "ВхДокументы")].НайтиПоИдентификатору(ИдентификаторСтроки);
			ДанныеСтроки.СтатусЭДО = ПеревестиСтатусAPIвСтатус1С(АктуальныйСтатусДокумента);
			
			Если НЕ РаботаемПоУС Тогда
			// Удалить++
				ДанныеСтроки.ПредставлениеСтатусаЭДО = Элементы.ТаблицаВходящих_СтатусЭДО.СписокВыбора.НайтиПоЗначению(ДанныеСтроки.СтатусЭДО).Представление + ?(НЕ ИдентификаторИзвещенияОПолучении = "", ". Извещение не подписано", "");
			// Удалить--	
			Иначе
				ДанныеСтроки.ПредставлениеСтатусаЭДО = Элементы.ТаблицаВходящих_СтатусЭДО.СписокВыбора.НайтиПоЗначению(ДанныеСтроки.СтатусЭДО).Представление;
			КонецЕсли;	
				
		Иначе
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "При уточнении состояния документа "+ИдентификаторДокумента+" после операции произошла ошибка."+Символы.ПС+"Описание ошибки:"+Символы.ПС+ЦепочкаДокумента.Описание;
			Сообщение.Сообщить();
			
		КонецЕсли;	
		
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройкиСортировки_ОбработкаЗакрытияФормыОтбора(Результат, ДопПараметры) Экспорт
	
	Если НЕ Результат = Неопределено Тогда
		
		Если НЕ Результат.ПолеСортировки = "" Тогда
			ЭтаФорма[ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя].Сортировать(Результат.ПолеСортировки+" "+Результат.НаправлениеСортировки);
		КонецЕсли;	
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиСортировки(Элемент)
	
	ПараметрыОткрытияФормы = Новый Структура;
	Если ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ИсхДокументы" Тогда
		ПараметрыОткрытияФормы.Вставить("ПередаваемыйСписокЗначений", ЭтаФорма.СписокКолонокДляНастройкиСортировкиИсходящих);
	ИначеЕсли ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ВхДокументы" Тогда
		ПараметрыОткрытияФормы.Вставить("ПередаваемыйСписокЗначений", ЭтаФорма.СписокКолонокДляНастройкиСортировкиВходящих);
	КонецЕсли;
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ФормаНастройкиСортировки_ОбработкаЗакрытияФормыОтбора", ЭтаФорма);
	
	ОткрытьФорму(ИмяОбработки + ".Форма.ФормаВыбораПоляСортировки", ПараметрыОткрытияФормы, ЭтаФорма, , , , ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьСписокИсходящихВходящихВФайл() 

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Сохранение таблицы документов";
	Диалог.Расширение = "xls";
	
	Если Диалог.Выбрать() Тогда
		
		ТабДок = Новый ТабличныйДокумент;
				
		ПодготовитьТабличныйДокументВыгружаемойТаблицыДокументовНаСервере(ТабДок);

		ТабДок.Записать(Диалог.ПолноеИмяФайла, ТипФайлаТабличногоДокумента.XLS);
				
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура КолонкиСпискаИсходящих_ОбработкаВыбора(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатЗакрытия = Неопределено Тогда 
		ЭтаФорма.ВыводимыеКолонкиСпискаИсходящих = РезультатЗакрытия;
		ОбновитьВидимостьКолонокСпискаИсходящих();
		ОбщегоНазначенияВызовСервера.ХранилищеНастроекДанныхФормСохранить(ИмяОбработки, "ВыводимыеКолонкиСпискаИсходящих", ЭтаФорма.ВыводимыеКолонкиСпискаИсходящих, , ПолучитьТекущегоПользователя());	
	КонецЕсли;	
	
КонецПроцедуры
	
&НаКлиенте
Процедура ВыбратьКолонкиСпискаИсходящих()

	ОписаниеОповещения = Новый ОписаниеОповещения("КолонкиСпискаИсходящих_ОбработкаВыбора", ЭтаФорма);
	ЭтаФорма.ВыводимыеКолонкиСпискаИсходящих.ПоказатьОтметкуЭлементов(ОписаниеОповещения, "Выберите статусы");		
	
КонецПроцедуры	

&НаСервере
Процедура ОбновитьВидимостьКолонокСпискаИсходящих() 

	Для Каждого ЭлементСписка из ЭтаФорма.ВыводимыеКолонкиСпискаИсходящих Цикл
		Элементы["ТаблицаИсходящих_"+ЭлементСписка.Значение].Видимость = ЭлементСписка.Пометка;	
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура КолонкиСпискаВходящих_ОбработкаВыбора(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатЗакрытия = Неопределено Тогда 
		ЭтаФорма.ВыводимыеКолонкиСпискаВходящих = РезультатЗакрытия;
		ОбновитьВидимостьКолонокСпискаВходящих();
		ОбщегоНазначенияВызовСервера.ХранилищеНастроекДанныхФормСохранить(ИмяОбработки, "ВыводимыеКолонкиСпискаВходящих", ЭтаФорма.ВыводимыеКолонкиСпискаВходящих, , ПолучитьТекущегоПользователя());	
	КонецЕсли;	
	
КонецПроцедуры
	
&НаКлиенте
Процедура ВыбратьКолонкиСпискаВходящих()

	ОписаниеОповещения = Новый ОписаниеОповещения("КолонкиСпискаВходящих_ОбработкаВыбора", ЭтаФорма);
	ЭтаФорма.ВыводимыеКолонкиСпискаВходящих.ПоказатьОтметкуЭлементов(ОписаниеОповещения, "Выберите статусы");		
	
КонецПроцедуры	

&НаСервере
Процедура ОбновитьВидимостьКолонокСпискаВходящих() 

	Для Каждого ЭлементСписка из ЭтаФорма.ВыводимыеКолонкиСпискаВходящих Цикл
		Элементы["ТаблицаВходящих_"+ЭлементСписка.Значение].Видимость = ЭлементСписка.Пометка;	
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьТабличныйДокументВыгружаемойТаблицыДокументовНаСервере(ТабДок)
	
	Если ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ИсхДокументы" Тогда
		ВыгружаемаяТаблица = ЭтаФорма.ИсхДокументы;
	ИначеЕсли ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ВхДокументы" Тогда
		ВыгружаемаяТаблица = ЭтаФорма.ВхДокументы;
	Иначе
		Возврат ТабДок;
	КонецЕсли;
	
	Построитель = Новый ПостроительОтчета;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ВыгружаемаяТаблица.Выгрузить());       
	Построитель.Вывести(ТабДок);
	
	Возврат ТабДок;
	
КонецФункции	

&НаКлиенте
Функция ОпределитьДатуТитулаПолучателяЭлектронногоДокумента(ЦепочкаДокумента)

	ДатаТитула = Неопределено;
	
	Если ЦепочкаДокумента.Свойство("slaves") Тогда 

		Для Каждого ПодчиненныйДокумент из ЦепочкаДокумента.slaves Цикл
			
			Если ЦепочкаДокумента.type = "ON_NSCHFDOPPR" Тогда
				Если ПодчиненныйДокумент.type = "ON_NSCHFDOPPOK" Тогда
					ДатаТитула = ПодчиненныйДокумент.created;	
				КонецЕсли;	
			ИначеЕсли ЦепочкаДокумента.type = "ON_NKORSCHFDOPPR" Тогда
				Если ПодчиненныйДокумент.type = "ON_NKORSCHFDOPPOK" Тогда
					ДатаТитула = ПодчиненныйДокумент.created;	
				КонецЕсли;
			ИначеЕсли ЦепочкаДокумента.type = "ON_KORSCHFDOPPR" Тогда
				Если ПодчиненныйДокумент.type = "ON_KORSCHFDOPPOK" Тогда
					ДатаТитула = ПодчиненныйДокумент.created;	
				КонецЕсли;
			ИначеЕсли ЦепочкаДокумента.type = "DP_TOVTORGPR" Тогда
				Если ПодчиненныйДокумент.type = "DP_TOVTORGPOK" Тогда
					ДатаТитула = ПодчиненныйДокумент.created;	
				КонецЕсли;
			ИначеЕсли ЦепочкаДокумента.type = "DP_REZRUISP" Тогда
				Если ПодчиненныйДокумент.type = "DP_REZRUZAK" Тогда
					ДатаТитула = ПодчиненныйДокумент.created;	
				КонецЕсли;
			ИначеЕсли ЦепочкаДокумента.type = "DP_PRIRASXPRIN" Тогда
				Если ПодчиненныйДокумент.type = "DP_PRIRASXDOP" Тогда
					ДатаТитула = ПодчиненныйДокумент.created;	
				КонецЕсли;
			ИначеЕсли ЦепочкаДокумента.type = "ON_AKTSVEROTP" Тогда
				Если ПодчиненныйДокумент.type = "ON_AKTSVERPOL" Тогда
					ДатаТитула = ПодчиненныйДокумент.created;	
				КонецЕсли;	
			ИначеЕсли ЦепочкаДокумента.type = "UNFORMALIZED" Тогда 
				Если ПодчиненныйДокумент.type = "UNFORMALIZED" Тогда
					ДатаТитула = ПодчиненныйДокумент.created;	
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;	
	
	КонецЕсли;
	
	Возврат ДатаТитула;
	
КонецФункции	

#КонецОбласти

#Область РаботаСФильтрамиВходящихИсходящих

// Исходящие

&НаКлиенте
Процедура ПериодДляФильтраИсходящих_ОбработкаВыбора(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если НЕ РезультатЗакрытия = Неопределено Тогда
		
		ЭтаФорма.ПериодДляФильтраИсходящих = РезультатЗакрытия;
		Элементы.ФильтрИсходящихПоПериоду.Заголовок = "За период: " + РезультатЗакрытия;
		
	КонецЕсли;	
	
КонецПроцедуры	
	
&НаКлиенте
Процедура ПериодДляФильтраИсходящихНажатие(Элемент)

	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
    Диалог.Период = ЭтаФорма.ПериодДляФильтраИсходящих;
    Диалог.Показать(Новый ОписаниеОповещения("ПериодДляФильтраИсходящих_ОбработкаВыбора", ЭтотОбъект, Новый Структура("Диалог", Диалог)));
	
КонецПроцедуры	

&НаКлиенте
Процедура КонтрагентыДляФильтраИсходящих_ОбработкаЗакрытияФормыОтбора(Результат, ДопПараметры) Экспорт
	
	Если НЕ Результат = Неопределено Тогда
		
		Если Результат.Количество() = 0 Тогда
			ЭтаФорма.КонтрагентыДляФильтраИсходящих.Очистить();
			Элементы.ФильтрИсходящихПоКонтрагентам.Заголовок = "Контрагенты: Все";
			Элементы.ФильтрИсходящихПоКонтрагентам.Подсказка = "";
			Возврат;
		КонецЕсли;	
		
		ЭтаФорма.КонтрагентыДляФильтраИсходящих = Результат;
		
		Если СтрДлина(ЭтаФорма.КонтрагентыДляФильтраИсходящих) > 15 Тогда
			Элементы.ФильтрИсходящихПоКонтрагентам.Заголовок = "Контрагенты: " + Лев(ЭтаФорма.КонтрагентыДляФильтраИсходящих, 15) + "...";
		Иначе	
			Элементы.ФильтрИсходящихПоКонтрагентам.Заголовок = "Контрагенты: " + ЭтаФорма.КонтрагентыДляФильтраИсходящих;
		КонецЕсли;	
		Элементы.ФильтрИсходящихПоКонтрагентам.Подсказка = "" + ЭтаФорма.КонтрагентыДляФильтраИсходящих;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентыДляФильтраИсходящихНажатие(Элемент)
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("ПередаваемыйСписокЗначений", ЭтаФорма.КонтрагентыДляФильтраИсходящих);
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("КонтрагентыДляФильтраИсходящих_ОбработкаЗакрытияФормыОтбора", ЭтаФорма);
	
	ОткрытьФорму(ИмяОбработки + ".Форма.ФормаОтбораВСписокЗначений", ПараметрыОткрытияФормы, ЭтаФорма, , , , ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры	

&НаКлиенте
Процедура ПолеФильтраИсходящихПоСтатусам_ОбработкаВыбора(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	ЭтаФорма.СтатусДляФильтраИсходящих = "";
	ВыбранныеСтатусыПредставление = "";
	
