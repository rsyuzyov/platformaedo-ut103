Функция API_ПрикрепитьПодписьКДокументу_v3(Знач ПараметрыЗапроса) Экспорт 
	
	//СтрокаЗапроса = "/api/v2/documents/<id>/signature";
	СтрокаЗапроса = "/edm-document/public/api/v3/documents/<document_id>/signature";
	СтрокаЗапроса = ЗаполнитьПараметрыВЗапросе(СтрокаЗапроса, ПараметрыЗапроса.Параметры);
	ПараметрыЗапроса.Заголовки.Вставить("Content-Type", "application/octet-stream");
	
	СтруктураОтвета = ПолучитьШаблонСтруктурыОтвета();
	
	Запрос = Новый HTTPЗапрос(СтрокаЗапроса, ПараметрыЗапроса.Заголовки); 
	Запрос.УстановитьИмяФайлаТела(ПараметрыЗапроса.Параметры["<Тело>"]);
	
	Ответ = ПараметрыЗапроса.Соединение.ВызватьHTTPМетод("PUT",Запрос); 	
	СтруктураОтвета = ОбработатьОтвет(Ответ, СтруктураОтвета);
	
	Возврат СтруктураОтвета; 	 	
	
КонецФункции

