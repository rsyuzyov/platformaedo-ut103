Процедура СброситьДатуАктуальностиСтатусов(Команда)
	
	ПоследняяДатаОбновления = Дата(2020, 3, 6); //Дата запуска сервиса.
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокВходящихДокументов(Команда)
	
	ОбновитьСписокВходящихДокументовОбщее();	
	
КонецПроцедуры

#КонецОбласти

#Область КнопкиВыгрузить
// Кнопка для выгрузки массива документов
// Возвращает соответствие, где ключ - это ссылка на выгружаемый документ, значение - строка с выгрузкой документа

// Выгрузить выделенные на сервере
&НаСервере
Функция ВыгрузитьНаСервере(ТекущаяСтраница, ТипВыгрузки, ФормированиеДокументаДляПредпросмотра = Ложь)
	
	ИмяНастройки = ТекущаяСтраница + "_" + ТипВыгрузки; 
	
	//ТекущаяСтраница = ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя; 
	//
	//Если ФормированиеДокументаДляПредпросмотра = Истина И СпособИнтеграции = 2 Тогда
	//	// Предпросмотр доступен только по 1 выделенному документу. В данном случае - по текущей строке.
	//	// Иначе придётся открывать кучу форм предпросмотра. А зачем нам такой бардак?
	//	МассивДокументов = Новый Массив;
	//	МассивДокументов.Добавить(Элементы["ДинамическийСписок"+ТекущаяСтраница].ТекущаяСтрока);
	//Иначе
	//	//Выгружаем только выделенные пользователем строки	
	//	МассивДокументов = Элементы["ДинамическийСписок"+ТекущаяСтраница].ВыделенныеСтроки;
	//КонецЕсли;
	
	МассивДокументов = ОпределитьВыделенныеДокументы(ФормированиеДокументаДляПредпросмотра);
	
	// Переводим динамический список в таблицу значений (только для выбранных элементов)
	ТаблицаЗначений = СписокВТЗнаСервере(МассивДокументов);
	МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
	
	// Загружаем Кэш обработки из временного хранилища
	Кэш = ЗагрузитьКэш();
	
	//Результат = МодульОбъектаОбработки.ВыгрузитьМассивДокументов(МассивДокументов, ТипВыгрузки, Кэш);
	Результат = МодульОбъектаОбработки.ВыгрузитьМассивДокументов(ТаблицаЗначений, Организация, ИмяНастройки, ТипВыгрузки, Кэш, ФормированиеДокументаДляПредпросмотра);
	
	Если Результат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	// Если в Кэш были добавлены новые настройки, то сохраняем их в рамках текущего сеанса работы
	СохранитьКэш(Результат.Кэш);
	
	// Возвращаем результат выгрузки на клиент
	Возврат Результат.ВыгрузкаДокументов;
	
КонецФункции

&НаСервере
Функция ОпределитьВыделенныеДокументы(ФормированиеДокументаДляПредпросмотра = Ложь)

	ТекущаяСтраница = ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя; 
	
	Если ФормированиеДокументаДляПредпросмотра = Истина И СпособИнтеграции = 2 Тогда
		// Предпросмотр доступен только по 1 выделенному документу. В данном случае - по текущей строке.
		// Иначе придётся открывать кучу форм предпросмотра. А зачем нам такой бардак?
		МассивДокументов = Новый Массив;
		МассивДокументов.Добавить(Элементы["ДинамическийСписок"+ТекущаяСтраница].ТекущаяСтрока);
	Иначе
		//Выгружаем только выделенные пользователем строки	
		МассивДокументов = Элементы["ДинамическийСписок"+ТекущаяСтраница].ВыделенныеСтроки;
	КонецЕсли;
	
	Возврат МассивДокументов; 
	
КонецФункции	

// Выгрузить все на сервере
&НаСервере
Функция ВыгрузитьВсеНаСервере(ТипВыгрузки, ПотоковаяОтправка = Ложь)
	
	ИнтеграцияКаталог = ?(ЭтаФорма.СпособИнтеграции = 1, Истина, Ложь);
	
	// Переводим динамический список в таблицу значений (только для выбранных элементов)
	ТаблицаЗначений = СписокВТЗнаСервере();		
	
	МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
	
	// Загружаем Кэш обработки из временного хранилища
	Кэш = ЗагрузитьКэш();
	
	//Результат = МодульОбъектаОбработки.ВыгрузитьМассивДокументов(МассивДокументов, ТипВыгрузки, Кэш);
	Результат = МодульОбъектаОбработки.ВыгрузитьМассивДокументов(ТаблицаЗначений, ТипВыгрузки, Кэш);
	
	// Если в Кэш были добавлены новые настройки, то сохраняем их в рамках текущего сеанса работы
	СохранитьКэш(Результат.Кэш);
	
	// Возвращаем результат выгрузки на клиент
	Возврат Результат.ВыгрузкаДокументов;
	
КонецФункции
 
// Кнопка выгрузить
&НаКлиенте
Процедура Выгрузить(Команда)
	
	// Обработка ошибки - не заполнен формат выгрузки документа
	Если ФорматВыгрузки = "" Тогда
		Сообщить("Заполните формат выгрузки документа.");    
		Возврат ;
	КонецЕсли;     
	
	ТекущаяСтраница = ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя;
	
	Если Элементы["ДинамическийСписок"+ТекущаяСтраница].ВыделенныеСтроки.Количество() <> 0 Тогда
		// Передаем на сервер информацию о массиве документов к выгрузке и типе выгрузки
		ПроверитьИдентификаторыУчастниковЭДОПередОтправкой();
		//Результат = ВыгрузитьНаСервере(ТекущаяСтраница, ФорматВыгрузки);
	Иначе 
		Сообщить("Выберите хотя бы 1 документ для выгрузки с помощью выделения строк (зажав на клавишу 'Ctrl' или 'Shift' можно выделить несколько документов).");
		Возврат;
	КонецЕсли;
	
	//Если Результат = Неопределено Тогда
	//	Сообщить("Ни один документ из списка выбранных не был сформирован.");
	//	Возврат;
	//КонецЕсли;
	
	// Выгрузка документов в зависимости от способа интеграции
	
	// Каталог	
	Если СпособИнтеграции = 1 Тогда
		Результат = ВыгрузитьНаСервере(ТекущаяСтраница, ФорматВыгрузки);
		Если Результат = Неопределено Тогда
			Сообщить("Ни один документ из списка выбранных не был сформирован.");
			Возврат;
		КонецЕсли;
		ВыгрузитьВКаталог(Результат, КаталогОбмена);
	КонецЕсли;
	
	// API
	Если СпособИнтеграции = 2 Тогда
		ПроверкаИУтверждениеВыгрузкиЧерезAPIПоСтатусамДокументов(Ложь);	
	КонецЕсли;  	
	
КонецПроцедуры 

&НаКлиенте
Процедура ВыгрузитьВСоставеПакета(Команда)
	
	// Обработка ошибки - не заполнен формат выгрузки документа
	Если ФорматВыгрузки = "" Тогда
		Сообщить("Заполните формат выгрузки документа.");    
		Возврат ;
	КонецЕсли;     
	
	ТекущаяСтраница = ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя;
	
	Если Элементы["ДинамическийСписок"+ТекущаяСтраница].ВыделенныеСтроки.Количество() <> 0 Тогда
		// Передаем на сервер информацию о массиве документов к выгрузке и типе выгрузки
		ПроверитьИдентификаторыУчастниковЭДОПередОтправкой();
	Иначе 
		Сообщить("Выберите хотя бы 1 документ для выгрузки с помощью выделения строк (зажав на клавишу 'Ctrl' или 'Shift' можно выделить несколько документов).");
		Возврат;
	КонецЕсли;
	
	// Каталог	
	Если СпособИнтеграции = 1 Тогда
		Сообщить("Пакетная отправка возможна только при интеграции через API.");
	КонецЕсли;
	
	// API
	Если СпособИнтеграции = 2 Тогда
		ПроверкаИУтверждениеВыгрузкиЧерезAPIПоСтатусамДокументов(Истина);	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаИУтверждениеВыгрузкиЧерезAPIПоСтатусамДокументов(ПакетнаяОтправка = Ложь)
	
	Если НЕ ПакетнаяОтправка Тогда 
		ТекущаяСтраница = ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя;
		МассивСтруктурДляВыгрузки = ВыгрузитьНаСервере(ТекущаяСтраница, ФорматВыгрузки);
	КонецЕсли;
	
	МассивДокументов = ОпределитьВыделенныеДокументы();
	МассивСтруктурОписанияДокументов = СписокВМассивнаСервере(МассивДокументов);
		
	АктуальныеСтатусыДокументов = Неопределено;
	СтрокаИдентификаторов = "";
	ИдентификаторыДокументов = ПолучитьИдентификаторыДокументовИз1С(МассивДокументов);
	
	Для Каждого Элемент из ИдентификаторыДокументов Цикл
		СтрокаИдентификаторов = СтрокаИдентификаторов + Элемент.Значение + ",";	
	КонецЦикла;

	
	Если ЗначениеЗаполнено(СтрокаИдентификаторов) И НЕ СокрЛП(СтрокаИдентификаторов) = "," Тогда		
		ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
		ПараметрыЗапроса.Параметры.Вставить("<id>", СокрЛП(СтрокаИдентификаторов)); 		
		РезультатПоискаДокументов = ВыполнитьЗапросAPI("API_ПолучитьСписокДокументов", ПараметрыЗапроса);		
		Если НЕ РезультатПоискаДокументов.Ошибка Тогда			
			АктуальныеСтатусыДокументов = Новый Массив; 			
			Если РезультатПоискаДокументов.Результат = Неопределено Тогда
				// Пустой ответ, статуса нет.
			Иначе
				Для Каждого Документ из РезультатПоискаДокументов.Результат Цикл
					ИдентификаторДокументаОтвета = СокрЛП(Формат(Документ.id, "ЧДЦ=0; ЧГ=0"));
					АктуальныйСтатусОтвета = ПеревестиСтатусAPIвСтатус1С(Документ.status);
					АктуальныеСтатусыДокументов.Добавить(АктуальныйСтатусОтвета);	
				КонецЦикла;
			КонецЕсли;			
		КонецЕсли;		
	Иначе
		Если ПакетнаяОтправка Тогда
			ОткрытьФормуОтправкиДокументов(МассивСтруктурОписанияДокументов);
		Иначе
			ВыгрузитьЧерезAPI(МассивСтруктурДляВыгрузки, AccessToken);
		КонецЕсли;	
		Возврат;		
	КонецЕсли;
	
	ПсевдонимыСтатусов = Новый Соответствие;
	ПсевдонимыСтатусов.Вставить(1, 		"Неотправленные");
	ПсевдонимыСтатусов.Вставить(10, 	"Черновик");
	ПсевдонимыСтатусов.Вставить(11, 	"Ожидает оплаты");
	ПсевдонимыСтатусов.Вставить(12, 	"В процессе отправки");
	ПсевдонимыСтатусов.Вставить(13, 	"Аннулирован");
	ПсевдонимыСтатусов.Вставить(14, 	"Получен запрос на аннулирование");
	ПсевдонимыСтатусов.Вставить(15, 	"Отправлен запрос на аннулирование");
	ПсевдонимыСтатусов.Вставить(16, 	"Запрошено аннулирование");
	ПсевдонимыСтатусов.Вставить(17, 	"Запрос на уточнение");
	ПсевдонимыСтатусов.Вставить(20, 	"Ошибка выгрузки");		
	ПсевдонимыСтатусов.Вставить(21, 	"Ошибка загрузки");	
	ПсевдонимыСтатусов.Вставить(22, 	"Ошибка отправки");
	ПсевдонимыСтатусов.Вставить(23,		"Ошибка подписания");
	ПсевдонимыСтатусов.Вставить(24, 	"Ошибка записи документа");
	ПсевдонимыСтатусов.Вставить(30, 	"Выгружен в каталог");
	ПсевдонимыСтатусов.Вставить(40,		"Отправлен");
	ПсевдонимыСтатусов.Вставить(50,		"Доставлен");
	ПсевдонимыСтатусов.Вставить(60,		"Отклонен");
	ПсевдонимыСтатусов.Вставить(70, 	"Подписан");
	ПсевдонимыСтатусов.Вставить(90, 	"Удален");
	
	ДопПараметрыОповещения = Новый Структура;
	Если ПакетнаяОтправка = Истина Тогда
		ДопПараметрыОповещения.Вставить("МассивДокументов", МассивСтруктурОписанияДокументов);
		Оповещение = Новый ОписаниеОповещения("ОбработкаВопросаПереотправкиДокументов_Пакетная", ЭтотОбъект, ДопПараметрыОповещения);
	Иначе
		ДопПараметрыОповещения.Вставить("МассивДокументов", МассивСтруктурДляВыгрузки);
		Оповещение = Новый ОписаниеОповещения("ОбработкаВопросаПереотправкиДокументов", ЭтотОбъект, ДопПараметрыОповещения);
	КонецЕсли;
	
	// 13 - Отменен, 30 - был выгружен в каталог, 60 - Отклонён, 90 - Удалён.	
	Если МассивДокументов.Количество() = 1 Тогда
		
		Если НЕ АктуальныеСтатусыДокументов.Количество() = 0 Тогда
			
			АктуальныйСтатусДокумента = АктуальныеСтатусыДокументов[0];
			
			Если НЕ АктуальныйСтатусДокумента = 13 И НЕ АктуальныйСтатусДокумента = 30 И НЕ АктуальныйСтатусДокумента = 60 И НЕ АктуальныйСтатусДокумента = 90 Тогда
				
				ПоказатьВопрос(Оповещение, "Данный документ уже был отправлен. Текущий статус ЭДО по документу: """+ПсевдонимыСтатусов.Получить(АктуальныйСтатусДокумента)+""". Вы уверены?",
						РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
						
			Иначе			
						
				Если ПакетнаяОтправка Тогда
					ОткрытьФормуОтправкиДокументов(МассивСтруктурОписанияДокументов);
				Иначе
					ВыгрузитьЧерезAPI(МассивСтруктурДляВыгрузки, AccessToken);
				КонецЕсли;
						
			КонецЕсли;
					
		Иначе
			
			Если ПакетнаяОтправка Тогда
				ОткрытьФормуОтправкиДокументов(МассивСтруктурОписанияДокументов);
			Иначе
				ВыгрузитьЧерезAPI(МассивСтруктурДляВыгрузки, AccessToken);
			КонецЕсли;
			
		КонецЕсли;	
		
	ИначеЕсли МассивДокументов.Количество() > 1 Тогда
		
		Для Каждого Статус из АктуальныеСтатусыДокументов Цикл
			
			Если НЕ Статус = 13 И НЕ Статус = 30 И НЕ Статус = 60 И НЕ Статус = 90 Тогда
				
				ПоказатьВопрос(Оповещение, "Среди выделенных документов есть документы, которые уже были отправлены в ЭДО ранее. Вы уверены?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
				Возврат;
				
			КонецЕсли;	
				
		КонецЦикла;	
		
		Если ПакетнаяОтправка Тогда
			ОткрытьФормуОтправкиДокументов(МассивСтруктурОписанияДокументов);
		Иначе
			ВыгрузитьЧерезAPI(МассивСтруктурДляВыгрузки, AccessToken);
		КонецЕсли;
		
	Иначе
		
		Если ПакетнаяОтправка Тогда
			ОткрытьФормуОтправкиДокументов(МассивСтруктурОписанияДокументов);
		Иначе
			ВыгрузитьЧерезAPI(МассивСтруктурДляВыгрузки, AccessToken);
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаПереотправкиДокументов(Результат, Параметры) Экспорт 
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		МассивДокументов = Параметры.МассивДокументов;
		ВыгрузитьЧерезAPI(МассивДокументов, AccessToken);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаПереотправкиДокументов_Пакетная(Результат, Параметры) Экспорт 
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		МассивДокументов = Параметры.МассивДокументов;
		ОткрытьФормуОтправкиДокументов(МассивДокументов);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуОтправкиДокументов(МассивДокументовДляВыгрузки)
	
	ТекущаяСтраница = ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя;
	
	ПараметрыОткрытияФормы = Новый Структура();
	ПараметрыОткрытияФормы.Вставить("ПредставлениеТекущейКонфигурации", ПредставлениеТекущейКонфигурации);
	ПараметрыОткрытияФормы.Вставить("МассивДокументовДляВыгрузки", МассивДокументовДляВыгрузки);
	ПараметрыОткрытияФормы.Вставить("ТекущаяСтраница", ТекущаяСтраница);
	ПараметрыОткрытияФормы.Вставить("ФорматВыгрузки", ФорматВыгрузки);
	ПараметрыОткрытияФормы.Вставить("ПредставлениеФорматаВыгрузки", ПредставлениеФорматаВыгрузки);
	ПараметрыОткрытияФормы.Вставить("ВерсияФорматаВыгрузки", ВерсияФорматаВыгрузки);
	ПараметрыОткрытияФормы.Вставить("ПрефиксКонфигурации", ПрефиксКонфигурации);
	ПараметрыОткрытияФормы.Вставить("АдресВременногоХранилищаКэш", АдресВременногоХранилищаКэш);
	ПараметрыОткрытияФормы.Вставить("ИмяОбработки", ИмяОбработки);
	ПараметрыОткрытияФормы.Вставить("Организация", Организация);
	ПараметрыОткрытияФормы.Вставить("ИдентификаторОрганизации", ИдентификаторОрганизации);
	ПараметрыОткрытияФормы.Вставить("AccessToken", AccessToken);
	ПараметрыОткрытияФормы.Вставить("RefreshToken", RefreshToken);
	ПараметрыОткрытияФормы.Вставить("ИспользоватьПодписание", ИспользоватьПодписание);
	ПараметрыОткрытияФормы.Вставить("ВерсияНастроекОбработки", ВерсияНастроекОбработки);
	ПараметрыОткрытияФормы.Вставить("ОтпечатокСертификатаBase64", ОтпечатокСертификатаBase64);
	ПараметрыОткрытияФормы.Вставить("ПарольДоступаКЗакрытомуКлючу", ПарольДоступаКЗакрытомуКлючу);
	ПараметрыОткрытияФормы.Вставить("ТипСубъектаПодписанта", ТипСубъектаПодписанта);
	ПараметрыОткрытияФормы.Вставить("МчдGUIDПодписанта", МчдGUIDПодписанта);
	ПараметрыОткрытияФормы.Вставить("ДатаНачалаДействияМЧД", ДатаНачалаДействияМЧД);
	ПараметрыОткрытияФормы.Вставить("ДолжностьФизлица", ДолжностьФизлица);
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработкаЗакрытияФормыОтправкиДокументов", ЭтаФорма);
	ОткрытьФорму(ИмяОбработки + ".Форма.ФормаОтправкиЭлектронныхДокументов", ПараметрыОткрытияФормы, ЭтаФорма, , , , ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗакрытияФормыОтправкиДокументов(Результат, ДопПараметры) Экспорт
	
	ТекущаяСтраница = ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя;
	Элементы["ДинамическийСписок"+ТекущаяСтраница].Обновить();
	
КонецПроцедуры

// Кнопка выгрузить все (только для раборы с массовой выгрузкой)
&НаКлиенте
Процедура ВыгрузитьВсе(Команда)
	
	// Обработка ошибки - не заполнен формат выгрузки документа
	Если ФорматВыгрузки = "" Тогда
		Сообщить("Заполните формат выгрузки документа.");    
		Возврат ;
	КонецЕсли;
	
	Если ОбъемЕдиничнойВыгрузки = 0 Тогда
		Сообщить("Заполните параметры массовой выгрузки.");    
		Возврат ;		
	КонецЕсли; 	
	
	ТекущаяСтраница = ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя;	
	// Если выборка пустая, то не выгружаем
	//Если Элементы["ДинамическийСписок"+ТекущаяСтраница].ВыделенныеСтроки.Количество() <> 0 Тогда
	Сообщить("Выгрузка документов начата: " + Строка(ТекущаяДата()));
	
	Если ПотоковаяОтправка Тогда                                    
		
		КоличествоДокументов = ПолучитьКоличествоДокументовВОтборе();
		Счетчик = 0;
		Пока Счетчик < КоличествоДокументов Цикл
			
			ПроверитьИдентификаторыУчастниковЭДОПередОтправкой();
			Результат = ВыгрузитьВсеНаСервере(ФорматВыгрузки);
			
			// Выгрузка документов в зависимости от способа интеграции
			
			// Каталог	
			Если СпособИнтеграции = 1 Тогда
				ВыгрузитьВКаталог(Результат, КаталогОбмена);
			КонецЕсли;
			
			// API
			Если СпособИнтеграции = 2 Тогда 
				ВыгрузитьЧерезAPI(Результат, AccessToken);
			КонецЕсли;
			
			Счетчик = Счетчик + Результат.Количество();
			
		КонецЦикла; 		
	Иначе     		
		
		Результат = ВыгрузитьВсеНаСервере(ФорматВыгрузки);
		
		// Выгрузка документов в зависимости от способа интеграции
		
		// Каталог	
		Если СпособИнтеграции = 1 Тогда
			ВыгрузитьВКаталог(Результат, КаталогОбмена);
		КонецЕсли;
		
		// API
		Если СпособИнтеграции = 2 Тогда 
			ВыгрузитьЧерезAPI(Результат, AccessToken);
		КонецЕсли;  	
		
	КонецЕсли;
	
	Сообщить("Выгрузка документов закончена: " + Строка(ТекущаяДата()));
	
КонецПроцедуры

#КонецОбласти

#Область КнопкаПредпросмотрДокумента

&НаКлиенте
Процедура ОткрытьФормуПредпросмотраДокумента(Команда)
	
	Если СпособИнтеграции = 1 Тогда 
		Сообщить("Предпросмотр документов возможен только в режиме работы через API.");
		Возврат;
	КонецЕсли;
	
	ТекущаяСтраница = ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя;
	
	// Формируем 1 документ по текущей строке, без дополнительных объектов. 
	Результат = ВыгрузитьНаСервере(ТекущаяСтраница, ФорматВыгрузки, Истина);
	
	Если НЕ Результат = Неопределено И Результат.Количество() > 0 Тогда	
	
		Документ = Результат[0];
		
		Если Документ.Неформализованный = Ложь Тогда
			
			// Предпросмотр возможен только для Формализованных.
			
			ПутьКПодготовренномуФайлуДокумента = КаталогВременныхФайлов() + Документ.ИмяФайла +".xml";
						
			Файл = Новый ТекстовыйДокумент();                           
			Файл.ДобавитьСтроку(Документ.Выгрузка);
			Попытка
				Файл.Записать(ПутьКПодготовренномуФайлуДокумента, "windows-1251");
			Исключение
				Сообщить("Не удалось сохранить документ " + Строка(Документ.Ссылка) + " во временный каталог для предпросмотра.");
				Возврат;
			КонецПопытки;
			
			ДвоичнаяСтрокаФайла = Новый ДвоичныеДанные(ПутьКПодготовренномуФайлуДокумента);
			
			// Получаем PDF.
			ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
			ПараметрыЗапроса.Параметры.Вставить("<Тело>", ДвоичнаяСтрокаФайла);
			ПараметрыЗапроса.Заголовки.Вставить("Content-Type", "application/xml");
			ПараметрыЗапроса.Заголовки.Вставить("accept", "application/pdf");
			РезультатЗагрузкиКонтентаPDF = ВыполнитьЗапросAPI("API_ЗагрузитьКонтентДляПредпросмотра", ПараметрыЗапроса);
			

			Если НЕ РезультатЗагрузкиКонтентаPDF.Ошибка Тогда	
			
		    	ВременныйФайлPDF = ПолучитьИмяВременногоФайла("pdf");
				РезультатЗагрузкиКонтентаPDF.Результат.Записать(ВременныйФайлPDF);
				ФайлPDF = Новый Файл(ВременныйФайлPDF);
				
				ПараметрыОповещения = Новый Структура;
				ПараметрыОповещения.Вставить("ФайлPDF", ВременныйФайлPDF);
				ПараметрыОповещения.Вставить("ФайлXML", ПутьКПодготовренномуФайлуДокумента);
				Оповещение = Новый ОписаниеОповещения("ОбработкаЗакрытияФормыПросмотраДокумента", ЭтотОбъект, ПараметрыОповещения);
				ПараметрыОткрытия = Новый Структура;
				ПараметрыОткрытия.Вставить("ФайлPDF", ВременныйФайлPDF);
				ПараметрыОткрытия.Вставить("ФайлXML", ПутьКПодготовренномуФайлуДокумента);
				ОткрытьФорму("ВнешняяОбработка.ОФД_ЭДО.Форма.ФормаПросмотраДокумента", ПараметрыОткрытия,,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
			
			Иначе
				
				Если РезультатЗагрузкиКонтентаPDF.Ошибка И НЕ Документ.Выгрузка = "" Тогда 
					
					
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Не удалось загрузить сформированный электронный документ для предпросмотра в формате PDF."+Символы.ПС
												+"Описание ошибки:"+Символы.ПС+РезультатЗагрузкиКонтентаPDF.Описание;	
					Сообщение.Сообщить(); 
						
					ПараметрыОповещения = Новый Структура;
					ПараметрыОповещения.Вставить("ФайлXML", ПутьКПодготовренномуФайлуДокумента);
					Оповещение = Новый ОписаниеОповещения("ОбработкаЗакрытияФормыПросмотраДокумента", ЭтотОбъект, ПараметрыОповещения);
					ПараметрыОткрытия = Новый Структура;
					ПараметрыОткрытия.Вставить("ФайлXML", ПутьКПодготовренномуФайлуДокумента); 
					ПараметрыОткрытия.Вставить("ОшибкаPDF", Истина);
					ОткрытьФорму("ВнешняяОбработка.ОФД_ЭДО.Форма.ФормаПросмотраДокумента", ПараметрыОткрытия,,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

					
				КонецЕсли;	
			
			КонецЕсли;
	
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры 

&наКлиенте
Процедура ОбработкаЗакрытияФормыПросмотраДокумента(Результат, ДополнительныеПараметры) Экспорт 
	
	Если ДополнительныеПараметры.Свойство("ФайлPDF") тогда
		УдалитьФайлы(ДополнительныеПараметры.ФайлPDF);
	КонецЕсли;
	
	УдалитьФайлы(ДополнительныеПараметры.ФайлXML);
	
КонецПроцедуры

#КонецОбласти

#Область КнопкиУдалитьДокументы

&НаКлиенте
Процедура УдалитьОтправленныеДокументы(Команда)
	
	// Не API
	Если СпособИнтеграции <> 2 Тогда
		Сообщить("Удалить документы возможно только при способе обмена 'API'. Измените способ обмена в настройках и повторите попытку.");
		Возврат ;
	КонецЕсли;
	
	ТекущаяСтраница = ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя;
	МассивДокументов = Элементы["ДинамическийСписок"+ТекущаяСтраница].ВыделенныеСтроки;
	Если МассивДокументов.Количество() <> 0 Тогда
		
		//Добавить обработчик для случаев не хранения информации в 1С.
		МассивИдентификаторов = ПолучитьИдентификаторыДокументовИз1С(МассивДокументов);
		
		Если МассивИдентификаторов.Количество() = 0 Тогда
			Сообщить("Выберите загруженный в личный кабинет документ.");
			Возврат;
		КонецЕсли;
		
		СвойствоСтатус = ПолучитьСвойствоСтатусаНаСервере();
		
		Для Каждого Документ из МассивИдентификаторов Цикл 
			
			ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса(); 
			ПараметрыЗапроса.Параметры.Вставить("<document_id>", Документ.Значение); 
			
			УдалениеДокумента = ВыполнитьЗапросAPI("API_УдалитьДокумент", ПараметрыЗапроса);
			
			Если Не УдалениеДокумента.Ошибка Тогда
				
				// Статус документа
				ПараметрыЗаписи = ПолучитьСтруктуруПараметровЗаписиВРегистрСведений();
				
				ПараметрыЗаписи.НаименованиеРегистра	= "ДополнительныеСведения";
				ПараметрыЗаписи.Объект 					= Документ.Ключ;
				ПараметрыЗаписи.Свойство 				= СвойствоСтатус;
				//ПараметрыЗаписи.Значение 				= "Удален";
				ПараметрыЗаписи.Значение 				= 90;
				
				СтатусЭДО = ЗаписьВРегистрСведений(ПараметрыЗаписи);
				// Статус документа 
				
			Иначе
				Сообщить("Нельзя удалить документ в текущем статусе или не найден документ с идентификатором: " + Документ.Значение + "(" + УдалениеДокумента.Описание + ")");
			КонецЕсли;
			
		КонецЦикла;
		
		Элементы["ДинамическийСписок"+ТекущаяСтраница].Обновить();
		
	Иначе 
		Сообщить("Выберите хотя бы 1 документ для удаления с помощью выделения строк (зажав на клавишу 'Ctrl' или 'Shift' можно выделить несколько документов).");
		Возврат ;
	КонецЕсли;  	
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИсходящиеДокументы(Команда)
	
	// Не API
	Если СпособИнтеграции <> 2 Тогда
		Сообщить("Удалить документы возможно только при способе обмена 'API'. Измените способ обмена в настройках и повторите попытку.");
		Возврат ;
	КонецЕсли;
	
	МассивВыделенныхСтрок = Элементы["ТаблицаИсходящих"].ВыделенныеСтроки;
	
	Если МассивВыделенныхСтрок.Количество() <> 0 Тогда
		
		МассивИдентификаторов = Новый Массив;
	
		Для Каждого Строка Из МассивВыделенныхСтрок Цикл
			ДанныеСтроки = ЭтаФорма.ИсхДокументы.НайтиПоИдентификатору(Строка);
			Если ДанныеСтроки.СтатусЭДО = 10 Тогда
				МассивИдентификаторов.Добавить(ДанныеСтроки.id);
			КонецЕсли;			
		КонецЦикла;	
		
		Для Каждого Идентификатор из МассивИдентификаторов Цикл 
			
			ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса(); 
			ПараметрыЗапроса.Параметры.Вставить("<document_id>", Идентификатор); 
			
			УдалениеДокумента = ВыполнитьЗапросAPI("API_УдалитьДокумент",ПараметрыЗапроса);
			
			Если УдалениеДокумента.Ошибка Тогда
				Сообщить("При попытке удаления документа произошла ошибка:" + Идентификатор + "(" + УдалениеДокумента.Описание + ")");
			КонецЕсли;
			
		КонецЦикла;
		
		ОбновитьВыбранныеВходящиеИсходящиеДокументы();
		
	Иначе 
		Сообщить("Выберите хотя бы 1 документ для удаления с помощью выделения строк (зажав на клавишу 'Ctrl' или 'Shift' можно выделить несколько документов).");
		Возврат ;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область КнопкиАннулироватьДокументы

&НаКлиенте
Процедура АннулироватьДокументы(Команда)
	
	Если СпособИнтеграции <> 2 Тогда
		Сообщить("Аннулировать документы возможно только при способе обмена 'API'. Измените способ обмена в настройках и повторите попытку.");
		Возврат ;
	КонецЕсли;	
	
	Если НЕ ИспользоватьПодписание Тогда
		Сообщить("Аннулировать документы возможно только при использовании и настройке подписания.");
		Возврат ;	
	КонецЕсли;	
	
	// Определяем, входящие или исходящие документы требуется аннулировать.
	Если ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ИсхДокументы" Тогда
		МассивВыделенныхСтрок = Элементы["ТаблицаИсходящих"].ВыделенныеСтроки;
	ИначеЕсли ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ВхДокументы" Тогда
		МассивВыделенныхСтрок = Элементы["ТаблицаВходящих"].ВыделенныеСтроки;
	Иначе
		Возврат;
	КонецЕсли;
	
	Если МассивВыделенныхСтрок.Количество() = 1 Тогда
		
		ВыделеннаяСтрока = МассивВыделенныхСтрок[0]; 
		Строка = ЭтаФорма[ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя].НайтиПоИдентификатору(ВыделеннаяСтрока);
		
		Если НЕ Строка.СтатусЭДО = 10 И НЕ Строка.СтатусЭДО = 11 И НЕ Строка.СтатусЭДО = 11 И НЕ Строка.СтатусЭДО = 12 И НЕ Строка.СтатусЭДО = 13 И НЕ Строка.СтатусЭДО = 60 И НЕ Строка.СтатусЭДО = 90 Тогда
			
			Если Строка.СтатусЭДО = 70 И ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ВхДокументы" Тогда
				Сообщить("Запрашивать аннулирование входящих документов со стороны получателя можно только после подписания."+Символы.ПС+"Доступно отклонение документа.");
				Возврат;
			КонецЕсли;	
			
			#Область ПроверкаНаНаличиеПредложенийОбАннулировании
			
			// Надеюсь, эта часть временна.
			// На данный момент создать предложение об аннулировании можно лишь один раз.
			// Повторное предложение, после отказа от первого, создать невозможно.
			
			// Ищем предложение об аннулировании среди подчиненных документов.
			ПараметрыЗапросаЦепочкиДокумента = ПолучитьШаблонПараметровЗапроса();
			ПараметрыЗапросаЦепочкиДокумента.Параметры.Вставить("<id>", Строка.id);
			РезультатЗапросаЦепочкиДокумента = ВыполнитьЗапросAPI("API_ПолучитьЦепочкиДокументов", ПараметрыЗапросаЦепочкиДокумента);
		
			Если РезультатЗапросаЦепочкиДокумента.Ошибка = Истина ИЛИ РезультатЗапросаЦепочкиДокумента.Результат = Неопределено
					ИЛИ РезультатЗапросаЦепочкиДокумента.Результат.Количество() = 0 ИЛИ НЕ РезультатЗапросаЦепочкиДокумента.Результат[0].Свойство("slaves")
					ИЛИ РезультатЗапросаЦепочкиДокумента.Результат[0].slaves.Количество() = 0 Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "По документу с идентификатором "+Строка.id+" не удалось получить цепочку подчиненных документов.";
				Сообщение.Сообщить();
				Возврат;
			КонецЕсли;
			
			УжеБылоПредложеноАннулирование = Ложь;
	
			Для Каждого ПодчиненныйДокумент из РезультатЗапросаЦепочкиДокумента.Результат[0].slaves Цикл
				Если ПодчиненныйДокумент.type = "DP_PRANNUL" Тогда
					УжеБылоПредложеноАннулирование = Истина; 
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если УжеБылоПредложеноАннулирование Тогда
				Сообщить("К документы уже было ранее создано предложение об аннулировании, которое уже было отклонено.");
				Возврат;	
			КонецЕсли;	
			
			#КонецОбласти
			
			Оповещение = Новый ОписаниеОповещения("ПослеВводаПричиныАннулирования", ЭтаФорма, Строка.id);
			ПоказатьВводСтроки(Оповещение, "", "Введите текст, описывающий причину аннулирования (обязательно)", 0, Истина);	
		ИначеЕсли Строка.СтатусЭДО = 14 Тогда
			ПодтвердитьПредложениеОбАннулированииДокументовЧерезAPI(Строка.id);
			ОбновитьВыбранныеВходящиеИсходящиеДокументы();	
		Иначе
			Сообщить("Аннулировать можно только либо активные документы, либо с входящим предложением об аннулировании.");
			Возврат;	
		КонецЕсли;			
			
	ИначеЕсли МассивВыделенныхСтрок.Количество() = 0 Тогда  
		Сообщить("Выберите документ для аннулирования.");
		Возврат;
	ИначеЕсли МассивВыделенныхСтрок.Количество() > 1 Тогда  
		Сообщить("Аннулировать документы можно только поштучно."+Символы.ПС+"Для каждого аннулируемого документа требуется указать индивидуальную причину аннулирования.");
		Возврат;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаПричиныАннулирования(Строка, ИдентификаторДокумента) Экспорт
	
    Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Строка = "" Тогда
		Сообщить("При отправке предложения об аннулировании документа, обязательно требуется описать причину аннулирования.");
		Возврат;
	КонецЕсли;	
	
    ТекстПричиныАннулирования = Строка;
	ОтправитьПредложениеОбАннулированииДокументовЧерезAPI(ИдентификаторДокумента, ТекстПричиныАннулирования);
	ОбновитьВыбранныеВходящиеИсходящиеДокументы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтклонитьАннулирование(Команда)
	
	Если СпособИнтеграции <> 2 Тогда
		Сообщить("Отказаться от аннулирования документа возможно только при способе обмена 'API'. Измените способ обмена в настройках и повторите попытку.");
		Возврат ;
	КонецЕсли;	
	
	Если НЕ РаботаемПоУС Тогда
		// Удалить++
		// После полного перехода на УС
		Если НЕ ИспользоватьПодписание Тогда
			Сообщить("Отказаться от аннулирования документа возможно только при использовании и настройке подписания.");
			Возврат ;	
		КонецЕсли;
		// Удалить--
	КонецЕсли;
	
	// Определяем, входящие или исходящие документы требуется аннулировать.
	Если ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ИсхДокументы" Тогда
		МассивВыделенныхСтрок = Элементы["ТаблицаИсходящих"].ВыделенныеСтроки;
	ИначеЕсли ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ВхДокументы" Тогда
		МассивВыделенныхСтрок = Элементы["ТаблицаВходящих"].ВыделенныеСтроки;
	Иначе
		Возврат;
	КонецЕсли;
	
	Если МассивВыделенныхСтрок.Количество() = 1 Тогда
		
		ВыделеннаяСтрока = МассивВыделенныхСтрок[0]; 
		Строка = ЭтаФорма[ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя].НайтиПоИдентификатору(ВыделеннаяСтрока);
		
		Если Строка.СтатусЭДО = 14 Тогда
			СтруктураОписанияДокумента = Новый Структура;
            СтруктураОписанияДокумента.Вставить("ИдентификаторДокумента", Строка.id);
			СтруктураОписанияДокумента.Вставить("ИдентификаторОрганизации", ИдентификаторОрганизации);
			Если ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ИсхДокументы" Тогда
				СтруктураОписанияДокумента.Вставить("ИдентификаторКонтрагента", Строка.recipientIdДокумента);
			ИначеЕсли ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ВхДокументы" Тогда
				СтруктураОписанияДокумента.Вставить("ИдентификаторКонтрагента", Строка.senderIdДокумента);
			КонецЕсли;	
			Оповещение = Новый ОписаниеОповещения("ПослеВводаПричиныОтказаОтАннулирования", ЭтаФорма, СтруктураОписанияДокумента);
			ПоказатьВводСтроки(Оповещение, "", "Введите текст, описывающий причину отказа аннулирования (необязательно)", 0, Истина);	
		Иначе
			Сообщить("Отказаться от аннулирования можно только для тех документов, по которым есть входящее предложение об аннулировании.");
			Возврат;	
		КонецЕсли;			
			
	ИначеЕсли МассивВыделенныхСтрок.Количество() = 0 Тогда  
		Сообщить("Выберите документ для отказа от аннулирования.");
		Возврат;
	ИначеЕсли МассивВыделенныхСтрок.Количество() > 1 Тогда  
		Сообщить("Отказаться от аннулирования документов можно только поштучно.");
		Возврат;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаПричиныОтказаОтАннулирования(Строка, СтруктураОписанияДокумента) Экспорт
	
    Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
    ТекстПричиныОтказаОтАннулирования = Строка;
	ОтклонитьПредложениеОбАннулированииДокументовЧерезAPI(СтруктураОписанияДокумента, ТекстПричиныОтказаОтАннулирования);
	ОбновитьВыбранныеВходящиеИсходящиеДокументы();
	
КонецПроцедуры

#КонецОбласти

#Область КнопкаДоступныеЛицензии

 &НаКлиенте
Процедура ОткрытьФормуПросмотраЛицензийПоТокену(Команда)

	ПараметрыОткрытияФормы = Новый Структура();
	ПараметрыОткрытияФормы.Вставить("АдресВременногоХранилищаКэш", АдресВременногоХранилищаКэш);
	ПараметрыОткрытияФормы.Вставить("ИспользоватьПодписание", ИспользоватьПодписание);
	ПараметрыОткрытияФормы.Вставить("ВерсияНастроекОбработки", ВерсияНастроекОбработки);
	ОткрытьФорму(ИмяОбработки + ".Форма.ФормаПросмотраЛицензий", ПараметрыОткрытияФормы);
	
КонецПроцедуры

#КонецОбласти

#Область КнопкаРаботаСАбонентамиВЭДО

&НаКлиенте
Процедура ОткрытьФормуРаботыСАбонентамиВЭДО(Команда)
	
	ПараметрыОткрытияФормы = Новый Структура();
	ПараметрыОткрытияФормы.Вставить("ИмяОбработки", ИмяОбработки);
	ПараметрыОткрытияФормы.Вставить("Организация", Организация);
	ПараметрыОткрытияФормы.Вставить("AccessToken", AccessToken);
	ПараметрыОткрытияФормы.Вставить("RefreshToken", RefreshToken);
	ПараметрыОткрытияФормы.Вставить("ИспользоватьПодписание", ИспользоватьПодписание);
	ПараметрыОткрытияФормы.Вставить("ВерсияНастроекОбработки", ВерсияНастроекОбработки);
	ПараметрыОткрытияФормы.Вставить("ОтпечатокСертификатаBase64", ОтпечатокСертификатаBase64);
	ПараметрыОткрытияФормы.Вставить("ПарольДоступаКЗакрытомуКлючу", ПарольДоступаКЗакрытомуКлючу);
	ПараметрыОткрытияФормы.Вставить("ТипСубъектаПодписанта", ТипСубъектаПодписанта);
	ПараметрыОткрытияФормы.Вставить("МчдGUIDПодписанта", МчдGUIDПодписанта);
	ПараметрыОткрытияФормы.Вставить("ДатаНачалаДействияМЧД", ДатаНачалаДействияМЧД);
	ПараметрыОткрытияФормы.Вставить("ДолжностьФизлица", ДолжностьФизлица);
	ПараметрыОткрытияФормы.Вставить("АдресВременногоХранилищаКэш", АдресВременногоХранилищаКэш);
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработкаЗакрытияФормыРаботыСАбонентамиВЭДО", ЭтаФорма);
	ОткрытьФорму(ИмяОбработки + ".Форма.ФормаРаботыСАбонентамиЭДО", ПараметрыОткрытияФормы, ЭтаФорма, , , , ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

