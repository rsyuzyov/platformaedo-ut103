						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = "Входящее предложение об аннулировании с идентификатором " +ИдентификаторПредложенияОбАннулировании+ " было успешно отклонено.";
						Сообщение.Сообщить();
					КонецЕсли;	
					
					УдалитьФайлы(ИмяФайлаПодписи);
					
				КонецЕсли;
				
			Иначе
				
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Не удалось скачать уведомление об уточнении покупателя для предложения об аннулировании с идентификатором "+ИдентификаторПредложенияОбАннулировании+"."+Символы.ПС+"Описание ошибки:"+Символы.ПС+РезультатФормированияУОУ.Описание;
				Сообщение.Сообщить();
				Возврат;
				
			КонецЕсли;	
			
		Иначе	
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не удалось сформировать уведомление об уточнении покупателя для предложения об аннулировании с идентификатором "+ИдентификаторПредложенияОбАннулировании+"."+Символы.ПС+"Описание ошибки:"+Символы.ПС+РезультатФормированияУОУ.Описание;
			Сообщение.Сообщить();
			Возврат;
			
		КонецЕсли;
		
	// Удалить++
	Иначе
		
		ID_УС3999 = "";
		УСУжеСуществует = Ложь;
		
		// Проверка наличия УОУ или УС 3999.
		IDПОА = Формат(ИдентификаторПредложенияОбАннулировании, "ЧГ=");
		
		ПараметрыЗапросаЦепочкиДокумента = ПолучитьШаблонПараметровЗапроса();
		ПараметрыЗапросаЦепочкиДокумента.Параметры.Вставить("<id>", IDПОА);
		РезультатЗапросаЦепочкиДокумента = ВыполнитьЗапросAPI("API_ПолучитьЦепочкиДокументов", ПараметрыЗапросаЦепочкиДокумента);
		
		Если РезультатЗапросаЦепочкиДокумента.Ошибка Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Для документа предложения об аннулировании с идентификатором " +IDПОА+" не удалось получить цепочку подчиненных документов."+Символы.ПС+ "Описание ошибки:";
			Сообщение.Сообщить();
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = РезультатЗапросаЦепочкиДокумента.Описание;
			Сообщение.Сообщить();
			Возврат;				
		КонецЕсли;
		
		Если НЕ РезультатЗапросаЦепочкиДокумента.Результат.Количество() = 0 Тогда
			
			Если РезультатЗапросаЦепочкиДокумента.Результат[0].Свойство("slaves") И НЕ РезультатЗапросаЦепочкиДокумента.Результат[0].slaves.Количество() = 0 Тогда
				
				Для Каждого ПодчиненныйДокумент из РезультатЗапросаЦепочкиДокумента.Результат[0].slaves Цикл
					Если ПодчиненныйДокумент.type = "DP_UVUTOCH" Тогда
						// Это УОУ по старому стандарту.
						// Удалить++
						Если ПодчиненныйДокумент.newStatus = "SENT" ИЛИ ПодчиненныйДокумент.newStatus = "ACCEPTED" Тогда
							Если НЕ ТекущаяДата() >= РаботаПоУС_ДатаНачала Тогда
								УСУжеСуществует = Истина;
								Прервать;
							КонецЕсли;	
						КонецЕсли;
						// Удалить--
					ИначеЕсли ПодчиненныйДокумент.type = "DP_UNISOOBSCH" Тогда
						Если ПодчиненныйДокумент.newStatus = "SENT" И ПодчиненныйДокумент.universalMessageInfo.status = "REJECTION" Тогда
							УСУжеСуществует = Истина;
							Прервать;
						КонецЕсли;	
					КонецЕсли;	
				КонецЦикла;
				
			КонецЕсли;
			
			Если НЕ УСУжеСуществует Тогда 
				
				СтрокаТелаДляФормированияУС = ""; СоставитьУниверсальноеСообщение(СтруктураОписанияДокумента.ИдентификаторОрганизации, СтруктураОписанияДокумента.ИдентификаторКонтрагента, "REJECTION", СубъектСертификата, ТекстПричиныОтказа);
				
				ПараметрыЗапросаФормированияКвитанции = ПолучитьШаблонПараметровЗапроса();
				ПараметрыЗапросаФормированияКвитанции.Параметры.Вставить("<document_id>", IDПОА);
				ПараметрыЗапросаФормированияКвитанции.Параметры.Вставить("<Тело>", СтрокаТелаДляФормированияУС);
				
				РезультатФормированияУС = ВыполнитьЗапросAPI("API_СформироватьУниверсальноеСообщение", ПараметрыЗапросаФормированияКвитанции);
				
				Если РезультатФормированияУС.Ошибка = Истина Тогда 
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Не удалось сформировать универсальное сообщение с уведомлением о получении для документа предложения об аннулировании с идентификатором " +IDПОА+"."+Символы.ПС+"Описание ошибки:";
					Сообщение.Сообщить();
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = РезультатФормированияУС.Описание;
					Сообщение.Сообщить();
					Возврат;
				КонецЕсли;	
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры	

#КонецОбласти

