							ИмяФайлаПодписи = ПодписатьДокумент(Файл.ИмяБезРасширения, ВременныйФайл, Менеджер, Сертификат, ПарольСертификата, ".signature.p7b");
							
							ПараметрыЗапросаПодписиТитула = ПолучитьШаблонПараметровЗапроса();
							ПараметрыЗапросаПодписиТитула.Параметры.Вставить("<document_id>", IDДокументаУОУ); 
							
							ПодписьДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаПодписи); 
							
							ЭлектроннаяПодписьCMSBase64 = Base64Строка(ПодписьДвоичныеДанные);
							ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ПС, "");
							ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ВК, "");
							ЭлектроннаяПодписьCMSвDERвURL = КодироватьBase64СтрокуВСтрокуURLНаСервере(ЭлектроннаяПодписьCMSBase64);
							
							СтруктураДанных = Новый Структура;
							СтруктураДанных.Вставить("value", ЭлектроннаяПодписьCMSBase64);
							Если ТипСубъектаПодписанта = "ФЛ" Тогда
								СтруктураPOA = Новый Структура;
								СтруктураPOA.Вставить("number", МчдGUIDПодписанта);
								СтруктураДанных.Вставить("poa", СтруктураPOA);
							КонецЕсли;
							ЗаписьJSON = Новый ЗаписьJSON;
							ЗаписьJSON.УстановитьСтроку();
							ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
							СтрокаТелаДляПередачиПодписи = ЗаписьJSON.Закрыть();
							ПараметрыЗапросаПодписиТитула.Параметры.Вставить("<Тело>", СтрокаТелаДляПередачиПодписи);
							
							РезультатПодписанияДокумента = ВыполнитьЗапросAPI("API_ПрикрепитьПодписьКДокументу", ПараметрыЗапросаПодписиТитула); 
							
							Если РезультатПодписанияДокумента.Ошибка Тогда
								Сообщение = Новый СообщениеПользователю;
								Сообщение.Текст = "Уведомление об уточнении документа с идентификатором "+Идентификатор.Ключ+" был успешно сформировано, но не мог быть подписан. Идентификатор документа титула: " +IDДокументаУОУ+Символы.ПС+ "Описание ошибки подписания:";
								Сообщение.Сообщить();
								Сообщение = Новый СообщениеПользователю;
								Сообщение.Текст = РезультатПодписанияДокумента.Описание;
								Сообщение.Сообщить();
							Иначе
								Сообщение = Новый СообщениеПользователю;
								Сообщение.Текст = "Входящих документ с идентификатором " +Идентификатор.Ключ+ " был успешно отклонён.";
								Сообщение.Сообщить();
							КонецЕсли;	
							
							УдалитьФайлы(ИмяФайлаПодписи);
							
						КонецЕсли;
						
					Иначе
						
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = "Не удалось скачать уведомление об уточнении покупателя для документа с идентификатором "+Идентификатор.Ключ+"."+Символы.ПС+"Описание ошибки:"+Символы.ПС+РезультатФормированияУОУ.Описание;
						Сообщение.Сообщить();
						Продолжить;
						
					КонецЕсли;	
					
				Иначе	
					
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Не удалось сформировать уведомление об уточнении покупателя для документа с идентификатором "+Идентификатор.Ключ+"."+Символы.ПС+"Описание ошибки:"+Символы.ПС+РезультатФормированияУОУ.Описание;
					Сообщение.Сообщить();
					Продолжить;
					
				КонецЕсли;
				
			Иначе
				
				ID_УС3999 = "";
				УСУжеСуществует = Ложь;
				
				// Проверка наличия УОУ или УС 3999.
				IDДокумента = Формат(Идентификатор.Ключ, "ЧГ=");
				ПараметрыЗапросаЦепочкиДокумента = ПолучитьШаблонПараметровЗапроса();
				ПараметрыЗапросаЦепочкиДокумента.Параметры.Вставить("<id>", IDДокумента);
				РезультатЗапросаЦепочкиДокумента = ВыполнитьЗапросAPI("API_ПолучитьЦепочкиДокументов", ПараметрыЗапросаЦепочкиДокумента);
				
				Если РезультатЗапросаЦепочкиДокумента.Ошибка Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Для документа с идентификатором " +IDДокумента+" не удалось получить цепочку подчиненных документов."+Символы.ПС+ "Описание ошибки:";
					Сообщение.Сообщить();
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = РезультатЗапросаЦепочкиДокумента.Описание;
					Сообщение.Сообщить();
					Продолжить;				
				КонецЕсли;
				
				Если НЕ РезультатЗапросаЦепочкиДокумента.Результат.Количество() = 0 Тогда
					
					Если РезультатЗапросаЦепочкиДокумента.Результат[0].Свойство("slaves") И НЕ РезультатЗапросаЦепочкиДокумента.Результат[0].slaves.Количество() = 0 Тогда
						
						Для Каждого ПодчиненныйДокумент из РезультатЗапросаЦепочкиДокумента.Результат[0].slaves Цикл
							Если ПодчиненныйДокумент.type = "DP_UVUTOCH" Тогда
								// Это УОУ по старому стандарту.
								// Удалить++
								Если ПодчиненныйДокумент.newStatus = "SENT" ИЛИ ПодчиненныйДокумент.newStatus = "ACCEPTED" Тогда
									Если НЕ ТекущаяДата() >= РаботаПоУС_ДатаНачала Тогда
										УСУжеСуществует = Истина;
										Прервать;
									КонецЕсли;	
								КонецЕсли;
								// Удалить--
							ИначеЕсли ПодчиненныйДокумент.type = "DP_UNISOOBSCH" Тогда
								Если ПодчиненныйДокумент.newStatus = "SENT" И ПодчиненныйДокумент.universalMessageInfo.status = "REJECTION" Тогда
									УСУжеСуществует = Истина;
									Прервать;
								КонецЕсли;	
							КонецЕсли;	
						КонецЦикла;
						
					КонецЕсли;
					
					Если НЕ УСУжеСуществует Тогда 
				
						СтрокаТелаДляФормированияУС = СоставитьУниверсальноеСообщение(Идентификатор.Значение.ИдентификаторОрганизации, Идентификатор.Значение.ИдентификаторКонтрагента, "REJECTION", СубъектСертификата, ТекстПричиныОтказа);

						ПараметрыЗапросаФормированияКвитанции = ПолучитьШаблонПараметровЗапроса();
						ПараметрыЗапросаФормированияКвитанции.Параметры.Вставить("<document_id>", Идентификатор.Ключ);
						ПараметрыЗапросаФормированияКвитанции.Параметры.Вставить("<Тело>", СтрокаТелаДляФормированияУС);
						
						РезультатФормированияУС = ВыполнитьЗапросAPI("API_СформироватьУниверсальноеСообщение", ПараметрыЗапросаФормированияКвитанции);
						
						Если РезультатФормированияУС.Ошибка = Истина Тогда 
							Сообщение = Новый СообщениеПользователю;
							Сообщение.Текст = "Не удалось сформировать универсальное сообщение с уведомлением о получении для документа с идентификатором "+Идентификатор.Ключ+"."+Символы.ПС+"Описание ошибки:";
							Сообщение.Сообщить();
							Сообщение = Новый СообщениеПользователю;
							Сообщение.Текст = РезультатФормированияУС.Описание;
							Сообщение.Сообщить();
							Продолжить;
						КонецЕсли;	
				
					КонецЕсли;
			
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗатребоватьУточнениеПоВходящимДокументамЧерезAPI(СписокИдентификаторовДокументов, ТекстПричиныЗапроса = "") Экспорт

	Если НЕ РаботаемПоУС Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Отправка запроса на уточнение возможно только в режиме работы через универсальные сообщения.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Интеграция			= ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	Менеджер			= ПолучитьМенеджерКриптографии();
	Сертификат			= ПолучитьЭЦППоОтпечатку(Менеджер, Base64Значение(ОтпечатокСертификатаBase64));
	
	СубъектСертификата	= Сертификат.Субъект;
	
	Для каждого Идентификатор из СписокИдентификаторовДокументов Цикл
		
		ID_УС2999 = "";
		УСУжеСуществует = Ложь;
		
		// Проверка наличия УС 2999.
		IDДокумента = Формат(Идентификатор.Ключ, "ЧГ=");
		
		ПараметрыЗапросаЦепочкиДокумента = ПолучитьШаблонПараметровЗапроса();
		ПараметрыЗапросаЦепочкиДокумента.Параметры.Вставить("<id>", IDДокумента);
		РезультатЗапросаЦепочкиДокумента = ВыполнитьЗапросAPI("API_ПолучитьЦепочкиДокументов", ПараметрыЗапросаЦепочкиДокумента);
		
		Если РезультатЗапросаЦепочкиДокумента.Ошибка Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Для документа с идентификатором " +IDДокумента+" не удалось получить цепочку подчиненных документов."+Символы.ПС+ "Описание ошибки:";
			Сообщение.Сообщить();
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = РезультатЗапросаЦепочкиДокумента.Описание;
			Сообщение.Сообщить();
			Продолжить;				
		КонецЕсли;
		
		Если НЕ РезультатЗапросаЦепочкиДокумента.Результат.Количество() = 0 Тогда
			
			Если РезультатЗапросаЦепочкиДокумента.Результат[0].Свойство("slaves") И НЕ РезультатЗапросаЦепочкиДокумента.Результат[0].slaves.Количество() = 0 Тогда
				
				Для Каждого ПодчиненныйДокумент из РезультатЗапросаЦепочкиДокумента.Результат[0].slaves Цикл
					Если ПодчиненныйДокумент.type = "DP_UNISOOBSCH" Тогда
						Если ПодчиненныйДокумент.newStatus = "SENT" И ПодчиненныйДокумент.universalMessageInfo.status = "CORRECTION" Тогда
							УСУжеСуществует = Истина;
							Прервать;
						КонецЕсли;	
					КонецЕсли;	
				КонецЦикла;
				
			КонецЕсли;
			
			Если НЕ УСУжеСуществует Тогда 
				
				СтрокаТелаДляФормированияУС = СоставитьУниверсальноеСообщение(Идентификатор.Значение.ИдентификаторОрганизации, Идентификатор.Значение.ИдентификаторКонтрагента, "CORRECTION", СубъектСертификата, ТекстПричиныЗапроса);
				
				ПараметрыЗапросаФормированияКвитанции = ПолучитьШаблонПараметровЗапроса();
				ПараметрыЗапросаФормированияКвитанции.Параметры.Вставить("<document_id>", Идентификатор.Ключ);
				ПараметрыЗапросаФормированияКвитанции.Параметры.Вставить("<Тело>", СтрокаТелаДляФормированияУС);
				
				РезультатФормированияУС = ВыполнитьЗапросAPI("API_СформироватьУниверсальноеСообщение", ПараметрыЗапросаФормированияКвитанции);
				
				Если РезультатФормированияУС.Ошибка = Истина Тогда 
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Не удалось сформировать универсальное сообщение с запросом об уточнении для документа с идентификатором "+Идентификатор.Ключ+"."+Символы.ПС+"Описание ошибки:";
					Сообщение.Сообщить();
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = РезультатФормированияУС.Описание;
					Сообщение.Сообщить();
					Продолжить;
				КонецЕсли;	
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Функция СоставитьУниверсальноеСообщение(ИдОтправителя, ИдПолучателя, СтатусУС, Субъект, Комментарий = "")
		
	ФамилияСубъекта			= Субъект.SN;
	ИмяОтчествоСубъекта 	= СтрРазделить(Субъект.GN, " ");
	ИмяСубъекта				= ИмяОтчествоСубъекта[0];
	ОтчествоСубъекта 		= ИмяОтчествоСубъекта[1];
	
	СтруктураДанных = Новый Структура;
	СтруктураОтправитель = Новый Структура;
	СтруктураОтправитель.Вставить("id", ИдОтправителя);
	СтруктураДанных.Вставить("sender", СтруктураОтправитель);
	СтруктураПолучатель = Новый Структура;
	СтруктураПолучатель.Вставить("id", ИдПолучателя);
	СтруктураДанных.Вставить("recipient", СтруктураПолучатель);
	СтруктураДанных.Вставить("status", СтатусУС);
	Если ЗначениеЗаполнено(Комментарий) Тогда
		СтруктураДанных.Вставить("description", Комментарий);
	КонецЕсли;	
	СтруктураФИО = Новый Структура;
	СтруктураФИО.Вставить("first", ИмяСубъекта);            
	СтруктураФИО.Вставить("last", ФамилияСубъекта);
	СтруктураФИО.Вставить("middle", ОтчествоСубъекта);
	СтруктураДанных.Вставить("senderPerson", СтруктураФИО);	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
	СтрокаТелаДляФормированияУС = ЗаписьJSON.Закрыть();
	
	Возврат СтрокаТелаДляФормированияУС 
	
КонецФункции	

&НаКлиенте
Процедура ОтправитьПредложениеОбАннулированииДокументовЧерезAPI(ИдентификаторДокумента, ТекстПричиныАннулирования) Экспорт

	Если ТекстПричиныАннулирования = "" Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "При отправке предложения об аннулировании документа, обязательно требуется описать причину аннулирования.";
		Сообщение.Сообщить();
		Возврат;	
	КонецЕсли;	
	
	Менеджер			= ПолучитьМенеджерКриптографии();
	Сертификат			= ПолучитьЭЦППоОтпечатку(Менеджер, Base64Значение(ОтпечатокСертификатаBase64));
	
	СубъектСертификата	= Сертификат.Субъект;
	ФамилияСубъекта		= СубъектСертификата.SN;
	ИмяОтчествоСубъекта = СтрРазделить(СубъектСертификата.GN, " ");
	ИмяСубъекта			= ИмяОтчествоСубъекта[0];
	ОтчествоСубъекта 	= ИмяОтчествоСубъекта[1];
	ДолжностьСубъекта	= ?(СубъектСертификата.Свойство("T"), ?(СубъектСертификата.T = "", "Индивидуальный предприниматель", СубъектСертификата.T), "Индивидуальный предприниматель");
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("reason", ТекстПричиныАннулирования);	
	СтруктураДанныхПодписанта = Новый Структура;
	СтруктураФИО = Новый Структура;
	СтруктураФИО.Вставить("first", ИмяСубъекта);            
	СтруктураФИО.Вставить("last", ФамилияСубъекта);
	СтруктураФИО.Вставить("middle", ОтчествоСубъекта);
	СтруктураДанныхПодписанта.Вставить("person", СтруктураФИО);
	СтруктураДанныхПодписанта.Вставить("position", ДолжностьСубъекта);
	СтруктураДанных.Вставить("signer", СтруктураДанныхПодписанта);	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
	СтрокаТелаДляФормированияПОА = ЗаписьJSON.Закрыть();
	
	ПараметрыЗапросаФормированияПОА = ПолучитьШаблонПараметровЗапроса();
	ПараметрыЗапросаФормированияПОА.Параметры.Вставить("<Тело>", СтрокаТелаДляФормированияПОА);
	
	ПараметрыЗапросаФормированияПОА.Параметры.Вставить("<document_id>", ИдентификаторДокумента);
	РезультатФормированияПОА = ВыполнитьЗапросAPI("API_СоздатьПредложенияОбАннулировании", ПараметрыЗапросаФормированияПОА);
	
	Если РезультатФормированияПОА.Ошибка ИЛИ РезультатФормированияПОА.Результат = Неопределено Тогда 			
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось сформировать предложение об аннулировании для документа с идентификатором "+ИдентификаторДокумента+"."+
								Символы.ПС+"Описание ошибки:"+Символы.ПС+РезультатФормированияПОА.Описание;
		Сообщение.Сообщить();
		Возврат;		
	КонецЕсли;
	
	ИдентификаторПОА = Формат(РезультатФормированияПОА.Результат.id, "ЧГ=0");
	
	ПараметрыЗапросаПолученияКонтента = ПолучитьШаблонПараметровЗапроса();
	ПараметрыЗапросаПолученияКонтента.Параметры.Вставить("<document_id>", ИдентификаторПОА);
	РезультатПолученияКонтента = ВыполнитьЗапросAPI("API_ПолучитьКонтентДокумента", ПараметрыЗапросаПолученияКонтента);
	
	Если РезультатПолученияКонтента.Ошибка Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось получить контекст документа предложения об аннулировании, сформированного к документу с идентификатором "+ИдентификаторДокумента+"."+
								Символы.ПС+"Идентификатор предложения об аннулировании: "+ИдентификаторПОА+"."+Символы.ПС+"Описание ошибки:"+Символы.ПС+РезультатПолученияКонтента.Описание;
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;	
	
	ВременныйФайл = ПолучитьИмяВременногоФайла("xml");
	РезультатПолученияКонтента.Результат.Записать(ВременныйФайл);
	Файл = Новый Файл(ВременныйФайл);
	
	Если НЕ Файл.Существует() Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось сохранить сформированный файл предложения об аннулировании для документа с идентификатором "+ИдентификаторДокумента+"."+
							Символы.ПС+"Идентификатор предложения об аннулировании: "+ИдентификаторПОА+".";
		Сообщение.Сообщить();
		Возврат;
		
	Иначе
		
		Менеджер			= ПолучитьМенеджерКриптографии();
		Сертификат			= ПолучитьЭЦППоОтпечатку(Менеджер, Base64Значение(ОтпечатокСертификатаBase64));
		
		ПарольСертификата = ?(ЗначениеЗаполнено(ПарольДоступаКЗакрытомуКлючу), ПарольДоступаКЗакрытомуКлючу, "");			
		
		ИмяФайлаПодписи = ПодписатьДокумент(Файл.ИмяБезРасширения, ВременныйФайл, Менеджер, Сертификат, ПарольСертификата, ".signature.p7b");				
		
		ПараметрыЗапросаПодписиПОА = ПолучитьШаблонПараметровЗапроса();
		ПараметрыЗапросаПодписиПОА.Параметры.Вставить("<document_id>", ИдентификаторПОА);
		
		ПодписьДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаПодписи); 
		
		ЭлектроннаяПодписьCMSBase64 = Base64Строка(ПодписьДвоичныеДанные);
		ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ПС, "");
		ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ВК, "");
		ЭлектроннаяПодписьCMSвDERвURL = КодироватьBase64СтрокуВСтрокуURLНаСервере(ЭлектроннаяПодписьCMSBase64);
		
