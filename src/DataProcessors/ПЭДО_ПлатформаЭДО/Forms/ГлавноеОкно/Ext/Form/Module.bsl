	ПараметрыЗапросаЦепочкиДокумента.Параметры.Вставить("<id>", ИдентификаторДокумента);
	РезультатЗапросаЦепочкиДокумента = ВыполнитьЗапросAPI("API_ПолучитьЦепочкиДокументов", ПараметрыЗапросаЦепочкиДокумента);
	
	Если РезультатЗапросаЦепочкиДокумента.Ошибка = Истина ИЛИ РезультатЗапросаЦепочкиДокумента.Результат = Неопределено
			ИЛИ РезультатЗапросаЦепочкиДокумента.Результат.Количество() = 0 ИЛИ НЕ РезультатЗапросаЦепочкиДокумента.Результат[0].Свойство("slaves")
			ИЛИ РезультатЗапросаЦепочкиДокумента.Результат[0].slaves.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "По документу с номером "+ИдентификаторДокумента+" не удалось получить цепочку подчиненных документов.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	ИдентификаторПредложенияОбАннулировании = "";
	
	Для Каждого ПодчиненныйДокумент из РезультатЗапросаЦепочкиДокумента.Результат[0].slaves Цикл
		Если ПодчиненныйДокумент.type = "DP_PRANNUL" Тогда
			// Это предложение об аннулировании. 
			Если НЕ ПодчиненныйДокумент.Свойство("slaves") Тогда
				// Нет ни одного подчинённого документа (уведомлений об уточнении).
				// Значит предложение не было отклонено.
				ИдентификаторПредложенияОбАннулировании = Формат(ПодчиненныйДокумент.id, "ЧГ=0"); 
				Прервать;
			Иначе
				КДокументуПриложеноПредложенияОбАннулировании = Истина;
				ИдентификаторПОА = Формат(ПодчиненныйДокумент.id, "ЧГ=0");
				Для Каждого ПодчиненныйПредложениюДокумент из ПодчиненныйДокумент.slaves Цикл
					Если ПодчиненныйПредложениюДокумент.type = "DP_UVUTOCH" Тогда
						// У предложения есть уведомление об уточнении.
						// Значит, оно было отклонено второй стороной.
						ИдентификаторПредложенияОбАннулировании = "";
						Прервать;
					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;
			// Документы в ответе располагаются в обратном хронологическом порядке.
			// Следовательно, если мы нашли предложение об аннулировании, то оно и есть самое актуальное из возможных,
			// прочие просматривать нет необходимости.
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	Если ИдентификаторПредложенияОбАннулировании = "" Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "У документа с номером "+ИдентификаторДокумента+" нет необработанных предложений об аннулировании.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	//Уведомление об уточнении.
	ПараметрыЗапросаФормированияУОУ.Параметры.Вставить("<document_id>", ИдентификаторПредложенияОбАннулировании);
	РезультатФормированияУОУ = ВыполнитьЗапросAPI("API_ПолучитьУведомлениеОбУточнении", ПараметрыЗапросаФормированияУОУ);
	
	Если НЕ РезультатФормированияУОУ.Ошибка Тогда
		
		IDДокументаУОУ = Формат(РезультатФормированияУОУ.Результат.ID, "ЧГ=");
		ПараметрыЗапросаПолученияКонтента = ПолучитьШаблонПараметровЗапроса();
