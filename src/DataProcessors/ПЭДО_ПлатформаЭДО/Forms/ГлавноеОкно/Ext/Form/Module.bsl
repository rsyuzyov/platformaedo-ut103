		Для Каждого ВыделеннаяСтрока из Элементы.ТаблицаИсходящих.ВыделенныеСтроки Цикл
			Строка = ЭтаФорма.ИсхДокументы.НайтиПоИдентификатору(ВыделеннаяСтрока);
			Если ЗначениеЗаполнено(Строка.ИдентификаторНеподписанногоИзвещения) Тогда
				ИдентификаторыИзвещений.Добавить(Строка.ИдентификаторНеподписанногоИзвещения); // УС убрать
			КонецЕсли;	
		КонецЦикла;	
		
		Если ИдентификаторыИзвещений.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;	
		
		ПодписатьИзвещенияЧерезAPI(ИдентификаторыИзвещений);
		ОбновитьВыбранныеВходящиеИсходящиеДокументы();
		
	Иначе
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Подписание и отклонение возможно только при использовании подписания.";
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокИсходящихДокументовОбщее()
	
	ЭтаФорма.ИсхДокументы.Очистить();
		
	Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);	
	Если Интеграция.СпособИнтеграции <> 2 Тогда //НЕ API
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Получить информацию по входящим документам можно только при способе обмена 'API'. Измените способ обмена в настройках и повторите попытку.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	СтруктураХранения1С				= ПолучитьСтруктуруХранения1С();
	СвойствоИдентификаторУчастника	= СтруктураХранения1С.СвойствоИдентификаторУчастника;
			
	ИдентификаторыОтправителей = ИдентификаторОрганизации;
	
	Если ИдентификаторыОтправителей = "" Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Идентификатор организации-отправителя не заполнен. Обновить идентификатор организации можно в разделе ""Поиск абонентов в ЭДО"".";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	КонтрагентыДляФильтраИсходящих = ЭтаФорма.КонтрагентыДляФильтраИсходящих;
	
	ИдентификаторыПолучателей = "";
	Счетчик = 1;
	Если НЕ ЭтаФорма.КонтрагентыДляФильтраИсходящих.Количество() = 0 Тогда
		Для Каждого КонтрагентФильтра Из КонтрагентыДляФильтраИсходящих Цикл
						
			ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
			ИННКППКонтрагента = ПолучитьИННКППНаименованиеУчастника(КонтрагентФильтра.Значение);
			ПараметрыЗапроса.Параметры.Вставить("<inn>", ИННКППКонтрагента.ИНН);
			Если ЗначениеЗаполнено(ИННКППКонтрагента.КПП) Тогда
				ПараметрыЗапроса.Параметры.Вставить("<kpp>", ИННКППКонтрагента.КПП);
			КонецЕсли;	
			ИнформацияОКонтрагенте = ВыполнитьЗапросAPI("API_ИнформацияОбАбоненте", ПараметрыЗапроса);
			
			Если Не ИнформацияОКонтрагенте.Ошибка Тогда
				Если ТипЗнч(ИнформацияОКонтрагенте.Результат) = Тип("Массив") и ИнформацияОКонтрагенте.Результат.Количество() <> 0 Тогда
					Для Каждого ЭлементРезультата из ИнформацияОКонтрагенте.Результат Цикл
						ИдентификаторАбонента = ЭлементРезультата.gid;
						ИдентификаторыПолучателей = ИдентификаторыПолучателей + ИдентификаторАбонента + ","; 
					КонецЦикла;		
				КонецЕсли;				
			КонецЕсли;	
			
			ИдентификаторКонтрагента1С = ПолучитьИдентификаторУчастникаЭДО(КонтрагентФильтра.Значение, СтруктураХранения1С);
			
			Если ЗначениеЗаполнено(ИдентификаторКонтрагента1С) Тогда
				Если СтрНайти(ИдентификаторыОтправителей, ИдентификаторКонтрагента1С) = 0 Тогда
					ИдентификаторыПолучателей = ИдентификаторыПолучателей + ИдентификаторКонтрагента1С + ",";
				КонецЕсли;	
			КонецЕсли;	
			
			Если  Счетчик = КонтрагентыДляФильтраИсходящих.Количество() Тогда 
				Если Прав(ИдентификаторыПолучателей, 1) = "," Тогда
					ИдентификаторыПолучателей = Лев(ИдентификаторыПолучателей, СтрДлина(ИдентификаторыПолучателей)-1);	
				КонецЕсли;	
			КонецЕсли;
			
			Счетчик = Счетчик + 1;
			
		КонецЦикла; 
	КонецЕсли;	
	
	ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
	ПараметрыЗапроса.Параметры.Вставить("<sender_id>", ИдентификаторыОтправителей);
	ПараметрыЗапроса.Параметры.Вставить("<type>", "SELLER_TITLE,NEW_SELLER_TITLE,COR_SELLER_TITLE,NEW_COR_SELLER_TITLE,TRADE_SELLER_TITLE,COMPLETION_CERTIFICATE,GS_ACCEPTANCE_REPORT,RECONCILIATION_REQUEST,UNFORMALIZED,PAYMENT_INVOICE");
	ПараметрыЗапроса.Параметры.Вставить("<page_size>", "1000");
	Если НЕ ИдентификаторыПолучателей = "" Тогда
		ПараметрыЗапроса.Параметры.Вставить("<recipient_id>", ИдентификаторыПолучателей);
	КонецЕсли;
	Если НЕ ЭтаФорма.СтатусДляФильтраИсходящих = "" Тогда
		ПараметрыЗапроса.Параметры.Вставить("<status>", ЭтаФорма.СтатусДляФильтраИсходящих);
	КонецЕсли;
	Если НЕ ЭтаФорма.ТипыДокументовДляФильтраИсходящих = "" Тогда 
		ПараметрыЗапроса.Параметры.Вставить("<type>", ЭтаФорма.ТипыДокументовДляФильтраИсходящих);	
	КонецЕсли;
	Если НЕ ЭтаФорма.НаличиеМаркировкиДляФильтраИсходящих = 0 Тогда
		Если ЭтаФорма.НаличиеМаркировкиДляФильтраИсходящих = 1 Тогда
			ПараметрыЗапроса.Параметры.Вставить("<labeled_goods>", "true");
		ИначеЕсли ЭтаФорма.НаличиеМаркировкиДляФильтраИсходящих = 2 Тогда
			ПараметрыЗапроса.Параметры.Вставить("<labeled_goods>", "false");
		КонецЕсли;	
	КонецЕсли;
	
	// Метод API может искать документы только максимум в пределах 31 дня.
	
	Счетчик = 0;
	ДеньЗапроса = ЭтаФорма.ПериодДляФильтраИсходящих.ДатаНачала;
	КонечныйДеньЗапроса = ЭтаФорма.ПериодДляФильтраИсходящих.ДатаОкончания;
	
	РазницаВДнях = (НачалоДня(КонечныйДеньЗапроса)-НачалоДня(ДеньЗапроса))/(60*60*24);
	
	Если РазницаВДнях >= 30 Тогда
		
		КонечныйДеньЗапроса = ДеньЗапроса;
	
		Пока КонечныйДеньЗапроса <= ЭтаФорма.ПериодДляФильтраИсходящих.ДатаОкончания Цикл
			
			ДатаНачалаВФорматеISO = ЗаписатьДатуJSON(НачалоДня(ДеньЗапроса), ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата);
			ДатаОкончанияВФорматеISO = СтрЗаменить(ЗаписатьДатуJSON(КонецДня(КонечныйДеньЗапроса), ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата), "Z", ".999999Z");	
			
			Если Счетчик = 30 ИЛИ КонечныйДеньЗапроса = НачалоДня(ТекущаяДата()) Тогда
				
				РезультатОбновленияЗаПериод = ОбновитьСписокИсходящихДокументовЗаПериод(ДатаНачалаВФорматеISO, ДатаОкончанияВФорматеISO, ПараметрыЗапроса, СвойствоИдентификаторУчастника);	
				Счетчик = 0;
				
				Если НЕ РезультатОбновленияЗаПериод ИЛИ ДеньЗапроса >= НачалоДня(ТекущаяДата()) Тогда
					Возврат;
				КонецЕсли;
				
				ДеньЗапроса = КонецДня(КонечныйДеньЗапроса) + 1;
				КонечныйДеньЗапроса = КонецДня(КонечныйДеньЗапроса) + 1;
				Продолжить;
				
			КонецЕсли;
			
			КонечныйДеньЗапроса = КонецДня(КонечныйДеньЗапроса) + 1;
			Счетчик = Счетчик + 1;
			
		КонецЦикла;
		
	Иначе
		
		ДатаНачалаВФорматеISO = ЗаписатьДатуJSON(НачалоДня(ДеньЗапроса), ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата);
		ДатаОкончанияВФорматеISO = СтрЗаменить(ЗаписатьДатуJSON(КонецДня(КонечныйДеньЗапроса), ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата), "Z", ".999999Z");	
		
		РезультатОбновленияЗаПериод = ОбновитьСписокИсходящихДокументовЗаПериод(ДатаНачалаВФорматеISO, ДатаОкончанияВФорматеISO, ПараметрыЗапроса, СвойствоИдентификаторУчастника);
		
	КонецЕсли;

	//ДеньЗапроса = ЭтаФорма.ПериодДляФильтраИсходящих.ДатаНачала;
	//ДеньОкончания = ЭтаФорма.ПериодДляФильтраИсходящих.ДатаОкончания;

	//	
	//	ДатаНачалаВФорматеISO = ЗаписатьДатуJSON(НачалоДня(ДеньЗапроса), ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата);
	//	ДатаОкончанияВФорматеISO = СтрЗаменить(ЗаписатьДатуJSON(КонецДня(ДеньОкончания), ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата), "Z", ".999999Z");
	//	
	//	РезультатОбновленияЗаПериод = ОбновитьСписокИсходящихДокументовЗаПериод(ДатаНачалаВФорматеISO, ДатаОкончанияВФорматеISO, ПараметрыЗапроса, СвойствоИдентификаторУчастника);	
	//	
	//	Если НЕ РезультатОбновленияЗаПериод ИЛИ ДеньЗапроса = НачалоДня(ТекущаяДата()) Тогда
	//		Возврат;
	//	КонецЕсли;
	
	ЭтаФорма.ИсхДокументы.Сортировать("ДатаСоздания УБЫВ");
		
КонецПроцедуры	

&НаКлиенте
Функция ОбновитьСписокИсходящихДокументовЗаПериод(ДатаНачалаВФорматеISO, ДатаОкончанияВФорматеISO, ПараметрыЗапроса, СвойствоИдентификаторУчастника = Неопределено, НомерСраницы = 0, ИдентификаторПоследнегоОбработанногоДокументаПредыдущегоШага = 0)
	
	СписокСокращений = СписокСокращенийНаименованийАбонентов();
	
	Если СвойствоИдентификаторУчастника = Неопределено Тогда
		СтруктураХранения1С				= ПолучитьСтруктуруХранения1С();
		СвойствоИдентификаторУчастника	= СтруктураХранения1С.СвойствоИдентификаторУчастника;
	КонецЕсли;	
	
	ПараметрыЗапроса.Параметры.Вставить("<created_from>", ДатаНачалаВФорматеISO);
	ПараметрыЗапроса.Параметры.Вставить("<created_till>", ДатаОкончанияВФорматеISO);
	
	РезультатСпискаДокументов = ВыполнитьЗапросAPI("API_ПолучитьСписокДокументов", ПараметрыЗапроса);
	
	ИдентификаторыКонтрагентов = "";
	ОбработаноКонтрагентовПоНаименованиям = 0;
	НаименованияКонтрагентов = Неопределено;
	
	Если НЕ РезультатСпискаДокументов.Ошибка Тогда
		
		Если РезультатСпискаДокументов.Результат = Неопределено Тогда
			// Пустой ответ, входящие документы не зафиксированы.
			Возврат Истина;
		КонецЕсли;	
		
		ИдентификаторПоследнегоОбработанногоДокумента	= 0;
		ДатаПоследнегоОбработанногоДокументаВФорматеISO = "";
		
		МассивИдентификаторовДокументов = Новый Массив;
		
		Для Каждого Элемент Из РезультатСпискаДокументов.Результат Цикл
			
			Если Элемент.id = ИдентификаторПоследнегоОбработанногоДокументаПредыдущегоШага Тогда
				Продолжить;
			КонецЕсли;	
			
			ПараметрыЗапросаЦепочкиДокумента = ПолучитьШаблонПараметровЗапроса();
			ПараметрыЗапросаЦепочкиДокумента.Параметры.Вставить("<id>", Строка(Формат(Элемент.id, "ЧГ=")));
			РезультатЗапросаЦепочкиДокумента = ВыполнитьЗапросAPI("API_ПолучитьЦепочкиДокументов", ПараметрыЗапросаЦепочкиДокумента);
			Если РезультатЗапросаЦепочкиДокумента.Ошибка = Истина Тогда
				Продолжить;
			//Иногда в качестве неформализованного документа может "попасться" служебный документ.
			//Отличить такой от "настоящего" документа можно по отсутствию цепочки.	
			ИначеЕсли Элемент.type = "UNFORMALIZED" И РезультатЗапросаЦепочкиДокумента.Результат = Неопределено Тогда
				//Значит, это служебный документ!
				Продолжить;
			КонецЕсли;
			
			ЦепочкаДокумента = Неопределено;
			
			// Судить о статусе документа непосредственно по статусу документа не всегда корректно.
			// Иногда бывает, что подчиненный документу технический документ имеет более важный по смыслу статус.
			Если РезультатЗапросаЦепочкиДокумента.Результат = Неопределено ИЛИ РезультатЗапросаЦепочкиДокумента.Результат.Количество() = 0 Тогда
				СтатусДокумента = ПеревестиСтатусAPIвСтатус1С(Элемент.status);
			Иначе
				ЦепочкаДокумента = РезультатЗапросаЦепочкиДокумента.Результат[0];
				Если НЕ ЗначениеЗаполнено(ИдентификаторОрганизации) Тогда
					ИдОтправителяДокумента = Элемент.recipient.id;
				Иначе
					ИдОтправителяДокумента = ИдентификаторОрганизации;
				КонецЕсли;
				СтатусПодчиненногоДокумента = ПроверитьПодчиненныеДокументыНаСтатусОжиданияОплаты(ЦепочкаДокумента);
				СтатусПредложенияОбАннулировании = ПроверитьПодчиненныеДокументыНаПредложениеОбАннулировании(ЦепочкаДокумента, ИдОтправителяДокумента);
				
				// Удалить++
				Если РаботаемПоУС = Ложь Тогда
					ИдентификаторИзвещенияОПолучении = ПроверитьПодчиненныеДокументыНаНеподписанныеИзвещенияОПолучении(ЦепочкаДокумента);
				КонецЕсли;
				// Удалить--
				
				Если СтатусПредложенияОбАннулировании = ""  Тогда 
					СтатусДокумента = ПеревестиСтатусAPIвСтатус1С(?(СтатусПодчиненногоДокумента = "AWAIT_PAYMENT" ИЛИ СтатусПодчиненногоДокумента = "SENDING_FAILED", СтатусПодчиненногоДокумента, Элемент.status));
				Иначе
					СтатусДокумента = ПеревестиСтатусAPIвСтатус1С(СтатусПредложенияОбАннулировании);
				КонецЕсли;
			КонецЕсли;
				
			НоваяСтрока = ЭтаФорма.ИсхДокументы.Добавить();
			
			ТипДокумента 				= "";
			НомерИсходящегоДокумента	= "";
			ДатаИсходящегоДокумента		= "";
			СуммаИсходящегоДокумента	= Формат(0, "ЧДЦ=2");
			СуммаНДСИсходящегоДокумента	= Формат(0, "ЧДЦ=2");
			ДатаПодписания				= "";
			
			Если Элемент.type = "ON_NSCHFDOPPR" Тогда
				ТипДокумента = "УПД";
				Если Элемент.invoice.function = "СЧФДОП" Тогда
					ТипДокумента = ТипДокумента + " ст. 1";
					СуммаНДСИсходящегоДокумента	= Формат(Элемент.invoice.vat, "ЧДЦ=2");
				ИначеЕСли Элемент.invoice.function = "ДОП" Тогда
					ТипДокумента = ТипДокумента + " ст. 2";
					СуммаНДСИсходящегоДокумента	= "Без НДС";
				ИначеЕсли Элемент.invoice.function = "СЧФ" Тогда
					ТипДокумента = "Счет-фактура";
					СуммаНДСИсходящегоДокумента	= Формат(Элемент.invoice.vat, "ЧДЦ=2");
				КонецЕсли;
				НомерИсходящегоДокумента = Элемент.invoice.num;
				ДатаИсходящегоДокумента	= Элемент.invoice.date;
				СуммаИсходящегоДокумента	= Формат(Элемент.invoice.sum, "ЧДЦ=2");
			ИначеЕсли Элемент.type = "ON_NKORSCHFDOPPR" Тогда
				ТипДокумента = "УКД";
				Если Элемент.invoice.function = "КСЧФДИС" Тогда
					ТипДокумента = ТипДокумента + " ст. 1";
					Если НЕ Элемент.invoice.decrease = Неопределено Тогда 
						СуммаНДСИсходящегоДокумента	= Формат(Элемент.invoice.decrease.vat, "ЧДЦ=2");
					Иначе
						СуммаНДСИсходящегоДокумента	= Формат(0, "ЧДЦ=2");
					КонецЕсли;
				ИначеЕСли Элемент.invoice.function = "ДИС" Тогда
					ТипДокумента = ТипДокумента + " ст. 2";
					СуммаНДСИсходящегоДокумента	= "Без НДС";
				КонецЕсли;
				НомерИсходящегоДокумента = Элемент.invoice.num;
				ДатаИсходящегоДокумента	= Элемент.invoice.date;
				Если НЕ Элемент.invoice.decrease = Неопределено Тогда 
					СуммаНДСИсходящегоДокумента	= Формат(Элемент.invoice.decrease.vat, "ЧДЦ=2");
				Иначе
					СуммаНДСИсходящегоДокумента	= Формат(0, "ЧДЦ=2");
				КонецЕсли;
			ИначеЕсли Элемент.type = "ON_KORSCHFDOPPR" Тогда
				ТипДокумента = "УКД";
				Если Элемент.invoice.function = "КСЧФДИС" Тогда
					ТипДокумента = ТипДокумента + " ст. 1";
					Если НЕ Элемент.invoice.decrease = Неопределено Тогда 
						СуммаНДСИсходящегоДокумента	= Формат(Элемент.invoice.decrease.vat, "ЧДЦ=2");
					Иначе
						СуммаНДСИсходящегоДокумента	= Формат(0, "ЧДЦ=2");
					КонецЕсли;
				ИначеЕСли Элемент.invoice.function = "ДИС" Тогда
					ТипДокумента = ТипДокумента + " ст. 2";
					СуммаНДСИсходящегоДокумента	= "Без НДС";
				ИначеЕсли Элемент.invoice.function = "КСЧФ" Тогда
					ТипДокумента = "К. счет-фактура";
					Если НЕ Элемент.invoice.decrease = Неопределено Тогда 
						СуммаНДСИсходящегоДокумента	= Формат(Элемент.invoice.decrease.vat, "ЧДЦ=2");
					Иначе
						СуммаНДСИсходящегоДокумента	= Формат(0, "ЧДЦ=2");
					КонецЕсли;	
				КонецЕсли;
				НомерИсходящегоДокумента = Элемент.invoice.num;
				ДатаИсходящегоДокумента	= Элемент.invoice.date;
				Если НЕ Элемент.invoice.decrease = Неопределено Тогда 
					СуммаНДСИсходящегоДокумента	= Формат(Элемент.invoice.decrease.vat, "ЧДЦ=2");
				Иначе
					СуммаНДСИсходящегоДокумента	= Формат(0, "ЧДЦ=2");
				КонецЕсли;
			ИначеЕсли Элемент.type = "DP_TOVTORGPR" Тогда
				ТипДокумента = "Торг12";
				СуммаНДСИсходящегоДокумента	= Формат(Элемент.invoice.vat, "ЧДЦ=2");
				НомерИсходящегоДокумента = Элемент.invoice.num;
				ДатаИсходящегоДокумента	= Элемент.invoice.date;
				СуммаИсходящегоДокумента	= Формат(Элемент.invoice.sum, "ЧДЦ=2");
			ИначеЕсли Элемент.type = "DP_REZRUISP" Тогда
				ТипДокумента = "Акт ВР";
				СуммаНДСИсходящегоДокумента	= Формат(Элемент.invoice.vat, "ЧДЦ=2");
				НомерИсходящегоДокумента = Элемент.invoice.num;
				ДатаИсходящегоДокумента	= Элемент.invoice.date;
				СуммаИсходящегоДокумента	= Формат(Элемент.invoice.sum, "ЧДЦ=2");
			ИначеЕсли Элемент.type = "DP_PRIRASXPRIN" Тогда
				ТипДокумента = "Торг-2";
				НомерИсходящегоДокумента = Элемент.invoice.num;
				ДатаИсходящегоДокумента	= Элемент.invoice.date;
			ИначеЕсли Элемент.type = "ON_AKTSVEROTP" Тогда
				ТипДокумента = "Акт сверки";
				НомерИсходящегоДокумента = Элемент.invoice.num;
				ДатаИсходящегоДокумента	= Элемент.invoice.date;
			ИначеЕсли Элемент.type = "ON_CHETOP" Тогда
				ТипДокумента = "Счет на оплату";
				НомерИсходящегоДокумента	= Элемент.invoice.num;
				ДатаИсходящегоДокумента		= Элемент.invoice.date;
				СуммаИсходящегоДокумента	= Формат(Элемент.invoice.sum, "ЧДЦ=2");
			ИначеЕсли Элемент.type = "UNFORMALIZED" Тогда 
				ТипДокумента = "Неформализованный";
			КонецЕсли;
			
			Если НЕ ЦепочкаДокумента = Неопределено Тогда 
				ДатаПодписания = ОпределитьДатуТитулаПолучателяЭлектронногоДокумента(ЦепочкаДокумента);
			КонецЕсли;	
			
			// Контрагент
			ИдентификаторКонтрагента = Элемент.recipient.id;
			Если СтрНайти(ИдентификаторыКонтрагентов, ИдентификаторКонтрагента) = 0 Тогда 
				ИдентификаторыКонтрагентов	= ИдентификаторыКонтрагентов + ИдентификаторКонтрагента + ",";
				ОбработаноКонтрагентовПоНаименованиям = ОбработаноКонтрагентовПоНаименованиям + 1;
			КонецЕсли;
			
			// Заполнение соответствия наименований контрагентов
			// Обрабатываем по 50. Да, можно запросить и больше, сменив в последствии номер страницы ответа, но лучше не рисковать превысить максимальную длину URI.
			Если ОбработаноКонтрагентовПоНаименованиям = 50 Тогда 
				ПараметрыЗапросаИнформацииОбУчастниках = ПолучитьШаблонПараметровЗапроса(); 
				ПараметрыЗапросаИнформацииОбУчастниках.Параметры.Вставить("<gid>", ИдентификаторыКонтрагентов);
				ПараметрыЗапросаИнформацииОбУчастниках.Параметры.Вставить("<page_size>", 50);
				ИнформацияОКонтрагентах = ВыполнитьЗапросAPI("API_ИнформацияОбУчастникеЭДО", ПараметрыЗапросаИнформацииОбУчастниках);
				// Да, можно запросить информацию по контрагенту на каждом шаге цикла по документам, но это очень долго.
				// Было принято решение отказаться от http-запроса по поиску абонента на каждом шаге. Пользователи не любят ждать.
				Если НЕ ИнформацияОКонтрагентах.Ошибка И НЕ ИнформацияОКонтрагентах.Результат = Неопределено Тогда
					Если НЕ ТипЗнч(НаименованияКонтрагентов) = Тип("Соответствие") Тогда
						НаименованияКонтрагентов = Новый Соответствие;                  
					КонецЕсли;	
					Для Каждого ИнформацияОКонтрагенте из ИнформацияОКонтрагентах.Результат Цикл
						ИдентификаторКонтрагента = ИнформацияОКонтрагенте.gid;
						Если НЕ ТипЗнч(ИнформацияОКонтрагенте.details.name) = Тип("Структура") Тогда 
							НаименованиеКонтрагента = ИнформацияОКонтрагенте.details.name;
						Иначе
							НаименованиеКонтрагента = ""+ИнформацияОКонтрагенте.details.name.last+" "+ИнформацияОКонтрагенте.details.name.first+" "+ИнформацияОКонтрагенте.details.name.middle;
						КонецЕсли;
						НаименованиеКонтрагента = ПроверитьНаименованиеАбонентаНаВозможностьСокращения(НаименованиеКонтрагента, СписокСокращений);
						НаименованияКонтрагентов.Вставить(ИдентификаторКонтрагента, НаименованиеКонтрагента);
					КонецЦикла;
				Иначе
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Не удалось получить информацию по абонентам."+Символы.ПС+"Описание ошибки:"+Символы.ПС+ИнформацияОКонтрагентах.Описание
										+Символы.ПС+"Список запрашиваемых идентификаторов:"+Символы.ПС+ИдентификаторыКонтрагентов;
					Сообщение.Сообщить();
				КонецЕсли;                            
				ИдентификаторыКонтрагентов = "";
				ОбработаноКонтрагентовПоНаименованиям = 0;	
			КонецЕсли;
			
			// Организация
			ПараметрыЗапросаИнформацииОбУчастнике = ПолучитьШаблонПараметровЗапроса(); 
			ПараметрыЗапросаИнформацииОбУчастнике.Параметры.Вставить("<gid>", Элемент.sender.id);	
			ИнформацияОбОрганизации = ВыполнитьЗапросAPI("API_ИнформацияОбУчастникеЭДО", ПараметрыЗапросаИнформацииОбУчастнике);
			Если НЕ ИнформацияОбОрганизации.Ошибка И НЕ ИнформацияОбОрганизации.Результат = Неопределено Тогда
				Если НЕ ТипЗнч(ИнформацияОбОрганизации.Результат[0].details.name) = Тип("Структура") Тогда 
					ОрганизацияСтроки = ИнформацияОбОрганизации.Результат[0].details.name;
				Иначе
					ОрганизацияСтроки = ""+ИнформацияОбОрганизации.Результат[0].details.name.last+" "+ИнформацияОбОрганизации.Результат[0].details.name.first+" "+ИнформацияОбОрганизации.Результат[0].details.name.middle;
				КонецЕсли;
			Иначе	
				ОрганизацияСтроки = "";
			КонецЕсли;
			
			НоваяСтрока.ДатаСоздания			= ПрочитатьДатуJSON(Элемент.created, ФорматДатыJSON.ISO);
			НоваяСтрока.ДатаПодписания			= ?(ЗначениеЗаполнено(ДатаПодписания), ПрочитатьДатуJSON(ДатаПодписания, ФорматДатыJSON.ISO), Дата(1,1,1));
			НоваяСтрока.id						= Формат(Элемент.id, "ЧГ=0");	
			НоваяСтрока.ТипДокумента			= ТипДокумента;
			НоваяСтрока.СтатусЭДО				= СтатусДокумента;
			
			// Удалить++
			Если РаботаемПоУС = Ложь Тогда
				НоваяСтрока.ПредставлениеСтатусаЭДО	= Элементы.ТаблицаИсходящих_СтатусЭДО.СписокВыбора.НайтиПоЗначению(СтатусДокумента).Представление + ?(НЕ ИдентификаторИзвещенияОПолучении = "", ". Извещение не подписано", "");
			Иначе
			// Удалить--	
				НоваяСтрока.ПредставлениеСтатусаЭДО	= Элементы.ТаблицаИсходящих_СтатусЭДО.СписокВыбора.НайтиПоЗначению(СтатусДокумента).Представление;
			КонецЕсли;
			
			НоваяСтрока.НомерДокумента			= НомерИсходящегоДокумента;
			НоваяСтрока.ДатаДокумента			= ДатаИсходящегоДокумента;  
			//НоваяСтрока.Контрагент			= Контрагент;
			НоваяСтрока.Организация				= ОрганизацияСтроки;
			НоваяСтрока.СуммаДокумента			= СуммаИсходящегоДокумента;
			НоваяСтрока.СуммаНДСДокумента		= СуммаНДСИсходящегоДокумента;
			Если Элемент.Свойство("topic") Тогда
				НоваяСтрока.Заголовок			= Элемент.topic;
			КонецЕсли;
			НоваяСтрока.ФорматДокумента			= Элемент.type;
			НоваяСтрока.fileIdДокумента			= Элемент.fileId;
			НоваяСтрока.recipientIdДокумента	= ИдентификаторКонтрагента;
			
			ИдентификаторПоследнегоОбработанногоДокумента	= Элемент.id;
			ДатаПоследнегоОбработанногоДокументаВФорматеISO	= Элемент.created;
			
			Если СтатусДокумента = 60 И НЕ ЦепочкаДокумента = Неопределено Тогда
				// Отклонен.
				ПричинаОтклонения = ОпределитьПричинуОтклонения(ЦепочкаДокумента);
				НоваяСтрока.ПричинаОтклоненияДокумента = ПричинаОтклонения;
			КонецЕсли;	
			
			// Удалить++
			Если НЕ РаботаемПоУС Тогда
				НоваяСтрока.ИдентификаторНеподписанногоИзвещения = ИдентификаторИзвещенияОПолучении;
			КонецЕсли;
			// Удалить--
			
			МассивИдентификаторовДокументов.Добавить(НоваяСтрока.id);
			
		КонецЦикла;
		
		ДокументыПоИдентификаторам = ПолучитьДокументыПоИдентификаторам1С(МассивИдентификаторовДокументов);
		
		Для Каждого Строка из ЭтаФорма.ИсхДокументы Цикл
			Если НЕ ЗначениеЗаполнено(Строка.СсылкаНаДокумент) Тогда 
				Строка.СсылкаНаДокумент = ДокументыПоИдентификаторам.Получить(Строка.id);
			КонецЕсли;	
		КонецЦикла;	
		
		// Заполнение соответствия наименований оставшихся контрагентов, если таковые есть.
		Если ОбработаноКонтрагентовПоНаименованиям > 0 Тогда
			ПараметрыЗапросаИнформацииОбУчастниках = ПолучитьШаблонПараметровЗапроса(); 
			ПараметрыЗапросаИнформацииОбУчастниках.Параметры.Вставить("<gid>", ИдентификаторыКонтрагентов);
			ПараметрыЗапросаИнформацииОбУчастниках.Параметры.Вставить("<page_size>", 50);
			ИнформацияОКонтрагентах = ВыполнитьЗапросAPI("API_ИнформацияОбУчастникеЭДО", ПараметрыЗапросаИнформацииОбУчастниках);
			// Да, можно запросить информацию по контрагенту на каждом шаге цикла по документам, но это очень долго.
			// Было принято решение отказаться от http-запроса по поиску абонента на каждом шаге. Пользователи не любят ждать.
			Если НЕ ИнформацияОКонтрагентах.Ошибка И НЕ ИнформацияОКонтрагентах.Результат = Неопределено Тогда
				Если НЕ ТипЗнч(НаименованияКонтрагентов) = Тип("Соответствие") Тогда
					НаименованияКонтрагентов = Новый Соответствие;                  
				КонецЕсли;
				Для Каждого ИнформацияОКонтрагенте из ИнформацияОКонтрагентах.Результат Цикл
					ИдентификаторКонтрагента = ИнформацияОКонтрагенте.gid;
					Если НЕ ТипЗнч(ИнформацияОКонтрагенте.details.name) = Тип("Структура") Тогда 
						НаименованиеКонтрагента = ИнформацияОКонтрагенте.details.name;
					Иначе
						НаименованиеКонтрагента = ""+ИнформацияОКонтрагенте.details.name.last+" "+ИнформацияОКонтрагенте.details.name.first+" "+ИнформацияОКонтрагенте.details.name.middle;
					КонецЕсли;
					НаименованиеКонтрагента = ПроверитьНаименованиеАбонентаНаВозможностьСокращения(НаименованиеКонтрагента, СписокСокращений);
					НаименованияКонтрагентов.Вставить(ИдентификаторКонтрагента, НаименованиеКонтрагента);
				КонецЦикла;
			Иначе
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Не удалось получить информацию по абонентам."+Символы.ПС+"Описание ошибки:"+Символы.ПС+ИнформацияОКонтрагентах.Описание
									+Символы.ПС+"Список запрашиваемых идентификаторов:"+Символы.ПС+ИдентификаторыКонтрагентов;
				Сообщение.Сообщить();	
			КонецЕсли;
		КонецЕсли;
		
		//Заполнение наименований контрагентов в таблице.
		Если НЕ НаименованияКонтрагентов = Неопределено Тогда
			Для Каждого Строка из ЭтаФорма.ИсхДокументы Цикл
				Если НЕ Строка.Контрагент = Неопределено И НЕ Строка.Контрагент = "" Тогда
					Продолжить;
				КонецЕсли;	
				НаименованиеКонтрагента = НаименованияКонтрагентов.Получить(Строка.recipientIdДокумента);
				Если НЕ НаименованиеКонтрагента = Неопределено Тогда
					Строка.Контрагент = НаименованиеКонтрагента;	
				Иначе
					Строка.Контрагент = "Не удалось определить абонента";	
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;
		
		Если РезультатСпискаДокументов.Результат.Количество() = 1000 Тогда
			// Достигнуто максимально допустимое количество элементов ответа.
			// Нужно проверить, есть ли ещё документы в указанном периоде и обработать их при наличии.
			ОбновитьСписокИсходящихДокументовЗаПериод(ДатаПоследнегоОбработанногоДокументаВФорматеISO, ДатаОкончанияВФорматеISO, ПараметрыЗапроса, СвойствоИдентификаторУчастника, 0, ИдентификаторПоследнегоОбработанногоДокумента);   
		КонецЕсли;	
		
	Иначе
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = РезультатСпискаДокументов.Описание;
		Сообщение.Сообщить();
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции	

&НаКлиенте
Процедура СброситьФильтрыИсходящихДокументов(Команда)
	
	ЭтаФорма.ПериодДляФильтраИсходящих.Вариант = ВариантСтандартногоПериода.Сегодня;
	ЭтаФорма.КонтрагентыДляФильтраИсходящих.Очистить();
	ЭтаФорма.СтатусДляФильтраИсходящих = "";
	ЭтаФорма.ТипыДокументовДляФильтраИсходящих = "";
	ЭтаФорма.НаличиеМаркировкиДляФильтраИсходящих = 0;
	
	Элементы.ФильтрИсходящихПоПериоду.Заголовок = "За период: Сегодня";
	Элементы.ФильтрИсходящихПоКонтрагентам.Заголовок = "Контрагенты: Все";
	Элементы.ФильтрИсходящихПоКонтрагентам.Подсказка = "";
	Элементы.СтатусДляФильтраИсходящих.Заголовок = "Фильтр по статусам";
	Элементы.СтатусДляФильтраИсходящих.Подсказка = "";
	Элементы.ТипыДокументовДляФильтраИсходящих.Заголовок = "Фильтр по типу";
	Элементы.ТипыДокументовДляФильтраИсходящих.Подсказка = "";
	Элементы.НаличиеМаркировкиДляФильтраИсходящих.Заголовок = "Фильтр по наличию маркировки";
	
КонецПроцедуры

#КонецОбласти

#Область Криптография

// Функция подписывает документ
// Входные параметры:
// Документ 			- структура Документ (формируется после выгрузки документа)
// МенеджерКриптографии - подключенный менеджер криптографии (Объект)
// ЭЦП 					- Подпись (объект)
// Выходные параметры:
// Подпись сохраняется в каталог временных файлов, возвращает полный путь до файла подписи
&НаКлиенте
Функция ПодписатьДокумент(ИмяФайлаДокумента, ПолноеИмяФайлаДокумента, МенеджерКриптографии, ЭЦП, ПарольДоступаКЗакрытомуКлючу = "", РасширениеФайлаРезультата = "") Экспорт 
	
	МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = ПарольДоступаКЗакрытомуКлючу;
	
	Каталог = КаталогВременныхФайлов();
	
	Попытка
		Ошибка = Ложь;
		МенеджерКриптографии.Подписать(ПолноеИмяФайлаДокумента, Каталог + ИмяФайлаДокумента + РасширениеФайлаРезультата, ЭЦП);	
	Исключение
		// Возможно старый алгоритм ЭЦП
		Ошибка = Истина;
		Описание = ОписаниеОшибки();
	КонецПопытки;
	
	// Невозможно по ЭЦП понять каким алгоритмом ее подписывать, поэтому костыль
	Если Ошибка Тогда
		Попытка
			Ошибка = Ложь;
			МенеджерКриптографии = ПолучитьМенеджерКриптографии(75);
			МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = ПарольДоступаКЗакрытомуКлючу;
			МенеджерКриптографии.Подписать(ПолноеИмяФайлаДокумента, Каталог + ИмяФайлаДокумента + РасширениеФайлаРезультата, ЭЦП);  			
		Исключение
			Ошибка = Истина;
			Сообщить(	"1 попытка: " + Описание + ";
			|
			|2 попытка: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	// Невозможно по ЭЦП понять каким алгоритмом ее подписывать, поэтому костыль
	
	Если Ошибка Тогда
		Возврат Неопределено;
	Иначе
		Возврат Каталог + ИмяФайлаДокумента + РасширениеФайлаРезультата;
	КонецЕсли;    	
	
КонецФункции

&НаКлиенте
Функция ПолучитьМенеджерКриптографии(ТипМенеджераКриптографии = 80) Экспорт 
	
	// Возврат Новый МенеджерКриптографии("", "", 75);      // Старый
	Возврат Новый МенеджерКриптографии("", "", ТипМенеджераКриптографии);  		// Новый	
	
КонецФункции

// Функция проверки соответсвия подписанта, выгруженного в документе, и выбранной пользователем ЭЦП
&НаКлиенте
Функция ПодписантСоответсвуетЭЦП(Подписант, ЭЦП) Экспорт 
	
	Если ТипСубъектаПодписанта = "ФЛ" Тогда
		Возврат Истина;
	КонецЕсли;	
	
	ЭЦП_ИНН = "";
			
	Если ЭЦП.Субъект.Свойство("OID1_2_643_100_4") Тогда
		ЭЦП_ИНН = ЭЦП.Субъект.OID1_2_643_100_4;
	ИначеЕсли ЭЦП.Субъект.Свойство("OID1_2_643_3_131_1_1") Тогда
		ЭЦП_ИНН = ЭЦП.Субъект.OID1_2_643_3_131_1_1;
	ИначеЕсли ЭЦП.Субъект.Свойство("INNLE") Тогда
		ЭЦП_ИНН = ЭЦП.Субъект.INNLE;
	ИначеЕсли ЭЦП.Субъект.Свойство("ИННЮЛ") Тогда
		ЭЦП_ИНН = ЭЦП.Субъект.ИННЮЛ;
	ИначеЕсли ЭЦП.Субъект.Свойство("ИНН_ЮЛ") Тогда
		ЭЦП_ИНН = ЭЦП.Субъект.ИНН_ЮЛ;
	ИначеЕсли ЭЦП.Субъект.Свойство("ИНН") Тогда
		ЭЦП_ИНН = ЭЦП.Субъект.ИНН;
	ИначеЕсли ЭЦП.Субъект.Свойство("ИННОрганизации") Тогда
		ЭЦП_ИНН = ЭЦП.Субъект.ИННОрганизации;
	ИначеЕсли ЭЦП.Субъект.Свойство("ИНН_Организации") Тогда
		ЭЦП_ИНН = ЭЦП.Субъект.ИНН_Организации;	
	КонецЕсли;
	
	Если ЭЦП_ИНН = "" Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	ЭЦП_ИНН 		= ЭЦП_ИНН;
	ЭЦП_Фамилия 	= ЭЦП.Субъект.SN;
	ЭЦП_ИмяОтчество = ЭЦП.Субъект.GN;
	
	Если СтрНайти(ЭЦП_ИНН, Подписант.ИНН) = 0 Тогда
		Возврат Ложь;	
	КонецЕсли;
	
	Если Нрег(ЭЦП_Фамилия) <> Нрег(Подписант.Фамилия) Тогда
		Возврат Ложь;	
	КонецЕсли;	
	
	Если Нрег(ЭЦП_ИмяОтчество) <> СокрЛП(Нрег(Подписант.Имя) + " " + Нрег(Подписант.Отчество)) Тогда
		Возврат Ложь;	
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ПолучитьЭЦППоОтпечатку(Менеджер, Отпечаток) Экспорт
	
	Хранилище = Менеджер.ПолучитьХранилищеСертификатов(ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);			
	Возврат Хранилище.НайтиПоОтпечатку(Отпечаток);  	
	
КонецФункции

&НаКлиенте
Функция ПолучитьТокенПоОтпечаткуСертификата(Отпечаток, ПарольДоступаКЗакрытомуКлючуСертификата = "") Экспорт
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	
	Менеджер = ПолучитьМенеджерКриптографии();
	Менеджер.ПарольДоступаКЗакрытомуКлючу = ПарольДоступаКЗакрытомуКлючуСертификата;
	ЭЦП = ПолучитьЭЦППоОтпечатку(Менеджер, Отпечаток);
	
	ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса(); 
		
	ЗаписьJSON = Новый ЗаписьJSON();
	
	ТекущаяДатаВUnixTime = Формат(УниверсальноеВремя(ТекущаяДата())- Дата(1970,1,1), "ЧГ=0"); 
	
	ЗаписьJSON.УстановитьСтроку();	    
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписьJSON.ЗаписатьИмяСвойства("ts");
	ЗаписьJSON.ЗаписатьЗначение(ТекущаяДатаВUnixTime); 
	ЗаписьJSON.ЗаписатьИмяСвойства("nonce");
	ЗаписьJSON.ЗаписатьЗначение(Строка(Новый УникальныйИдентификатор()));  
	ЗаписьJSON.ЗаписатьКонецОбъекта();
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Поток = Новый ПотокВПамяти;
	Текст = Новый ЗаписьТекста(Поток, КодировкаТекста.UTF8) ;
	Текст.Записать(СтрокаJSON);
	Текст.Закрыть();
	ДвоичныеДанные = Поток.ЗакрытьИПолучитьДвоичныеДанные();
	
	Отказ = Ложь;
	ОписаниеОшибки = "";
	Подпись = Менеджер.Подписать(ДвоичныеДанные, ЭЦП);
	РезультатПодписанияДвоичныеДанные = ПрисоединитьПодпись(Подпись, ДвоичныеДанные, Отказ, ОписаниеОшибки);
		
	ЭлектроннаяПодписьCMSBase64 = Base64Строка(РезультатПодписанияДвоичныеДанные);
	ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ПС, "");
	ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ВК, "");
	ЭлектроннаяПодписьCMSвDERвURL = КодироватьBase64СтрокуВСтрокуURLНаСервере(ЭлектроннаяПодписьCMSBase64);
	
	ПараметрыЗапроса.Параметры.Вставить("<Тело>", "grant_type=signature&signature="+ЭлектроннаяПодписьCMSвDERвURL);
	ПараметрыЗапроса.Параметры.Вставить("ИдентификаторКлиента", СистемнаяИнформация.ИдентификаторКлиента);
	
	РезультатЗапросаТокенаПоСертификату = API_ПолучитьТокенАвторизацииПоСертификату(ПараметрыЗапроса);
	
	Если НЕ РезультатЗапросаТокенаПоСертификату.Ошибка Тогда
		
		Возврат РезультатЗапросаТокенаПоСертификату.Результат.access_token;	
		
	Иначе	
				
		Возврат Неопределено;
	
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция КодироватьBase64СтрокуВСтрокуURLНаСервере(ЭлектроннаяПодписьBase64)

	Возврат КодироватьСтроку(ЭлектроннаяПодписьBase64, СпособКодированияСтроки.КодировкаURL);
	
КонецФункции

#Область ПолучениеПрисоединеннойПодписи
// Менеджер криптографии в 1С не умеет делать присоединённые подписи.
// Выхода два: подписывать через COM-объект КриптоПро или воспользоваться сторонним решением.
// Стороннее решение: https://infostart.ru/public/1493281/, за авторством Сивина Алексея.

&НаКлиенте
Функция РазмерКонтейтера(Элемент)
	Результат = Элемент.Длина + 2;

	Если Элемент.Длина<=127 Тогда
		
	ИначеЕсли Элемент.Длина<=255 Тогда
		Результат = Результат + 1;
	ИначеЕсли Элемент.Длина<=65535 Тогда
		Результат = Результат + 2;
	ИначеЕсли Элемент.Длина<=16777215 Тогда
		Результат = Результат + 3;
	ИначеЕсли Элемент.Длина<=4294967295 Тогда
		Результат = Результат + 4;
	ИначеЕсли Элемент.Длина<=1099511627776 Тогда
		Результат = Результат + 5;
	КонецЕсли;

	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ЗаписатьЭлемент(Элемент,Поток,ТолькоЗаголовок);
	ВремБуфер = Новый БуферДвоичныхДанных(8);

	ВремБуфер[0] = Элемент.ПервыйБайт;
	Поток.Записать(ВремБуфер,0,1);
	
	Если Элемент.Длина<=127 Тогда
		ВремБуфер[0] = Элемент.Длина;
		Поток.Записать(ВремБуфер,0,1);
	Иначе
		Если Элемент.Длина<=255 Тогда
			К = 1;
		ИначеЕсли Элемент.Длина<=65535 Тогда
			К = 2;
		ИначеЕсли Элемент.Длина<=16777215 Тогда
			К = 3;
		ИначеЕсли Элемент.Длина<=4294967295 Тогда
			К = 4;
		ИначеЕсли Элемент.Длина<=1099511627776 Тогда
			К = 5;
		КонецЕсли;
		ВремБуфер[0] = К+128;
		Поток.Записать(ВремБуфер,0,1);

		ВремБуфер.ЗаписатьЦелое64(0,Элемент.Длина,ПорядокБайтов.BigEndian);
		Поток.Записать(ВремБуфер,8-К,К);		
	КонецЕсли;
	
	Если ТолькоЗаголовок<>Истина Тогда
		Поток.Записать(Элемент.Буфер,0,Элемент.Буфер.Размер);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПрочитатьЭлемент(Буфер,Позиция,Отказ,ОписаниеОшибки)
	
	Результат = Новый Структура;
	
	Если Позиция>=Буфер.Размер Тогда
		Отказ = Истина;
		ОписаниеОшибки = "Ошибка чтения подписи В0001";
		Возврат Неопределено;
	КонецЕсли;
	
	Результат.Вставить("ПервыйБайт",Буфер[Позиция]); Позиция = Позиция + 1;

	Длина = 0;
	Если Позиция>=Буфер.Размер Тогда
		Отказ = Истина;
		ОписаниеОшибки = "Ошибка чтения подписи В0002";
		Возврат Неопределено;
	КонецЕсли;

	Байт = Буфер[Позиция]; Позиция = Позиция + 1;

	Если Байт<=127 Тогда
		Длина = Байт;
	ИначеЕсли Байт=128 Тогда
		Отказ = Истина;
		ОписаниеОшибки = "Ошибка чтения подписи В0003";
		Возврат Неопределено;
	Иначе
		К = Байт-128;

		ВремБуфер = Новый БуферДвоичныхДанных(8);
		ВремБуфер.ЗаписатьЦелое64(0,0);

		М = Новый Массив;
		Для х=1 По К Цикл

			Если Позиция>=Буфер.Размер Тогда
				Отказ = Истина;
				ОписаниеОшибки = "Ошибка чтения подписи В0004";
				Возврат Неопределено;
			КонецЕсли;
			
			ВремБуфер[7-К+х] = Буфер[Позиция];
			Позиция = Позиция + 1;
		КонецЦикла;
		
		Длина = ВремБуфер.ПрочитатьЦелое64(0,ПорядокБайтов.BigEndian);
	КонецЕсли;
	
	Если (Позиция+Длина)>Буфер.Размер Тогда
		Отказ = Истина;
		ОписаниеОшибки = "Ошибка чтения подписи В0005";
		Возврат Неопределено;
	КонецЕсли;

	Результат.Вставить("Длина",Длина);
	Результат.Вставить("Буфер",Буфер.Прочитать(Позиция,Длина));
	Позиция = Позиция + Длина;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ПрисоединитьПодпись(Подпись,ДвоичныеДанные,Отказ,ОписаниеОшибки) Экспорт

	//Разбираем
	ЧтениеДанных = Новый ЧтениеДанных(Подпись);
	Буфер = ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных();
	
	ПозицияА = 0;
	А1 = ПрочитатьЭлемент(Буфер,ПозицияА,Отказ,ОписаниеОшибки);
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если А1.ПервыйБайт<>48 Тогда //SEQUENCE
		Отказ = Истина;
		ОписаниеОшибки = "Ошибка чтения подписи А0001";
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПозицияА<>Буфер.Размер Тогда
		Отказ = Истина;
		ОписаниеОшибки = "Ошибка чтения подписи А0002";
		Возврат Неопределено;
	КонецЕсли;
	
	ПозицияБ = 0;
	Б1 = ПрочитатьЭлемент(А1.Буфер,ПозицияБ,Отказ,ОписаниеОшибки);
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Б1.ПервыйБайт<>6 Тогда //OBJECT IDENTIFIER
		Отказ = Истина;
		ОписаниеОшибки = "Ошибка чтения подписи А0003";
		Возврат Неопределено;
	КонецЕсли;

	Если ПолучитьBase64СтрокуИзБуфераДвоичныхДанных(Б1.Буфер)<>"KoZIhvcNAQcC" Тогда //1.2.840.113549.1.7.2
		Отказ = Истина;
		ОписаниеОшибки = "Ошибка чтения подписи А0004";
		Возврат Неопределено;
	КонецЕсли;
	
	Б2 = ПрочитатьЭлемент(А1.Буфер,ПозицияБ,Отказ,ОписаниеОшибки);
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПозицияБ<>А1.Буфер.Размер Тогда
		Отказ = Истина;
		ОписаниеОшибки = "Ошибка чтения подписи А0005";
		Возврат Неопределено;
	КонецЕсли;
	
	ПозицияВ = 0;
	В1 = ПрочитатьЭлемент(Б2.Буфер,ПозицияВ,Отказ,ОписаниеОшибки);
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если В1.ПервыйБайт<>48 Тогда //SEQUENCE
		Отказ = Истина;
		ОписаниеОшибки = "Ошибка чтения подписи А0006";
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПозицияВ<>Б2.Буфер.Размер Тогда
		Отказ = Истина;
		ОписаниеОшибки = "Ошибка чтения подписи А0007";
		Возврат Неопределено;
	КонецЕсли;
	
	ПозицияГ = 0;
	Г1 = ПрочитатьЭлемент(В1.Буфер,ПозицияГ,Отказ,ОписаниеОшибки);
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Г1.ПервыйБайт<>2 Тогда //INTEGER
		Отказ = Истина;
		ОписаниеОшибки = "Ошибка чтения подписи А0008";
		Возврат Неопределено;
	КонецЕсли;
	
	Г2 = ПрочитатьЭлемент(В1.Буфер,ПозицияГ,Отказ,ОписаниеОшибки);
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Г2.ПервыйБайт<>49 Тогда //SET
		Отказ = Истина;
		ОписаниеОшибки = "Ошибка чтения подписи А0009";
		Возврат Неопределено;
	КонецЕсли;
	
	Г3 = ПрочитатьЭлемент(В1.Буфер,ПозицияГ,Отказ,ОписаниеОшибки);
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Г3.ПервыйБайт<>48 Тогда //SEQUENCE
		Отказ = Истина;
		ОписаниеОшибки = "Ошибка чтения подписи А0010";
		Возврат Неопределено;
	КонецЕсли;
	
	ПозицияД = 0;
	Д1 = ПрочитатьЭлемент(Г3.Буфер,ПозицияД,Отказ,ОписаниеОшибки);
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Д1.ПервыйБайт<>6 Тогда //OBJECT IDENTIFIER
		Отказ = Истина;
		ОписаниеОшибки = "Ошибка чтения подписи А0011";
		Возврат Неопределено;
	КонецЕсли;

	Если ПолучитьBase64СтрокуИзБуфераДвоичныхДанных(Д1.Буфер)<>"KoZIhvcNAQcB" Тогда //1.2.840.113549.1.7.1
		Отказ = Истина;
		ОписаниеОшибки = "Ошибка чтения подписи А0012";
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПозицияД<>Г3.Буфер.Размер Тогда
		Отказ = Истина;
		ОписаниеОшибки = "Ошибка чтения подписи А0013";
		Возврат Неопределено;
	КонецЕсли;

	Г4 = ПрочитатьЭлемент(В1.Буфер,ПозицияГ,Отказ,ОписаниеОшибки);
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Г5 = ПрочитатьЭлемент(В1.Буфер,ПозицияГ,Отказ,ОписаниеОшибки);
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПозицияГ<>В1.Буфер.Размер Тогда
		Отказ = Истина;
		ОписаниеОшибки = "Ошибка чтения подписи А0014";
		Возврат Неопределено;
	КонецЕсли;
	
	//Собираем
	
	//Создаем новые элементы Д2 И Е1
	ЧТ = Новый ЧтениеДанных(ДвоичныеДанные);
	Е1 = Новый Структура;
	Е1.Вставить("ПервыйБайт",4);
	Е1.Вставить("Буфер", ЧТ.ПрочитатьВБуферДвоичныхДанных());	
	Е1.Вставить("Длина",Е1.Буфер.Размер);

	Д2 = Новый Структура;
	Д2.Вставить("ПервыйБайт",160);
	Д2.Вставить("Длина",РазмерКонтейтера(Е1));
	
	Г3.Длина = РазмерКонтейтера(Д1)+РазмерКонтейтера(Д2);
	В1.Длина = РазмерКонтейтера(Г1)+РазмерКонтейтера(Г2)+РазмерКонтейтера(Г3)+РазмерКонтейтера(Г4)+РазмерКонтейтера(Г5);
	Б2.Длина = РазмерКонтейтера(В1);
	А1.Длина = РазмерКонтейтера(Б1)+РазмерКонтейтера(Б2);
	
	Поток = Новый ПотокВПамяти();
	
	ЗаписатьЭлемент(А1,Поток,Истина);
	ЗаписатьЭлемент(Б1,Поток,Ложь);
	ЗаписатьЭлемент(Б2,Поток,Истина);
	ЗаписатьЭлемент(В1,Поток,Истина);
	ЗаписатьЭлемент(Г1,Поток,Ложь);
	ЗаписатьЭлемент(Г2,Поток,Ложь);
	ЗаписатьЭлемент(Г3,Поток,Истина);
	ЗаписатьЭлемент(Д1,Поток,Ложь);
	ЗаписатьЭлемент(Д2,Поток,Истина);
	ЗаписатьЭлемент(Е1,Поток,Ложь);
	ЗаписатьЭлемент(Г4,Поток,Ложь);
	ЗаписатьЭлемент(Г5,Поток,Ложь);

	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();
КонецФункции

#КонецОбласти

