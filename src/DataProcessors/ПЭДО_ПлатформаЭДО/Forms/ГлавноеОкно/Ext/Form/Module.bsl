&НаКлиенте
Процедура ОткрытьНастройки(Команда)
	
	ПараметрыОткрытияФормы = Новый Структура();
	ПараметрыОткрытияФормы.Вставить("ИмяОбработки", ИмяОбработки);
	ПараметрыОткрытияФормы.Вставить("ПрефиксКонфигурации", ПрефиксКонфигурации);
	ПараметрыОткрытияФормы.Вставить("ВерсияНастроекОбработки", ВерсияНастроекОбработки);
	ПараметрыОткрытияФормы.Вставить("АдресВременногоХранилищаКэш", АдресВременногоХранилищаКэш);  
	ПараметрыОткрытияФормы.Вставить("ЭтоМастерНастроек", ЗапускатьМастерНастроек);
	ПараметрыОткрытияФормы.Вставить("ПоказыватьНастройкиРазработчика", ПоказыватьНастройкиРазработчика);
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработкаЗакрытияФормыНастроек", ЭтаФорма);
	ОткрытьФорму(ИмяОбработки + ".Форма.ФормаНастройки", ПараметрыОткрытияФормы, ЭтаФорма, , , , ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗакрытияФормыНастроек(Результат, ДопПараметры) Экспорт
	
	ОпределитьИспользованиеТестовогоКонтура();
	
	//Отображаем версию обработки
	ТестовыйКонтурСтрока = "";
	Если Объект.ЭтоТестоваяОбработка Тогда
		ТестовыйКонтурСтрока = "для тестирования";
	КонецЕсли;
	
	ВерсияОбработкиСтрокой = "v." + ВерсияНастроекОбработки + " " + ТестовыйКонтурСтрока;
	
	ИнициализацияИнтеграции();
	
	СформироватьИСохранитьПараметрыФоновыхЗаданий(ЭтоФайловаяОбработка());
	
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

