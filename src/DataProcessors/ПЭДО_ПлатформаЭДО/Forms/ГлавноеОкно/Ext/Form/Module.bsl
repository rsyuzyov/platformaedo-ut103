		СтрокаТелаДляФормированияУОУ = ЗаписьJSON.Закрыть();
		
		ПараметрыЗапросаФормированияУОУ = ПолучитьШаблонПараметровЗапроса();
		ПараметрыЗапросаФормированияУОУ.Параметры.Вставить("<Тело>", СтрокаТелаДляФормированияУОУ);
	
	//Удалить--
	КонецЕсли;
	
	
	// Ищем предложение об аннулировании среди подчиненных документов.
	ПараметрыЗапросаЦепочкиДокумента = ПолучитьШаблонПараметровЗапроса();
	ПараметрыЗапросаЦепочкиДокумента.Параметры.Вставить("<id>", ИдентификаторДокумента);
	РезультатЗапросаЦепочкиДокумента = ВыполнитьЗапросAPI("API_ПолучитьЦепочкиДокументов", ПараметрыЗапросаЦепочкиДокумента);
	
	Если РезультатЗапросаЦепочкиДокумента.Ошибка = Истина ИЛИ РезультатЗапросаЦепочкиДокумента.Результат = Неопределено
			ИЛИ РезультатЗапросаЦепочкиДокумента.Результат.Количество() = 0 ИЛИ НЕ РезультатЗапросаЦепочкиДокумента.Результат[0].Свойство("slaves")
			ИЛИ РезультатЗапросаЦепочкиДокумента.Результат[0].slaves.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "По документу с номером "+ИдентификаторДокумента+" не удалось получить цепочку подчиненных документов.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	ИдентификаторПредложенияОбАннулировании = "";
	
	Для Каждого ПодчиненныйДокумент из РезультатЗапросаЦепочкиДокумента.Результат[0].slaves Цикл
		Если ПодчиненныйДокумент.type = "DP_PRANNUL" Тогда
			// Это предложение об аннулировании. 
			Если НЕ ПодчиненныйДокумент.Свойство("slaves") Тогда
				// Нет ни одного подчинённого документа (уведомлений об уточнении).
				// Значит предложение не было отклонено.
				ИдентификаторПредложенияОбАннулировании = Формат(ПодчиненныйДокумент.id, "ЧГ=0"); 
				Прервать;
			Иначе
				КДокументуПриложеноПредложенияОбАннулировании = Истина;
				ИдентификаторПОА = Формат(ПодчиненныйДокумент.id, "ЧГ=0");
				Для Каждого ПодчиненныйПредложениюДокумент из ПодчиненныйДокумент.slaves Цикл
					Если ПодчиненныйПредложениюДокумент.type = "DP_UVUTOCH" Тогда
						// У предложения есть уведомление об уточнении.
						// Значит, оно было отклонено второй стороной.
						ИдентификаторПредложенияОбАннулировании = "";
						Прервать;
					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;
			// Документы в ответе располагаются в обратном хронологическом порядке.
			// Следовательно, если мы нашли предложение об аннулировании, то оно и есть самое актуальное из возможных,
			// прочие просматривать нет необходимости.
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	Если ИдентификаторПредложенияОбАннулировании = "" Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "У документа с номером "+ИдентификаторДокумента+" нет необработанных предложений об аннулировании.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если НЕ РаботаемПоУС Тогда
	// Удалить++
	// После полного перехода на УС.
	
		//Уведомление об уточнении.
		ПараметрыЗапросаФормированияУОУ.Параметры.Вставить("<document_id>", ИдентификаторПредложенияОбАннулировании);
		РезультатФормированияУОУ = ВыполнитьЗапросAPI("API_ПолучитьУведомлениеОбУточнении", ПараметрыЗапросаФормированияУОУ);
		
		Если НЕ РезультатФормированияУОУ.Ошибка Тогда
			
			IDДокументаУОУ = Формат(РезультатФормированияУОУ.Результат.ID, "ЧГ=");
			ПараметрыЗапросаПолученияКонтента = ПолучитьШаблонПараметровЗапроса();
			ПараметрыЗапросаПолученияКонтента.Параметры.Вставить("<document_id>", IDДокументаУОУ);
			РезультатПолученияКонтента = ВыполнитьЗапросAPI("API_ПолучитьКонтентДокумента", ПараметрыЗапросаПолученияКонтента);
			
			Если НЕ РезультатПолученияКонтента.Ошибка Тогда
				
				ВременныйФайл = ПолучитьИмяВременногоФайла("xml");
				РезультатПолученияКонтента.Результат.Записать(ВременныйФайл);
				Файл = Новый Файл(ВременныйФайл);
				
				Если НЕ Файл.Существует() Тогда
					
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Не удалось сохранить скачанный файл уведомления об уточнении покупателя для документа с идентификатором "+ИдентификаторДокумента+".";
					Сообщение.Сообщить();
					Возврат;
					
				Иначе
					
					ПарольСертификата = ПарольДоступаКЗакрытомуКлючу;			
					
					ИмяФайлаПодписи = ПодписатьДокумент(Файл.ИмяБезРасширения, ВременныйФайл, Менеджер, Сертификат, ПарольСертификата, ".signature.p7b");
					
					ПараметрыЗапросаПодписиТитула = ПолучитьШаблонПараметровЗапроса();
					ПараметрыЗапросаПодписиТитула.Параметры.Вставить("<document_id>", IDДокументаУОУ); 
					
					ПодписьДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаПодписи); 
					
					ЭлектроннаяПодписьCMSBase64 = Base64Строка(ПодписьДвоичныеДанные);
					ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ПС, "");
					ЭлектроннаяПодписьCMSBase64 = СтрЗаменить(ЭлектроннаяПодписьCMSBase64, Символы.ВК, "");
					ЭлектроннаяПодписьCMSвDERвURL = КодироватьBase64СтрокуВСтрокуURLНаСервере(ЭлектроннаяПодписьCMSBase64);
					
					СтруктураДанных = Новый Структура;
					СтруктураДанных.Вставить("value", ЭлектроннаяПодписьCMSBase64);
					Если ТипСубъектаПодписанта = "ФЛ" Тогда
						СтруктураPOA = Новый Структура;
						СтруктураPOA.Вставить("number", МчдGUIDПодписанта);
						СтруктураДанных.Вставить("poa", СтруктураPOA);
					КонецЕсли;
					ЗаписьJSON = Новый ЗаписьJSON;
					ЗаписьJSON.УстановитьСтроку();
					ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
					СтрокаТелаДляПередачиПодписи = ЗаписьJSON.Закрыть();
					ПараметрыЗапросаПодписиТитула.Параметры.Вставить("<Тело>", СтрокаТелаДляПередачиПодписи); 
					
					РезультатПодписанияДокумента = ВыполнитьЗапросAPI("API_ПрикрепитьПодписьКДокументу", ПараметрыЗапросаПодписиТитула); 
					
					Если РезультатПодписанияДокумента.Ошибка Тогда
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = "Документ уведомления об уточнении документа с идентификатором "+ПараметрыЗапросаПодписиТитула+" был успешно сформировано, но не мог быть подписан. Идентификатор документа титула: " +IDДокументаУОУ+Символы.ПС+ "Описание ошибки подписания:";
						Сообщение.Сообщить();
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = РезультатПодписанияДокумента.Описание;
						Сообщение.Сообщить();
