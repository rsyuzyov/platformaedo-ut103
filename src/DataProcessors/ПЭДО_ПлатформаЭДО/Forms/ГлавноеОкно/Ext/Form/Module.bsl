&НаКлиенте
Процедура СформироватьИСохранитьПараметрыФоновыхЗаданий(ЭтоФайловаяОбработка)

	ПараметрыФоновыхЗаданий = Новый Структура; 
	ПараметрыФоновыхЗаданий.Вставить("ИнтерактивноОбновлятьСтатусыДО", ИнтерактивноОбновлятьСтатусыДО);
	ПараметрыФоновыхЗаданий.Вставить("ЭтоФайловаяОбработка", ЭтоФайловаяОбработка);
	ПараметрыФоновыхЗаданий.Вставить("ИмяОбработки", ИмяОбработки);
	ПараметрыФоновыхЗаданий.Вставить("ХранениеФайлаОбработки", ХранениеФайлаОбработки);
	ПараметрыФоновыхЗаданий.Вставить("ОбработкаСсылка", ?(ЭтоФайловаяОбработка, Неопределено, ОбъектСсылка));
	ПараметрыФоновыхЗаданий.Вставить("УникальныйИдентификаторФормы", УникальныйИдентификатор);
	СохранитьПараметрыФоновыхЗаданийНаСервере(ПараметрыФоновыхЗаданий);	
	
КонецПроцедуры	

&НаСервере
Функция КопияОбработкиНаСервере(Хранение)

	Результат = ПолучитьИмяВременногоФайла();
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Хранение);
	ДвоичныеДанные.Записать(Результат);
	
	Возврат Результат;

КонецФункции
	
&НаСервере
Функция ЭтоФайловаяОбработка()
	 
	ИмяФайла = ИмяФайлаОбработки();
	Файловая = СтрНайти(ИмяФайла, ".epf");
	
	Возврат ?(Файловая = 0, Ложь, Истина);
	
КонецФункции

