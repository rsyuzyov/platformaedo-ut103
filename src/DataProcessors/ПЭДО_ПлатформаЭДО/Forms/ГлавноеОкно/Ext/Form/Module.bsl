&НаКлиенте
Функция ПеревестиСтатус1СвСтатусAPI(Статус)
	
	//На 19.02.2020 возможные статусы: NEW, DELETED, SIGNED, SENT, DELIVERED, ACCEPTED, REJECTED.
	// 19.03.2026 +CORRECTION_REQUESTED 
	Если Статус = 10 Тогда //Новый.
		Возврат "NEW,SIGNED"; //Черновик + Подписан отправителем
	ИначеЕсли Статус = 11 Тогда //Ожидает оплаты
		Возврат "AWAIT_PAYMENT";	
	ИначеЕсли Статус = 13 Тогда //Предложено аннулирование
		Возврат "PRECANCELLED";
	ИначеЕсли Статус = 14 Тогда //Аннулирован
		Возврат "CANCELLED";	
	ИначеЕсли Статус = 22 Тогда //Неизвестная и неожиданная ошибка.
		Возврат "SENDING_FAILED";
	ИначеЕсли Статус = 12 Тогда //В процессе отправки
		Возврат "SENDING";
	ИначеЕсли Статус = 17 Тогда //Запрос на уточнение
		Возврат "CORRECTION_REQUESTED";	
	ИначеЕсли Статус = 40 Тогда //Отправлен.
		Возврат "SENT"; //Отправлен
	ИначеЕсли Статус = 50 Тогда //Доставлен.
		Возврат "DELIVERED"; //Доставлен
	ИначеЕсли Статус = 70 Тогда //Подписан получателем.
		Возврат "ACCEPTED"; //Подписан
	ИначеЕсли Статус = 60 Тогда //Отклонён.
		Возврат "REJECTED"; //Отклонён                     	
	ИначеЕсли Статус = 90 Тогда //Удалён.
		Возврат "DELETED";	//Удалён
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	Кэш = ЗагрузитьКэш();
	
	МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
	Настройка = МодульОбъектаОбработки.ПолучитьОбъектНастройкиПоИмениМетаданных("Конфигурация", Кэш);
	
	Если Настройка.СпискиДокументов.Свойства().Получить("СписокДокументов") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Настройка.СпискиДокументов.СписокДокументов) = Тип("СписокXDTO") Тогда
		// Несколько списков документов
		СписокДокументов = Настройка.СпискиДокументов.ПолучитьСписок("СписокДокументов");
	Иначе
		// Один список документов
		СписокДокументов = Новый Массив;
		СписокДокументов.Добавить(Настройка.СпискиДокументов.СписокДокументов);
	КонецЕсли;
	
	Для Каждого Список из СписокДокументов Цикл
		Если НЕ Список.ПараметрыЗапроса.Свойства().Получить("Организация") = Неопределено 
				И Список.ПараметрыЗапроса.Организация.ИсточникДанныхДляПараметра = "ФормаОбработки" Тогда  
			СписокРеквизит = ЭтаФорма[Список.Наименование];
			СписокРеквизит.Параметры.УстановитьЗначениеПараметра("Организация", Организация);
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

