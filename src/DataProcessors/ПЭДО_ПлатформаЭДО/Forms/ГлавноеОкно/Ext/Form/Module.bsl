		КонецЕсли;
		Если НЕ ВыбранныеТипыПредставление = "" Тогда
			Если СтрДлина(ВыбранныеТипыПредставление) > 15 Тогда
				Элементы.ТипыДокументовДляФильтраВходящих.Заголовок = "Типы:" + Лев(ВыбранныеТипыПредставление, 15) + "...";
			Иначе
				Элементы.ТипыДокументовДляФильтраВходящих.Заголовок = "Типы:" + ВыбранныеТипыПредставление;
			КонецЕсли;	
			Элементы.ТипыДокументовДляФильтраВходящих.Подсказка = ВыбранныеТипыПредставление;
		Иначе
			Элементы.ТипыДокументовДляФильтраВходящих.Заголовок = "Фильтр по типу";
			Элементы.ТипыДокументовДляФильтраВходящих.Подсказка = "";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеФильтраВходящихПоТипамНажатие(Элемент)
	
	СписокТиповДляВыбора = Новый СписокЗначений;
	СписокТиповДляВыбора.Добавить("NEW_SELLER_TITLE",		"УПД");
	СписокТиповДляВыбора.Добавить("NEW_COR_SELLER_TITLE",	"УКД");
	СписокТиповДляВыбора.Добавить("TRADE_SELLER_TITLE",		"Торг-12");
	СписокТиповДляВыбора.Добавить("COMPLETION_CERTIFICATE",	"Акт ВР");
	СписокТиповДляВыбора.Добавить("GS_ACCEPTANCE_REPORT",	"Торг-2");
	СписокТиповДляВыбора.Добавить("RECONCILIATION_REQUEST",	"Акт сверки");
	СписокТиповДляВыбора.Добавить("PAYMENT_INVOICE",		"Счет на оплату");
	СписокТиповДляВыбора.Добавить("UNFORMALIZED",			"Неформализованный");
	
	Для Каждого ЭлементСписка из СписокТиповДляВыбора Цикл
		Если НЕ СтрНайти(ЭтаФорма.ТипыДокументовДляФильтраВходящих, ЭлементСписка.Значение) = 0 Тогда
			ЭлементСписка.Пометка = Истина;
		КонецЕсли;	
	КонецЦикла;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПолеФильтраВходящихПоТипам_ОбработкаВыбора", ЭтаФорма);
	СписокТиповДляВыбора.ПоказатьОтметкуЭлементов(ОписаниеОповещения, "Выберите типы");
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеФильтраВходящихПоНаличиюМаркировки_ОбработкаВыбора(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатЗакрытия = Неопределено Тогда	
		ЭтаФорма.НаличиеМаркировкиДляФильтраВходящих = РезультатЗакрытия.Значение; 
		Элементы.НаличиеМаркировкиДляФильтраВходящих.Заголовок = ?(РезультатЗакрытия.Значение = 0, "Фильтр по наличию маркировки", "Документы: "+РезультатЗакрытия.Представление);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеФильтраВходящихПоНаличиюМаркировкиНажатие(Элемент)
	
	СписокПризнаковНаличияМаркировкиДляВыбора = Новый СписокЗначений;
	СписокПризнаковНаличияМаркировкиДляВыбора.Добавить(0, "Все");
	СписокПризнаковНаличияМаркировкиДляВыбора.Добавить(1, "С маркировкой");
	СписокПризнаковНаличияМаркировкиДляВыбора.Добавить(2, "Без маркировки");
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПолеФильтраВходящихПоНаличиюМаркировки_ОбработкаВыбора", ЭтаФорма);
	ПоказатьВыборИзСписка(ОписаниеОповещения, СписокПризнаковНаличияМаркировкиДляВыбора, Элементы.НаличиеМаркировкиДляФильтраВходящих, );
		
КонецПроцедуры

