				ПолучениеКонтентаДокумента = ВыполнитьЗапросAPI("API_ПолучитьКонтентДокументаСWatermark", ПараметрыЗапроса);
				Если ПолучениеКонтентаДокумента.Ошибка И ПолучениеКонтентаДокумента.КодСостояния = 415 Тогда
