//&НаКлиенте
//Перем ЭтоТестоваяОбработка;

#Область СобытияФормы

// Подготовительные действия при открытии обработки
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// ⭐ Вставка расширения: клиентские настройки маппинга движок читает ДЛЯ ТЕКУЩЕГО пользователя
	//    (ПолучитьСохраненныеКлиентскиеНастройки → ПолучитьТекущегоПользователя). Если их нет,
	//    берутся штатные настройки вендора, а там запрос списка документов тянет реквизит
	//    РеализацияТоваровУслуг.СодержитМаркируемыйТовар, которого в УТ 10.3 нет, — и форма
	//    падает при открытии. Раскладываем настройки до сборки кэша.
	ПЭДО_Сервер.ЗагрузитьКлиентскиеНастройки();
	
	ОбъектСсылка = Параметры.ДополнительнаяОбработкаСсылка;
	ИдентификаторКоманды = Параметры.ИдентификаторКоманды;
		
	ИмяОбработки = РеквизитФормыВЗначение("Объект").Метаданные().ПолноеИмя(); 
	ИмяФайлаОбработки = ИмяФайлаОбработки();   
	
	ПредставлениеТекущейКонфигурации = Транслит("1С " + Метаданные.ПодробнаяИнформация + "; Версия: " + Метаданные.Версия);
	
	ОпределитьИспользованиеТестовогоКонтура();
	
	// УС Удалить после полной активации ++
	РаботаПоУС_ДатаНачала = Дата("20260601");
	Если ТекущаяДата() >= РаботаПоУС_ДатаНачала Тогда 
		РаботаемПоУС = Истина;
	КонецЕсли;	
	// УС Удалить после полной активации --
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(ЭтаФорма.Организация) Тогда
		Элементы.ОрганизацияГиперссылка.Заголовок = "Организация: " + ЭтаФорма.Организация;
	КонецЕсли;	
	
	ЭтаФорма.Заголовок = ЭтаФорма.Заголовок; 
	
	//Отображаем версию обработки
	ТестовыйКонтурСтрока = "";
	Если Объект.ЭтоТестоваяОбработка Тогда
		ТестовыйКонтурСтрока = "для тестирования";
	КонецЕсли;
	
	ВерсияОбработкиСтрокой = "v." + ВерсияНастроекОбработки + " " + ТестовыйКонтурСтрока;

	ВедущийФрагментАдресаKeycloak = ?(Объект.ЭтоТестоваяОбработка = Истина, "oauth-test", "oauth");
	realmФрагментАдресаKeycloak = ?(Объект.ЭтоТестоваяОбработка = Истина, "playground", "production");
	
	Если ОбновитьНастройки() Тогда // Осталось для обновления версии настроек в интеграции.
		//ОткатитсяКСтандартнымНастройкамНаСервере();
	КонецЕсли;
	
	ОткатитсяКСтандартнымНастройкамНаСервере();
	
	// Инициализируем Кэш
	ИнициализацияКэш();	
	
	//Во избежание ложных срабатываний
	ЗапускатьМастерНастроек = Ложь;
	
	// Загружаем пользовательские настройки интеграции
	ИнициализацияИнтеграции();
	
	// Добавляем необходимые для работы свойства
	ДобавитьСвойстваДляХраненияИнформации1С();
	
	ПолучитьДатуПоследнегоОбновленияСтатусов();

	// Подготовка параметров для запуска фоновых задач и завершение построения формы.
	ЭтоФайловаяОбработка = ЭтоФайловаяОбработка();
	
	Если ЭтоФайловаяОбработка Тогда
        ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьРезультатПомещенияФайлаОбработки", ЭтотОбъект); 
        НачатьПомещениеФайлов(ОписаниеОповещения, ИмяФайлаОбработки, Ложь, УникальныйИдентификатор);
	Иначе
		СформироватьИСохранитьПараметрыФоновыхЗаданий(Ложь);
		СформироватьФормуПриОткрытии();
	КонецЕсли;	
	
	//Если настройки интеграции пустые - запускаем мастер настроек
	Если ЗапускатьМастерНастроек тогда
		ОткрытьНастройки("");
		ЗапускатьМастерНастроек = Ложь;
	КонецЕсли;
	
КонецПроцедуры

// Функция при смене страницы (динамического списка) подгружает список доступных форматов для выгрузки
&НаКлиенте
Процедура ПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если НЕ ТекущаяСтраница.Имя = "ВхДокументы" и НЕ ТекущаяСтраница.Имя = "ИсхДокументы" Тогда
		
		Элементы.ГруппаКнопкиНаОтправку.Видимость	= Истина;
		Элементы.ГруппаКнопкиВходящих.Видимость		= Ложь;
		Элементы.ГруппаКнопкиНаОтправку.Доступность	= Истина;
		Элементы.ГруппаКнопкиВходящих.Доступность	= Истина;
		Элементы.ГруппаКнопкиИсходящих.Видимость	= Ложь;
		Элементы.ГруппаКнопкиИсходящих.Доступность	= Ложь;
		
		СписокДоступныхФорматов = ПолучитьСписокДоступныхФорматовНаСервере(ТекущаяСтраница.Имя, АдресВременногоХранилищаКэш);
		ДоступныеВерсииФорматов = ПолучитьСписокДоступныхВерсийФорматовНаСервере(ТекущаяСтраница.Имя, АдресВременногоХранилищаКэш);
		
		// Заполняем по умолчанию первым значением из списка
		ФорматВыгрузки					= СписокДоступныхФорматов.Получить(0).Значение;
		ПредставлениеФорматаВыгрузки	= СписокДоступныхФорматов.Получить(0).Представление;
		Элементы.ФорматВыгрузкиГиперссылка.Видимость		= Истина;
		Элементы.ФорматВыгрузкиГиперссылка.Заголовок		= "Формат выгрузки: " + ПредставлениеФорматаВыгрузки;
		ВерсияФорматаВыгрузки	= ДоступныеВерсииФорматов[ФорматВыгрузки].Получить(0).Значение;
		Элементы.ВерсияФорматаВыгрузкиГиперссылка.Видимость = Ложь;
		Элементы.ВерсияФорматаВыгрузкиГиперссылка.Заголовок = "Версия: " + ВерсияФорматаВыгрузки;
		
	ИначеЕсли ТекущаяСтраница.Имя = "ИсхДокументы" Тогда 
		
		Элементы.ФорматВыгрузкиГиперссылка.Видимость	= Ложь;
		Элементы.ГруппаКнопкиНаОтправку.Видимость		= Ложь;
		Элементы.ГруппаКнопкиВходящих.Видимость			= Ложь;
		Элементы.ГруппаКнопкиНаОтправку.Доступность		= Ложь;
		Элементы.ГруппаКнопкиВходящих.Доступность		= Ложь;
		Элементы.ГруппаКнопкиИсходящих.Видимость		= Истина;
		Элементы.ГруппаКнопкиИсходящих.Доступность		= Истина;
		
		// Удалить++
		// Не забыть удалить саму кнопку и команду к ней, вместе с процедурами.
		Если РаботаемПоУС = Истина Тогда
			Элементы.ПодписатьИзвещение.Видимость = Ложь;
		Иначе
			Элементы.ПодписатьИзвещение.Видимость = Истина;
		КонецЕсли;
		// Удалить--
		
	ИначеЕсли ТекущаяСтраница.Имя = "ВхДокументы" Тогда 
		
		Элементы.ФорматВыгрузкиГиперссылка.Видимость	= Ложь;
		Элементы.ГруппаКнопкиНаОтправку.Видимость		= Ложь;
		Элементы.ГруппаКнопкиВходящих.Видимость			= Истина;
		Элементы.ГруппаКнопкиНаОтправку.Доступность		= Истина;
		Элементы.ГруппаКнопкиВходящих.Доступность		= Истина;
		Элементы.ГруппаКнопкиИсходящих.Видимость		= Ложь;
		Элементы.ГруппаКнопкиИсходящих.Доступность		= Ложь;
		
	КонецЕсли;	
	
КонецПроцедуры

// Сохранение объема единичной выгрузки в "Интеграцию"
&НаКлиенте                                            
Процедура ОбъемЕдиничнойВыгрузкиПриИзменении(Элемент)
	
	Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	
	Если Не Интеграция.Свойство("МассоваяВыгрузка") Тогда
		
		МассоваяВыгрузка = Новый Структура;
		МассоваяВыгрузка.Вставить("ОбъемЕдиничнойВыгрузки", ОбъемЕдиничнойВыгрузки);  		
		Интеграция.Вставить("МассоваяВыгрузка", МассоваяВыгрузка);
		
	ИначеЕсли Не Интеграция.МассоваяВыгрузка.Свойство("ОбъемЕдиничнойВыгрузки") Тогда 
		
		Интеграция.МассоваяВыгрузка.Вставить("ОбъемЕдиничнойВыгрузки", ОбъемЕдиничнойВыгрузки);
		
	Иначе
		
		Интеграция.МассоваяВыгрузка.ОбъемЕдиничнойВыгрузки = ОбъемЕдиничнойВыгрузки;
		
	КонецЕсли;
	
	СохранитьИнтеграциюНаСервере(Интеграция)
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбработкаПолученияДанныхДинамическогоСписка(ИмяЭлемента, Настройки, Строки)
	
	ПараметрыФоновыхЗаданий = ПолучитьПараметрыФоновыхЗаданийНаСервере();	
	
	Если ПараметрыФоновыхЗаданий = Неопределено Тогда
		Возврат;		
	КонецЕсли;
	
	Если НЕ ПараметрыФоновыхЗаданий.Свойство("ИнтерактивноОбновлятьСтатусыДО") ИЛИ ПараметрыФоновыхЗаданий.ИнтерактивноОбновлятьСтатусыДО = Ложь Тогда
		Возврат;		
	КонецЕсли;	
	
	МассивДокументов = Новый Массив;
	
	Для каждого СтрокаСписка из Строки Цикл
		МассивДокументов.Добавить(СтрокаСписка.Ключ);
	КонецЦикла;
	
	ЭтоФайловаяОбработка = ПараметрыФоновыхЗаданий.ЭтоФайловаяОбработка;
	ИмяОбработки = ПараметрыФоновыхЗаданий.ИмяОбработки;
	ХранениеФайлаОбработки = ПараметрыФоновыхЗаданий.ХранениеФайлаОбработки;
	УникальныйИдентификатор = ПараметрыФоновыхЗаданий.УникальныйИдентификаторФормы;
	ОбработкаСсылка = ПараметрыФоновыхЗаданий.ОбработкаСсылка;
	
	ИмяОбработкиДляФоновогоВыполнения = ?(ЭтоФайловаяОбработка, ХранениеФайлаОбработки, ИмяОбработки);	
	
	ПараметрыВыполненияОбработки = Новый Структура;
	ПараметрыВыполненияОбработки.Вставить("МассивДокументов", МассивДокументов);
	ПараметрыВыполненияОбработки.Вставить("Пользователь", ПолучитьТекущегоПользователя());
	
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ИмяОбработки",		ИмяОбработкиДляФоновогоВыполнения);
	ПараметрыЗадания.Вставить("ИмяМетода",			"ОбновитьСтатусыСпискаДокументовВФоне");
	ПараметрыЗадания.Вставить("ПараметрыВыполнения",	ПараметрыВыполненияОбработки);
	ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка",	Ложь); // ПЭДО: обработка конфигурации
	ПараметрыЗадания.Вставить("ДополнительнаяОбработкаСсылка", ОбработкаСсылка);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Обновление статусов документов в фоне по массиву ссылок.";
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.Вставить("ИдентификаторФормы", УникальныйИдентификатор); 
	
	ВыполняемыйМетод = "ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки"; // Выполняем процедуру из модуля объекта
	РезультатВыполнения = ДлительныеОперации.ВыполнитьВФоне(ВыполняемыйМетод, ПараметрыЗадания, ПараметрыВыполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияГиперссылкаНажатие_ОбработкаВыбора(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
		
	Если НЕ РезультатЗакрытия = Неопределено Тогда
		
		ЭтаФорма.Организация = РезультатЗакрытия.Значение;
		Элементы.ОрганизацияГиперссылка.Заголовок = "Организация: " + ЭтаФорма.Организация;
		
		ИнициализацияИнтеграции();
		ОрганизацияПриИзмененииНаСервере();	
		
		Если НЕ Организация.Пустая() Тогда
			ИдентификаторОрганизации = ПолучитьИдентификаторЭДОИз1СПоСсылке(Организация);
			Если НЕ Элементы.Найти("ТаблицаИсходящих") = Неопределено Тогда
				ЭтаФорма.ОрганизацииДляФильтраИсходящих.Очистить();
				ЭтаФорма.ОрганизацииДляФильтраИсходящих.Добавить(Организация);
			КонецЕсли;
			Если НЕ Элементы.Найти("ТаблицаВходящих") = Неопределено Тогда
				ЭтаФорма.ОрганизацииДляФильтраВходящих.Очистить();
				ЭтаФорма.ОрганизацииДляФильтраВходящих.Добавить(Организация);
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ИсхДокументы" Тогда
			ОбновитьСписокИсходящихДокументовОбщее();
		ИначеЕсли ЭтаФорма.Элементы.Страницы.ТекущаяСтраница.Имя = "ВхДокументы" Тогда
			ОбновитьСписокВходящихДокументовОбщее();
		КонецЕсли;
		
		ОбновитьЭлементыФормы();
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияГиперссылкаНажатие(Элемент)
	
	ДоступныеОрганизации = ПолучитьДоступныеОрганизации1С();
	
	СписокОрганизации = Новый СписокЗначений;
	
	Для Каждого ОрганизацияСтруктура из ДоступныеОрганизации Цикл
		СписокОрганизации.Добавить(ОрганизацияСтруктура.Ссылка, ОрганизацияСтруктура.Ссылка);
	КонецЦикла;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОрганизацияГиперссылкаНажатие_ОбработкаВыбора", ЭтаФорма);
	ПоказатьВыборИзСписка(ОписаниеОповещения, СписокОрганизации, Элементы.ОрганизацияГиперссылка, );
	
КонецПроцедуры

&НаКлиенте
Процедура ФорматГиперссылкаНажатие_ОбработкаВыбора(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
		
	Если НЕ РезультатЗакрытия = Неопределено Тогда
		
		ЭтаФорма.ФорматВыгрузки = РезультатЗакрытия.Значение;
		Элементы.ФорматВыгрузкиГиперссылка.Заголовок = "Формат выгрузки: " + ЭтаФорма.ФорматВыгрузки;
		
		ДоступныеВерсииФорматов = ПолучитьСписокДоступныхВерсийФорматовНаСервере(Элементы.Страницы.ТекущаяСтраница.Имя, АдресВременногоХранилищаКэш);
		ДоступныеВерсииТекущегоФормата = ДоступныеВерсииФорматов[ФорматВыгрузки];
		ЭтаФорма.ВерсияФорматаВыгрузки = ДоступныеВерсииФорматов[ЭтаФорма.ФорматВыгрузки].Получить(0).Значение;
		Элементы.ВерсияФорматаВыгрузкиГиперссылка.Заголовок = "Версия: " + ЭтаФорма.ВерсияФорматаВыгрузки;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ФорматГиперссылкаНажатие(Элемент)
	
	ДоступныеФорматы = ПолучитьСписокДоступныхФорматовНаСервере(Элементы.Страницы.ТекущаяСтраница.Имя, АдресВременногоХранилищаКэш);
		
	ОписаниеОповещения = Новый ОписаниеОповещения("ФорматГиперссылкаНажатие_ОбработкаВыбора", ЭтаФорма);
	ПоказатьВыборИзСписка(ОписаниеОповещения, ДоступныеФорматы, Элементы.ФорматВыгрузкиГиперссылка, );
	
КонецПроцедуры

&НаКлиенте
Процедура ВерсияФорматаГиперссылкаНажатие_ОбработкаВыбора(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
		
	Если НЕ РезультатЗакрытия = Неопределено Тогда
		
		ЭтаФорма.ВерсияФорматаВыгрузки = РезультатЗакрытия.Значение;
		Элементы.ВерсияФорматаВыгрузкиГиперссылка.Заголовок = "Версия: " + ЭтаФорма.ВерсияФорматаВыгрузки;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВерсияФорматаГиперссылкаНажатие(Элемент)
	
	ДоступныеВерсииФорматов = ПолучитьСписокДоступныхВерсийФорматовНаСервере(Элементы.Страницы.ТекущаяСтраница.Имя, АдресВременногоХранилищаКэш);
	ДоступныеВерсииТекущегоФормата = ДоступныеВерсииФорматов[ФорматВыгрузки];
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВерсияФорматаГиперссылкаНажатие_ОбработкаВыбора", ЭтаФорма);
	ПоказатьВыборИзСписка(ОписаниеОповещения, ДоступныеВерсииТекущегоФормата, Элементы.ВерсияФорматаВыгрузкиГиперссылка, );
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если НЕ ЗавершениеРаботы Тогда
		СохранитьПараметрыФоновыхЗаданийНаСервере(Неопределено);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВерсияОбработкиСтрокойНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	СчетчикНажатийВерсии = СчетчикНажатийВерсии + 1; 
	
	Если СчетчикНажатийВерсии >= 3 тогда
		
		СчетчикНажатийВерсии = 0; 
		
		ВерсияОбработкиСтрокойНажатиеСервер();
	    
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ВерсияОбработкиСтрокойНажатиеСервер()
	
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", 										// Ключ объекта
				"ПоказыватьНастройкиРазработчика",                                                          // Ключ настройки
				Истина,																						 
				"Служебный параметр, определяющий доступность настроек для разработки", 					// описание настройки
				ПолучитьТекущегоПользователя());
				
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыФункции

&НаКлиенте
Процедура СформироватьФормуПриОткрытии()
	
	// Заполняем динамический список на основании настроек
	// После выполенения этой процедуры вызывать сервер только без контекста, чтобы не передавать сформированные списки на сервер
	ЗаполнитьДинамическиеСписки();	
	
	// Устанавливаем доступные форматы относительно списка
	Если НЕ ЭтаФорма.Элементы.Найти("Страницы") = Неопределено Тогда
		ПриСменеСтраницы(Неопределено, ЭтаФорма.Элементы.Страницы.ТекущаяСтраница);
	КонецЕсли;
	
	ОбновитьЭлементыФормы();
	
КонецПроцедуры	

// При открытии обработки инициализуем Кэш для работы
&НаСервере
Процедура ИнициализацияКэш(Откат = Ложь)
	
	// Инициализируем Кэш 
	//МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
	Кэш = ЗагрузитьКэш(Откат);
	
	Если Кэш = Неопределено Тогда
		Кэш = ЗагрузитьКэш(Истина);
	КонецЕсли;	
	
	//ЗначениеВРеквизитФормы(МодульОбъектаОбработки, "Объект"); 
	СохранитьКэш(Кэш);
	// Инициализируем Кэш 

	ПрефиксКонфигурации = Кэш.ПрефиксКонфигурации;
	
КонецПроцедуры

// Процедура инициализирует способ интеграции
// Если обработка ранее запускалась, то настройки подтягиваются из хранилища настроек
// Если обработка ранее не запускалась, то настройки не предзаполняются
&НаКлиенте
Процедура ИнициализацияИнтеграции()
	
	ТокенАвторизации = Неопределено;
	
	// Инициализируем способ интеграции
	Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	Если (Интеграция <> Неопределено) Тогда
		
		Если Интеграция.Свойство("СпособИнтеграции") И Интеграция.СпособИнтеграции <> Неопределено Тогда				
			// Заполняем значения реквизитов формы из сохраненных значений интеграции
			КаталогОбмена = Интеграция.КаталогОбмена;	
			СпособИнтеграции = Интеграция.СпособИнтеграции;
		ИначеЕсли Интеграция.СпособИнтеграции = Неопределено Тогда
			СпособИнтеграции = 1;
			КаталогОбмена = ?(Интеграция.КаталогОбмена = Неопределено, "", Интеграция.КаталогОбмена);
			СохранитьИнтеграциюНаСервере(Интеграция);
		КонецЕсли;
				
		Если Интеграция.Свойство("ИнтерактивноОбновлятьСтатусыДО") Тогда
			ИнтерактивноОбновлятьСтатусыДО = Интеграция.ИнтерактивноОбновлятьСтатусыДО; 
		КонецЕсли;
		
		// Удалить++
		Если Интеграция.Свойство("РаботаПоУС") Тогда
			РаботаемПоУС = Интеграция.РаботаПоУС;
		КонецЕсли;
		// Удалить--
		
		AccessToken						= "";
		RefreshToken					= "";
		ИспользоватьПодписание			= Ложь;
		ОтпечатокСертификатаBase64		= "";
		ПарольДоступаКЗакрытомуКлючу	= "";
		ТипСубъектаПодписанта			= "";
		ДатаНачалаДействияМЧД			= "";
		МчдGUIDПодписанта				= "";
				
		Если НЕ Организация.Пустая() Тогда
			
			Если Интеграция.Свойство("ПараметрыАвторизацииИПодписания") Тогда
				ПараметрыАвторизацииИПодписанияОрганизации = Интеграция.ПараметрыАвторизацииИПодписания.Получить(Организация);
				Если НЕ ПараметрыАвторизацииИПодписанияОрганизации = Неопределено Тогда
					Если ПараметрыАвторизацииИПодписанияОрганизации.Свойство("AccessToken") Тогда
						AccessToken = ПараметрыАвторизацииИПодписанияОрганизации.AccessToken;
					ИначеЕсли ПараметрыАвторизацииИПодписанияОрганизации.Свойство("ТокенАвторизации") Тогда
						ТокенАвторизации = ПараметрыАвторизацииИПодписанияОрганизации.ТокенАвторизации;
						AccessToken = ТокенАвторизации;
					КонецЕсли;
					Если ПараметрыАвторизацииИПодписанияОрганизации.Свойство("RefreshToken") Тогда
						RefreshToken = ПараметрыАвторизацииИПодписанияОрганизации.RefreshToken;
					КонецЕсли;
					Если ПараметрыАвторизацииИПодписанияОрганизации.Свойство("ИспользуетсяПодписание") Тогда
						ИспользоватьПодписание = ПараметрыАвторизацииИПодписанияОрганизации.ИспользуетсяПодписание;
					КонецЕсли;
					Если ПараметрыАвторизацииИПодписанияОрганизации.Свойство("ПараметрыПодписания") 
							И ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.Свойство("ОтпечатокСертификатаBase64") Тогда
						ОтпечатокСертификатаBase64 = ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.ОтпечатокСертификатаBase64;
						Если ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.Свойство("ПарольДоступаКЗакрытомуКлючу") Тогда
							ПарольДоступаКЗакрытомуКлючу = ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.ПарольДоступаКЗакрытомуКлючу; 	
						КонецЕсли;
						Если ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.Свойство("ТипСубъекта") Тогда
							ТипСубъектаПодписанта = ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.ТипСубъекта; 	
						КонецЕсли;
						Если ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.Свойство("МчдGUID") Тогда
							МчдGUIDПодписанта = ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.МчдGUID; 	
						КонецЕсли;
						Если ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.Свойство("ДатаНачалаДействияМЧД") Тогда
							ДатаНачалаДействияМЧД = ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.ДатаНачалаДействияМЧД; 	
						КонецЕсли;
						Если ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.Свойство("ДолжностьФизлица") Тогда
							ДолжностьФизлица = ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.ДолжностьФизлица; 	
						КонецЕсли;
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;
			
			ИдентификаторОрганизации = ПолучитьИдентификаторЭДОИз1СПоСсылке(Организация);
			
		КонецЕсли;	
		
		Если ОтпечатокСертификатаBase64 = "" Тогда
			ИспользоватьПодписание = Ложь;
			ОбновитьЭлементыФормы();
		КонецЕсли;	
		
		Если Интеграция.Свойство("МассоваяВыгрузка") и Интеграция.МассоваяВыгрузка.Свойство("ОбъемЕдиничнойВыгрузки") Тогда
			ОбъемЕдиничнойВыгрузки = Интеграция.МассоваяВыгрузка.ОбъемЕдиничнойВыгрузки;
		КонецЕсли; 
		
		Если Интеграция.Свойство("ЭтоПервыйЗапуск") тогда
			Если Интеграция.ЭтоПервыйЗапуск тогда
				ЗапускатьМастерНастроек = Истина; 
				Интеграция.Удалить("ЭтоПервыйЗапуск");
				// >>> ПАТЧ УТ 10.3: персист снятия флага ЭтоПервыйЗапуск
				// Вендор снимает флаг только в памяти (Удалить), без сохранения → флаг
				// запекается в хранилище при первом запуске и мастер стартует КАЖДЫЙ раз.
				// Персистим снятие: мастер покажется один раз, дальше — рабочее место.
				СохранитьИнтеграциюНаСервере(Интеграция);
				// <<< ПАТЧ УТ 10.3
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ТокенАвторизации = Неопределено Тогда
		СохранитьПараметрыАвторизацииИПодписанияОрганизации(Организация, AccessToken, RefreshToken, ИспользоватьПодписание, ОтпечатокСертификатаBase64, ПарольДоступаКЗакрытомуКлючу, ТипСубъектаПодписанта, МчдGUIDПодписанта, ДатаНачалаДействияМЧД, ДолжностьФизлица);
	КонецЕсли;	
		
	// Инициализируем способ интеграции  	
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПараметрыАвторизацииИПодписанияОрганизации(Организация, AccessTokenОрганизации, RefreshTokenОрганизации, ИспользоватьПодписание, ОтпечатокСертификатаBase64Организации, ПарольДоступаКЗакрытомуКлючуОрганизации, ТипСубъектаПодписантаОрганизации, МчдGUIDПодписантаОрганизации, ДатаНачалаДействияМЧДОрганизации, ДолжностьФизлицаОрганизации)

	ПараметрыАвторизацииИПодписанияОрганизации = Новый Структура;
	
	ПараметрыАвторизацииИПодписанияОрганизации.Вставить("AccessToken", AccessTokenОрганизации);
	ПараметрыАвторизацииИПодписанияОрганизации.Вставить("RefreshToken", RefreshTokenОрганизации);
	ПараметрыАвторизацииИПодписанияОрганизации.Вставить("ИспользуетсяПодписание", ИспользоватьПодписание);
	
	ПараметрыПодписания = Новый Структура;
	 
	ПараметрыПодписания.Вставить("ОтпечатокСертификатаBase64", ОтпечатокСертификатаBase64Организации);
	ПараметрыПодписания.Вставить("ПарольДоступаКЗакрытомуКлючу", ПарольДоступаКЗакрытомуКлючуОрганизации);
	Менеджер = ПолучитьМенеджерКриптографии();
	Сертификат  = ПолучитьЭЦППоОтпечатку(Менеджер, Base64Значение(ОтпечатокСертификатаBase64Организации));
	Если ТипЗнч(Сертификат) = Тип("СертификатКриптографии") Тогда 
		ПараметрыПодписания.Вставить("Субъект", Сертификат.Субъект);
	Иначе
		ПараметрыПодписания.Вставить("Субъект", Неопределено);
	КонецЕсли;
	ПараметрыПодписания.Вставить("ТипСубъекта", ТипСубъектаПодписантаОрганизации);
	ПараметрыПодписания.Вставить("МчдGUID", МчдGUIDПодписантаОрганизации);
	ПараметрыПодписания.Вставить("ДатаНачалаДействияМЧД", ДатаНачалаДействияМЧДОрганизации);
	ПараметрыПодписания.Вставить("ДолжностьФизлица", ?(ЗначениеЗаполнено(ДолжностьФизлицаОрганизации), ДолжностьФизлицаОрганизации, Неопределено));
	
	ПараметрыАвторизацииИПодписанияОрганизации.Вставить("ПараметрыПодписания", ПараметрыПодписания);
	
	ОбновитьПараметрыАвторизацииИПодписанияОрганизации(Организация, ПараметрыАвторизацииИПодписанияОрганизации);	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПараметрыАвторизацииИПодписанияОрганизации(Организация, ПараметрыАвторизацииИПодписанияОрганизации)
	
	Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	
	Если НЕ Интеграция.Свойство("ПараметрыАвторизацииИПодписания") Тогда
		Интеграция.Вставить("ПараметрыАвторизацииИПодписания", Новый Соответствие);
	КонецЕсли;
		
	Интеграция.ПараметрыАвторизацииИПодписания.Вставить(Организация, ПараметрыАвторизацииИПодписанияОрганизации);	
	
	СохранитьИнтеграциюНаСервере(Интеграция);
	
КонецПроцедуры
	
// Функция определяет тип клиента:
// Истина - Управляемая форма
// Ложь - Неуправляемая форма
&НаСервере
Функция ОпределитьТипКлиента() Экспорт
	
	Если ТипЗнч(ЭтаФорма) = Тип("УправляемаяФорма") Тогда 
		Возврат Истина; 
	Иначе 
		Возврат Ложь; 
	КонецЕсли;	
	
КонецФункции

// Добавляет необходимые свойства для хранения информации в 1С
&НаСервере
Процедура ДобавитьСвойстваДляХраненияИнформации1С() 
	
	// Получаем данные из настроек и обновляем Кэш
	Кэш = ЗагрузитьКэш();
	
	Если Кэш = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
	Настройка = МодульОбъектаОбработки.ПолучитьОбъектНастройкиПоИмениМетаданных("Конфигурация", Кэш);
	СохранитьКэш(Кэш); 	
	
	УправляемаяФорма = ОпределитьТипКлиента();
	
	// Пока только для управляемых форм работаем
	Если УправляемаяФорма Тогда
		МодульОбъектаОбработки.ДобавитьСвойстваДляУправляемыхФорм(Настройка.ХранениеИнформации1С);	
	КонецЕсли;
	
КонецПроцедуры

// Функция получает список доступных форматов из КЭШ по текущей странице (по текущему динамическому списку)
// Входящие параметры:
// Текущая страница 			- строка (наименование динамического списка)
// АдресВременногоХранилищаКэш 	- строка (адрес временного хранилища КЭШ - реквизит формы)
// Возвращаемое значение:
// Список значений (формат-представление) доступных форматов для динамического списка
&НаСервере
Функция ПолучитьСписокДоступныхФорматовНаСервере(ТекущаяСтраница, АдресВременногоХранилищаКэш)
	
	Кэш = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаКэш);
	
	Если Кэш = Неопределено Тогда
		ИнициализацияКэш(Истина);
		Кэш = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаКэш);
	КонецЕсли;
	
	ДоступныеФорматы = Кэш.ДоступныеФорматы[ТекущаяСтраница];
	
	Если ДоступныеФорматы = Неопределено Тогда
		
		РеестрДокументов = "Конфигурация";
		
		// Получаем данные из настроек и обновляем Кэш
		МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
		Настройка = МодульОбъектаОбработки.ПолучитьОбъектНастройкиПоИмениМетаданных(РеестрДокументов, Кэш);
		
		Если ТипЗнч(Настройка.СпискиДокументов.СписокДокументов) = Тип("СписокXDTO") Тогда
			// Несколько списков документов
			СписокДокументов = Настройка.СпискиДокументов.ПолучитьСписок("СписокДокументов");
		Иначе
			// Один список документов
			СписокДокументов = Новый Массив;
			СписокДокументов.Добавить(Настройка.СпискиДокументов.СписокДокументов);
		КонецЕсли;	
		
		Для Каждого Список из СписокДокументов Цикл
						
			// Распаковываем список доступных форматов для списка документов в Кэш
			Если ТипЗнч(Список.ФорматыДляВыгрузки.Формат) = Тип("СписокXDTO") Тогда
				// Несколько форматов
				СписокДоступныхФорматов = Список.ФорматыДляВыгрузки.ПолучитьСписок("Формат");
			Иначе
				// Один формат
				СписокДоступныхФорматов = Новый Массив;
				СписокДоступныхФорматов.Добавить(Список.ФорматыДляВыгрузки.Формат);
			КонецЕсли; 		
			//СписокДоступныхФорматов = Список.ФорматыДляВыгрузки.ПолучитьСписок("Формат");
		
			СписокЗначений = Новый СписокЗначений;
			Индекс = 0;
			Для Каждого Формат из СписокДоступныхФорматов Цикл			
				СписокЗначений.Вставить(Индекс, Формат.Значение, Формат.Представление);
				Индекс = Индекс + 1; 
			КонецЦикла;
			Кэш.ДоступныеФорматы.Вставить(Список.Наименование, СписокЗначений);
			
			СохранитьКэш(Кэш);
			
			ДоступныеФорматы = Кэш.ДоступныеФорматы[ТекущаяСтраница];
			
		КонецЦикла;
		
	КонецЕсли;	
		
	Возврат ДоступныеФорматы;
	
КонецФункции

&НаСервере
Функция ПолучитьСписокДоступныхВерсийФорматовНаСервере(ТекущаяСтраница, АдресВременногоХранилищаКэш)
	
	Кэш = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаКэш);
	
	Если Кэш = Неопределено Тогда
		ИнициализацияКэш(Истина);
		Кэш = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаКэш);
	КонецЕсли;
	
	ДоступныеФорматы = Кэш.ДоступныеФорматы[ТекущаяСтраница];
	
	Если ДоступныеФорматы = Неопределено Тогда
		ДоступныеФорматы = ПолучитьСписокДоступныхФорматовНаСервере(ТекущаяСтраница, АдресВременногоХранилищаКэш);
	КонецЕсли;	
	
	РеестрДокументов = "Конфигурация";
	
	// Получаем данные из настроек и обновляем Кэш
	МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
	Настройка = МодульОбъектаОбработки.ПолучитьОбъектНастройкиПоИмениМетаданных(РеестрДокументов, Кэш);
	
	Если ТипЗнч(Настройка.СпискиДокументов.СписокДокументов) = Тип("СписокXDTO") Тогда
		// Несколько списков документов
		СписокДокументов = Настройка.СпискиДокументов.ПолучитьСписок("СписокДокументов");
	Иначе
		// Один список документов
		СписокДокументов = Новый Массив;
		СписокДокументов.Добавить(Настройка.СпискиДокументов.СписокДокументов);
	КонецЕсли;	
	
	Для Каждого Список из СписокДокументов Цикл
		
		// Распаковываем список доступных форматов для списка документов в Кэш
		Если ТипЗнч(Список.ФорматыДляВыгрузки.Формат) = Тип("СписокXDTO") Тогда
			// Несколько форматов
			СписокДоступныхФорматов = Список.ФорматыДляВыгрузки.ПолучитьСписок("Формат");
		Иначе
			// Один формат
			СписокДоступныхФорматов = Новый Массив;
			СписокДоступныхФорматов.Добавить(Список.ФорматыДляВыгрузки.Формат);
		КонецЕсли; 		
		//СписокДоступныхФорматов = Список.ФорматыДляВыгрузки.ПолучитьСписок("Формат");
		
		СтруктураЗначений = Новый Структура;
		Для Каждого Формат из СписокДоступныхФорматов Цикл
			ДоступныеВерсииСписок = Новый СписокЗначений;
			Если НЕ Формат.Свойства().Получить("ДоступныеВерсииФорматов") = Неопределено Тогда
				Если ТипЗнч(Формат.ДоступныеВерсииФорматов.Версия) = Тип("СписокXDTO") Тогда 
					ДоступныеВерсии = Формат.ДоступныеВерсииФорматов.ПолучитьСписок("Версия");
				Иначе
					ДоступныеВерсии = Новый Массив;
					ДоступныеВерсии.Добавить(Формат.ДоступныеВерсииФорматов.Версия.Версия);
				КонецЕсли;
				Для Каждого Версия из ДоступныеВерсии Цикл
					ДоступныеВерсииСписок.Добавить(Версия.Версия);
				КонецЦикла;
			Иначе
				ДоступныеВерсииСписок.Добавить("5.01");
			КонецЕсли;
			ДоступныеВерсииСписок.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
			СтруктураЗначений.Вставить(Формат.Значение, ДоступныеВерсииСписок);
		КонецЦикла;
		
		Кэш.ДоступныеВерсииФорматов.Вставить(Список.Наименование, СтруктураЗначений);
		
		СохранитьКэш(Кэш);
		
		ДоступныеВерсииФорматов = Кэш.ДоступныеВерсииФорматов[ТекущаяСтраница];
		
	КонецЦикла;
	
	Возврат ДоступныеВерсииФорматов;
	
КонецФункции

// Функция загрузки Кэш
// Если значение реквизита формы "АдресВременногоХранилищаКэш" заполнено, то берем Кэш из временного хранилища (ШтатныйЗапуск())
&НаСервере
Функция ЗагрузитьКэш(Откат = Ложь)       
	
	Если ЗначениеЗаполнено(ЭтаФорма.АдресВременногоХранилищаКэш) и Не Откат Тогда
		
		Кэш = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресВременногоХранилищаКэш);
		
		Если НЕ ЗначениеЗаполнено(Кэш) Тогда
			МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
			Кэш = МодульОбъектаОбработки.Инициализация(Откат);
			ЗначениеВРеквизитФормы(МодульОбъектаОбработки, "Объект");
		КонецЕсли;	
		
		Возврат Кэш;
		
	Иначе
		
		МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
		Кэш = МодульОбъектаОбработки.Инициализация(Откат);
		ЗначениеВРеквизитФормы(МодульОбъектаОбработки, "Объект"); 
		
		Возврат Кэш;
		
	КонецЕсли;
	
КонецФункции

// Функция сохранения Кэш в процессе работы
// В текущий Кэш записываем только требуемые для выгрузки настройки, остальные динамически подргружаем по мере необходимости
&НаСервере
Процедура СохранитьКэш(Кэш)
	
	// Удаляем предыдущее значение Кэш из временного хранилища
	Если ЗначениеЗаполнено(ЭтаФорма.АдресВременногоХранилищаКэш) Тогда
		//УдалитьИзВременногоХранилища(ЭтаФорма.АдресВременногоХранилищаКэш);
		Адрес = ЭтаФорма.АдресВременногоХранилищаКэш;
	Иначе
		Адрес = ЭтаФорма.УникальныйИдентификатор;
	КонецЕсли;
	
	// Записываем новое значение Кэш во временное хранилище
	ЭтаФорма.АдресВременногоХранилищаКэш = ПоместитьВоВременноеХранилище(Кэш, Адрес);	
	
КонецПроцедуры

// Получаем настройку из Кэш 
// Функция сделана для вызова сервера с уже заполненным динамическим списком на форме
&НаСервере
Функция ПолучитьСтруктуруХранения1С() Экспорт
	
	ИмяМетаданных = "Конфигурация";
	Кэш = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаКэш);    
	
	Если Кэш.НастройкиОбъект[Кэш.ПрефиксКонфигурации+ИмяМетаданных] = Неопределено Тогда				
		ИнициализацияКэш(Истина);
		Кэш = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаКэш);		
	КонецЕсли;
	
	Настройка = Кэш.НастройкиОбъект[Кэш.ПрефиксКонфигурации+ИмяМетаданных].ХранениеИнформации1С;
	
	СтрокаВызоваСвойствоИдентификатор 			= Настройка.ОФД_ЭДО_ИдентификаторДокумента.ТипОбъектаМетаданных + "." + 
	Настройка.ОФД_ЭДО_ИдентификаторДокумента.Путь + ".НайтиПоНаименованию(" + Символ(034) + 
	Настройка.ОФД_ЭДО_ИдентификаторДокумента.Наименование + Символ(034) + ")";
	
	СтрокаВызоваСвойствоСтатус					= Настройка.ОФД_ЭДО_СтатусДокумента.ТипОбъектаМетаданных + "." + 
	Настройка.ОФД_ЭДО_СтатусДокумента.Путь + ".НайтиПоНаименованию(" + Символ(034) + 
	Настройка.ОФД_ЭДО_СтатусДокумента.Наименование + Символ(034) + ")";
	
	СтрокаВызоваСвойствоИдентификаторУчастника	= Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.ТипОбъектаМетаданных + "." + 
	Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Путь + ".НайтиПоНаименованию(" + Символ(034) + 
	Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Наименование + Символ(034) + ")";
	
	СвойствоИдентификатор 				= Вычислить(СтрокаВызоваСвойствоИдентификатор);									
	СвойствоСтатус						= Вычислить(СтрокаВызоваСвойствоСтатус);
	СвойствоИдентификаторУчастника		= Вычислить(СтрокаВызоваСвойствоИдентификаторУчастника);
	
	СтруктураХранения1С = Новый Структура;
	СтруктураХранения1С.Вставить("СвойствоИдентификатор",			СвойствоИдентификатор);
	СтруктураХранения1С.Вставить("СвойствоСтатус",					СвойствоСтатус);
	СтруктураХранения1С.Вставить("СвойствоИдентификаторУчастника",	СвойствоИдентификаторУчастника);
	СтруктураХранения1С.Вставить("НаименованиеРегистра",			Настройка.Путь);
	
	Возврат СтруктураХранения1С;
	
КонецФункции

// Функция определяет необходимость обновить настройки в зависимости от настроек, записанных ранее
&НаКлиенте
Функция ОбновитьНастройки() 
	
	Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	// Если сохранненые настройки прошлой версии, то загружаем новые настройки
	Если Интеграция.ВерсияНастроек <> ВерсияНастроекОбработки Тогда
		// Обновляем версию настроек
		Интеграция.ВерсияНастроек = ВерсияНастроекОбработки;
		СохранитьИнтеграциюНаСервере(Интеграция);  		
		Возврат Истина;
	Иначе
		Возврат Ложь;	
	КонецЕсли;
	
КонецФункции

// Функция получает параметры интеграции из хранилища общих настроек
// Параметры интеграции хранятся относительно текущего пользователя
&НаСервереБезКонтекста
Функция ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	СписокЗначений = ХранилищеОбщихНастроек.ПолучитьСписок("ОФД_ЭДО_НастройкиОбработки", ПолучитьТекущегоПользователя());
	Интеграция = СписокЗначений.НайтиПоЗначению("Интеграция");
	
	// Информация об интеграции уже есть в хранилище значений 
	Если ТипЗнч(Интеграция) = Тип("ЭлементСпискаЗначений") Тогда
		
		Возврат ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", 	// Ключ объекта
		"Интеграция",															// Ключ настройки 
		"Информация о способе интеграции обработки ОФД ЭДО.", 					// описание настройки
		ПолучитьТекущегоПользователя()); 										// Пользователь
		
	Иначе 
		// Это первый запуск, возвращаем пустую структуру
		Интеграция = Новый Структура;
		Интеграция.Вставить("СпособИнтеграции", 1);
		Интеграция.Вставить("КаталогОбмена");
		Интеграция.Вставить("ИспользоватьКриптографию", Ложь);
		Интеграция.Вставить("ИнтерактивноОбновлятьСтатусыДО", Ложь);
		Интеграция.Вставить("ПараметрыАвторизацииИПодписания", Новый Соответствие);
		Интеграция.Вставить("ВерсияНастроек", ВерсияНастроекОбработки);
		Интеграция.Вставить("МассоваяВыгрузка", Новый Структура);
		Интеграция.Вставить("ЭтоПервыйЗапуск", Истина);
		
		Возврат Интеграция;
		
	КонецЕсли; 	
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

// Функция сохраняет параметры интеграции в хранилище общих настроек
// Параметры интеграции хранятся относительно текущего пользователя
&НаСервереБезКонтекста
Процедура СохранитьИнтеграциюНаСервере(Интеграция) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", 	// Ключ объекта
	"Интеграция",													// Ключ настройки 
	Интеграция,														// Настройка
	"Информация о способе интеграции обработки ОФД ЭДО.", 			// описание настройки
	ПолучитьТекущегоПользователя()); 								// Пользователь     
	
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры   

&НаСервере
Функция ПолучитьИдентификаторУчастникаЭДО(Участник, ХранениеИнформации1С)
	
	ИнтеграцияКаталог = ?(ЭтаФорма.СпособИнтеграции = 1, Истина, Ложь); 
	
	МодульОбъекта = РеквизитФормыВЗначение("Объект");
	Возврат МодульОбъекта.ПолучитьИдентификаторЭДОПоСсылке(Участник, МодульОбъекта.ПолучитьОбъектНастройкиПоИмениМетаданных("Конфигурация", ПолучитьИзВременногоХранилища(АдресВременногоХранилищаКэш)).ХранениеИнформации1С, ИнтеграцияКаталог); 
	
КонецФункции

&НаСервере
Функция ПолучитьКонтрагентовПоВыделеннымДокументам(МассивДокументов)
	
	МассивКонтрагентов = Новый Массив;
	Для Каждого Элемент из МассивДокументов Цикл
		Структура = Новый Структура; 		
		Структура.Вставить("Ссылка",		Элемент.Контрагент);
		Структура.Вставить("ИНН", 			Элемент.Контрагент.ИНН);
		Структура.Вставить("КПП",			Элемент.Контрагент.КПП);
		МассивКонтрагентов.Добавить(Структура);
	КонецЦикла;
	
	Возврат МассивКонтрагентов;
	
КонецФункции	

