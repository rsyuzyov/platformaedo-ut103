				ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "МассивПоИсточнику" Тогда
					ЗаполнитьМассивЭлементаПоИсточнику(ОбъектXDTOЭлементаМассива, ОбъектXDTOЭлементаМассиваПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
				ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Массив" Тогда
					ЗаполнитьМассивЭлемента(ОбъектXDTOЭлементаМассива, ОбъектXDTOЭлементаМассиваПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
				КонецЕсли;
				
			КонецЦикла;
			
			СписокXDTOМассива.Добавить(ОбъектXDTOЭлементаМассива);
			
		КонецЕсли;
		
		#КонецОбласти
		
	ИначеЕсли ТипЗнч(ЭлементРодитель) = Тип("ЭлементDOM") ИЛИ ТипЗнч(ЭлементРодитель) = Тип("ДокументDOM") Тогда
			
		#Область DOM
		
		ДокументDOM = ЭлементРодитель.ДокументВладелец;
		СтруктураЗначениеИВладельцецDOM = ПолучитьЗначениеУзлаИВладельцаПоПути_DOM(ЭлементРодитель, ОбъектXDTOМассиваПоНастройке.ПутьКМассиву);
		
		Если ТипЗнч(ОбъектXDTOМассиваПоНастройке.ЭлементМассива) = Тип("СписокXDTO") Тогда
			
			Для Каждого ЭлементМассива ИЗ ОбъектXDTOМассиваПоНастройке.ЭлементМассива Цикл
				
				Если НЕ ЭлементМассива.Свойства().Получить("УсловияВыгрузкиЭлемента") = Неопределено Тогда	
					УсловиеВыполнено = РезультатОбработкиУсловия(ЭлементМассива, ПараметрыФормирования);
					Если УсловиеВыполнено = Ложь Тогда
						Продолжить;
					КонецЕсли;	
				КонецЕсли;
				
				ЭлементМассиваDOM = ДокументDOM.СоздатьЭлемент(ОбъектXDTOМассиваПоНастройке.Имя);
				
				//ОбъектXDTOЭлементаМассива = ПолучитьОбъектXDTO(Фабрика, ЭлементРодитель.Тип(), ОбъектXDTOМассиваПоНастройке.Имя);
					
				Для Каждого СвойствоXDTOЭлементаМассиваПоНастройке из ЭлементМассива.Свойства() Цикл
					
					Если СвойствоXDTOЭлементаМассиваПоНастройке.Форма = ФормаXML.Атрибут ИЛИ СвойствоXDTOЭлементаМассиваПоНастройке.Имя = "ИсточникДанныхДляМассива" ИЛИ НЕ СтрНайти(СвойствоXDTOЭлементаМассиваПоНастройке.Имя, "Условия") = 0 Тогда
						Продолжить;	
					КонецЕсли;
					
					Если СвойствоXDTOЭлементаМассиваПоНастройке.Имя = "УсловияВыгрузкиЭлемента" Тогда
						Продолжить;
					КонецЕсли;
					
					ОбъектXDTOЭлементаМассиваПоНастройке = ЭлементМассива[СвойствоXDTOЭлементаМассиваПоНастройке.Имя]; 
					
					Если ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Атрибут" Тогда
						ЗаполнитьАтрибутЭлемента(ЭлементМассиваDOM, ОбъектXDTOЭлементаМассиваПоНастройке, ПараметрыФормирования);
					ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Элемент" Тогда
						ОбработатьВложенныйЭлемент(ЭлементМассиваDOM, ОбъектXDTOЭлементаМассиваПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
					ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Текст" Тогда
						ЗаполнитьТекстЭлемента(ЭлементМассиваDOM, ОбъектXDTOЭлементаМассиваПоНастройке, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);	
					ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "МассивПоИсточнику" Тогда
						ЗаполнитьМассивЭлементаПоИсточнику(ЭлементМассиваDOM, ОбъектXDTOЭлементаМассиваПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
					ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Массив" Тогда
						ЗаполнитьМассивЭлемента(ЭлементМассиваDOM, ОбъектXDTOЭлементаМассиваПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
					КонецЕсли;
					
				КонецЦикла;
				
				СтруктураЗначениеИВладельцецDOM.Владелец.ДобавитьДочерний(ЭлементМассиваDOM);	
				
			КонецЦикла;
			
		ИначеЕсли ТипЗнч(ОбъектXDTOМассиваПоНастройке.ЭлементМассива) = Тип("ОбъектXDTO") Тогда
			
			ЭлементМассива = ОбъектXDTOМассиваПоНастройке.ЭлементМассива;
			
			Если НЕ ЭлементМассива.Свойства().Получить("УсловияВыгрузкиЭлемента") = Неопределено Тогда	
				УсловиеВыполнено = РезультатОбработкиУсловия(ЭлементМассива, ПараметрыФормирования);
				Если УсловиеВыполнено = Ложь Тогда
					Возврат;
				КонецЕсли;	
			КонецЕсли;	 
			
			ЭлементМассиваDOM = ДокументDOM.СоздатьЭлемент(ОбъектXDTOМассиваПоНастройке.Имя);
			
			//ОбъектXDTOЭлементаМассива = ПолучитьОбъектXDTO(Фабрика, ЭлементРодитель.Тип(), ОбъектXDTOМассиваПоНастройке.Имя);
			
			Для Каждого СвойствоXDTOЭлементаМассиваПоНастройке из ЭлементМассива.Свойства() Цикл
				
				Если СвойствоXDTOЭлементаМассиваПоНастройке.Форма = ФормаXML.Атрибут ИЛИ СвойствоXDTOЭлементаМассиваПоНастройке.Имя = "ИсточникДанныхДляМассива" Тогда
					Продолжить;	
				КонецЕсли;
				
				Если СвойствоXDTOЭлементаМассиваПоНастройке.Имя = "УсловияВыгрузкиЭлемента" Тогда
					Продолжить;
				КонецЕсли; 
				
				ОбъектXDTOЭлементаМассиваПоНастройке = ЭлементМассива[СвойствоXDTOЭлементаМассиваПоНастройке.Имя];
				
				Если ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Атрибут" Тогда
					ЗаполнитьАтрибутЭлемента(ЭлементМассиваDOM, ОбъектXDTOЭлементаМассиваПоНастройке, ПараметрыФормирования);
				ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Элемент" Тогда
					ОбработатьВложенныйЭлемент(ЭлементМассиваDOM, ОбъектXDTOЭлементаМассиваПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
				ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Текст" Тогда
					ЗаполнитьТекстЭлемента(ЭлементМассиваDOM, ОбъектXDTOЭлементаМассиваПоНастройке, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);	
				ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "МассивПоИсточнику" Тогда
					ЗаполнитьМассивЭлементаПоИсточнику(ЭлементМассиваDOM, ОбъектXDTOЭлементаМассиваПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
				ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Массив" Тогда
					ЗаполнитьМассивЭлемента(ЭлементМассиваDOM, ОбъектXDTOЭлементаМассиваПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
				КонецЕсли;
				
			КонецЦикла;
			
			СтруктураЗначениеИВладельцецDOM.Владелец.ДобавитьДочерний(ЭлементМассиваDOM);
			
		КонецЕсли;
		
		#КонецОбласти
				
	КонецЕсли;
	
КонецПроцедуры
                                  
Функция РезультатОбработкиУсловия(ОбъектXDTOПоНастройке, ПараметрыФормирования)
	
	Если НЕ ОбъектXDTOПоНастройке.Свойства().Получить("УсловияОтменыВыгрузки") = Неопределено Тогда 
		Условия = ОбъектXDTOПоНастройке.УсловияОтменыВыгрузки;
	ИначеЕсли НЕ ОбъектXDTOПоНастройке.Свойства().Получить("УсловияВыгрузкиУзла") = Неопределено Тогда 
		Условия = ОбъектXDTOПоНастройке.УсловияВыгрузкиУзла;  
	ИначеЕсли НЕ ОбъектXDTOПоНастройке.Свойства().Получить("УсловияВыбораВарианта") = Неопределено Тогда
		Условия = ОбъектXDTOПоНастройке.УсловияВыбораВарианта;	
	ИначеЕсли НЕ ОбъектXDTOПоНастройке.Свойства().Получить("УсловияВызоваПроцедуры") = Неопределено Тогда
		Условия = ОбъектXDTOПоНастройке.УсловияВызоваПроцедуры;
	ИначеЕсли НЕ ОбъектXDTOПоНастройке.Свойства().Получить("УсловияВыгрузкиЭлемента") = Неопределено Тогда	
		Условия = ОбъектXDTOПоНастройке.УсловияВыгрузкиЭлемента;	                                      
	ИначеЕсли НЕ ОбъектXDTOПоНастройке.Свойства().Получить("УсловияРедактированияУзла") = Неопределено Тогда
		Условия = ОбъектXDTOПоНастройке.УсловияРедактированияУзла;
	ИначеЕсли НЕ ОбъектXDTOПоНастройке.Свойства().Получить("УсловияУдаленияЭлемента") = Неопределено Тогда
		Условия = ОбъектXDTOПоНастройке.УсловияУдаленияЭлемента;
	ИначеЕсли НЕ ОбъектXDTOПоНастройке.Свойства().Получить("УсловияДобавленияЭлемента") = Неопределено Тогда
		Условия = ОбъектXDTOПоНастройке.УсловияДобавленияЭлемента;	
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Условия.Условие) = Тип("СписокXDTO") Тогда
		
		Для Каждого Условие из Условия.Условие Цикл
			
			ЗначениеУсловия		= РассчитатьЗначениеПоМетодуРасчета(Условие, ПараметрыФормирования);	
			ПризнакСравнения	= РассчитатьЗначениеПоМетодуРасчета(Условие.ПризнакСравнения, ПараметрыФормирования);
			Если НЕ Условие.Свойства().Получить("СравнениеНЕ") = Неопределено И Условие.СравнениеНЕ = "Истина" Тогда
				// Если совпадают - не выгружаем.
				Если ЗначениеУсловия = ПризнакСравнения Тогда
					Возврат Ложь;	
				КонецЕсли;	
			Иначе
				// Если НЕ совпадают - не выгружаем.
				Если НЕ ЗначениеУсловия = ПризнакСравнения Тогда
					Возврат Ложь;	
				КонецЕсли;
			КонецЕсли;	
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Условия.Условие) = Тип("ОбъектXDTO") Тогда
		
		Условие = Условия.Условие;
		
		ЗначениеУсловия		= РассчитатьЗначениеПоМетодуРасчета(Условие, ПараметрыФормирования);	
		ПризнакСравнения	= РассчитатьЗначениеПоМетодуРасчета(Условие.ПризнакСравнения, ПараметрыФормирования);
		Если НЕ Условие.Свойства().Получить("СравнениеНЕ") = Неопределено И Условие.СравнениеНЕ = "Истина" Тогда
			// Если совпадают - не выгружаем.
			Если ЗначениеУсловия = ПризнакСравнения Тогда
				Возврат Ложь;	
			КонецЕсли;	
		Иначе
			// Если совпадают - выгружаем.
			Если НЕ ЗначениеУсловия = ПризнакСравнения Тогда
				Возврат Ложь;	
			КонецЕсли;
		КонецЕсли;	
				
	КонецЕсли;	
	
	Возврат Истина;
		
КонецФункции	

// Функция заполняет данными сторону документооборота
Функция ЗаполнитьСторонуДокументооборота(ПараметрыЗаполнения, ПараметрыФормирования)

	Это5_03 = Ложь;
	
	ДанныеСтороны 					= ПараметрыЗаполнения.ДанныеСтороны;
	ЭтоГрузоОтправительПолучатель	= ПараметрыЗаполнения.ЭтоГрузоОтправительПолучатель;
	ИмяЭлементаВладельцаУчастника	= ПараметрыЗаполнения.ИмяЭлементаВладельцаУчастника;
	ИмяЭлементаУчастника 			= ПараметрыЗаполнения.ИмяЭлементаУчастника;
	XSDТипУчастника 				= ПараметрыЗаполнения.XSDТипУчастника;
	Фабрика							= ПараметрыФормирования.Фабрика;
	ФорматВыгрузки					= ПараметрыФормирования.ФорматВыгрузки;
	ОсновныеДанныеДокумента 		= ПараметрыФормирования.ОсновныеДанныеДокумента;
	ФайлОбъектXDTO					= ПараметрыФормирования.КорневойЭлементЭД;
	Документ 						= ОсновныеДанныеДокумента.ДанныеПоШапке.Ссылка;
	
	Если ПараметрыЗаполнения.Свойство("Это5_03") Тогда
		Это5_03 = ПараметрыЗаполнения.Это5_03; 
	КонецЕсли;	
	
	ДокументОбъектXDTO = ПолучитьОбъектXDTO(Фабрика, ФайлОбъектXDTO.Тип(), "Документ");
	СвСчФактОбъектXDTO = ПолучитьОбъектXDTO(Фабрика, ДокументОбъектXDTO.Тип(), ИмяЭлементаВладельцаУчастника);
	
	Сторона 	= ПолучитьКомплексныйОбъектXDTO(Фабрика, ФорматВыгрузки, XSDТипУчастника);	
	ИдСв 		= ПолучитьОбъектXDTO(Фабрика, Сторона.Тип(), "ИдСв");
	БанкРекв	= Неопределено;
	Контакт 	= Неопределено;	
	ЮрФизЛицо	= ?(СтрДлина(ДанныеСтороны.ИНН) = 10, "ЮЛ", "ИП");    
	
	ИНН					= ДанныеСтороны.ИНН;
	КПП					= ДанныеСтороны.КПП;
	Если ДанныеСтороны.Свойство("ОфициальноеНаименование") Тогда
		ОфициальноеНаименование = ДанныеСтороны.ОфициальноеНаименование;
	Иначе
		ОфициальноеНаименование = "";
	КонецЕсли;     	
	ПолноеНаименование	= ДанныеСтороны.ПолноеНаименование;
	НомерСчета			= ДанныеСтороны.НомерСчета;
	Если НЕ ДанныеСтороны.Банк = Неопределено И ТипЗнч(ДанныеСтороны.Банк) = Тип("Строка") Тогда
		Банк	= ДанныеСтороны.Банк;
	Иначе	
		Банк	= ?(ЗначениеЗаполнено(ДанныеСтороны.Банк), ДанныеСтороны.Банк.Наименование, "");
	КонецЕсли;
	БИК					= ДанныеСтороны.БИК;
	КоррСчет			= ДанныеСтороны.КоррСчет;
	ЮридическийАдрес	= ДанныеСтороны.ЮридическийАдрес;
	ФактическийАдрес	= ДанныеСтороны.ФактическийАдрес;
	Телефоны			= ДанныеСтороны.Телефоны;
	
// ИдСв -------------------------------------------------------------------------------------------------------------
	// СвЮЛУч
	Если ЮрФизЛицо = "ЮЛ" Тогда
		СвЮЛУч = ПолучитьОбъектXDTO(Фабрика, ИдСв.Тип(), "СвЮЛУч");
		ЗаполнитьОбязательныйЭлемент_XDTO(СвЮЛУч.ИННЮЛ, ИНН, Строка(Документ) + ". ИНН участника ЭДО " + ПолноеНаименование);
		ЗаполнитьОбязательныйЭлемент_XDTO(СвЮЛУч.КПП, КПП, Строка(Документ) + ". КПП участника ЭДО " + ПолноеНаименование);
		ЗаполнитьОбязательныйЭлемент_XDTO(СвЮЛУч.НаимОрг,    ?(ЗначениеЗаполнено(ОфициальноеНаименование), ОфициальноеНаименование, ПолноеНаименование), Строка(Документ) + ". Наименование участника ЭДО " + ПолноеНаименование); 
		ИдСв.СвЮЛУч = СвЮЛУч;
	КонецЕсли;
	
	// СвИПТип
	Если ЮрФизЛицо = "ИП" Тогда
		СвИП = ПолучитьКомплексныйОбъектXDTO(Фабрика, ФорматВыгрузки, "СвИПТип");
		ЗаполнитьОбязательныйЭлемент_XDTO(СвИП.ИННФЛ, ИНН, Строка(Документ) + ". ИНН участника ЭДО " + ПолноеНаименование);
		
		ФИО = ПолучитьКомплексныйОбъектXDTO(Фабрика, ФорматВыгрузки, "ФИОТип"); 
		ФИО	= ПолучитьФИОИзСтроки(ФИО, ?(ЗначениеЗаполнено(ОфициальноеНаименование), ОфициальноеНаименование, ПолноеНаименование));  	

		СвИП.ФИО = ФИО;
		ИдСв.СвИП = СвИП; 
	КонецЕсли;
// ИдСв -------------------------------------------------------------------------------------------------------------

//БанкРекв ----------------------------------------------------------------------------------------------------------  
	Если ЗначениеЗаполнено(НомерСчета) ИЛИ ЗначениеЗаполнено(БИК) ИЛИ ЗначениеЗаполнено(КоррСчет) ИЛИ ЗначениеЗаполнено(Банк) Тогда
			
		БанкРекв = ПолучитьОбъектXDTO(Фабрика, Сторона.Тип(), "БанкРекв");
    	
		ЗаполнитьНеобязательныйЭлемент_XDTO(БанкРекв.НомерСчета, НомерСчета);
		
		СвБанк = ПолучитьОбъектXDTO(Фабрика, БанкРекв.Тип(), "СвБанк");
    	
		ЗаполнитьНеобязательныйЭлемент_XDTO(СвБанк.БИК, БИК);
		ЗаполнитьНеобязательныйЭлемент_XDTO(СвБанк.КорСчет, КоррСчет);
		ЗаполнитьНеобязательныйЭлемент_XDTO(СвБанк.НаимБанк, Банк);
		
		БанкРекв.СвБанк = СвБанк; 
		
	КонецЕсли; 	
//БанкРекв ----------------------------------------------------------------------------------------------------------

//АдрИнфТип ---------------------------------------------------------------------------------------------------------
	Адрес		= ПолучитьКомплексныйОбъектXDTO(Фабрика, ФорматВыгрузки, "АдресТип");
	АдрИнф		= ПолучитьКомплексныйОбъектXDTO(Фабрика, ФорматВыгрузки, "АдрИнфТип");
	
	Если НЕ ЭтоГрузоОтправительПолучатель Тогда 
		ЗаполнитьОбязательныйЭлемент_XDTO(АдрИнф.АдрТекст, ЮридическийАдрес, Строка(Документ) + "Юридический адрес участника ЭДО " + ПолноеНаименование);
	Иначе
		ЗаполнитьОбязательныйЭлемент_XDTO(АдрИнф.АдрТекст, ?(ЗначениеЗаполнено(ФактическийАдрес), ФактическийАдрес, ЮридическийАдрес), Строка(Документ) + "Фактический или юридический адрес участника ЭДО " + ПолноеНаименование);
	КонецЕсли;
	АдрИнф.КодСтр = "643";	// пока всегда Россия
	
	Если Это5_03 = Истина Тогда
		АдрИнф.НаимСтран = "РОССИЯ"; // пока всегда Россия
	КонецЕсли;	
	
	Адрес.АдрИнф = АдрИнф; 
//АдрИнфТип ---------------------------------------------------------------------------------------------------------

	Если ЗначениеЗаполнено(Телефоны) Тогда
		Контакт = ПолучитьКомплексныйОбъектXDTO(Фабрика, ФорматВыгрузки, "КонтактТип");
		Если Это5_03 = Истина Тогда
			Контакт.Тлф.Добавить(Телефоны);
		Иначе	
			ЗаполнитьНеобязательныйЭлемент_XDTO(Контакт.Тлф, Телефоны);
		КонецЕсли;
	КонецЕсли;
	
	Сторона.ИдСв 		= ИдСв; 
	Сторона.Адрес		= Адрес;
	Если НЕ БанкРекв = Неопределено Тогда 
		Сторона.БанкРекв = БанкРекв;
	КонецЕсли;
	Если НЕ Контакт = Неопределено Тогда
		Сторона.Контакт = Контакт;
	КонецЕсли;
	
	Если ИмяЭлементаУчастника = "ГрузОт" И ФайлОбъектXDTO.Документ[ИмяЭлементаВладельцаУчастника][ИмяЭлементаУчастника].ВладеющееСвойство.Имя = "ГрузОт" Тогда
		ГрузОт = ПолучитьОбъектXDTO(Фабрика, СвСчФактОбъектXDTO.Тип(), "ГрузОт");
		ГрузОт.ГрузОтпр	= Сторона;
		Если ТипЗнч(ФайлОбъектXDTO.Документ[ИмяЭлементаВладельцаУчастника][ИмяЭлементаУчастника]) = Тип("СписокXDTO") Тогда 
			ФайлОбъектXDTO.Документ[ИмяЭлементаВладельцаУчастника][ИмяЭлементаУчастника].Добавить(ГрузОт);
		Иначе 
        	ФайлОбъектXDTO.Документ[ИмяЭлементаВладельцаУчастника][ИмяЭлементаУчастника] = Сторона;	
		КонецЕсли;	
	Иначе
		Если ТипЗнч(ФайлОбъектXDTO.Документ[ИмяЭлементаВладельцаУчастника][ИмяЭлементаУчастника]) = Тип("СписокXDTO") Тогда 
			ФайлОбъектXDTO.Документ[ИмяЭлементаВладельцаУчастника][ИмяЭлементаУчастника].Добавить(Сторона); 
		Иначе 
			ФайлОбъектXDTO.Документ[ИмяЭлементаВладельцаУчастника][ИмяЭлементаУчастника] = Сторона;
		КонецЕсли;	
	КонецЕсли;	
		
КонецФункции

Процедура ЗаполнитьПодписантов(ПараметрыЗаполнения, ПараметрыФормирования)
	
	Это5_03 = Ложь;
	
	ИННОрганизации			= ПараметрыЗаполнения.ИННОрганизации;
	Доверенность			= ПараметрыЗаполнения.Доверенность;
	НаименованиеОрганизации	= ПараметрыЗаполнения.НаименованиеОрганизации;
	ПрефиксКонфигурации		= ПараметрыЗаполнения.ПрефиксКонфигурации;
	ОбластьПолномочий		= ?(ПараметрыЗаполнения.Свойство("ОбластьПолномочий"), ПараметрыЗаполнения.ОбластьПолномочий, Неопределено);
	СтатусПодписанта		= ?(ПараметрыЗаполнения.Свойство("СтатусПодписанта"), ПараметрыЗаполнения.СтатусПодписанта, Неопределено);
	Фабрика					= ПараметрыФормирования.Фабрика;
	ФорматВыгрузки			= ПараметрыФормирования.ФорматВыгрузки;
	ОсновныеДанныеДокумента = ПараметрыФормирования.ОсновныеДанныеДокумента;
	ДополнительныеПараметры	= ПараметрыФормирования.ДополнительныеПараметры;
	ДокументОбъектXDTO		= ПараметрыФормирования.КорневойЭлементЭД.Документ;
	
	Если ПараметрыЗаполнения.Свойство("Это5_03") Тогда
		Это5_03 = ПараметрыЗаполнения.Это5_03; 
	КонецЕсли;
	
	ПараметрыАвторизацииИПодписания = ДополнительныеПараметры.ПараметрыАвторизацииИПодписания; 
	
	ЮрФизЛицоИППодписант = Неопределено;
	СубъектПодписант = Неопределено;	
	Если НЕ ПараметрыАвторизацииИПодписания = Неопределено Тогда
		Если ПараметрыАвторизацииИПодписания.Свойство("ПараметрыПодписания") Тогда
			Если ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("ТипСубъекта") Тогда
				ЮрФизЛицоИППодписант = ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ТипСубъекта;
			КонецЕсли;
			Если ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("Субъект") Тогда
				СубъектПодписант = ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Субъект;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
		
	ДанныеПодписанта = Неопределено;

	Подписант = ПолучитьОбъектXDTO(Фабрика, ДокументОбъектXDTO.Тип(), "Подписант");
	
	Если ЮрФизЛицоИППодписант = Неопределено Тогда
		ЮрФизЛицоИППодписант = ?(СтрДлина(ИННОрганизации) = 10, "ЮЛ", "ИП");
	КонецЕсли;	
	
	ПодписьСоответствуетОрганизации = Ложь;
	
	Если НЕ СубъектПодписант = Неопределено Тогда
		// Были переданы данные о подписанте из ЭЦП.
		ЭЦП_ИНН = "";
		Если СубъектПодписант.Свойство("OID1_2_643_100_4") Тогда
			ЭЦП_ИНН = СубъектПодписант.OID1_2_643_100_4;
		ИначеЕсли СубъектПодписант.Свойство("OID1_2_643_3_131_1_1") Тогда
			ЭЦП_ИНН = СубъектПодписант.OID1_2_643_3_131_1_1;
		ИначеЕсли СубъектПодписант.Свойство("INNLE") Тогда
			ЭЦП_ИНН = СубъектПодписант.INNLE;
		ИначеЕсли СубъектПодписант.Свойство("ИННЮЛ") Тогда
			ЭЦП_ИНН = СубъектПодписант.ИННЮЛ;
		ИначеЕсли СубъектПодписант.Свойство("ИНН_ЮЛ") Тогда
			ЭЦП_ИНН = СубъектПодписант.ИНН_ЮЛ;
		ИначеЕсли СубъектПодписант.Свойство("ИНН") Тогда
			ЭЦП_ИНН = СубъектПодписант.ИНН;
		ИначеЕсли СубъектПодписант.Свойство("ИННОрганизации") Тогда
			ЭЦП_ИНН = СубъектПодписант.ИННОрганизации;
		ИначеЕсли СубъектПодписант.Свойство("ИНН_Организации") Тогда
			ЭЦП_ИНН = СубъектПодписант.ИНН_Организации;	
		КонецЕсли;
		Если НЕ ЮрФизЛицоИППодписант = "ФЛ" Тогда
			Если ЭЦП_ИНН = "" Тогда
				ПодписьСоответствуетОрганизации = Ложь;
			Иначе	
				ПодписьСоответствуетОрганизации = СтрНайти(ЭЦП_ИНН, ИННОрганизации) <> 0;
			КонецЕсли;
		Иначе
			ПодписьСоответствуетОрганизации = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ СубъектПодписант = Неопределено И НЕ ПодписьСоответствуетОрганизации И НЕ ЮрФизЛицоИППодписант = "ФЛ" Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Внимание! Приложенная подпись не принадлежит организации, указанной в документе!"+Символы.ПС+"Проверьте корректность подписи!"
			+Символы.ПС+"Данные о подписанте будут заполнены в соответствии с данными об руководителе организации из 1С.";
		Сообщение.Сообщить();
	КонецЕсли;	
	
	Если ПодписьСоответствуетОрганизации И НЕ ЮрФизЛицоИППодписант = "ФЛ" Тогда
		
		// Были переданы данные о подписанте из ЭЦП.
		ДанныеПодписанта = Новый Структура;	
		ДанныеПодписанта.Вставить("Фамилия", СокрЛП(СубъектПодписант.OID2_5_4_4));
		ДанныеПодписанта.Вставить("Имя", СокрЛП(Лев(СубъектПодписант.OID2_5_4_42, СтрНайти(СубъектПодписант.OID2_5_4_42, " "))));
		ДанныеПодписанта.Вставить("Отчество", СокрЛП(Прав(СубъектПодписант.OID2_5_4_42, СтрДлина(СубъектПодписант.OID2_5_4_42) - СтрНайти(СубъектПодписант.OID2_5_4_42, " "))));
		Если ЮрФизЛицоИППодписант = "ЮЛ" И НЕ СубъектПодписант.Свойство("T") Тогда
			ДанныеПодписанта = Неопределено;
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Внимание! В прилагаемой подписи отсутствует обязательная информация о должности подписанта!"+Символы.ПС+"Проверьте корректность подписи!";
			Сообщение.Сообщить();
		Иначе	
			ДанныеПодписанта.Вставить("Должность", ?(ЮрФизЛицоИППодписант = "ЮЛ", СокрЛП(СубъектПодписант.T), ""));
		КонецЕсли;
		ДанныеПодписанта.Вставить("ТипПодпис", "1");
		ДанныеПодписанта.Вставить("СпосПодтПолном", "1");
		
	ИначеЕсли ЮрФизЛицоИППодписант = "ФЛ" Тогда 
		
		МчдGUIDПодписанта = "";
		ДатаНачалаДействияМЧД = "";
		
		// Были переданы данные о подписанте-физлице из ЭЦП.
		ДанныеПодписанта = Новый Структура;	
		ДанныеПодписанта.Вставить("Фамилия", СокрЛП(СубъектПодписант.OID2_5_4_4));
		ДанныеПодписанта.Вставить("Имя", СокрЛП(Лев(СубъектПодписант.OID2_5_4_42, СтрНайти(СубъектПодписант.OID2_5_4_42, " "))));
		ДанныеПодписанта.Вставить("Отчество", СокрЛП(Прав(СубъектПодписант.OID2_5_4_42, СтрДлина(СубъектПодписант.OID2_5_4_42) - СтрНайти(СубъектПодписант.OID2_5_4_42, " "))));
		Если ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("ДолжностьФизлица") Тогда
			Если ЗначениеЗаполнено(ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ДолжностьФизлица) Тогда
				ДанныеПодписанта.Вставить("Должность", ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ДолжностьФизлица);
			Иначе
				ДанныеПодписанта.Вставить("Должность", "Уполномоченное физическое лицо");
			КонецЕсли;	
		Иначе
			ДанныеПодписанта.Вставить("Должность", "Уполномоченное физическое лицо");
		КонецЕсли;
		Если ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("МчдGUID") Тогда
			Если ЗначениеЗаполнено(ПараметрыАвторизацииИПодписания.ПараметрыПодписания.МчдGUID) Тогда
				МчдGUIDПодписанта =  ПараметрыАвторизацииИПодписания.ПараметрыПодписания.МчдGUID;
				ДанныеПодписанта.Вставить("МчдGUIDПодписанта", МчдGUIDПодписанта);
			КонецЕсли;	
		КонецЕсли;
		Если ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("ДатаНачалаДействияМЧД") Тогда
			Если ЗначениеЗаполнено(ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ДатаНачалаДействияМЧД) Тогда
				ДатаНачалаДействияМЧД = ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ДатаНачалаДействияМЧД;
				ДанныеПодписанта.Вставить("ДатаНачалаДействияМЧД", ДатаНачалаДействияМЧД);
			КонецЕсли;	
		КонецЕсли;
		ДанныеПодписанта.Вставить("ТипПодпис", "1");
		ДанныеПодписанта.Вставить("СпосПодтПолном", "4");
		
		ДанныеДоверенностиВведены = Ложь;
		Если ЗначениеЗаполнено(МчдGUIDПодписанта) И ЗначениеЗаполнено(ДатаНачалаДействияМЧД) Тогда
			ДанныеДоверенностиВведены = Истина;
		КонецЕсли;	
		
		Если ДанныеДоверенностиВведены = Ложь Тогда //И ФормированиеДляПредпросмотра = Ложь Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Заполните для подписанта все данные по МЧД.";
			Сообщение.Сообщить();
			Возврат;
		КонецЕсли;	
		
		ДанныеПодписанта.Вставить("МчдGUIDПодписанта", МчдGUIDПодписанта);
		ДанныеПодписанта.Вставить("ДатаНачалаДействияМЧД", ДатаНачалаДействияМЧД);
		
	Иначе	
	
		Если ОсновныеДанныеДокумента.ДанныеПоШапке.Владелец().Колонки.Найти("ПодписантФамилия") = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ОсновныеДанныеДокумента.ДанныеПоШапке.ПодписантФамилия) Тогда
			
			//Попытаемся самостоятельно определить.
			ДанныеПодписанта = ПолучитьФИОРуководителяОрганизацииНаДату_Стандарт(ОсновныеДанныеДокумента.ДанныеПоШапке.Организация, ОсновныеДанныеДокумента.ДанныеПоШапке.Дата, ПрефиксКонфигурации);
				
		Иначе
			
			ДанныеПодписанта = Новый Структура;	
			ДанныеПодписанта.Вставить("Фамилия", ОсновныеДанныеДокумента.ДанныеПоШапке.ПодписантФамилия);
			ДанныеПодписанта.Вставить("Имя", ОсновныеДанныеДокумента.ДанныеПоШапке.ПодписантИмя);
			ДанныеПодписанта.Вставить("Отчество", ОсновныеДанныеДокумента.ДанныеПоШапке.ПодписантОтчество);
			ДанныеПодписанта.Вставить("Должность", ОсновныеДанныеДокумента.ДанныеПоШапке.ПодписантДолжность);
			
		КонецЕсли;
		
		Если Это5_03 = Истина Тогда
			ДанныеПодписанта.Вставить("ТипПодпис", "1");
			ДанныеПодписанта.Вставить("СпосПодтПолном", "1");
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ДанныеПодписанта = Неопределено И НЕ ДанныеПодписанта.Фамилия = "" И НЕ ДанныеПодписанта.Имя = "" Тогда 
		
		Если Это5_03 = Ложь Тогда
			
			#Область Документ_5_01
			
			ФИО = ПолучитьКомплексныйОбъектXDTO(Фабрика, ФорматВыгрузки, "ФИОТип");
			ЗаполнитьОбязательныйЭлемент_XDTO(ФИО.Фамилия, ДанныеПодписанта.Фамилия, "Фамилия подписанта");
			ЗаполнитьОбязательныйЭлемент_XDTO(ФИО.Имя, ДанныеПодписанта.Имя, "Имя подписанта");
			ЗаполнитьНеОбязательныйЭлемент_XDTO(ФИО.Отчество, ДанныеПодписанта.Отчество);
			
			Если НЕ ОбластьПолномочий = Неопределено Тогда
				Подписант.ОблПолн  = ОбластьПолномочий;
			Иначе	
				Подписант.ОблПолн  = "5";  //Принимает значения:
				//0 - лицо, ответственное за подписание счетов-фактур |
				//1 - лицо, совершившее сделку, операцию |
				//2 - лицо, совершившее сделку, операцию и ответственное за ее оформление |
				//3 - лицо, ответственное за оформление свершившегося события |
				//4 - лицо, совершившее сделку, операцию и ответственное за подписание счетов-фактур |
				//5 - лицо, совершившее сделку, операцию и ответственное за ее оформление и за подписание счетов-фактур |
				//6 - лицо, ответственное за оформление свершившегося события и за подписание счетов-фактур
			КонецЕсли;
			
			Если НЕ ЮрФизЛицоИППодписант = "ФЛ" Тогда
				Если НЕ СтатусПодписанта = Неопределено Тогда
					Подписант.Статус  = СтатусПодписанта;
				Иначе
					Подписант.Статус = "1"; //Принимает значение:
					//1 - работник организации продавца товаров (работ, услуг, имущественных прав) |
					//2 - работник организации - составителя файла обмена информации продавца, если составитель файла обмена информации не является продавцом |
					//3 - работник иной уполномоченной организации |
					//4 - уполномоченное физическое лицо (в том числе индивидуальный предприниматель)
				КонецЕсли;
			Иначе
				Подписант.Статус = "1";
			КонецЕсли;
			
			Если НЕ ЮрФизЛицоИППодписант = "ФЛ" Тогда
				ЗаполнитьОбязательныйЭлемент_XDTO(Подписант.ОснПолн, ?(ЗначениеЗаполнено(Доверенность), Доверенность, "Должностные обязанности"), "Доверенность подписанта");
			Иначе
				ЗаполнитьОбязательныйЭлемент_XDTO(Подписант.ОснПолн, "Доверенность подписанта", "Доверенность подписанта");
			КонецЕсли;	
				
			Если ЮрФизЛицоИППодписант = "ЮЛ" Тогда
				
				ЮЛ = ПолучитьОбъектXDTO(Фабрика, Подписант.Тип(), "ЮЛ");
				ЮЛ.ФИО = ФИО;
				//ЗаполнитьОбязательныйЭлемент(ЮЛ.ФИО, ФИО, "ФИО руководителя отправителя в подписанте");
				ЗаполнитьОбязательныйЭлемент_XDTO(ЮЛ.Должн, ДанныеПодписанта.Должность, "Должность руководителя отправителя в подписанте");
				ЗаполнитьОбязательныйЭлемент_XDTO(ЮЛ.ИННЮЛ, ИННОрганизации, "ИНН Отправителя");
				// Надо придумать как заполнять лучше, скорее всего в рамках добавления подписания в 1С
				ЗаполнитьОбязательныйЭлемент_XDTO(ЮЛ.НаимОрг, НаименованиеОрганизации, "Наименование отправителя");
				
				Подписант.ЮЛ = ЮЛ;
				
			ИначеЕсли ЮрФизЛицоИППодписант = "ИП" Тогда
				
				ИП = ПолучитьКомплексныйОбъектXDTO(Фабрика, ФорматВыгрузки, "СвИПТип");
				Если ТипЗнч(ФИО) = Тип("ОбъектXDTO") Тогда 
					ИП.ФИО = ФИО;
				Иначе	
					ЗаполнитьОбязательныйЭлемент_XDTO(ИП.ФИО, ФИО, "ФИО руководителя отправителя в подписанте");
				КонецЕсли;	
				//ЗаполнитьОбязательныйЭлемент(ИП.НаимОрг, Шапка.Организация.НаименованиеПолное, "Наименование отправителя");
				ЗаполнитьОбязательныйЭлемент_XDTO(ИП.ИННФЛ, ИННОрганизации, "ИНН Отправителя");

				Подписант.ИП = ИП;
				
			ИначеЕсли ЮрФизЛицоИППодписант = "ФЛ" Тогда
				
				////ФЛ = ПолучитьКомплексныйОбъектXDTO(Фабрика, Подписант.Тип(), "ФЛ");
				//ФЛ = ПолучитьОбъектXDTO(Фабрика, Подписант.Тип(), "ФЛ");
				//Если ТипЗнч(ФИО) = Тип("ОбъектXDTO") Тогда 
				//	ФЛ.ФИО = ФИО;
				//Иначе	
				//	ЗаполнитьОбязательныйЭлемент_XDTO(ФЛ.ФИО, ФИО, "ФИО руководителя отправителя в подписанте");
				//КонецЕсли;	
				////ЗаполнитьОбязательныйЭлемент(ИП.НаимОрг, Шапка.Организация.НаименованиеПолное, "Наименование отправителя");
				//ЗаполнитьОбязательныйЭлемент_XDTO(ФЛ.ИННФЛ, СубъектПодписант.OID1_2_643_3_131_1_1, "ИНН Отправителя");
				//
				//Подписант.ФЛ = ФЛ;
				
				ЮЛ = ПолучитьОбъектXDTO(Фабрика, Подписант.Тип(), "ЮЛ");
				ЮЛ.ФИО = ФИО;
				//ЗаполнитьОбязательныйЭлемент(ЮЛ.ФИО, ФИО, "ФИО руководителя отправителя в подписанте");
				ЗаполнитьОбязательныйЭлемент_XDTO(ЮЛ.Должн, ДанныеПодписанта.Должность, "Должность уполномоченного физлица в подписанте");
				ЗаполнитьОбязательныйЭлемент_XDTO(ЮЛ.ИННЮЛ, ИННОрганизации, "ИНН Отправителя");
				// Надо придумать как заполнять лучше, скорее всего в рамках добавления подписания в 1С
				ЗаполнитьОбязательныйЭлемент_XDTO(ЮЛ.НаимОрг, НаименованиеОрганизации, "Наименование отправителя");
				
				Подписант.ЮЛ = ЮЛ;
				
			КонецЕсли;
			
			ДокументОбъектXDTO.Подписант.Добавить(Подписант);
			
			#КонецОбласти
		
		ИначеЕсли Это5_03 = Истина Тогда
			
			ФИО = ПолучитьКомплексныйОбъектXDTO(Фабрика, ФорматВыгрузки, "ФИОТип");
			ЗаполнитьОбязательныйЭлемент_XDTO(ФИО.Фамилия, ДанныеПодписанта.Фамилия, "Фамилия подписанта");
			ЗаполнитьОбязательныйЭлемент_XDTO(ФИО.Имя, ДанныеПодписанта.Имя, "Имя подписанта");
			ЗаполнитьНеОбязательныйЭлемент_XDTO(ФИО.Отчество, ДанныеПодписанта.Отчество);
			
			Подписант.ФИО = ФИО;
			ЗаполнитьНеОбязательныйЭлемент_XDTO(Подписант.Должн, ДанныеПодписанта.Должность);
			ЗаполнитьНеОбязательныйЭлемент_XDTO(Подписант.ТипПодпис, ДанныеПодписанта.ТипПодпис);
			ЗаполнитьНеОбязательныйЭлемент_XDTO(Подписант.СпосПодтПолном, ДанныеПодписанта.СпосПодтПолном);
			
			ДокументОбъектXDTO.Подписант.Добавить(Подписант);
			
		КонецЕсли;
		
	Иначе
		
		//Сообщение = Новый СообщениеПользователю();
		//Сообщение.Текст = "Заполните руководителя для организации: " + Строка(Шапка[Настройка.Документ.Отправитель.Путь]);
		//Сообщение.Сообщить();
		
	КонецЕсли;	
	
КонецПроцедуры	

// Функция заполняет узел об идентификаторах участников ЭДО 
Процедура ЗаполнитьИдентификаторыУчастниковЭДО(ПараметрыЗаполнения, ПараметрыФормирования)
	 
	Интеграция = ПолучитьИнтеграциюНаСервере();
	ИнтеграцияКаталог = Интеграция.СпособИнтеграции = 1;
	
	Отправитель				= ПараметрыЗаполнения.Организация;
	Получатель				= ПараметрыЗаполнения.Контрагент;
	Фабрика					= ПараметрыФормирования.Фабрика;
	ОсновныеДанныеДокумента = ПараметрыФормирования.ОсновныеДанныеДокумента;
	Файл					= ПараметрыФормирования.КорневойЭлементЭД;
	Кэш						= ПараметрыФормирования.ДополнительныеПараметры.Кэш;  
	
	Конфигурация = ПолучитьОбъектНастройкиПоИмениМетаданных("Конфигурация", Кэш);
	
	СвУчДокОбор	= ПолучитьОбъектXDTO(Фабрика, Файл.Тип(), "СвУчДокОбор");
	СвОЭДОтпр	= ПолучитьОбъектXDTO(Фабрика, СвУчДокОбор.Тип(), "СвОЭДОтпр");
	
	// Сведения об операторе связи ЭДО
	СвОЭДОтпр.ИННЮЛ		= "9715260691";
	
	Если ЭтоТестоваяОбработка Тогда
		// Тестовый
		СвОЭДОтпр.ИдЭДО 	= "2VO";  
	Иначе	
		// Бой
		СвОЭДОтпр.ИдЭДО 	= "2VO";
	КонецЕсли;
	
	СвОЭДОтпр.НаимОрг 	= "ООО &quot;Эвотор ОФД&quot;";
	
	СвУчДокОбор.СвОЭДОтпр = СвОЭДОтпр;
	
	ИдОтправителя = ПолучитьИдентификаторЭДОПоСсылке(Отправитель, Конфигурация.ХранениеИнформации1С, ИнтеграцияКаталог);
	ИдПолучателя = ПолучитьИдентификаторЭДОПоСсылке(Получатель, Конфигурация.ХранениеИнформации1С, ИнтеграцияКаталог);
	
	Если ИдОтправителя = Неопределено ИЛИ ИдПолучателя = Неопределено Тогда
		Если ИдОтправителя = Неопределено Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Не удалось определить идентификатор отправителя "+Отправитель+" в системе ЭДО. Отправка невозможна.";
			Сообщение.Сообщить();
		КонецЕсли;
		Если ИдПолучателя = Неопределено Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Не удалось определить идентификатор получателя "+Получатель+" в системе ЭДО. Отправка невозможна.";
			Сообщение.Сообщить();
		КонецЕсли;
		Возврат;
	КонецЕсли;	
	
	ЗаполнитьОбязательныйЭлемент_XDTO(СвУчДокОбор.ИдОтпр, ИдОтправителя, "Идентификатор ЭДО отправителя");
	ЗаполнитьОбязательныйЭлемент_XDTO(СвУчДокОбор.ИдПол, ИдПолучателя, "Идентификатор ЭДО получателя"); 	
	
	Файл.СвУчДокОбор = СвУчДокОбор;
	
КонецПроцедуры

// Функция составляет имя файла по идентификаторам участников ЭДО
Процедура ЗаполнитьИмяФайлаПоИдентификаторам(ПараметрыЗаполнения, ПараметрыФормирования)
	
	ДокументСодержитМарки	= ПараметрыЗаполнения.ДокументСодержитМарки;
	ИдентификаторДокумента	= ПараметрыЗаполнения.ИдентификаторДокумента;
	ДатаОтправки			= ПараметрыЗаполнения.ДатаОтправки;
	ИдентификаторДокумента	= ПараметрыЗаполнения.ИдентификаторДокумента;
	Фабрика					= ПараметрыФормирования.Фабрика;
	ФорматВыгрузки			= ПараметрыФормирования.ФорматВыгрузки;
	ОсновныеДанныеДокумента = ПараметрыФормирования.ОсновныеДанныеДокумента;
	Файл					= ПараметрыФормирования.КорневойЭлементЭД;
	
	СвУчДокОбор = Файл.СвУчДокОбор;
	
	//ON_NSCHFDOPPOKXXXX, где XXXX
	//это "MARK" - для товаров, подлежащих маркировке
	//это "PROS" - для товаров, подлежащих прослеживаемости
	ИмяФайла = ФорматВыгрузки + ?(ДокументСодержитМарки = Истина, "MARK", "") + "_" + СвУчДокОбор.ИдПол + "_" + СвУчДокОбор.ИдОтпр + "_" + ДатаОтправки + "_" + ИдентификаторДокумента; 
	
	Файл.ИдФайл = ИмяФайла;
	
КонецПроцедуры

Процедура ЗаполнитьИмяФайлаПоИдентификаторам_5_03(ПараметрыЗаполнения, ПараметрыФормирования)
	
	Интеграция = ПолучитьИнтеграциюНаСервере();
	ИнтеграцияКаталог = Интеграция.СпособИнтеграции = 1;
	
	ДокументСодержитДанныеПрослеживаемости = Ложь;

	Отправитель				= ПараметрыЗаполнения.Организация;
	Получатель				= ПараметрыЗаполнения.Контрагент;
	ДокументСодержитМарки	= ПараметрыЗаполнения.ДокументСодержитМарки;
	ИдентификаторДокумента	= ПараметрыЗаполнения.ИдентификаторДокумента;
	ДатаОтправки			= ПараметрыЗаполнения.ДатаОтправки;
	ИдентификаторДокумента	= ПараметрыЗаполнения.ИдентификаторДокумента;
	Фабрика					= ПараметрыФормирования.Фабрика;
	ФорматВыгрузки			= ПараметрыФормирования.ФорматВыгрузки;
	ОсновныеДанныеДокумента = ПараметрыФормирования.ОсновныеДанныеДокумента;
	Файл					= ПараметрыФормирования.КорневойЭлементЭД;
	Кэш						= ПараметрыФормирования.ДополнительныеПараметры.Кэш;
	
	Конфигурация = ПолучитьОбъектНастройкиПоИмениМетаданных("Конфигурация", Кэш);
	
	Если ПараметрыЗаполнения.Свойство("ДокументСодержитДанныеПрослеживаемости") Тогда
		ДокументСодержитДанныеПрослеживаемости = ПараметрыЗаполнения.ДокументСодержитДанныеПрослеживаемости;
	КонецЕсли;
	
	ИдОтправителя = ПолучитьИдентификаторЭДОПоСсылке(Отправитель, Конфигурация.ХранениеИнформации1С, ИнтеграцияКаталог);
	ИдПолучателя = ПолучитьИдентификаторЭДОПоСсылке(Получатель, Конфигурация.ХранениеИнформации1С, ИнтеграцияКаталог);
	
	ИмяФайла = ФорматВыгрузки + "_" + ИдПолучателя + "_" + ИдОтправителя + "_" + ДатаОтправки + "_" + ИдентификаторДокумента + "_"
			+ ?(ДокументСодержитДанныеПрослеживаемости = Истина, 1, 0) + "_" + ?(ДокументСодержитМарки = Истина, 1, 0) +"_0_0_0_00"; 
	
	Файл.ИдФайл = ИмяФайла;
	
КонецПроцедуры

Функция ПоместитьВДокументИдентификаторДоверенностиФизлица_XDTO(СтруктураДанных, ПараметрыАвторизацииИПодписания, ФорматВыгрузки, Кэш, ТипПодписанта = Неопределено)
	
	Если НЕ ТипПодписанта = Неопределено И НЕ ТипПодписанта = "ФЛ" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ФорматВыгрузки = "ON_AKTSVEROTP" Тогда
		Возврат Истина;
	КонецЕсли;	
	
	Если НЕ ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("ТипСубъекта") Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось определить тип подписанта по сертификату."+Символы.ПС+"Проверьте настройки подписания.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ТипСубъекта = "ФЛ" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если НЕ ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("МчдGUID") Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не обнаружен идентификатор доверенности физлица подписанта."+Символы.ПС+"Проверьте настройки подписания.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	Если СокрЛП(ПараметрыАвторизацииИПодписания.ПараметрыПодписания.МчдGUID) = "" Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не заполнен идентификатор доверенности физлица подписанта."+Символы.ПС+"Проверьте настройки подписания.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ СтрДлина(СокрЛП(ПараметрыАвторизацииИПодписания.ПараметрыПодписания.МчдGUID)) = 36 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Идентификатор доверенности физлица подписанта заполнен некорректно, не содержит 36 символов."+Символы.ПС+"Проверьте настройки подписания.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ СтрНайти(СокрЛП(ПараметрыАвторизацииИПодписания.ПараметрыПодписания.МчдGUID), " ") = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Идентификатор доверенности физлица подписанта заполнен некорректно, идентификатор не может содержать пробелы."+Символы.ПС+"Проверьте настройки подписания.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;	
	
	ДанныеПереданыВВидеXDTO = Ложь;
	Фабрика = ПолучитьФабрикуФормата(ФорматВыгрузки, Кэш);
	
	Если ТипЗнч(СтруктураДанных) = Тип("Строка") Тогда
		
		XML = СтруктураДанных;
		ОбрабатываемыйОбъектXDTO = СоздатьОбъектXDTOИзXML(XML, Фабрика);
		
	ИначеЕсли ТипЗнч(СтруктураДанных) = Тип("ОбъектXDTO") Тогда
		
		ДанныеПереданыВВидеXDTO = Истина;
		ОбрабатываемыйОбъектXDTO = СтруктураДанных;
		
		ПараметрыЗаписи = Новый ПараметрыЗаписиXML("Windows-1251", "1.0", Истина, Истина);
		ЗаписьXML = Новый ЗаписьXML();
		ЗаписьXML.УстановитьСтроку(ПараметрыЗаписи);
		ЗаписьXML.ЗаписатьОбъявлениеXML();   		
		Фабрика.ЗаписатьXML(ЗаписьXML, ОбрабатываемыйОбъектXDTO, , , , НазначениеТипаXML.Неявное);
		
		XML = ЗаписьXML.Закрыть();
		
		// Приводим полученный нами XML к нужному нам виду.
		XML = УдалитьПространствоИменИзXML(XML, ФорматВыгрузки);
		
		ОбрабатываемыйОбъектXDTO = СоздатьОбъектXDTOИзXML(XML, Фабрика);
		
	КонецЕсли;
	
	УзелШапкиДокумента = Неопределено;
	
	Если ФорматВыгрузки = "ON_NSCHFDOPPR" Тогда		
		УзелШапкиДокумента = ОбрабатываемыйОбъектXDTO.Документ.СвСчФакт;	
	ИначеЕсли ФорматВыгрузки = "ON_NKORSCHFDOPPR" Тогда	
		УзелШапкиДокумента = ОбрабатываемыйОбъектXDTO.Документ.СвКСчФ;	
	ИначеЕсли ФорматВыгрузки = "DP_TOVTORGPR" Тогда	
		УзелШапкиДокумента = ОбрабатываемыйОбъектXDTO.Документ.СвДокПТПр.СодФХЖ1;	
	ИначеЕсли ФорматВыгрузки = "DP_REZRUISP" Тогда			
		УзелШапкиДокумента = ОбрабатываемыйОбъектXDTO.Документ.СвДокПРУ.СодФХЖ1;	
	Иначе	
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Подписание документов формата "+ФорматВыгрузки+" подписью физического лица на данный момент не поддерживается.";
		Сообщение.Сообщить();
		Возврат Ложь;	
	КонецЕсли;
	
	Если УзелШапкиДокумента = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "При подписании документа подписью физлица, не удалось определить узел структуры документа для помещения информации по идентификатору доверенности физлица.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;	
	
	СтруктураЭлементОбъектаXDTO = ПолучитьЗначениеИОбъектXDTOПоПути(УзелШапкиДокумента, "ИнфПолФХЖ1");
				
	Если НЕ СтруктураЭлементОбъектаXDTO = Неопределено И СтруктураЭлементОбъектаXDTO.УзелСуществует = Истина Тогда
		// Элемент существует. Никакие действия не требуются.
	ИначеЕсли НЕ СтруктураЭлементОбъектаXDTO = Неопределено И СтруктураЭлементОбъектаXDTO.УзелСуществует = Ложь Тогда 
		ГоловнойЭлементXDTO = СтруктураЭлементОбъектаXDTO.ОбъектXDTO;
		ОбъектXDTOЭлемента = ПолучитьОбъектXDTO(Фабрика, ГоловнойЭлементXDTO.Тип(), "ИнфПолФХЖ1");
		ГоловнойЭлементXDTO.Добавить(ФормаXML.Элемент, ФорматВыгрузки, СокрЛП("ИнфПолФХЖ1"), ОбъектXDTOЭлемента);
	Иначе
		// Узел не существует в структуре документа. Карайне маловероятное событие (косяк в XSD-схеме?).	
	КонецЕсли;			
	
	ИнфПолФХЖ1Документа = УзелШапкиДокумента.ИнфПолФХЖ1;
	
	// Получаем и заполняем узел ТекстИнф. Он общий для всех узлов ИнфПолФХЖ1.
	Если НЕ ИнфПолФХЖ1Документа = Неопределено Тогда			
		
		ОбъектXDTOЭлементаМассиваТекстИнф = ПолучитьОбъектXDTO(Фабрика, ИнфПолФХЖ1Документа.Тип(), "ТекстИнф");
		
		ЭлементДанныхString = ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "string");
		ЭлементДанных = ФабрикаXDTO.Создать(ЭлементДанныхString, "");
		ОбъектXDTOЭлементаМассиваТекстИнф.Добавить(ФормаXML.Атрибут, ФорматВыгрузки, "Идентиф", ЭлементДанных);
		ОбъектXDTOЭлементаМассиваТекстИнф.Добавить(ФормаXML.Атрибут, ФорматВыгрузки, "Значен", ЭлементДанных);				
		ОбъектXDTOЭлементаМассиваТекстИнф.Идентиф = "МЧД";
		ОбъектXDTOЭлементаМассиваТекстИнф.Значен = ПараметрыАвторизацииИПодписания.ПараметрыПодписания.МчдGUID;
		
		ИнфПолФХЖ1Документа.Добавить(ФормаXML.Элемент, "http://www.w3.org/2001/XMLSchema", "ТекстИнф", ОбъектXDTOЭлементаМассиваТекстИнф);
		
	Иначе	
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось определить и заполнить узел ""ИнфПолФХЖ1"" в структуре документа при помещении идентификатора доверенности физлица."+Символы.ПС+"Проверьте настройки формирования документа.";
		Сообщение.Сообщить();
		Возврат Ложь;
		
	КонецЕсли;						
	
	Если ДанныеПереданыВВидеXDTO Тогда
		
		СтруктураДанных = ОбрабатываемыйОбъектXDTO;
		
	Иначе
		
		ПараметрыЗаписи = Новый ПараметрыЗаписиXML("Windows-1251", "1.0", Истина, Истина);
		ЗаписьXML = Новый ЗаписьXML();
		ЗаписьXML.УстановитьСтроку(ПараметрыЗаписи);
		ЗаписьXML.ЗаписатьОбъявлениеXML();   		
		Фабрика.ЗаписатьXML(ЗаписьXML, ОбрабатываемыйОбъектXDTO, , , , НазначениеТипаXML.Неявное);
		
		XML = ЗаписьXML.Закрыть();
		
		// Приводим полученный нами XML к нужному нам виду.
		XML = УдалитьПространствоИменИзXML(XML, ФорматВыгрузки);
		
		СтруктураДанных = XML;
		
	КонецЕсли;
	
КонецФункции	

Функция ПоместитьВДокументИдентификаторДоверенностиФизлица_DOM(СтруктураДанных, ПараметрыАвторизацииИПодписания, ФорматВыгрузки, Кэш, ТипПодписанта = Неопределено)
	
	Если НЕ ТипПодписанта = Неопределено И НЕ ТипПодписанта = "ФЛ" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ФорматВыгрузки = "ON_AKTSVEROTP" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если НЕ ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("ТипСубъекта") Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось определить тип подписанта по сертификату."+Символы.ПС+"Проверьте настройки подписания.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ТипСубъекта = "ФЛ" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если НЕ ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("МчдGUID") Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не обнаружен идентификатор доверенности физлица подписанта."+Символы.ПС+"Проверьте настройки подписания.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	Если СокрЛП(ПараметрыАвторизацииИПодписания.ПараметрыПодписания.МчдGUID) = "" Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не заполнен идентификатор доверенности физлица подписанта."+Символы.ПС+"Проверьте настройки подписания.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ СтрДлина(СокрЛП(ПараметрыАвторизацииИПодписания.ПараметрыПодписания.МчдGUID)) = 36 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Идентификатор доверенности физлица подписанта заполнен некорректно, не содержит 36 символов."+Символы.ПС+"Проверьте настройки подписания.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ СтрНайти(СокрЛП(ПараметрыАвторизацииИПодписания.ПараметрыПодписания.МчдGUID), " ") = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Идентификатор доверенности физлица подписанта заполнен некорректно, идентификатор не может содержать пробелы."+Символы.ПС+"Проверьте настройки подписания.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;	
	
	ДанныеПереданыВВидеXDTO = Ложь;
	Фабрика = ПолучитьФабрикуФормата(ФорматВыгрузки, Кэш);
	
	Если ТипЗнч(СтруктураДанных) = Тип("Строка") Тогда
		
		XML = СтруктураДанных;
		//ОбрабатываемыйОбъектXDTO = СоздатьОбъектXDTOИзXML(XML, Фабрика);
		
	ИначеЕсли ТипЗнч(СтруктураДанных) = Тип("ОбъектXDTO") Тогда
		
		ДанныеПереданыВВидеXDTO = Истина;
		ОбрабатываемыйОбъектXDTO = СтруктураДанных;
		
		ПараметрыЗаписи = Новый ПараметрыЗаписиXML("Windows-1251", "1.0", Истина, Истина);
		ЗаписьXML = Новый ЗаписьXML();
		ЗаписьXML.УстановитьСтроку(ПараметрыЗаписи);
		ЗаписьXML.ЗаписатьОбъявлениеXML();   		
		Фабрика.ЗаписатьXML(ЗаписьXML, ОбрабатываемыйОбъектXDTO, , , , НазначениеТипаXML.Неявное);
		
		XML = ЗаписьXML.Закрыть();
		
	КонецЕсли;
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(XML);
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(Чтение);
	
	ЭлементШапкиДокументаDOM = Неопределено;
	
	Если ФорматВыгрузки = "ON_NSCHFDOPPR" Тогда		
		ЭлементШапкиДокументаDOM = ПолучитьЭлементУзлаDOM(ДокументDOM, "СвСчФакт");	
	ИначеЕсли ФорматВыгрузки = "ON_NKORSCHFDOPPR" Тогда	
		ЭлементШапкиДокументаDOM = ПолучитьЭлементУзлаDOM(ДокументDOM, "СвКСчФ");	
	ИначеЕсли ФорматВыгрузки = "DP_TOVTORGPR" Тогда	
		ЭлементШапкиДокументаDOM = ПолучитьЭлементУзлаDOM(ДокументDOM, "СодФХЖ1");	
	ИначеЕсли ФорматВыгрузки = "DP_REZRUISP" Тогда			
		ЭлементШапкиДокументаDOM = ПолучитьЭлементУзлаDOM(ДокументDOM, "СодФХЖ1");	
	Иначе	
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Подписание документов формата "+ФорматВыгрузки+" подписью физического лица на данный момент не поддерживается.";
		Сообщение.Сообщить();
		Возврат Ложь;	
	КонецЕсли;
	
	Если ЭлементШапкиДокументаDOM = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "При подписании документа подписью физлица, не удалось определить узел структуры документа для помещения информации по идентификатору доверенности физлица.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;	
	
	ЭлементИнфПолФХЖ1ДокументаDOM = ПолучитьЭлементУзлаDOM(ДокументDOM, "ИнфПолФХЖ1");
	
	Если НЕ ЭлементИнфПолФХЖ1ДокументаDOM = Неопределено Тогда
		// Элемент существует. Никакие действия не требуются.
	Иначе
		ЭлементИнфПолФХЖ1ДокументаDOM = ДокументDOM.СоздатьЭлемент("ИнфПолФХЖ1");
		ЭлементШапкиДокументаDOM.ДобавитьДочерний(ЭлементИнфПолФХЖ1ДокументаDOM);
		ЭлементИнфПолФХЖ1ДокументаDOM = ПолучитьЭлементУзлаDOM(ДокументDOM, "ИнфПолФХЖ1");	
	КонецЕсли;			
	
	// Получаем и заполняем узел ТекстИнф. Он общий для всех узлов ИнфПолФХЖ1.				
	ЭлементТекстИнфДокументаDOM = ДокументDOM.СоздатьЭлемент("ТекстИнф");	
	ЭлементТекстИнфДокументаDOM.УстановитьАтрибут("Идентиф", "МЧД");
	ЭлементТекстИнфДокументаDOM.УстановитьАтрибут("Значен", ПараметрыАвторизацииИПодписания.ПараметрыПодписания.МчдGUID);
	ЭлементИнфПолФХЖ1ДокументаDOM.ДобавитьДочерний(ЭлементТекстИнфДокументаDOM);
	
	// Помещаем узел в документ.
	ЭлементИнфПолФХЖ1ДокументаDOM.ДобавитьДочерний(ЭлементТекстИнфДокументаDOM);
	
	ПараметрыЗаписи = Новый ПараметрыЗаписиXML("Windows-1251", "1.0", Истина, Истина);
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку(ПараметрыЗаписи); 
	ЗаписьDOM = Новый ЗаписьDOM;
	ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
	XML = ЗаписьXML.Закрыть(); 
	
	
	//ИнфПолФХЖ1Документа.Добавить(ФормаXML.Элемент, "http://www.w3.org/2001/XMLSchema", "ТекстИнф", ОбъектXDTOЭлементаМассиваТекстИнф);
						
	
	Если ДанныеПереданыВВидеXDTO Тогда
		
		ИтоговыйОбъектXDTO = СоздатьОбъектXDTOИзXML(XML, Фабрика);
		СтруктураДанных = ИтоговыйОбъектXDTO;
		Возврат Истина;
		
	Иначе
		
		// Пространства имен не нужны.
		XML = УдалитьПространствоИменИзXML(XML, ФорматВыгрузки);
		СтруктураДанных = XML;
		Возврат Истина;
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти


#Область МетодыРасчетаПроизвольныхЗначений

Функция РассчитатьЗначениеПоМетодуРасчета(ЗначениеXDTO, ПараметрыФормирования, МетодРасчетаЗначения = "", СообщатьОПустомРезультате = Ложь)
	
	МетодРасчетаЗначения = ?(МетодРасчетаЗначения = "", ЗначениеXDTO.Источник.МетодРасчетаЗначения, МетодРасчетаЗначения);	
	
	Если НЕ ЗначениеXDTO.Свойства().Получить("Имя") = Неопределено Тогда
		ИмяПараметра = ЗначениеXDTO.Имя;
	ИначеЕсли НЕ ЗначениеXDTO.Свойства().Получить("ИмяПараметра") = Неопределено Тогда
		ИмяПараметра = ЗначениеXDTO.ИмяПараметра;	
	КонецЕсли;	
	ТипЗначения = ЗначениеXDTO.Источник.ТипЗначения;
	
	Если МетодРасчетаЗначения = "ФиксированноеЗначение" Тогда
		Значение = ПолучитьФиксированноеЗначение(ЗначениеXDTO.Источник.ПутьКИсточнику, ТипЗначения, ИмяПараметра, ПараметрыФормирования);
	ИначеЕсли МетодРасчетаЗначения = "ИзПодготовленныхДанных" Тогда
		Значение = ПолучитьЗначениеИзПодготовленныхДанных(ЗначениеXDTO.Источник.ПутьКИсточнику, ТипЗначения, 
																	ИмяПараметра, ПараметрыФормирования);
	ИначеЕсли МетодРасчетаЗначения = "ИзОбрабатываемогоОбъектаXDTO" Тогда
		Значение = ПолучитьЗначениеИзОбрабатываемогоУзлаДокумента(ЗначениеXDTO.Источник.ПутьКИсточнику, ТипЗначения, 
																	ИмяПараметра, ПараметрыФормирования);
	ИначеЕсли МетодРасчетаЗначения = "ИзОбрабатываемогоУзлаДокумента" Тогда
		Значение = ПолучитьЗначениеИзОбрабатываемогоУзлаДокумента(ЗначениеXDTO.Источник.ПутьКИсточнику, ТипЗначения, 
																	ИмяПараметра, ПараметрыФормирования);																
	ИначеЕсли МетодРасчетаЗначения = "ПоискПоИндексированнымРеквизитам" Тогда
		Значение = ПолучитьРезультатПоискаПоИндексированнымРеквизитам(ЗначениеXDTO.Источник.РеквизитыПоиска, 
																			   ЗначениеXDTO.Источник.ТипОбъектаМетаданных, ЗначениеXDTO.Источник.ИмяОбъектаМетаданных, 
																			   ПараметрыФормирования, СообщатьОПустомРезультате);
	ИначеЕсли МетодРасчетаЗначения = "РезультатЗапроса" Тогда	
		Значение = ПолучитьРезультатЗапроса(ЗначениеXDTO.Источник.ТекстЗапроса, ТипЗначения, ЗначениеXDTO.Источник.ПараметрыЗапроса, ИмяПараметра, ПараметрыФормирования, 
													СообщатьОПустомРезультате);
	ИначеЕсли МетодРасчетаЗначения = "РезультатВыполненияКода" Тогда
		Значение = ПолучитьРезультатВыполненияКода(ЗначениеXDTO.Источник.ТекстФункции, ТипЗначения, ЗначениеXDTO.Источник.ВходящиеПараметры, ИмяПараметра, 
															ПараметрыФормирования, СообщатьОПустомРезультате);
	ИначеЕсли МетодРасчетаЗначения = "Константа" Тогда
		Значение = ПолучитьЗначениеКонстанты(ЗначениеXDTO.Источник.ИмяОбъектаМетаданных, ПараметрыФормирования);
	ИначеЕсли МетодРасчетаЗначения = "Перечисление" Тогда	
		Значение = ПолучитьЗначениеПеречисления(ЗначениеXDTO.Источник.ИмяОбъектаМетаданных, ЗначениеXDTO.Источник.ПутьКИсточнику, ПараметрыФормирования);	
	ИначеЕсли МетодРасчетаЗначения = "ПустаяСсылка" Тогда
		Если НЕ СтрНайти(ТипЗначения, "Справочник") = 0 Тогда 
			Значение = Справочники[ЗначениеXDTO.Источник.ИмяОбъектаМетаданных].ПустаяСсылка();
		ИначеЕсли НЕ Стрнайти(ТипЗначения, "Документ") = 0 Тогда 
			Значение = Документы[ЗначениеXDTO.Источник.ИмяОбъектаМетаданных].ПустаяСсылка();
		ИначеЕсли НЕ Стрнайти(ТипЗначения, "Перечисление") = 0 Тогда 
			Значение = Перечисления[ЗначениеXDTO.Источник.ИмяОбъектаМетаданных].ПустаяСсылка();	
		Иначе
			Значение = Неопределено;
		КонецЕсли;
	ИначеЕсли МетодРасчетаЗначения = "Неопределено" Тогда
		Возврат Неопределено;
	ИначеЕсли МетодРасчетаЗначения = "ПроверкаНаличияУзлаОбрабатываемогоОбъектаXDTO" Тогда
		Значение = ПроверитьНаличиеУзлаОбрабатываемогоДокумента(ЗначениеXDTO.Источник.ПутьКИсточнику, ТипЗначения, 
																	ИмяПараметра, ПараметрыФормирования);
	ИначеЕсли МетодРасчетаЗначения = "ПроверкаНаличияУзлаОбрабатываемогоДокумента" Тогда
		Значение = ПроверитьНаличиеУзлаОбрабатываемогоДокумента(ЗначениеXDTO.Источник.ПутьКИсточнику, ТипЗначения, 
																	ИмяПараметра, ПараметрыФормирования);	
	Иначе	
		Значение = Неопределено;
	КонецЕсли;
	
	Если НЕ Значение = Неопределено И НЕ ЗначениеXDTO.Источник.Свойства().Получить("Формат") = Неопределено Тогда
		Значение = Формат(Значение, ЗначениеXDTO.Источник.Формат);
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Число") И ЗначениеXDTO.Источник.Свойства().Получить("Формат") = Неопределено Тогда
		Значение = Формат(Значение, "ЧРД=.; ЧН=0; ЧГ=0");
	КонецЕсли;     
	
	Если ТипЗначения = "Строка" Тогда
		Значение = СокрЛП(Значение);
	КонецЕсли;
	
	Если ЗначениеXDTO.Источник.Свойства().Получить("Формат") = Неопределено И НЕ Значение = Неопределено И НЕ ТипЗнч(Значение) = Тип(ТипЗначения) Тогда
		Если ТипЗначения = "Строка" Тогда
			Попытка
				Значение = Строка(Значение);
			Исключение
				Возврат Неопределено;
			КонецПопытки;
		ИначеЕсли ТипЗначения = "Число" Тогда
			Попытка
				Значение = Число(Значение);
			Исключение
				Возврат Неопределено;
			КонецПопытки; 
		ИначеЕсли ТипЗначения = "Дата" Тогда
			Попытка
				Значение = Дата(Значение + " 00:00:00");
			Исключение
				Возврат Неопределено;
			КонецПопытки;
		Иначе
			Возврат Неопределено;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Значение; 
	
КонецФункции

Функция ПолучитьФиксированноеЗначение(Значение, ТипЗначения, Имя = Неопределено, ПараметрыФормирования)
	
	Если ТипЗначения = "Булево" Тогда
		Если Значение = "Истина" Тогда
			Возврат Истина;
		ИначеЕсли Значение = "Ложь" Тогда
			Возврат Ложь;
		Иначе   
			ТекстОшибки = "При расчете значения "+Имя+" произошла ошибка."+Символы.ПС+"Значение """+Значение+""" не может быть приведено к типу """+ТипЗначения+""".";
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстОшибки;
			Сообщение.Сообщить();
			СтруктураОшибки = Новый Структура;
