							ЗначениеАтрибута = РассчитатьЗначениеПоМетодуРасчета(ВариантXDTO, ПараметрыФормирования);
							ЭлементДанныхString = ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "string");
							ЭлементДанных = ФабрикаXDTO.Создать(ЭлементДанныхString, ЗначениеАтрибута);
							ЭлементXDTO.Добавить(ФормаXML.Атрибут, ФорматВыгрузки, СокрЛП(НастройкаОбъектXDTO.Имя), ЭлементДанных);
						Иначе
							// Узел не существует.
