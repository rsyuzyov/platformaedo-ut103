		// Определение и заполнение данных подписанта.
		ДанныеПодписанта = Неопределено;
		
		ЮрФизЛицоИППодписант = Неопределено;
		СубъектПодписант = Неопределено;	
		Если НЕ ПараметрыАвторизацииИПодписания = Неопределено Тогда
			Если ПараметрыАвторизацииИПодписания.Свойство("ПараметрыПодписания") Тогда
				Если ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("ТипСубъекта") Тогда
					ЮрФизЛицоИППодписант = ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ТипСубъекта;
				КонецЕсли;
				Если ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("Субъект") Тогда
					СубъектПодписант = ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Субъект;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
		
		Если ЮрФизЛицоИППодписант = Неопределено Тогда
			ЮрФизЛицоИППодписант = ?(СтрДлина(СтруктураОбмена.СтруктураЭД.Организация.ИНН) = 10, "ЮЛ", "ИП");
		КонецЕсли;
		
		ПодписьСоответствуетОрганизации = Ложь;
		
		Если НЕ СубъектПодписант = Неопределено Тогда
			// Были переданы данные о подписанте из ЭЦП.
			ЭЦП_ИНН = "";
			Если СубъектПодписант.Свойство("OID1_2_643_100_4") Тогда
				ЭЦП_ИНН = СубъектПодписант.OID1_2_643_100_4;
			ИначеЕсли СубъектПодписант.Свойство("OID1_2_643_3_131_1_1") Тогда
				ЭЦП_ИНН = СубъектПодписант.OID1_2_643_3_131_1_1;
			ИначеЕсли СубъектПодписант.Свойство("INNLE") Тогда
				ЭЦП_ИНН = СубъектПодписант.INNLE;
			ИначеЕсли СубъектПодписант.Свойство("ИННЮЛ") Тогда
				ЭЦП_ИНН = СубъектПодписант.ИННЮЛ;
			ИначеЕсли СубъектПодписант.Свойство("ИНН_ЮЛ") Тогда
				ЭЦП_ИНН = СубъектПодписант.ИНН_ЮЛ;
			ИначеЕсли СубъектПодписант.Свойство("ИНН") Тогда
				ЭЦП_ИНН = СубъектПодписант.ИНН;
			ИначеЕсли СубъектПодписант.Свойство("ИННОрганизации") Тогда
				ЭЦП_ИНН = СубъектПодписант.ИННОрганизации;
			ИначеЕсли СубъектПодписант.Свойство("ИНН_Организации") Тогда
				ЭЦП_ИНН = СубъектПодписант.ИНН_Организации;	
			КонецЕсли;
			Если НЕ ЮрФизЛицоИППодписант = "ФЛ" Тогда
				Если ЭЦП_ИНН = "" Тогда
					ПодписьСоответствуетОрганизации = Ложь;
				Иначе	
					ПодписьСоответствуетОрганизации = СтрНайти(ЭЦП_ИНН, СтруктураОбмена.СтруктураЭД.Организация.ИНН) <> 0;
				КонецЕсли;
			Иначе
				ПодписьСоответствуетОрганизации = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ СубъектПодписант = Неопределено И НЕ ПодписьСоответствуетОрганизации И НЕ ЮрФизЛицоИППодписант = "ФЛ" Тогда
			Сообщение = Новый СообщениеПользователю();
