#Область ПодготовкаИнформацииОбОшибкахФормированияБЭД 

Функция ПодготовитьМассивОшибокФормированияДокументовБЭДизЖурналаРегистрации(МассивДокументов, МоментВремениНачалаФормированияДокументов) 
	
	GUIDДокументов = Новый Соответствие;	
	Для Каждого Документ из МассивДокументов Цикл		
		GUIDДокументов.Вставить(Строка(Документ.УникальныйИдентификатор()), Документ);	
	КонецЦикла;	
	
	МассивОшибок = Новый Массив;
	
	ФильтрСобытийЖурнала = Новый Структура;
	ФильтрСобытийЖурнала.Вставить("ДатаНачала", МоментВремениНачалаФормированияДокументов);
	ФильтрСобытийЖурнала.Вставить("ДатаОкончания", ТекущаяДата());
	ФильтрСобытийЖурнала.Вставить("Событие", "Электронное взаимодействие.Обмен с контрагентами");
	ИмяФайлаЖурнала = ПолучитьИмяВременногоФайла("XML");
	ВыгрузитьЖурналРегистрации(ИмяФайлаЖурнала, ФильтрСобытийЖурнала, "Дата, Событие, Комментарий, Метаданные, Данные, ПредставлениеДанных, ИмяПользователя");
	ФайлЛогаЖурнала = Новый ТекстовыйДокумент;
	ФайлЛогаЖурнала.Прочитать(ИмяФайлаЖурнала);
	ЛогЖурналаXDTO = СоздатьОбъектXDTOИзXML(ФайлЛогаЖурнала.ПолучитьТекст(), Новый ФабрикаXDTO);
	УдалитьФайлы(ИмяФайлаЖурнала);
	
	Если ЛогЖурналаXDTO.Свойства().Получить("Event") = Неопределено Тогда
		Возврат МассивОшибок; // Пустой массив.
	КонецЕсли;	
	
	Если ТипЗнч(ЛогЖурналаXDTO.Event) = Тип("СписокXDTO") Тогда
		// Несколько ошибок.
		
		Для Каждого ОшибкаЖурнала из ЛогЖурналаXDTO.Event Цикл				
			ДокументОшибки = GUIDДокументов.Получить(ОшибкаЖурнала.Data);
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("Документ", ДокументОшибки);	
			СтруктураОшибки.Вставить("ТекстОшибки", ОшибкаЖурнала.Comment);
			МассивОшибок.Добавить(СтруктураОшибки);	
		КонецЦикла;	
		
	ИначеЕсли ТипЗнч(ЛогЖурналаXDTO.Event) = Тип("ОбъектXDTO") Тогда
		// Одна ошибка
		
		ДокументОшибки = GUIDДокументов.Получить(ЛогЖурналаXDTO.Event.Data);
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("Документ", ДокументОшибки);	
		СтруктураОшибки.Вставить("ТекстОшибки", ЛогЖурналаXDTO.Event.Comment);
		МассивОшибок.Добавить(СтруктураОшибки);	
		
	КонецЕсли;	
	
	Возврат МассивОшибок; 
	
КонецФункции	

#КонецОбласти

#КонецОбласти

#Область ИнтеграцияAPI

Функция ВыполнитьЗапросAPI(ИмяФункцииЗапроса, ВходящиеПараметрыЗапроса, Страница = Неопределено, ПараметрыАвторизацииИПодписания, Организация) Экспорт
	
	РезультатЗапроса = ПолучитьШаблонСтруктурыОтвета();
	РезультатЗапроса.Ошибка = Истина;
	
	ПараметрыЗапроса = СкопироватьКоллекцию(ВходящиеПараметрыЗапроса);
	
	Выполнить("РезультатЗапроса = "+ИмяФункцииЗапроса+"(ПараметрыЗапроса"+?(Страница = Неопределено, "", ", Страница")+");");
	
	Если РезультатЗапроса.КодСостояния = 401 Тогда
		
		// Ошибка авторизации.
		// Попытка обновить токен по сертификату.
		Если ПараметрыАвторизацииИПодписания.ИспользуетсяПодписание = Истина И НЕ ЗначениеЗаполнено(ПараметрыАвторизацииИПодписания.RefreshToken) Тогда
			
			Если ПараметрыЗапроса.Свойство("Заголовки") И НЕ ПараметрыЗапроса.Заголовки.Получить("Authorization") = Неопределено Тогда
				ИспользоватьПодписание			= ПараметрыАвторизацииИПодписания.ИспользуетсяПодписание;
				ОтпечатокСертификатаBase64		= ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ОтпечатокСертификатаBase64;
				ПарольДоступаКЗакрытомуКлючу	= ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ПарольДоступаКЗакрытомуКлючу;
				ТипСубъектаПодписанта			= ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ТипСубъекта;
				МчдGUIDПодписанта				= ПараметрыАвторизацииИПодписания.ПараметрыПодписания.МчдGUID;
				ДатаНачалаДействияМЧД			= ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ДатаНачалаДействияМЧД;
				ДолжностьФизлица				= ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ДолжностьФизлица;
				НовыйТокен = ПолучитьТокенПоОтпечаткуСертификата(Base64Значение(ОтпечатокСертификатаBase64), ПарольДоступаКЗакрытомуКлючу);
				Если НЕ НовыйТокен = Неопределено Тогда
					ПараметрыЗапроса = СкопироватьКоллекцию(ВходящиеПараметрыЗапроса);
					ПараметрыЗапроса.Заголовки.Вставить("Authorization", "Bearer "+ НовыйТокен);
					Выполнить("РезультатЗапроса = "+ИмяФункцииЗапроса+"(ПараметрыЗапроса"+?(Страница = Неопределено, "", ", Страница")+");");
					Если РезультатЗапроса.КодСостояния = 200 Тогда
						AccessToken = НовыйТокен;
						RefreshToken = "";
						СохранитьПараметрыАвторизацииИПодписанияОрганизации(Организация, AccessToken, RefreshToken, ИспользоватьПодписание, ОтпечатокСертификатаBase64, ПарольДоступаКЗакрытомуКлючу, ТипСубъектаПодписанта, МчдGUIDПодписанта, ДатаНачалаДействияМЧД, ДолжностьФизлица);
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(ПараметрыАвторизацииИПодписания.AccessToken) И ЗначениеЗаполнено(ПараметрыАвторизацииИПодписания.RefreshToken) Тогда 	
			
			ИспользоватьПодписание			= ПараметрыАвторизацииИПодписания.ИспользуетсяПодписание;
			ОтпечатокСертификатаBase64		= ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ОтпечатокСертификатаBase64;
			ПарольДоступаКЗакрытомуКлючу	= ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ПарольДоступаКЗакрытомуКлючу;
			ТипСубъектаПодписанта			= ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ТипСубъекта;
			МчдGUIDПодписанта				= ПараметрыАвторизацииИПодписания.ПараметрыПодписания.МчдGUID;
			ДатаНачалаДействияМЧД			= ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ДатаНачалаДействияМЧД;
			ДолжностьФизлица				= ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ДолжностьФизлица;
			
			RefreshToken = ПараметрыАвторизацииИПодписания.RefreshToken;
			FreshTokens = RefreshTokens(RefreshToken);
			Если НЕ FreshTokens = Неопределено Тогда
				НовыйAccessToken = FreshTokens.access_token;
				НовыйRefreshToken = FreshTokens.refresh_token;
				AccessToken = НовыйAccessToken;
				RefreshToken = НовыйRefreshToken;
				СохранитьПараметрыАвторизацииИПодписанияОрганизации(Организация, AccessToken, RefreshToken, ИспользоватьПодписание, ОтпечатокСертификатаBase64, ПарольДоступаКЗакрытомуКлючу, ТипСубъектаПодписанта, МчдGUIDПодписанта, ДатаНачалаДействияМЧД, ДолжностьФизлица);
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат РезультатЗапроса;
	
КонецФункции

Процедура СохранитьПараметрыАвторизацииИПодписанияОрганизации(Организация, AccessTokenОрганизации, RefreshTokenОрганизации, ИспользоватьПодписание, ОтпечатокСертификатаBase64Организации, ПарольДоступаКЗакрытомуКлючуОрганизации, ТипСубъектаПодписантаОрганизации, МчдGUIDПодписантаОрганизации, ДатаНачалаДействияМЧДОрганизации, ДолжностьФизлицаОрганизации)

	ПараметрыАвторизацииИПодписанияОрганизации = Новый Структура;
	
	ПараметрыАвторизацииИПодписанияОрганизации.Вставить("AccessToken", AccessTokenОрганизации);
	ПараметрыАвторизацииИПодписанияОрганизации.Вставить("RefreshToken", RefreshTokenОрганизации);
	ПараметрыАвторизацииИПодписанияОрганизации.Вставить("ИспользуетсяПодписание", ИспользоватьПодписание);
	
	ПараметрыПодписания = Новый Структура;
	 
	ПараметрыПодписания.Вставить("ОтпечатокСертификатаBase64", ОтпечатокСертификатаBase64Организации);
	ПараметрыПодписания.Вставить("ПарольДоступаКЗакрытомуКлючу", ПарольДоступаКЗакрытомуКлючуОрганизации);
	Менеджер = ПолучитьМенеджерКриптографии();
	Сертификат  = ПолучитьЭЦППоОтпечатку(Менеджер, Base64Значение(ОтпечатокСертификатаBase64Организации));
	ПараметрыПодписания.Вставить("Субъект", Сертификат.Субъект);
	ПараметрыПодписания.Вставить("ТипСубъекта", ТипСубъектаПодписантаОрганизации);
	ПараметрыПодписания.Вставить("МчдGUID", МчдGUIDПодписантаОрганизации);
	ПараметрыПодписания.Вставить("ДатаНачалаДействияМЧД", ДатаНачалаДействияМЧДОрганизации);
	ПараметрыПодписания.Вставить("ДолжностьФизлица", ?(ЗначениеЗаполнено(ДолжностьФизлицаОрганизации), ДолжностьФизлицаОрганизации, Неопределено));
	
	ПараметрыАвторизацииИПодписанияОрганизации.Вставить("ПараметрыПодписания", ПараметрыПодписания);
	
	ОбновитьПараметрыАвторизацииИПодписанияОрганизации(Организация, ПараметрыАвторизацииИПодписанияОрганизации);	
	
КонецПроцедуры

Процедура ОбновитьПараметрыАвторизацииИПодписанияОрганизации(Организация, ПараметрыАвторизацииИПодписанияОрганизации)
	
	ПользовательВладелецНастроек = ПолучитьТекущегоПользователя();
	
	Интеграция = ПолучитьИнтеграциюНаСервере(ПользовательВладелецНастроек);
	
	Если НЕ Интеграция.Свойство("ПараметрыАвторизацииИПодписания") Тогда
		Интеграция.Вставить("ПараметрыАвторизацииИПодписания", Новый Соответствие);
	КонецЕсли;
		
	Интеграция.ПараметрыАвторизацииИПодписания.Вставить(Организация, ПараметрыАвторизацииИПодписанияОрганизации);	
	
	СохранитьИнтеграциюНаСервере(Интеграция);
	
КонецПроцедуры

Функция ПолучитьШаблонПараметровЗапроса(AccessToken) Экспорт
	
	Структура = Новый Структура;
	
	Структура.Вставить("Соединение", 	ПолучитьСоединение());
	Структура.Вставить("Заголовки", 	ПолучитьЗаголовки(AccessToken));
	Структура.Вставить("Параметры", 	Новый Соответствие);
	
	Возврат Структура;
	
КонецФункции

Функция ПолучитьШаблонСтруктурыОтвета()
	
	Структура = Новый Структура();
	
	Структура.Вставить("Результат", 	Неопределено);
	Структура.Вставить("Ошибка", 		Ложь);
	Структура.Вставить("Описание", 		""); 
	Структура.Вставить("КодСостояния",	"");
	
	Возврат Структура;
	
КонецФункции

Функция ПолучитьЗаголовки(AccessToken)
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("accept", "application/json;charset=UTF-8");
	Заголовки.Вставить("Authorization", "Bearer "+ AccessToken);
	
	Возврат Заголовки;
	
КонецФункции

Функция ПолучитьСоединение()
	
	СертификатКлиентаWin 	= Новый СертификатКлиентаWindows();
	СертификатУЦWin 		= Неопределено; //Новый СертификатыУдостоверяющихЦентровWindows();
	
	ssl = Новый ЗащищенноеСоединениеOpenSSL(СертификатКлиентаWin, СертификатУЦWin); 		
	
	Если ЭтоТестоваяОбработка Тогда		
		// Тест
		Соединение  =  Новый HTTPСоединение("edo-test.platformaofd.ru", //сервер
		443, 	//порт
		,		//логин
		,		//пароль
		,		//прокси
		20,		//таймаут
		ssl,);	//защищенное HTTPS соединение 			
	Иначе	
		// Бой
		Соединение  =  Новый HTTPСоединение("edo.platformaofd.ru", //сервер
		443,	//порт
		,		//логин
		,		//пароль
		,		//прокси
		20,		//таймаут
		ssl,);	//защищенное HTTPS соединение
	КонецЕсли;
	
	Возврат Соединение;
	
КонецФункции

Функция ЗаполнитьПараметрыВЗапросе(СтрокаЗапроса, Параметры) Экспорт
	
	Для Каждого Параметр из Параметры Цикл
		
		СтрокаЗапроса = СтрЗаменить(СтрокаЗапроса, Параметр.Ключ, Параметр.Значение);
		
	КонецЦикла;	
	
	Возврат СтрокаЗапроса;
	
КонецФункции

Функция ОбработатьОтвет(Ответ, СтруктураОтвета, ЭтоФайл = Ложь) Экспорт 
	
	СтруктураОтвета.КодСостояния = Ответ.КодСостояния;
	ОтветОбработан = Ложь;
	Тело = Ответ.ПолучитьТелоКакСтроку();	
	
	ТекущаяДата = Строка(ТекущаяДата());
	
	Если СтруктураОтвета.КодСостояния = 200 Тогда
		
		Если Тело = "[]" или Тело = "" Тогда
			СтруктураОтвета.Описание 		= ТекущаяДата + " Пустой ответ.";
		Иначе 
			Если НЕ ЭтоФайл Тогда
				ЧтениеJSON = Новый ЧтениеJSON();
				ЧтениеJSON.УстановитьСтроку(Тело);
				СтруктураОтвета.Результат = ПрочитатьJSON(ЧтениеJSON);			
				ЧтениеJSON.Закрыть(); 
			Иначе
				ДвоичныеДанныеФайла = Ответ.ПолучитьТелоКакДвоичныеДанные();
				СтруктураОтвета.Результат = ДвоичныеДанныеФайла;
				СтруктураОтвета.Вставить("Тип", Ответ.Заголовки.Получить("Content-Type"));
			КонецЕсли;	
		КонецЕсли;
		
		Возврат СтруктураОтвета;
		
	КонецЕсли;
	
	
	Если СтруктураОтвета.КодСостояния = 201 Тогда 
		
		Если Тело = "[]" Тогда
			СтруктураОтвета.Описание 		= ТекущаяДата + " Вроде норм, но че-то непонятно.";
			СтруктураОтвета.КодСостояния 	= 0;
		Иначе 
			ЧтениеJSON = Новый ЧтениеJSON();
			ЧтениеJSON.УстановитьСтроку(Тело);
			СтруктураОтвета.Результат = ПрочитатьJSON(ЧтениеJSON);			
			ЧтениеJSON.Закрыть();  
		КонецЕсли;
		
		Возврат СтруктураОтвета;	
		
	КонецЕсли;
	
	
	Если СтруктураОтвета.КодСостояния = 400 Тогда
		СтруктураОтвета.Ошибка 		= Истина;
		СтруктураОтвета.Описание 	= ТекущаяДата + " Error 400. Ошибка выгружаемых данных." + ?(ЗначениеЗаполнено(Тело), " ("+Тело+")", ""); 	
		Возврат СтруктураОтвета; 	
	КонецЕсли;
	
	Если СтруктураОтвета.КодСостояния = 401 Тогда
		СтруктураОтвета.Ошибка 		= Истина;
		СтруктураОтвета.Описание 	= ТекущаяДата + " Error 401. Ошибка авторизации. Проверье авторизацию в разделе настройки и повторите запрос позднее." + ?(ЗначениеЗаполнено(Тело), " ("+Тело+")", "");		
		Возврат СтруктураОтвета;	
	КонецЕсли;	
	
	Если СтруктураОтвета.КодСостояния = 403 Тогда
		СтруктураОтвета.Ошибка 		= Истина;
		СтруктураОтвета.Описание 	= ТекущаяДата +" Error 403." + ?(ЗначениеЗаполнено(Тело), " ("+Тело+")", "");	
		Возврат СтруктураОтвета; 
	КонецЕсли; 	
	
	Если СтруктураОтвета.КодСостояния = 404 Тогда
		СтруктураОтвета.Ошибка 		= Истина;
		СтруктураОтвета.Описание 	= ТекущаяДата +" Error 404." + ?(ЗначениеЗаполнено(Тело), " ("+Тело+")", "");		
		Возврат СтруктураОтвета;		
	КонецЕсли;
	
	Если СтруктураОтвета.КодСостояния = 415 Тогда
		СтруктураОтвета.Ошибка 		= Истина;
		СтруктураОтвета.Описание 	= ТекущаяДата +" Error 415. Неподдерживаемый тип файла." + ?(ЗначениеЗаполнено(Тело), " ("+Тело+")", "");		
		Возврат СтруктураОтвета;		
	КонецЕсли;
	
	Если СтруктураОтвета.КодСостояния = 500 Тогда
		СтруктураОтвета.Ошибка 		= Истина;
		СтруктураОтвета.Описание 	= ТекущаяДата +" Error 500. Сервис недоступен. Повторите запрос позднее." + ?(ЗначениеЗаполнено(Тело), " ("+Тело+")", ""); 		
		Возврат СтруктураОтвета; 		
	КонецЕсли;
	
	Если СтруктураОтвета.КодСостояния = 204 Тогда
		СтруктураОтвета.Ошибка 		= Ложь;
		СтруктураОтвета.Описание 	= ТекущаяДата +" Успешно."; 		
		Возврат СтруктураОтвета; 		
	КонецЕсли;
	
	СтруктураОтвета.Ошибка 		= Истина;
	СтруктураОтвета.Описание 	= ТекущаяДата + " Error " + СтруктураОтвета.КодСостояния + ". Неизвестная ошибка сервиса." + ?(ЗначениеЗаполнено(Тело), " ("+Тело+")", "");      			
	Возврат СтруктураОтвета;
	
КонецФункции

// documents
Функция API_ПолучитьСписокДокументов(Знач ПараметрыЗапроса) Экспорт
	
	СтрокаЗапроса = "/document/public/api/v3/documents";
	
	Счетчик = 1;
	Для Каждого ПараметрЗапроса из ПараметрыЗапроса.Параметры Цикл
		СтрокаЗапроса = СтрокаЗапроса + ?(Счетчик = 1, "?", "&") + СтрЗаменить(СтрЗаменить(ПараметрЗапроса.Ключ, ">", ""), "<", "") + "=" +ПараметрЗапроса.Ключ;
		Счетчик = Счетчик+1;
	КонецЦикла;	
	
	СтрокаЗапроса = ЗаполнитьПараметрыВЗапросе(СтрокаЗапроса, ПараметрыЗапроса.Параметры);
	
	СтруктураОтвета = ПолучитьШаблонСтруктурыОтвета();
	
	Запрос = Новый HTTPЗапрос(СтрокаЗапроса, ПараметрыЗапроса.Заголовки); 
	
	Ответ = ПараметрыЗапроса.Соединение.ВызватьHTTPМетод("GET", Запрос);
	СтруктураОтвета = ОбработатьОтвет(Ответ, СтруктураОтвета);
	
	Возврат СтруктураОтвета;
	
КонецФункции

// subscribers/le
Функция API_ИнформацияОКонтрагенте(Знач ПараметрыЗапроса) Экспорт
	
	СтрокаЗапроса = "/subscriber/public/api/v3/subscribers";
	
	Счетчик = 1;
	Для Каждого ПараметрЗапроса из ПараметрыЗапроса.Параметры Цикл
		Если НЕ ПараметрЗапроса.Значение = Неопределено И НЕ ПараметрЗапроса.Значение = Null И НЕ ПараметрЗапроса.Значение = "null" И НЕ ПараметрЗапроса.Значение = "Null" Тогда
			СтрокаЗапроса = СтрокаЗапроса + ?(Счетчик = 1, "?", ?(Счетчик = ПараметрыЗапроса.Количество(), "", "&")) + СтрЗаменить(СтрЗаменить(ПараметрЗапроса.Ключ, ">", ""), "<", "") + "=" +ПараметрЗапроса.Ключ;
		КонецЕсли;	
		Счетчик = Счетчик+1;
	КонецЦикла;
	
	СтрокаЗапроса = ЗаполнитьПараметрыВЗапросе(СтрокаЗапроса, ПараметрыЗапроса.Параметры);
	
	СтруктураОтвета = ПолучитьШаблонСтруктурыОтвета();
	
	Запрос = Новый HTTPЗапрос(СтрокаЗапроса, ПараметрыЗапроса.Заголовки);    	
	
	Ответ = ПараметрыЗапроса.Соединение.Получить(Запрос);
	СтруктураОтвета = ОбработатьОтвет(Ответ, СтруктураОтвета);
	
	Возврат СтруктураОтвета;     
	
КонецФункции

// shared-subscribers
Функция API_ИнформацияОКонтрагентеПоДаннымФНС(Знач ПараметрыЗапроса) Экспорт
	
	СтрокаЗапроса = "/subscriber/public/api/v3/shared-subscribers";
	
	Счетчик = 1;
	Для Каждого ПараметрЗапроса из ПараметрыЗапроса.Параметры Цикл
		Если НЕ ПараметрЗапроса.Значение = Неопределено И НЕ ПараметрЗапроса.Значение = Null И НЕ ПараметрЗапроса.Значение = "null" И НЕ ПараметрЗапроса.Значение = "Null" Тогда
			СтрокаЗапроса = СтрокаЗапроса + ?(Счетчик = 1, "?", ?(Счетчик = ПараметрыЗапроса.Количество(), "", "&")) + СтрЗаменить(СтрЗаменить(ПараметрЗапроса.Ключ, ">", ""), "<", "") + "=" +ПараметрЗапроса.Ключ;
		КонецЕсли;	
		Счетчик = Счетчик+1;
	КонецЦикла;
	
	СтрокаЗапроса = ЗаполнитьПараметрыВЗапросе(СтрокаЗапроса, ПараметрыЗапроса.Параметры);
	
	СтруктураОтвета = ПолучитьШаблонСтруктурыОтвета();
	
	Запрос = Новый HTTPЗапрос(СтрокаЗапроса, ПараметрыЗапроса.Заголовки);    	
	
	Ответ = ПараметрыЗапроса.Соединение.Получить(Запрос);
	СтруктураОтвета = ОбработатьОтвет(Ответ, СтруктураОтвета);
	
	Возврат СтруктураОтвета;     
	
КонецФункции

// document-changes
Функция API_ПолучитьСписокСобытийПоДокументам(Знач ПараметрыЗапроса) Экспорт
	
	СтрокаЗапроса = "/document/public/api/v4/document-changes";
	
	Счетчик = 1;
	Для Каждого ПараметрЗапроса из ПараметрыЗапроса.Параметры Цикл
		СтрокаЗапроса = СтрокаЗапроса + ?(Счетчик = 1, "?", "&") + СтрЗаменить(СтрЗаменить(ПараметрЗапроса.Ключ, ">", ""), "<", "") + "=" +ПараметрЗапроса.Ключ;
		Счетчик = Счетчик+1;
	КонецЦикла;	
	
	СтрокаЗапроса = ЗаполнитьПараметрыВЗапросе(СтрокаЗапроса, ПараметрыЗапроса.Параметры);
	
	СтруктураОтвета = ПолучитьШаблонСтруктурыОтвета();
	
	Запрос = Новый HTTPЗапрос(СтрокаЗапроса, ПараметрыЗапроса.Заголовки); 
	
	Ответ = ПараметрыЗапроса.Соединение.ВызватьHTTPМетод("GET", Запрос);
	СтруктураОтвета = ОбработатьОтвет(Ответ, СтруктураОтвета);
	
	Возврат СтруктураОтвета;
	
КонецФункции

Функция API_ПолучитьТокенАвторизацииПоСертификату(Знач ПараметрыЗапроса) Экспорт
	
	ЗаголовкиЗапроса = Новый Соответствие;
	ЗаголовкиЗапроса.Вставить("Content-Type", "application/x-www-form-urlencoded");
	ЗаголовкиЗапроса.Вставить("x-client-id", ПараметрыЗапроса.Параметры.Получить("ИдентификаторКлиента"));
	ЗаголовкиЗапроса.Вставить("Content-Encoding", "utf-8");
	ПараметрыЗапроса.Заголовки = ЗаголовкиЗапроса;
	
	СтрокаЗапроса = "/security/public/api/v3/oauth/token";
	
	СтруктураОтвета = ПолучитьШаблонСтруктурыОтвета();
	
	Запрос = Новый HTTPЗапрос(СтрокаЗапроса, ПараметрыЗапроса.Заголовки); 
	Запрос.УстановитьТелоИзСтроки(ПараметрыЗапроса.Параметры["<Тело>"], КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Ответ = ПараметрыЗапроса.Соединение.ВызватьHTTPМетод("POST", Запрос);
	СтруктураОтвета = ОбработатьОтвет(Ответ, СтруктураОтвета);
	
	Возврат СтруктураОтвета;
	
КонецФункции

