		// Приводим полученный нами XML к нужному нам виду.
		XML = УдалитьПространствоИменИзXML(XML, ФорматВыгрузки);
		
		СтруктураДанных = XML;
		
	КонецЕсли;	
		
КонецПроцедуры

Функция ПолучитьЗначениеИОбъектXDTOПоПути(ОбрабатываемыйОбъектXDTO, Путь)
		
	СтруктураЗначениеОбъектаXDTO = Неопределено;
	ДанныеУзла = ОбрабатываемыйОбъектXDTO;
	ПутьМассивУзлов = СтрРазделить(Путь, ".");
	
	Если ПутьМассивУзлов.Количество() = 0 ИЛИ ПутьМассивУзлов[0] = "" Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	ОбъектXDTO = ОбрабатываемыйОбъектXDTO;
	Счетчик = 1;
	Для Каждого Узел Из ПутьМассивУзлов Цикл
		Если ДанныеУзла.Свойства().Получить(СокрЛП(Узел)) = Неопределено Тогда
			// Соответствующего узла нет в структуре документа, требуется создание.
			СтруктураЗначениеОбъектаXDTO = Новый Структура();
			СтруктураЗначениеОбъектаXDTO.Вставить("УзелСуществует", Ложь);
			СтруктураЗначениеОбъектаXDTO.Вставить("ОбъектXDTO", ОбъектXDTO);
			СтруктураЗначениеОбъектаXDTO.Вставить("Значение", Неопределено);
			Возврат СтруктураЗначениеОбъектаXDTO;
		КонецЕсли;	
		ДанныеУзла = ДанныеУзла[СокрЛП(Узел)];
		Если Счетчик = ПутьМассивУзлов.Количество() Тогда
			СтруктураЗначениеОбъектаXDTO = Новый Структура();
			СтруктураЗначениеОбъектаXDTO.Вставить("УзелСуществует", Истина);
			СтруктураЗначениеОбъектаXDTO.Вставить("ОбъектXDTO", ОбъектXDTO);
			СтруктураЗначениеОбъектаXDTO.Вставить("Значение", СокрЛП(Узел));
			Прервать;
		Иначе
			ОбъектXDTO = ДанныеУзла;
		КонецЕсли;	
		Счетчик = Счетчик+1;
	КонецЦикла;
	
	Возврат СтруктураЗначениеОбъектаXDTO; 
	
КонецФункции	
                                        
Процедура ДополнитьМассивЭлементом_XDTO(ЭлементРодитель, Знач ОбъектXDTOМассиваПоНастройке, Фабрика, ФорматВыгрузки, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента = "")
	
	ПараметрыФормирования.Вставить("ОбрабатываемыйУзелДокумента", ЭлементРодитель);
	
	Если НЕ ОбъектXDTOМассиваПоНастройке.Свойства().Получить("УсловияВыгрузкиУзла") = Неопределено Тогда	
		УсловиеВыполнено = РезультатОбработкиУсловия(ОбъектXDTOМассиваПоНастройке, ПараметрыФормирования);
		Если УсловиеВыполнено = Ложь Тогда
			Возврат;
		КонецЕсли;	
	КонецЕсли;		
	
	Если ТипЗнч(ОбъектXDTOМассиваПоНастройке.ЭлементМассива) = Тип("СписокXDTO") Тогда
		
		Для Каждого ЭлементМассива ИЗ ОбъектXDTOМассиваПоНастройке.ЭлементМассива Цикл
			
			Если НЕ ЭлементМассива.Свойства().Получить("УсловияВыгрузкиЭлемента") = Неопределено Тогда	
				УсловиеВыполнено = РезультатОбработкиУсловия(ЭлементМассива, ПараметрыФормирования);
				Если УсловиеВыполнено = Ложь Тогда
					Продолжить;
				КонецЕсли;	
			КонецЕсли;
			
			ОбъектXDTOЭлементаМассива = ПолучитьОбъектXDTO(Фабрика, ЭлементРодитель.Тип(), ОбъектXDTOМассиваПоНастройке.Имя);
			
			Если ОбъектXDTOЭлементаМассива.Свойства().Количество() = 0 Тогда
				// Не удалось создать ОбъектXDTO по схеме.
				Для Каждого СвойствоЭлемента из ЭлементМассива.Свойства() Цикл
					АтрибутЭлементаМассиваПоНастройкеОбъектXDTO = ЭлементМассива[СвойствоЭлемента.Имя];
					Если АтрибутЭлементаМассиваПоНастройкеОбъектXDTO.Тип = "Текст" Тогда 
						Продолжить;
					КонецЕсли;					
					ЭлементДанныхString = ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "string");
					ЭлементДанных = ФабрикаXDTO.Создать(ЭлементДанныхString, "");
					ОбъектXDTOЭлементаМассива.Добавить(?(АтрибутЭлементаМассиваПоНастройкеОбъектXDTO.Тип = "Атрибут", ФормаXML.Атрибут, ФормаXML.Элемент), ФорматВыгрузки, СокрЛП(СвойствоЭлемента.Имя), ЭлементДанных);
				КонецЦикла;	
			КонецЕсли;
			
			Для Каждого СвойствоXDTOЭлементаМассиваПоНастройке из ЭлементМассива.Свойства() Цикл
				
				Если СвойствоXDTOЭлементаМассиваПоНастройке.Форма = ФормаXML.Атрибут ИЛИ СвойствоXDTOЭлементаМассиваПоНастройке.Имя = "ИсточникДанныхДляМассива" ИЛИ НЕ СтрНайти(СвойствоXDTOЭлементаМассиваПоНастройке.Имя, "Условия") = 0 Тогда
					Продолжить;	
				КонецЕсли;
				
				Если СвойствоXDTOЭлементаМассиваПоНастройке.Имя = "УсловияВыгрузкиЭлемента" Тогда
					Продолжить;
				КонецЕсли;
				
				ОбъектXDTOЭлементаМассиваПоНастройке = ЭлементМассива[СвойствоXDTOЭлементаМассиваПоНастройке.Имя]; 
				
				Если ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Атрибут" Тогда
					ЗаполнитьАтрибутЭлемента(ОбъектXDTOЭлементаМассива, ОбъектXDTOЭлементаМассиваПоНастройке, ПараметрыФормирования);
				ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Элемент" Тогда
					ОбработатьВложенныйЭлемент(ОбъектXDTOЭлементаМассива, ОбъектXDTOЭлементаМассиваПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
				ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Текст" Тогда
					ЗаполнитьТекстЭлемента(ОбъектXDTOЭлементаМассива, ОбъектXDTOЭлементаМассиваПоНастройке, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);	
				ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "МассивПоИсточнику" Тогда
					ЗаполнитьМассивЭлементаПоИсточнику(ОбъектXDTOЭлементаМассива, ОбъектXDTOЭлементаМассиваПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
				ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Массив" Тогда
					ЗаполнитьМассивЭлемента(ОбъектXDTOЭлементаМассива, ОбъектXDTOЭлементаМассиваПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
				КонецЕсли;
				
			КонецЦикла;
			
			ЭлементРодитель.Добавить(ФормаXML.Элемент, ФорматВыгрузки, СокрЛП(ОбъектXDTOМассиваПоНастройке.Имя), ОбъектXDTOЭлементаМассива);
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ОбъектXDTOМассиваПоНастройке.ЭлементМассива) = Тип("ОбъектXDTO") Тогда
		
		ЭлементМассива = ОбъектXDTOМассиваПоНастройке.ЭлементМассива;
		
		Если НЕ ЭлементМассива.Свойства().Получить("УсловияВыгрузкиЭлемента") = Неопределено Тогда	
			УсловиеВыполнено = РезультатОбработкиУсловия(ЭлементМассива, ПараметрыФормирования);
			Если УсловиеВыполнено = Ложь Тогда
				Возврат;
			КонецЕсли;	
		КонецЕсли;	
		
