				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Возвращаем результат на клиент
	Результат = Новый Структура;
	Результат.Вставить("Кэш", Кэш);
	Результат.Вставить("ВыгрузкаДокументов", ВыгрузкаДокументов);

	Возврат Результат;
	
КонецФункции

// Функция проверяет, удовлетворяют ли документы в списке заданному в файле настройки набору условий.
// Если хотя бы одно из условий соблюдено, документ будет удалён из списка и отправка не произойдёт.
Функция ПроверитьСписокДокументовНаСоответствиеУсловиямОтменыВыгрузки(СписокДокументов, УсловияОтменыВыгрузки, ПараметрыФормирования)
	
	СписокПереданКакМассив = Ложь;
	СписокСодержитДопДанныеПоФактурам = Ложь;
	
	Если НЕ ТипЗнч(СписокДокументов) = Тип("Массив") И НЕ СписокДокументов.Колонки.Найти("Фактура") = Неопределено Тогда
		ОтредактированныйСписокДокументов = Новый ТаблицаЗначений;
		ОтредактированныйСписокДокументов.Колонки.Добавить("Ссылка");
		ОтредактированныйСписокДокументов.Колонки.Добавить("Фактура");
		СписокСодержитДопДанныеПоФактурам = Истина;
	Иначе
		ОтредактированныйСписокДокументов = Новый Массив;
		Если ТипЗнч(СписокДокументов) = Тип("Массив") Тогда
			СписокПереданКакМассив = Истина;
		КонецЕсли;	
	КонецЕсли;
	
	Если ТипЗнч(УсловияОтменыВыгрузки.УсловиеОтменыВыгрузки) = Тип("СписокXDTO") Тогда
		ПереченьУсловий = УсловияОтменыВыгрузки.УсловиеОтменыВыгрузки;	
	Иначе
		ПереченьУсловий = Новый Массив;
		ПереченьУсловий.Добавить(УсловияОтменыВыгрузки[УсловияОтменыВыгрузки.Свойства()[0].Имя]);
	КонецЕсли;	
		
	ПараметрыПроверкиДокумента = Новый Структура;
	ПараметрыПроверкиДокумента.Вставить("СписокПереданКакМассив", СписокПереданКакМассив);
	ПараметрыПроверкиДокумента.Вставить("СписокСодержитДопДанныеПоФактурам", СписокСодержитДопДанныеПоФактурам);
	
	ПараметрыФормирования.Вставить("ПараметрыПроверкиДокумента", ПараметрыПроверкиДокумента);
	
	//Если СписокСодержитДопДанныеПоФактурам Тогда
	//	
	//Иначе
	//	
	//КонецЕсли;	
	
	КоличествоДокументов = СписокДокументов.Количество();
	Для ОбратныйИндекс = 1 По КоличествоДокументов Цикл
	//Для Каждого ЭлементСпискаДокументов Из СписокДокументов Цикл
	
		ЭлементСпискаДокументов = СписокДокументов[КоличествоДокументов - ОбратныйИндекс];
		
		ПараметрыПроверкиДокумента.Вставить("ЭлементСпискаДокументов", ЭлементСпискаДокументов);
		
		Для Каждого Условие ИЗ ПереченьУсловий Цикл
			
			МетодРасчетаЗначенияУсловия = Условие.Источник.МетодРасчетаЗначения;
			ЗначениеУсловия = РассчитатьЗначениеПоМетодуРасчета(Условие, ПараметрыФормирования);
																
			Если ЗначениеУсловия = Неопределено И НЕ МетодРасчетаЗначенияУсловия = "Неопределено" Тогда
				ПроверкаБылаСкомпроментирована = Истина;
				// Необходимо сообщить, что проверка задана некорректно.
				Если СписокПереданКакМассив = Истина Тогда
					СписокДокументов.Удалить(КоличествоДокументов - ОбратныйИндекс);
				Иначе	
					СписокДокументов.Удалить(ЭлементСпискаДокументов);
				КонецЕсли;	
				Продолжить;                                                                                                                     
			КонецЕсли;	
			
			ЗначениеСравнения = РассчитатьЗначениеПоМетодуРасчета(Условие.ПризнакСравнения, ПараметрыФормирования); 
			
			Если НЕ ЗначениеУсловия = ЗначениеСравнения Тогда
				// Условие не отработало. Всё хорошо.
				Продолжить;
			Иначе	
				// Условие отработало. Документ выгружать нельзя.
				// Выводим сопроводительное сообщение, если таковое объявлено.
				// ⚠️🔴 Свойства() отдаёт свойства ТИПА, а не заполненные значения ⟹ узел
				//    «ПредупреждениеОбОтменеВыгрузки» находился ВСЕГДА, и у условия без
				//    предупреждения следующая строка падала: «Значение не является значением
				//    объектного типа (ТекстПредупрежденияОтменыВыгрузки)». Ловится на любом
				//    документе, который отсекается УсловиемОтменыВыгрузки.
				//    Тот же класс, что исправлен в PR #1 для СвИП/СвЮЛУч — проверяем ЗНАЧЕНИЕ.
				// ⚠️ Мало сравнить с Неопределено: незаполненный узел приходит СТРОКОЙ, и обращение
				//    к её свойству падает так же. Проверяем тип — приём самого движка, стр. ~1400
				//    (Подписант.ЮЛ / .ИП / .ФЛ там страхуются именно ТипЗнч = ОбъектXDTO).
				Если ТипЗнч(Условие.ПредупреждениеОбОтменеВыгрузки) = Тип("ОбъектXDTO") Тогда
					ТекстПредупрежденияОтменыВыгрузки = Условие.ПредупреждениеОбОтменеВыгрузки.ТекстПредупрежденияОтменыВыгрузки;
					Если НЕ Условие.ПредупреждениеОбОтменеВыгрузки.ТекстСодержитВычисляемыеЭлементы = Неопределено 
							И Условие.ПредупреждениеОбОтменеВыгрузки.ТекстСодержитВычисляемыеЭлементы = "Истина" Тогда
						Выполнить("ТекстПредупрежденияОтменыВыгрузки = """+СокрЛП(Условие.ПредупреждениеОбОтменеВыгрузки.ТекстПредупрежденияОтменыВыгрузки)+""";");	
					КонецЕсли;		
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = СокрЛП(ТекстПредупрежденияОтменыВыгрузки);
					Сообщение.Сообщить();
				КонецЕсли;
				Если СписокПереданКакМассив = Истина Тогда
					СписокДокументов.Удалить(КоличествоДокументов - ОбратныйИндекс);
				Иначе	
					СписокДокументов.Удалить(ЭлементСпискаДокументов);
				КонецЕсли;
				Прервать;
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЦикла;	
	
	Возврат СписокДокументов; 

КонецФункции	

// Функция возвращает список настроек обработки ОФД ЭДО
// 
// Возращаемые значения:
// Список настроек из хранилища общих настроек (Тип данных: список значений)
Функция ОФД_ЭДО_ПолучитьСписокНастроек() Экспорт
	
	ПользовательВладелецНастроек = ПолучитьТекущегоПользователя();
	
	УстановитьПривилегированныйРежим(Истина);
	Возврат ХранилищеОбщихНастроек.ПолучитьСписок("ОФД_ЭДО_НастройкиОбработки", ПользовательВладелецНастроек);
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

// ИмяСобытия - Имя события.
// ПредставлениеУровня - "Информация", "Ошибка", "Предупреждение", "Примечание". 
// Комментарий - информационный тект.
Процедура ЗаписьВЖурналРегистрации(ИмяСобытия, ПредставлениеУровня, Комментарий)
	
	СтруктураЗаписи = Новый Структура;
	СтруктураЗаписи.Вставить("ИмяСобытия", ИмяСобытия);
	СтруктураЗаписи.Вставить("ПредставлениеУровня", ПредставлениеУровня);
	СтруктураЗаписи.Вставить("Комментарий", Комментарий);        
	СтруктураЗаписи.Вставить("ДатаСобытия", ТекущаяДата());
	
    СобытияДляЖурналаРегистрации = Новый СписокЗначений;
	СобытияДляЖурналаРегистрации.Добавить(СтруктураЗаписи);
	
	// >>> ПАТЧ УТ 10.3: модуля ЖурналРегистрацииВызовСервера в УТ 10.3 нет (это БСП).
	// Через Выполнить + Попытку: в поддерживаемых конфигурациях работает как раньше,
	// в УТ 10.3 просто не пишет в журнал.
	Попытка
		Выполнить("ЖурналРегистрацииВызовСервера.ЗаписатьСобытияВЖурналРегистрации(СобытияДляЖурналаРегистрации)");
	Исключение
		// журнал регистрации недоступен в этой конфигурации — не критично
	КонецПопытки;
	// <<< ПАТЧ УТ 10.3
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыФункции

Функция ПолучитьСтруктуруПодписанта(XDTO)
	
	Структура = Новый Структура;
	Структура.Вставить("Фамилия");
	Структура.Вставить("Имя");
	Структура.Вставить("Отчество");
	Структура.Вставить("ИНН");
	
	// В модели подписант это список XDTO, учитывая то, что в ЭДО подписант всегда 1, берем первый элемент списка
	Подписант = ?(ТипЗнч(XDTO) = Тип("СписокXDTO"), XDTO[0], XDTO);
	
	Если НЕ Подписант.Свойства().Получить("ЮЛ") = Неопределено И ТипЗнч(Подписант.ЮЛ) = Тип("ОбъектXDTO") Тогда
		
		Структура.Фамилия 	= Подписант.ЮЛ.ФИО.Фамилия;
		Структура.Имя		= Подписант.ЮЛ.ФИО.Имя;
		Структура.Отчество	= ?(НЕ Подписант.ЮЛ.ФИО.Свойства().Получить("Отчество") = Неопределено, Подписант.ЮЛ.ФИО.Отчество, "");
		
		Структура.ИНН 		= Подписант.ЮЛ.ИННЮЛ;
		
	КонецЕсли;
	
	Если НЕ Подписант.Свойства().Получить("ИП") = Неопределено И ТипЗнч(Подписант.ИП) = Тип("ОбъектXDTO") Тогда
		
		Структура.Фамилия 	= Подписант.ИП.ФИО.Фамилия;
		Структура.Имя		= Подписант.ИП.ФИО.Имя;
		Структура.Отчество	= ?(НЕ Подписант.ИП.ФИО.Свойства().Получить("Отчество") = Неопределено, Подписант.ИП.ФИО.Отчество, "");
		
		Структура.ИНН 		= Подписант.ИП.ИННФЛ;       		
		
	КонецЕсли;
	
	Если НЕ Подписант.Свойства().Получить("ФЛ") = Неопределено И ТипЗнч(Подписант.ФЛ) = Тип("ОбъектXDTO") Тогда
		
		Структура.Фамилия 	= Подписант.ФЛ.ФИО.Фамилия;
		Структура.Имя		= Подписант.ФЛ.ФИО.Имя;
		Структура.Отчество	= ?(НЕ Подписант.ФЛ.ФИО.Свойства().Получить("Отчество") = Неопределено, Подписант.ФЛ.ФИО.Отчество, "");
		
		Структура.ИНН 		= Подписант.ФЛ.ИННФЛ; 		
		
	КонецЕсли;
	
	Возврат Структура;      
	
КонецФункции

Функция ПолучитьСтруктуруПодписанта5_03(XDTO)
	
	Структура = Новый Структура;
	Структура.Вставить("Фамилия");
	Структура.Вставить("Имя");
	Структура.Вставить("Отчество");
	Структура.Вставить("ИНН");
	
	// В модели подписант это список XDTO, учитывая то, что в ЭДО подписант всегда 1, берем первый элемент списка
	Подписант = ?(ТипЗнч(XDTO.Подписант) = Тип("СписокXDTO"), XDTO.Подписант[0], XDTO.Подписант);
	
	Структура.Фамилия 	= Подписант.ФИО.Фамилия;
	Структура.Имя		= Подписант.ФИО.Имя;
	Структура.Отчество	= ?(НЕ Подписант.ФИО.Свойства().Получить("Отчество") = Неопределено, Подписант.ФИО.Отчество, "");
	
	СвПрод = ?(ТипЗнч(XDTO.СвСчФакт.СвПрод) = Тип("СписокXDTO"), XDTO.СвСчФакт.СвПрод[0], XDTO.СвСчФакт.СвПрод);
	
	// ⚠️ Свойства() отдаёт список свойств ТИПА, а не заполненных значений ⟹ "СвИП" находится
	//    всегда, и у продавца-ЮЛ ветка уходила в незаполненный СвИП: «Значение не является
	//    значением объектного типа (ИННФЛ)». Проверяем сами ЗНАЧЕНИЯ.
	Если НЕ СвПрод.ИдСв.СвИП = Неопределено Тогда 
		Структура.Вставить("ИНН", СвПрод.ИдСв.СвИП.ИННФЛ);
	ИначеЕсли НЕ СвПрод.ИдСв.СвЮЛУч = Неопределено Тогда
		Структура.Вставить("ИНН", СвПрод.ИдСв.СвЮЛУч.ИННЮЛ);
	КонецЕсли;	
	
	Возврат Структура;      
	
КонецФункции

