	КонецЕсли;
	Если СтрНайти(ВерсияКонфигурации.ПодробнаяИнформация, "Управление сервисным центром, редакция 3.0") > 0 И СтрНайти(ВерсияКонфигурации.Версия, "3.0") > 0 Тогда
		Возврат "УСЦ_3_0_";
	КонецЕсли;
	
	// >>> ПАТЧ УТ 10.3
	// Метаданные базы trade: ПодробнаяИнформация = "Управление торговлей", редакция 10.3
	//                        Версия               = 10.3.88.3
	// Ветки УТ 11 выше не срабатывают: они ищут "Управление торговлей, редакция 11".
	// Ставится ПЕРЕД возвратом Ложь, чтобы не влиять на остальные конфигурации.
	Если СтрНайти(ВерсияКонфигурации.ПодробнаяИнформация, "Управление торговлей") > 0 И СтрНайти(ВерсияКонфигурации.Версия, "10.3") > 0 Тогда
		Возврат "УТ_10_3_";
	КонецЕсли;
	// <<< ПАТЧ УТ 10.3

	// Конфигурация не поддерживается
	Возврат Ложь;
	
КонецФункции

// Процедура распаковывает настройки для конфигурации во временный каталог 1С на сервере
//Входящие параметры
// Конфигурация		 - строка с префиксом текущей конфигурации
Процедура РаспаковатьНастройкиДляОбработки(МакетСНастройками, Кэш, ПрефиксКонфигурации = Неопределено)
	
	// Распаковываем основные настройки
	ДанныеМакета = ПолучитьМакет(МакетСНастройками);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("zip");
	ДанныеМакета.Записать(ИмяВременногоФайла);

	Архив = Новый ЧтениеZipФайла(ИмяВременногоФайла);
	ИмяВременногоКаталога = ПолучитьИмяВременногоФайла();
	
	СоответствиеНастроек = Новый Соответствие();
	
	Для Каждого Элемент Из Архив.Элементы Цикл 
		
		ПризнакРаспаковкиЭлемента = Ложь;
		// Распаковываем настройки только для текущей конфигурации
		Если ПрефиксКонфигурации <> Неопределено и Найти(Элемент.ИмяБезРасширения, ПрефиксКонфигурации) > 0 Тогда
			ПризнакРаспаковкиЭлемента = Истина; 			
		// Распаковываем все настройки из макета
		ИначеЕсли ПрефиксКонфигурации = Неопределено Тогда
			ПризнакРаспаковкиЭлемента = Истина;			
		КонецЕсли;
		
		Если ПризнакРаспаковкиЭлемента Тогда
			
			Архив.Извлечь(Элемент, ИмяВременногоКаталога, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);   		

			Файл = Новый ТекстовыйДокумент;
			Файл.Прочитать(ИмяВременногоКаталога + "\" + Элемент.Имя);
			Настройка = Файл.ПолучитьТекст();
			СоответствиеНастроек.Вставить(Элемент.ИсходноеИмяБезРасширения, Настройка);			
			
			// Чистим за собой временные файлы      			
			УдалитьФайлы(ИмяВременногоКаталога + "\" + Элемент.Имя);
		КонецЕсли; 
		
	КонецЦикла;  
	
	Кэш.Вставить(МакетСНастройками, СоответствиеНастроек);
	
	Архив.Закрыть();
	УдалитьФайлы(ИмяВременногоФайла);
	
КонецПроцедуры

Функция РаспаковатьНастройкиИзХранилища(ПрефиксКонфигурации) Экспорт
	
	СписокНашихНастроек = ОФД_ЭДО_ПолучитьСписокНастроек();
	
	ПользовательВладелецНастроек = ПолучитьТекущегоПользователя();
	
	Соответствие = Новый Соответствие;
	
	УстановитьПривилегированныйРежим(Истина);
	// Если обработка запускается впервые, то настроек в базе еще нет и их нужно создать из стандартных настроек
	Если СписокНашихНастроек.Количество() <> 0 Тогда
		
		Для Каждого Настройка из СписокНашихНастроек Цикл
			
			Если Найти(Настройка.Значение, ПрефиксКонфигурации) > 0 Тогда
				ТекстНастройки = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", 									// Ключ объекта
															Настройка.Значение,														// Ключ настройки 
															"Настройка " + Настройка.Значение + " для внешней обработки ОФД ЭДО.",  // описание настройки
															ПользовательВладелецНастроек); 											// Пользователь
				Соответствие.Вставить(Настройка.Значение, ТекстНастройки);
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		Сообщить("Обнаружена ошибка в пользовательских настройках. Нажмите на кнопку К стандартным настройкам.");
		Возврат Неопределено;
		
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Соответствие;
	
КонецФункции

//Процедура инициализации настроек из хранилища общих настроек
// Входящие параметры
// Структура настроек, где Шаблон-фабрика настройки, а соответствие - путь до файла настройки
Процедура ИнициализацияНастроек(Соответствие, ЗаменитьНастройкиНаСтандартные = Ложь) Экспорт
	
	СписокНашихНастроек = ОФД_ЭДО_ПолучитьСписокНастроек();
	
	ПользовательВладелецНастроек = ПолучитьТекущегоПользователя();
	
	УстановитьПривилегированныйРежим(Истина);
	// Если обработка запускается впервые, то настроек в базе еще нет и их нужно создать из стандартных настроек
	Если СписокНашихНастроек.Количество() = 0 или ЗаменитьНастройкиНаСтандартные Тогда
		Для Каждого Настройка из Соответствие Цикл
			
			
			ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", 	// Ключ объекта
												Настройка.Ключ,				// Ключ настройки 
												Настройка.Значение,			// Настройка
												"Настройка " + Настройка.Ключ + " для внешней обработки ОФД ЭДО.", // описание настройки
												ПользовательВладелецНастроек); // Пользователь   			
			
		КонецЦикла;   		
		
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Функция восстанавливает настройку к стандартным значениям
//
// Входящие параметры
// НаименованиеНастройки - добавляемая настройка (ТипДанных:Строка)
// Кэш (ТипДанных: Структура)
// ЗаменитьНастройкуНаСтандартную(необязательный) - если передать Истина, то перезапишет настройку в хранилище на стандартную из макета (Тип данных: Булево)
//
// Возвращаемые значения:
// Истина 	- настройка успешно добавлена
// Ложь 	- настройка не добавлена
Функция ЗагрузитьНастройкуВХранилищеОбщихНастроек(НаименованиеНастройки, Кэш, ЗаменитьНастройкуНаСтандартную = Ложь) Экспорт
	
	СписокЗначений = ОФД_ЭДО_ПолучитьСписокНастроек();
	ТребуемаяНастройка = СписокЗначений.НайтиПоЗначению(НаименованиеНастройки);
	
	ПользовательВладелецНастроек = ПолучитьТекущегоПользователя();
	
	// Требуемая настройка уже в хранилище значений и ее не надо перезаписывать
	Если ТипЗнч(ТребуемаяНастройка) = Тип("ЭлементСпискаЗначений") и Не ЗаменитьНастройкуНаСтандартную Тогда
		Возврат Истина;	
	КонецЕсли;

	// Проверяем есть ли в Кэш текстовые значения настроек
	Если Не Кэш.Свойство("Настройки") Тогда
		// Если нет, то распакуем их из макета
		РаспаковатьНастройкиДляОбработки("Настройки", Кэш, Кэш.ПрефиксКонфигурации);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);

	// Если искомая настройка в макете есть
	Если Кэш.Настройки[НаименованиеНастройки] Тогда
		
		ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", 						// Ключ объекта
											НаименованиеНастройки,							// Ключ настройки 
											Кэш.Настройки[НаименованиеНастройки],			// Настройка
											"Настройка " + НаименованиеНастройки + " для внешней обработки ОФД ЭДО.", // описание настройки
											ПользовательВладелецНастроек); 					// Пользователь   	
		Возврат Истина;
		
	Иначе 
		Сообщить ("Не удалось восстановить настройку: " + НаименованиеНастройки + " по причине: не найдена стандартная настройка с таким именем!");
		Возврат Ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

// Функция проверяет наличие необходимой настройки в системе по наименованию настройки
//
// Входящие параметры
// НаименованиеНастройки - наименование настройки (ТипДанных:Строка)
//
// Возвращаемые значения:
// Строка с текстом настройки из хранилища настроек
Функция ПолучитьНастройкуИзХранилищаОбщихНастроек(НаименованиеНастройки) Экспорт
	
	СписокЗначений = ОФД_ЭДО_ПолучитьСписокНастроек();
	ТребуемаяНастройка = СписокЗначений.НайтиПоЗначению(НаименованиеНастройки);
	
	ПользовательВладелецНастроек = ПолучитьТекущегоПользователя();
	
	Если ТипЗнч(ТребуемаяНастройка) = Тип("ЭлементСпискаЗначений") Тогда
		
		УстановитьПривилегированныйРежим(Истина);    
		Возврат ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", 	// Ключ объекта
											НаименованиеНастройки,				// Ключ настройки 
											"Настройка " + НаименованиеНастройки + " для внешней обработки ОФД ЭДО.", // описание настройки
											ПользовательВладелецНастроек); 		// Пользователь
		УстановитьПривилегированныйРежим(Ложь);
										
	Иначе
		
		Сообщить("Не удалось загрузить настройку: " + НаименованиеНастройки + " по причине: Не найдена настройка!");
		Возврат Неопределено;
											
	КонецЕсли;   
	
КонецФункции

// Функция определяет поддерживается ли используемая конфигурация обработкой ОФД ЭДО
//
// Возвращаемые значения:
// Истина 	- конфигурация поддерживается
// Ложь 	- конфигурация не поддерживается    
Функция ПоддерживаемаяКонфигурация(Конфигурация)
	
	СписокПоддерживаемыхКонфигураций = Новый СписокЗначений();
	СписокПоддерживаемыхКонфигураций.Добавить("ERP_2_2_");
	СписокПоддерживаемыхКонфигураций.Добавить("ERP_2_4_");
	СписокПоддерживаемыхКонфигураций.Добавить("ERP_2_5_");
	СписокПоддерживаемыхКонфигураций.Добавить("БУХ_3_0_");
	СписокПоддерживаемыхКонфигураций.Добавить("УТ_11_4_");
	СписокПоддерживаемыхКонфигураций.Добавить("УТ_11_5_");
	СписокПоддерживаемыхКонфигураций.Добавить("КА_2_4_");
	СписокПоддерживаемыхКонфигураций.Добавить("КА_2_5_");
	СписокПоддерживаемыхКонфигураций.Добавить("Розн_2_3_");
	СписокПоддерживаемыхКонфигураций.Добавить("Розн_3_0_");
	СписокПоддерживаемыхКонфигураций.Добавить("УНФ_1_6_");
	СписокПоддерживаемыхКонфигураций.Добавить("УНФ_3_0_");
	//СписокПоддерживаемыхКонфигураций.Добавить("ДалионТР_3_0_");
	СписокПоддерживаемыхКонфигураций.Добавить("Общепит_3_0_");
	СписокПоддерживаемыхКонфигураций.Добавить("УСЦ_3_0_");
	// >>> ПАТЧ УТ 10.3
	СписокПоддерживаемыхКонфигураций.Добавить("УТ_10_3_");
	// <<< ПАТЧ УТ 10.3
	
	Если СписокПоддерживаемыхКонфигураций.НайтиПоЗначению(Конфигурация) = Неопределено Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;		
	КонецЕсли;   	
	
КонецФункции

// Функция получает параметры интеграции из хранилища общих настроек
// Параметры интеграции хранятся относительно текущего пользователя
Функция ПолучитьИнтеграциюНаСервере(ПользовательВладелецНастроек = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ПользовательВладелецНастроек = Неопределено Тогда              
		ПользовательВладелецНастроек = ПолучитьТекущегоПользователя();
	КонецЕсли;
	
	СписокЗначений = ХранилищеОбщихНастроек.ПолучитьСписок("ОФД_ЭДО_НастройкиОбработки", ПолучитьТекущегоПользователя());
	Интеграция = СписокЗначений.НайтиПоЗначению("Интеграция");
	
	// Информация об интеграции уже есть в хранилище значений 
	Если ТипЗнч(Интеграция) = Тип("ЭлементСпискаЗначений") Тогда
		
		Возврат ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", 	// Ключ объекта
		"Интеграция",															// Ключ настройки 
		"Информация о способе интеграции обработки ОФД ЭДО.", 					// описание настройки
		ПользовательВладелецНастроек); 											// Пользователь
		
	Иначе 
				
		Возврат Неопределено;
		
	КонецЕсли; 	
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

Процедура СохранитьИнтеграциюНаСервере(Интеграция) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", 	// Ключ объекта
	"Интеграция",													// Ключ настройки 
	Интеграция,														// Настройка
	"Информация о способе интеграции обработки ОФД ЭДО.", 			// описание настройки
	ПолучитьТекущегоПользователя()); 								// Пользователь     
	
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры

// Функция возвращает клиентские настройки работы с эл. документами.
Функция ПолучитьСохраненныеКлиентскиеНастройки() Экспорт
	
	КлиентскиеНастройкиМассив = Неопределено;
	
	ПользовательВладелецНастроек = ПолучитьТекущегоПользователя();
	
	// Проверяем наличие клиентских настроек. Если есть - заполняем таблицу.
	УстановитьПривилегированныйРежим(Истина);
	СписокЗначений = ХранилищеОбщихНастроек.ПолучитьСписок("ОФД_ЭДО_НастройкиОбработки", ПользовательВладелецНастроек);
	Интеграция = СписокЗначений.НайтиПоЗначению("КлиентскиеНастройки");
	
	// Информация об интеграции уже есть в хранилище значений 
	Если ТипЗнч(Интеграция) = Тип("ЭлементСпискаЗначений") Тогда
		
		КлиентскиеНастройкиМассив =  ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки",					// Ключ объекта
				"КлиентскиеНастройки",																				// Ключ настройки 
				"Клиентские настройки формирования исходящих эл. документов и загрузки входящих эл. документов.",	// описание настройки
				ПользовательВладелецНастроек); 
				
	КонецЕсли;
			
	УстановитьПривилегированныйРежим(Ложь);		
			
	Возврат КлиентскиеНастройкиМассив;		
	
КонецФункции

#КонецОбласти
                             
