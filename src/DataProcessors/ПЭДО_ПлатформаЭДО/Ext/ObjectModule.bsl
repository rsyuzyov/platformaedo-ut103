									СтруктураЗначениеИВладелецDOM.Владелец.ДобавитьДочерний(ЭлементДокументаDOM);
								КонецЕсли;	
							КонецЕсли;	
								
						КонецЕсли;
						
						ВариантОбработан = Истина;
							
					КонецЕсли
						
				КонецЕсли;
			
				Если НЕ ВариантОбработан И НЕ НастройкаОбъектXDTO.ВариантыИсточника.Свойства().Получить("ВариантИсключение") = Неопределено Тогда
					
					ВариантXDTO = НастройкаОбъектXDTO.ВариантыИсточника.ВариантИсключение;
					
					Если НастройкаОбъектXDTO.Тип = "Атрибут" Тогда 
						
						Путь = ПолучитьПутьКАтрибутуЭлементу(НастройкаОбъектXDTO, НастройкаОбъектXDTO.Тип);
						
						СтруктураЗначениеИВладелецDOM = ПолучитьЗначениеУзлаИВладельцаПоПути_DOM(ДокументDOM, Путь);
						ОбрабатываемыйУзелТекущегоУровня = ПараметрыФормирования.ОбрабатываемыйУзелДокумента;
						ПараметрыФормирования.Вставить("ОбрабатываемыйУзелДокумента", СтруктураЗначениеИВладелецDOM.Владелец);
						
						Если НЕ СтруктураЗначениеИВладелецDOM = Неопределено Тогда
							Если НЕ СтруктураЗначениеИВладелецDOM.Значение = Неопределено Тогда
								ЗначениеАтрибута = РассчитатьЗначениеПоМетодуРасчета(ВариантXDTO, ПараметрыФормирования);
								СтруктураЗначениеИВладелецDOM.Владелец.УстановитьАтрибут(СтруктураЗначениеИВладелецDOM.Значение.ИмяУзла, ЗначениеАтрибута);
							Иначе
								// Не обнаружен атрибут. Но его все равно можно создать и заполнить.
								ЗначениеАтрибута = РассчитатьЗначениеПоМетодуРасчета(ВариантXDTO, ПараметрыФормирования);
								СтруктураЗначениеИВладелецDOM.Владелец.УстановитьАтрибут(НастройкаОбъектXDTO.Имя, ЗначениеАтрибута);
							КонецЕсли;	
						КонецЕсли;
						
						ПараметрыФормирования.Вставить("ОбрабатываемыйУзелДокумента", ОбрабатываемыйУзелТекущегоУровня);
						
					ИначеЕсли НастройкаОбъектXDTO.Тип = "Элемент" Тогда	
						
						// Создаем элемент в структуре документа.
						
						Путь = ПолучитьПутьКАтрибутуЭлементу(НастройкаОбъектXDTO, НастройкаОбъектXDTO.Тип);
						
						СтруктураЗначениеИВладелецDOM = ПолучитьЗначениеУзлаИВладельцаПоПути_DOM(ДокументDOM, Путь);
						
						Если НЕ СтруктураЗначениеИВладелецDOM = Неопределено Тогда
							Если НЕ СтруктураЗначениеИВладелецDOM.Значение = Неопределено Тогда
								// Элемент уже существует.
							Иначе
								// Необходимо создать элемент.
								Если ТипЗнч(ДокументDOM) = Тип("ДокументDOM") Тогда
									ЭлементДокументаDOM = ДокументDOM.СоздатьЭлемент(НастройкаОбъектXDTO.Имя);
								ИначеЕсли ТипЗнч(ДокументDOM) = Тип("ЭлементDOM") Тогда
									ЭлементДокументаDOM = ДокументDOM.ДокументВладелец.СоздатьЭлемент(НастройкаОбъектXDTO.Имя);
								КонецЕсли;
								СтруктураЗначениеИВладелецDOM.Владелец.ДобавитьДочерний(ЭлементДокументаDOM);
							КонецЕсли;	
						КонецЕсли;	
							
					КонецЕсли;
					
				КонецЕсли;	
				
			КонецЕсли;
			
		ИначеЕсли НастройкаОбъектXDTO.ЭтоМассив = "Истина" Тогда
			
			СтруктураЗначениеИВладелецDOM = ПолучитьЗначениеУзлаИВладельцаПоПути_DOM(ДокументDOM, НастройкаОбъектXDTO.ПутьКМассиву);
			ОбрабатываемыйУзелТекущегоУровня = ПараметрыФормирования.ОбрабатываемыйУзелДокумента;
			ПараметрыФормирования.Вставить("ОбрабатываемыйУзелДокумента", СтруктураЗначениеИВладелецDOM.Владелец);
			
			Для Каждого УзелЭлементаМассива из СтруктураЗначениеИВладелецDOM.Владелец.ДочерниеУзлы Цикл
				Если УзелЭлементаМассива.ИмяУзла = НастройкаОбъектXDTO.Имя Тогда  
					ПараметрыФормирования.Вставить("ИсточникДанныхДляМассива", ИсточникДанныхДляМассива);
					ОбработатьРезультатФормирования_DOM(УзелЭлементаМассива, НастройкаОбъектXDTO, ФорматВыгрузки, Кэш, Документ, ПараметрыФормирования);
				КонецЕсли;	
			КонецЦикла;
			
			ПараметрыФормирования.Вставить("ОбрабатываемыйУзелДокумента", ОбрабатываемыйУзелТекущегоУровня);
							
		КонецЕсли;	
		
	КонецЦикла;
	
	
	Если НЕ ДанныеПереданыВВидеDOM Тогда
		
		ПараметрыЗаписи = Новый ПараметрыЗаписиXML("Windows-1251", "1.0", Истина, Истина);
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку(ПараметрыЗаписи); 
		ЗаписьDOM = Новый ЗаписьDOM;
		ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
		XML = ЗаписьXML.Закрыть();	
		
		Если ДанныеПереданыВВидеXDTO Тогда
			
			ИтоговыйОбъектXDTO = СоздатьОбъектXDTOИзXML(XML, Фабрика);
			СтруктураДанных = ИтоговыйОбъектXDTO;
			
		Иначе
			
			// Пространства имен не нужны.
			XML = УдалитьПространствоИменИзXML(XML, ФорматВыгрузки);		
			СтруктураДанных = XML;
			
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры	

Функция ПолучитьЗначениеУзлаИВладельцаПоПути_DOM(ОбрабатываемыйЭлементDOM, Путь)
		
	СтруктураЗначениеУзлаВладелец = Неопределено;
	ПутьМассивУзлов = СтрРазделить(Путь, ".");
	
	Если ПутьМассивУзлов.Количество() = 0 ИЛИ ПутьМассивУзлов[0] = "" Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	УзелDOM = ОбрабатываемыйЭлементDOM;
	ОбрабатываемыйДокументDOM = ОбрабатываемыйЭлементDOM.ДокументВладелец;
	
	Счетчик = 1;
	Для Каждого Узел Из ПутьМассивУзлов Цикл
			
		Если Счетчик < ПутьМассивУзлов.Количество() Тогда
			Владелец = ПолучитьЭлементУзлаDOM(УзелDOM, Узел);
			Если Владелец = Неопределено Тогда
				// Соответствующего узла нет в структуре документа, требуется создание.
				ЭлементДокументаDOM = ОбрабатываемыйДокументDOM.СоздатьЭлемент(Узел);
				УзелDOM.ДобавитьДочерний(ЭлементДокументаDOM);
				Владелец = ПолучитьЭлементУзлаDOM(УзелDOM, Узел);
			КонецЕсли;	
		ИначеЕсли Счетчик = ПутьМассивУзлов.Количество() Тогда
			Если УзелDOM = ОбрабатываемыйДокументDOM И Владелец = Неопределено Тогда
				// Если головной узел - сам документ и Владелец неопределен, значит идет обращение к головному узлу "Файл".
				Владелец = ПолучитьЭлементУзлаDOM(УзелDOM, "Файл");
			ИначеЕсли Владелец = Неопределено Тогда
				// Работаем с подчиненный узлом переданного элемента.
				Если НЕ ПутьМассивУзлов.Количество() = 1 Тогда 
					ЭлементДокументаDOM = ОбрабатываемыйДокументDOM.СоздатьЭлемент(Узел);
					УзелDOM.ДобавитьДочерний(ЭлементДокументаDOM);
					Владелец = ПолучитьЭлементУзлаDOM(УзелDOM, Узел);
				Иначе
					Владелец = УзелDOM;
				КонецЕсли;	
			КонецЕсли;	
			Для Каждого ДочернийУзел из Владелец.ДочерниеУзлы Цикл
				Если ДочернийУзел.ИмяУзла = Узел Тогда
					// Нашли.
					СтруктураЗначениеУзлаВладелец = Новый Структура;
					СтруктураЗначениеУзлаВладелец.Вставить("Владелец", Владелец);
					СтруктураЗначениеУзлаВладелец.Вставить("Значение", ДочернийУзел);
					СтруктураЗначениеУзлаВладелец.Вставить("ТипУзлаDOM", "Элемент");
					Возврат СтруктураЗначениеУзлаВладелец; 
				КонецЕсли;	
			КонецЦикла;
			Атрибут = Владелец.Атрибуты.ПолучитьИменованныйЭлемент(Узел);
			Если НЕ Атрибут = Неопределено Тогда
				СтруктураЗначениеУзлаВладелец = Новый Структура;
				СтруктураЗначениеУзлаВладелец.Вставить("Владелец", Владелец);
				СтруктураЗначениеУзлаВладелец.Вставить("Значение", Атрибут);
				СтруктураЗначениеУзлаВладелец.Вставить("ТипУзлаDOM", "Атрибут");
				Возврат СтруктураЗначениеУзлаВладелец;
			КонецЕсли;
			// Не нашли.
			СтруктураЗначениеУзлаВладелец = Новый Структура;
			СтруктураЗначениеУзлаВладелец.Вставить("Владелец", Владелец);
			СтруктураЗначениеУзлаВладелец.Вставить("Значение", Неопределено);
			СтруктураЗначениеУзлаВладелец.Вставить("ТипУзлаDOM", Неопределено);
		КонецЕсли;
		УзелDOM = Владелец;
		Счетчик = Счетчик+1; 
		
	КонецЦикла;
	
	Возврат СтруктураЗначениеУзлаВладелец; 
	
КонецФункции
                                       
Процедура ЗаполнитьМассивЭлементом_DOM(ЭлементРодитель, Знач ОбъектXDTOМассиваПоНастройке, Фабрика, ФорматВыгрузки, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента = "")
	
	Если НЕ ОбъектXDTOМассиваПоНастройке.Свойства().Получить("УсловияВыгрузкиУзла") = Неопределено Тогда	
		УсловиеВыполнено = РезультатОбработкиУсловия(ОбъектXDTOМассиваПоНастройке, ПараметрыФормирования);
		Если УсловиеВыполнено = Ложь Тогда
			Возврат;
		КонецЕсли;	
	КонецЕсли; 
	
	ДокументDOM = ЭлементРодитель.ДокументВладелец;
	
	//СписокXDTOМассива = ЭлементРодитель[ОбъектXDTOМассиваПоНастройке.Имя];		
	
	Если ТипЗнч(ОбъектXDTOМассиваПоНастройке.ЭлементМассива) = Тип("СписокXDTO") Тогда
		
		Для Каждого ЭлементМассива ИЗ ОбъектXDTOМассиваПоНастройке.ЭлементМассива Цикл
			
			Если НЕ ЭлементМассива.Свойства().Получить("УсловияВыгрузкиЭлемента") = Неопределено Тогда	
				УсловиеВыполнено = РезультатОбработкиУсловия(ЭлементМассива, ПараметрыФормирования);
				Если УсловиеВыполнено = Ложь Тогда
					Продолжить;
				КонецЕсли;	
			КонецЕсли;
			
			СтруктураЗначениеИВладельцецDOM = ПолучитьЗначениеУзлаИВладельцаПоПути_DOM(ЭлементРодитель, ОбъектXDTOМассиваПоНастройке.ПутьКМассиву);
		
			// Создаем элемент массива как элемент DOM.
			ЭлементМассиваDOM = ДокументDOM.СоздатьЭлемент(ОбъектXDTOМассиваПоНастройке.Имя);
			
			Для Каждого СвойствоXDTOЭлементаМассиваПоНастройке из ЭлементМассива.Свойства() Цикл
				
				Если СвойствоXDTOЭлементаМассиваПоНастройке.Форма = ФормаXML.Атрибут ИЛИ СвойствоXDTOЭлементаМассиваПоНастройке.Имя = "ИсточникДанныхДляМассива" ИЛИ НЕ СтрНайти(СвойствоXDTOЭлементаМассиваПоНастройке.Имя, "Условия") = 0 Тогда
					Продолжить;	
				КонецЕсли;
				
				Если СвойствоXDTOЭлементаМассиваПоНастройке.Имя = "УсловияВыгрузкиЭлемента" Тогда
					Продолжить;
				КонецЕсли;
				
				ОбъектXDTOЭлементаМассиваПоНастройке = ЭлементМассива[СвойствоXDTOЭлементаМассиваПоНастройке.Имя];
				
				Если ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Атрибут" Тогда
					ЗаполнитьАтрибутЭлемента(ЭлементМассиваDOM, ОбъектXDTOЭлементаМассиваПоНастройке, ПараметрыФормирования);
				ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Элемент" Тогда
					ОбработатьВложенныйЭлемент(ЭлементМассиваDOM, ОбъектXDTOЭлементаМассиваПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
				ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Текст" Тогда
					ЗаполнитьТекстЭлемента(ЭлементМассиваDOM, ОбъектXDTOЭлементаМассиваПоНастройке, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);	
				ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "МассивПоИсточнику" Тогда
					ЗаполнитьМассивЭлементаПоИсточнику(ЭлементМассиваDOM, ОбъектXDTOЭлементаМассиваПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
				ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Массив" Тогда
					ЗаполнитьМассивЭлемента(ЭлементМассиваDOM, ОбъектXDTOЭлементаМассиваПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
				КонецЕсли;
				
			КонецЦикла;
			
			СтруктураЗначениеИВладельцецDOM.Владелец.ДобавитьДочерний(ЭлементМассиваDOM);
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ОбъектXDTOМассиваПоНастройке.ЭлементМассива) = Тип("ОбъектXDTO") Тогда
		
		ЭлементМассива = ОбъектXDTOМассиваПоНастройке.ЭлементМассива; 
		
		Если НЕ ЭлементМассива.Свойства().Получить("УсловияВыгрузкиЭлемента") = Неопределено Тогда	
			УсловиеВыполнено = РезультатОбработкиУсловия(ЭлементМассива, ПараметрыФормирования);
			Если УсловиеВыполнено = Ложь Тогда
				Возврат;
			КонецЕсли;	
		КонецЕсли;	
		
		СтруктураЗначениеИВладельцецDOM = ПолучитьЗначениеУзлаИВладельцаПоПути_DOM(ЭлементРодитель, ОбъектXDTOМассиваПоНастройке.Имя);
		
		// Создаем элемент массива как элемент DOM.
		ЭлементМассиваDOM = ДокументDOM.СоздатьЭлемент(ОбъектXDTOМассиваПоНастройке.Имя);
		
		Для Каждого СвойствоXDTOЭлементаМассиваПоНастройке из ЭлементМассива.Свойства() Цикл
			
			Если СвойствоXDTOЭлементаМассиваПоНастройке.Форма = ФормаXML.Атрибут ИЛИ СвойствоXDTOЭлементаМассиваПоНастройке.Имя = "ИсточникДанныхДляМассива" Тогда
				Продолжить;	
			КонецЕсли;
			
			Если СвойствоXDTOЭлементаМассиваПоНастройке.Имя = "УсловияВыгрузкиЭлемента" Тогда
				Продолжить;
			КонецЕсли; 
			
			ОбъектXDTOЭлементаМассиваПоНастройке = ЭлементМассива[СвойствоXDTOЭлементаМассиваПоНастройке.Имя];
			
			Если ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Атрибут" Тогда
				ЗаполнитьАтрибутЭлемента(ЭлементМассиваDOM, ОбъектXDTOЭлементаМассиваПоНастройке, ПараметрыФормирования);
			ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Элемент" Тогда
				ОбработатьВложенныйЭлемент(ЭлементМассиваDOM, ОбъектXDTOЭлементаМассиваПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
			ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Текст" Тогда
				ЗаполнитьТекстЭлемента(ЭлементМассиваDOM, ОбъектXDTOЭлементаМассиваПоНастройке, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
			ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "МассивПоИсточнику" Тогда
				ЗаполнитьМассивЭлементаПоИсточнику(ЭлементМассиваDOM, ОбъектXDTOЭлементаМассиваПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
			ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Массив" Тогда
				ЗаполнитьМассивЭлемента(ЭлементМассиваDOM, ОбъектXDTOЭлементаМассиваПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
			КонецЕсли;
			
		КонецЦикла;
		
		СтруктураЗначениеИВладельцецDOM.Владелец.ДобавитьДочерний(ЭлементМассиваDOM);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыПолученияИЗаполненияДанныхDOM

Функция ПолучитьЭлементУзлаDOM(УзелDOM, ИмяЭлемента, Документ = Неопределено, ИнформацияПоОшибкамФормирования = Неопределено)
	
	ИскомыйЭлемент = УзелDOM.ПолучитьЭлементыПоИмени(ИмяЭлемента);
	
	Если ИскомыйЭлемент.Количество() = 1 Тогда
		Возврат ИскомыйЭлемент[0];
	ИначеЕсли ИскомыйЭлемент.Количество() = 0 Тогда
		Если НЕ ИнформацияПоОшибкамФормирования = Неопределено Тогда
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("Документ", Документ);	
			СтруктураОшибки.Вставить("ТекстОшибки", "При формировании документа не удалось обнаружить узел """+ИмяЭлемента+""" в сруктуре XML.");	
		КонецЕсли;
		Возврат Неопределено;
	Иначе
		Если НЕ ИнформацияПоОшибкамФормирования = Неопределено Тогда
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("Документ", Документ);	
			СтруктураОшибки.Вставить("ТекстОшибки", "При формировании документа была зафиксирована попытка вызвать список элементов """+ИмяЭлемента+""" как отдельный элемент в сруктуре XML.");
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции	
	
#КонецОбласти

#КонецОбласти

#Область РаботаСоСтатусами

Процедура ПолучитьДатуПоследнегоОбновленияСтатусов() Экспорт
	
	ПользовательВладелецНастроек = ПолучитьТекущегоПользователя();
	
	ПоследняяДатаОбновления = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки",// Ключ объекта
		"ПоследняяДатаОбновления",															// Ключ настройки 
		"Последняя дата обновления статусов для внешней обработки ОФД ЭДО.", 				// Описание настройки
		ПользовательВладелецНастроек);                                          			// Пользователь
	
КонецПроцедуры

Процедура ЗафиксироватьДатуОбновленияСтатусов(Дата) Экспорт
	
	ПользовательВладелецНастроек = ПолучитьТекущегоПользователя();
	
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", 			// Ключ объекта
		"ПоследняяДатаОбновления",											// Ключ настройки 
		Дата,																// Настройка
		"Последняя дата обновления статусов для внешней обработки ОФД ЭДО.",// описание настройки
		ПользовательВладелецНастроек);										// Пользователь
	
КонецПроцедуры

Процедура ОбновитьСтатусыСпискаДокументовВФоне(Параметры, АдресРезультата) Экспорт
	
	Если Параметры.Свойство("МассивДокументов") = Неопределено Тогда
		ЗаписьВЖурналРегистрации("Платформа ЭДО", "Ошибка", "Запуск фонового обновления статусов по массиву невозможен. Не передан массив ссылок документов.");
		Возврат;
	КонецЕсли;	
		
	МассивДокументов = Параметры.МассивДокументов;
	ПользовательВладелецНастроек	= ?(Параметры.Свойство("Пользователь"), Параметры.Пользователь, Неопределено);        
	AccessToken						= ?(Параметры.Свойство("AccessToken"), Параметры.AccessToken, Неопределено);
	RefreshToken					= ?(Параметры.Свойство("RefreshToken"), Параметры.AccessToken, Неопределено);
	Кэш								= ?(Параметры.Свойство("Кэш"), Параметры.Кэш, Неопределено);
	Интеграция						= ?(Параметры.Свойство("Интеграция"), Параметры.Интеграция, Неопределено);
	
	ОбновитьСтатусыМассиваДокументовОрганизации(МассивДокументов, ПользовательВладелецНастроек, AccessToken, RefreshToken, Кэш, Интеграция);
	
КонецПроцедуры
	
Процедура ОбновитьСтатусыМассиваДокументовОрганизации(МассивДокументов, ПользовательВладелецНастроек = Неопределено, AccessToken = Неопределено, RefreshToken = Неопределено, Кэш = Неопределено, Интеграция = Неопределено) Экспорт
		
	Если МассивДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ПользовательВладелецНастроек = Неопределено Тогда              
		ПользовательВладелецНастроек = ПолучитьТекущегоПользователя();
	КонецЕсли;	
	
	Если Кэш = Неопределено Тогда
		Кэш = Инициализация(Ложь);
	КонецЕсли;
	
	Если Интеграция = Неопределено Тогда
		Интеграция = ПолучитьИнтеграциюНаСервере(ПользовательВладелецНастроек);
	КонецЕсли;  
	
	Если AccessToken = Неопределено Тогда
		ОрганизацияДокументовМассива = МассивДокументов[0].Организация;
		ПараметрыАвторизацииИПодписания = Интеграция.ПараметрыАвторизацииИПодписания;
		ПараметрыАвторизацииИПодписанияОрганизации = ПараметрыАвторизацииИПодписания[ОрганизацияДокументовМассива];
		AccessToken = ПараметрыАвторизацииИПодписанияОрганизации.AccessToken;
	КонецЕсли;
	
	Если RefreshToken = Неопределено Тогда
		ОрганизацияДокументовМассива = МассивДокументов[0].Организация;
		ПараметрыАвторизацииИПодписания = Интеграция.ПараметрыАвторизацииИПодписания;
		ПараметрыАвторизацииИПодписанияОрганизации = ПараметрыАвторизацииИПодписания[ОрганизацияДокументовМассива];
		RefreshToken = ПараметрыАвторизацииИПодписанияОрганизации.RefreshToken;
	КонецЕсли;
	
	Если Интеграция.СпособИнтеграции <> 2 Тогда //НЕ API
		ЗаписьВЖурналРегистрации("Невозможно обновить статусы", "Предупреждение", "Обновить статусы можно только при способе обмена 'API'. Измените способ обмена в настройках и повторите попытку.");
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(МассивДокументов) = Тип("Массив") И МассивДокументов.Количество() > 0 Тогда
		
		// Получаем структуру свойств из настроек Кэш	
		СтруктураХранения1С = ПолучитьСтруктуруХранения1С(Кэш);
		
		ХранениеИнформацииВ1С = Ложь;
		СвойствоИдентификатор = Неопределено;
		СвойствоСтатус		  = Неопределено;
		
		// Если по каким-то причинам не удалось найти свойства, то ничего не сохраняем
		Если СтруктураХранения1С <> Неопределено И ЗначениеЗаполнено(СтруктураХранения1С.СвойствоИдентификатор) И
			ЗначениеЗаполнено(СтруктураХранения1С.СвойствоСтатус) Тогда				
			
			ХранениеИнформацииВ1С = Истина;
			СвойствоИдентификатор = СтруктураХранения1С.СвойствоИдентификатор;
			СвойствоСтатус		  = СтруктураХранения1С.СвойствоСтатус;				
		КонецЕсли;
		
		СтрокаИдентификаторов = "";
		
		Если ХранениеИнформацииВ1С Тогда
			ИдентификаторыДокументов = ПолучитьИдентификаторыДокументовИз1С(МассивДокументов, СвойствоИдентификатор);
			Для Каждого Элемент из ИдентификаторыДокументов Цикл
				СтрокаИдентификаторов = СтрокаИдентификаторов + Элемент.Значение + ",";	
			КонецЦикла;			
		КонецЕсли;	
		
		ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса(AccessToken);
		ПараметрыЗапроса.Параметры.Вставить("<id>", СтрокаИдентификаторов); 
		
		РезультатПоискаДокументов = ВыполнитьЗапросAPI("API_ПолучитьСписокДокументов", ПараметрыЗапроса, , ПараметрыАвторизацииИПодписанияОрганизации, ОрганизацияДокументовМассива);
		
		Если НЕ РезультатПоискаДокументов.Ошибка Тогда
			
			Если РезультатПоискаДокументов.Результат = Неопределено Тогда
				// Пустой ответ, изменения не требуются.
				Возврат;
			КонецЕсли;	
			
			АктуальныеСтатусыДокументов = Новый Соответствие; 
			
			Для Каждого Документ из РезультатПоискаДокументов.Результат Цикл
				ИдентификаторДокументаОтвета = СокрЛП(Формат(Документ.id, "ЧДЦ=0; ЧГ=0"));
				АктуальныйСтатусОтвета = ПеревестиСтатусAPIвСтатус1С(Документ.status);
				АктуальныеСтатусыДокументов.Вставить(ИдентификаторДокументаОтвета, АктуальныйСтатусОтвета);	
			КонецЦикла;	
			
			Если ХранениеИнформацииВ1С Тогда
				
				ТекущиеСтатусыДокументов = ПолучитьСтатусыДокументовИз1С(МассивДокументов, СвойствоСтатус, СвойствоИдентификатор);				
					
			Иначе
				
				//Здесь будет реализована альтернатива.
				//Не будет. ДопСведения - безусловный стандарт, и их можно исползовать даже при отключенной функц. опции.
				
			КонецЕсли;
			
			Если НЕ АктуальныеСтатусыДокументов = Неопределено И НЕ ТекущиеСтатусыДокументов = Неопределено И АктуальныеСтатусыДокументов.Количество() > 0 Тогда
				ЗафиксироватьАктуальныеСтатусыВ1С(АктуальныеСтатусыДокументов, ТекущиеСтатусыДокументов, ИдентификаторыДокументов, Истина, СтруктураХранения1С, СвойствоСтатус);
			КонецЕсли;
			
		Иначе
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = РезультатПоискаДокументов.Описание;
			Сообщение.Сообщить();
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

Функция ПолучитьМассивСтруктурДокументовНаОбновление() 
	
	УстановитьПривилегированныйРежим(Истина);
	СписокЗначений = ХранилищеОбщихНастроек.ПолучитьСписок("ОФД_ЭДО_ДокументыНаОбновление", ПолучитьТекущегоПользователя());
	Интеграция = СписокЗначений.НайтиПоЗначению("СоответствиеДокументовНаОбновление");
	
	// Информация об интеграции уже есть в хранилище значений 
	Если ТипЗнч(Интеграция) = Тип("ЭлементСпискаЗначений") Тогда
		
		Возврат ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_ДокументыНаОбновление",	// Ключ объекта
		"МассивСтруктурДокументовНаОбновление",										// Ключ настройки 
		"Массив структур документов, по которым периодически проводится динамическое" 
		+" обновление статусов, для оперативного отражения статусов"
		+" в пользовательском интерфейсе.",											// описание настройки
		ПолучитьТекущегоПользователя()); 											// Пользователь
		
	Иначе 
		
		Возврат Новый Массив;
		
	КонецЕсли; 	
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

Процедура ОбработатьСобытияПоЭлектроннымДокументам() Экспорт
	
	СистемнаяИнформация = Новый("СистемнаяИнформация");
	ВерсияПлатформы1С = СистемнаяИнформация.ВерсияПриложения;
	СравнениеВерсийПлатформы_8_3_21 = ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияПлатформы1С, "8.3.20.9999");
	
	ЭтоФоновоеВыполнение = Ложь;
	Сеанс = ПолучитьТекущийСеансИнформационнойБазы();	
	Если НЕ Сеанс.ПолучитьФоновоеЗадание() = Неопределено Тогда
		ЭтоФоновоеВыполнение = Истина;
	КонецЕсли;	
	
	КоличествоОбрабатываемыхЗаРазСобытий = 1000;
	             
	ПользовательВладелецНастроек = ПолучитьТекущегоПользователя();	
	Кэш = Инициализация(Ложь);
	Интеграция = ПолучитьИнтеграциюНаСервере(ПользовательВладелецНастроек);
	
	Если Интеграция = Неопределено Тогда
		Если СравнениеВерсийПлатформы_8_3_21 > 0 Тогда
			Выполнить("ВызватьИсключение(""Не указаны настройки обработки для пользователя, от имени которого выполняется регламентное задание."", , ""Не указаны настройки обработки для пользователя, от имени которого выполняется регламентное задание."")");
		Иначе
			ЗаписьВЖурналРегистрации("Платформа ЭДО. Запуск обновления событий.", "Ошибка", "Не указаны настройки обработки для пользователя, от имени которого выполняется регламентное задание.");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если НЕ Интеграция.СпособИнтеграции = 2 Тогда
		// Не API.	
		Если СравнениеВерсийПлатформы_8_3_21 > 0 Тогда
			Выполнить("ВызватьИсключение(""В настройках внешней обработки ОФД ЭДО не активирован режим работы через API."", , ""В настройках внешней обработки ОФД ЭДО не активирован режим работы через API."")");
		Иначе
			ЗаписьВЖурналРегистрации("Платформа ЭДО. Запуск обновления событий.", "Ошибка", "В настройках внешней обработки ОФД ЭДО не активирован режим работы через API.");
		КонецЕсли;
		Возврат;
	КонецЕсли;	
	
	ПараметрыАвторизацииИПодписания = Интеграция.ПараметрыАвторизацииИПодписания;
	
	Для Каждого КлючЗначение Из ПараметрыАвторизацииИПодписания Цикл
		
		Организация = КлючЗначение.Ключ;
		ПараметрыАвторизацииИПодписанияОрганизации = КлючЗначение.Значение;
		AccessToken = ПараметрыАвторизацииИПодписанияОрганизации.AccessToken;
		
		Если НЕ ЗначениеЗаполнено(AccessToken) Тогда			
			ТекстСообщения = "Для организации """+Организация+""" не задан токен авторизации. Обновление статусов не было проведено.";
			Если ЭтоФоновоеВыполнение = Истина Тогда
				ЗаписьВЖурналРегистрации("Обновление статусов документов ОФД ЭДО.", "Предупреждение", ТекстСообщения);
			Иначе
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ТекстСообщения;
				Сообщение.Сообщить();
			КонецЕсли;
			Продолжить;		
		КонецЕсли;
		
		ИдентификаторОрганизации = ПолучитьИдентификаторЭДОИз1СПоСсылке(Организация);
		
		Если НЕ ЗначениеЗаполнено(ИдентификаторОрганизации) Тогда
			ТекстСообщения = "Для организации """+Организация+""" не задан идентификатор абонента ЭДО. Обновление статусов не было проведено.";
			Если ЭтоФоновоеВыполнение = Истина Тогда
				ЗаписьВЖурналРегистрации("Обновление статусов документов ОФД ЭДО.", "Предупреждение", ТекстСообщения);
			Иначе
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ТекстСообщения;
				Сообщение.Сообщить();
			КонецЕсли;
			Возврат;
		КонецЕсли;	
		
		НомерПоследнегоОбработанногоСобытияОрганизации = ПолучитьНомерПоследнегоОбработанногоСобытияПоДокументам(Организация);
		
		ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса(AccessToken);
		ПараметрыЗапроса.Параметры.Вставить("<offset>", НомерПоследнегоОбработанногоСобытияОрганизации);
		ПараметрыЗапроса.Параметры.Вставить("<limit>", Формат(КоличествоОбрабатываемыхЗаРазСобытий, "ЧГ=0"));
		ПараметрыЗапроса.Параметры.Вставить("<master-doc-only>", "true");
		
		РезультатПоискаСобытий = ВыполнитьЗапросAPI("API_ПолучитьСписокСобытийПоДокументам", ПараметрыЗапроса, , ПараметрыАвторизацииИПодписанияОрганизации, Организация);
		
		Если НЕ РезультатПоискаСобытий.Ошибка Тогда
			
			Если ТипЗнч(РезультатПоискаСобытий.Результат) = Тип("Массив") И РезультатПоискаСобытий.Результат.Количество() > 0 Тогда
				
				АктуальныеСтатусыДокументов		= Новый Соответствие;
				МассивИдентификаторовДокументов	= Новый Массив;
				НомерОбработанногоСобытия		= НомерПоследнегоОбработанногоСобытияОрганизации;
				
				// Получили список событий. Обработка.
				Для Каждого Событие из РезультатПоискаСобытий.Результат Цикл
					
					Если НЕ Событие.field = "status" Тогда
						Продолжить;
					КонецЕсли;	
					
					ИдентификаторСобытия	= Формат(Событие.id, "ЧГ=0");
					ИдентификаторДокумента	= Формат(Событие.document.id, "ЧГ=0");
					
					СтатусИзСобытия	= Событие.value;
					СтатусAPI		= ПеревестиСтатусИзСобытияВСтатусAPI(СтатусИзСобытия);
					Статус1С		= ПеревестиСтатусAPIвСтатус1С(СтатусAPI);
					
					АктуальныеСтатусыДокументов.Вставить(ИдентификаторДокумента, Статус1С);
					
					МассивИдентификаторовДокументов.Добавить(ИдентификаторДокумента);
					
					НомерОбработанногоСобытия = ИдентификаторСобытия;
					
				КонецЦикла;
				
				ИдентификаторыДокументов = ПолучитьДокументыПоИдентификаторам1С(МассивИдентификаторовДокументов);
				
				ТекущиеСтатусыДокументов = ПолучитьСтатусыДокументовИз1С(МассивИдентификаторовДокументов, , , Истина);
				
				Если НЕ АктуальныеСтатусыДокументов = Неопределено И НЕ ТекущиеСтатусыДокументов = Неопределено И АктуальныеСтатусыДокументов.Количество() > 0 Тогда
					ЗафиксироватьАктуальныеСтатусыВ1С(АктуальныеСтатусыДокументов, ТекущиеСтатусыДокументов, ИдентификаторыДокументов, Ложь);
				КонецЕсли;
				
				// Поиск и анализ аннулирований.
				ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса(AccessToken);
				ПараметрыЗапроса.Параметры.Вставить("<offset>", НомерПоследнегоОбработанногоСобытияОрганизации);
				ПараметрыЗапроса.Параметры.Вставить("<limit>", Формат(КоличествоОбрабатываемыхЗаРазСобытий, "ЧГ=0"));
				ПараметрыЗапроса.Параметры.Вставить("<types>", "CANCELLATION");
				
				РезультатПоискаСобытийАннулирования = ВыполнитьЗапросAPI("API_ПолучитьСписокСобытийПоДокументам", ПараметрыЗапроса, , ПараметрыАвторизацииИПодписанияОрганизации, Организация);
				
				Если НЕ РезультатПоискаСобытийАннулирования.Ошибка Тогда
					
					Если ТипЗнч(РезультатПоискаСобытийАннулирования.Результат) = Тип("Массив") И РезультатПоискаСобытийАннулирования.Результат.Количество() > 0 Тогда
						
						АктуальныеСтатусыДокументов_Аннулирование		= Новый Соответствие;
						МассивИдентификаторовДокументов_Аннулирование	= Новый Массив;
						НомерОбработанногоСобытияАннулирования			= НомерПоследнегоОбработанногоСобытияОрганизации;	
						
						Для Каждого Событие из РезультатПоискаСобытийАннулирования.Результат Цикл
							
							Если НЕ Событие.field = "status" Тогда
								Продолжить;
							КонецЕсли;	
							
							ИдентификаторСобытия		= Формат(Событие.id, "ЧГ=0");
							ИдентификаторДокумента		= Формат(Событие.document.masterId, "ЧГ=0");
							ИдентификаторОтправителя	= Событие.document.sender;
							ИдентификаторПолучателя		= Событие.document.recipient;
							
							СтатусИзСобытия	= Событие.value;
							СтатусAPI		= ПеревестиСтатусИзСобытияВСтатусAPI(СтатусИзСобытия);
							
							Если СтатусAPI = "SENT" Тогда
								// Было отправлено предложение об аннулировании.
								Если ИдентификаторОрганизации = ИдентификаторОтправителя Тогда
									// Предложение было отправлено организацией.
									СтатусAPI = "PreCancelledByUs";
								ИначеЕсли ИдентификаторОрганизации = ИдентификаторПолучателя Тогда
									// Предложение было отправлено контрагентом.
									СтатусAPI = "PreCancelledByThem";
								Иначе
									// ???
									СтатусAPI = "PreCancelled";
								КонецЕсли;	
							ИначеЕсли СтатусAPI = "ACCEPTED" Тогда
								// Было принято.
								СтатусAPI = "CANCELLED";
							ИначеЕсли СтатусAPI = "REJECTED" Тогда
								// Было отклонено.
								// Документ вновь считается просто подписанным.
								СтатусAPI = "ACCEPTED";
							Иначе
								Продолжить;
							КонецЕсли;	
							
							Статус1С = ПеревестиСтатусAPIвСтатус1С(СтатусAPI);
							
							АктуальныеСтатусыДокументов_Аннулирование.Вставить(ИдентификаторДокумента, Статус1С);
							
							МассивИдентификаторовДокументов_Аннулирование.Добавить(ИдентификаторДокумента);
							
							НомерОбработанногоСобытияАннулирования = ИдентификаторСобытия;
							
						КонецЦикла;
						
						ИдентификаторыДокументов_Аннулирование = ПолучитьДокументыПоИдентификаторам1С(МассивИдентификаторовДокументов_Аннулирование);
				
						ТекущиеСтатусыДокументов_Аннулирование = ПолучитьСтатусыДокументовИз1С(МассивИдентификаторовДокументов_Аннулирование, , , Истина);
						
						Если НЕ АктуальныеСтатусыДокументов = Неопределено И НЕ ТекущиеСтатусыДокументов = Неопределено И АктуальныеСтатусыДокументов.Количество() > 0 Тогда
							ЗафиксироватьАктуальныеСтатусыВ1С(АктуальныеСтатусыДокументов_Аннулирование, ТекущиеСтатусыДокументов_Аннулирование, ИдентификаторыДокументов_Аннулирование, Ложь);
						КонецЕсли;
						
						НомерПоследнегоОбработанногоСобытияОрганизации = НомерОбработанногоСобытия;
						
						ЗафиксироватьНомерПоследнегоОбработанногоСобытияПоДокументам(НомерПоследнегоОбработанногоСобытияОрганизации, Организация);
						
					КонецЕсли;	
					
				Иначе
					
					Если РезультатПоискаСобытийАннулирования.КодСостояния = 401 Тогда 
						ТекстСообщения = "Для организации """+Организация+""" задан некорректный токен авторизации (вероятнее всего просрочен). Обновление статусов аннулирования не было проведено.";
					Иначе
						ТекстСообщения = "При обновлении статусов аннулирования для организации """+Организация+""" произошла ошибка."+Символы.ПС+"Описание ошибки:"+Символы.ПС+"Код ошибки "+РезультатПоискаСобытийАннулирования.КодСостояния+"."+Символы.ПС+РезультатПоискаСобытийАннулирования.Описание;
					КонецЕсли;
					
					Если ЭтоФоновоеВыполнение = Истина Тогда
						ЗаписьВЖурналРегистрации("Обновление статусов документов ОФД ЭДО.", "Ошибка", ТекстСообщения);
					Иначе
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = ТекстСообщения;
						Сообщение.Сообщить();
					КонецЕсли;
					
				КонецЕсли;	
				
			КонецЕсли;	
			
		Иначе
			
			Если РезультатПоискаСобытий.КодСостояния = 401 Тогда 
				ТекстСообщения = "Для организации """+Организация+""" задан некорректный токен авторизации (вероятнее всего просрочен). Обновление статусов не было проведено.";
			Иначе
				ТекстСообщения = "При обновлении статусов для организации """+Организация+""" произошла ошибка."+Символы.ПС+"Описание ошибки:"+Символы.ПС+"Код ошибки "+РезультатПоискаСобытий.КодСостояния+"."+Символы.ПС+РезультатПоискаСобытий.Описание;
			КонецЕсли;
			
			Если ЭтоФоновоеВыполнение = Истина Тогда
				ЗаписьВЖурналРегистрации("Обновление статусов документов ОФД ЭДО.", "Ошибка", ТекстСообщения);
			Иначе
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ТекстСообщения;
				Сообщение.Сообщить();
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры	

Функция ПолучитьНомерПоследнегоОбработанногоСобытияПоДокументам(Организация) Экспорт
	
	ПользовательВладелецНастроек = ПолучитьТекущегоПользователя();
	
	НомерСобытия = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки",			// Ключ объекта
		"НомерПоследнегоСобытияОрганизации"+Организация,									// Ключ настройки 
		"Номер последнего обработанного события по документам организации "+Организация+".",// Описание настройки
		ПользовательВладелецНастроек);                                          			// Пользователь

	Если НомерСобытия = Неопределено Тогда
		НомерСобытия = 0;
	КонецЕсли;
	
	Возврат НомерСобытия; 
		
КонецФункции

Процедура ЗафиксироватьНомерПоследнегоОбработанногоСобытияПоДокументам(НомерСобытия, Организация) Экспорт
	
	ПользовательВладелецНастроек = ПолучитьТекущегоПользователя();
	
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки",							// Ключ объекта
		"НомерПоследнегоСобытияОрганизации"+Организация,									// Ключ настройки 
		НомерСобытия,																		// Настройка
		"Номер последнего обработанного события по документам организации "+Организация+".",// описание настройки
		ПользовательВладелецНастроек);														// Пользователь
	
КонецПроцедуры

Функция ПеревестиСтатусAPIвСтатус1С(СтатусAPI)
	
	//На 19.02.2020 возможные статусы: NEW, DELETED, SIGNED, SENT, DELIVERED, ACCEPTED, REJECTED.
	Если СтатусAPI = "NEW" Тогда //Новый.
		Возврат 10; //Черновик
	ИначеЕсли СтатусAPI = "SIGNED" Тогда //Подписан отправителем, но не отправлен.
		Возврат 10;  //Черновик
	ИначеЕсли СтатусAPI = "AWAIT_PAYMENT" Тогда //Ожидает оплаты
		Возврат 11;
	ИначеЕсли СтатусAPI = "SENDING" Тогда //Ожидает оплаты
		Возврат 12;	
	ИначеЕсли СтатусAPI = "CANCELLED" Тогда //АннулированПредложено аннулирование
		Возврат 13;
	ИначеЕсли СтатусAPI = "PreCancelledByThem" Тогда //Предложено аннулирование со стороны контрагента
		Возврат 14;
	ИначеЕсли СтатусAPI = "PreCancelledByUs" Тогда //Предложено аннулирование со стороны организации
		Возврат 15;
	ИначеЕсли СтатусAPI = "PreCancelled" Тогда //В списке отобразился сторонний документ, по нему предложено аннулирование
		Возврат 16;	
	ИначеЕсли СтатусAPI = "CORRECTION_REQUESTED" Тогда // Запрос на уточнение
		Возврат 17;	
	ИначеЕсли СтатусAPI = "SENDING_FAILED" Тогда //Неизвестная и неожиданная ошибка.
		Возврат 22;
	ИначеЕсли СтатусAPI = "SENDING" Тогда //В процессе отправки
		Возврат 12;
	ИначеЕсли СтатусAPI = "SENT" Тогда //Отправлен.
		Возврат 40; //Отправлен
	ИначеЕсли СтатусAPI = "DELIVERED" Тогда //Доставлен.
		Возврат 50; //Доставлен
	ИначеЕсли СтатусAPI = "SENT_TO_OPERATOR" Тогда //Отправлен оператору. Далее не ушел.
		Возврат 55;	
	ИначеЕсли СтатусAPI = "ACCEPTED" Тогда //Подписан получателем.
		Возврат 70; //Подписан
	ИначеЕсли СтатусAPI = "REJECTED" Тогда //Отклонён.
		Возврат 60; //Отклонён                     	
	ИначеЕсли СтатусAPI = "DELETED" Тогда //Удалён.
		Возврат 90;	//Удалён
	КонецЕсли;
	
КонецФункции

Функция ПеревестиСтатусИзСобытияВСтатусAPI(СтатусИзСобытия)

	Если СтатусИзСобытия = "0" Тогда
		Возврат "NEW";
	ИначеЕсли СтатусИзСобытия = "20" Тогда
		Возврат "DELETED";
	ИначеЕсли СтатусИзСобытия = "40" Тогда
		Возврат "SIGNED";
	ИначеЕсли СтатусИзСобытия = "50" Тогда
		Возврат "AWAIT_PAYMENT";
	ИначеЕсли СтатусИзСобытия = "55" Тогда
		Возврат "SENDING";
	ИначеЕсли СтатусИзСобытия = "57" Тогда
		Возврат "SENT_TO_OPERATOR";
	ИначеЕсли СтатусИзСобытия = "60" Тогда
		Возврат "SENT";
	ИначеЕсли СтатусИзСобытия = "80" Тогда
		Возврат "DELIVERED";
	ИначеЕсли СтатусИзСобытия = "100" Тогда
		Возврат "ACCEPTED";
	ИначеЕсли СтатусИзСобытия = "120" Тогда
		Возврат "REJECTED";
	ИначеЕсли СтатусИзСобытия = "140" Тогда
		Возврат "SENDING_FAILED";	
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСтруктуруПараметровЗаписиВРегистрСведений() Экспорт
	
	ПараметрыЗаписи = Новый Структура;
	ПараметрыЗаписи.Вставить("НаименованиеРегистра", 	"");
	ПараметрыЗаписи.Вставить("Объект", 					Неопределено);
	ПараметрыЗаписи.Вставить("Свойство", 				Неопределено);
	ПараметрыЗаписи.Вставить("Значение", 				"");
	ПараметрыЗаписи.Вставить("СтатусЗаписи",			Ложь);
	
	Возврат ПараметрыЗаписи;
	
КонецФункции

Функция ЗаписьВРегистрСведений(ПараметрыЗаписи) Экспорт 	
	
	НаборЗаписей = РегистрыСведений[ПараметрыЗаписи.НаименованиеРегистра].СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(ПараметрыЗаписи.Объект);
	НаборЗаписей.Отбор.Свойство.Установить(ПараметрыЗаписи.Свойство);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда		
		НоваяЗаписьНабора = НаборЗаписей.Добавить();
		НоваяЗаписьНабора.Объект	= ПараметрыЗаписи.Объект;
		НоваяЗаписьНабора.Свойство	= ПараметрыЗаписи.Свойство;
		НоваяЗаписьНабора.Значение	= ПараметрыЗаписи.Значение; 		
	Иначе
		НоваяЗаписьНабора = НаборЗаписей.Получить(0);
		// Защита от записи пустого значения, вместо полного
		Если ПараметрыЗаписи.Значение <> "" Тогда
			НоваяЗаписьНабора.Значение	= ПараметрыЗаписи.Значение; 		
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		НаборЗаписей.Записать(); 
		ПараметрыЗаписи.СтатусЗаписи = Истина;
	Исключение
		ПараметрыЗаписи.СтатусЗаписи = Ложь;
	КонецПопытки;
	
	Возврат ПараметрыЗаписи;
	
КонецФункции

#КонецОбласти

#Область РаботаСИдентификаторамиАбонентов

Процедура ЗаполнитьПустыеИдентификаторыАбонентовПоДокументамПоследнейАктивности() Экспорт
	
	СистемнаяИнформация = Новый("СистемнаяИнформация");
	ВерсияПлатформы1С = СистемнаяИнформация.ВерсияПриложения;
	СравнениеВерсийПлатформы_8_3_21 = ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияПлатформы1С, "8.3.20.9999");
	
	Кэш = Инициализация(Ложь);	
	Если Кэш.НастройкиОбъект.Получить(Кэш.ПрефиксКонфигурации + "ПараметрыФоновыхОпераций") = Неопределено Тогда
		Если СравнениеВерсийПлатформы_8_3_21 > 0 Тогда
			Выполнить("ВызватьИсключение(""Не обнаружена настройка параметров выполнения фоновых операций для текущей конфигурации 1С."", , ""Не обнаружена настройка параметров выполнения фоновых операций для текущей конфигурации 1С."")");
		Иначе
			ЗаписьВЖурналРегистрации("Платформа ЭДО. Запуск заполнения идентификаторов абонентов.", "Ошибка", "Не обнаружена настройка параметров выполнения фоновых операций для текущей конфигурации 1С.");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ПараметрыФоновыхОперацийXDTO = Кэш.НастройкиОбъект.Получить(Кэш.ПрефиксКонфигурации + "ПараметрыФоновыхОпераций");
	
	ЭтоФоновоеВыполнение = Ложь;
	Сеанс = ПолучитьТекущийСеансИнформационнойБазы();	
	Если НЕ Сеанс.ПолучитьФоновоеЗадание() = Неопределено Тогда
		ЭтоФоновоеВыполнение = Истина;
	КонецЕсли;	
	
	ПользовательВладелецНастроек = ПолучитьТекущегоПользователя();
	Интеграция = ПолучитьИнтеграциюНаСервере(ПользовательВладелецНастроек);
	
	Если Интеграция = Неопределено Тогда
		Если СравнениеВерсийПлатформы_8_3_21 > 0 Тогда
			Выполнить("ВызватьИсключение(""Не указаны настройки обработки для пользователя, от имени которого выполняется регламентное задание."", , ""Не указаны настройки обработки для пользователя, от имени которого выполняется регламентное задание."")");
		Иначе
			ЗаписьВЖурналРегистрации("Платформа ЭДО. Запуск заполнения идентификаторов абонентов.", "Ошибка", "Не указаны настройки обработки для пользователя, от имени которого выполняется регламентное задание.");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если НЕ Интеграция.СпособИнтеграции = 2 Тогда
		// Не API.	
		Если СравнениеВерсийПлатформы_8_3_21 > 0 Тогда
			Выполнить("ВызватьИсключение(""В настройках внешней обработки ОФД ЭДО не активирован режим работы через API."", , ""В настройках внешней обработки ОФД ЭДО не активирован режим работы через API."")");
		Иначе
			ЗаписьВЖурналРегистрации("Платформа ЭДО. Запуск заполнения идентификаторов абонентов.", "Ошибка", "В настройках внешней обработки ОФД ЭДО не активирован режим работы через API.");
		КонецЕсли;
		Возврат;
	КонецЕсли;	
	
	ПараметрыАвторизацииИПодписания = Интеграция.ПараметрыАвторизацииИПодписания;
	
	Для Каждого КлючЗначение Из ПараметрыАвторизацииИПодписания Цикл
		
		Организация = КлючЗначение.Ключ;
		ПараметрыАвторизацииИПодписанияОрганизации = КлючЗначение.Значение;
		
		Если ПараметрыАвторизацииИПодписанияОрганизации.Свойство("AccessToken") = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ПараметрыАвторизацииИПодписанияОрганизации.AccessToken) Тогда
			Продолжить;
		КонецЕсли;	
		
		ОбработатьОбъектыОпределенияАктивностиАбонентов(Организация, ПараметрыАвторизацииИПодписанияОрганизации, ПараметрыФоновыхОперацийXDTO, Кэш);
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ОбработатьОбъектыОпределенияАктивностиАбонентов(Организация, ПараметрыАвторизацииИПодписанияОрганизации, ПараметрыФоновыхОперацийXDTO, Кэш)

	ОписаниеФоновогоЗаполненияИдентификаторовАбонентовЭДО = ПараметрыФоновыхОперацийXDTO.ФоновоеЗаполнениеИдентификаторовАбонентовЭДО;
	ОписаниеДокументовОтслеживанияАктивности = ОписаниеФоновогоЗаполненияИдентификаторовАбонентовЭДО.ДокументыОпределенияАктивности;
		
	СтруктураХранения1С = ПолучитьСтруктуруХранения1С(Кэш);
	СвойствоИдентификатор = СтруктураХранения1С.СвойствоИдентификаторУчастника;
	НаименованиеРегистра = СтруктураХранения1С.НаименованиеРегистра;
	
	СтруктураОбъектаОпределенияАктивности = Новый Структура;
	СтруктураОбъектаОпределенияАктивности.Вставить("НаименованиеРегистра", НаименованиеРегистра);
	СтруктураОбъектаОпределенияАктивности.Вставить("СвойствоИдентификатор", СвойствоИдентификатор);
	
	Для Каждого СвойствоXDTOДокументОтслеживанияАктивности из ОписаниеДокументовОтслеживанияАктивности.Свойства() Цикл
		
		ДокументОтслеживанияАктивностиXDTO = ОписаниеДокументовОтслеживанияАктивности.Получить(СвойствоXDTOДокументОтслеживанияАктивности.Имя);
		
		ИмяОбъектаМетаданныхДокумента = ДокументОтслеживанияАктивностиXDTO.ИмяОбъектаМетаданных;
		ИмяРеквизитаОтправителяДокумента = ДокументОтслеживанияАктивностиXDTO.РеквизитОтправитель.НаименованиеРеквизита;
		ИмяРеквизитаПолучателяДокумента = ДокументОтслеживанияАктивностиXDTO.РеквизитПолучатель.НаименованиеРеквизита;
		
		СтруктураОбъектаОпределенияАктивности.Вставить("ИмяОбъектаМетаданныхДокумента", ИмяОбъектаМетаданныхДокумента);
		СтруктураОбъектаОпределенияАктивности.Вставить("ИмяРеквизитаОтправителяДокумента", ИмяРеквизитаОтправителяДокумента);
		СтруктураОбъектаОпределенияАктивности.Вставить("ИмяРеквизитаПолучателяДокумента", ИмяРеквизитаПолучателяДокумента);
		
		ОпределитьАктивностьПотенциальныхНовыхАбонентовИЗаполнитьИдентификаторы(Организация, ПараметрыАвторизацииИПодписанияОрганизации, СтруктураОбъектаОпределенияАктивности);
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ОпределитьАктивностьПотенциальныхНовыхАбонентовИЗаполнитьИдентификаторы(Организация, ПараметрыАвторизацииИПодписанияОрганизации, СтруктураОбъектаОпределенияАктивности)
	
	НаименованиеРегистра				= СтруктураОбъектаОпределенияАктивности.НаименованиеРегистра;
	ИмяОбъектаМетаданныхДокумента		= СтруктураОбъектаОпределенияАктивности.ИмяОбъектаМетаданныхДокумента;
	ИмяРеквизитаОтправителяДокумента	= СтруктураОбъектаОпределенияАктивности.ИмяРеквизитаОтправителяДокумента;
	ИмяРеквизитаПолучателяДокумента		= СтруктураОбъектаОпределенияАктивности.ИмяРеквизитаПолучателяДокумента;
	СвойствоИдентификатор				= СтруктураОбъектаОпределенияАктивности.СвойствоИдентификатор;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ДокументАктивности."+ИмяРеквизитаПолучателяДокумента+" КАК Абонент
	               |ИЗ
	               |	Документ."+ИмяОбъектаМетаданныхДокумента+" КАК ДокументАктивности
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений."+НаименованиеРегистра+" КАК ДополнительныеСведения
	               |		ПО ДокументАктивности."+ИмяРеквизитаПолучателяДокумента+" = ДополнительныеСведения.Объект
	               |			И (ДополнительныеСведения.Свойство = &СвойствоИдентификатор)
	               |ГДЕ
	               |	ДокументАктивности.Дата <= КОНЕЦПЕРИОДА(&ТекущаяДата, ДЕНЬ)
	               |	И ДокументАктивности.Дата >= НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ТекущаяДата, МЕСЯЦ, -1), МЕСЯЦ)
	               |	И ДокументАктивности.Проведен = ИСТИНА
	               |	И ДокументАктивности."+ИмяРеквизитаОтправителяДокумента+" = &Отправитель
	               |	И ДополнительныеСведения.Значение ЕСТЬ NULL";
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.УстановитьПараметр("Отправитель", Организация);
	Запрос.УстановитьПараметр("СвойствоИдентификатор", СвойствоИдентификатор);
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		Результат = Результат.Выбрать();
		
		Пока Результат.Следующий() Цикл
			
			AccessToken = ПараметрыАвторизацииИПодписанияОрганизации.AccessToken;
			
			ПриоритетИдентификаторов = ЗаполнитьСписокПриоритетаИзНастройки();
			
			Если ПриоритетИдентификаторов = Неопределено тогда 
				ПриоритетИдентификаторов = ЗаполнитьСписокПриоритетаПоУмолчанию();
			КонецЕсли;
			
			Абонент	= Результат.Абонент;
			ИНН		= Абонент.ИНН;
			КПП		= Абонент.КПП;
			
			ИдентификаторОбрабатываемогоАбонента = "";
			
			ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса(AccessToken);
			
			ПараметрыЗапроса.Параметры.Вставить("<inn>", СокрЛП(ИНН));
			Если ЗначениеЗаполнено(СокрЛП(КПП)) Тогда
				ПараметрыЗапроса.Параметры.Вставить("<kpp>", СокрЛП(КПП));
			КонецЕсли;
			
			ИнформацияОКонтрагенте = ВыполнитьЗапросAPI("API_ИнформацияОКонтрагенте", ПараметрыЗапроса, , ПараметрыАвторизацииИПодписанияОрганизации, Организация);
			
			Если НЕ ИнформацияОКонтрагенте.Ошибка Тогда
				
				Если ИнформацияОКонтрагенте.Результат = Неопределено Тогда
					ИнформацияОКонтрагентеПоДаннымФНС = ВыполнитьЗапросAPI("API_ИнформацияОКонтрагентеПоДаннымФНС", ПараметрыЗапроса, , ПараметрыАвторизацииИПодписанияОрганизации, Организация);
					// После этого информация из ФНС, при наличии, отображается в наших данных.
					ИнформацияОКонтрагенте = ВыполнитьЗапросAPI("API_ИнформацияОКонтрагенте", ПараметрыЗапроса, , ПараметрыАвторизацииИПодписанияОрганизации, Организация);
				КонецЕсли;
				
				Если ИнформацияОКонтрагенте.Результат = Неопределено Тогда
					//Информации нет ни по нашим данным, ни по данным ФНС.
					Продолжить;
				КонецЕсли;
				
				МассивИдентификаторов = ИнформацияОКонтрагенте.Результат;
				
				Если МассивИдентификаторов.Количество() = 1 Тогда
					
					ИдентификаторОбрабатываемогоАбонента = МассивИдентификаторов[0].gid;
					ДанныеПоКонтрагенту = Новый Структура;
					ДанныеПоКонтрагенту.Вставить("Ссылка", Абонент);
					ДанныеПоКонтрагенту.Вставить("ИНН", СокрЛП(ИНН));
					ДанныеПоКонтрагенту.Вставить("КПП", СокрЛП(ИНН));
					ДанныеПоКонтрагенту.Вставить("Идентификатор", ИдентификаторОбрабатываемогоАбонента);
					
					ОбновитьИдентификаторыУчастниковЭДОНаСервере(ДанныеПоКонтрагенту, СвойствоИдентификатор);
					Продолжить;
					
				КонецЕсли;
				
				Для Каждого Оператор из ПриоритетИдентификаторов Цикл
					Для Каждого Идентификатор из МассивИдентификаторов Цикл
						Если Лев(Идентификатор.gid, 3) = Оператор.Значение Тогда
							ИдентификаторОбрабатываемогоАбонента = Идентификатор.gid;
							Прервать;
						КонецЕсли;	
					КонецЦикла;
					Если НЕ ИдентификаторОбрабатываемогоАбонента = "" Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если ИдентификаторОбрабатываемогоАбонента = "" Тогда
					ИдентификаторОбрабатываемогоАбонента = МассивИдентификаторов[0].gid;
				КонецЕсли;	                                                               
				
				// Фиксируем идентификатор.
				ДанныеПоКонтрагенту = Новый Структура;
				ДанныеПоКонтрагенту.Вставить("Ссылка", Абонент);
				ДанныеПоКонтрагенту.Вставить("ИНН", СокрЛП(ИНН));
				ДанныеПоКонтрагенту.Вставить("КПП", СокрЛП(ИНН));
				ДанныеПоКонтрагенту.Вставить("Идентификатор", ИдентификаторОбрабатываемогоАбонента);
				
				ОбновитьИдентификаторыУчастниковЭДОНаСервере(ДанныеПоКонтрагенту, СвойствоИдентификатор);
				Продолжить;
				
			Иначе	
				Если ИнформацияОКонтрагенте.КодСостояния = 401 Тогда
					Прервать;
				КонецЕсли;	
			КонецЕсли;	
			
		КонецЦикла;	
		
	КонецЕсли;	
	
КонецПроцедуры

Функция ЗаполнитьСписокПриоритетаПоУмолчанию()
	
	ПриоритетИдентификаторовСписок = Новый СписокЗначений;
			
	Макет = ЭтотОбъект.ПолучитьМакет("СлужебныеДанные"); 
	
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(Макет.Область());
    Построитель.ДобавлениеПредставлений = ТипДобавленияПредставлений.НеДобавлять;
    Построитель.ЗаполнитьНастройки();
    Построитель.Выполнить();
	
	ТЗ = Построитель.Результат.Выгрузить(); 
	
	Для каждого Строка из ТЗ цикл
		ПриоритетИдентификаторовСписок.Добавить(Строка.Идентификатор, Строка.Представление);
	КонецЦикла;
	
	Возврат ПриоритетИдентификаторовСписок;	
	
КонецФункции

Функция ЗаполнитьСписокПриоритетаИзНастройки() 

	Возврат ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_ПриоритетИдентификаторов",
	"СписокПриоритетов",
	"Список приоритетности операторов ЭДО",
	ПолучитьТекущегоПользователя())
		
КонецФункции
	
Процедура ОбновитьИдентификаторыАбонентовВФоне(Параметры, АдресРезультата) Экспорт
	
	ПользовательВладелецНастроек	= ?(Параметры.Свойство("Пользователь"), Параметры.Пользователь, Неопределено);        
	AccessToken						= ?(Параметры.Свойство("AccessToken"), Параметры.AccessToken, Неопределено);
	RefreshToken					= ?(Параметры.Свойство("RefreshToken"), Параметры.RefreshToken, Неопределено);
	Организация						= ?(Параметры.Свойство("Организация"), Параметры.Организация, Неопределено);
	Интеграция						= ?(Параметры.Свойство("Интеграция"), Параметры.Интеграция, Неопределено);
	ПриоритетИдентификаторов		= ?(Параметры.Свойство("ПриоритетИдентификаторов"), Параметры.ПриоритетИдентификаторов, Неопределено);
	СвойствоИдентификаторАбонента	= ?(Параметры.Свойство("СвойствоИдентификаторАбонента"), Параметры.СвойствоИдентификаторАбонента, Неопределено);
	ФиксироватьИнформациюОбОшибкахВЖурналеРегистрации = ?(Параметры.Свойство("ФиксироватьИнформациюОбОшибкахВЖурналеРегистрации"), Параметры.ФиксироватьИнформациюОбОшибкахВЖурналеРегистрации, Ложь);
	
	ОбновитьИдентификаторыАбонентов(ПользовательВладелецНастроек, Организация, AccessToken, RefreshToken, Интеграция, ПриоритетИдентификаторов, СвойствоИдентификаторАбонента, ФиксироватьИнформациюОбОшибкахВЖурналеРегистрации);
	
КонецПроцедуры

Процедура ОбновитьИдентификаторыАбонентов(ПользовательВладелецНастроек = Неопределено, Организация = Неопределено, AccessToken = Неопределено, RefreshToken = Неопределено, Интеграция = Неопределено, ПриоритетИдентификаторов = Неопределено, СвойствоИдентификаторАбонента = Неопределено, ФиксироватьИнформациюОбОшибкахВЖурналеРегистрации = Ложь) Экспорт
			
	Если ПользовательВладелецНастроек = Неопределено Тогда              
		ПользовательВладелецНастроек = ПолучитьТекущегоПользователя();
	КонецЕсли;
	
	Если Организация = Неопределено Тогда
		Если ФиксироватьИнформациюОбОшибкахВЖурналеРегистрации Тогда
			ЗаписьВЖурналРегистрации("Невозможно обновить Идентификаторы", "Предупреждение", "В параметры фонового задания не была передана ссылка на организацию.");
		КонецЕсли;	
		Возврат;
	КонецЕсли;
	
	Если Интеграция = Неопределено Тогда
		Интеграция = ПолучитьИнтеграциюНаСервере(ПользовательВладелецНастроек);
	КонецЕсли;  
	
	Если AccessToken = Неопределено Тогда
		ОрганизацияДокументовМассива = Организация;
		ПараметрыАвторизацииИПодписания = Интеграция.ПараметрыАвторизацииИПодписания;
		ПараметрыАвторизацииИПодписанияОрганизации = ПараметрыАвторизацииИПодписания[ОрганизацияДокументовМассива];
		AccessToken = ПараметрыАвторизацииИПодписанияОрганизации.AccessToken;
	КонецЕсли;
	
	Если RefreshToken = Неопределено Тогда
		ОрганизацияДокументовМассива = Организация;
		ПараметрыАвторизацииИПодписания = Интеграция.ПараметрыАвторизацииИПодписания;
		ПараметрыАвторизацииИПодписанияОрганизации = ПараметрыАвторизацииИПодписания[ОрганизацияДокументовМассива];
		RefreshToken = ПараметрыАвторизацииИПодписанияОрганизации.RefreshToken;
	КонецЕсли;
	
	Если Интеграция.СпособИнтеграции <> 2 Тогда //НЕ API
		Если ФиксироватьИнформациюОбОшибкахВЖурналеРегистрации Тогда
			ЗаписьВЖурналРегистрации("Невозможно обновить Идентификаторы", "Предупреждение", "Обновить идентификаторы абонентов можно только при способе обмена 'API'. Измените способ обмена в настройках и повторите попытку.");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если ПриоритетИдентификаторов = Неопределено Тогда
		Если ФиксироватьИнформациюОбОшибкахВЖурналеРегистрации Тогда
			ЗаписьВЖурналРегистрации("Невозможно обновить Идентификаторы", "Предупреждение", "В параметры фонового задания не был передан список приоритетности операторов.");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если СвойствоИдентификаторАбонента = Неопределено Тогда
		Если ФиксироватьИнформациюОбОшибкахВЖурналеРегистрации Тогда
			ЗаписьВЖурналРегистрации("Невозможно обновить Идентификаторы", "Предупреждение", "Не удалось определить ссылку на допсведение для хранения идентификаторов абонентов.");
		КонецЕсли;
		Возврат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Контрагенты.Ссылка,
	               |	Контрагенты.ИНН,
	               |	Контрагенты.КПП
	               |ПОМЕСТИТЬ СписокКонтрагентов
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ДополнительныеСведения
	               |		ПО Контрагенты.Ссылка = ДополнительныеСведения.Объект
	               |			И (ДополнительныеСведения.Значение ЕСТЬ NULL
	               |				ИЛИ ДополнительныеСведения.Значение = """")
	               |			И (ДополнительныеСведения.Свойство = &СвойствоИдентификаторАбонента)
	               |			И (ДополнительныеСведения.Объект ССЫЛКА Справочник.Контрагенты)
	               |ГДЕ
	               |	Контрагенты.ПометкаУдаления = Ложь
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(1) КАК КоличествоЭлементов
	               |ИЗ
	               |	СписокКонтрагентов КАК СписокКонтрагентов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СписокКонтрагентов.Ссылка,
	               |	СписокКонтрагентов.ИНН,
	               |	СписокКонтрагентов.КПП
	               |ИЗ
	               |	СписокКонтрагентов КАК СписокКонтрагентов";
	Запрос.УстановитьПараметр("СвойствоИдентификаторАбонента", СвойствоИдентификаторАбонента);
	Результаты = Запрос.ВыполнитьПакет();
	
	Результат = Результаты[2].Выбрать(); 
	
	ОбщееКоличествоОбрабатываемыхКонтрагентов = Результаты[1].Выгрузить()[0].КоличествоЭлементов;
	Счетчик = 1; 
	
	Пока Результат.Следующий() Цикл
		
		Контрагент	= Результат.Ссылка;
		ИНН			= Результат.ИНН;
		КПП			= Результат.КПП;
		
		ИдентификаторОбрабатываемогоКонтрагента = "";
		
		ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса(AccessToken);
		
		ПараметрыЗапроса.Параметры.Вставить("<inn>", СокрЛП(ИНН));
		Если ЗначениеЗаполнено(СокрЛП(КПП)) Тогда
			ПараметрыЗапроса.Параметры.Вставить("<kpp>", СокрЛП(КПП));
		КонецЕсли;
		
		ИнформацияОКонтрагенте = ВыполнитьЗапросAPI("API_ИнформацияОКонтрагенте", ПараметрыЗапроса, , ПараметрыАвторизацииИПодписанияОрганизации, Организация);
		
		Если НЕ ИнформацияОКонтрагенте.Ошибка Тогда
			
			Если ИнформацияОКонтрагенте.Результат = Неопределено Тогда
				ИнформацияОКонтрагентеПоДаннымФНС = ВыполнитьЗапросAPI("API_ИнформацияОКонтрагентеПоДаннымФНС", ПараметрыЗапроса, , ПараметрыАвторизацииИПодписанияОрганизации, Организация);
				// После этого информация из ФНС, при наличии, отображается в наших данных.
				ИнформацияОКонтрагенте = ВыполнитьЗапросAPI("API_ИнформацияОКонтрагенте", ПараметрыЗапроса, , ПараметрыАвторизацииИПодписанияОрганизации, Организация);
			КонецЕсли;
			
			Если ИнформацияОКонтрагенте.Результат = Неопределено Тогда
				//Информации нет ни по нашим данным, ни по данным ФНС.
				Если ФиксироватьИнформациюОбОшибкахВЖурналеРегистрации Тогда
					ЗаписьВЖурналРегистрации("Невозможно обновить идентификатор контрагента "+Контрагент, "Предупреждение", "Не удалось обнаружить информацию о регистрации такого абонента в ЭДО. (ИНН/КПП "+ИНН+"/"+КПП+")");
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			
			МассивИдентификаторов = ИнформацияОКонтрагенте.Результат;
			
			Если МассивИдентификаторов.Количество() = 1 Тогда
				
				ИдентификаторОбрабатываемогоКонтрагента = МассивИдентификаторов[0].gid;
				ДанныеПоКонтрагенту = Новый Структура;
				ДанныеПоКонтрагенту.Вставить("Ссылка", Контрагент);
				ДанныеПоКонтрагенту.Вставить("ИНН", СокрЛП(ИНН));
				ДанныеПоКонтрагенту.Вставить("КПП", СокрЛП(ИНН));
				ДанныеПоКонтрагенту.Вставить("Идентификатор", ИдентификаторОбрабатываемогоКонтрагента);
				
				ОбновитьИдентификаторыУчастниковЭДОНаСервере(ДанныеПоКонтрагенту, СвойствоИдентификаторАбонента);
				Продолжить;
				
			КонецЕсли;
			
			Для Каждого Оператор из ПриоритетИдентификаторов Цикл
				Для Каждого Идентификатор из МассивИдентификаторов Цикл
					Если Лев(Идентификатор.gid, 3) = Оператор.Значение Тогда
						ИдентификаторОбрабатываемогоКонтрагента = Идентификатор.gid;
						Прервать;
					КонецЕсли;	
				КонецЦикла;
				Если НЕ ИдентификаторОбрабатываемогоКонтрагента = "" Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ИдентификаторОбрабатываемогоКонтрагента = "" Тогда
				ИдентификаторОбрабатываемогоКонтрагента = МассивИдентификаторов[0].gid;
			КонецЕсли;	                                                               
			
			// Фиксируем идентификатор.
			ДанныеПоКонтрагенту = Новый Структура;
			ДанныеПоКонтрагенту.Вставить("Ссылка", Контрагент);
			ДанныеПоКонтрагенту.Вставить("ИНН", СокрЛП(ИНН));
			ДанныеПоКонтрагенту.Вставить("КПП", СокрЛП(ИНН));
			ДанныеПоКонтрагенту.Вставить("Идентификатор", ИдентификаторОбрабатываемогоКонтрагента);
			
			ОбновитьИдентификаторыУчастниковЭДОНаСервере(ДанныеПоКонтрагенту, СвойствоИдентификаторАбонента);
			Продолжить;
			
		Иначе
			Если ФиксироватьИнформациюОбОшибкахВЖурналеРегистрации Тогда
				ЗаписьВЖурналРегистрации("Невозможно обновить идентификатор контрагента "+Контрагент, "Предупреждение", ИнформацияОКонтрагенте.Описание);
			КонецЕсли; 
			
			Если ИнформацияОКонтрагенте.КодСостояния = 401 Тогда
				Если ФиксироватьИнформациюОбОшибкахВЖурналеРегистрации Тогда
					ЗаписьВЖурналРегистрации("Невозможно обновить Идентификаторы", "Предупреждение", "Токен авторизации некорректен.");
				КонецЕсли;
				Прервать;
			КонецЕсли;	
		КонецЕсли;	
		
		ИнформацияОКонтрагентеПоДаннымФНС = ВыполнитьЗапросAPI("API_ИнформацияОКонтрагентеПоДаннымФНС", ПараметрыЗапроса, , ПараметрыАвторизацииИПодписанияОрганизации, Организация);
		
		Прогресс = (Счетчик/ОбщееКоличествоОбрабатываемыхКонтрагентов)*100;
		Прогресс = Окр(Прогресс,0);
		
		ДлительныеОперации.СообщитьПрогресс(Прогресс, СокрЛП(Результат.Ссылка));
		
		Счетчик = Счетчик + 1;
		
	КонецЦикла
	
КонецПроцедуры

Процедура ОбновитьИдентификаторыУчастниковЭДОНаСервере(ДанныеПоКонтрагенту, СвойствоИдентификаторАбонента)
	
	Если ДанныеПоКонтрагенту.Идентификатор = "" Тогда  				
		Возврат;				
	КонецЕсли;    			
	
	РегистрСведений 	= РегистрыСведений.ДополнительныеСведения;
	МенеджерЗаписи 		= РегистрСведений.СоздатьМенеджерЗаписи();
	
	МенеджерЗаписи.Объект	= ДанныеПоКонтрагенту.Ссылка;
	МенеджерЗаписи.Свойство	= СвойствоИдентификаторАбонента;
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда
		
		Если МенеджерЗаписи.Значение <> ДанныеПоКонтрагенту.Идентификатор Тогда
			МенеджерЗаписи.Значение = ДанныеПоКонтрагенту.Идентификатор;				
			МенеджерЗаписи.Записать();
		КонецЕсли;
		
	Иначе
		
		МенеджерЗаписи.Объект	= ДанныеПоКонтрагенту.Ссылка;
		МенеджерЗаписи.Свойство	= СвойствоИдентификаторАбонента;
		МенеджерЗаписи.Значение = ДанныеПоКонтрагенту.Идентификатор;				
		МенеджерЗаписи.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ВычислениеИсточниковДанныхДляФормированияДокуменов

#Область СборДанныхПоАлгоритмамПечатныхФорм 

Функция ВызовСтандратногоАлгоритмаСбораДанныхПечатнойФормыУПД(СписокДокументов, ПрефиксКонфигурации)
	
	МассивРезультатов = Новый Массив;
	
	МассивДокументов = Новый Массив;
	МассивФактур = Новый Массив;
	
	Для Каждого Документ из СписокДокументов Цикл		
		Если Документ.Фактура = Null ИЛИ НЕ Найти(ПрефиксКонфигурации, "Розн") = 0 Тогда
			МассивДокументов.Добавить(Документ.Ссылка);
		Иначе
			МассивФактур.Добавить(Документ.Фактура);
		КонецЕсли;		
	КонецЦикла;
	
	Если НЕ Найти(ПрефиксКонфигурации, "БУХ_3_0_") = 0 Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "В настройках формирования документов для выбранного типа документа указан алгоритм сбора данных для печатной формы этого документа."+Символы.ПС+
			"К сожалению, для данной конфигурации (1С Бухгалтерия 3.0) эта функция неприменима."+Символы.ПС+
			"Обратитесь к техническому специалисту, реализовавшему этот вариант решения.";
		Сообщение.Сообщить();
		
	Иначе	
		
		ПараметрыПечати = Новый Структура;
		ПараметрыПечати.Вставить("ДополнитьКомплектВнешнимиПечатнымиФормами", Ложь);
		ПараметрыПечати.Вставить("НеВыводитьУПДПосредника", Истина);
		Если НЕ Найти(ПрефиксКонфигурации, "Розн") = 0 Тогда
			ПараметрыПечати.Вставить("Представление", "УПД (Универсальный передаточный документ)");	
		КонецЕсли;	
		
		Если НЕ Найти(ПрефиксКонфигурации, "Розн") = 0 Тогда
			
			ДанныеДокументовСФактурами	= Документы["РеализацияТоваров"].ПолучитьДанныеДляПечатнойФормыУПД(ПараметрыПечати, МассивДокументов);
			МассивРезультатов.Добавить(ДанныеДокументовСФактурами);	
			
		Иначе
			
			Если МассивФактур.Количество() > 0 Тогда 
				ДанныеДокументовСФактурами	= Документы["СчетФактураВыданный"].ПолучитьДанныеДляПечатнойФормыУПД(ПараметрыПечати, МассивФактур);
				МассивРезультатов.Добавить(ДанныеДокументовСФактурами);
			КонецЕсли;
			
			Если МассивДокументов.Количество() > 0 Тогда
				Если НЕ Найти(ПрефиксКонфигурации, "ERP_2_2") = 0 Тогда
					ДанныеДокументовБезФактур	= Документы["РеализацияТоваровУслуг"].ПолучитьДанныеДляПечатнойФормыУПД(ПараметрыПечати, МассивДокументов);
				Иначе
					ДанныеДокументовБезФактур	= Вычислить("РеализацияТоваровУслугЛокализация.ПолучитьДанныеДляПечатнойФормыУПД(ПараметрыПечати, МассивДокументов)");
				КонецЕсли;	
				МассивРезультатов.Добавить(ДанныеДокументовБезФактур);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат МассивРезультатов;
	
КонецФункции

Функция ВызовСтандратногоАлгоритмаСбораДанныхПечатнойФормыУПДи(СписокДокументов, ПрефиксКонфигурации)
	
	МассивРезультатов = Новый Массив;
	
	МассивДокументов = Новый Массив;
	МассивФактур = Новый Массив;
	
	Для Каждого Документ из СписокДокументов Цикл		
		Если Документ.Фактура = Null ИЛИ НЕ Найти(ПрефиксКонфигурации, "Розн") = 0 Тогда
			МассивДокументов.Добавить(Документ.Ссылка);
		Иначе
			МассивФактур.Добавить(Документ.Фактура);
		КонецЕсли;		
	КонецЦикла;
	
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ДополнитьКомплектВнешнимиПечатнымиФормами", Ложь);
	ПараметрыПечати.Вставить("НеВыводитьУПДПосредника", Истина);
	Если НЕ Найти(ПрефиксКонфигурации, "Розн") = 0 Тогда
		ПараметрыПечати.Вставить("Представление", "УПД (Универсальный передаточный документ)");	
	КонецЕсли;	
	
	Если НЕ Найти(ПрефиксКонфигурации, "Розн") = 0 Тогда
		
		ДанныеДокументовСФактурами	= Документы["РеализацияТоваров"].ПолучитьДанныеДляПечатнойФормыУПД(ПараметрыПечати, МассивДокументов);
		МассивРезультатов.Добавить(ДанныеДокументовСФактурами);	
		
	Иначе	
		
		Если МассивФактур.Количество() > 0 Тогда 
			ДанныеДокументовСФактурами	= Документы["СчетФактураВыданный"].ПолучитьДанныеДляПечатнойФормыУПД(ПараметрыПечати, МассивФактур);
			МассивРезультатов.Добавить(ДанныеДокументовСФактурами);
		КонецЕсли;
		
		Если МассивДокументов.Количество() > 0 Тогда
			Если НЕ Найти(ПрефиксКонфигурации, "ERP_2_2") = 0 Тогда
				ДанныеДокументовБезФактур	= Документы["КорректировкаРеализации"].ПолучитьДанныеДляПечатнойФормыУПД(ПараметрыПечати, МассивДокументов);
			Иначе
				ДанныеДокументовБезФактур	= Вычислить("КорректировкаРеализацииЛокализация.ПолучитьДанныеДляПечатнойФормыУПД(ПараметрыПечати, МассивДокументов)");
			КонецЕсли;	
			МассивРезультатов.Добавить(ДанныеДокументовБезФактур);
		КонецЕсли;
		
	КонецЕсли;

	
	Возврат МассивРезультатов;
	
КонецФункции

Функция ВызовСтандратногоАлгоритмаСбораДанныхПечатнойФормыУКД(СписокДокументов, ПрефиксКонфигурации)
	
	МассивРезультатов = Новый Массив;
	
	МассивДокументов = Новый Массив;
	МассивФактур = Новый Массив;
	
	Для Каждого Документ из СписокДокументов Цикл		
		Если Документ.Фактура = Null ИЛИ НЕ Найти(ПрефиксКонфигурации, "Розн") = 0 Тогда
			МассивДокументов.Добавить(Документ.Ссылка);
		Иначе
			МассивФактур.Добавить(Документ.Фактура);
		КонецЕсли;		
	КонецЦикла;
	
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ДополнитьКомплектВнешнимиПечатнымиФормами", Ложь);
	ПараметрыПечати.Вставить("НеВыводитьУПДПосредника", Истина);
	Если НЕ Найти(ПрефиксКонфигурации, "Розн") = 0 Тогда
		ПараметрыПечати.Вставить("Представление", "УПД (Универсальный передаточный документ)");	
	КонецЕсли;	
	
	Если НЕ Найти(ПрефиксКонфигурации, "Розн") = 0 Тогда
		
		ДанныеДокументовСФактурами	= Документы["РеализацияТоваров"].ПолучитьДанныеДляПечатнойФормыУКД(ПараметрыПечати, МассивДокументов);
		МассивРезультатов.Добавить(ДанныеДокументовСФактурами);	
		
	Иначе	
		
		Если МассивФактур.Количество() > 0 Тогда 
			ДанныеДокументовСФактурами	= Документы["СчетФактураВыданный"].ПолучитьДанныеДляПечатнойФормыУКД(ПараметрыПечати, МассивФактур);
			МассивРезультатов.Добавить(ДанныеДокументовСФактурами);
		КонецЕсли;
		
		Если МассивДокументов.Количество() > 0 Тогда
			Если НЕ Найти(ПрефиксКонфигурации, "ERP_2_2") = 0 Тогда
				ДанныеДокументовБезФактур	= Документы["КорректировкаРеализации"].ПолучитьДанныеДляПечатнойФормыУКД(ПараметрыПечати, МассивДокументов);
			Иначе
				ДанныеДокументовБезФактур	= Вычислить("КорректировкаРеализацииЛокализация.ПолучитьДанныеДляПечатнойФормыУКД(ПараметрыПечати, МассивДокументов)");
			КонецЕсли;	
			МассивРезультатов.Добавить(ДанныеДокументовБезФактур);
		КонецЕсли;
	
	КонецЕсли;

	
	Возврат МассивРезультатов;
	
КонецФункции
		
#КонецОбласти

Функция СборДанныхПоМаркамДокументаУПД(СписокДокументов, ПрефиксКонфигурации)

	МаркиТоваровДокументов = Новый Соответствие;
	
	Если НЕ Найти(ПрефиксКонфигурации, "Розн") = 0 Тогда
		Возврат Неопределено; // будет реализовано в следующих релизах
	Иначе	
		
		Если Метаданные.Константы.Найти("ВестиУчетОбувнойПродукцииИСМП") = Неопределено И Метаданные.Константы.Найти("ВестиУчетТабачнойПродукцииМОТП") = Неопределено 
			И Метаданные.Константы.Найти("ВестиУчетМаркируемойПродукцииИСМП") = Неопределено И Метаданные.Константы.Найти("ВестиУчетМаркировкиПродукцииВГИСМ") = Неопределено Тогда
			// Учет по маркам не поддерживается.
			Возврат Неопределено;
		ИначеЕсли Метаданные.Документы.РеализацияТоваровУслуг.ТабличныеЧасти.Найти("ШтрихкодыУпаковок") = Неопределено Тогда
			// Учет по маркам не поддерживается. По крайней мере типичным на момент написания методом.
			Возврат Неопределено;
		Иначе
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	РеализацияТоваровУслугШтрихкодыУпаковок.Ссылка КАК Документ,
			               |	РеализацияТоваровУслугШтрихкодыУпаковок.ШтрихкодУпаковки.Номенклатура КАК Номенклатура,
			               |	РеализацияТоваровУслугШтрихкодыУпаковок.ШтрихкодУпаковки.ЗначениеШтрихкода КАК Марка
			               |ИЗ
			               |	Документ.РеализацияТоваровУслуг.ШтрихкодыУпаковок КАК РеализацияТоваровУслугШтрихкодыУпаковок
			               |ГДЕ
			               |	РеализацияТоваровУслугШтрихкодыУпаковок.Ссылка В(&СписокДокументов)
			               |ИТОГИ ПО
			               |	Документ,
			               |	Номенклатура,
			               |	Марка";
			Запрос.УстановитьПараметр("СписокДокументов", СписокДокументов);
			ВыборкаПоДокументу = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаПоДокументу.Следующий() Цикл // выборка по Документу
				Документ = ВыборкаПоДокументу.Документ;
				МаркиТоваровПоДокументу = Новый Соответствие;
				ВыборкаПоНоменклатуре = ВыборкаПоДокументу.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаПоНоменклатуре.Следующий() Цикл // выборка по Номенклатуре
					МассивМарок = Новый Массив;
					ВыборкаМарок = ВыборкаПоНоменклатуре.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока ВыборкаМарок.Следующий() Цикл // выборка Марок
						МассивМарок.Добавить(ВыборкаМарок.Марка);
					КонецЦикла;
					МаркиТоваровПоДокументу.Вставить(ВыборкаПоНоменклатуре.Номенклатура, МассивМарок);
				КонецЦикла;
				МаркиТоваровДокументов.Вставить(ВыборкаПоДокументу.Документ, МаркиТоваровПоДокументу);
			КонецЦикла;	
						
			Возврат ?(МаркиТоваровДокументов.Количество() = 0, Неопределено, МаркиТоваровДокументов);
		
		КонецЕсли;	
			
	КонецЕсли;	
	
	Возврат Неопределено;
	
КонецФункции

Функция ДокументСодержитИнформациюПоМаркам(СсылкаНаДокумент)

	ДокументСодержитМарки = Ложь;
	
	Если Метаданные.Константы.Найти("ВестиУчетОбувнойПродукцииИСМП") = Неопределено И Метаданные.Константы.Найти("ВестиУчетТабачнойПродукцииМОТП") = Неопределено 
		И Метаданные.Константы.Найти("ВестиУчетМаркируемойПродукцииИСМП") = Неопределено И Метаданные.Константы.Найти("ВестиУчетМаркировкиПродукцииВГИСМ") = Неопределено Тогда
		// Учет по маркам не поддерживается.
		Возврат Ложь;
	КонецЕсли;
	
	МетаданныеДокумента = СсылкаНаДокумент.Метаданные();
	Если МетаданныеДокумента.ТабличныеЧасти.Найти("ШтрихкодыУпаковок") = Неопределено И МетаданныеДокумента.ТабличныеЧасти.Найти("АкцизныеМарки") = Неопределено Тогда
		// Учет по маркам не поддерживается для этого типа документов.
		Возврат Ложь;	
	КонецЕсли;
	
	Если НЕ МетаданныеДокумента.ТабличныеЧасти.Найти("ШтрихкодыУпаковок") = Неопределено И НЕ СсылкаНаДокумент.ШтрихкодыУпаковок.Количество() = 0 Тогда
		ДокументСодержитМарки = Истина;
	КонецЕсли;
	
	Если НЕ МетаданныеДокумента.ТабличныеЧасти.Найти("АкцизныеМарки") = Неопределено И НЕ СсылкаНаДокумент.АкцизныеМарки.Количество() = 0 Тогда
		ДокументСодержитМарки = Истина;
	КонецЕсли;	
	
	Возврат ДокументСодержитМарки;
	
КонецФункции

#КонецОбласти

#Область ФормированиеЭДПоАлгоритмамБЭД

#Область РедактированиеДокументовЧерезОбъектXDTO

// Не работает на линейке платформы 8.3.22. Зарегистрирована ошибка 1С №60003084.

// Для БЭД версий 1.8
Функция СформироватьЭДПоАлгоритмуБЭД_1_8_XDTO(МассивДокументов, ФорматВыгрузки, Кэш, ПараметрыАвторизацииИПодписания, ИнтеграцияКаталог, ИспользоватьПодписание, СоответствиеДокументФактура = Неопределено, ТипЭД = "", КодФормата = "", НастройкаВыгрузкиДополнительныхОбъектов = Неопределено, НастройкаРедактированияРезультата = Неопределено)
	
	// Часть алгоритма соответствует "Обработки.ОбменСКонтрагентами.ПодготовитьДанныеДляЗаполненияДокументов()"
	
	МассивДокументовКВыгрузке = Новый Массив; 
	НастройкиОбъектов = Новый Соответствие;
	ФактураПереданаВСоответствии = Ложь;
	ДокументФактураВыданный = Ложь;
	ДокументФактураВыданныйНаАванс = Ложь;
	
	ОбщийМодульОбменСКонтрагентамиСлужебный = Вычислить("ОбменСКонтрагентамиСлужебный");
	ОбщийМодульОбменСКонтрагентамиПовтИсп	= Вычислить("ОбменСКонтрагентамиПовтИсп");
	
	СведенияОФорматахТекущейКонфигурации = ОбщийМодульОбменСКонтрагентамиПовтИсп.СведенияОФорматахЭлектронныхДокументовИзМакета();
	
	Если ЗначениеЗаполнено(КодФормата) Тогда
		Отбор = Новый Структура();
		Отбор.Вставить("ИдентификаторФормата", КодФормата);
		СтрокиФорматов = СведенияОФорматахТекущейКонфигурации.НайтиСтроки(Отбор);
		Если СтрокиФорматов.Количество() = 0 Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Формат "+КодФормата+" недоступен для текущей конфигурации 1С.";
			Сообщение.Сообщить();
			Возврат Новый Массив;	
		КонецЕсли;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТаблицаФорматов.ИдентификаторФормата КАК ИдентификаторФормата,
		               |	ТаблицаФорматов.Отключен КАК Отключен,
		               |	ТаблицаФорматов.ДатаНачалаДействия КАК ДатаНачалаДействия,
		               |	ТаблицаФорматов.ДатаОкончанияДействия КАК ДатаОкончанияДействия
		               |ПОМЕСТИТЬ ТаблицаФорматов
		               |ИЗ
		               |	&СведенияОФорматахТекущейКонфигурации КАК ТаблицаФорматов
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ТаблицаФорматов.ИдентификаторФормата КАК ИдентификаторФормата
		               |ИЗ
		               |	ТаблицаФорматов КАК ТаблицаФорматов
		               |ГДЕ
		               |	ТаблицаФорматов.ИдентификаторФормата ПОДОБНО &ФорматВыгрузки
		               |	И ТаблицаФорматов.Отключен = ЛОЖЬ
		               |	И (ТаблицаФорматов.ДатаОкончанияДействия = &ПустаяДата
		               |			ИЛИ ТаблицаФорматов.ДатаОкончанияДействия > &ТекущаяДата)
		               |	И НЕ ТаблицаФорматов.ДатаНачалаДействия > &ТекущаяДата";
		Запрос.УстановитьПараметр("СведенияОФорматахТекущейКонфигурации", СведенияОФорматахТекущейКонфигурации);
		Запрос.УстановитьПараметр("ФорматВыгрузки", ФорматВыгрузки+"%");
		Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
		Результат = Запрос.Выполнить();
		Если Результат.Пустой() Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Формат "+ФорматВыгрузки+" недоступен для текущей конфигурации 1С.";
			Сообщение.Сообщить();
			Возврат Новый Массив;
		КонецЕсли;	
	КонецЕсли;
	
	Для Каждого СсылкаНаОбъект Из МассивДокументов Цикл
		
		НастройкиОбмена = ОбщийМодульОбменСКонтрагентамиСлужебный.ЗаполнитьПараметрыЭДПоИсточнику(СсылкаНаОбъект,,, Истина);
		
		Конфигурация = ПолучитьОбъектНастройкиПоИмениМетаданных("Конфигурация", Кэш);
		
		ИдОрганизации = ПолучитьИдентификаторЭДОПоСсылке(НастройкиОбмена.Организация, Конфигурация.ХранениеИнформации1С, ИнтеграцияКаталог);
		ИдКонтрагента = ПолучитьИдентификаторЭДОПоСсылке(НастройкиОбмена.Контрагент, Конфигурация.ХранениеИнформации1С, ИнтеграцияКаталог);
		
		Если СокрЛП(ИдОрганизации) = "" Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Документ " + СсылкаНаОбъект + " не выгружен. Не заполнен идентификатор организации """ + НастройкиОбмена.Организация + """!";
			Сообщение.Сообщить();
			Продолжить;	
		КонецЕсли;
		Если СокрЛП(ИдКонтрагента) = "" Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Документ " + СсылкаНаОбъект + " не выгружен. Не заполнен идентификатор контрагента """ + НастройкиОбмена.Контрагент + """!";
			Сообщение.Сообщить();
			Продолжить;	
		КонецЕсли;
		
		Если НЕ СоответствиеДокументФактура = Неопределено И НЕ СоответствиеДокументФактура.Получить(СсылкаНаОбъект) = Неопределено  Тогда
			ФактураПереданаВСоответствии = Истина;
		КонецЕсли;	
		
		Если НЕ Метаданные.Документы.Найти("СчетФактураВыданный") = Неопределено И ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
			ДокументФактураВыданный = Истина;
		КонецЕсли;		
		Если НЕ Метаданные.Документы.Найти("СчетФактураВыданныйАванс") = Неопределено И ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданныйАванс") Тогда
			ДокументФактураВыданныйНаАванс = Истина;
		КонецЕсли;
		
		Если ТипЭД = "" ИЛИ Метаданные.Перечисления.ВидыЭД.ЗначенияПеречисления.Найти(ТипЭД) = Неопределено Тогда 		
			Если ФорматВыгрузки = "ON_NSCHFDOPPR" Тогда
				Если ДокументФактураВыданный ИЛИ ДокументФактураВыданныйНаАванс Тогда
				//Если ФактураПереданаВСоответствии ИЛИ ДокументФактураВыданный ИЛИ ДокументФактураВыданныйНаАванс Тогда
					НастройкиОбмена.ВидЭД = Перечисления.ВидыЭД.СчетФактура;
				Иначе	
					НастройкиОбмена.ВидЭД = Перечисления.ВидыЭД.УПД;
				КонецЕсли;	
			ИначеЕсли ФорматВыгрузки = "ON_NKORSCHFDOPPR" Тогда
				НастройкиОбмена.ВидЭД = Перечисления.ВидыЭД.УКД;
			ИначеЕсли ФорматВыгрузки = "DP_TOVTORGPR" Тогда
				НастройкиОбмена.ВидЭД = Перечисления.ВидыЭД.ТОРГ12Продавец;
			ИначеЕсли ФорматВыгрузки = "DP_REZRUISP" Тогда
				НастройкиОбмена.ВидЭД = Перечисления.ВидыЭД.АктИсполнитель;	
			КонецЕсли;
			Если НЕ ТипЭД = "" И Метаданные.Перечисления.ВидыЭД.ЗначенияПеречисления.Найти(ТипЭД) = Неопределено Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Объявленного в настройке выгрузки вида электронного документа "+ТипЭД+" не существует. Документ будет выгружен по настройке "+НастройкиОбмена.ТипЭД+".";
				Сообщение.Сообщить();
			КонецЕсли;	
		Иначе
			НастройкиОбмена.ВидЭД = Перечисления.ВидыЭД[ТипЭД];
		КонецЕсли; 
		
		Если НЕ НастройкиОбмена.Свойство("ВерсияФормата") Тогда
			НастройкиОбмена.Вставить("ВерсияФормата", "");
		КонецЕсли;	
		
		Если НЕ КодФормата = "" Тогда			
			НастройкиОбмена.ВерсияФормата = КодФормата;			
		Иначе			
			Если ФорматВыгрузки = "DP_REZRUISP" Тогда
				НастройкиОбмена.ВерсияФормата = "DP_REZRUISP_1_990_01_05_01";
			ИначеЕсли ФорматВыгрузки = "DP_TOVTORGPR" Тогда
				НастройкиОбмена.ВерсияФормата = "DP_TOVTORGPR_1_992_01_05_01";
			ИначеЕсли ФорматВыгрузки = "ON_NSCHFDOPPR" Тогда
				НастройкиОбмена.ВерсияФормата = "ON_NSCHFDOPPR_1_997_01_05_01";
			ИначеЕсли ФорматВыгрузки = "ON_NKORSCHFDOPPR" Тогда
				НастройкиОбмена.ВерсияФормата = "ON_NKORSCHFDOPPR_1_996_03_05_01";	
			КонецЕсли;		
		КонецЕсли;
		
		НастройкиОбмена.Вставить("ИдентификаторОрганизации", ИдОрганизации);
		НастройкиОбмена.Вставить("ИдентификаторКонтрагента", ИдКонтрагента);
		
		НастройкиОбмена.Вставить("СпособОбменаЭД", Перечисления.СпособыОбменаЭД.БыстрыйОбмен);
		НастройкиОбмена.Вставить("МаршрутПодписания", Справочники.МаршрутыПодписания.ОднойДоступнойПодписью);
		НастройкиОбмена.Вставить("СоглашениеЭД", "");
		НастройкиОбмена.Вставить("Формировать", Истина);
		НастройкиОбмена.Вставить("ЭтоУПД"     , Ложь);
		Если НастройкиОбмена.ВидЭД = Перечисления.ВидыЭД.ТОРГ12Продавец 
				ИЛИ НастройкиОбмена.ВидЭД = Перечисления.ВидыЭД.АктИсполнитель 
				ИЛИ НастройкиОбмена.ВидЭД = Перечисления.ВидыЭД.СчетФактура Тогда
			НастройкиОбмена.Вставить("ИспользоватьУПД", Ложь);
		Иначе
			НастройкиОбмена.Вставить("ИспользоватьУПД", Истина);
		КонецЕсли;
		НастройкиОбмена.Вставить("ИспользоватьУКД", Истина);
		НастройкиОбмена.Вставить("Подписывать",     Ложь);
				
		ВерсияФормата = ОбщийМодульОбменСКонтрагентамиСлужебный.АктуальнаяВерсияФорматаЭД(НастройкиОбмена.ВидЭД);	
		НастройкиОбмена.Вставить("ВерсияФормата", ВерсияФормата);
		
		Если НастройкиОбмена.ВидЭД = Перечисления.ВидыЭД.АктИсполнитель Тогда
			ВерсияРегламентаЭДО = Перечисления.ВерсииРегламентаОбмена1С.Версия20;
			НастройкиОбмена.Вставить("ВерсияРегламентаЭДО", ВерсияРегламентаЭДО);
		КонецЕсли;	
		
		ТаблицаФорматов = ОбщийМодульОбменСКонтрагентамиСлужебный.ФорматыЭлектронныхДокументов();
		СведенияОФормате = ТаблицаФорматов.НайтиСтроки(Новый Структура("ВидЭлектронногоДокумента, ИдентификаторФормата", НастройкиОбмена.ВидЭД, ВерсияФормата));
		
		МассивДокументовКВыгрузке.Добавить(СсылкаНаОбъект);
		НастройкиОбъектов.Вставить(СсылкаНаОбъект, НастройкиОбмена);
		
	КонецЦикла;
	
	МоментВремениНачалаФормированияДокументов = ТекущаяДата();
	
	МассивСтруктурОбмена = ОбщийМодульОбменСКонтрагентамиСлужебный.СформироватьXMLФайлыДокументов(МассивДокументовКВыгрузке, НастройкиОбъектов);
	
	// Сформируем соответствие "Документ - Ошибки".
    ИнформацияПоОшибкамФормирования = ПодготовитьМассивОшибокФормированияДокументовБЭДизЖурналаРегистрации(МассивДокументов, МоментВремениНачалаФормированияДокументов);
	
	// МассивСтруктурОбмена содержит в себе результат формирования ЭД по алгоритму БЭД.
	
	ВыгрузкаДокументов = Новый Массив;
	
	Для Каждого СтруктураОбмена из МассивСтруктурОбмена Цикл
		
		// Прочитаем результат как XDTO объект.
		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьФайл(СтруктураОбмена.ПолноеИмяФайла); 
		ФабрикаФормата = Новый ФабрикаXDTO;
    	ДокументСтруктураXML = ФабрикаФормата.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
		УдалитьФайлы(СтруктураОбмена.ПолноеИмяФайла); // Сами результирующие файлы нам не нужны.
		
		// Актуализируем результат под наши требования.		
		АктуализироватьДанныеОператораЭДОДокументаПродажи_1_8_XDTO(ДокументСтруктураXML);
		
		// Подписант в документе не заполнен. По алгоритму БСП он заполняется в момент подписания.
		ДокументСтруктураXML.Документ.Сбросить("Подписант");
		
		// Перевод объекта XDTO в XML (строка) 	
		ПараметрыЗаписи = Новый ПараметрыЗаписиXML("Windows-1251", "1.0", Истина, Истина);
		ЗаписьXML = Новый ЗаписьXML();
		ЗаписьXML.УстановитьСтроку(ПараметрыЗаписи);
		ЗаписьXML.ЗаписатьОбъявлениеXML();   		
		ФабрикаФормата.ЗаписатьXML(ЗаписьXML, ДокументСтруктураXML, , , , НазначениеТипаXML.Неявное);
		
		XML = ЗаписьXML.Закрыть();
		
		// Приводим полученный нами XML к нужному нам виду.
		XML = УдалитьПространствоИменИзXML(XML, ФорматВыгрузки);
		
		// Определение и заполнение данных подписанта.
		ДанныеПодписанта = Неопределено;
		
		ЮрФизЛицоИППодписант = Неопределено;
		СубъектПодписант = Неопределено;	
		Если НЕ ПараметрыАвторизацииИПодписания = Неопределено Тогда
			Если ПараметрыАвторизацииИПодписания.Свойство("ПараметрыПодписания") Тогда
				Если ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("ТипСубъекта") Тогда
					ЮрФизЛицоИППодписант = ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ТипСубъекта;
				КонецЕсли;
				Если ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("Субъект") Тогда
					СубъектПодписант = ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Субъект;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
		
		Если ЮрФизЛицоИППодписант = Неопределено Тогда
			ЮрФизЛицоИППодписант = ?(СтрДлина(СокрЛП(СтруктураОбмена.СтруктураЭД.Организация.ИНН)) = 10, "ЮЛ", "ИП");
		КонецЕсли;
		
		ТипПродавца = ?(СтрДлина(СокрЛП(СтруктураОбмена.СтруктураЭД.Организация.ИНН)) = 10, "ЮрЛицо", "ИндПред");
		
		ПодписьСоответствуетОрганизации = Ложь;	
		
		Если НЕ СубъектПодписант = Неопределено Тогда
			// Были переданы данные о подписанте из ЭЦП.
			ЭЦП_ИНН = "";
			Если СубъектПодписант.Свойство("OID1_2_643_100_4") Тогда
				ЭЦП_ИНН = СубъектПодписант.OID1_2_643_100_4;
			ИначеЕсли СубъектПодписант.Свойство("OID1_2_643_3_131_1_1") Тогда
				ЭЦП_ИНН = СубъектПодписант.OID1_2_643_3_131_1_1;
			ИначеЕсли СубъектПодписант.Свойство("INNLE") Тогда
				ЭЦП_ИНН = СубъектПодписант.INNLE;
			ИначеЕсли СубъектПодписант.Свойство("ИННЮЛ") Тогда
				ЭЦП_ИНН = СубъектПодписант.ИННЮЛ;
			ИначеЕсли СубъектПодписант.Свойство("ИНН_ЮЛ") Тогда
				ЭЦП_ИНН = СубъектПодписант.ИНН_ЮЛ;
			ИначеЕсли СубъектПодписант.Свойство("ИНН") Тогда
				ЭЦП_ИНН = СубъектПодписант.ИНН;
			ИначеЕсли СубъектПодписант.Свойство("ИННОрганизации") Тогда
				ЭЦП_ИНН = СубъектПодписант.ИННОрганизации;
			ИначеЕсли СубъектПодписант.Свойство("ИНН_Организации") Тогда
				ЭЦП_ИНН = СубъектПодписант.ИНН_Организации;	
			КонецЕсли;
			Если ЭЦП_ИНН = "" Тогда
				ПодписьСоответствуетОрганизации = Ложь;
			Иначе	
				ПодписьСоответствуетОрганизации = СтрНайти(ЭЦП_ИНН, СтруктураОбмена.СтруктураЭД.Организация.ИНН) <> 0;
			КонецЕсли;	
		КонецЕсли;
		
		Если НЕ СубъектПодписант = Неопределено И НЕ ПодписьСоответствуетОрганизации И НЕ ЮрФизЛицоИППодписант = "ФЛ" Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Внимание! Приложенная подпись не принадлежит организации, указанной в документе!"+Символы.ПС+"Проверьте корректность подписи!"
				+Символы.ПС+"Данные о подписанте будут заполнены в соответствии с данными об руководителе организации из 1С.";
			Сообщение.Сообщить();
		КонецЕсли;
		
		
		
		Если ПодписьСоответствуетОрганизации Тогда
			
			// Были переданы данные о подписанте из ЭЦП.
			ДанныеПодписанта = Новый Структура;	
			ДанныеПодписанта.Вставить("Фамилия", СокрЛП(СубъектПодписант.OID2_5_4_4));
			ДанныеПодписанта.Вставить("Имя", СокрЛП(Лев(СубъектПодписант.OID2_5_4_42, СтрНайти(СубъектПодписант.OID2_5_4_42, " "))));
			ДанныеПодписанта.Вставить("Отчество", СокрЛП(Прав(СубъектПодписант.OID2_5_4_42, СтрДлина(СубъектПодписант.OID2_5_4_42) - СтрНайти(СубъектПодписант.OID2_5_4_42, " "))));
			Если ЮрФизЛицоИППодписант = "ЮЛ" И НЕ СубъектПодписант.Свойство("T") Тогда
				ДанныеПодписанта = Неопределено;
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "Внимание! В прилагаемой подписи отсутствует обязательная информация о должности подписанта!"+Символы.ПС+"Проверьте корректность подписи!";
				Сообщение.Сообщить();
			Иначе	
				ДанныеПодписанта.Вставить("Должность", ?(ЮрФизЛицоИППодписант = "ЮЛ", СокрЛП(СубъектПодписант.T), ""));
			КонецЕсли;
			
		ИначеЕсли ЮрФизЛицоИППодписант = "ФЛ" Тогда 
		
			// Были переданы данные о подписанте-физлице из ЭЦП.
			ДанныеПодписанта = Новый Структура;	
			ДанныеПодписанта.Вставить("Фамилия", СокрЛП(СубъектПодписант.OID2_5_4_4));
			ДанныеПодписанта.Вставить("Имя", СокрЛП(Лев(СубъектПодписант.OID2_5_4_42, СтрНайти(СубъектПодписант.OID2_5_4_42, " "))));
			ДанныеПодписанта.Вставить("Отчество", СокрЛП(Прав(СубъектПодписант.OID2_5_4_42, СтрДлина(СубъектПодписант.OID2_5_4_42) - СтрНайти(СубъектПодписант.OID2_5_4_42, " "))));	
			Если ТипПродавца = "ЮрЛицо" Тогда
				ДанныеПодписанта.Вставить("Должность", "Уполномоченное физическое лицо");
			Иначе
				ДанныеПодписанта.Вставить("Должность", "Индивидуальный предприниматель");	
			КонецЕсли;
			
		Иначе
			
			Если Найти(Кэш.ПрефиксКонфигурации, "УНФ") = 0 Тогда
				ДанныеПодписанта = ПолучитьФИОРуководителяОрганизацииНаДату_Стандарт(СтруктураОбмена.СтруктураЭД.Организация, СтруктураОбмена.СтруктураЭД.ДатаДокументаОтправителя, Кэш.ПрефиксКонфигурации);
			Иначе
				ДанныеПодписанта = ПолучитьФИОРуководителяОрганизацииНаДату_УНФ(СтруктураОбмена.СтруктураЭД.Организация, СтруктураОбмена.СтруктураЭД.ДатаДокументаОтправителя, Кэш.ПрефиксКонфигурации);
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ ДанныеПодписанта = Неопределено И НЕ ДанныеПодписанта.Фамилия = "" И НЕ ДанныеПодписанта.Имя = "" Тогда
			
			НаимОрг = СтруктураОбмена.СтруктураЭД.Организация.НаименованиеПолное;
			НаимОрг = СтрЗаменить(НаимОрг, "&", "&amp;");
			НаимОрг = СтрЗаменить(НаимОрг, """", "&quot;");
			НаимОрг = СтрЗаменить(НаимОрг, ">", "&gt;");
			НаимОрг = СтрЗаменить(НаимОрг, "<", "&lt;");
			
			ДанныеПодписанта.Вставить("НаимОрг", НаимОрг);     
			Если НЕ ЮрФизЛицоИППодписант = "ФЛ" Тогда 
				ДанныеПодписанта.Вставить("ИНН", СтруктураОбмена.СтруктураЭД.Организация.ИНН);
				ДанныеПодписанта.Вставить("ОснПолн", "Должностные обязанности");
			Иначе
				ДанныеПодписанта.Вставить("ИНН", СтруктураОбмена.СтруктураЭД.Организация.ИНН);
				ДанныеПодписанта.Вставить("ОснПолн", "Доверенность подписанта");
			КонецЕсли;
			
			Если ФорматВыгрузки = "DP_TOVTORGPR" ИЛИ ФорматВыгрузки = "DP_REZRUISP" Тогда
				ДанныеПодписанта.Вставить("ОблПолн", "2");
			ИначеЕсли ФорматВыгрузки = "ON_NKORSCHFDOPPR" Тогда
				ДанныеПодписанта.Вставить("ОблПолн", "6");	
			Иначе	
				ДанныеПодписанта.Вставить("ОблПолн", "5"); 
			КонецЕсли; 
			//Принимает значения:
			//0 - лицо, ответственное за подписание счетов-фактур |
			//1 - лицо, совершившее сделку, операцию |
			//2 - лицо, совершившее сделку, операцию и ответственное за ее оформление |
			//3 - лицо, ответственное за оформление свершившегося события |
			//4 - лицо, совершившее сделку, операцию и ответственное за подписание счетов-фактур |
			//5 - лицо, совершившее сделку, операцию и ответственное за ее оформление и за подписание счетов-фактур |
			//6 - лицо, ответственное за оформление свершившегося события и за подписание счетов-фактур
			
			Если НЕ ЮрФизЛицоИППодписант = "ФЛ" Тогда
				ДанныеПодписанта.Вставить("Статус", "1"); //Принимает значение:
				//1 - работник организации продавца товаров (работ, услуг, имущественных прав) |
				//2 - работник организации - составителя файла обмена информации продавца, если составитель файла обмена информации не является продавцом |
				//3 - работник иной уполномоченной организации |
				//4 - уполномоченное физическое лицо (в том числе индивидуальный предприниматель) 
			Иначе
				ДанныеПодписанта.Вставить("Статус", "1");
			КонецЕсли;
			
		Иначе
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Заполните руководителя для организации: " + СтруктураОбмена.СтруктураЭД.Организация;
			Сообщение.Сообщить();
			Продолжить;
		КонецЕсли;
		
		ЗавершитьЗаполнениеДокументаПродажи_1_8_XDTO(XML, ФорматВыгрузки, ДанныеПодписанта, ЮрФизЛицоИППодписант);
		
		Если НЕ НастройкаРедактированияРезультата = Неопределено Тогда
			ПараметрыФормирования = Новый Структура();
			ОсновныеДанныеДокумента = Новый Структура();
			ОсновныеДанныеДокумента.Вставить("СсылкаНаДокумент", СтруктураОбмена.СтруктураЭД.Владелец);
			ОсновныеДанныеДокумента.Вставить("ФорматВыгрузки", ФорматВыгрузки);
			ПараметрыФормирования.Вставить("ОсновныеДанныеДокумента", ОсновныеДанныеДокумента);
			ОбработатьРезультатФормирования_XDTO(XML, НастройкаРедактированияРезультата, ФорматВыгрузки, Кэш, СтруктураОбмена.СтруктураЭД.Владелец, ПараметрыФормирования);
		КонецЕсли;
		
		Если ИспользоватьПодписание Тогда
			ОбработкаПодписиФизлицаУспешна = ПоместитьВДокументИдентификаторДоверенностиФизлица_XDTO(XML, ПараметрыАвторизацииИПодписания, ФорматВыгрузки, Кэш, ЮрФизЛицоИППодписант);
		КонецЕсли;	
			
		ДокументСодержитМарки = Ложь;
		ДокументСодержитДанныеПрослеживаемости = Ложь;
		ДокументСодержитМарки = ДокументСодержитИнформациюПоМаркам(СтруктураОбмена.СтруктураЭД.Владелец);
		Если ДокументСодержитМарки = Ложь Тогда
			Если НЕ СтрНайти(XML, "СведПрослеж") = 0 Тогда
				ДокументСодержитМарки = Ложь;
				ДокументСодержитДанныеПрослеживаемости = Истина;
			ИначеЕсли НЕ СтрНайти(XML, "НомСредИдентТов") = 0 Тогда
				ДокументСодержитМарки = Истина;
			ИначеЕсли НЕ СтрНайти(XML, "НомСредИдентТовДо") = 0 Тогда
				ДокументСодержитМарки = Истина;
			ИначеЕсли НЕ СтрНайти(XML, "НомСредИдентТовПосле") = 0 Тогда
				ДокументСодержитМарки = Истина;	
			КонецЕсли;	
		КонецЕсли;	
				
		Идентификатор1С = Строка(Новый УникальныйИдентификатор);
		ДатаДокумента = Формат(СтруктураОбмена.СтруктураЭД.ДатаДокументаОтправителя, "ДФ=yyyyMMdd"); 
		ИмяФайла = СоставитьИмяФайлаПоИдентификаторам_XDTO(ДокументСтруктураXML.СвУчДокОбор, ФорматВыгрузки, ДокументСтруктураXML.Документ, ДатаДокумента, Идентификатор1С, ДокументСодержитМарки, ДокументСодержитДанныеПрослеживаемости);
		
		Если ДокументСодержитМарки И СтрНайти(XML, "ИдФайл="""+ФорматВыгрузки+"MARK") = 0 Тогда
			XML = СтрЗаменить(XML, "ИдФайл="""+ФорматВыгрузки, "ИдФайл="""+ФорматВыгрузки+"MARK");
		КонецЕсли;
		
		Если ДокументСодержитДанныеПрослеживаемости И СтрНайти(XML, "ИдФайл="""+ФорматВыгрузки+"PROS") = 0 Тогда
			XML = СтрЗаменить(XML, "ИдФайл="""+ФорматВыгрузки, "ИдФайл="""+ФорматВыгрузки+"PROS");
		КонецЕсли;
		
		СостояниеДокумента 	= ПолучитьСтруктуруСостоянияДокумента();
		
		СостояниеДокумента.Ссылка 					= СтруктураОбмена.СтруктураЭД.Владелец;
		СостояниеДокумента.Выгрузка 				= XML;
		СостояниеДокумента.ИмяФайла 				= ИмяФайла; 
		СостояниеДокумента.Идентификатор1С			= Идентификатор1С;
		СостояниеДокумента.Подписант 				= ДанныеПодписанта;
		СостояниеДокумента.ОтправительСсылка		= СтруктураОбмена.СтруктураЭД.Организация;
		СостояниеДокумента.ПолучательСсылка			= СтруктураОбмена.СтруктураЭД.Контрагент;
		СостояниеДокумента.ИдентификаторОтправителя	= СтруктураОбмена.СтруктураЭД.Отправитель;
		СостояниеДокумента.ИдентификаторПолучателя	= СтруктураОбмена.СтруктураЭД.Получатель;
		
		Если ОбработкаПодписиФизлицаУспешна = Ложь Тогда
			СостояниеДокумента.ОшибкиФормирования = Истина;
			СостояниеДокумента.ОписанияОшибокФормирования = "Ошибка применения для подписания документа сертификата физлица. Проверьте настройки и корректность заполнения идентификатора доверенности физлица.";
		КонецЕсли;	
		
		ВыгрузкаДокументов.Добавить(СостояниеДокумента);
		
		Если НЕ СостояниеДокумента.ОшибкиФормирования И НЕ НастройкаВыгрузкиДополнительныхОбъектов = Неопределено Тогда
			ДополнитьВыгрузкуДополнительнымиОбъектами(СтруктураОбмена.СтруктураЭД.Владелец, НастройкаВыгрузкиДополнительныхОбъектов, ВыгрузкаДокументов, Кэш, Конфигурация, ИнтеграцияКаталог, ИмяФайла, ИнформацияПоОшибкамФормирования);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИнформацияПоОшибкамФормирования.Количество() > 0 Тогда
		
		Для Каждого Ошибка из ИнформацияПоОшибкамФормирования Цикл 
			СостояниеДокумента 	= ПолучитьСтруктуруСостоянияДокумента();		
			СостояниеДокумента.Ссылка						= Ошибка.Документ;
			СостояниеДокумента.ОшибкиФормирования			= Истина;
			СостояниеДокумента.ОписанияОшибокФормирования	= Ошибка.ТекстОшибки;	
			ВыгрузкаДокументов.Добавить(СостояниеДокумента);
		КонецЦикла;
		
	КонецЕсли;	
	
	Возврат ВыгрузкаДокументов;
	
КонецФункции	

Процедура АктуализироватьДанныеОператораЭДОДокументаПродажи_1_8_XDTO(ДокументСтруктураXML)
	
	// Заполнение актуальных сведений об операторе связи ЭДО.
	СвОЭДОтпр	= ДокументСтруктураXML.СвУчДокОбор.СвОЭДОтпр;	
	СвОЭДОтпр.ИННЮЛ		= "9715260691";	
			
	Если ЭтоТестоваяОбработка Тогда
		// Тестовый
		СвОЭДОтпр.ИдЭДО 	= "2VO";  
	Иначе	
		// Бой
		СвОЭДОтпр.ИдЭДО 	= "2VO";
	КонецЕсли;
	
	СвОЭДОтпр.НаимОрг 	= "ООО &quot;Эвотор ОФД&quot;";	
	
КонецПроцедуры	

Процедура ЗавершитьЗаполнениеДокументаПродажи_1_8_XDTO(XML, ФорматВыгрузки, ДанныеПодписанта, Знач ЮрФизЛицоИППодписант)
	
	// Если Вы решили проанализировать код обработки и дошли до этого момента, то Вы должны знать, что да, мне стыдно. 
	// Но иначе реализовать не получилось.
	// А затем пропал смысл переделывать. Это логика для очень старой версии библиотеки БЭД.
	
	Если ЮрФизЛицоИППодписант = "ФЛ" Тогда
		ЮрФизЛицоИППодписант = "ЮЛ";
	КонецЕсли;
	
	ТекстЭлементаXMLФИО = "		<Подписант ";
	ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + "ОблПолн="""+ДанныеПодписанта.ОблПолн+"""";
	ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + Символы.ПС + "				Статус="""+ДанныеПодписанта.Статус+"""";
	ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + Символы.ПС + "				"+?(ФорматВыгрузки = "DP_REZRUISP", "ОснПолнПодп=""", "ОснПолн=""")+ДанныеПодписанта.ОснПолн+""">";
	ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + Символы.ПС + "			<"+ЮрФизЛицоИППодписант+" "+?(ЮрФизЛицоИППодписант = "ЮЛ", "ИННЮЛ", "ИННФЛ")+"="""+ДанныеПодписанта.ИНН+"""";
	Если ЮрФизЛицоИППодписант = "ЮЛ" Тогда
		ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + Символы.ПС + "					НаимОрг="""+ДанныеПодписанта.НаимОрг+"""";
		ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + Символы.ПС + "					Должн="""+ДанныеПодписанта.Должность+""">";
	Иначе
		ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + ">";	
	КонецЕсли;
	ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + Символы.ПС + "				<ФИО Фамилия="""+ДанныеПодписанта.Фамилия+"""";
	ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + Символы.ПС + "						Имя="""+ДанныеПодписанта.Имя+"""";
	ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + Символы.ПС + "						Отчество="""+ДанныеПодписанта.Отчество+"""/>";
	ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + Символы.ПС + "			</"+ЮрФизЛицоИППодписант+">";
	ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + Символы.ПС + "		</Подписант>";
	
	XML = СтрЗаменить(XML, "	</Документ>", ТекстЭлементаXMLФИО + Символы.ПС + "	</Документ>");
	
КонецПроцедуры	

// Для БЭД версий 1.9
Функция СформироватьЭДПоАлгоритмуБЭД_1_9_XDTO(МассивДокументов, ФорматВыгрузки, Кэш, ПараметрыАвторизацииИПодписания, ИнтеграцияКаталог, ИспользоватьПодписание, СоответствиеДокументФактура = Неопределено, ТипЭД = "", КодФормата = "", НастройкаВыгрузкиДополнительныхОбъектов = Неопределено, НастройкаРедактированияРезультата = Неопределено)
	
	ЭтоДокументПродажи = Ложь;
	
	// Часть алгоритма соответствует "ЭлектронныеДокументыЭДО.СформироватьДанныеДокументовДляВыгрузки()"

	Конфигурация = ПолучитьОбъектНастройкиПоИмениМетаданных("Конфигурация", Кэш);

	ОбщийМодульИнтеграцияЭДО			= Вычислить("ИнтеграцияЭДО");
	ОбщийМодульСинхронизацияЭДО			= Вычислить("СинхронизацияЭДО");
	ОбщийМодульЭлектронныеДокументыЭДО	= Вычислить("ЭлектронныеДокументыЭДО");
	ОбщийМодульФорматыЭДО				= Вычислить("ФорматыЭДО");
	ОбщийМодульФорматыЭДОПовтИсп		= Вычислить("ФорматыЭДОПовтИсп");
	ОбщийМодульОбщегоНазначенияБЭДО		= Вычислить("ОбщегоНазначенияБЭД");
	
	СведенияОФорматахТекущейКонфигурации = ОбщийМодульФорматыЭДОПовтИсп.СведенияОФорматахЭлектронныхДокументовИзМакета();
	
	Если ЗначениеЗаполнено(КодФормата) Тогда
		Отбор = Новый Структура();
		Отбор.Вставить("ИдентификаторФормата", КодФормата);
		СтрокиФорматов = СведенияОФорматахТекущейКонфигурации.НайтиСтроки(Отбор);
		Если СтрокиФорматов.Количество() = 0 Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Формат "+КодФормата+" недоступен для текущей конфигурации 1С.";
			Сообщение.Сообщить();
			Возврат Новый Массив;	
		КонецЕсли;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТаблицаФорматов.ИдентификаторФормата КАК ИдентификаторФормата,
		               |	ТаблицаФорматов.Отключен КАК Отключен,
		               |	ТаблицаФорматов.ДатаНачалаДействия КАК ДатаНачалаДействия,
		               |	ТаблицаФорматов.ДатаОкончанияДействия КАК ДатаОкончанияДействия
		               |ПОМЕСТИТЬ ТаблицаФорматов
		               |ИЗ
		               |	&СведенияОФорматахТекущейКонфигурации КАК ТаблицаФорматов
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ТаблицаФорматов.ИдентификаторФормата КАК ИдентификаторФормата
		               |ИЗ
		               |	ТаблицаФорматов КАК ТаблицаФорматов
		               |ГДЕ
		               |	ТаблицаФорматов.ИдентификаторФормата ПОДОБНО &ФорматВыгрузки
		               |	И ТаблицаФорматов.Отключен = ЛОЖЬ
		               |	И (ТаблицаФорматов.ДатаОкончанияДействия = &ПустаяДата
		               |			ИЛИ ТаблицаФорматов.ДатаОкончанияДействия > &ТекущаяДата)
		               |	И НЕ ТаблицаФорматов.ДатаНачалаДействия > &ТекущаяДата";
		Запрос.УстановитьПараметр("СведенияОФорматахТекущейКонфигурации", СведенияОФорматахТекущейКонфигурации);
		Запрос.УстановитьПараметр("ФорматВыгрузки", ФорматВыгрузки+"%");
		Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
		Результат = Запрос.Выполнить();
		Если Результат.Пустой() Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Формат "+ФорматВыгрузки+" недоступен для текущей конфигурации 1С.";
			Сообщение.Сообщить();
			Возврат Новый Массив;
		КонецЕсли;	
	КонецЕсли;  
	
	ОписанияОбъектовУчета = ОбщийМодульИнтеграцияЭДО.ОписанияОбъектовУчета(МассивДокументов);
	
	// Мы не можем зависеть от стандартных параметров ЭДО, заполним типы документов самостоятельно.
	// Заполняем базовыми типами, потом заменим их на требуемый.
	Если ФорматВыгрузки = "ON_NSCHFDOPPR" Тогда
		ЭтоДокументПродажи = Истина;
		ОписанияОбъектовУчета.ЗаполнитьЗначения(Перечисления.ТипыДокументовЭДО.ТоварнаяНакладная, "ТипДокумента");
	ИначеЕсли ФорматВыгрузки = "ON_NKORSCHFDOPPR" Тогда
		ЭтоДокументПродажи = Истина;
		ОписанияОбъектовУчета.ЗаполнитьЗначения(Перечисления.ТипыДокументовЭДО.СоглашениеОбИзмененииСтоимости, "ТипДокумента");
	ИначеЕсли ФорматВыгрузки = "DP_TOVTORGPR" Тогда
		ЭтоДокументПродажи = Истина;
		ОписанияОбъектовУчета.ЗаполнитьЗначения(Перечисления.ТипыДокументовЭДО.ТоварнаяНакладная, "ТипДокумента");
	ИначеЕсли ФорматВыгрузки = "DP_REZRUISP" Тогда
		ЭтоДокументПродажи = Истина;
		ОписанияОбъектовУчета.ЗаполнитьЗначения(Перечисления.ТипыДокументовЭДО.АктВыполненныхРабот, "ТипДокумента");
	КонецЕсли;	 

	ДанныеДокументов = ОбщийМодульСинхронизацияЭДО.НовыеДанныеОбъектов();
	
	ОписанияЗапросов = Новый Массив;
	ОписанияЗапросов.Добавить(ОбщийМодульИнтеграцияЭДО.ЗапросСведенийПоОбъектамУчетаИУчастникамЭДО(ОписанияОбъектовУчета, "СведенияПоОбъектамУчета"));
	ОписанияЗапросов.Добавить(ОбщийМодульЭлектронныеДокументыЭДО.ЗапросАктуальныхФорматов("АктуальныеФорматы"));
	
	// Поехали!
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СведенияПоОбъектамУчета.ОбъектУчета КАК ОбъектУчета,
		|	СведенияПоОбъектамУчета.Направление КАК Направление,
		|	СведенияПоОбъектамУчета.ТипДокумента КАК ТипДокумента,
		|	СведенияПоОбъектамУчета.ПрикладнойТипДокумента КАК ПрикладнойТипДокумента,
		|	СведенияПоОбъектамУчета.Организация КАК Организация,
		|	СведенияПоОбъектамУчета.Контрагент КАК Контрагент,
		|	СведенияПоОбъектамУчета.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	СведенияПоОбъектамУчета.ОрганизацияИНН КАК ОрганизацияИНН,
		|	СведенияПоОбъектамУчета.ОрганизацияКПП КАК ОрганизацияКПП,
		|	СведенияПоОбъектамУчета.КонтрагентИНН КАК КонтрагентИНН,
		|	СведенияПоОбъектамУчета.КонтрагентКПП КАК КонтрагентКПП,
		|	ВидыДокументовЭДО.Ссылка КАК ВидДокумента,
		|	ВидыДокументовЭДО.Наименование КАК ВидДокументаНаименование,
		|	АктуальныеФорматы.Формат
		|ИЗ
		|	СведенияПоОбъектамУчета КАК СведенияПоОбъектамУчета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыДокументовЭДО КАК ВидыДокументовЭДО
		|		ПО СведенияПоОбъектамУчета.ТипДокумента = ВидыДокументовЭДО.ТипДокумента
		|		И СведенияПоОбъектамУчета.ПрикладнойТипДокумента = ВидыДокументовЭДО.ПрикладнойТипДокумента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ АктуальныеФорматы КАК АктуальныеФорматы
		|		ПО ВидыДокументовЭДО.Ссылка = АктуальныеФорматы.ВидДокумента";
	
	Запрос = ОбщийМодульОбщегоНазначенияБЭДО.СоединитьЗапросы(Запрос, ОписанияЗапросов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	// МассивСтруктурОбмена содержит в себе результат формирования ЭД по алгоритму БСП.
	ВыгрузкаДокументов = Новый Массив;
	ИнформацияПоОшибкамФормирования = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Направление = Перечисления.НаправленияЭДО.Интеркампани Тогда 
			Продолжить;
		КонецЕсли;
			
		Настройки = ОбщийМодульФорматыЭДО.НовыеНастройкиФормированияДокументаПоОбъектуУчета();
		
		Настройки.ТипДокумента = Выборка.ТипДокумента;
		Настройки.Формат = Выборка.Формат;	
		
		Если НЕ ТипЭД = "" Тогда
			
			Если Метаданные.Перечисления.ТипыДокументовЭДО.ЗначенияПеречисления.Найти(ТипЭД) = Неопределено Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Объявленного в настройке выгрузки для формата "+ФорматВыгрузки+" вида электронного документа "+ТипЭД+" не существует. Документ не будет выгружен.";
				Сообщение.Сообщить();
				Продолжить;
			КонецЕсли;
			
			Настройки.ТипДокумента = Перечисления.ТипыДокументовЭДО[ТипЭД];
			
		Иначе	
		
			Если ФорматВыгрузки = "ON_NSCHFDOPPR" И НЕ СоответствиеДокументФактура = Неопределено И НЕ СоответствиеДокументФактура.Получить(Выборка.ОбъектУчета) = Неопределено Тогда 
				Настройки.ТипДокумента = Перечисления.ТипыДокументовЭДО.УПД;	
			КонецЕсли;	
			
			Если ФорматВыгрузки = "ON_NSCHFDOPPR" И НЕ СтрНайти(ТипЗнч(Выборка.ОбъектУчета), "фактура") = 0 Тогда 
				Настройки.ТипДокумента = Перечисления.ТипыДокументовЭДО.СчетФактура;	
			КонецЕсли;
			
			Если ФорматВыгрузки = "ON_NKORSCHFDOPPR" Тогда
				Если НЕ Метаданные.Документы.Найти("СчетФактураВыданный") = Неопределено И ТипЗнч(Выборка.ОбъектУчета) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
					Настройки.ТипДокумента = Перечисления.ТипыДокументовЭДО.УКД;
				Иначе
					Если НЕ СоответствиеДокументФактура = Неопределено И НЕ СоответствиеДокументФактура.Получить(Выборка.ОбъектУчета) = Неопределено Тогда
						Настройки.ТипДокумента = Перечисления.ТипыДокументовЭДО.УКД;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
			
			Если ФорматВыгрузки = "ON_NKORSCHFDOPPR" И НЕ СтрНайти(ТипЗнч(Выборка.ОбъектУчета), "фактура") = 0 Тогда 
				Настройки.ТипДокумента = Перечисления.ТипыДокументовЭДО.КорректировочныйСчетФактура;	
			КонецЕсли; 
		
		КонецЕсли;
		
		Если НЕ КодФормата = "" Тогда
			
			Настройки.Формат = КодФормата;
			
		Иначе	
		
			Если ФорматВыгрузки = "DP_REZRUISP" Тогда
				Настройки.Формат = "DP_REZRUISP_1_990_01_05_01";
			ИначеЕсли ФорматВыгрузки = "DP_TOVTORGPR" Тогда
				Настройки.Формат = "DP_TOVTORGPR_1_992_01_05_01";	
			КонецЕсли;
		
		КонецЕсли;
		
		Настройки.ОтключитьРассчетДополнительныхПолей = Истина;
		
		Данные = ОбщийМодульФорматыЭДО.НовыеДанныеДляФормированияОсновногоТитула();
		Данные.УникальныйИдентификатор = Строка(Новый УникальныйИдентификатор);
		Данные.Участники.ИдентификаторОтправителя = ПолучитьИдентификаторЭДОПоСсылке(Выборка.Организация, Конфигурация.ХранениеИнформации1С, ИнтеграцияКаталог);
		Данные.Участники.ИдентификаторПолучателя = ПолучитьИдентификаторЭДОПоСсылке(Выборка.Контрагент, Конфигурация.ХранениеИнформации1С, ИнтеграцияКаталог);
		
		// Было бы смешно, если бы не было так грустно.
		// Кто-то действительно удалил 1 букву и это попало в релиз.
		// Было актуально несколько релизов. В частности, в 1.9.3.69.
		Попытка
			ПараметрыФормирования = ОбщийМодульИнтеграцияЭДО.НовыеПараметрыФормированияДанныхОбъектаУчета();
		Исключение
			ПараметрыФормирования = ОбщийМодульИнтеграцияЭДО.НовыеПараметрыФормированияДанныхОбъектаУчет();
		КонецПопытки;
		
		ЗаполнитьЗначенияСвойств(ПараметрыФормирования, Настройки);
		ОписаниеДанных = ОбщийМодульИнтеграцияЭДО.ОписаниеДанныхОбъектаУчета(Выборка.ОбъектУчета,
			ПараметрыФормирования);
		Данные.ДанныеДокумента = ОписаниеДанных.Данные;
		
		// Поскольку мы заполнили типы документов самостоятельно, могли неверно расчитаться значения функций.
		// Дополнительный контроль.
		Если НЕ Данные.ДанныеДокумента.Строки.Количество() = 0 Тогда
			Если ФорматВыгрузки = "ON_NSCHFDOPPR" ИЛИ ФорматВыгрузки = "ON_NKORSCHFDOPPR" Тогда
				Если НЕ СоответствиеДокументФактура = Неопределено Тогда
					// Раньше для понимания наличия фактуры я пытался использовать ОписаниеДанных.СвязанныеОбъектыУчета,
					// но фактуры иногда просто выпадают из поля зрения алгоритма.
					Если НЕ СоответствиеДокументФактура.Получить(Выборка.ОбъектУчета) = Неопределено Тогда
						Если ФорматВыгрузки = "ON_NSCHFDOPPR" Тогда
							Данные.ДанныеДокумента.Строки.Найти("Функция", "ПолныйПуть", Истина).Значение = "СЧФДОП";
						ИначеЕсли ФорматВыгрузки = "ON_NKORSCHFDOPPR" Тогда
							Данные.ДанныеДокумента.Строки.Найти("Функция", "ПолныйПуть", Истина).Значение = "КСЧФДИС"; 	
						КонецЕсли;	
					Иначе	
						Если ФорматВыгрузки = "ON_NSCHFDOPPR" Тогда
							Данные.ДанныеДокумента.Строки.Найти("Функция", "ПолныйПуть", Истина).Значение = "ДОП";
						ИначеЕсли ФорматВыгрузки = "ON_NKORSCHFDOPPR" Тогда
							Данные.ДанныеДокумента.Строки.Найти("Функция", "ПолныйПуть", Истина).Значение = "ДИС";
						КонецЕсли;	
					КонецЕсли;	
				КонецЕсли;
				Если НЕ Метаданные.Документы.Найти("СчетФактураВыданный") = Неопределено И ТипЗнч(Выборка.ОбъектУчета) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
					Если ФорматВыгрузки = "ON_NSCHFDOPPR" Тогда
						Данные.ДанныеДокумента.Строки.Найти("Функция", "ПолныйПуть", Истина).Значение = "СЧФДОП";
					ИначеЕсли ФорматВыгрузки = "ON_NKORSCHFDOPPR" Тогда
						Данные.ДанныеДокумента.Строки.Найти("Функция", "ПолныйПуть", Истина).Значение = "КСЧФДИС"; 	
					КонецЕсли;
				КонецЕсли;
				Если Настройки.ТипДокумента = Перечисления.ТипыДокументовЭДО.СчетФактура Тогда
					Данные.ДанныеДокумента.Строки.Найти("Функция", "ПолныйПуть", Истина).Значение = "СЧФ";
				КонецЕсли;
				Если Настройки.ТипДокумента = Перечисления.ТипыДокументовЭДО.КорректировочныйСчетФактура Тогда
					Данные.ДанныеДокумента.Строки.Найти("Функция", "ПолныйПуть", Истина).Значение = "КСЧФ";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
		
		МоментВремениНачалаФормированияДокумента = ТекущаяДата();
		
		РезультатФормирования = ОбщийМодульФорматыЭДО.СформироватьДанныеОсновногоТитулаПоОбъектуУчета(
			Выборка.ОбъектУчета, Настройки, Данные);	
			
		// Обработаем информацию об ошибках.
		Если РезультатФормирования.ЕстьОшибки Тогда
			ТекстОшибокДляИнформацииПоОшибкам = "";
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Произошли ошибки при формировании электронного документа по документу "+Выборка.ОбъектУчета+":";
			Сообщение.Сообщить();
			Если РезультатФормирования.Свойство("Ошибки") И РезультатФормирования.Ошибки.Свойство("ЗаполнениеДанных") И ТипЗнч(РезультатФормирования.Ошибки.ЗаполнениеДанных) = Тип("Массив") Тогда
				Для Каждого Ошибка из РезультатФормирования.Ошибки.ЗаполнениеДанных Цикл
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = Ошибка.ТекстОшибки;
					Сообщение.Сообщить();
					ТекстОшибокДляИнформацииПоОшибкам = ТекстОшибокДляИнформацииПоОшибкам +Символы.ПС+ Ошибка.ТекстОшибки;
				КонецЦикла;	
			КонецЕсли;
			Если НЕ СокрЛП(ТекстОшибокДляИнформацииПоОшибкам) = "" Тогда
				СтруктураОшибки = Новый Структура;
				СтруктураОшибки.Вставить("Документ", Выборка.ОбъектУчета);	
				СтруктураОшибки.Вставить("ТекстОшибки", СокрЛП(ТекстОшибокДляИнформацииПоОшибкам));
				ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
			КонецЕсли;
			
			// Не все ошибки записываются в "РезультатФормирования.Ошибки". Некоторые отмечаются только в журнале регистрации.
			МассивОбъектаУчета = Новый Массив;
			МассивОбъектаУчета.Добавить(Выборка.ОбъектУчета);
			МассивОшибокПоЗаписямЖурнала = ПодготовитьМассивОшибокФормированияДокументовБЭДизЖурналаРегистрации(МассивОбъектаУчета, МоментВремениНачалаФормированияДокумента);
			Для Каждого ОшибкаЖурнала из МассивОшибокПоЗаписямЖурнала Цикл
				Если ОшибкаЖурнала.Документ = Неопределено Тогда
					СтруктураОшибки = Новый Структура;
					СтруктураОшибки.Вставить("Документ", Выборка.ОбъектУчета);	
					СтруктураОшибки.Вставить("ТекстОшибки", ОшибкаЖурнала.ТекстОшибки);
					ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
				Иначе	
					ИнформацияПоОшибкамФормирования.Добавить(ОшибкаЖурнала);
				КонецЕсли;	
			КонецЦикла;
			
			Продолжить;	
		КонецЕсли;		
			
		ПолноеИмяФайлаЭД = КаталогВременныхФайлов()+РезультатФормирования.Документ.ИмяФайла;
		РезультатФормирования.Документ.ДвоичныеДанные.Записать(КаталогВременныхФайлов()+РезультатФормирования.Документ.ИмяФайла);	
			
		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьФайл(ПолноеИмяФайлаЭД); 
		ФабрикаФормата = Новый ФабрикаXDTO;
		ДокументСтруктураXML = ФабрикаФормата.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
		УдалитьФайлы(ПолноеИмяФайлаЭД);
		
		// Подписант в документе не заполнен. По алгоритму БСП он заполняется в момент подписания.
		ДокументСтруктураXML.Документ.Сбросить("Подписант");
		
		XML = "";
		
		ЮрФизЛицоИППодписант = Неопределено;
		СубъектПодписант = Неопределено;	
		Если НЕ ПараметрыАвторизацииИПодписания = Неопределено Тогда
			Если ПараметрыАвторизацииИПодписания.Свойство("ПараметрыПодписания") Тогда
				Если ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("ТипСубъекта") Тогда
					ЮрФизЛицоИППодписант = ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ТипСубъекта;
				КонецЕсли;
				Если ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("Субъект") Тогда
					СубъектПодписант = ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Субъект;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
		
		Если ЮрФизЛицоИППодписант = Неопределено Тогда
			ЮрФизЛицоИППодписант = ?(СтрДлина(СокрЛП(Выборка.ОрганизацияИНН)) = 10, "ЮЛ", "ИП");
		КонецЕсли;
		
		ДанныеПодписанта = Неопределено;
		
		Если ЭтоДокументПродажи Тогда
			ЗавершитьЗаполнениеДокументаПродажи_1_9_XDTO(ДокументСтруктураXML, Выборка, ФорматВыгрузки, ФабрикаФормата, Кэш, ПараметрыАвторизацииИПодписания, ЮрФизЛицоИППодписант, СубъектПодписант, XML, ДанныеПодписанта);
		КонецЕсли;
		
		ДокументСодержитМарки = Ложь;
		ДокументСодержитДанныеПрослеживаемости = Ложь;
		ДокументСодержитМарки = ДокументСодержитИнформациюПоМаркам(Выборка.ОбъектУчета);
		Если ДокументСодержитМарки = Ложь Тогда
			Если НЕ СтрНайти(XML, "СведПрослеж") = 0 Тогда
				ДокументСодержитМарки = Ложь;
				ДокументСодержитДанныеПрослеживаемости = Истина;
			ИначеЕсли НЕ СтрНайти(XML, "НомСредИдентТов") = 0 Тогда
				ДокументСодержитМарки = Истина;
			ИначеЕсли НЕ СтрНайти(XML, "НомСредИдентТовДо") = 0 Тогда
				ДокументСодержитМарки = Истина;
			ИначеЕсли НЕ СтрНайти(XML, "НомСредИдентТовПосле") = 0 Тогда
				ДокументСодержитМарки = Истина;	
			КонецЕсли;	
		КонецЕсли;
		
		Если ДокументСодержитМарки И СтрНайти(XML, "ИдФайл="""+ФорматВыгрузки+"MARK") = 0 Тогда
			XML = СтрЗаменить(XML, "ИдФайл="""+ФорматВыгрузки, "ИдФайл="""+ФорматВыгрузки+"MARK");
		КонецЕсли;
		
		Если ДокументСодержитДанныеПрослеживаемости И СтрНайти(XML, "ИдФайл="""+ФорматВыгрузки+"PROS") = 0 Тогда
			XML = СтрЗаменить(XML, "ИдФайл="""+ФорматВыгрузки, "ИдФайл="""+ФорматВыгрузки+"PROS");
		КонецЕсли;
		
		Если НЕ НастройкаРедактированияРезультата = Неопределено Тогда
			ПараметрыФормирования = Новый Структура();
			ОсновныеДанныеДокумента = Новый Структура();
			ОсновныеДанныеДокумента.Вставить("СсылкаНаДокумент", Выборка.ОбъектУчета);
			ОсновныеДанныеДокумента.Вставить("ФорматВыгрузки", ФорматВыгрузки);
			ПараметрыФормирования.Вставить("ОсновныеДанныеДокумента", ОсновныеДанныеДокумента);
			ОбработатьРезультатФормирования_XDTO(XML, НастройкаРедактированияРезультата, ФорматВыгрузки, Кэш, Выборка.ОбъектУчета, ПараметрыФормирования);
		КонецЕсли;
		
		Если ИспользоватьПодписание Тогда
			ОбработкаПодписиФизлицаУспешна = ПоместитьВДокументИдентификаторДоверенностиФизлица_XDTO(XML, ПараметрыАвторизацииИПодписания, ФорматВыгрузки, Кэш, ЮрФизЛицоИППодписант);
		КонецЕсли;
		
		Идентификатор1С = Строка(Новый УникальныйИдентификатор);
		ДатаДокумента = Формат(Выборка.ОбъектУчета.Дата, "ДФ=yyyyMMdd");
		ИмяФайла = СоставитьИмяФайлаПоИдентификаторам_XDTO(ДокументСтруктураXML.СвУчДокОбор, ФорматВыгрузки, ДокументСтруктураXML.Документ, ДатаДокумента, Идентификатор1С, ДокументСодержитМарки, ДокументСодержитДанныеПрослеживаемости);
		
		СостояниеДокумента 	= ПолучитьСтруктуруСостоянияДокумента();
		
		Если НЕ СоответствиеДокументФактура = Неопределено И НЕ СоответствиеДокументФактура.Получить(Выборка.ОбъектУчета) = Неопределено Тогда
			СостояниеДокумента.Ссылка 				= СоответствиеДокументФактура.Получить(Выборка.ОбъектУчета);
		Иначе
			СостояниеДокумента.Ссылка 				= Выборка.ОбъектУчета;
		КонецЕсли;	
		СостояниеДокумента.Выгрузка 				= XML;
		СостояниеДокумента.ИмяФайла 				= ИмяФайла; 
		СостояниеДокумента.Идентификатор1С			= Идентификатор1С;
		СостояниеДокумента.Подписант 				= ДанныеПодписанта;
		СостояниеДокумента.ОтправительСсылка		= Выборка.Организация;
		СостояниеДокумента.ПолучательСсылка			= Выборка.Контрагент;
		СостояниеДокумента.ИдентификаторОтправителя	= Данные.Участники.ИдентификаторОтправителя;
		СостояниеДокумента.ИдентификаторПолучателя	= Данные.Участники.ИдентификаторПолучателя;
		
		Если ОбработкаПодписиФизлицаУспешна = Ложь Тогда
			СостояниеДокумента.ОшибкиФормирования = Истина;
			СостояниеДокумента.ОписанияОшибокФормирования = "Ошибка применения для подписания документа сертификата физлица. Проверьте настройки и корректность заполнения идентификатора доверенности физлица.";
		КонецЕсли;
		
		ВыгрузкаДокументов.Добавить(СостояниеДокумента);
		
		Если НЕ СостояниеДокумента.ОшибкиФормирования И НЕ НастройкаВыгрузкиДополнительныхОбъектов = Неопределено Тогда
			ДополнитьВыгрузкуДополнительнымиОбъектами(Выборка.ОбъектУчета, НастройкаВыгрузкиДополнительныхОбъектов, ВыгрузкаДокументов, Кэш, Конфигурация, ИнтеграцияКаталог, ИмяФайла, ИнформацияПоОшибкамФормирования);
		КонецЕсли;	
		
	КонецЦикла;
	
	Если ИнформацияПоОшибкамФормирования.Количество() > 0 Тогда		
		
		Для Каждого Ошибка из ИнформацияПоОшибкамФормирования Цикл 
			СостояниеДокумента 	= ПолучитьСтруктуруСостоянияДокумента();			
			СостояниеДокумента.Ссылка						= Ошибка.Документ;
			СостояниеДокумента.ОшибкиФормирования			= Истина;
			СостояниеДокумента.ОписанияОшибокФормирования	= Ошибка.ТекстОшибки;	
			ВыгрузкаДокументов.Добавить(СостояниеДокумента);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ВыгрузкаДокументов;
	
КонецФункции

Процедура ЗавершитьЗаполнениеДокументаПродажи_1_9_XDTO(ДокументСтруктураXML, ЭлементВыборкиПоДокументам, ФорматВыгрузки, ФабрикаФормата, Кэш, ПараметрыАвторизацииИПодписания, ЮрФизЛицоИППодписант, СубъектПодписант, XML, ДанныеПодписанта)
	
	// Актуализируем результат под наши требования
	СвОЭДОтпрОбъектXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "anyType"));
	АтрибутСтрока = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "string"), "");
	СвОЭДОтпрОбъектXDTO.Добавить(ФормаXML.Атрибут, "", "ИННЮЛ", АтрибутСтрока);
	СвОЭДОтпрОбъектXDTO.Добавить(ФормаXML.Атрибут, "", "ИдЭДО", АтрибутСтрока);
	СвОЭДОтпрОбъектXDTO.Добавить(ФормаXML.Атрибут, "", "НаимОрг", АтрибутСтрока);
	ДокументСтруктураXML.СвУчДокОбор.Добавить(ФормаXML.Элемент, "", "СвОЭДОтпр", СвОЭДОтпрОбъектXDTO);
	
	// Заполнение актуальных сведений об операторе связи ЭДО.
	СвОЭДОтпр 			= ДокументСтруктураXML.СвУчДокОбор.СвОЭДОтпр;	
	СвОЭДОтпр.ИННЮЛ		= "9715260691";	
	
	Если ЭтоТестоваяОбработка Тогда
		// Тестовый
		СвОЭДОтпр.ИдЭДО 	= "2VO";  
	Иначе	
		// Бой
		СвОЭДОтпр.ИдЭДО 	= "2VO";
	КонецЕсли;
	
	СвОЭДОтпр.НаимОрг 	= "ООО &quot;Эвотор ОФД&quot;";
	
	// Перевод объекта XDTO в XML (строка) 	
	ПараметрыЗаписи = Новый ПараметрыЗаписиXML("Windows-1251", "1.0", Истина, Истина);
	ЗаписьXML = Новый ЗаписьXML();
	ЗаписьXML.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписьXML.ЗаписатьОбъявлениеXML();   		
	ФабрикаФормата.ЗаписатьXML(ЗаписьXML, ДокументСтруктураXML, , , , НазначениеТипаXML.Неявное);
	
	// Приводим полученный нами XML к нужному нам виду.
	XML = ЗаписьXML.Закрыть();		
	XML = УдалитьПространствоИменИзXML(XML, ФорматВыгрузки);
	
	// Определение и заполнение данных подписанта.
	ДанныеПодписанта = Неопределено;
		
	Если НЕ ПараметрыАвторизацииИПодписания = Неопределено Тогда
		Если ПараметрыАвторизацииИПодписания.Свойство("ПараметрыПодписания") Тогда
			Если ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("ТипСубъекта") Тогда
				ЮрФизЛицоИППодписант = ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ТипСубъекта;
			КонецЕсли;
			Если ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("Субъект") Тогда
				СубъектПодписант = ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Субъект;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
	Если ЮрФизЛицоИППодписант = Неопределено Тогда
		ЮрФизЛицоИППодписант = ?(СтрДлина(СокрЛП(ЭлементВыборкиПоДокументам.ОрганизацияИНН)) = 10, "ЮЛ", "ИП");
	КонецЕсли; 
	
	ТипПродавца = ?(СтрДлина(СокрЛП(ЭлементВыборкиПоДокументам.ОрганизацияИНН)) = 10, "ЮрЛицо", "ИндПред");
	
	ПодписьСоответствуетОрганизации = Ложь;
	
	Если НЕ СубъектПодписант = Неопределено Тогда
		// Были переданы данные о подписанте из ЭЦП.
		ЭЦП_ИНН = "";
		Если СубъектПодписант.Свойство("OID1_2_643_100_4") Тогда
			ЭЦП_ИНН = СубъектПодписант.OID1_2_643_100_4;
		ИначеЕсли СубъектПодписант.Свойство("OID1_2_643_3_131_1_1") Тогда
			ЭЦП_ИНН = СубъектПодписант.OID1_2_643_3_131_1_1;
		ИначеЕсли СубъектПодписант.Свойство("INNLE") Тогда
			ЭЦП_ИНН = СубъектПодписант.INNLE;
		ИначеЕсли СубъектПодписант.Свойство("ИННЮЛ") Тогда
			ЭЦП_ИНН = СубъектПодписант.ИННЮЛ;
		ИначеЕсли СубъектПодписант.Свойство("ИНН_ЮЛ") Тогда
			ЭЦП_ИНН = СубъектПодписант.ИНН_ЮЛ;
		ИначеЕсли СубъектПодписант.Свойство("ИНН") Тогда
			ЭЦП_ИНН = СубъектПодписант.ИНН;
		ИначеЕсли СубъектПодписант.Свойство("ИННОрганизации") Тогда
			ЭЦП_ИНН = СубъектПодписант.ИННОрганизации;
		ИначеЕсли СубъектПодписант.Свойство("ИНН_Организации") Тогда
			ЭЦП_ИНН = СубъектПодписант.ИНН_Организации;	
		КонецЕсли;
		Если ЭЦП_ИНН = "" Тогда
			ПодписьСоответствуетОрганизации = Ложь;
		Иначе	
			ПодписьСоответствуетОрганизации = СтрНайти(ЭЦП_ИНН, ЭлементВыборкиПоДокументам.ОрганизацияИНН) <> 0;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ СубъектПодписант = Неопределено И НЕ ПодписьСоответствуетОрганизации И НЕ ЮрФизЛицоИППодписант = "ФЛ" Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Внимание! Приложенная подпись не принадлежит организации, указанной в документе!"+Символы.ПС+"Проверьте корректность подписи!"
		+Символы.ПС+"Данные о подписанте будут заполнены в соответствии с данными об руководителе организации из 1С.";
		Сообщение.Сообщить();
	КонецЕсли;	
	
	Если ПодписьСоответствуетОрганизации Тогда
		
		// Были переданы данные о подписанте из ЭЦП.
		ДанныеПодписанта = Новый Структура;	
		ДанныеПодписанта.Вставить("Фамилия", СокрЛП(СубъектПодписант.OID2_5_4_4));
		ДанныеПодписанта.Вставить("Имя", СокрЛП(Лев(СубъектПодписант.OID2_5_4_42, СтрНайти(СубъектПодписант.OID2_5_4_42, " "))));
		ДанныеПодписанта.Вставить("Отчество", СокрЛП(Прав(СубъектПодписант.OID2_5_4_42, СтрДлина(СубъектПодписант.OID2_5_4_42) - СтрНайти(СубъектПодписант.OID2_5_4_42, " "))));
		Если ЮрФизЛицоИППодписант = "ЮЛ" И НЕ СубъектПодписант.Свойство("T") Тогда
			ДанныеПодписанта = Неопределено;
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Внимание! В прилагаемой подписи отсутствует обязательная информация о должности подписанта!"+Символы.ПС+"Проверьте корректность подписи!";
			Сообщение.Сообщить();
		Иначе	
			ДанныеПодписанта.Вставить("Должность", ?(ЮрФизЛицоИППодписант = "ЮЛ", СокрЛП(СубъектПодписант.T), ""));
		КонецЕсли;	
		
	ИначеЕсли ЮрФизЛицоИППодписант = "ФЛ" Тогда 
		
		// Были переданы данные о подписанте-физлице из ЭЦП.
		ДанныеПодписанта = Новый Структура;	
		ДанныеПодписанта.Вставить("Фамилия", СокрЛП(СубъектПодписант.OID2_5_4_4));
		ДанныеПодписанта.Вставить("Имя", СокрЛП(Лев(СубъектПодписант.OID2_5_4_42, СтрНайти(СубъектПодписант.OID2_5_4_42, " "))));
		ДанныеПодписанта.Вставить("Отчество", СокрЛП(Прав(СубъектПодписант.OID2_5_4_42, СтрДлина(СубъектПодписант.OID2_5_4_42) - СтрНайти(СубъектПодписант.OID2_5_4_42, " "))));	
		Если ТипПродавца = "ЮрЛицо" Тогда
			ДанныеПодписанта.Вставить("Должность", "Уполномоченное физическое лицо");
		Иначе
			ДанныеПодписанта.Вставить("Должность", "Индивидуальный предприниматель");	
		КонецЕсли;
		
	Иначе
		
		Если Найти(Кэш.ПрефиксКонфигурации, "УНФ") = 0 Тогда
			ДанныеПодписанта = ПолучитьФИОРуководителяОрганизацииНаДату_Стандарт(ЭлементВыборкиПоДокументам.Организация, ЭлементВыборкиПоДокументам.ОбъектУчета.Дата, Кэш.ПрефиксКонфигурации);
		Иначе
			ДанныеПодписанта = ПолучитьФИОРуководителяОрганизацииНаДату_УНФ(ЭлементВыборкиПоДокументам.Организация, ЭлементВыборкиПоДокументам.ОбъектУчета.Дата, Кэш.ПрефиксКонфигурации);
		КонецЕсли;	
		
	КонецЕсли;
	
	Если НЕ ДанныеПодписанта = Неопределено И НЕ ДанныеПодписанта.Фамилия = "" И НЕ ДанныеПодписанта.Имя = "" Тогда
		
		НаимОрг = ЭлементВыборкиПоДокументам.Организация.НаименованиеПолное;
		НаимОрг = СтрЗаменить(НаимОрг, "&", "&amp;");
		НаимОрг = СтрЗаменить(НаимОрг, """", "&quot;");
		НаимОрг = СтрЗаменить(НаимОрг, ">", "&gt;");
		НаимОрг = СтрЗаменить(НаимОрг, "<", "&lt;");
		
		ДанныеПодписанта.Вставить("НаимОрг", НаимОрг);
		Если НЕ ЮрФизЛицоИППодписант = "ФЛ" Тогда 
			ДанныеПодписанта.Вставить("ИНН", ЭлементВыборкиПоДокументам.ОрганизацияИНН);
			ДанныеПодписанта.Вставить("ОснПолн", "Должностные обязанности");
		Иначе
			ДанныеПодписанта.Вставить("ИНН", ЭлементВыборкиПоДокументам.ОрганизацияИНН);
			ДанныеПодписанта.Вставить("ОснПолн", "Доверенность подписанта");
		КонецЕсли;	
		
		Если ФорматВыгрузки = "DP_REZRUISP" ИЛИ ФорматВыгрузки = "DP_TOVTORGPR" Тогда
			ДанныеПодписанта.Вставить("ОблПолн", "2");
		ИначеЕсли ФорматВыгрузки = "ON_NKORSCHFDOPPR" Тогда
			ДанныеПодписанта.Вставить("ОблПолн", "6");
		Иначе	
			ДанныеПодписанта.Вставить("ОблПолн", "5"); 
		КонецЕсли;	
		//Принимает значения:
		//0 - лицо, ответственное за подписание счетов-фактур |
		//1 - лицо, совершившее сделку, операцию |
		//2 - лицо, совершившее сделку, операцию и ответственное за ее оформление |
		//3 - лицо, ответственное за оформление свершившегося события |
		//4 - лицо, совершившее сделку, операцию и ответственное за подписание счетов-фактур |
		//5 - лицо, совершившее сделку, операцию и ответственное за ее оформление и за подписание счетов-фактур |
		//6 - лицо, ответственное за оформление свершившегося события и за подписание счетов-фактур
		
		Если НЕ ЮрФизЛицоИППодписант = "ФЛ" Тогда
			ДанныеПодписанта.Вставить("Статус", "1"); //Принимает значение:
			//1 - работник организации продавца товаров (работ, услуг, имущественных прав) |
			//2 - работник организации - составителя файла обмена информации продавца, если составитель файла обмена информации не является продавцом |
			//3 - работник иной уполномоченной организации |
			//4 - уполномоченное физическое лицо (в том числе индивидуальный предприниматель) 
		Иначе
			ДанныеПодписанта.Вставить("Статус", "1");
		КонецЕсли;	
	Иначе
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Заполните руководителя для организации: " + ЭлементВыборкиПоДокументам.Организация;
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если ЮрФизЛицоИППодписант = "ФЛ" Тогда
		ЮрФизЛицоИППодписант = "ЮЛ";
	КонецЕсли;
	
	// Если Вы решили проанализировать код обработки и дошли до этого момента, то Вы должны знать, что да, мне стыдно. 
	// Но иначе реализовать не получилось.
	ТекстЭлементаXMLФИО = "		<Подписант ";
	ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + "ОблПолн="""+ДанныеПодписанта.ОблПолн+"""";
	ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + Символы.ПС + "				Статус="""+ДанныеПодписанта.Статус+"""";
	ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + Символы.ПС + "				"+?(ФорматВыгрузки = "DP_REZRUISP", "ОснПолнПодп=""", "ОснПолн=""")+ДанныеПодписанта.ОснПолн+""">";
	ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + Символы.ПС + "			<"+ЮрФизЛицоИППодписант+" "+?(ЮрФизЛицоИППодписант = "ЮЛ", "ИННЮЛ", "ИННФЛ")+"="""+ДанныеПодписанта.ИНН+"""";
	Если ЮрФизЛицоИППодписант = "ЮЛ" Тогда
		ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + Символы.ПС + "					НаимОрг="""+ДанныеПодписанта.НаимОрг+"""";
		ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + Символы.ПС + "					Должн="""+ДанныеПодписанта.Должность+""">";
	Иначе
		ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + ">";	
	КонецЕсли;
	ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + Символы.ПС + "				<ФИО Фамилия="""+ДанныеПодписанта.Фамилия+"""";
	ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + Символы.ПС + "						Имя="""+ДанныеПодписанта.Имя+"""";
	ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + Символы.ПС + "						Отчество="""+ДанныеПодписанта.Отчество+"""/>";
	ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + Символы.ПС + "			</"+ЮрФизЛицоИППодписант+">";
	ТекстЭлементаXMLФИО = ТекстЭлементаXMLФИО + Символы.ПС + "		</Подписант>";
	
	XML = СтрЗаменить(XML, "	</Документ>", ТекстЭлементаXMLФИО + Символы.ПС + "	</Документ>");
	
	XML = УдалитьПространствоИменИзXML(XML, ФорматВыгрузки);
		
КонецПроцедуры	

#КонецОбласти

#Область РедактированиеДокументовЧерезDOM

// Для БЭД версий 1.8
Функция СформироватьЭДПоАлгоритмуБЭД_1_8_DOM(МассивДокументов, ФорматВыгрузки, Кэш, ПараметрыАвторизацииИПодписания, ИнтеграцияКаталог, ИспользоватьПодписание, СоответствиеДокументФактура = Неопределено, ТипЭД = "", КодФормата = "", НастройкаВыгрузкиДополнительныхОбъектов = Неопределено, НастройкаРедактированияРезультата = Неопределено)
	
	// Часть алгоритма соответствует "Обработки.ОбменСКонтрагентами.ПодготовитьДанныеДляЗаполненияДокументов()"
	
	МассивДокументовКВыгрузке = Новый Массив; 
	НастройкиОбъектов = Новый Соответствие;
	ФактураПереданаВСоответствии = Ложь;
	ДокументФактураВыданный = Ложь;
	ДокументФактураВыданныйНаАванс = Ложь;
	
	ОбщийМодульОбменСКонтрагентамиСлужебный = Вычислить("ОбменСКонтрагентамиСлужебный");
	ОбщийМодульОбменСКонтрагентамиПовтИсп	= Вычислить("ОбменСКонтрагентамиПовтИсп");
	
	СведенияОФорматахТекущейКонфигурации = ОбщийМодульОбменСКонтрагентамиПовтИсп.СведенияОФорматахЭлектронныхДокументовИзМакета();
	
	Если ЗначениеЗаполнено(КодФормата) Тогда
		Отбор = Новый Структура();
		Отбор.Вставить("ИдентификаторФормата", КодФормата);
		СтрокиФорматов = СведенияОФорматахТекущейКонфигурации.НайтиСтроки(Отбор);
		Если СтрокиФорматов.Количество() = 0 Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Формат "+КодФормата+" недоступен для текущей конфигурации 1С.";
			Сообщение.Сообщить();
			Возврат Новый Массив;	
		КонецЕсли;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТаблицаФорматов.ИдентификаторФормата КАК ИдентификаторФормата,
		               |	ТаблицаФорматов.Отключен КАК Отключен,
		               |	ТаблицаФорматов.ДатаНачалаДействия КАК ДатаНачалаДействия,
		               |	ТаблицаФорматов.ДатаОкончанияДействия КАК ДатаОкончанияДействия
		               |ПОМЕСТИТЬ ТаблицаФорматов
		               |ИЗ
		               |	&СведенияОФорматахТекущейКонфигурации КАК ТаблицаФорматов
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ТаблицаФорматов.ИдентификаторФормата КАК ИдентификаторФормата
		               |ИЗ
		               |	ТаблицаФорматов КАК ТаблицаФорматов
		               |ГДЕ
		               |	ТаблицаФорматов.ИдентификаторФормата ПОДОБНО &ФорматВыгрузки
		               |	И ТаблицаФорматов.Отключен = ЛОЖЬ
		               |	И (ТаблицаФорматов.ДатаОкончанияДействия = &ПустаяДата
		               |			ИЛИ ТаблицаФорматов.ДатаОкончанияДействия > &ТекущаяДата)
		               |	И НЕ ТаблицаФорматов.ДатаНачалаДействия > &ТекущаяДата";
		Запрос.УстановитьПараметр("СведенияОФорматахТекущейКонфигурации", СведенияОФорматахТекущейКонфигурации);
		Запрос.УстановитьПараметр("ФорматВыгрузки", ФорматВыгрузки+"%");
		Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
