		ЗаписьXML.УстановитьСтроку(ПараметрыЗаписи);
		ЗаписьXML.ЗаписатьОбъявлениеXML();   		
		Фабрика.ЗаписатьXML(ЗаписьXML, ОбрабатываемыйОбъектXDTO, , , , НазначениеТипаXML.Неявное);
		
