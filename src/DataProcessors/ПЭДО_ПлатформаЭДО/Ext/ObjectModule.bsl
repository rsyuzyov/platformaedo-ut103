Процедура ПроверитьНаНаличиеПустыхЭлементовИАтрибутов(УзелDOM)

	Для Каждого ДочернийУзел из УзелDOM.ДочерниеУзлы Цикл
		
		Если ТипЗнч(ДочернийУзел) = Тип("ТекстDOM") Тогда
			Если НЕ ЗначениеЗаполнено(ДочернийУзел.ТекстовоеСодержимое) Тогда
				УзелDOM.УдалитьДочерний(ДочернийУзел);
			КонецЕсли;
			Продолжить;
		КонецЕсли;	
		
		Если ДочернийУзел.Атрибуты.Количество() = 0 И ДочернийУзел.ДочерниеУзлы.Количество() = 0 Тогда
			УзелDOM.УдалитьДочерний(ДочернийУзел);
			Продолжить;
		КонецЕсли;	
		
		
		Если ДочернийУзел.Атрибуты.Количество() > 0 Тогда
		
			КоличествоАтрибутов = ДочернийУзел.Атрибуты.Количество();
			Счетчик = КоличествоАтрибутов; 
			
			Пока НЕ Счетчик = 0 Цикл
				
				Счетчик = Счетчик-1;
				Атрибут = ДочернийУзел.Атрибуты[Счетчик];
				
				Если НЕ ЗначениеЗаполнено(Атрибут.Значение) Тогда
					ДочернийУзел.УдалитьАтрибут(Атрибут);
				КонецЕсли;
				
			КонецЦикла;
		
		КонецЕсли;
		
		
		Если ДочернийУзел.ДочерниеУзлы.Количество() > 0 Тогда
		
			КоличествоУзлов = ДочернийУзел.ДочерниеУзлы.Количество();
			Счетчик = КоличествоУзлов; 
			
			Пока НЕ Счетчик = 0 Цикл
				
				Счетчик = Счетчик-1;
				
				Если ТипЗнч(ДочернийУзел.ДочерниеУзлы[Счетчик]) = Тип("ТекстDOM") Тогда
					Если НЕ ЗначениеЗаполнено(ДочернийУзел.ДочерниеУзлы[Счетчик].ТекстовоеСодержимое) Тогда
						ДочернийУзел.УдалитьДочерний(ДочернийУзел.ДочерниеУзлы[Счетчик]);
					КонецЕсли;
					Продолжить;
				КонецЕсли;
				
				Если ДочернийУзел.ДочерниеУзлы[Счетчик].Атрибуты.Количество() = 0 И ДочернийУзел.ДочерниеУзлы[Счетчик].ДочерниеУзлы.Количество() = 0 Тогда
					ДочернийУзел.УдалитьДочерний(ДочернийУзел.ДочерниеУзлы[Счетчик]);
					Продолжить;
				КонецЕсли;
				
				ПроверитьНаНаличиеПустыхЭлементовИАтрибутов(ДочернийУзел.ДочерниеУзлы[Счетчик])
				
			КонецЦикла;
		
		КонецЕсли;
		
		
		Если ДочернийУзел.Атрибуты.Количество() = 0 И ДочернийУзел.ДочерниеУзлы.Количество() = 0 Тогда
			УзелDOM.УдалитьДочерний(ДочернийУзел);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

