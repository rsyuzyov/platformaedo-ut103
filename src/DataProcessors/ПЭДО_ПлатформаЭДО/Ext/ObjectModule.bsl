		КонецЕсли;
	ИначеЕсли ТипЗначения = "Строка" Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = "Число" Тогда
		Попытка
			Возврат Число(Значение);	
		Исключение 
			ТекстОшибки = "При расчете значения "+Имя+" произошла ошибка."+Символы.ПС+"Значение """+Значение+""" не может быть приведено к типу """+ТипЗначения+""".";
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстОшибки;
			Сообщение.Сообщить();
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("Документ", Неопределено);	
			СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
			ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
			Возврат Неопределено;
		КонецПопытки;
	ИначеЕсли ТипЗначения = "Дата" Тогда
		Попытка
			Возврат Дата(Значение);	
		Исключение  
			ТекстОшибки = "При расчете значения "+Имя+" произошла ошибка."+Символы.ПС+"Значение """+Значение+""" не может быть приведено к типу """+ТипЗначения+""".";
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстОшибки;
			Сообщение.Сообщить();
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("Документ", Неопределено);	
			СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
			ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;	
			
	Возврат Неопределено;		
		
КонецФункции
                                               
Функция ПолучитьЗначениеИзПодготовленныхДанных(ПутьКЗначению, ТипЗначения, Имя = Неопределено, ПараметрыФормирования)
	
	Значение = Неопределено;
	
	ПутьКЗначениюМассивУзлов = СтрРазделить(ПутьКЗначению, ".");
	Если ПутьКЗначениюМассивУзлов.Количество() = 1 И ПутьКЗначениюМассивУзлов[0] = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИсточникДанных = Неопределено;
	ПредставлениеИсточникаДанных = "";
	Счетчик = 1;
	
	Для Каждого Узел из ПутьКЗначениюМассивУзлов Цикл
		
		Если Счетчик = 1 Тогда
			Если Узел = "ОсновныеДанныеДокумента" Тогда
				ИсточникДанных = ПараметрыФормирования.ОсновныеДанныеДокумента;
			ИначеЕсли Узел = "ДополнительныеТаблицы" Тогда
				ИсточникДанных = ПараметрыФормирования.ДополнительныеТаблицы;
			ИначеЕсли Узел = "ДополнительныеПараметры" Тогда
				ИсточникДанных = ПараметрыФормирования.ДополнительныеПараметры;
			ИначеЕсли Узел = "ДополнительныеПараметрыЭлементаВыборки" Тогда
				ИсточникДанных = ПараметрыФормирования.ДополнительныеПараметрыЭлементаВыборки;	
			ИначеЕсли Узел = "ИсточникДанныхДляМассива" Тогда
				ИсточникДанных = ПараметрыФормирования.ИсточникДанныхДляМассива;
			ИначеЕсли Узел = "НомерОбрабатываемогоЭлемента" Тогда
				ИсточникДанных = ПараметрыФормирования.НомерОбрабатываемогоЭлемента;
			ИначеЕсли Узел = "ПараметрыФормирования" Тогда
				ИсточникДанных = ПараметрыФормирования;
			Иначе
				ИсточникДанных = ПараметрыФормирования;
			КонецЕсли;
			Если ПутьКЗначениюМассивУзлов.Количество() = 1 Тогда
				Значение = ИсточникДанных;
				Возврат Значение;
			КонецЕсли;	
		Иначе
			
			Попытка
				ИсточникДанных = ИсточникДанных[Узел];
				Если Счетчик = ПутьКЗначениюМассивУзлов.Количество() Тогда
					Значение = ИсточникДанных;
					Возврат Значение;
				КонецЕсли;	
			Исключение	
				ТекстОшибки = "У источника данных "+ПредставлениеИсточникаДанных+" отсутствует свойство """+Узел+"""";
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ТекстОшибки;
				Сообщение.Сообщить();
				СтруктураОшибки = Новый Структура;
				СтруктураОшибки.Вставить("Документ", Неопределено);	
				СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
				ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
				Возврат Неопределено;
			КонецПопытки;	
				
		КонецЕсли;
		
		ПредставлениеИсточникаДанных = ПредставлениеИсточникаДанных +"."+ Узел; 
		
		Счетчик = Счетчик+1;
		
	КонецЦикла;	
			
	Возврат Неопределено;		
		
КонецФункции

Функция ПолучитьЗначениеИзОбрабатываемогоУзлаДокумента(ПутьКЗначению, ТипЗначения, Имя = Неопределено, ПараметрыФормирования)
	
	Значение = Неопределено;
	
	ДанныеУзла = ПараметрыФормирования.ОбрабатываемыйУзелДокумента;
	ПутьМассивУзлов = СтрРазделить(ПутьКЗначению, ".");
	
	Если ПутьМассивУзлов.Количество() = 0 ИЛИ ПутьМассивУзлов[0] = "" Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	Счетчик = 1;
	Для Каждого Узел Из ПутьМассивУзлов Цикл
		
		Если СокрЛП(Узел) = "Владелец()" ИЛИ СокрЛП(Узел) = "Владелец" ИЛИ СокрЛП(Узел) = "РодительскийУзел" Тогда
			
			Если ТипЗнч(ДанныеУзла) = Тип("ОбъектXDTO") Тогда
				ДанныеУзла = ДанныеУзла.Владелец();
			ИначеЕсли ТипЗнч(ДанныеУзла) = Тип("ЭлементDOM") Тогда
				ДанныеУзла = ДанныеУзла.РодительскийУзел;
			КонецЕсли;
			
		Иначе
			
			Если ТипЗнч(ДанныеУзла) = Тип("ОбъектXDTO") Тогда
				
				ДанныеУзла = ДанныеУзла[СокрЛП(Узел)];
				
			ИначеЕсли ТипЗнч(ДанныеУзла) = Тип("ЭлементDOM") ИЛИ ТипЗнч(ДанныеУзла) = Тип("ДокументDOM") Тогда
				
				Если Счетчик = ПутьМассивУзлов.Количество() Тогда
					
					// Последний элемент. Значит, это атрибут.
					СтруктураЗначениеИВладелецDOM = ПолучитьЗначениеУзлаИВладельцаПоПути_DOM(ДанныеУзла, Узел);
					Если НЕ СтруктураЗначениеИВладелецDOM.Значение = Неопределено И СтруктураЗначениеИВладелецDOM.ТипУзлаDOM = "Атрибут" Тогда
						ДанныеУзла = СтруктураЗначениеИВладелецDOM.Значение.Значение;
					Иначе
						ТекстОшибки = "У обрабатываемого узла "+ДанныеУзла.ИмяУзла+" отсутствует атрибут """+Узел+""" (путь "+ПутьКЗначению+")";
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = ТекстОшибки;
						Сообщение.Сообщить();
						СтруктураОшибки = Новый Структура;
						СтруктураОшибки.Вставить("Документ", Неопределено);	
						СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
						ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
						Возврат Неопределено;
					КонецЕсли;
					
				Иначе  
					
					// Это дочерний узел.
					СтруктураЗначениеИВладелецDOM = ПолучитьЗначениеУзлаИВладельцаПоПути_DOM(ДанныеУзла, Узел);
					Если НЕ СтруктураЗначениеИВладелецDOM.Значение = Неопределено И СтруктураЗначениеИВладелецDOM.ТипУзлаDOM = "Элемент" Тогда
						ДанныеУзла = СтруктураЗначениеИВладелецDOM.Значение;
					Иначе	
						ТекстОшибки = "У обрабатываемого узла "+ДанныеУзла.ИмяУзла+" отсутствует подчиненный элемент """+Узел+""" (путь "+ПутьКЗначению+")";
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = ТекстОшибки;
						Сообщение.Сообщить();
						СтруктураОшибки = Новый Структура;
						СтруктураОшибки.Вставить("Документ", Неопределено);	
						СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
						ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
						Возврат Неопределено;
					КонецЕсли;	
						
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Счетчик = ПутьМассивУзлов.Количество() Тогда
			Значение = ДанныеУзла;
			Прервать;
		КонецЕсли;
		
		Счетчик = Счетчик+1;
		
	КонецЦикла;
	
	Возврат Значение;		
		
КонецФункции

Функция ПроверитьНаличиеУзлаОбрабатываемогоДокумента(ПутьКЗначению, ТипЗначения, Имя = Неопределено, ПараметрыФормирования)
	
	Значение = Неопределено;
	
	ДанныеУзла = ПараметрыФормирования.ОбрабатываемыйУзелДокумента;
	ПутьМассивУзлов = СтрРазделить(ПутьКЗначению, ".");
	
	Если ПутьМассивУзлов.Количество() = 0 ИЛИ ПутьМассивУзлов[0] = "" Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	Счетчик = 1;
	Для Каждого Узел Из ПутьМассивУзлов Цикл
		
		Если СокрЛП(Узел) = "Владелец()" ИЛИ СокрЛП(Узел) = "Владелец" ИЛИ СокрЛП(Узел) = "РодительскийУзел" Тогда
			
			Если ТипЗнч(ДанныеУзла) = Тип("ОбъектXDTO") Тогда
				ДанныеУзла = ДанныеУзла.Владелец();
			ИначеЕсли ТипЗнч(ДанныеУзла) = Тип("ЭлементDOM") Тогда
				ДанныеУзла = ДанныеУзла.РодительскийУзел;
			КонецЕсли;
			
		Иначе
			
			Если ТипЗнч(ДанныеУзла) = Тип("ОбъектXDTO") Тогда
				
				Если НЕ ДанныеУзла.Свойства().Получить(СокрЛП(Узел)) = Неопределено Тогда 
					ДанныеУзла = ДанныеУзла[СокрЛП(Узел)];
				Иначе
					Возврат Ложь;
				КонецЕсли;	
				
			ИначеЕсли ТипЗнч(ДанныеУзла) = Тип("ЭлементDOM") ИЛИ ТипЗнч(ДанныеУзла) = Тип("ДокументDOM") Тогда
				
				Если Счетчик = ПутьМассивУзлов.Количество() Тогда
					
					СтруктураЗначениеИВладелецDOM = ПолучитьЗначениеУзлаИВладельцаПоПути_DOM(ДанныеУзла, Узел);
					Если НЕ СтруктураЗначениеИВладелецDOM.Значение = Неопределено Тогда
						Если СтруктураЗначениеИВладелецDOM.ТипУзлаDOM = "Атрибут" Тогда
							ДанныеУзла = СтруктураЗначениеИВладелецDOM.Значение.Значение;
						Иначе
							ДанныеУзла = СтруктураЗначениеИВладелецDOM.Значение;
						КонецЕсли;	
					Иначе
						Возврат Ложь;
					КонецЕсли;
					
				Иначе  
					
					// Это дочерний узел.
					СтруктураЗначениеИВладелецDOM = ПолучитьЗначениеУзлаИВладельцаПоПути_DOM(ДанныеУзла, Узел);
					Если НЕ СтруктураЗначениеИВладелецDOM.Значение = Неопределено И СтруктураЗначениеИВладелецDOM.ТипУзлаDOM = "Элемент" Тогда
						ДанныеУзла = СтруктураЗначениеИВладелецDOM.Значение;
					Иначе	
						Возврат Ложь;
					КонецЕсли;	
						
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Счетчик = ПутьМассивУзлов.Количество() Тогда
			Значение = ДанныеУзла;
			Прервать;
		КонецЕсли;
		
		Счетчик = Счетчик+1;
		
	КонецЦикла;
	
	Если НЕ Значение = Неопределено Тогда
		Возврат Истина;
	Иначе	
		Возврат Ложь;
	КонецЕсли;	
		
КонецФункции
                
Функция ПолучитьРезультатПоискаПоИндексированнымРеквизитам(РеквизитыПоиска, ТипОбъектаМетаданных, ИмяОбъектаМетаданных, ПараметрыФормирования, СообщатьОПустомРезультате = Истина)
	
	РезультатПоиска = Неопределено;
	
	Если Метаданные[ТипОбъектаМетаданных].Найти(ИмяОбъектаМетаданных) = Неопределено Тогда
		ТекстОшибки = "Объявленный в настройке загрузки объект метаданных """+ТипОбъектаМетаданных+"."+ИмяОбъектаМетаданных+""" не обнаружен.";
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить();
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("Документ", Неопределено);	
		СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
		ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
		Возврат Неопределено;	
	КонецЕсли;	
	
	Если ТипОбъектаМетаданных = "Документы" Тогда
		ОбъектПоиска = Документы[ИмяОбъектаМетаданных];
	ИначеЕсли ТипОбъектаМетаданных = "Справочники" Тогда
		ОбъектПоиска = Справочники[ИмяОбъектаМетаданных];
	Иначе
		// Поиск возможен только по справочникам и документам.
		// Возможно, еще и по таким объектам, как "Задачи" и "Планы счетов" и т.д., но это все потом,
		// если возникнет потребность, в чем я сильно сомневаюсь.
		ТекстОшибки = "Тип объекта метаданных "+ТипОбъектаМетаданных+" не поддерживается для поиска по проиндексированным реквизитам.";
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить();
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("Документ", Неопределено);	
		СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
		ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
		Возврат Неопределено;
	КонецЕсли;
	
	ОбъектМетаданныхПоиска = Метаданные[ТипОбъектаМетаданных][ИмяОбъектаМетаданных];
	
	ПервичныйПараметрПоиска = Новый Структура;
	ПервичныйПараметрПоискаОбработан = Ложь;
	ВторичныеПараметрыПоиска = Новый Соответствие;
	
	Для Каждого РеквизитПоиска Из РеквизитыПоиска.Свойства() Цикл
		
		РеквизитПоискаXDTO = РеквизитыПоиска[РеквизитПоиска.Имя];
		
		// Проверяем существование реквизита.
		РеквизитПоискаСуществует = ПроверкаСуществованияРеквизита(ОбъектМетаданныхПоиска, РеквизитПоискаXDTO, ПараметрыФормирования);
		Если НЕ РеквизитПоискаСуществует Тогда
			Возврат Неопределено;
		КонецЕсли;	
		
		МетодРасчетаЗначенияРеквизита = РеквизитПоискаXDTO.Источник.МетодРасчетаЗначения; 
		
		ЗначениеРеквизитаПоиска = РассчитатьЗначениеПоМетодуРасчета(РеквизитПоискаXDTO, ПараметрыФормирования, МетодРасчетаЗначенияРеквизита);
		Если ЗначениеРеквизитаПоиска = Неопределено И НЕ МетодРасчетаЗначенияРеквизита = "Неопределено" Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Если НЕ РеквизитыПоиска[РеквизитПоиска.Имя].Свойства().Получить("РеквизитИндексированногоПоиска") = Неопределено И РеквизитыПоиска[РеквизитПоиска.Имя]["РеквизитИндексированногоПоиска"] = "Истина" Тогда    
			Если ПервичныйПараметрПоискаОбработан Тогда
				ТекстОшибки  ="Поиск объекта """+ТипОбъектаМетаданных+"."+ИмяОбъектаМетаданных+""" по индексированному реквизиту  невозможен, поскольку в настройке"+Символы.ПС+
					+"указано более одного первичного проиндексированного реквизита. Указать можно только один.";
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ТекстОшибки;
				Сообщение.Сообщить();
				СтруктураОшибки = Новый Структура;
				СтруктураОшибки.Вставить("Документ", Неопределено);	
				СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
				ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
				Возврат Неопределено;
			КонецЕсли;	
			ПервичныйПараметрПоиска.Вставить("Ключ", РеквизитПоискаXDTO.ИмяОбъектаМетаданных);
			ПервичныйПараметрПоиска.Вставить("Значение", ЗначениеРеквизитаПоиска);
			ПервичныйПараметрПоискаОбработан = Истина;
		Иначе
			ВторичныеПараметрыПоиска.Вставить(РеквизитПоискаXDTO.ИмяОбъектаМетаданных, ЗначениеРеквизитаПоиска);
		КонецЕсли;	
		
	КонецЦикла;
	
	Если НЕ ПервичныйПараметрПоискаОбработан Тогда
		ТекстОшибки = "Поиск объекта """+ТипОбъектаМетаданных+"."+ИмяОбъектаМетаданных+""" по индексированному реквизиту  невозможен, поскольку в настройке"+Символы.ПС+
			+"не указано ни одного первичного проиндексированного реквизита.";
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить();
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("Документ", Неопределено);	
		СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
		ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
		Возврат Неопределено;
	КонецЕсли;	
	
	РезультатПоискаПоРеквизиту = Неопределено;
	
	// По первичному реквизиту ищем подходящие элементы через метод "Выбрать".
	ПараметрОтбора = Новый Структура; 
	ПараметрОтбора.Вставить(ПервичныйПараметрПоиска.Ключ, ПервичныйПараметрПоиска.Значение);
	ВыборкаПоПервичномуРеквизитуПоиска = ОбъектПоиска.Выбрать(, , ПараметрОтбора);
	РезультатПоискаПоРеквизиту = Новый СписокЗначений;
	Пока ВыборкаПоПервичномуРеквизитуПоиска.Следующий() Цикл
		РезультатПоискаПоРеквизиту.Добавить(ВыборкаПоПервичномуРеквизитуПоиска);
	КонецЦикла;	
	Если РезультатПоискаПоРеквизиту.Количество() = 0 Тогда
		// Ничего не найдено.
		Если СообщатьОПустомРезультате Тогда
			ТекстОшибки = "Поиск объекта """+ТипОбъектаМетаданных+"."+ИмяОбъектаМетаданных+""" по реквизиту """
					+ПервичныйПараметрПоиска.Ключ+""" со значением """+ПервичныйПараметрПоиска.Значение+""" не дал результатов.";
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстОшибки;
			Сообщение.Сообщить();
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("Документ", Неопределено);	
			СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
			ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
		КонецЕсли;
		Возврат Неопределено;	
	КонецЕсли;
	
	// Если реквизитов больше одного, ищем подходящие значения перебором в цикле.
	// Рекомендуется использовать поиск через запрос.
	Для Каждого ПараметрПоиска из ВторичныеПараметрыПоиска Цикл
		Если РезультатПоискаПоРеквизиту = Неопределено Тогда
			Если СообщатьОПустомРезультате Тогда  
				ТекстОшибки = "Поиск объекта """+ТипОбъектаМетаданных+"."+ИмяОбъектаМетаданных+""" по индексированным реквизитам не дал результатов.";
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ТекстОшибки;
				Сообщение.Сообщить();
				СтруктураОшибки = Новый Структура;
				СтруктураОшибки.Вставить("Документ", Неопределено);	
				СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
				ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
			КонецЕсли;
			Возврат Неопределено;
		Иначе
			РезультатПоискаПоСледующемуРеквизиту = Новый СписокЗначений;
			Для Каждого ЭлементРезультата из РезультатПоискаПоРеквизиту Цикл
				Если НЕ ЭлементРезультата.Значение[ПараметрПоиска.Ключ] = ПараметрПоиска.Значение Тогда
					Продолжить;
				Иначе
					РезультатПоискаПоСледующемуРеквизиту.Добавить(ЭлементРезультата.Значение);
				КонецЕсли;	
			КонецЦикла;	
			РезультатПоискаПоРеквизиту = РезультатПоискаПоСледующемуРеквизиту;
		КонецЕсли;		
	КонецЦикла;	
	
	Если РезультатПоискаПоРеквизиту.Количество() = 0 Тогда
		Если СообщатьОПустомРезультате Тогда
			ТекстОшибки = "Поиск объекта """+ТипОбъектаМетаданных+"."+ИмяОбъектаМетаданных+""" по индексированным реквизитам не дал результатов.";
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстОшибки;
			Сообщение.Сообщить();
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("Документ", Неопределено);	
			СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
			ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
		КонецЕсли;	
		Возврат Неопределено;
	КонецЕсли;	
	
	Возврат РезультатПоискаПоРеквизиту[0].Значение.Ссылка;
	
КонецФункции
           
Функция ПолучитьРезультатЗапроса(ТекстЗапроса, ТипРезультата, XDTOПараметрыЗапроса, Имя = Неопределено, ПараметрыФормирования, СообщатьОПустомРезультате = Истина)
	
	РезультатЗапроса = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Для Каждого XDTOПараметрСвойство из XDTOПараметрыЗапроса.Свойства() Цикл
		
		XDTOПараметр = XDTOПараметрыЗапроса[XDTOПараметрСвойство.Имя];
		МетодРасчетаЗначенияПараметра = XDTOПараметр.Источник.МетодРасчетаЗначения;
		
		ИмяПараметраЗапроса = XDTOПараметр.ИмяПараметра;
		ЗначениеПараметраЗапроса = РассчитатьЗначениеПоМетодуРасчета(XDTOПараметр, ПараметрыФормирования, МетодРасчетаЗначенияПараметра);
		
		Если ЗначениеПараметраЗапроса = Неопределено И НЕ МетодРасчетаЗначенияПараметра = "Неопределено" Тогда
			Возврат Неопределено;
		КонецЕсли;	
		
		Запрос.УстановитьПараметр(ИмяПараметраЗапроса, ЗначениеПараметраЗапроса);
		
	КонецЦикла;
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Если СообщатьОПустомРезультате Тогда
			ТекстОшибки = "";
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст =	"Поиск значения для реквизита """+Имя+""" через запрос не дал результата."+Символы.ПС
								+"Текст запроса:"+Символы.ПС+ТекстЗапроса+Символы.ПС+"Параметры запроса:";
			ТекстОшибки = Сообщение.Текст; 					
			Сообщение.Сообщить();
			Для Каждого ПараметрЗапроса из Запрос.Параметры Цикл
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Параметр "+ПараметрЗапроса.Ключ+" - значение: "+ПараметрЗапроса.Значение+Символы.ПС;
				ТекстОшибки = ТекстОшибки +Символы.ПС+ Сообщение.Текст;
				Сообщение.Сообщить();
			КонецЦикла;
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("Документ", Неопределено);	
			СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
			ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
		КонецЕсли;
		Возврат Неопределено;	
	Иначе
		Результат = Результат.Выбрать();
		Результат.Следующий();
		Результат = Результат.Результат;
		Если НЕ ТипЗнч(Результат) = Тип(ТипРезультата) Тогда
			ТекстОшибки = "";
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст =	"Поиск значения для реквизита """+Имя+""" через запрос вернул результат с типом, не соответствующим ожидаемому."+Символы.ПС
								+"Тип результата: "+ТипЗнч(Результат)+". Ожидаемый тип:"+ТипРезультата+"."+Символы.ПС+"Текст запроса:"+Символы.ПС+ТекстЗапроса;
			ТекстОшибки = Сообщение.Текст;					
			Сообщение.Сообщить();
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Параметры запроса:";
			Сообщение.Сообщить();
			Для Каждого ПараметрЗапроса из Запрос.Параметры Цикл
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Параметр "+ПараметрЗапроса.Ключ+" - значение: "+ПараметрЗапроса.Значение+Символы.ПС;
				ТекстОшибки = ТекстОшибки +Символы.ПС+ Сообщение.Текст;
				Сообщение.Сообщить();
			КонецЦикла;
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("Документ", Неопределено);	
			СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
			ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
			Возврат Неопределено;
		Иначе
			РезультатЗапроса = Результат;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат РезультатЗапроса;
	
КонецФункции
               
Функция ПолучитьРезультатВыполненияКода(ТекстКода, ТипРезультата, XDTOВходящиеПараметры, Имя = Неопределено, ПараметрыФормирования, СообщатьОПустомРезультате = Истина)
	
	РезультатВыполненияКода = Неопределено;
	ВходящиеПараметры = Новый Структура;   
	
	ОсновныеДанныеДокумента = Неопределено;
	ДополнительныеТаблицы = Неопределено;
	ДополнительныеПараметры = Неопределено;
	ДополнительныеПараметрыЭлементаВыборки = Неопределено;
	ИсточникДанныхДляМассива = Неопределено;
	
	Если ПараметрыФормирования.Свойство("ОсновныеДанныеДокумента") Тогда
		ОсновныеДанныеДокумента = ПараметрыФормирования.ОсновныеДанныеДокумента;
	КонецЕсли;	
	Если ПараметрыФормирования.Свойство("ДополнительныеТаблицы") Тогда
		ДополнительныеТаблицы = ПараметрыФормирования.ДополнительныеТаблицы;
	КонецЕсли;	
	Если ПараметрыФормирования.Свойство("ДополнительныеПараметры") Тогда
		ДополнительныеПараметры = ПараметрыФормирования.ДополнительныеПараметры;
	КонецЕсли;	
	Если ПараметрыФормирования.Свойство("ДополнительныеПараметрыЭлементаВыборки") Тогда
		ДополнительныеПараметрыЭлементаВыборки = ПараметрыФормирования.ДополнительныеПараметрыЭлементаВыборки;
	КонецЕсли;	
	Если ПараметрыФормирования.Свойство("ИсточникДанныхДляМассива") Тогда
		ИсточникДанныхДляМассива = ПараметрыФормирования.ИсточникДанныхДляМассива;	
	КонецЕсли;
	
	Для Каждого XDTOВходящийПараметрСвойство из XDTOВходящиеПараметры.Свойства() Цикл
		
		XDTOВходящийПараметр = XDTOВходящиеПараметры[XDTOВходящийПараметрСвойство.Имя];  
		
		ЗначениеВходящегоПараметра = Неопределено;
		
		Если НЕ XDTOВходящийПараметр.Свойства().Получить("ВариантыИсточника") = Неопределено Тогда
			
			Если Тип(XDTOВходящийПараметр.ВариантыИсточника.Вариант) = Тип("СписокXDTO") Тогда
				
				Для Каждого ВариантXDTO из XDTOВходящийПараметр.ВариантыИсточника.Вариант Цикл
					                                             
					УсловиеВыполнено = РезультатОбработкиУсловия(ВариантXDTO, ПараметрыФормирования);
					
					Если УсловиеВыполнено = Истина Тогда
						
						МетодРасчетаЗначенияПараметра = ВариантXDTO.Источник.МетодРасчетаЗначения;
		
						ИмяПараметра = XDTOВходящийПараметр.ИмяПараметра;
						ЗначениеВходящегоПараметра = РассчитатьЗначениеПоМетодуРасчета(ВариантXDTO, ПараметрыФормирования, МетодРасчетаЗначенияПараметра);
						
						Если ЗначениеВходящегоПараметра = Неопределено И НЕ МетодРасчетаЗначенияПараметра = "Неопределено" Тогда
							Возврат Неопределено;
						КонецЕсли;	
						
						ВходящиеПараметры.Вставить(ИмяПараметра, ЗначениеВходящегоПараметра);
						Прервать;
						
					КонецЕсли;
					
				КонецЦикла;	
				
			Иначе
				
				ВариантXDTO = XDTOВходящийПараметр.ВариантыИсточника.Вариант;
				
				УсловиеВыполнено = РезультатОбработкиУсловия(ВариантXDTO, ПараметрыФормирования);
				
				Если УсловиеВыполнено = Истина Тогда
					
					МетодРасчетаЗначенияПараметра = ВариантXDTO.Источник.МетодРасчетаЗначения;
					
					ИмяПараметра = XDTOВходящийПараметр.ИмяПараметра;
					ЗначениеВходящегоПараметра = РассчитатьЗначениеПоМетодуРасчета(ВариантXDTO, ПараметрыФормирования, МетодРасчетаЗначенияПараметра);
					
					Если ЗначениеВходящегоПараметра = Неопределено И НЕ МетодРасчетаЗначенияПараметра = "Неопределено" Тогда
						Возврат Неопределено;
					КонецЕсли;	
					
					ВходящиеПараметры.Вставить(ИмяПараметра, ЗначениеВходящегоПараметра);
					Продолжить;
						
				КонецЕсли
					
			КонецЕсли;
			
			Если ЗначениеВходящегоПараметра = Неопределено И НЕ XDTOВходящийПараметр.ВариантыИсточника.Свойства().Получить("ВариантИсключение") = Неопределено Тогда
				
				ВариантXDTO = XDTOВходящийПараметр.ВариантыИсточника.ВариантИсключение;
				
				МетодРасчетаЗначенияПараметра = ВариантXDTO.Источник.МетодРасчетаЗначения;
				
				ИмяПараметра = XDTOВходящийПараметр.ИмяПараметра;
				ЗначениеВходящегоПараметра = РассчитатьЗначениеПоМетодуРасчета(ВариантXDTO, ПараметрыФормирования, МетодРасчетаЗначенияПараметра);
				
				Если ЗначениеВходящегоПараметра = Неопределено И НЕ МетодРасчетаЗначенияПараметра = "Неопределено" Тогда
					Возврат Неопределено;
				КонецЕсли;	
				
				ВходящиеПараметры.Вставить(ИмяПараметра, ЗначениеВходящегоПараметра);
		
			КонецЕсли;	
			
		Иначе	
			
			МетодРасчетаЗначенияПараметра = XDTOВходящийПараметр.Источник.МетодРасчетаЗначения;
		
			ИмяПараметра = XDTOВходящийПараметр.ИмяПараметра;
			ЗначениеВходящегоПараметра = РассчитатьЗначениеПоМетодуРасчета(XDTOВходящийПараметр, ПараметрыФормирования, МетодРасчетаЗначенияПараметра);
			
			Если ЗначениеВходящегоПараметра = Неопределено И НЕ МетодРасчетаЗначенияПараметра = "Неопределено" Тогда
				Возврат Неопределено;
			КонецЕсли;	
			
			ВходящиеПараметры.Вставить(ИмяПараметра, ЗначениеВходящегоПараметра);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПараметрыФормирования.Свойство("ВходящиеПеременные") Тогда
		Если ТипЗнч(ПараметрыФормирования.ВходящиеПеременные) = Тип("Структура") Тогда
			ВходящиеПараметры.Вставить("ВходящиеПеременные", ПараметрыФормирования.ВходящиеПеременные);
		КонецЕсли;	
	КонецЕсли;	
	
	//Попытка	
		
		Выполнить(ТекстКода);
				
	//Исключение
		
		//ТекстОшибки = "При расчете значения """+Имя+""" посредством выполнения произвольного кода произошла ошибка."+Символы.ПС
		//					+"Проверьте текст кода на корректность."+Символы.ПС+"Текст кода:"+Символы.ПС+ТекстКода;
		//Сообщение = Новый СообщениеПользователю;
		//Сообщение.Текст = ТекстОшибки;
		//Сообщение.Сообщить();
		//СтруктураОшибки = Новый Структура;
		//СтруктураОшибки.Вставить("Документ", Неопределено);	
		//СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
		//ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
		//Возврат Неопределено;	
		
	//КонецПопытки;
	
	Если РезультатВыполненияКода = Неопределено Тогда
		Если СообщатьОПустомРезультате Тогда
			ТекстОшибки = "Расчет значения """+Имя+""" посредством выполнения произвольного кода не вернул результата."+Символы.ПС
								+"Проверьте текст кода на корректность."+Символы.ПС+"Текст кода:"+Символы.ПС+ТекстКода;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстОшибки;	
			Сообщение.Сообщить();
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("Документ", Неопределено);	
			СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
			ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;	
	
	Если НЕ ТипЗнч(РезультатВыполненияКода) = Тип(ТипРезультата) Тогда
		ТекстОшибки = "";
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст =	"Поиск значения для """+Имя+""" через выполнение кода из строки вернул результат с типом, не соответствующим ожидаемому."+Символы.ПС
							+"Тип результата: "+ТипЗнч(РезультатВыполненияКода)+". Ожидаемый тип:"+ТипРезультата+"."+Символы.ПС+"Текст кода:"+Символы.ПС+ТекстКода;
		ТекстОшибки = Сообщение.Текст;					
		Сообщение.Сообщить();
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Входящие параметры кода:";
		Сообщение.Сообщить();
		Для Каждого ВходящийПараметр из ВходящиеПараметры Цикл
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Параметр "+ВходящийПараметр.Ключ+" - значение: "+ВходящийПараметр.Значение+Символы.ПС;
			ТекстОшибки = ТекстОшибки +Символы.ПС+ Сообщение.Текст;
			Сообщение.Сообщить();
		КонецЦикла;
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("Документ", Неопределено);	
		СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
		ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат РезультатВыполненияКода; 
	
КонецФункции

Функция ПолучитьЗначениеКонстанты(ИмяКонстанты, ПараметрыФормирования)
	
	Возврат Константы[ИмяКонстанты].Получить();
	
КонецФункции

Функция ПолучитьЗначениеПеречисления(ИмяПеречисления, ЗначениеПеречисления, МассивОшибок)
	
	Возврат Перечисления[ИмяПеречисления][ЗначениеПеречисления];
	
КонецФункции

Функция ПроверкаСуществованияРеквизита(ОбъектМетаданных, РеквизитXDTO, ПараметрыФормирования)
	
	Если РеквизитXDTO.СтандартныйРеквизит = "Ложь" Тогда	
		// Нестандартный.
		Если ОбъектМетаданных.Реквизиты.Найти(РеквизитXDTO.ИмяОбъектаМетаданных) = Неопределено Тогда
			ТекстОшибки = "При проверке существования реквизита """+РеквизитXDTO.ИмяОбъектаМетаданных+""" объекта метаданных """+ОбъектМетаданных+""" произошла ошибка."+Символы.ПС+
								"Реквизит """+РеквизитXDTO.ИмяОбъектаМетаданных+""" отсутствует в списке реквизитов объекта метаданных."+Символы.ПС+
								"Проверьте корректность файла настройки загрузки.";
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстОшибки;
			Сообщение.Сообщить();
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("Документ", Неопределено);	
			СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
			ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
			Возврат Ложь;
		КонецЕсли;
	ИначеЕсли РеквизитXDTO.СтандартныйРеквизит = "Истина" Тогда
		// Стандартный.
		Попытка
			ПроверяемыйСтандартныйРеквизит = ОбъектМетаданных.СтандартныеРеквизиты[РеквизитXDTO.ИмяОбъектаМетаданных];
		Исключение
			ТекстОшибки = "При проверке существования реквизита """+РеквизитXDTO.ИмяОбъектаМетаданных+""" объекта метаданных """+ОбъектМетаданных+""" произошла ошибка."+Символы.ПС+
								"Реквизит """+РеквизитXDTO.ИмяОбъектаМетаданных+""" заявлен как стандартный реквизит объекта метаданных, однако в списке стандартных реквизитов отсутствует."+
								Символы.ПС+"Проверьте корректность файла настройки загрузки.";
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстОшибки;
			Сообщение.Сообщить();
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("Документ", Неопределено);	
			СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
			ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
			Возврат Ложь;
		КонецПопытки;	
	Иначе
		// Внештатная ситуация. 
		ТекстОшибки = "Неожиданная ошибка при проверке существования реквизита """+РеквизитXDTO.ИмяОбъектаМетаданных+""" объекта метаданных """+ОбъектМетаданных+"""."+Символы.ПС+
							"Проверьте корректность файла настройки загрузки.";
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить();
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("Документ", Неопределено);	
		СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
		ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти


#Область ФормированиеДополнительныхОбъектовВыгрузки

Процедура ДополнитьВыгрузкуДополнительнымиОбъектами(ОбъектИсточник, НастройкаВыгрузкиДополнительныхОбъектов, ВыгрузкаДокументов, Кэш, Конфигурация = Неопределено, ИнтеграцияКаталог = Неопределено, ИмяФайлаОбъектаИсточника = "", МассивОшибок)
	
	Если Конфигурация = Неопределено Тогда
		Конфигурация = ПолучитьОбъектНастройкиПоИмениМетаданных("Конфигурация", Кэш);	
	КонецЕсли;
	
	Если ИнтеграцияКаталог = Неопределено Тогда 
		Интеграция = ПолучитьИнтеграциюНаСервере();
		ИнтеграцияКаталог = Интеграция.СпособИнтеграции = 1;
	КонецЕсли;	
	
	Для Каждого НастройкаВыгрузкиОбъектаСвойствоXDTO из НастройкаВыгрузкиДополнительныхОбъектов.Свойства() Цикл
		
		НастройкаВыгрузкиОбъектаОбъектXDTO = НастройкаВыгрузкиДополнительныхОбъектов[НастройкаВыгрузкиОбъектаСвойствоXDTO.Имя];
		
		Если НастройкаВыгрузкиОбъектаОбъектXDTO.Тип = "ПечатнаяФорма" Тогда 
			
			ПараметрыФормирования = Новый Структура;
			
			// Формируем табличный документ через стандартную подсистему печати.
			СтруктураОбъектаИсточникаДляРасчетов = Новый Структура;
			СтруктураОбъектаИсточникаДляРасчетов.Вставить("СсылкаНаДокумент", ОбъектИсточник);
			СтруктураОбъектаИсточникаДляРасчетов.Вставить("Конфигурация", Конфигурация);
			СтруктураОбъектаИсточникаДляРасчетов.Вставить("ИнтеграцияКаталог", ИнтеграцияКаталог); 
			
			ПараметрыФормирования.Вставить("ОсновныеДанныеДокумента", СтруктураОбъектаИсточникаДляРасчетов);
			ПараметрыФормирования.Вставить("МассивОшибок", МассивОшибок);
			
			ОбъектПечатиОбъектXDTO = НастройкаВыгрузкиОбъектаОбъектXDTO.ОбъектПечати;
			ОбъектПечати = РассчитатьЗначениеПоМетодуРасчета(ОбъектПечатиОбъектXDTO, ПараметрыФормирования);
			
			Если НЕ ЗначениеЗаполнено(ОбъектПечати) Тогда
				Продолжить;
			КонецЕсли;	
			
			СтруктураОбъектаИсточникаДляРасчетов.Вставить("ДополнительныйОбъект", ОбъектПечати);
			ПараметрыФормирования.Вставить("ОсновныеДанныеДокумента", СтруктураОбъектаИсточникаДляРасчетов);
			
			УсловиеОтменыВыгрузкиВыполнено = РезультатОбработкиУсловия(НастройкаВыгрузкиОбъектаОбъектXDTO, ПараметрыФормирования); 
			
			Если УсловиеОтменыВыгрузкиВыполнено = Истина Тогда
				Продолжить;
			КонецЕсли;
			
			ОписаниеПечатнойФормыОбъектXDTO = НастройкаВыгрузкиОбъектаОбъектXDTO.ОписаниеПечатнойФормы;
			
			МассивОбъектов = Новый Массив();
			МассивОбъектов.Добавить(ОбъектПечати);
			ПараметрыПечати = Новый Структура();
			ДопустимыеТипыОбъектовПечати = Неопределено;
	
			ИмяМенеджераПечати = ОписаниеПечатнойФормыОбъектXDTO.ИмяМенеджераПечати;
    		ИменаМакетов = ОписаниеПечатнойФормыОбъектXDTO.ИменаМакетов;
			
			// Заполнение параметров печати, при наличии.
			Если НЕ ОписаниеПечатнойФормыОбъектXDTO.Свойства().Получить("ПараметрыПечати") = Неопределено Тогда			
				Для Каждого XDTOВходящийПараметрСвойство из ОписаниеПечатнойФормыОбъектXDTO.ПараметрыПечати.Свойства() Цикл			
					XDTOПараметрПечати = ОписаниеПечатнойФормыОбъектXDTO.ПараметрыПечати[XDTOВходящийПараметрСвойство.Имя];
					МетодРасчетаЗначенияПараметра = XDTOПараметрПечати.Источник.МетодРасчетаЗначения;
					ИмяПараметра = XDTOПараметрПечати.ИмяПараметра;
					ЗначениеВходящегоПараметра = РассчитатьЗначениеПоМетодуРасчета(XDTOПараметрПечати, ПараметрыФормирования);	
					Если ЗначениеВходящегоПараметра = Неопределено И НЕ МетодРасчетаЗначенияПараметра = "Неопределено" Тогда
						Продолжить;
					КонецЕсли;	
					ПараметрыПечати.Вставить(ИмяПараметра, ЗначениеВходящегоПараметра);			
				КонецЦикла;		
			КонецЕсли;	
			
			ИдентификаторОтправителяОбъектXDTO	= НастройкаВыгрузкиОбъектаОбъектXDTO.ИдентификаторОтправителя;
			ИдентификаторПолучателяОбъектXDTO	= НастройкаВыгрузкиОбъектаОбъектXDTO.ИдентификаторПолучателя;
			ИдентификаторОтправителя			= РассчитатьЗначениеПоМетодуРасчета(ИдентификаторОтправителяОбъектXDTO, ПараметрыФормирования);
			ИдентификаторПолучателя				= РассчитатьЗначениеПоМетодуРасчета(ИдентификаторПолучателяОбъектXDTO, ПараметрыФормирования);
			
			Попытка
				ПечатныеФормы = УправлениеПечатью.СформироватьПечатныеФормы(ИмяМенеджераПечати, ИменаМакетов, МассивОбъектов, ПараметрыПечати, ДопустимыеТипыОбъектовПечати);
			Исключение
				ТекстОшибки = "Не удалось сформировать неформализованный документ "+НастройкаВыгрузкиОбъектаСвойствоXDTO.Имя+".";
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ТекстОшибки;
				Сообщение.Сообщить();
				СтруктураОшибки = Новый Структура;
				СтруктураОшибки.Вставить("Документ", ОбъектИсточник);	
				СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
				МассивОшибок.Добавить(СтруктураОшибки);
				Продолжить;
			КонецПопытки;	
				
    		ТабличныйДокументРезультат = ПечатныеФормы.КоллекцияПечатныхФорм[0].ТабличныйДокумент;
			
			Если ТабличныйДокументРезультат.ВысотаТаблицы = 0 Тогда
				// Пустой табличный документ.
				Продолжить;
			КонецЕсли;	
			
			Идентификатор1С = ОбъектПечати.УникальныйИдентификатор();
			
			Если НЕ НастройкаВыгрузкиОбъектаОбъектXDTO.Свойства().Получить("ЗаголовокНеформализованногоДокумента") = Неопределено Тогда
				ЗаголовокНеформализованногоДокумента = НастройкаВыгрузкиОбъектаОбъектXDTO.ЗаголовокНеформализованногоДокумента;  
				ТекстЗаголовкаНеформализованногоДокумента = ЗаголовокНеформализованногоДокумента.ТекстЗаголовкаНеформализованногоДокумента;	
				Если НЕ ЗаголовокНеформализованногоДокумента.Свойства().Получить("ТекстСодержитВычисляемыеЭлементы") = Неопределено 
						И ЗаголовокНеформализованногоДокумента.ТекстСодержитВычисляемыеЭлементы = "Истина" Тогда
					Выполнить("ТекстЗаголовкаНеформализованногоДокумента = """+СокрЛП(ТекстЗаголовкаНеформализованногоДокумента)+""";");	
				КонецЕсли;
			Иначе
				ТекстЗаголовкаНеформализованногоДокумента = "Приложение "+ИменаМакетов+" к "+ОбъектИсточник;
			КонецЕсли;
			
			Если НЕ ИмяФайлаОбъектаИсточника = "" Тогда
				ИмяФайла = ИмяФайлаОбъектаИсточника+"_"+СтрЗаменить(ТекстЗаголовкаНеформализованногоДокумента, " ", "_");
			Иначе
				ИмяФайла = СтрЗаменить(ТекстЗаголовкаНеформализованногоДокумента, " ", "_");
			КонецЕсли;	
			
			СостояниеДокумента 	= ПолучитьСтруктуруСостоянияДокумента();
			
			СостояниеДокумента.Ссылка 						= ОбъектПечати;	
			СостояниеДокумента.Выгрузка 					= ТабличныйДокументРезультат;
			СостояниеДокумента.ИмяФайла 					= ИмяФайла; 
			СостояниеДокумента.Идентификатор1С				= Идентификатор1С;
			СостояниеДокумента.Неформализованный			= Истина;
			СостояниеДокумента.ЗаголовокНеформализованного	= ТекстЗаголовкаНеформализованногоДокумента;
			СостояниеДокумента.ФорматФайла					= ОписаниеПечатнойФормыОбъектXDTO.ФорматФайла;
			СостояниеДокумента.ИдентификаторОтправителя		= ИдентификаторОтправителя;
			СостояниеДокумента.ИдентификаторПолучателя		= ИдентификаторПолучателя;
			
			ВыгрузкаДокументов.Добавить(СостояниеДокумента);
			
		Иначе
			
			// Задел для выгрузки произвольных файлов.
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры	

#КонецОбласти


#Область РедактированиеXMLДокументовПослеФормирования_XDTO
                                             
Процедура ОбработатьРезультатФормирования_XDTO(СтруктураДанных, НастройкаРедактированияРезультата, ФорматВыгрузки, Кэш, Документ, ПараметрыФормирования)
	
	Если ПараметрыФормирования.Свойство("ОсновныеДанныеДокумента") = Неопределено Тогда
		ОсновныеДанныеДокумента = Новый Структура();
		ОсновныеДанныеДокумента.Вставить("СсылкаНаДокумент", Документ);
		ОсновныеДанныеДокумента.Вставить("ФорматВыгрузки", ФорматВыгрузки);
		ПараметрыФормирования.Вставить("ОсновныеДанныеДокумента", ОсновныеДанныеДокумента);
	ИначеЕсли ПараметрыФормирования.ОсновныеДанныеДокумента = Неопределено Тогда
		ОсновныеДанныеДокумента = Новый Структура();
		ОсновныеДанныеДокумента.Вставить("СсылкаНаДокумент", Документ);
		ОсновныеДанныеДокумента.Вставить("ФорматВыгрузки", ФорматВыгрузки);
		ПараметрыФормирования.Вставить("ОсновныеДанныеДокумента", ОсновныеДанныеДокумента);
	КонецЕсли;
	
	ДанныеПереданыВВидеXDTO = Ложь;
	Фабрика = ПолучитьФабрикуФормата(ФорматВыгрузки, Кэш);
	
	Если ТипЗнч(СтруктураДанных) = Тип("Строка") Тогда
		
		XML = СтруктураДанных;
		ОбрабатываемыйОбъектXDTO = СоздатьОбъектXDTOИзXML(XML, Фабрика);
		
	ИначеЕсли ТипЗнч(СтруктураДанных) = Тип("ОбъектXDTO") Тогда
		
		ДанныеПереданыВВидеXDTO = Истина;
		ОбрабатываемыйОбъектXDTO = СтруктураДанных;
		
	КонецЕсли;
	
	ПараметрыФормирования.Вставить("ОбрабатываемыйУзелДокумента", ОбрабатываемыйОбъектXDTO);
	
	Для Каждого СвойствоXDTO из НастройкаРедактированияРезультата.Свойства() Цикл 
		
		Если СвойствоXDTO.Имя = "ЭтоМассив" ИЛИ СвойствоXDTO.Имя = "ПутьКМассиву" ИЛИ СвойствоXDTO.Имя = "ЭтоУдалениеУзла" ИЛИ СвойствоXDTO.Имя = "Имя" Тогда
			Продолжить;
		КонецЕсли;
		
		Если СвойствоXDTO.Имя = "ДополнительныеПараметры" Тогда
			
			Если НЕ ПараметрыФормирования.Свойство("ДополнительныеПараметры") Тогда
				ДополнительныеПараметры = Новый Структура();
				ДополнительныеПараметры.Вставить("Кэш", Кэш);
				ПараметрыФормирования.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
			ИначеЕсли ПараметрыФормирования.ДополнительныеПараметры = Неопределено Тогда
				ДополнительныеПараметры = Новый Структура();
				ДополнительныеПараметры.Вставить("Кэш", Кэш);
				ПараметрыФормирования.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
			КонецЕсли;	

			Для Каждого ДополнительныйПараметрОписаниеXDTO из НастройкаРедактированияРезультата.ДополнительныеПараметры.Свойства() Цикл
				XDTOДополнительныйПараметр = НастройкаРедактированияРезультата.ДополнительныеПараметры[ДополнительныйПараметрОписаниеXDTO.Имя];
				Значение = РассчитатьЗначениеПоМетодуРасчета(XDTOДополнительныйПараметр, ПараметрыФормирования, XDTOДополнительныйПараметр.Источник.МетодРасчетаЗначения);
				ПараметрыФормирования.ДополнительныеПараметры.Вставить(XDTOДополнительныйПараметр.Имя, Значение);
			КонецЦикла;
			
			Продолжить;
			
		КонецЕсли;
		
		НастройкаОбъектXDTO = НастройкаРедактированияРезультата[СвойствоXDTO.Имя];
		
		Если НЕ НастройкаОбъектXDTO.Свойства().Получить("УсловияРедактированияУзла") = Неопределено Тогда	
			УсловиеВыполнено = РезультатОбработкиУсловия(НастройкаОбъектXDTO, ПараметрыФормирования);
			Если УсловиеВыполнено = Ложь Тогда
				Продолжить;
			КонецЕсли;	
		КонецЕсли;
		
		
		Если НЕ НастройкаОбъектXDTO.Свойства().Получить("ЭтоУдалениеУзла") = Неопределено И НастройкаОбъектXDTO.ЭтоУдалениеУзла = "Истина" Тогда
			СтруктураАтрибутЭлементОбъектаXDTO = ПолучитьЗначениеИОбъектXDTOПоПути(ОбрабатываемыйОбъектXDTO, НастройкаОбъектXDTO.ПутьКАтрибутуЭлементу);
			Если СтруктураАтрибутЭлементОбъектаXDTO.УзелСуществует = Истина Тогда 
				СтруктураАтрибутЭлементОбъектаXDTO.ОбъектXDTO.Сбросить(СтруктураАтрибутЭлементОбъектаXDTO.Значение);
				Продолжить;
			Иначе
				// Атрибута или элемента и так не существует.
				Продолжить;
			КонецЕсли;	
		КонецЕсли;		
		
		Если НЕ НастройкаОбъектXDTO.Свойства().Получить("ЭтоДополнениеМассива") = Неопределено И НастройкаОбъектXDTO.ЭтоДополнениеМассива = "Истина" Тогда
			
			СтруктураМассивОбъектаXDTO = ПолучитьЗначениеИОбъектXDTOПоПути(ОбрабатываемыйОбъектXDTO, НастройкаОбъектXDTO.ПутьКМассиву);
			ВладелецМассиваОбъектXDTO = СтруктураМассивОбъектаXDTO.ОбъектXDTO;
			
			Если НЕ НастройкаОбъектXDTO.Свойства().Получить("МассивПоИсточнику") = Неопределено И НастройкаОбъектXDTO.МассивПоИсточнику = "Истина" Тогда
				
				ИсточникДанныхДляМассиваОбъектXDTO = НастройкаОбъектXDTO.ИсточникДанныхДляМассива;
				ИсточникДанныхДляМассива = РассчитатьЗначениеПоМетодуРасчета(ИсточникДанныхДляМассиваОбъектXDTO, ПараметрыФормирования);
				
				Если НастройкаОбъектXDTO.Тип = "МассивПоИсточнику" Тогда
				
					Для Каждого ЭлементДанныхМассива из ИсточникДанныхДляМассива Цикл
						ПараметрыФормирования.Вставить("ИсточникДанныхДляМассива", ЭлементДанныхМассива);
						ДополнитьМассивЭлементом_XDTO(ВладелецМассиваОбъектXDTO, НастройкаОбъектXDTO, Фабрика, ФорматВыгрузки, ПараметрыФормирования);		
					КонецЦикла;
					
					ПараметрыФормирования.Вставить("ОбрабатываемыйУзелДокумента", ОбрабатываемыйОбъектXDTO);
					
					Продолжить;  
					
				ИначеЕсли НастройкаОбъектXDTO.Тип = "МассивТекстПоИсточнику" Тогда
					
					Для Каждого ЭлементДанныхМассива из ИсточникДанныхДляМассива Цикл
						ПараметрыФормирования.Вставить("ИсточникДанныхДляМассива", ЭлементДанныхМассива);
						ЗаполнитьТекстЭлемента(ВладелецМассиваОбъектXDTO, НастройкаОбъектXDTO, ПараметрыФормирования);
					КонецЦикла;
					
					Продолжить;
					
				КонецЕсли;
				
			Иначе
				 
				ДополнитьМассивЭлементом_XDTO(ВладелецМассиваОбъектXDTO, НастройкаОбъектXDTO, Фабрика, ФорматВыгрузки, ПараметрыФормирования);		
				Продолжить; 
				
			КонецЕсли;
			
		КонецЕсли;
				
		Если НЕ НастройкаОбъектXDTO.Свойства().Получить("ЭтоЗаполнениеМассива") = Неопределено И НастройкаОбъектXDTO.ЭтоЗаполнениеМассива = "Истина" Тогда
			
			СтруктураМассивОбъектаXDTO = ПолучитьЗначениеИОбъектXDTOПоПути(ОбрабатываемыйОбъектXDTO, НастройкаОбъектXDTO.ПутьКМассиву);
			ГоловнойЭлементXDTO = СтруктураМассивОбъектаXDTO.ОбъектXDTO;
			ОбъектXDTOЭлемента = ПолучитьОбъектXDTO(Фабрика, ГоловнойЭлементXDTO.Тип(), НастройкаОбъектXDTO.Имя);
			
			Если НЕ НастройкаОбъектXDTO.Свойства().Получить("МассивПоИсточнику") = Неопределено И НастройкаОбъектXDTO.МассивПоИсточнику = "Истина" Тогда
				
				ИсточникДанныхДляМассиваОбъектXDTO = НастройкаОбъектXDTO.ИсточникДанныхДляМассива;
				ИсточникДанныхДляМассива = РассчитатьЗначениеПоМетодуРасчета(ИсточникДанныхДляМассиваОбъектXDTO, ПараметрыФормирования);
				
				Если НастройкаОбъектXDTO.Тип = "МассивПоИсточнику" Тогда
				
					Для Каждого ЭлементДанныхМассива из ИсточникДанныхДляМассива Цикл
						ПараметрыФормирования.Вставить("ИсточникДанныхДляМассива", ЭлементДанныхМассива);
						ЗаполнитьМассивЭлементом_XDTO(ГоловнойЭлементXDTO, НастройкаОбъектXDTO, Фабрика, ФорматВыгрузки, ПараметрыФормирования);		
					КонецЦикла;
					
					ПараметрыФормирования.Вставить("ОбрабатываемыйУзелДокумента", ОбрабатываемыйОбъектXDTO);
					
					Продолжить;  
				
				ИначеЕсли НастройкаОбъектXDTO.Тип = "МассивТекстПоИсточнику" Тогда
					
					Для Каждого ЭлементДанныхМассива из ИсточникДанныхДляМассива Цикл
						ПараметрыФормирования.Вставить("ИсточникДанныхДляМассива", ЭлементДанныхМассива);
						ЗаполнитьТекстЭлемента(ГоловнойЭлементXDTO, НастройкаОбъектXDTO, ПараметрыФормирования);
					КонецЦикла;
					
					Продолжить;
					
				КонецЕсли;
				
			Иначе	
				
				ЗаполнитьМассивЭлементом_XDTO(ГоловнойЭлементXDTO, НастройкаОбъектXDTO, Фабрика, ФорматВыгрузки, ПараметрыФормирования);		
				Продолжить;
				
			КонецЕсли;	
			
		КонецЕсли;
		
		Если НЕ НастройкаОбъектXDTO.Свойства().Получить("ЭтоОчисткаМассива") = Неопределено И НастройкаОбъектXDTO.ЭтоОчисткаМассива = "Истина" Тогда
			СтруктураМассивОбъектаXDTO = ПолучитьЗначениеИОбъектXDTOПоПути(ОбрабатываемыйОбъектXDTO, НастройкаОбъектXDTO.ПутьКМассиву);
			МассивОбъектXDTO = СтруктураМассивОбъектаXDTO.ОбъектXDTO[СтруктураМассивОбъектаXDTO.Значение];
			ПараметрыФормирования.Вставить("ОбрабатываемыйУзелДокумента", МассивОбъектXDTO);
			Если ТипЗнч(МассивОбъектXDTO) = Тип("СписокXDTO") Тогда
				// Несколько элементов в массиве.
				ИндексЭлемента = МассивОбъектXDTO.Количество()-1;
				Пока НЕ ИндексЭлемента = -1 Цикл
					ЭлементОбъектXDTO = МассивОбъектXDTO[ИндексЭлемента];
					ПараметрыФормирования.Вставить("ОбрабатываемыйУзелДокумента", ЭлементОбъектXDTO);
					Если НЕ НастройкаОбъектXDTO.Свойства().Получить("УсловияУдаленияЭлемента") = Неопределено Тогда
						// Удаляем только элементы, соответствующие условию.
						УсловиеВыполнено = РезультатОбработкиУсловия(НастройкаОбъектXDTO, ПараметрыФормирования);
						Если УсловиеВыполнено = Истина Тогда
							МассивОбъектXDTO.Удалить(ИндексЭлемента);
						КонецЕсли;	
					Иначе
						// Удаляем все элементы.
						МассивОбъектXDTO.Удалить(ИндексЭлемента);
					КонецЕсли;	                                 
					ИндексЭлемента = ИндексЭлемента-1;
				КонецЦикла;	
			ИначеЕсли ТипЗнч(МассивОбъектXDTO) = Тип("ОбъектXDTO") Тогда
				// Один элемент в массиве.
				// Если условий нет, удаляем сразу.
				УсловиеВыполнено = Истина;
				Если НЕ НастройкаОбъектXDTO.Свойства().Получить("УсловияУдаленияЭлемента") = Неопределено Тогда
					// Если условие есть, в случае несоответствия оно выдаст "Ложь".
					УсловиеВыполнено = РезультатОбработкиУсловия(НастройкаОбъектXDTO, ПараметрыФормирования);
				КонецЕсли;
				Если УсловиеВыполнено = Истина Тогда
					СтруктураМассивОбъектаXDTO.ОбъектXDTO.Сбросить(СтруктураМассивОбъектаXDTO.Значение);
				КонецЕсли;	
			КонецЕсли;
			Продолжить;
		КонецЕсли;	
		
		
		Если НастройкаОбъектXDTO.Свойства().Получить("ЭтоМассив") = Неопределено ИЛИ НастройкаОбъектXDTO.ЭтоМассив = "Ложь" Тогда 
			
			Если НастройкаОбъектXDTO.Свойства().Получить("ВариантыИсточника") = Неопределено Тогда 
				
				Если НастройкаОбъектXDTO.Тип = "Атрибут" Тогда 
				
					СтруктураАтрибутОбъектаXDTO = ПолучитьЗначениеИОбъектXDTOПоПути(ОбрабатываемыйОбъектXDTO, НастройкаОбъектXDTO.ПутьКАтрибуту);
					Если НЕ СтруктураАтрибутОбъектаXDTO = Неопределено И СтруктураАтрибутОбъектаXDTO.УзелСуществует = Истина Тогда 
						ЗначениеАтрибута = РассчитатьЗначениеПоМетодуРасчета(НастройкаОбъектXDTO, ПараметрыФормирования);
						СтруктураАтрибутОбъектаXDTO.ОбъектXDTO[СтруктураАтрибутОбъектаXDTO.Значение] = ЗначениеАтрибута;
					ИначеЕсли НЕ СтруктураАтрибутОбъектаXDTO = Неопределено И СтруктураАтрибутОбъектаXDTO.УзелСуществует = Ложь Тогда 
						ЭлементXDTO = СтруктураАтрибутОбъектаXDTO.ОбъектXDTO;
						ЗначениеАтрибута = РассчитатьЗначениеПоМетодуРасчета(НастройкаОбъектXDTO, ПараметрыФормирования);
						ЭлементДанныхString = ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "string");
						ЭлементДанных = ФабрикаXDTO.Создать(ЭлементДанныхString, ЗначениеАтрибута);
						ЭлементXDTO.Добавить(ФормаXML.Атрибут, ФорматВыгрузки, СокрЛП(НастройкаОбъектXDTO.Имя), ЭлементДанных);
					Иначе
						// Узел не существует.
					КонецЕсли; 
					
				ИначеЕсли НастройкаОбъектXDTO.Тип = "Элемент" Тогда	
					
					СтруктураЭлементОбъектаXDTO = ПолучитьЗначениеИОбъектXDTOПоПути(ОбрабатываемыйОбъектXDTO, НастройкаОбъектXDTO.ПутьКЭлементу);
					
					Если НЕ СтруктураЭлементОбъектаXDTO = Неопределено И СтруктураЭлементОбъектаXDTO.УзелСуществует = Истина Тогда
						// Элемент существует. Никакие действия не требуются.
					ИначеЕсли НЕ СтруктураЭлементОбъектаXDTO = Неопределено И СтруктураЭлементОбъектаXDTO.УзелСуществует = Ложь Тогда 
						ГоловнойЭлементXDTO = СтруктураЭлементОбъектаXDTO.ОбъектXDTO;
						ОбъектXDTOЭлемента = ПолучитьОбъектXDTO(Фабрика, ГоловнойЭлементXDTO.Тип(), НастройкаОбъектXDTO.Имя);
						ГоловнойЭлементXDTO.Добавить(ФормаXML.Элемент, ФорматВыгрузки, СокрЛП(НастройкаОбъектXDTO.Имя), ОбъектXDTOЭлемента);
					Иначе
						// Узел не существует.	
					КонецЕсли;	
						
				КонецЕсли;
				
			Иначе
				
				ВариантОбработан = Ложь;
				
				Если Тип(НастройкаОбъектXDTO.ВариантыИсточника.Вариант) = Тип("СписокXDTO") Тогда
				
					Для Каждого ВариантXDTO из НастройкаОбъектXDTO.ВариантыИсточника.Вариант Цикл
						
						УсловиеВыполнено = РезультатОбработкиУсловия(ВариантXDTO, ПараметрыФормирования);
						
						Если УсловиеВыполнено = Истина Тогда
							
							Если НастройкаОбъектXDTO.Тип = "Атрибут" Тогда 
							
								СтруктураАтрибутОбъектаXDTO = ПолучитьЗначениеИОбъектXDTOПоПути(ОбрабатываемыйОбъектXDTO, НастройкаОбъектXDTO.ПутьКАтрибуту);
								Если НЕ СтруктураАтрибутОбъектаXDTO = Неопределено И СтруктураАтрибутОбъектаXDTO.УзелСуществует = Истина Тогда 
									ЗначениеАтрибута = РассчитатьЗначениеПоМетодуРасчета(ВариантXDTO, ПараметрыФормирования);
									СтруктураАтрибутОбъектаXDTO.ОбъектXDTO[СтруктураАтрибутОбъектаXDTO.Значение] = ЗначениеАтрибута;
								ИначеЕсли НЕ СтруктураАтрибутОбъектаXDTO = Неопределено И СтруктураАтрибутОбъектаXDTO.УзелСуществует = Ложь Тогда 
									ЭлементXDTO = СтруктураАтрибутОбъектаXDTO.ОбъектXDTO;
									ЗначениеАтрибута = РассчитатьЗначениеПоМетодуРасчета(ВариантXDTO, ПараметрыФормирования);
									ЭлементДанныхString = ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "string");
									ЭлементДанных = ФабрикаXDTO.Создать(ЭлементДанныхString, ЗначениеАтрибута);
