		КонецЕсли;	
		
		// Поскольку мы заполнили типы документов самостоятельно, могли неверно расчитаться значения функций.
		// Дополнительный контроль.
		Если НЕ Данные.ДанныеДокумента.Строки.Количество() = 0 Тогда
			Если ФорматВыгрузки = "ON_NSCHFDOPPR" ИЛИ ФорматВыгрузки = "ON_NKORSCHFDOPPR" Тогда
				Если ЗначениеЗаполнено(ФункцияУПД) Тогда
					Данные.ДанныеДокумента.Строки.Найти("Функция", "ПолныйПуть", Истина).Значение = ФункцияУПД;
				Иначе	
					Если НЕ СоответствиеДокументФактура = Неопределено Тогда
						// Раньше для понимания наличия фактуры я пытался использовать ОписаниеДанных.СвязанныеОбъектыУчета,
						// но фактуры иногда просто выпадают из поля зрения алгоритма.
						Если НЕ СоответствиеДокументФактура.Получить(Выборка.ОбъектУчета) = Неопределено Тогда
							Если ФорматВыгрузки = "ON_NSCHFDOPPR" Тогда
								Данные.ДанныеДокумента.Строки.Найти("Функция", "ПолныйПуть", Истина).Значение = "СЧФДОП";
							ИначеЕсли ФорматВыгрузки = "ON_NKORSCHFDOPPR" Тогда
								Данные.ДанныеДокумента.Строки.Найти("Функция", "ПолныйПуть", Истина).Значение = "КСЧФДИС"; 	
							КонецЕсли;	
						Иначе	
							Если ФорматВыгрузки = "ON_NSCHFDOPPR" Тогда
								Данные.ДанныеДокумента.Строки.Найти("Функция", "ПолныйПуть", Истина).Значение = "ДОП";
							ИначеЕсли ФорматВыгрузки = "ON_NKORSCHFDOPPR" Тогда
								Данные.ДанныеДокумента.Строки.Найти("Функция", "ПолныйПуть", Истина).Значение = "ДИС";
							КонецЕсли;	
						КонецЕсли;	
					КонецЕсли;
					Если НЕ Метаданные.Документы.Найти("СчетФактураВыданный") = Неопределено И ТипЗнч(Выборка.ОбъектУчета) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
						Если ФорматВыгрузки = "ON_NSCHFDOPPR" Тогда
							Данные.ДанныеДокумента.Строки.Найти("Функция", "ПолныйПуть", Истина).Значение = "СЧФДОП";
						ИначеЕсли ФорматВыгрузки = "ON_NKORSCHFDOPPR" Тогда
							Данные.ДанныеДокумента.Строки.Найти("Функция", "ПолныйПуть", Истина).Значение = "КСЧФДИС"; 	
						КонецЕсли;
					КонецЕсли;
					Если Настройки.ТипДокумента = Перечисления.ТипыДокументовЭДО.СчетФактура Тогда
						Данные.ДанныеДокумента.Строки.Найти("Функция", "ПолныйПуть", Истина).Значение = "СЧФ";
					КонецЕсли;
					Если Настройки.ТипДокумента = Перечисления.ТипыДокументовЭДО.КорректировочныйСчетФактура Тогда
						Данные.ДанныеДокумента.Строки.Найти("Функция", "ПолныйПуть", Истина).Значение = "КСЧФ";
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
		
		МоментВремениНачалаФормированияДокумента = ТекущаяДата();
		
		РезультатФормирования = ОбщийМодульФорматыЭДО.СформироватьДанныеОсновногоТитулаПоОбъектуУчета(
			Выборка.ОбъектУчета, Настройки, Данные);	
			
		// Обработаем информацию об ошибках.
		Если РезультатФормирования.ЕстьОшибки Тогда
			ТекстОшибокДляИнформацииПоОшибкам = "";
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Произошли ошибки при формировании электронного документа по документу "+Выборка.ОбъектУчета+":";
			Сообщение.Сообщить();
			Если РезультатФормирования.Свойство("Ошибки") И РезультатФормирования.Ошибки.Свойство("ЗаполнениеДанных") И ТипЗнч(РезультатФормирования.Ошибки.ЗаполнениеДанных) = Тип("Массив") Тогда
				Для Каждого Ошибка из РезультатФормирования.Ошибки.ЗаполнениеДанных Цикл
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = Ошибка.ТекстОшибки;
					Сообщение.Сообщить();
					ТекстОшибокДляИнформацииПоОшибкам = ТекстОшибокДляИнформацииПоОшибкам +Символы.ПС+ Ошибка.ТекстОшибки;
				КонецЦикла;	
			КонецЕсли;
			Если НЕ СокрЛП(ТекстОшибокДляИнформацииПоОшибкам) = "" Тогда
				СтруктураОшибки = Новый Структура;
				СтруктураОшибки.Вставить("Документ", Выборка.ОбъектУчета);	
				СтруктураОшибки.Вставить("ТекстОшибки", СокрЛП(ТекстОшибокДляИнформацииПоОшибкам));
				ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
			КонецЕсли;
			
			// Не все ошибки записываются в "РезультатФормирования.Ошибки". Некоторые отмечаются только в журнале регистрации.
			МассивОбъектаУчета = Новый Массив;
			МассивОбъектаУчета.Добавить(Выборка.ОбъектУчета);
			МассивОшибокПоЗаписямЖурнала = ПодготовитьМассивОшибокФормированияДокументовБЭДизЖурналаРегистрации(МассивОбъектаУчета, МоментВремениНачалаФормированияДокумента);
			Для Каждого ОшибкаЖурнала из МассивОшибокПоЗаписямЖурнала Цикл
				Если ОшибкаЖурнала.Документ = Неопределено Тогда
					СтруктураОшибки = Новый Структура;
					СтруктураОшибки.Вставить("Документ", Выборка.ОбъектУчета);	
					СтруктураОшибки.Вставить("ТекстОшибки", ОшибкаЖурнала.ТекстОшибки);
					ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
				Иначе	
					ИнформацияПоОшибкамФормирования.Добавить(ОшибкаЖурнала);
				КонецЕсли;	
			КонецЦикла;
			
			Продолжить;	
		КонецЕсли;		
			
		ПолноеИмяФайлаЭД = КаталогВременныхФайлов()+РезультатФормирования.Документ.ИмяФайла;
		РезультатФормирования.Документ.ДвоичныеДанные.Записать(КаталогВременныхФайлов()+РезультатФормирования.Документ.ИмяФайла);	
		
		
		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьФайл(ПолноеИмяФайлаЭД);
		ПостроительDOM = Новый ПостроительDOM;
		ДокументDOM = ПостроительDOM.Прочитать(Чтение);
		
		
		// Определение и заполнение данных подписанта.
		ДанныеПодписанта = Неопределено;
		
		ЮрФизЛицоИППодписант = Неопределено;
		СубъектПодписант = Неопределено;
		ДолжностьПодписант = Неопределено;
		МчдGUIDПодписанта = Неопределено;
		ДатаНачалаДействияМЧД = Неопределено;
		Если НЕ ПараметрыАвторизацииИПодписания = Неопределено Тогда
			Если ПараметрыАвторизацииИПодписания.Свойство("ПараметрыПодписания") Тогда
				Если ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("ТипСубъекта") Тогда
					ЮрФизЛицоИППодписант = ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ТипСубъекта;
				КонецЕсли;
				Если ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("Субъект") Тогда
					СубъектПодписант = ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Субъект;
				КонецЕсли;
				Если ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("ДолжностьФизлица") Тогда
					ДолжностьПодписант = ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ДолжностьФизлица;
				КонецЕсли;
				Если ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("МчдGUID") Тогда
					МчдGUIDПодписанта = ПараметрыАвторизацииИПодписания.ПараметрыПодписания.МчдGUID;
				КонецЕсли;
				Если ПараметрыАвторизацииИПодписания.ПараметрыПодписания.Свойство("ДатаНачалаДействияМЧД") Тогда
					ДатаНачалаДействияМЧД = ПараметрыАвторизацииИПодписания.ПараметрыПодписания.ДатаНачалаДействияМЧД;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ЮрФизЛицоИППодписант) Тогда
			ЮрФизЛицоИППодписант = ?(СтрДлина(СокрЛП(Выборка.ОрганизацияИНН)) = 10, "ЮЛ", "ИП");
		КонецЕсли;
		
		ТипПродавца = ?(СтрДлина(СокрЛП(Выборка.ОрганизацияИНН)) = 10, "ЮрЛицо", "ИндПред"); 
		
		ПодписьСоответствуетОрганизации = Ложь;
		
		Если НЕ СубъектПодписант = Неопределено Тогда
			// Были переданы данные о подписанте из ЭЦП.
			ЭЦП_ИНН = "";
			Если СубъектПодписант.Свойство("OID1_2_643_100_4") Тогда
				ЭЦП_ИНН = СубъектПодписант.OID1_2_643_100_4;
			ИначеЕсли СубъектПодписант.Свойство("OID1_2_643_3_131_1_1") Тогда
				ЭЦП_ИНН = СубъектПодписант.OID1_2_643_3_131_1_1;
			ИначеЕсли СубъектПодписант.Свойство("INNLE") Тогда
				ЭЦП_ИНН = СубъектПодписант.INNLE;
			ИначеЕсли СубъектПодписант.Свойство("ИННЮЛ") Тогда
				ЭЦП_ИНН = СубъектПодписант.ИННЮЛ;
			ИначеЕсли СубъектПодписант.Свойство("ИНН_ЮЛ") Тогда
				ЭЦП_ИНН = СубъектПодписант.ИНН_ЮЛ;
			ИначеЕсли СубъектПодписант.Свойство("ИНН") Тогда
				ЭЦП_ИНН = СубъектПодписант.ИНН;
			ИначеЕсли СубъектПодписант.Свойство("ИННОрганизации") Тогда
				ЭЦП_ИНН = СубъектПодписант.ИННОрганизации;
			ИначеЕсли СубъектПодписант.Свойство("ИНН_Организации") Тогда
				ЭЦП_ИНН = СубъектПодписант.ИНН_Организации;	
			КонецЕсли;
			Если НЕ ЮрФизЛицоИППодписант = "ФЛ" Тогда
				Если ЭЦП_ИНН = "" Тогда
					ПодписьСоответствуетОрганизации = Ложь;
				Иначе	
					ПодписьСоответствуетОрганизации = СтрНайти(ЭЦП_ИНН, Выборка.ОрганизацияИНН) <> 0;
				КонецЕсли;
			Иначе
				ПодписьСоответствуетОрганизации = Истина;
			КонецЕсли;	
		КонецЕсли;
		
		Если НЕ СубъектПодписант = Неопределено И НЕ ПодписьСоответствуетОрганизации И НЕ ЮрФизЛицоИППодписант = "ФЛ" Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Внимание! Приложенная подпись не принадлежит организации, указанной в документе!"+Символы.ПС+"Проверьте корректность подписи!"
				+Символы.ПС+"Данные о подписанте будут заполнены в соответствии с данными об руководителе организации из 1С.";
			Сообщение.Сообщить();
		КонецЕсли;	
		
		Если ПодписьСоответствуетОрганизации И НЕ ЮрФизЛицоИППодписант = "ФЛ" Тогда
			
			// Были переданы данные о подписанте из ЭЦП.
			ДанныеПодписанта = Новый Структура;  
			ДанныеПодписанта.Вставить("Фамилия", СокрЛП(СубъектПодписант.OID2_5_4_4));
			ИмяОтчествоРазделитель = СтрНайти(СубъектПодписант.OID2_5_4_42, " ");
			Если НЕ ИмяОтчествоРазделитель = 0 Тогда
				ДанныеПодписанта.Вставить("Имя", СокрЛП(Лев(СубъектПодписант.OID2_5_4_42, СтрНайти(СубъектПодписант.OID2_5_4_42, " "))));
				ДанныеПодписанта.Вставить("Отчество", СокрЛП(Прав(СубъектПодписант.OID2_5_4_42, СтрДлина(СубъектПодписант.OID2_5_4_42) - ИмяОтчествоРазделитель)));
			Иначе
				ДанныеПодписанта.Вставить("Имя", СубъектПодписант.OID2_5_4_42);
				ДанныеПодписанта.Вставить("Отчество", "");
			КонецЕсли;
			Если ЮрФизЛицоИППодписант = "ЮЛ" И НЕ СубъектПодписант.Свойство("T") Тогда
				ДанныеПодписанта = Неопределено;
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "Внимание! В прилагаемой подписи отсутствует обязательная информация о должности подписанта!"+Символы.ПС+"Проверьте корректность подписи!";
				Сообщение.Сообщить();
			ИначеЕсли ЮрФизЛицоИППодписант = "ИП" Тогда
				ДанныеПодписанта.Вставить("Должность", "Индивидуальный предприниматель");
			Иначе	
				ДанныеПодписанта.Вставить("Должность", ?(ЮрФизЛицоИППодписант = "ЮЛ", СокрЛП(СубъектПодписант.T), ""));
			КонецЕсли;	
			
		ИначеЕсли ЮрФизЛицоИППодписант = "ФЛ" Тогда 
		
			// Были переданы данные о подписанте-физлице из ЭЦП. 
			ДанныеПодписанта = Новый Структура;	
			ДанныеПодписанта.Вставить("Фамилия", СокрЛП(СубъектПодписант.OID2_5_4_4));
			ИмяОтчествоРазделитель = СтрНайти(СубъектПодписант.OID2_5_4_42, " ");
			Если НЕ ИмяОтчествоРазделитель = 0 Тогда
				ДанныеПодписанта.Вставить("Имя", СокрЛП(Лев(СубъектПодписант.OID2_5_4_42, СтрНайти(СубъектПодписант.OID2_5_4_42, " "))));
				ДанныеПодписанта.Вставить("Отчество", СокрЛП(Прав(СубъектПодписант.OID2_5_4_42, СтрДлина(СубъектПодписант.OID2_5_4_42) - ИмяОтчествоРазделитель)));
			Иначе
				ДанныеПодписанта.Вставить("Имя", СубъектПодписант.OID2_5_4_42);
				ДанныеПодписанта.Вставить("Отчество", "");
			КонецЕсли;	
			Если ТипПродавца = "ЮрЛицо" Тогда
				Если ЗначениеЗаполнено(СокрЛП(ДолжностьПодписант)) Тогда
					ДанныеПодписанта.Вставить("Должность", ДолжностьПодписант);
				Иначе
					ДанныеПодписанта.Вставить("Должность", "Уполномоченное физическое лицо");
				КонецЕсли;
			Иначе
				ДанныеПодписанта.Вставить("Должность", "Индивидуальный предприниматель");
			КонецЕсли;	
			
		Иначе
			
			Если Найти(Кэш.ПрефиксКонфигурации, "УНФ") = 0 Тогда
				ДанныеПодписанта = ПолучитьФИОРуководителяОрганизацииНаДату_Стандарт(Выборка.Организация, Выборка.ОбъектУчета.Дата, Кэш.ПрефиксКонфигурации);
			Иначе
				ДанныеПодписанта = ПолучитьФИОРуководителяОрганизацииНаДату_УНФ(Выборка.Организация, Выборка.ОбъектУчета.Дата, Кэш.ПрефиксКонфигурации);
			КонецЕсли;	
				
		КонецЕсли;
		
		Если НЕ ДанныеПодписанта = Неопределено И НЕ ДанныеПодписанта.Фамилия = "" И НЕ ДанныеПодписанта.Имя = "" Тогда
			
			НаимОрг = Выборка.Организация.НаименованиеПолное;
			
			ДанныеПодписанта.Вставить("НаимОрг", НаимОрг);
			Если НЕ ЮрФизЛицоИППодписант = "ФЛ" Тогда 
				ДанныеПодписанта.Вставить("ИНН", Выборка.ОрганизацияИНН);
				ДанныеПодписанта.Вставить("ОснПолн", "Должностные обязанности");
			Иначе
				ДанныеПодписанта.Вставить("ИНН", Выборка.ОрганизацияИНН);
				ДанныеПодписанта.Вставить("ОснПолн", "Доверенность подписанта");
			КонецЕсли;	
				
			Если ФорматВыгрузки = "DP_REZRUISP" ИЛИ ФорматВыгрузки = "DP_TOVTORGPR" Тогда
				ДанныеПодписанта.Вставить("ОблПолн", "2");
			ИначеЕсли ФорматВыгрузки = "ON_NKORSCHFDOPPR" Тогда
				ДанныеПодписанта.Вставить("ОблПолн", "6");
			Иначе	
				ДанныеПодписанта.Вставить("ОблПолн", "5"); 
			КонецЕсли;	
			//Принимает значения:
			//0 - лицо, ответственное за подписание счетов-фактур |
			//1 - лицо, совершившее сделку, операцию |
			//2 - лицо, совершившее сделку, операцию и ответственное за ее оформление |
			//3 - лицо, ответственное за оформление свершившегося события |
			//4 - лицо, совершившее сделку, операцию и ответственное за подписание счетов-фактур |
			//5 - лицо, совершившее сделку, операцию и ответственное за ее оформление и за подписание счетов-фактур |
			//6 - лицо, ответственное за оформление свершившегося события и за подписание счетов-фактур
			
			Если НЕ ЮрФизЛицоИППодписант = "ФЛ" Тогда
				ДанныеПодписанта.Вставить("Статус", "1"); //Принимает значение:
				//1 - работник организации продавца товаров (работ, услуг, имущественных прав) |
				//2 - работник организации - составителя файла обмена информации продавца, если составитель файла обмена информации не является продавцом |
				//3 - работник иной уполномоченной организации |
				//4 - уполномоченное физическое лицо (в том числе индивидуальный предприниматель) 
			Иначе
				ДанныеПодписанта.Вставить("Статус", "1");
			КонецЕсли;
			
			ДанныеПодписанта.Вставить("ТипПодпис", "1");
			
			// Способ подтверждения полномочий.
			// Еслю ЮЛ - 1, если ФЛ -3.
			Если НЕ ЮрФизЛицоИППодписант = "ФЛ" Тогда
				ДанныеПодписанта.Вставить("СпосПодтПолном", "1");
			Иначе
				ДанныеПодписанта.Вставить("СпосПодтПолном", "4");
			КонецЕсли;
			//Принимает значения:
			//1 - в соответствии с данными, содержащимися в электронной подписи |
			//2 - в соответствии с доверенностью в электронной форме в машиночитаемом виде, если представление доверенности осуществляется посредством включения в каждый пакет электронных документов, подписываемых представителем |
			//3 - в соответствии с доверенностью в электронной форме в машиночитаемом виде, если представление доверенности осуществляется из информационной системы. При этом необходимая информация для запроса доверенности из информационной системы, указана в электронном документе |
			//4 - в соответствии с доверенностью в электронной форме в машиночитаемом виде, если представление доверенности осуществляется из информационной системы. При этом необходимая информация для запроса доверенности из информационной системы представляется способом, отличным от указания в электронном документе |
			//5 - в соответствии с доверенностью в форме документа на бумажном носителе |
			//6 - иное
			
			ДанныеДоверенностиВведены = Ложь;
			Если ЗначениеЗаполнено(МчдGUIDПодписанта) И ЗначениеЗаполнено(ДатаНачалаДействияМЧД) Тогда
				ДанныеДоверенностиВведены = Истина;
			КонецЕсли;	
			
			Если ЮрФизЛицоИППодписант = "ФЛ" И ДанныеДоверенностиВведены = Ложь Тогда //И ФормированиеДляПредпросмотра = Ложь Тогда
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "Заполните для подписанта организации " + Выборка.Организация + "все данные по МЧД.";
				Сообщение.Сообщить();
				Продолжить;
			КонецЕсли;	
			
			// Данные об МЧД
			Если ЮрФизЛицоИППодписант = "ФЛ" Тогда
				ДанныеПодписанта.Вставить("МчдGUIDПодписанта", МчдGUIDПодписанта);
				ДанныеПодписанта.Вставить("ДатаНачалаДействияМЧД", ДатаНачалаДействияМЧД);
			КонецЕсли;
			
		Иначе
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Заполните руководителя для организации: " + Выборка.Организация;
			Сообщение.Сообщить();
			Продолжить;
		КонецЕсли;	
		
		Если ЭтоДокументПродажи Тогда
			Если ЭтоДокументУПД503 Тогда
				ЗавершитьЗаполнениеДокументаПродажи503_1_9_DOM(ДокументDOM, Выборка, ФорматВыгрузки, ДанныеПодписанта, ЮрФизЛицоИППодписант, ТипПродавца, ИнформацияПоОшибкамФормирования, ФормированиеДляПредпросмотра);
			Иначе	
				ЗавершитьЗаполнениеДокументаПродажи501_1_9_DOM(ДокументDOM, Выборка, ФорматВыгрузки, ДанныеПодписанта, ЮрФизЛицоИППодписант, ТипПродавца, ИнформацияПоОшибкамФормирования);
			КонецЕсли;	
		ИначеЕсли ЭтоДокументАктаСверки Тогда
			ЗавершитьЗаполнениеДокументаАктаСверки_1_9_DOM(ДокументDOM, Выборка, ДанныеПодписанта, ТипПродавца, ИнформацияПоОшибкамФормирования);
		ИначеЕсли ЭтоДокументСчетаНаОплату Тогда
			ЗавершитьЗаполнениеДокументаСчетаНаОплату_1_9_DOM(ДокументDOM, Выборка, ДанныеПодписанта, ТипПродавца, ИнформацияПоОшибкамФормирования);
		КонецЕсли;
		
		ПроверитьНаНаличиеПустыхЭлементовИАтрибутов(ДокументDOM);
		
		ПараметрыЗаписи = Новый ПараметрыЗаписиXML("Windows-1251", "1.0", Истина, Истина);
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку(ПараметрыЗаписи); 
		ЗаписьDOM = Новый ЗаписьDOM;
		ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
		XML = ЗаписьXML.Закрыть();
		
		// Пространства имен не нужны. 
		УдалитьПространствоИменИзXML(XML, ФорматВыгрузки);
		
		Если НЕ НастройкаРедактированияРезультата = Неопределено Тогда
			
			ОсновныеДанныеДокумента = Новый Структура();
			ОсновныеДанныеДокумента.Вставить("СсылкаНаДокумент", Выборка.ОбъектУчета);
			ОсновныеДанныеДокумента.Вставить("ФорматВыгрузки", ФорматВыгрузки);
			ПараметрыФормированияДокумента.Вставить("ОсновныеДанныеДокумента", ОсновныеДанныеДокумента);
			
			// Вычисляем дополнительные данные для каждого элемента выборки
			ДополнительныеПараметрыЭлементаВыборки = Новый Структура();
			Идентификатор1С = Строка(Выборка.ОбъектУчета.Ссылка.УникальныйИдентификатор());
			ДополнительныеПараметрыЭлементаВыборки.Вставить("ИдентификаторДокумента", Идентификатор1С);
			Если НЕ ОписаниеДополнительныхПараметровЭлементаВыборки = Неопределено Тогда 
				Для Каждого СвойствоXDTO из ОписаниеДополнительныхПараметровЭлементаВыборки.Свойства() Цикл
					XDTOДополнительныйПараметр = ОписаниеДополнительныхПараметровЭлементаВыборки[СвойствоXDTO.Имя];
					Значение = РассчитатьЗначениеПоМетодуРасчета(XDTOДополнительныйПараметр, ПараметрыФормированияДокумента, XDTOДополнительныйПараметр.Источник.МетодРасчетаЗначения);
					ДополнительныеПараметрыЭлементаВыборки.Вставить(XDTOДополнительныйПараметр.Имя, Значение);
					ПараметрыФормированияДокумента.Вставить("ДополнительныеПараметрыЭлементаВыборки", ДополнительныеПараметрыЭлементаВыборки);
				КонецЦикла;
			КонецЕсли;
						
			ОбработатьРезультатФормирования_DOM(XML, НастройкаРедактированияРезультата, ФорматВыгрузки, Кэш, Выборка.ОбъектУчета, ПараметрыФормированияДокумента);
			
		КонецЕсли;
		
		Если ИспользоватьПодписание Тогда
			ОбработкаПодписиФизлицаУспешна = ПоместитьВДокументИдентификаторДоверенностиФизлица_DOM(XML, ПараметрыАвторизацииИПодписания, ФорматВыгрузки, Кэш, ЮрФизЛицоИППодписант);
		КонецЕсли;	
			
		ДокументСодержитМарки = Ложь;
		ДокументСодержитДанныеПрослеживаемости = Ложь;
		//ДокументСодержитМарки = ДокументСодержитИнформациюПоМаркам(Выборка.ОбъектУчета);
		Если ДокументСодержитМарки = Ложь Тогда
			Если НЕ СтрНайти(XML, "СведПрослеж") = 0 Тогда
				ДокументСодержитМарки = Ложь;
				ДокументСодержитДанныеПрослеживаемости = Истина;
			ИначеЕсли НЕ СтрНайти(XML, "НомСредИдентТов") = 0 Тогда
				ДокументСодержитМарки = Истина;
			ИначеЕсли НЕ СтрНайти(XML, "НомСредИдентТовДо") = 0 Тогда
				ДокументСодержитМарки = Истина;
			ИначеЕсли НЕ СтрНайти(XML, "НомСредИдентТовПосле") = 0 Тогда
				ДокументСодержитМарки = Истина;	
			КонецЕсли;	
		КонецЕсли;
		
		Идентификатор1С = Строка(Новый УникальныйИдентификатор);
		ДатаДокумента = Формат(Выборка.ОбъектУчета.Дата, "ДФ=yyyyMMdd");
		ЭлементСвУчДокОборДокументаDOM = ПолучитьЭлементУзлаDOM(ДокументDOM, "СвУчДокОбор", Выборка.ОбъектУчета, ИнформацияПоОшибкамФормирования);
		ЭлементДокументДокументаDOM = ПолучитьЭлементУзлаDOM(ДокументDOM, "Документ", Выборка.ОбъектУчета, ИнформацияПоОшибкамФормирования);
		
		ИмяФайла = СоставитьИмяФайлаПоИдентификаторам_DOM(ЭлементСвУчДокОборДокументаDOM, ФорматВыгрузки, Выборка.ОбъектУчета, ДатаДокумента, 
					Идентификатор1С, ЭтоДокументУПД503, ДокументСодержитМарки, ДокументСодержитДанныеПрослеживаемости, Данные.Участники.ИдентификаторОтправителя, Данные.Участники.ИдентификаторПолучателя);
					
		Если ЭтоДокументУПД503 = Ложь Тогда			
			Если ДокументСодержитМарки И СтрНайти(XML, "ИдФайл="""+ФорматВыгрузки+"MARK") = 0 Тогда
				XML = СтрЗаменить(XML, "ИдФайл="""+ФорматВыгрузки, "ИдФайл="""+ФорматВыгрузки+"MARK");
			КонецЕсли;
			Если ДокументСодержитДанныеПрослеживаемости И СтрНайти(XML, "ИдФайл="""+ФорматВыгрузки+"PROS") = 0 Тогда
				XML = СтрЗаменить(XML, "ИдФайл="""+ФорматВыгрузки, "ИдФайл="""+ФорматВыгрузки+"PROS");
			КонецЕсли;
		Иначе
			НачалоИдФайл = СтрНайти(XML, "ИдФайл");
			ОкончаниеИдФайл = СтрНайти(Сред(XML, НачалоИдФайл, СтрДлина(XML)), Символы.ПС)-1;
			СтрокаИдФайлИзначальная = Сред(XML, НачалоИдФайл, ОкончаниеИдФайл);
			СтрокаИдФайл = СтрокаИдФайлИзначальная;
			СтрокаФлагиИзначальная = Сред(СтрокаИдФайл, ОкончаниеИдФайл-13, 13);
			СтрокаФлаги = СтрокаФлагиИзначальная;
			Если ДокументСодержитДанныеПрослеживаемости Тогда
				СтрокаФлагиСПрослеживаемостью = "_1" + Прав(СтрокаФлаги, 11);
				СтрокаФлаги = СтрокаФлагиСПрослеживаемостью;
			КонецЕсли;
			Если ДокументСодержитМарки Тогда
				СтрокаФлагиСМаркировкой = Лев(СтрокаФлаги, 2) + "_1"+Прав(СтрокаФлаги, 9);
				СтрокаФлаги = СтрокаФлагиСМаркировкой;
			КонецЕсли;
			Если НЕ СтрокаФлаги = СтрокаФлагиИзначальная Тогда
				СтрокаИдФайл = СтрЗаменить(СтрокаИдФайл, СтрокаФлагиИзначальная, СтрокаФлаги);
				XML = СтрЗаменить(XML, СтрокаИдФайлИзначальная, СтрокаИдФайл);
			КонецЕсли;	
		КонецЕсли;
		
		СостояниеДокумента 	= ПолучитьСтруктуруСостоянияДокумента();
		
		Если НЕ СоответствиеДокументФактура = Неопределено И НЕ СоответствиеДокументФактура.Получить(Выборка.ОбъектУчета) = Неопределено Тогда
			СостояниеДокумента.Ссылка 				= СоответствиеДокументФактура.Получить(Выборка.ОбъектУчета);
		Иначе
			СостояниеДокумента.Ссылка 				= Выборка.ОбъектУчета;
		КонецЕсли;	
		СостояниеДокумента.Выгрузка 				= XML;
		СостояниеДокумента.ФорматФормализованного	= ФорматВыгрузки;
		СостояниеДокумента.ИмяФайла 				= ИмяФайла; 
		СостояниеДокумента.Идентификатор1С			= Идентификатор1С;
		СостояниеДокумента.Подписант 				= ДанныеПодписанта;
		СостояниеДокумента.ОтправительСсылка		= Выборка.Организация;
		СостояниеДокумента.ПолучательСсылка			= Выборка.Контрагент;
		СостояниеДокумента.ИдентификаторОтправителя	= Данные.Участники.ИдентификаторОтправителя;
		СостояниеДокумента.ИдентификаторПолучателя	= Данные.Участники.ИдентификаторПолучателя;
		
		Если ОбработкаПодписиФизлицаУспешна = Ложь Тогда
			СостояниеДокумента.ОшибкиФормирования = Истина;
			СостояниеДокумента.ОписанияОшибокФормирования = "Ошибка применения для подписания документа сертификата физлица. Проверьте настройки и корректность заполнения идентификатора доверенности физлица.";
		КонецЕсли;
		
		ВыгрузкаДокументов.Добавить(СостояниеДокумента);
		
		Если НЕ СостояниеДокумента.ОшибкиФормирования И НЕ НастройкаВыгрузкиДополнительныхОбъектов = Неопределено Тогда
			ДополнитьВыгрузкуДополнительнымиОбъектами(Выборка.ОбъектУчета, НастройкаВыгрузкиДополнительныхОбъектов, ВыгрузкаДокументов, Кэш, Конфигурация, ИнтеграцияКаталог, ИмяФайла, ИнформацияПоОшибкамФормирования);
		КонецЕсли;	
		
	КонецЦикла;
	
	Если ИнформацияПоОшибкамФормирования.Количество() > 0 Тогда		
		
		Для Каждого Ошибка из ИнформацияПоОшибкамФормирования Цикл 
			СостояниеДокумента 	= ПолучитьСтруктуруСостоянияДокумента();			
			СостояниеДокумента.Ссылка						= Ошибка.Документ;
			СостояниеДокумента.ФорматФормализованного		= ФорматВыгрузки;
			СостояниеДокумента.ОшибкиФормирования			= Истина;
			СостояниеДокумента.ОписанияОшибокФормирования	= Ошибка.ТекстОшибки;	
			ВыгрузкаДокументов.Добавить(СостояниеДокумента);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ВыгрузкаДокументов;
	
КонецФункции

Процедура ЗавершитьЗаполнениеДокументаПродажи501_1_9_DOM(ДокументDOM, ЭлементВыборкиПоДокументам, ФорматВыгрузки, ДанныеПодписанта, Знач ЮрФизЛицоИППодписант, ТипПродавца, ИнформацияПоОшибкамФормирования)
	
	Если ЮрФизЛицоИППодписант = "ФЛ" Тогда
		ЮрФизЛицоИППодписант = "ЮЛ";
	КонецЕсли;
	
	// Сведения об операторе и участниках ДО.
	ЭлементСвУчДокОборДокументаDOM = ПолучитьЭлементУзлаDOM(ДокументDOM, "СвУчДокОбор", ЭлементВыборкиПоДокументам.ОбъектУчета, ИнформацияПоОшибкамФормирования); 
	ЭлементСвОЭДОтпрЭлементаСвУчДокОбор = ДокументDOM.СоздатьЭлемент("СвОЭДОтпр");
	ЭлементСвОЭДОтпрЭлементаСвУчДокОбор.УстановитьАтрибут("ИННЮЛ", "9715260691");
	ЭлементСвОЭДОтпрЭлементаСвУчДокОбор.УстановитьАтрибут("ИдЭДО", "2VO");
	ЭлементСвОЭДОтпрЭлементаСвУчДокОбор.УстановитьАтрибут("НаимОрг", "ООО &quot;Эвотор ОФД&quot;");
	ЭлементСвУчДокОборДокументаDOM.ДобавитьДочерний(ЭлементСвОЭДОтпрЭлементаСвУчДокОбор);
	
	// Создаем и заполняем узел "Подписант".
	ЭлементДокументДокументаDOM = ПолучитьЭлементУзлаDOM(ДокументDOM, "Документ", ЭлементВыборкиПоДокументам.ОбъектУчета, ИнформацияПоОшибкамФормирования);
	ЭлементПодписантДокументаDOM = ПолучитьЭлементУзлаDOM(ДокументDOM, "Подписант");
	Если НЕ ЭлементПодписантДокументаDOM = Неопределено Тогда
		// Если типовая процедура сама создала этот узел, уничтожаем его.
		ЭлементДокументДокументаDOM.УдалитьДочерний(ЭлементПодписантДокументаDOM);
	КонецЕсли;
	ЭлементПодписантДокументаDOM = ДокументDOM.СоздатьЭлемент("Подписант");
	ЭлементПодписантДокументаDOM.УстановитьАтрибут("ОблПолн", ДанныеПодписанта.ОблПолн);
	ЭлементПодписантДокументаDOM.УстановитьАтрибут("Статус", ДанныеПодписанта.Статус);
	ЭлементПодписантДокументаDOM.УстановитьАтрибут(?(ФорматВыгрузки = "DP_REZRUISP", "ОснПолнПодп", "ОснПолн"), ДанныеПодписанта.ОснПолн);		
	// Создаем и заполняем узел "ЮЛ"/"ИП"/"ФЛ".
	Если ТипПродавца = "ЮрЛицо" Тогда
		ЭлементЮЛИПФЛДокументаDOM = ДокументDOM.СоздатьЭлемент("ЮЛ");
	ИначеЕсли ТипПродавца = "ИндПред" Тогда
		ЭлементЮЛИПФЛДокументаDOM = ДокументDOM.СоздатьЭлемент("ИП");
	КонецЕсли;	
	Если ЮрФизЛицоИППодписант = "ЮЛ" И ТипПродавца = "ЮрЛицо" Тогда
		ЭлементЮЛИПФЛДокументаDOM.УстановитьАтрибут("ИННЮЛ", ДанныеПодписанта.ИНН);
		ЭлементЮЛИПФЛДокументаDOM.УстановитьАтрибут("НаимОрг", ДанныеПодписанта.НаимОрг);
		ЭлементЮЛИПФЛДокументаDOM.УстановитьАтрибут("Должн", ДанныеПодписанта.Должность);
	Иначе
		ЭлементЮЛИПФЛДокументаDOM.УстановитьАтрибут("ИННФЛ", ДанныеПодписанта.ИНН);
	КонецЕсли;         
	// Создаем и заполняем узел ФИО.
	ЭлементФИОДокументаDOM = ДокументDOM.СоздатьЭлемент("ФИО");
	ЭлементФИОДокументаDOM.УстановитьАтрибут("Фамилия", ДанныеПодписанта.Фамилия);
	ЭлементФИОДокументаDOM.УстановитьАтрибут("Имя", ДанныеПодписанта.Имя);
	ЭлементФИОДокументаDOM.УстановитьАтрибут("Отчество", ДанныеПодписанта.Отчество);
	// Помещаем узлы друг в друга и в документ.
	ЭлементЮЛИПФЛДокументаDOM.ДобавитьДочерний(ЭлементФИОДокументаDOM);
	ЭлементПодписантДокументаDOM.ДобавитьДочерний(ЭлементЮЛИПФЛДокументаDOM);
	ЭлементДокументДокументаDOM.ДобавитьДочерний(ЭлементПодписантДокументаDOM);
	
КонецПроцедуры

Процедура ЗавершитьЗаполнениеДокументаПродажи503_1_9_DOM(ДокументDOM, ЭлементВыборкиПоДокументам, ФорматВыгрузки, ДанныеПодписанта, Знач ЮрФизЛицоИППодписант, ТипПродавца, ИнформацияПоОшибкамФормирования, ФормированиеДляПредпросмотра)
	
	Если ЮрФизЛицоИППодписант = "ФЛ" Тогда
		ДатаНачалаДействияМЧДДляПомещенияВДокумент = "";
		ОбщийМодульСтроковыеФункцииКлиентСервер = Метаданные.ОбщиеМодули.Найти("СтроковыеФункцииКлиентСервер");
		Если ОбщийМодульСтроковыеФункцииКлиентСервер = Неопределено Тогда
			ДатаМЧД_МассивСтрок = РазбитьСтрокуВМассив(ДанныеПодписанта.ДатаНачалаДействияМЧД, "-");
			ДатаНачалаДействияМЧДДляПомещенияВДокумент = ДатаМЧД_МассивСтрок[2] +"."+ ДатаМЧД_МассивСтрок[1] +"."+ ДатаМЧД_МассивСтрок[0];
		Иначе
			ОбщийМодульСтроковыеФункцииКлиентСервер = Вычислить("СтроковыеФункцииКлиентСервер");
			ДатаНачалаДействияМЧДДляПомещенияВДокумент = ОбщийМодульСтроковыеФункцииКлиентСервер.СтрокаВДату(ДанныеПодписанта.ДатаНачалаДействияМЧД);
			ДатаНачалаДействияМЧДДляПомещенияВДокумент = Формат(ДатаНачалаДействияМЧДДляПомещенияВДокумент, "ДФ=dd.MM.yyyy");
		КонецЕсли;
	КонецЕсли;
	
	ЭлементДокументДокументаDOM = ПолучитьЭлементУзлаDOM(ДокументDOM, "Документ", ЭлементВыборкиПоДокументам.ОбъектУчета, ИнформацияПоОшибкамФормирования);
	
	// Создаем и заполняем узел "СвПродПер\СвПер\СвЛицПер"
	ЭлементСвПродПерДокументаDOM = ПолучитьЭлементУзлаDOM(ДокументDOM, "СвПродПер");
	ЭлементСвПерДокументаDOM = ПолучитьЭлементУзлаDOM(ЭлементСвПродПерДокументаDOM, "СвПер");
	Если ЭлементСвПерДокументаDOM = Неопределено Тогда
		ЭлементСвПерДокументаDOM = ДокументDOM.СоздатьЭлемент("СвПер");
		ЭлементСвПродПерДокументаDOM.ДобавитьДочерний(ЭлементСвПерДокументаDOM);	
	КонецЕсли;
	ЭлементСвЛицПерДокументаDOM = ПолучитьЭлементУзлаDOM(ЭлементСвПерДокументаDOM, "СвЛицПер");
	Если ЭлементСвЛицПерДокументаDOM = Неопределено Тогда
		ЭлементСвЛицПерДокументаDOM = ДокументDOM.СоздатьЭлемент("СвЛицПер");
		ЭлементТранДокументаDOM = ПолучитьЭлементУзлаDOM(ЭлементСвПродПерДокументаDOM, "Тран");
		Если ЭлементТранДокументаDOM = Неопределено Тогда
			ЭлементСвПерДокументаDOM.ДобавитьДочерний(ЭлементСвЛицПерДокументаDOM);
		Иначе
			ЭлементСвПерДокументаDOM.ВставитьПеред(ЭлементСвЛицПерДокументаDOM, ЭлементТранДокументаDOM);
		КонецЕсли;	
	КонецЕсли;	
	ЭлементИнЛицоДокументаDOM = ПолучитьЭлементУзлаDOM(ЭлементСвЛицПерДокументаDOM, "ИнЛицо");
	Если НЕ ЭлементИнЛицоДокументаDOM = Неопределено Тогда
		// Если типовая процедура сама создала этот узел, уничтожаем его.
		ЭлементСвЛицПерДокументаDOM.УдалитьДочерний(ЭлементИнЛицоДокументаDOM);
	КонецЕсли;
	ЭлементРабОргПродДокументаDOM = ПолучитьЭлементУзлаDOM(ЭлементСвЛицПерДокументаDOM, "РабОргПрод");
	Если НЕ ЭлементРабОргПродДокументаDOM = Неопределено Тогда
		// Если типовая процедура сама создала этот узел, уничтожаем его.
		ЭлементСвЛицПерДокументаDOM.УдалитьДочерний(ЭлементРабОргПродДокументаDOM);
	КонецЕсли;
	ЭлементРабОргПродДокументаDOM = ДокументDOM.СоздатьЭлемент("РабОргПрод");
	ЭлементРабОргПродДокументаDOM.УстановитьАтрибут("Должность", ДанныеПодписанта.Должность);
	// Создаем и заполняем узел ФИО.
	ЭлементФИОДокументаDOM = ДокументDOM.СоздатьЭлемент("ФИО");
	ЭлементФИОДокументаDOM.УстановитьАтрибут("Фамилия", ДанныеПодписанта.Фамилия);
	ЭлементФИОДокументаDOM.УстановитьАтрибут("Имя", ДанныеПодписанта.Имя);
	Если ЗначениеЗаполнено(ДанныеПодписанта.Отчество) Тогда
		ЭлементФИОДокументаDOM.УстановитьАтрибут("Отчество", ДанныеПодписанта.Отчество);
	КонецЕсли;
	ЭлементРабОргПродДокументаDOM.ДобавитьДочерний(ЭлементФИОДокументаDOM);
	ЭлементСвЛицПерДокументаDOM.ДобавитьДочерний(ЭлементРабОргПродДокументаDOM);
		
	// Создаем и заполняем узел "Подписант".
	ЭлементПодписантДокументаDOM = ПолучитьЭлементУзлаDOM(ДокументDOM, "Подписант");
	Если НЕ ЭлементПодписантДокументаDOM = Неопределено Тогда
		// Если типовая процедура сама создала этот узел, уничтожаем его.
		ЭлементДокументДокументаDOM.УдалитьДочерний(ЭлементПодписантДокументаDOM);
	КонецЕсли;
	ЭлементПодписантДокументаDOM = ДокументDOM.СоздатьЭлемент("Подписант");
	ЭлементПодписантДокументаDOM.УстановитьАтрибут("ТипПодпис", ДанныеПодписанта.ТипПодпис);
	ЭлементПодписантДокументаDOM.УстановитьАтрибут("СпосПодтПолном", ДанныеПодписанта.СпосПодтПолном);
	ЭлементПодписантДокументаDOM.УстановитьАтрибут("Должн", ДанныеПодписанта.Должность);
	// Создаем и заполняем узел ФИО.
	ЭлементФИОДокументаDOM = ДокументDOM.СоздатьЭлемент("ФИО");
	ЭлементФИОДокументаDOM.УстановитьАтрибут("Фамилия", ДанныеПодписанта.Фамилия);
	ЭлементФИОДокументаDOM.УстановитьАтрибут("Имя", ДанныеПодписанта.Имя);
	Если ЗначениеЗаполнено(ДанныеПодписанта.Отчество) Тогда
		ЭлементФИОДокументаDOM.УстановитьАтрибут("Отчество", ДанныеПодписанта.Отчество);
	КонецЕсли;	
	
	// Узел "СвДоверЭл" 
	//Если ЮрФизЛицоИППодписант = "ФЛ" Тогда // И НЕ ФормированиеДляПредпросмотра = Истина Тогда
	//	ЭлементСвДоверЭлДокументаDOM = ДокументDOM.СоздатьЭлемент("СвДоверЭл");
	//	ЭлементСвДоверЭлДокументаDOM.УстановитьАтрибут("НомДовер", ДанныеПодписанта.МчдGUIDПодписанта);
	//	ЭлементСвДоверЭлДокументаDOM.УстановитьАтрибут("ДатаВыдДовер", ДатаНачалаДействияМЧДДляПомещенияВДокумент);
	//	ЭлементСвДоверЭлДокументаDOM.УстановитьАтрибут("ИдСистХран", ???);
	//КонецЕсли;
	
	// Помещаем узлы друг в друга и в документ.
	ЭлементПодписантДокументаDOM.ДобавитьДочерний(ЭлементФИОДокументаDOM);
	//Если ЮрФизЛицоИППодписант = "ФЛ" Тогда // И НЕ ФормированиеДляПредпросмотра = Истина Тогда
	//	ЭлементПодписантДокументаDOM.ДобавитьДочерний(ЭлементСвДоверЭлДокументаDOM);
	//КонецЕсли;
	ЭлементДокументДокументаDOM.ДобавитьДочерний(ЭлементПодписантДокументаDOM);
	
КонецПроцедуры

