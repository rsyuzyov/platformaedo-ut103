				ДанныеПодписанта.Вставить("ОблПолн", "5"); 
			КонецЕсли;	
			//Принимает значения:
			//0 - лицо, ответственное за подписание счетов-фактур |
			//1 - лицо, совершившее сделку, операцию |
			//2 - лицо, совершившее сделку, операцию и ответственное за ее оформление |
			//3 - лицо, ответственное за оформление свершившегося события |
			//4 - лицо, совершившее сделку, операцию и ответственное за подписание счетов-фактур |
			//5 - лицо, совершившее сделку, операцию и ответственное за ее оформление и за подписание счетов-фактур |
			//6 - лицо, ответственное за оформление свершившегося события и за подписание счетов-фактур
			
			Если НЕ ЮрФизЛицоИППодписант = "ФЛ" Тогда
				ДанныеПодписанта.Вставить("Статус", "1"); //Принимает значение:
				//1 - работник организации продавца товаров (работ, услуг, имущественных прав) |
				//2 - работник организации - составителя файла обмена информации продавца, если составитель файла обмена информации не является продавцом |
				//3 - работник иной уполномоченной организации |
				//4 - уполномоченное физическое лицо (в том числе индивидуальный предприниматель) 
			Иначе
				ДанныеПодписанта.Вставить("Статус", "1");
			КонецЕсли;	
		Иначе
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Заполните руководителя для организации: " + СтруктураОбмена.СтруктураЭД.Организация;
			Сообщение.Сообщить();
			Продолжить;
		КонецЕсли;	
				
		ЗавершитьЗаполнениеДокументаПродажи_1_8_DOM(ДокументDOM, СтруктураОбмена, ФорматВыгрузки, ДанныеПодписанта, ЮрФизЛицоИППодписант, ИнформацияПоОшибкамФормирования);
			
		
		ПараметрыЗаписи = Новый ПараметрыЗаписиXML("Windows-1251", "1.0", Истина, Истина);
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку(ПараметрыЗаписи); 
		ЗаписьDOM = Новый ЗаписьDOM;
		ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
		XML = ЗаписьXML.Закрыть();
		
		// Пространства имен не нужны. 
		УдалитьПространствоИменИзXML(XML, ФорматВыгрузки);
		
		ИнформацияПоОшибкамФормирования = Новый Массив;
		
		Если НЕ НастройкаРедактированияРезультата = Неопределено Тогда
			ПараметрыФормирования = Новый Структура();
			ОсновныеДанныеДокумента = Новый Структура();
			ОсновныеДанныеДокумента.Вставить("СсылкаНаДокумент", СтруктураОбмена.СтруктураЭД.Владелец);
			ОсновныеДанныеДокумента.Вставить("ФорматВыгрузки", ФорматВыгрузки);
			ПараметрыФормирования.Вставить("ОсновныеДанныеДокумента", ОсновныеДанныеДокумента);
			ПараметрыФормирования.Вставить("ИнформацияПоОшибкамФормирования", ИнформацияПоОшибкамФормирования);
			ОбработатьРезультатФормирования_DOM(XML, НастройкаРедактированияРезультата, ФорматВыгрузки, Кэш, СтруктураОбмена.СтруктураЭД.Владелец, ПараметрыФормирования);
		КонецЕсли;
		
		Если ИспользоватьПодписание Тогда
			ОбработкаПодписиФизлицаУспешна = ПоместитьВДокументИдентификаторДоверенностиФизлица_DOM(XML, ПараметрыАвторизацииИПодписания, ФорматВыгрузки, Кэш, ЮрФизЛицоИППодписант);
		КонецЕсли;	
			
		ДокументСодержитМарки = Ложь;
		ДокументСодержитДанныеПрослеживаемости = Ложь;
		//ДокументСодержитМарки = ДокументСодержитИнформациюПоМаркам(СтруктураОбмена.СтруктураЭД.Владелец);
		Если ДокументСодержитМарки = Ложь Тогда
			Если НЕ СтрНайти(XML, "СведПрослеж") = 0 Тогда
				ДокументСодержитМарки = Ложь;
				ДокументСодержитДанныеПрослеживаемости = Истина;
			ИначеЕсли НЕ СтрНайти(XML, "НомСредИдентТов") = 0 Тогда
				ДокументСодержитМарки = Истина;
			ИначеЕсли НЕ СтрНайти(XML, "НомСредИдентТовДо") = 0 Тогда
				ДокументСодержитМарки = Истина;
			ИначеЕсли НЕ СтрНайти(XML, "НомСредИдентТовПосле") = 0 Тогда
				ДокументСодержитМарки = Истина;	
			КонецЕсли;	
		КонецЕсли;
		
		Идентификатор1С = Строка(Новый УникальныйИдентификатор);
		ДатаДокумента = Формат(СтруктураОбмена.СтруктураЭД.Владелец.Дата, "ДФ=yyyyMMdd");
		ЭлементСвУчДокОборДокументаDOM = ПолучитьЭлементУзлаDOM(ДокументDOM, "СвУчДокОбор", СтруктураОбмена.СтруктураЭД.Владелец, ИнформацияПоОшибкамФормирования);
		ЭлементДокументДокументаDOM = ПолучитьЭлементУзлаDOM(ДокументDOM, "Документ", СтруктураОбмена.СтруктураЭД.Владелец, ИнформацияПоОшибкамФормирования);
		
		ИмяФайла = СоставитьИмяФайлаПоИдентификаторам_DOM(ЭлементСвУчДокОборДокументаDOM, ФорматВыгрузки, СтруктураОбмена.СтруктураЭД.Владелец, ДатаДокумента, Идентификатор1С, ДокументСодержитМарки, ДокументСодержитДанныеПрослеживаемости, ДокументСодержитДанныеПрослеживаемости, );
		
		Если ДокументСодержитМарки И СтрНайти(XML, "ИдФайл="""+ФорматВыгрузки+"MARK") = 0 Тогда
			XML = СтрЗаменить(XML, "ИдФайл="""+ФорматВыгрузки, "ИдФайл="""+ФорматВыгрузки+"MARK");
		КонецЕсли;
		
		Если ДокументСодержитДанныеПрослеживаемости И СтрНайти(XML, "ИдФайл="""+ФорматВыгрузки+"PROS") = 0 Тогда
			XML = СтрЗаменить(XML, "ИдФайл="""+ФорматВыгрузки, "ИдФайл="""+ФорматВыгрузки+"PROS");
		КонецЕсли;
		
		СостояниеДокумента 	= ПолучитьСтруктуруСостоянияДокумента();
		
		Если НЕ СоответствиеДокументФактура = Неопределено И НЕ СоответствиеДокументФактура.Получить(СтруктураОбмена.СтруктураЭД.Владелец) = Неопределено Тогда
			СостояниеДокумента.Ссылка 				= СоответствиеДокументФактура.Получить(СтруктураОбмена.СтруктураЭД.Владелец);
		Иначе
			СостояниеДокумента.Ссылка 				= СтруктураОбмена.СтруктураЭД.Владелец;
		КонецЕсли;	
		СостояниеДокумента.Выгрузка 				= XML;
		СостояниеДокумента.ФорматФормализованного	= ФорматВыгрузки;
		СостояниеДокумента.ИмяФайла 				= ИмяФайла; 
		СостояниеДокумента.Идентификатор1С			= Идентификатор1С;
		СостояниеДокумента.Подписант 				= ДанныеПодписанта;
		СостояниеДокумента.ОтправительСсылка		= СтруктураОбмена.СтруктураЭД.Организация;
		СостояниеДокумента.ПолучательСсылка			= СтруктураОбмена.СтруктураЭД.Контрагент;
		СостояниеДокумента.ИдентификаторОтправителя	= СтруктураОбмена.СтруктураЭД.Отправитель;
		СостояниеДокумента.ИдентификаторПолучателя	= СтруктураОбмена.СтруктураЭД.Получатель;
		
		Если ОбработкаПодписиФизлицаУспешна = Ложь Тогда
			СостояниеДокумента.ОшибкиФормирования = Истина;
			СостояниеДокумента.ОписанияОшибокФормирования = "Ошибка применения для подписания документа сертификата физлица. Проверьте настройки и корректность заполнения идентификатора доверенности физлица.";
		КонецЕсли;
		
		ВыгрузкаДокументов.Добавить(СостояниеДокумента);
		
		Если НЕ СостояниеДокумента.ОшибкиФормирования И НЕ НастройкаВыгрузкиДополнительныхОбъектов = Неопределено Тогда
			ДополнитьВыгрузкуДополнительнымиОбъектами(СтруктураОбмена.СтруктураЭД.Владелец, НастройкаВыгрузкиДополнительныхОбъектов, ВыгрузкаДокументов, Кэш, Конфигурация, ИнтеграцияКаталог, ИмяФайла, ИнформацияПоОшибкамФормирования);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИнформацияПоОшибкамФормирования.Количество() > 0 Тогда
		
		Для Каждого Ошибка из ИнформацияПоОшибкамФормирования Цикл 
			СостояниеДокумента 	= ПолучитьСтруктуруСостоянияДокумента();		
			СостояниеДокумента.Ссылка						= Ошибка.Документ;
			СостояниеДокумента.ФорматФормализованного		= ФорматВыгрузки;
			СостояниеДокумента.ОшибкиФормирования			= Истина;
			СостояниеДокумента.ОписанияОшибокФормирования	= Ошибка.ТекстОшибки;	
			ВыгрузкаДокументов.Добавить(СостояниеДокумента);
		КонецЦикла;
		
	КонецЕсли;	
	
	Возврат ВыгрузкаДокументов;
	
КонецФункции

Процедура ЗавершитьЗаполнениеДокументаПродажи_1_8_DOM(ДокументDOM, СтруктураОбмена, ФорматВыгрузки, ДанныеПодписанта, Знач ЮрФизЛицоИППодписант, ИнформацияПоОшибкамФормирования)
	
	Если ЮрФизЛицоИППодписант = "ФЛ" Тогда
		ЮрФизЛицоИППодписант = "ЮЛ";
	КонецЕсли;
	
	// Сведения об операторе и участниках ДО.
	ЭлементСвУчДокОборДокументаDOM = ПолучитьЭлементУзлаDOM(ДокументDOM, "СвУчДокОбор", СтруктураОбмена.СтруктураЭД.Владелец, ИнформацияПоОшибкамФормирования); 
	
	Для Каждого ДочернийЭлементDOM из ЭлементСвУчДокОборДокументаDOM.ДочерниеУзлы Цикл
		Если ДочернийЭлементDOM.ИмяУзла = "СвОЭДОтпр" Тогда
			ЭлементСвУчДокОборДокументаDOM.УдалитьДочерний(ДочернийЭлементDOM);
		КонецЕсли;	
	КонецЦикла;	
	
	ЭлементСвОЭДОтпрЭлементаСвУчДокОбор = ДокументDOM.СоздатьЭлемент("СвОЭДОтпр");
	ЭлементСвОЭДОтпрЭлементаСвУчДокОбор.УстановитьАтрибут("ИННЮЛ", "9715260691");
	ЭлементСвОЭДОтпрЭлементаСвУчДокОбор.УстановитьАтрибут("ИдЭДО", "2VO");
	ЭлементСвОЭДОтпрЭлементаСвУчДокОбор.УстановитьАтрибут("НаимОрг", "ООО &quot;Эвотор ОФД&quot;");
	ЭлементСвУчДокОборДокументаDOM.ДобавитьДочерний(ЭлементСвОЭДОтпрЭлементаСвУчДокОбор);
	
	// Создаем и заполняем узел "Подписант".
	ЭлементДокументДокументаDOM = ПолучитьЭлементУзлаDOM(ДокументDOM, "Документ", СтруктураОбмена.СтруктураЭД.Владелец, ИнформацияПоОшибкамФормирования);
	ЭлементПодписантДокументаDOM = ПолучитьЭлементУзлаDOM(ДокументDOM, "Подписант");
	Если НЕ ЭлементПодписантДокументаDOM = Неопределено Тогда
		// Если типовая процедура сама создала этот узел, уничтожаем его.
		ЭлементДокументДокументаDOM.УдалитьДочерний(ЭлементПодписантДокументаDOM);
	КонецЕсли;
	ЭлементПодписантДокументаDOM = ДокументDOM.СоздатьЭлемент("Подписант");
	ЭлементПодписантДокументаDOM.УстановитьАтрибут("ОблПолн", ДанныеПодписанта.ОблПолн);
	ЭлементПодписантДокументаDOM.УстановитьАтрибут("Статус", ДанныеПодписанта.Статус);
	ЭлементПодписантДокументаDOM.УстановитьАтрибут(?(ФорматВыгрузки = "DP_REZRUISP", "ОснПолнПодп", "ОснПолн"), ДанныеПодписанта.ОснПолн);		
	// Создаем и заполняем узел "ЮЛ"/"ИП"/"ФЛ".
	ЭлементЮЛИПФЛДокументаDOM = ДокументDOM.СоздатьЭлемент(ЮрФизЛицоИППодписант);
	Если ЮрФизЛицоИППодписант = "ЮЛ" Тогда
		ЭлементЮЛИПФЛДокументаDOM.УстановитьАтрибут("ИННЮЛ", ДанныеПодписанта.ИНН);
		ЭлементЮЛИПФЛДокументаDOM.УстановитьАтрибут("НаимОрг", ДанныеПодписанта.НаимОрг);
		ЭлементЮЛИПФЛДокументаDOM.УстановитьАтрибут("Должн", ДанныеПодписанта.Должность);
	Иначе
		ЭлементЮЛИПФЛДокументаDOM.УстановитьАтрибут("ИННФЛ", ДанныеПодписанта.ИНН);
	КонецЕсли;         
	// Создаем и заполняем узел ФИО.
	ЭлементФИОДокументаDOM = ДокументDOM.СоздатьЭлемент("ФИО");
	ЭлементФИОДокументаDOM.УстановитьАтрибут("Фамилия", ДанныеПодписанта.Фамилия);
	ЭлементФИОДокументаDOM.УстановитьАтрибут("Имя", ДанныеПодписанта.Имя);
	ЭлементФИОДокументаDOM.УстановитьАтрибут("Отчество", ДанныеПодписанта.Отчество);
	// Помещаем узлы друг в друга и в документ.
	ЭлементЮЛИПФЛДокументаDOM.ДобавитьДочерний(ЭлементФИОДокументаDOM);
	ЭлементПодписантДокументаDOM.ДобавитьДочерний(ЭлементЮЛИПФЛДокументаDOM);
	ЭлементДокументДокументаDOM.ДобавитьДочерний(ЭлементПодписантДокументаDOM);
	
КонецПроцедуры

// Для БЭД версий 1.9
Функция СформироватьЭДПоАлгоритмуБЭД_1_9_DOM(МассивДокументов, ФорматВыгрузки, Кэш, ПараметрыАвторизацииИПодписания, ИнтеграцияКаталог, ИспользоватьПодписание, СоответствиеДокументФактура = Неопределено, ТипЭД = "", КодФормата = "", НастройкаВыгрузкиДополнительныхОбъектов = Неопределено, НастройкаРедактированияРезультата = Неопределено, ОписаниеДополнительныхПараметров = Неопределено, ОписаниеДополнительныхПараметровЭлементаВыборки = Неопределено, ФункцияУПД = "", ФормированиеДляПредпросмотра)
	
	ЭтоДокументПродажи = Ложь;
	ЭтоДокументАктаСверки = Ложь;
	ЭтоДокументУПД503 = Ложь;
	ЭтоДокументСчетаНаОплату = Ложь;
	
	// Часть алгоритма соответствует "ЭлектронныеДокументыЭДО.СформироватьДанныеДокументовДляВыгрузки()"

	Конфигурация = ПолучитьОбъектНастройкиПоИмениМетаданных("Конфигурация", Кэш);

	ОбщийМодульИнтеграцияЭДО			= Вычислить("ИнтеграцияЭДО");
	ОбщийМодульСинхронизацияЭДО			= Вычислить("СинхронизацияЭДО");
	ОбщийМодульЭлектронныеДокументыЭДО	= Вычислить("ЭлектронныеДокументыЭДО");
	ОбщийМодульФорматыЭДО				= Вычислить("ФорматыЭДО");
	ОбщийМодульФорматыЭДОПовтИсп		= Вычислить("ФорматыЭДОПовтИсп");
	ОбщийМодульОбщегоНазначенияБЭДО		= Вычислить("ОбщегоНазначенияБЭД");
	
	СведенияОФорматахТекущейКонфигурации = ОбщийМодульФорматыЭДОПовтИсп.СведенияОФорматахЭлектронныхДокументовИзМакета();
	
	КонфигурацияПоддерживаетУПД_5_03 = Ложь;
	
	Если ЗначениеЗаполнено(КодФормата) Тогда
		Отбор = Новый Структура();
		Отбор.Вставить("ИдентификаторФормата", КодФормата);
		СтрокиФорматов = СведенияОФорматахТекущейКонфигурации.НайтиСтроки(Отбор);
		Если СтрокиФорматов.Количество() = 0 Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Формат "+КодФормата+" недоступен для текущей конфигурации 1С.";
			Сообщение.Сообщить();
			Возврат Новый Массив;	
		КонецЕсли;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТаблицаФорматов.ИдентификаторФормата КАК ИдентификаторФормата,
		               |	ТаблицаФорматов.Отключен КАК Отключен,
		               |	ТаблицаФорматов.ДатаНачалаДействия КАК ДатаНачалаДействия,
		               |	ТаблицаФорматов.ДатаОкончанияДействия КАК ДатаОкончанияДействия
		               |ПОМЕСТИТЬ ТаблицаФорматов
		               |ИЗ
		               |	&СведенияОФорматахТекущейКонфигурации КАК ТаблицаФорматов
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ТаблицаФорматов.ИдентификаторФормата КАК ИдентификаторФормата
		               |ИЗ
		               |	ТаблицаФорматов КАК ТаблицаФорматов
		               |ГДЕ
		               |	ТаблицаФорматов.ИдентификаторФормата ПОДОБНО &ФорматВыгрузки
		               |	И ТаблицаФорматов.Отключен = ЛОЖЬ
