// Функция составляет имя файла по идентификаторам участников ЭДО
Функция СоставитьИмяФайлаПоИдентификаторам_XDTO(СвУчДокОбор, ФорматВыгрузки, ДокументСсылка, ДатаОтправки, ИдентификаторДокумента, ДокументСодержитМарки = Ложь, ДокументСодержитДанныеПрослеживаемости = Ложь)
	
	// пока не добавлена маркировка
	//ON_NSCHFDOPPOKXXXX, где XXXX
	//это "MARK" - для товаров, подлежащих маркировке
	//это "PROS" - для товаров, подлежащих прослеживаемости
	//ИдентификаторДокумента = Строка(ДокументСсылка.УникальныйИдентификатор());
	//ИдентификаторДокумента = Новый УникальныйИдентификатор;
	
	Если ДокументСодержитДанныеПрослеживаемости И ДокументСодержитМарки Тогда
		ДокументСодержитМарки = Ложь;
	КонецЕсли;
	
	ИмяФайла = ФорматВыгрузки + ?(ДокументСодержитМарки = Истина, "MARK", ?(ДокументСодержитДанныеПрослеживаемости = Истина, "PROS", "")) + "_" + СвУчДокОбор.ИдПол + "_" + СвУчДокОбор.ИдОтпр + "_" + ДатаОтправки + "_" + ИдентификаторДокумента; 
	
	Возврат ИмяФайла;
	
КонецФункции

// Функция составляет имя файла по идентификаторам участников ЭДО
Функция СоставитьИмяФайлаПоИдентификаторам_DOM(СвУчДокОборDOM, ФорматВыгрузки, ДокументСсылка, ДатаОтправки, ИдентификаторДокумента, ЭтоДокументУПД503, Знач ДокументСодержитМарки = Ложь, Знач ДокументСодержитДанныеПрослеживаемости = Ложь, ИдентификаторОтправителя = "", ИдентификаторПолучателя= "")
	
	// пока не добавлена маркировка
	//ON_NSCHFDOPPOKXXXX, где XXXX
	//это "MARK" - для товаров, подлежащих маркировке
	//это "PROS" - для товаров, подлежащих прослеживаемости
	//ИдентификаторДокумента = Строка(ДокументСсылка.УникальныйИдентификатор());
	//ИдентификаторДокумента = Новый УникальныйИдентификатор;
	
	Если ДокументСодержитДанныеПрослеживаемости И ДокументСодержитМарки Тогда
		ДокументСодержитМарки = Ложь;
	КонецЕсли;
	
	Если ЭтоДокументУПД503 = Истина Тогда
		ДокументСодержитДанныеПрослеживаемости = Ложь;
		ДокументСодержитМарки = Ложь;
	КонецЕсли;	
	
	Если НЕ СвУчДокОборDOM = Неопределено Тогда
		ИмяФайла = ФорматВыгрузки + ?(ДокументСодержитМарки = Истина, "MARK", ?(ДокументСодержитДанныеПрослеживаемости = Истина, "PROS", "")) + "_" + СвУчДокОборDOM.Атрибуты.ПолучитьИменованныйЭлемент("ИдПол").Значение + "_" + СвУчДокОборDOM.Атрибуты.ПолучитьИменованныйЭлемент("ИдОтпр").Значение + "_" + ДатаОтправки + "_" + ИдентификаторДокумента; 
	Иначе
		ИмяФайла = ФорматВыгрузки + ?(ДокументСодержитМарки = Истина, "MARK", ?(ДокументСодержитДанныеПрослеживаемости = Истина, "PROS", "")) + "_" + ИдентификаторПолучателя + "_" + ИдентификаторОтправителя + "_" + ДатаОтправки + "_" + ИдентификаторДокумента; 
	КонецЕсли;	
		
	Возврат ИмяФайла;
	
КонецФункции

// Процедура добавляет свойства в 1С для управляемых форм
&НаСервере
Процедура ДобавитьСвойстваДляУправляемыхФорм(ХранениеИнформации1С) Экспорт
	// >>> ПАТЧ УТ 10.3: ДобавитьСвойстваДляУправляемыхФорм
	// Свойства ОФД_ЭДО_* заведены заранее в ПВХ СвойстваОбъектов; БСП-объекты
	// (ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения,
	//  Справочник.НаборыДополнительныхРеквизитовИСведений) в УТ 10.3 отсутствуют → no-op.
	Если ПолучитьВерсиюКонфигурации() = "УТ_10_3_" Тогда
		Возврат;
	КонецЕсли;
	// <<< ПАТЧ УТ 10.3    	
		
	НаименованиеИдентификаторДокумента	= ХранениеИнформации1С.ОФД_ЭДО_ИдентификаторДокумента.Наименование;
	НаименованиеИдентификаторУчастника	= ХранениеИнформации1С.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Наименование;
	НаименованиеСтатусДокумента 		= ХранениеИнформации1С.ОФД_ЭДО_СтатусДокумента.Наименование;
	
	ИдентификаторДокумента				= ХранениеИнформации1С.ОФД_ЭДО_ИдентификаторДокумента;
	ИдентификаторУчастника				= ХранениеИнформации1С.ОФД_ЭДО_ИдентификаторУчастникаЭДО;
	СтатусДокумента 					= ХранениеИнформации1С.ОФД_ЭДО_СтатусДокумента;
	
	МассивСвойств = Новый Массив(); 
	МассивСвойств.Добавить(ИдентификаторДокумента);
	МассивСвойств.Добавить(ИдентификаторУчастника);
	МассивСвойств.Добавить(СтатусДокумента);   
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаДляПоискаСвойствВ1С(); 
	
	Запрос.УстановитьПараметр("НаименованиеИдентификаторДокумента", НаименованиеИдентификаторДокумента);
	Запрос.УстановитьПараметр("НаименованиеИдентификаторУчастника", НаименованиеИдентификаторУчастника);
	Запрос.УстановитьПараметр("НаименованиеСтатусДокумента", 		НаименованиеСтатусДокумента);

	РезультатЗапроса 	= Запрос.Выполнить();
	ТаблицаЗначений 	= РезультатЗапроса.Выгрузить();
	
	// Новая база, необходимо добавить все свойства и записи
	Если ТаблицаЗначений.Количество() = 0 Тогда
		
		Для Каждого Свойство ИЗ МассивСвойств  Цикл
			
			СвойствоСсылка 	= ДобавитьСвойствоВ1С(Свойство.Путь, Свойство.Наименование, Свойство.Тип);  			
			СписокНаборов 	= Свойство.НаборыСвойств.ПолучитьСписок("Набор");
			ДобавитьНаборыДляСвойства(СвойствоСсылка, СписокНаборов);  
			
		КонецЦикла;          		
		
	// База не новая, необходимо проверить наличие всех записей из настроек
	Иначе
	    // Проверим наличие наборов для каждого свойства
		Для Каждого Свойство ИЗ МассивСвойств Цикл   
			
			// Свойство в 1С
			СвойствоСсылка = НайтиСвойствоВ1С(Свойство.Путь, Свойство.Наименование); 			
			Если Не ЗначениеЗаполнено(СвойствоСсылка) Тогда
				СвойствоСсылка = ДобавитьСвойствоВ1С(Свойство.Путь, Свойство.Наименование, Свойство.Тип); 
			КонецЕсли;
			
			// Находим в 1С наборы свойств соответвующие искомому свойству из настроек
			Отбор = Новый Структура();
			Отбор.Вставить("СвойствоНаименование", Свойство.Наименование);
			Строки = ТаблицаЗначений.НайтиСтроки(Отбор);
			
			// Наборы, которые должны быть
			СписокНеобходимыхНаборов = ХранениеИнформации1С[Свойство.Наименование].НаборыСвойств.ПолучитьСписок("Набор");
			
			// Определяем с помощью исключающего ИЛИ наборы, которые не добавлены в 1С
			Результат = ИсключающееИЛИ(СписокНеобходимыхНаборов, Строки);
			
			// Если массив пустой, значит все наборы есть в 1С
			Если Результат.Количество() <> 0 Тогда
				
				// Если массив не пустой, значит нужно добавить наборы, которых не хватает в 1С
				Для Каждого Элемент Из Результат Цикл
					ДобавитьНаборыДляСвойства(СвойствоСсылка, Элемент);
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли; 
	
	УстановитьПривилегированныйРежим(Ложь); 	
	
КонецПроцедуры

// Функция возвращает текст запроса для поиска свойств и наборов свойств в 1С
Функция ПолучитьТекстЗапросаДляПоискаСвойствВ1С() 
	
	ТекстЗапроса = 		
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДополнительныеРеквизитыИСведения.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ Свойства
		|ИЗ
		|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
		|ГДЕ
		|	(ДополнительныеРеквизитыИСведения.Заголовок = &НаименованиеИдентификаторДокумента
		|			ИЛИ ДополнительныеРеквизитыИСведения.Заголовок = &НаименованиеИдентификаторУчастника
		|			ИЛИ ДополнительныеРеквизитыИСведения.Заголовок = &НаименованиеСтатусДокумента)
		|	И ДополнительныеРеквизитыИСведения.ПометкаУдаления = ЛОЖЬ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НаборыДополнительныхРеквизитовИСведенийДополнительныеСведения.Свойство,
		|	НаборыДополнительныхРеквизитовИСведений.Ссылка КАК Ссылка,
		|	НаборыДополнительныхРеквизитовИСведений.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
		|	НаборыДополнительныхРеквизитовИСведенийДополнительныеСведения.Свойство.Наименование КАК СвойствоНаименование
		|ИЗ
		|	Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеСведения КАК НаборыДополнительныхРеквизитовИСведенийДополнительныеСведения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Свойства КАК Свойства
		|		ПО (Свойства.Ссылка = НаборыДополнительныхРеквизитовИСведенийДополнительныеСведения.Свойство)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НаборыДополнительныхРеквизитовИСведений КАК НаборыДополнительныхРеквизитовИСведений
		|		ПО НаборыДополнительныхРеквизитовИСведенийДополнительныеСведения.Ссылка = НаборыДополнительныхРеквизитовИСведений.Ссылка";

	
	Возврат ТекстЗапроса;
	
КонецФункции

// Функция исключающего или - необходима для того, чтобы найти различные элементы в массивах
Функция ИсключающееИЛИ(Массив1, Массив2)
	
	Результат        = Новый Массив;
	Повтор           = Новый Соответствие;
	
	Для Каждого Элемент Из Массив1 Цикл
		Повтор[Элемент.Наименование] = ?(Повтор[Элемент.Наименование] = Неопределено, Ложь, Истина);
	КонецЦикла;
	
	Для Каждого Элемент Из Массив2 Цикл
		Повтор[Элемент.ИмяПредопределенныхДанных] = ?(Повтор[Элемент.ИмяПредопределенныхДанных] = Неопределено, Ложь, Истина);
	КонецЦикла;
	
	Для Каждого Элемент Из Повтор Цикл
		Если НЕ Элемент.Значение Тогда
			Результат.Добавить(Элемент.Ключ)
		КонецЕсли
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции	

// Функция производит поиск свойства в плане видов характеристик по его наименованию
Функция НайтиСвойствоВ1С(ИмяПланаВидовХарактеристик, НаименованиеСвойства) Экспорт
	
	Свойство = ПланыВидовХарактеристик[ИмяПланаВидовХарактеристик].НайтиПоНаименованию(НаименованиеСвойства);
	
	Возврат Свойство;
	
КонецФункции

// Функция добавляет свойство в 1С
Функция ДобавитьСвойствоВ1С(ИмяПланаВидовХарактеристик, НаименованиеСвойства, Тип) Экспорт
	
    Элемент = ПланыВидовХарактеристик[ИмяПланаВидовХарактеристик].СоздатьЭлемент();
	
	Если Тип = "Число" Тогда
		Знак  = ДопустимыйЗнак.Неотрицательный;
		КЧ = Новый КвалификаторыЧисла(3, 0, Знак);
		Массив = Новый Массив;
		Массив.Добавить(Тип("Число")); 	
		ОписаниеТипа = Новый ОписаниеТипов(Массив,,,КЧ);			
	Иначе 
		КС = Новый КвалификаторыСтроки();
		Массив = Новый Массив;
		Массив.Добавить(Тип("Строка")); 	
		ОписаниеТипа = Новый ОписаниеТипов(Массив,,,,КС);		
	КонецЕсли;  
	
	Элемент.ТипЗначения = ОписаниеТипа;
	Элемент.Наименование = НаименованиеСвойства;
	Элемент.Заголовок = НаименованиеСвойства;	                                
	Элемент.ЭтоДополнительноеСведение = Истина;
	Элемент.Виден = Истина;
	Элемент.УстановитьНовыйКод();
	
	Элемент.Записать();
	
	Возврат Элемент.Ссылка;
	
КонецФункции

// Функция добавляет наборы в справочник
Процедура ДобавитьНаборыДляСвойства(Свойство, СписокНаборов)
	
	// Добавляем 1 набор
	Если ТипЗнч(СписокНаборов) = Тип("Строка") Тогда		
		
		Если НЕ Метаданные.Справочники.НаборыДополнительныхРеквизитовИСведений.ПолучитьИменаПредопределенных().Найти(СписокНаборов) = Неопределено Тогда
			НаборыДопРеквизитовИСведений = Справочники.НаборыДополнительныхРеквизитовИСведений[СписокНаборов].ПолучитьОбъект();
		Иначе
			НаборыДопРеквизитовИСведений = Справочники.НаборыДополнительныхРеквизитовИСведений.НайтиПоНаименованию(СписокНаборов);
			Если НаборыДопРеквизитовИСведений = Справочники.НаборыДополнительныхРеквизитовИСведений.ПустаяСсылка() Тогда 
				НаборыДопРеквизитовИСведений = Справочники.НаборыДополнительныхРеквизитовИСведений.СоздатьЭлемент();
				НаборыДопРеквизитовИСведений.Наименование = СписокНаборов;
				НаборыДопРеквизитовИСведений.Записать();
			Иначе
				НаборыДопРеквизитовИСведений = НаборыДопРеквизитовИСведений.ПолучитьОбъект();
			КонецЕсли;
		КонецЕсли;
		ДопРеквизит = НаборыДопРеквизитовИСведений.ДополнительныеСведения.Добавить();
		ДопРеквизит.Свойство = Свойство;
		НаборыДопРеквизитовИСведений.Записать();		
		
	// Иначе добавляем список наборов
	Иначе		
		Для Каждого Набор Из СписокНаборов Цикл 
			
			Если НЕ Метаданные.Справочники.НаборыДополнительныхРеквизитовИСведений.ПолучитьИменаПредопределенных().Найти(Набор.Наименование) = Неопределено Тогда
				НаборыДопРеквизитовИСведений = Справочники.НаборыДополнительныхРеквизитовИСведений[Набор.Наименование].ПолучитьОбъект();
			Иначе
				НаборыДопРеквизитовИСведений = Справочники.НаборыДополнительныхРеквизитовИСведений.НайтиПоНаименованию(Набор.Наименование);
				Если НаборыДопРеквизитовИСведений = Справочники.НаборыДополнительныхРеквизитовИСведений.ПустаяСсылка() Тогда 
					НаборыДопРеквизитовИСведений = Справочники.НаборыДополнительныхРеквизитовИСведений.СоздатьЭлемент();
					НаборыДопРеквизитовИСведений.Наименование = Набор.Наименование;
					НаборыДопРеквизитовИСведений.Записать();
				Иначе
					НаборыДопРеквизитовИСведений = НаборыДопРеквизитовИСведений.ПолучитьОбъект();
				КонецЕсли;
			КонецЕсли;	
			ДопРеквизит = НаборыДопРеквизитовИСведений.ДополнительныеСведения.Добавить();
			ДопРеквизит.Свойство = Свойство;
			НаборыДопРеквизитовИСведений.Записать();	
			
		КонецЦикла; 	
	КонецЕсли;
	
КонецПроцедуры

// Функция выполняет вызов общей функции из файла настроек (необходимо доработать, еще очень сырая) 
Функция ВызовОбщейФункции(ДанныеВыгрузки, ВызовОбщейФункции) 
	
	ВызовФункции = "";
	
	Если ВызовОбщейФункции.ТипОбъектаМетаданных = "ОбщийМодуль" Тогда
		
		ВызовФункции = ВызовФункции + ВызовОбщейФункции.Путь + "." + ВызовОбщейФункции.Наименование;
		
	КонецЕсли;
	
	Список = ВызовОбщейФункции.ПараметрыВызова.ПолучитьСписок("Параметр");
	ПараметрыВызова = Новый Соответствие;	
	
	Для Каждого Параметр из Список Цикл		
		// Не обязательный параметр
		Если Параметр.Порядок = "0" Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыВызова.Вставить(Параметр.Порядок, "ДанныеВыгрузки." + Параметр.Значение);
		
	КонецЦикла;    	

	ВызовФункции = ВызовФункции + "(";
	Счетчик = 1;
	Пока ПараметрыВызова[Строка(Счетчик)] <> Неопределено Цикл
		ВызовФункции = ВызовФункции + ПараметрыВызова[Строка(Счетчик)] + ?(Счетчик <> ПараметрыВызова.Количество(), ",","");
		Счетчик = Счетчик +1;
	КонецЦикла;
	ВызовФункции = ВызовФункции + ")";	                                                
	//Сообщить (ВызовФункции);
	Возврат Вычислить(ВызовФункции);
	
КонецФункции

// Функция костыля для удаления пространства имен
// Наш сервер не воспринимает XML с явно указанным пространством имен, XDTO же не может сфомрировать объект без указания пространства имен
// Как итог, после формирования XML вырезаем ножом объявление пространства имен
Функция УдалитьПространствоИменИзXML(XML, ПространствоИмен)

	XML = СтрЗаменить(XML, "СвУчДокОбор xmlns="""+ПространствоИмен+""""+Символы.ПС+"			xmlns:xs=""http://www.w3.org/2001/XMLSchema""", "СвУчДокОбор");
	XML = СтрЗаменить(XML, "Документ xmlns="""+ПространствоИмен+""""+Символы.ПС+"			xmlns:xs=""http://www.w3.org/2001/XMLSchema""", "Документ");
	XML = СтрЗаменить(XML, "СвУчДокОбор xmlns="""""+Символы.ПС+"		xmlns:xs=""http://www.w3.org/2001/XMLSchema""", "СвУчДокОбор");
	XML = СтрЗаменить(XML, "Документ xmlns="""""+Символы.ПС+"			xmlns:xs=""http://www.w3.org/2001/XMLSchema""", "Документ");
	XML = СтрЗаменить(XML, " xmlns=""" + ПространствоИмен + """", "");
	XML = СтрЗаменить(XML, "xmlns=""" + ПространствоИмен + """", "");
	XML = СтрЗаменить(XML, Символы.ПС+"			xmlns:xs=""http://www.w3.org/2001/XMLSchema""", "");
	XML = СтрЗаменить(XML, "xmlns=", "xmlns:xs=");
	XML = СтрЗаменить(XML, "xmlns:xs=""""", "");
	XML = СтрЗаменить(XML, "<xs:ТекстИнф", "<ТекстИнф"); 
	XML = СтрЗаменить(XML, "<anyType xmlns=""http://www.w3.org/2001/XMLSchema""", "<Файл xmlns:xs=""http://www.w3.org/2001/XMLSchema""");
	XML = СтрЗаменить(XML, "<anyType xmlns:xs=""http://www.w3.org/2001/XMLSchema""", "<Файл xmlns:xs=""http://www.w3.org/2001/XMLSchema""");
	XML = СтрЗаменить(XML, "</anyType>", "</Файл>");
	
	Возврат XML;
	
КонецФункции

// Функция разбивает строку по определенному разделителю и формирует массив из получившихся элементов
функция РазбитьСтрокуВМассив(Знач Строка, Разделитель) 
	
	МассивЭлементов = Новый Массив();
	ЕстьРазделитель = Истина;
	
	Пока ЕстьРазделитель И Строка <> "" И Разделитель <> "" Цикл
		Если Найти(Строка, Разделитель) = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Элемент = Сред(Строка, 1, Найти(Строка, Разделитель) - 1);
		МассивЭлементов.Добавить(Элемент);
		Строка = Сред(Строка, Найти(Строка, Разделитель) + 1);
		
	КонецЦикла;
	
	МассивЭлементов.Добавить(Строка);
	
	Возврат МассивЭлементов;
	
КонецФункции

// Функция получает ФИО из наименования
Функция ПолучитьФИОИзСтроки(ФИО, Наименование)
	
	Если Сред(Нрег(Наименование),1,3) = "ип " или Сред(Нрег(Наименование),1,3)="чп " Тогда
		Наименование = СокрЛП(Сред(Наименование,4));
	КонецЕсли;
	Если Сред(Нрег(Наименование),1,31) = "индивидуальный предприниматель " Тогда
		Наименование = СокрЛП(Сред(Наименование,32));
	КонецЕсли;
	Если Сред(Нрег(Наименование),1,8) = "адвокат " Тогда
		Наименование = СокрЛП(Сред(Наименование,9));
	КонецЕсли;
	Если Сред(Нрег(Наименование),1,9) = "нотариус " Тогда
		Наименование = СокрЛП(Сред(Наименование,10));
	КонецЕсли;
	Если Сред(Нрег(Наименование),1,50) = "предприниматель без образования юридического лица " Тогда
		Наименование = СокрЛП(Сред(Наименование,51));
	КонецЕсли;
	Если Сред(Нрег(Наименование),1,6) = "пбоюл " Тогда
		Наименование = СокрЛП(Сред(Наименование,7));
	КонецЕсли;
	Если Сред(Нрег(Наименование),1,16) = "предприниматель " Тогда
		Наименование = СокрЛП(Сред(Наименование,17));
	КонецЕсли;
	
	НаименованиеМассив = РазбитьСтрокуВМассив(Наименование, " ");
	
	ЗаполнитьОбязательныйЭлемент_XDTO (ФИО.Фамилия, ?(НаименованиеМассив.Количество() > 0, НаименованиеМассив[0], ""), "Фамилия");
	ЗаполнитьОбязательныйЭлемент_XDTO (ФИО.Имя, ?(НаименованиеМассив.Количество() >= 2, НаименованиеМассив[1], ""), "Имя");
	Отчество = "";
	
	Если НаименованиеМассив.Количество() >= 3 Тогда
		Для Счетчик = 2 по НаименованиеМассив.Количество() - 1 Цикл
			Отчество = Отчество + НаименованиеМассив[Счетчик] + " ";
		КонецЦикла;
		// Отчество не больше 60 символов
		//Отчество = Лев(Отчество, 60);
		ЗаполнитьНеОбязательныйЭлемент_XDTO(ФИО.Отчество, СокрЛП(Отчество));
	КонецЕсли;

	Возврат ФИО;
	
КонецФункции

// Функция получает ФИО из наименования
Функция ПолучитьСтруктуруФИОИзСтроки(Наименование)
	
	ФИО = Новый Структура;
	
	Если Сред(Нрег(Наименование),1,3) = "ип " или Сред(Нрег(Наименование),1,3)="чп " Тогда
		Наименование = СокрЛП(Сред(Наименование,4));
	КонецЕсли;
	Если Сред(Нрег(Наименование),1,31) = "индивидуальный предприниматель " Тогда
		Наименование = СокрЛП(Сред(Наименование,32));
	КонецЕсли;
	Если Сред(Нрег(Наименование),1,8) = "адвокат " Тогда
		Наименование = СокрЛП(Сред(Наименование,9));
	КонецЕсли;
	Если Сред(Нрег(Наименование),1,9) = "нотариус " Тогда
		Наименование = СокрЛП(Сред(Наименование,10));
	КонецЕсли;
	Если Сред(Нрег(Наименование),1,50) = "предприниматель без образования юридического лица " Тогда
		Наименование = СокрЛП(Сред(Наименование,51));
	КонецЕсли;
	Если Сред(Нрег(Наименование),1,6) = "пбоюл " Тогда
		Наименование = СокрЛП(Сред(Наименование,7));
	КонецЕсли;
	Если Сред(Нрег(Наименование),1,16) = "предприниматель " Тогда
		Наименование = СокрЛП(Сред(Наименование,17));
	КонецЕсли;
	
	НаименованиеМассив = РазбитьСтрокуВМассив(Наименование, " ");
	
	ФИО.Вставить("Фамилия", ?(НаименованиеМассив.Количество() > 0, НаименованиеМассив[0], ""));
	ФИО.Вставить("Имя", ?(НаименованиеМассив.Количество() >= 2, НаименованиеМассив[1], ""));
	Отчество = "";
	
	Если НаименованиеМассив.Количество() >= 3 Тогда
		Для Счетчик = 2 по НаименованиеМассив.Количество() - 1 Цикл
			Отчество = Отчество + НаименованиеМассив[Счетчик] + " ";
		КонецЦикла;
		// Отчество не больше 60 символов
		//Отчество = Лев(Отчество, 60);
	КонецЕсли;
	
	ФИО.Вставить("Отчество", Отчество);
	
	Возврат ФИО;
	
КонецФункции

// Функция возвращает ставку НДС строкой, приведенной к формату ФНС
Функция ПолучитьСтрокуСтавки(СтавкаНДС) 
	
	СтрокаСтавка = НРег(Строка(СтавкаНДС));
	
	Если Найти(СтрокаСтавка, "без ндс") Тогда
		Возврат "без НДС";
	КонецЕсли;
	
	Если Найти(СтрокаСтавка, "20/120") Тогда
		Возврат "20/120";
	КонецЕсли;
	
	Если Найти(СтрокаСтавка, "18/118") Тогда
		Возврат "18/118";
	КонецЕсли;
	
	Если Найти(СтрокаСтавка, "10/110") Тогда
		Возврат "10/110";
	КонецЕсли;
	
	Если Найти(СтрокаСтавка, "20") Тогда
		Возврат "20%";
	КонецЕсли;	
	
	Если Найти(СтрокаСтавка, "18") Тогда
		Возврат "18%";
	КонецЕсли;	
	
	Если Найти(СтрокаСтавка, "10") Тогда
		Возврат "10%";
	КонецЕсли;	
	
	Если Найти(СтрокаСтавка, "0") Тогда
		Возврат "0%";
	КонецЕсли;
	
	Если Найти(СтрокаСтавка, "ндс исчисляется налоговым агентом") Тогда
		Возврат "НДС исчисляется налоговым агентом"
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Процедура заполняет необязательный реквизит с проверкой заполнения 
Процедура ЗаполнитьНеобязательныйЭлемент_XDTO(Элемент, Значение) 
	
	Если ЗначениеЗаполнено(Значение) Тогда
		Попытка
			Элемент = Значение;
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;	
	КонецЕсли;
	
КонецПроцедуры

// Процедура заполняет обязательный реквизит с проверкой заполнения
// Пока просто спамит сообщением о заполнении, в дальнейшем надо сделать журнал с ошибками заполнения
Процедура ЗаполнитьОбязательныйЭлемент_XDTO(Элемент, Значение, ИмяРеквизита) 
	
	Если ЗначениеЗаполнено(Значение) Тогда
		Попытка
			Элемент = Значение; 			
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
	Иначе
		Сообщить("Заполните обязательный реквизит: "+ ИмяРеквизита);	
	КонецЕсли;
	
КонецПроцедуры

// Процедура заполняет необязательный реквизит с проверкой заполнения 
Процедура ЗаполнитьНеобязательныйАтрибут_DOM(Элемент, ИмяАтрибута, Значение) 
	
	Элемент.УстановитьАтрибут(ИмяАтрибута, Значение);
	
КонецПроцедуры

// Процедура заполняет обязательный реквизит с проверкой заполнения
// Пока просто спамит сообщением о заполнении, в дальнейшем надо сделать журнал с ошибками заполнения
Процедура ЗаполнитьОбязательныйАтрибут_DOM(Элемент, ИмяАтрибута, Значение, ИмяРеквизита) 
	
	Если ЗначениеЗаполнено(Значение) Тогда
		Элемент.УстановитьАтрибут(ИмяАтрибута, Значение);
	Иначе
		Сообщить("Заполните обязательный реквизит: "+ ИмяРеквизита);	
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПутьКАтрибутуЭлементу(НастройкаОбъектXDTO, ТипАтрибутЭлемент = Неопределено)
	
	Путь = Неопределено;
	
	Если ТипАтрибутЭлемент = "Атрибут" Тогда 
		Путь = ?(НЕ НастройкаОбъектXDTO.Свойства().Получить("ПутьКАтрибуту") = Неопределено, НастройкаОбъектXDTO.ПутьКАтрибуту, НастройкаОбъектXDTO.ПутьКАтрибутуЭлементу);
	ИначеЕсли ТипАтрибутЭлемент = "Элемент" Тогда	
		Путь = ?(НЕ НастройкаОбъектXDTO.Свойства().Получить("ПутьКЭлементу") = Неопределено, НастройкаОбъектXDTO.ПутьКЭлементу, НастройкаОбъектXDTO.ПутьКАтрибутуЭлементу);
	Иначе
		Путь = НастройкаОбъектXDTO.ПутьКАтрибутуЭлементу;	
	КонецЕсли;
	
	Возврат Путь;
	
КонецФункции	

// Функция вызывает стандартные алгоритмы 1С формирования представлений номеров документов для печати.
Функция ОбработатьНомерДокумента(НомерДокумента, ПрефиксКонфигурации, ИндексПодразделения = "")
	
	Если СтандартныеПодсистемыСервер.ВерсияБиблиотеки() > "3.0.3.154" Тогда
		НомерБезПрефикса = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(НомерДокумента);
	Иначе
		НомерБезПрефикса = ПрефиксацияОбъектовКлиентСервер.ПолучитьНомерНаПечать(НомерДокумента);
	КонецЕсли;	
	
	Если НЕ Найти(ПрефиксКонфигурации, "Розн") = 0 Тогда
		
		Если Лев(НомерБезПрефикса, 1) = "И" Тогда
			НомерБезПрефикса = Прав(НомерБезПрефикса, СтрДлина(НомерБезПрефикса)-1);
		КонецЕсли;
		
	Иначе
		
		ПозицияРазделителя = СтрНайти(НомерБезПрефикса, "-");
		Префикс = Лев(НомерБезПрефикса, ПозицияРазделителя);
		НомерБезПрефикса = Сред(НомерБезПрефикса, ПозицияРазделителя + 1);
		
		Если Лев(НомерБезПрефикса, 1) = "И" Тогда
			НомерБезПрефикса = Префикс + Сред(НомерБезПрефикса, 2);
		КонецЕсли;
		Если ЗначениеЗаполнено(ИндексПодразделения) Тогда
			НомерБезПрефикса = НомерБезПрефикса + "/" + ИндексПодразделения;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НомерБезПрефикса; 
	
КонецФункции	

// Функция формирует данные о ФИО руководителя организации, в соответствии со стандартной структурой данных конфигураций 1С.
Функция ПолучитьФИОРуководителяОрганизацииНаДату_Стандарт(Организация, Дата = Неопределено, ПрефиксКонфигурации)
	
	// >>> ПАТЧ УТ 10.3: подписант
	Если СтрНайти(ПрефиксКонфигурации, "УТ_10_3") > 0 Тогда
		ДанныеПодписантаУТ103 = Новый Структура("Фамилия, Имя, Отчество, Должность", "", "", "", "Индивидуальный предприниматель");
		ЗапросПодп = Новый Запрос(
			"ВЫБРАТЬ ЗС.Свойство.Наименование КАК Имя, ЗС.Значение КАК Значение
			|ИЗ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗС
			|ГДЕ ЗС.Объект = &Объект И ЗС.Свойство.Наименование ПОДОБНО ""ОФД_ОРГ_%""");
		ЗапросПодп.УстановитьПараметр("Объект", Организация);
		ВыборкаПодп = ЗапросПодп.Выполнить().Выбрать();
		Пока ВыборкаПодп.Следующий() Цикл
			ЗначениеСвойства = СокрЛП(Строка(ВыборкаПодп.Значение));
			Если ВыборкаПодп.Имя = "ОФД_ОРГ_Фамилия" Тогда
				ДанныеПодписантаУТ103.Фамилия = ЗначениеСвойства;
			ИначеЕсли ВыборкаПодп.Имя = "ОФД_ОРГ_Имя" Тогда
				ДанныеПодписантаУТ103.Имя = ЗначениеСвойства;
			ИначеЕсли ВыборкаПодп.Имя = "ОФД_ОРГ_Отчество" Тогда
				ДанныеПодписантаУТ103.Отчество = ЗначениеСвойства;
			ИначеЕсли ВыборкаПодп.Имя = "ОФД_ОРГ_Должность" И НЕ ПустаяСтрока(ЗначениеСвойства) Тогда
				ДанныеПодписантаУТ103.Должность = ЗначениеСвойства;
			КонецЕсли;
		КонецЦикла;
		// ⚠️ Фолбэк по наименованию годится ТОЛЬКО для ИП: у продавца-ЮЛ он резал
		//    «Общество с ограниченной ответственностью …» на слова и отдавал
		//    Фамилия="Общество" Имя="с" Отчество="ограниченной".
		ЭтоИПпоИНН = (СтрДлина(СокрЛП(Строка(Организация.ИНН))) = 12);
		Если ПустаяСтрока(ДанныеПодписантаУТ103.Фамилия) И ЭтоИПпоИНН Тогда
			// фолбэк: разбираем НаименованиеПолное вида «Индивидуальный предприниматель Ф И О»
			НаимПолное = СокрЛП(Строка(Организация.НаименованиеПолное));
			НаимПолное = СтрЗаменить(НаимПолное, "Индивидуальный предприниматель", "");
			НаимПолное = СтрЗаменить(НаимПолное, "ИНДИВИДУАЛЬНЫЙ ПРЕДПРИНИМАТЕЛЬ", "");
			НаимПолное = СокрЛП(СтрЗаменить(НаимПолное, "ИП", ""));
			ЧастиФИО = СтрРазделить(НаимПолное, " ", Ложь);
			Если ЧастиФИО.Количество() > 0 Тогда
				ДанныеПодписантаУТ103.Фамилия = ЧастиФИО[0];
			КонецЕсли;
			Если ЧастиФИО.Количество() > 1 Тогда
				ДанныеПодписантаУТ103.Имя = ЧастиФИО[1];
			КонецЕсли;
			Если ЧастиФИО.Количество() > 2 Тогда
				ДанныеПодписантаУТ103.Отчество = ЧастиФИО[2];
			КонецЕсли;
		КонецЕсли;
		// Должность по умолчанию в структуре — «Индивидуальный предприниматель»; для ЮЛ она неверна.
		Если НЕ ЭтоИПпоИНН И ДанныеПодписантаУТ103.Должность = "Индивидуальный предприниматель" Тогда
			ДанныеПодписантаУТ103.Должность = "Руководитель";
		КонецЕсли;
		Если ПустаяСтрока(ДанныеПодписантаУТ103.Фамилия) ИЛИ ПустаяСтрока(ДанныеПодписантаУТ103.Имя) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ДанныеПодписантаУТ103;
	КонецЕсли;
	// <<< ПАТЧ УТ 10.3: подписант
	
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДата();
	КонецЕсли;	
	
	ДанныеПодписанта = Неопределено;
	
	Если НЕ Найти(ПрефиксКонфигурации, "БУХ") = 0 Тогда
		СтруктураОтветственныхЛицОрганизацииПоДокументу = Вычислить("ОтветственныеЛицаБП.ОтветственныеЛица(Организация, Дата)");
	ИначеЕсли НЕ Найти(ПрефиксКонфигурации, "Розн") = 0 Тогда
		СтруктураОтветственныхЛицОрганизацииПоДокументу = Вычислить("ФормированиеПечатныхФормСервер.ОтветственныеЛицаОрганизаций(Организация, Дата)");
	Иначе
		СтруктураОтветственныхЛицОрганизацииПоДокументу = Вычислить("ОтветственныеЛицаСервер.ПолучитьОтветственныеЛицаОрганизации(Организация, Дата)");
	КонецЕсли;
	
	ЭтоФизЛицо = Ложь;
	Если НЕ Найти(ПрефиксКонфигурации, "БУХ") = 0 Тогда
		Если Организация.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
			ЭтоФизЛицо = Истина;
		КонецЕсли;	
	Иначе
		Если Организация.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель Тогда
			ЭтоФизЛицо = Истина;
		КонецЕсли;
	КонецЕсли;
	
	
	Если НЕ СтруктураОтветственныхЛицОрганизацииПоДокументу.Руководитель = Справочники.ФизическиеЛица.ПустаяСсылка() Тогда
		
		Если СтруктураОтветственныхЛицОрганизацииПоДокументу.РуководительДолжность = "" И НЕ ЭтоФизЛицо Тогда
			Возврат Неопределено;
		КонецЕсли;	
		
		ДанныеПодписанта = Новый Структура;
		Если НЕ ЭтоФизЛицо Тогда
			ДанныеПодписанта.Вставить("Должность", Строка(СтруктураОтветственныхЛицОрганизацииПоДокументу.РуководительДолжность));
		Иначе
			ДанныеПодписанта.Вставить("Должность", "Индивидуальный предприниматель");
		КонецЕсли;
		
		Если НЕ Метаданные.РегистрыСведений.Найти("ФИОФизическихЛиц") = Неопределено И НЕ Метаданные.РегистрыСведений.Найти("ФИОФизическихЛиц").ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			               |	ФИОФизическихЛицСрезПоследних.Фамилия,
			               |	ФИОФизическихЛицСрезПоследних.Имя,
			               |	ФИОФизическихЛицСрезПоследних.Отчество
			               |ИЗ
			               |	РегистрСведений.ФИОФизическихЛиц.СрезПоследних(&Дата, ФизическоеЛицо = &Руководитель) КАК ФИОФизическихЛицСрезПоследних";
			Запрос.УстановитьПараметр("Дата", Дата);
			Запрос.УстановитьПараметр("Руководитель", СтруктураОтветственныхЛицОрганизацииПоДокументу.Руководитель);
			Результат = Запрос.Выполнить();
			
			Если НЕ Результат.Пустой() Тогда
				Результат = Результат.Выбрать();
				Результат.Следующий();
				Если НЕ Результат.Фамилия = "" И НЕ Результат.Имя = "" Тогда
					ДанныеПодписанта.Вставить("Фамилия", Результат.Фамилия);
					ДанныеПодписанта.Вставить("Имя", Результат.Имя);
					ДанныеПодписанта.Вставить("Отчество", Результат.Отчество);
					Возврат ДанныеПодписанта;
				Конецесли;	
			КонецЕсли;	
			
		ИначеЕсли НЕ Метаданные.РегистрыСведений.Найти("ФИОФизЛиц") = Неопределено И НЕ Метаданные.РегистрыСведений.Найти("ФИОФизЛиц").ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			               |	ФИОФизЛицСрезПоследних.Фамилия,
			               |	ФИОФизЛицСрезПоследних.Имя,
			               |	ФИОФизЛицСрезПоследних.Отчество
			               |ИЗ
			               |	РегистрСведений.ФИОФизЛиц.СрезПоследних(&Дата, ФизЛицо = &Руководитель) КАК ФИОФизЛицСрезПоследних";
			Запрос.УстановитьПараметр("Дата", Дата);
			Запрос.УстановитьПараметр("Руководитель", СтруктураОтветственныхЛицОрганизацииПоДокументу.РуководительФизическоеЛицо);
			Результат = Запрос.Выполнить();
			
			Если НЕ Результат.Пустой() Тогда
				Результат = Результат.Выбрать();
				Результат.Следующий();
				Если НЕ Результат.Фамилия = "" И НЕ Результат.Имя = "" Тогда
					ДанныеПодписанта.Вставить("Фамилия", Результат.Фамилия);
					ДанныеПодписанта.Вставить("Имя", Результат.Имя);
					ДанныеПодписанта.Вставить("Отчество", Результат.Отчество);
					Возврат ДанныеПодписанта;
				Конецесли;	
			КонецЕсли;	
			
		КонецЕсли;
		
		ИнформацияОРуководителеВСтруктуре = Ложь;
		ИмяСуществуетИЗаполненоВСтруктуре = Ложь;
		ФамилияСуществуетИЗаполненоВСтруктуре = Ложь;
		ОтчествоСуществуетИЗаполненоВСтруктуре = Ложь;
		ФамилияИИмяЗаполненыВСтруктуре = Ложь;
		
		Если ТипЗнч(СтруктураОтветственныхЛицОрганизацииПоДокументу.Руководитель) = Тип("Структура") Тогда
			ИнформацияОРуководителеВСтруктуре = Истина;
			Если СтруктураОтветственныхЛицОрганизацииПоДокументу.Руководитель.Свойство("Имя") И ЗначениеЗаполнено(СтруктураОтветственныхЛицОрганизацииПоДокументу.Руководитель.Имя) Тогда 
				ИмяСуществуетИЗаполненоВСтруктуре = Истина;
			КонецЕсли;
			Если СтруктураОтветственныхЛицОрганизацииПоДокументу.Руководитель.Свойство("Фамилия") И ЗначениеЗаполнено(СтруктураОтветственныхЛицОрганизацииПоДокументу.Руководитель.Фамилия) Тогда 
				ФамилияСуществуетИЗаполненоВСтруктуре = Истина;
			КонецЕсли;
			Если СтруктураОтветственныхЛицОрганизацииПоДокументу.Руководитель.Свойство("Отчество") И ЗначениеЗаполнено(СтруктураОтветственныхЛицОрганизацииПоДокументу.Руководитель.Отчество) Тогда 
				ОтчествоСуществуетИЗаполненоВСтруктуре = Истина;
			КонецЕсли;
			Если ИмяСуществуетИЗаполненоВСтруктуре И ФамилияСуществуетИЗаполненоВСтруктуре Тогда 
				ФамилияИИмяЗаполненыВСтруктуре = Ложь;
			КонецЕсли;	
		КонецЕсли;	
			
		Если НЕ ИнформацияОРуководителеВСтруктуре ИЛИ НЕ ФамилияИИмяЗаполненыВСтруктуре Тогда 
			
			Если НЕ Найти(ПрефиксКонфигурации, "Розн") = 0 Тогда
				МассивФИО = СтрРазделить(СтруктураОтветственныхЛицОрганизацииПоДокументу.РуководительФизическоеЛицо.Наименование, " ");
			Иначе
				Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(СтруктураОтветственныхЛицОрганизацииПоДокументу.Руководитель)) Тогда
					МетаданныеРуководитель = СтруктураОтветственныхЛицОрганизацииПоДокументу.Руководитель.Метаданные();
					Если НЕ СтруктураОтветственныхЛицОрганизацииПоДокументу.Руководитель.Метаданные().Реквизиты.Найти("ФИО") = Неопределено Тогда
						МассивФИО = СтрРазделить(СтруктураОтветственныхЛицОрганизацииПоДокументу.Руководитель.ФИО, " ");
					Иначе
						МассивФИО = СтрРазделить(СтруктураОтветственныхЛицОрганизацииПоДокументу.Руководитель.Наименование, " ");
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
			Счетчик = 1;
			Отчество = "";
			Для Каждого ЭлементФИО из МассивФИО Цикл
				Если Счетчик = 1 Тогда
					Фамилия = ЭлементФИО;
				ИначеЕсли Счетчик = 2 Тогда
					Имя = ЭлементФИО;
				Иначе
					Отчество = Отчество + ЭлементФИО; 
				КонецЕсли;	
				Счетчик = Счетчик + 1;
			КонецЦикла;
			ДанныеПодписанта.Вставить("Фамилия", Фамилия);
			ДанныеПодписанта.Вставить("Имя", Имя);
			ДанныеПодписанта.Вставить("Отчество", Отчество);
			Возврат ДанныеПодписанта;
			
		Иначе
			
			Если ФамилияИИмяЗаполненыВСтруктуре = Истина Тогда
				
				ДанныеПодписанта.Вставить("Фамилия", СтруктураОтветственныхЛицОрганизацииПоДокументу.Руководитель.Фамилия);
				ДанныеПодписанта.Вставить("Имя", СтруктураОтветственныхЛицОрганизацииПоДокументу.Руководитель.Имя);
				ДанныеПодписанта.Вставить("Отчество", ?(ОтчествоСуществуетИЗаполненоВСтруктуре, СтруктураОтветственныхЛицОрганизацииПоДокументу.Руководитель.Отчество, ""));
				Возврат ДанныеПодписанта;
				
			КонецЕсли;
				
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДанныеПодписанта; 
	
КонецФункции	

// Функция формирует данные о ФИО руководителя организации, в соответствии с структурой данных конфигурации УНФ 1.6.
Функция ПолучитьФИОРуководителяОрганизацииНаДату_УНФ(Организация, Дата = Неопределено, ПрефиксКонфигурации)
	
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДата();
	КонецЕсли;	
	
	ДанныеПодписанта = Неопределено;
	
	ЭтоФизЛицо = Ложь;
	Если Организация.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
		ЭтоФизЛицо = Истина;
	КонецЕсли;
	
	РуководительОрганизацииФизЛицо = Вычислить("ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.Руководитель(Организация)");		
	
	Если НЕ РуководительОрганизацииФизЛицо = Справочники.ФизическиеЛица.ПустаяСсылка() Тогда
		
		Должность = Неопределено;
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Подписи.Должность.Наименование КАК Должность
		|ИЗ
		|	Справочник.Подписи КАК Подписи
		|ГДЕ
		|	НЕ Подписи.ПометкаУдаления
		|	И Подписи.ФизическоеЛицо = &ФизическоеЛицо
		|	И Подписи.Организация = &Организация";
		
		Запрос.УстановитьПараметр("ФизическоеЛицо", РуководительОрганизацииФизЛицо);
		Запрос.УстановитьПараметр("Организация", Организация);
		
		Попытка
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			Пока Выборка.Следующий() Цикл
				Должность = Выборка.Должность;
			КонецЦикла;	
		Исключение
			Должность = "Руководитель";
		КонецПопытки;
			
		ДанныеПодписанта = Новый Структура;
		Если НЕ ЭтоФизЛицо Тогда
			ДанныеПодписанта.Вставить("Должность", Должность);
		ИначеЕсли Должность = "Руководитель" Тогда 
			ДанныеПодписанта.Вставить("Должность", "Индивидуальный предприниматель");
		КонецЕсли;
		
		Если НЕ Метаданные.РегистрыСведений.Найти("ФИОФизЛиц") = Неопределено И НЕ Метаданные.РегистрыСведений.Найти("ФИОФизЛиц").ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			               |	ФИОФизЛицСрезПоследних.Фамилия,
			               |	ФИОФизЛицСрезПоследних.Имя,
			               |	ФИОФизЛицСрезПоследних.Отчество
			               |ИЗ
			               |	РегистрСведений.ФИОФизЛиц.СрезПоследних(&Дата, ФизЛицо = &Руководитель) КАК ФИОФизЛицСрезПоследних";
			Запрос.УстановитьПараметр("Дата", Дата);
			Запрос.УстановитьПараметр("Руководитель", РуководительОрганизацииФизЛицо);
			Результат = Запрос.Выполнить();
			
			Если НЕ Результат.Пустой() Тогда
				Результат = Результат.Выбрать();
				Результат.Следующий();
				Если НЕ Результат.Фамилия = "" И НЕ Результат.Имя = "" Тогда
					ДанныеПодписанта.Вставить("Фамилия", Результат.Фамилия);
					ДанныеПодписанта.Вставить("Имя", Результат.Имя);
					ДанныеПодписанта.Вставить("Отчество", Результат.Отчество);
					Возврат ДанныеПодписанта;
				Конецесли;	
			КонецЕсли;	
			
		Иначе
			
			МассивФИО = СтрРазделить(РуководительОрганизацииФизЛицо.Наименование, " ");
			
			Счетчик = 1;
			Отчество = "";
			Для Каждого ЭлементФИО из МассивФИО Цикл
				Если Счетчик = 1 Тогда
					Фамилия = ЭлементФИО;
				ИначеЕсли Счетчик = 2 Тогда
					Имя = ЭлементФИО;
				Иначе
					Отчество = Отчество + ЭлементФИО; 
				КонецЕсли;	
				Счетчик = Счетчик + 1;
			КонецЦикла;
			
			ДанныеПодписанта.Вставить("Фамилия", Фамилия);
			ДанныеПодписанта.Вставить("Имя", Имя);
			ДанныеПодписанта.Вставить("Отчество", Отчество);
			
			Возврат ДанныеПодписанта;
								
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДанныеПодписанта; 
	
КонецФункции

Функция ПолучитьСтруктуруХранения1С(Кэш = Неопределено) Экспорт
	
	Если Кэш = Неопределено Тогда
		Кэш = ШтатныйЗапуск();	
	КонецЕсли;	
	
	ИмяМетаданных = "Конфигурация";    
	
	Настройка = Кэш.НастройкиОбъект[Кэш.ПрефиксКонфигурации+ИмяМетаданных].ХранениеИнформации1С;
	
	СтрокаВызоваСвойствоИдентификатор 			= Настройка.ОФД_ЭДО_ИдентификаторДокумента.ТипОбъектаМетаданных + "." + 
	Настройка.ОФД_ЭДО_ИдентификаторДокумента.Путь + ".НайтиПоНаименованию(" + Символ(034) + 
	Настройка.ОФД_ЭДО_ИдентификаторДокумента.Наименование + Символ(034) + ")";
	
	СтрокаВызоваСвойствоСтатус					= Настройка.ОФД_ЭДО_СтатусДокумента.ТипОбъектаМетаданных + "." + 
	Настройка.ОФД_ЭДО_СтатусДокумента.Путь + ".НайтиПоНаименованию(" + Символ(034) + 
	Настройка.ОФД_ЭДО_СтатусДокумента.Наименование + Символ(034) + ")";
	
	СтрокаВызоваСвойствоИдентификаторУчастника	= Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.ТипОбъектаМетаданных + "." + 
	Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Путь + ".НайтиПоНаименованию(" + Символ(034) + 
	Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Наименование + Символ(034) + ")";
	
	СвойствоИдентификатор 				= Вычислить(СтрокаВызоваСвойствоИдентификатор);									
	СвойствоСтатус						= Вычислить(СтрокаВызоваСвойствоСтатус);
	СвойствоИдентификаторУчастника		= Вычислить(СтрокаВызоваСвойствоИдентификаторУчастника);
	
	СтруктураХранения1С = Новый Структура;
	СтруктураХранения1С.Вставить("СвойствоИдентификатор",			СвойствоИдентификатор);
	СтруктураХранения1С.Вставить("СвойствоСтатус",					СвойствоСтатус);
	СтруктураХранения1С.Вставить("СвойствоИдентификаторУчастника",	СвойствоИдентификаторУчастника);
	СтруктураХранения1С.Вставить("НаименованиеРегистра",			Настройка.Путь);
	
	Возврат СтруктураХранения1С;
	
КонецФункции

Функция ПолучитьТекущегоПользователя()
	
	Возврат Неопределено;
	
	Если НЕ Метаданные.ОбщиеМодули.Найти("ПользователиИнформационнойБазы") = Неопределено Тогда
		ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Иначе
		ТекущийПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	КонецЕсли;	
	
	Возврат ТекущийПользователь;
	
КонецФункции	

Функция СкопироватьКоллекцию(ВходящаяКоллекция)
	
	Если ТипЗнч(ВходящаяКоллекция) = Тип("Структура") Тогда
		НоваяКоллекция = Новый Структура;
	ИначеЕсли ТипЗнч(ВходящаяКоллекция) = Тип("Соответствие") Тогда
		НоваяКоллекция = Новый Соответствие;
	КонецЕсли;
	
	Для Каждого ЭлементКоллекции из ВходящаяКоллекция Цикл
		
		Если ТипЗнч(ЭлементКоллекции.Значение) = Тип("Структура") ИЛИ ТипЗнч(ЭлементКоллекции.Значение) = Тип("Соответствие") Тогда				
			Значение = СкопироватьКоллекцию(ЭлементКоллекции.Значение);			
			НоваяКоллекция.Вставить(ЭлементКоллекции.Ключ, Значение);	
		Иначе
			НоваяКоллекция.Вставить(ЭлементКоллекции.Ключ, ЭлементКоллекции.Значение);
		КонецЕсли;
		
    КонецЦикла;
	
	Возврат НоваяКоллекция;
	
КонецФункции

#Область ПроцедурыПолученияДанныхИФормированияXDTO

Функция СформироватьXDTOПоНастройке(Документ, ФорматВыгрузки, Фабрика, Настройка, ПараметрыФормирования)
	
	Если НЕ Настройка.ФорматВыгрузки = ФорматВыгрузки Тогда
		// Ошибка!            
		ТекстОшибки = "Формат выгружаемого документа не соответствует формату, указанному в файле настройки выгрузки.";
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить();
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("Документ", Документ);	
		СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
		ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
		Возврат Неопределено;
	КонецЕсли;
	
	ПакетXDTO = Фабрика.Пакеты.Получить(ФорматВыгрузки);	
	
	КорневойЭлементЭД = ПолучитьОбъектXDTO(Фабрика, ПакетXDTO, Настройка.ПравилаЗаполненияПоФормату.КорневойЭлемент.Имя);
	ПараметрыФормирования.Вставить("КорневойЭлементЭД", КорневойЭлементЭД);
	
	ИмяОсновнойВыборки = Настройка.ПолучениеДанныхДокументов.ИсточникДанных.ОсновныеДанныеДокумента.ОсновнаяВыборка;
	ДокументПоОсновнойВыборке = ПараметрыФормирования.ОсновныеДанныеДокумента[ИмяОсновнойВыборки].Ссылка;
	ПредставлениеИсточникаДанных = Строка(Документ);
	
	Для Каждого СвойствоXDTO из Настройка.ПравилаЗаполненияПоФормату.КорневойЭлемент.Свойства() Цикл
		
		Если СвойствоXDTO.Форма = ФормаXML.Атрибут Тогда
			Продолжить;                                   
		КонецЕсли;
		
		ОбъектXDTO = Настройка.ПравилаЗаполненияПоФормату.КорневойЭлемент[СвойствоXDTO.Имя]; 
	
		Если ОбъектXDTO.Тип = "Атрибут" Тогда
			ЗаполнитьАтрибутЭлемента(КорневойЭлементЭД, ОбъектXDTO, ПараметрыФормирования);
		ИначеЕсли ОбъектXDTO.Тип = "Элемент" Тогда
			ОбработатьВложенныйЭлемент(КорневойЭлементЭД, ОбъектXDTO, Фабрика, ПараметрыФормирования);
		КонецЕсли;	
		
	КонецЦикла;
	
	Если НЕ Настройка.ПравилаЗаполненияПоФормату.Свойства().Получить("ДополнительныеПроцедурыЗаполнения") = Неопределено Тогда
		Для Каждого СвойствоXDTO из Настройка.ПравилаЗаполненияПоФормату.ДополнительныеПроцедурыЗаполнения.Свойства() Цикл
			ДополнительнаяПроцедураОбъектXDTO = Настройка.ПравилаЗаполненияПоФормату.ДополнительныеПроцедурыЗаполнения[СвойствоXDTO.Имя];
			
			Если НЕ ДополнительнаяПроцедураОбъектXDTO.Свойства().Получить("УсловияВызоваПроцедуры") = Неопределено Тогда	
				УсловиеВыполнено = РезультатОбработкиУсловия(ДополнительнаяПроцедураОбъектXDTO, ПараметрыФормирования);
				Если УсловиеВыполнено = Ложь Тогда
					Продолжить;	
				КонецЕсли;	
			КонецЕсли; 
			
			ТекстПроцедуры = ДополнительнаяПроцедураОбъектXDTO.ТекстПроцедуры;
			XDTOВходящиеПараметры = ДополнительнаяПроцедураОбъектXDTO.ВходящиеПараметры;
			РезультатВыполненияПроцедуры = ПолучитьРезультатВыполненияКода(ТекстПроцедуры, "Булево", XDTOВходящиеПараметры, ДополнительнаяПроцедураОбъектXDTO.Имя, ПараметрыФормирования);
			Если РезультатВыполненияПроцедуры = Ложь ИЛИ РезультатВыполненияПроцедуры = Неопределено Тогда
				ТекстОшибки = "При формировании эл. документа "+Документ+" не удалось выполнить дополнительную процедуру """+ДополнительнаяПроцедураОбъектXDTO.Имя+""".";
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ТекстОшибки;
				Сообщение.Сообщить();
				СтруктураОшибки = Новый Структура;
				СтруктураОшибки.Вставить("Документ", Документ);	
				СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
				ПараметрыФормирования.ИнформацияПоОшибкамФормирования.Добавить(СтруктураОшибки);
				Продолжить;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
	
	Возврат КорневойЭлементЭД; 
	
КонецФункции	

// Функция получает универсальную выгрузку по документам
// Необходимо переписать на получение данных из запроса, запрос брать из файла настроек
// Возвращаемые значения:
// Массив структур 	- массив структур с данными для выгрузки документов
// ВНИМАНИЕ!!! Продумать что делать, если не удалось вернуть структуру докуемнтов!!!
Функция ПолучитьСтруктуруДанныхДокументовПоЗапросу(СписокДокументов, ОписаниеИсточника, ПрефиксКонфигурации, МассивОшибок) 
	
	Если ОписаниеИсточника.МетодПолученияДанных = "Запрос" Тогда 
		
		УстановитьПривилегированныйРежим(Истина);
		Запрос = Новый Запрос;
		Запрос.Текст = ОписаниеИсточника.ТекстЗапроса;
		
		ВерсияКонфигурации = Новый Структура;
		ВерсияКонфигурации.Вставить("ПодробнаяИнформация", Метаданные.ПодробнаяИнформация);
		ВерсияКонфигурации.Вставить("Версия", Метаданные.Версия);
		
		Если ТипЗнч(СписокДокументов) = Тип("ТаблицаЗначений") Тогда 
			МассивДокументов = СписокДокументов.ВыгрузитьКолонку("Ссылка");
		Иначе
			МассивДокументов = СписокДокументов;
		КонецЕсли;	
		Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
		
		Если НЕ ОписаниеИсточника.Свойства().Получить("ДополнительныеПараметрыЗапроса") = Неопределено Тогда
			Для Каждого XDTOПараметрСвойство из ОписаниеИсточника.ДополнительныеПараметрыЗапроса.Свойства() Цикл
				XDTOПараметр = ОписаниеИсточника.ДополнительныеПараметрыЗапроса[XDTOПараметрСвойство.Имя];
				МетодРасчетаЗначенияПараметра = XDTOПараметр.Источник.МетодРасчетаЗначения;
				ИмяПараметраЗапроса = XDTOПараметр.ИмяПараметра;
				ПараметрыФормирования = Новый Структура;
				ЗначениеПараметраЗапроса = РассчитатьЗначениеПоМетодуРасчета(XDTOПараметр, ПараметрыФормирования, МетодРасчетаЗначенияПараметра);
				Если ЗначениеПараметраЗапроса = Неопределено И НЕ МетодРасчетаЗначенияПараметра = "Неопределено" Тогда
					Возврат Неопределено;
				КонецЕсли;	
				Запрос.УстановитьПараметр(ИмяПараметраЗапроса, ЗначениеПараметраЗапроса);
			КонецЦикла;
		КонецЕсли;
				
		Результат = Запрос.ВыполнитьПакет();
		УстановитьПривилегированныйРежим(Ложь);
		
		РезультатыФормированияДанных = Новый Структура;
		ИмяОсновнойВыборки = ОписаниеИсточника.ОсновныеДанныеДокумента.ОсновнаяВыборка;
		
		Для Каждого СвойствоXDTO из ОписаниеИсточника.ОсновныеДанныеДокумента.Свойства() Цикл
			Если СвойствоXDTO.Форма = ФормаXML.Атрибут Тогда
				Продолжить;
			КонецЕсли;
			ОбъектXDTO = ОписаниеИсточника.ОсновныеДанныеДокумента[СвойствоXDTO.Имя];
			Если СвойствоXDTO.Имя = ИмяОсновнойВыборки Тогда
				ОсновнаяВыборка = Результат[Число(ОбъектXDTO.ПоложениеРезультата)].Выбрать();
				РезультатыФормированияДанных.Вставить(ОбъектXDTO.Имя, ОсновнаяВыборка);	
			Иначе	
				Если ОбъектXDTO.ТипЗначения = "ВыборкаИзРезультатаЗапроса" Тогда
					Данные = ОбработатьРезультатКакВыборкуПоГруппировкам(Результат[Число(ОбъектXDTO.ПоложениеРезультата)]);
					РезультатыФормированияДанных.Вставить(ОбъектXDTO.Имя, Данные);
				КонецЕсли;
				Если ОбъектXDTO.ТипЗначения = "ТаблицаЗначений" Тогда
					Данные = ОбработатьРезультатКакТабличнуюЧастьПоГруппировкам(Результат[Число(ОбъектXDTO.ПоложениеРезультата)]);
					РезультатыФормированияДанных.Вставить(ОбъектXDTO.Имя, Данные);
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;	
		
		Возврат РезультатыФормированияДанных;
		
	Иначе	
		
		ТекстОшибки = "Если вы видите это сообщение, проверьте параметр ""ПроизвольныйЗапрос"" в разделе ""ЗапросДанныхДокументов"" XML-файла настроек. Он должен принимать значения либо ""Истина"", либо ""Ложь"".";
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить();
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("Документ", Неопределено);	
		СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
		МассивОшибок.Добавить(СтруктураОшибки);
		Возврат Неопределено;
		
	КонецЕсли;	
			
КонецФункции

Функция ВычислитьДополнительнуюТаблицу(ОписаниеТаблицыОбъектXDTO, СписокДокументов, МассивОшибок)

	ДополнительнаяТаблица = Неопределено;
	
	Источник = ОписаниеТаблицыОбъектXDTO.ИсточникДанных;
	
	Если Источник.МетодПолученияДанных = "Запрос" Тогда
		ДополнительнаяТаблица = ПолучитьРезультатДополнительнойТаблицыПоЗапросу(ОписаниеТаблицыОбъектXDTO, ОписаниеТаблицыОбъектXDTO.ТипЗначения, СписокДокументов, МассивОшибок);
	КонецЕсли;	
	
	Если Источник.МетодПолученияДанных = "РезультатВыполненияКода" Тогда
		ДополнительнаяТаблица = ПолучитьРезультатДополнительнойТаблицыПоВыполнениюКода(ОписаниеТаблицыОбъектXDTO, ОписаниеТаблицыОбъектXDTO.ТипЗначения, СписокДокументов, МассивОшибок);
	КонецЕсли;
	
	Возврат ДополнительнаяТаблица; 
	
КонецФункции

Функция ПолучитьРезультатДополнительнойТаблицыПоЗапросу(ОписаниеТаблицыОбъектXDTO, ТипРезультата, СписокДокументов, МассивОшибок)
	
	ОписаниеИсточника = ОписаниеТаблицыОбъектXDTO.ИсточникДанных;
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст = ОписаниеИсточника.ТекстЗапроса;
	
	ВерсияКонфигурации = Новый Структура;
	ВерсияКонфигурации.Вставить("ПодробнаяИнформация", Метаданные.ПодробнаяИнформация);
	ВерсияКонфигурации.Вставить("Версия", Метаданные.Версия);
	
	Если ТипЗнч(СписокДокументов) = Тип("ТаблицаЗначений") Тогда 
		МассивДокументов = СписокДокументов.ВыгрузитьКолонку("Ссылка");
	Иначе
		МассивДокументов = СписокДокументов;
	КонецЕсли;	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	
	Если НЕ ОписаниеИсточника.Свойства().Получить("ПараметрыЗапроса") = Неопределено Тогда
		Для Каждого XDTOПараметрСвойство из ОписаниеИсточника.ПараметрыЗапроса.Свойства() Цикл
			XDTOПараметр = ОписаниеИсточника.ПараметрыЗапроса[XDTOПараметрСвойство.Имя];
			МетодРасчетаЗначенияПараметра = XDTOПараметр.Источник.МетодРасчетаЗначения;
			ИмяПараметраЗапроса = XDTOПараметр.ИмяПараметра;
			ПараметрыФормирования = Новый Структура;
			ЗначениеПараметраЗапроса = РассчитатьЗначениеПоМетодуРасчета(XDTOПараметр, ПараметрыФормирования, МетодРасчетаЗначенияПараметра);
			Если ЗначениеПараметраЗапроса = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;	
			Запрос.УстановитьПараметр(ИмяПараметраЗапроса, ЗначениеПараметраЗапроса);
		КонецЦикла;
	КонецЕсли;
	
	Попытка
		Результат = Запрос.Выполнить();
		Если Результат.Пустой() Тогда
			Возврат Неопределено;
		КонецЕсли;	
		Если ТипРезультата = "ТаблицаЗначений" Тогда
			Возврат Результат.Выгрузить();	
		ИначеЕсли ТипРезультата = "ВыборкаИзРезультатаЗапроса" Тогда
			Возврат Результат.Выбрать();
		Иначе
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Для результата дополнительной таблицы """+ОписаниеТаблицыОбъектXDTO.Имя+" указан неподдерживаемый тип."
					+Символы.ПС+"Допустимы только ""ТаблицаЗначений"" и ""ВыборкаИзРезультатаЗапроса""(без группировки)";
			Сообщение.Сообщить();
			Возврат Неопределено;
		КонецЕсли;	
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Произошла ошибка при вычислении дополнительной таблицы """+ОписаниеТаблицыОбъектXDTO.Имя+"""."
				+Символы.ПС+"Проверьте текст и параметры запроса.";
		Сообщение.Сообщить();
		Возврат Неопределено;
	КонецПопытки;	
	
КонецФункции

Функция ПолучитьРезультатДополнительнойТаблицыПоВыполнениюКода(ОписаниеТаблицыОбъектXDTO, ТипРезультата, СписокДокументов, МассивОшибок)
	
	ОписаниеИсточника = ОписаниеТаблицыОбъектXDTO.ИсточникДанных;
	XDTOВходящиеПараметры = ОписаниеИсточника.ВходящиеПараметры;
	ТекстКода = ОписаниеИсточника.ТекстФункции;
	
	РезультатВыполненияКода = Неопределено;
	ВходящиеПараметры = Новый Структура;
	
	Если ТипЗнч(СписокДокументов) = Тип("ТаблицаЗначений") Тогда 
		МассивДокументов = СписокДокументов.ВыгрузитьКолонку("Ссылка");
	Иначе
		МассивДокументов = СписокДокументов;
	КонецЕсли;	
	ВходящиеПараметры.Вставить("МассивДокументов", МассивДокументов);
	
	Для Каждого XDTOВходящийПараметрСвойство из XDTOВходящиеПараметры.Свойства() Цикл
		
		XDTOВходящийПараметр = XDTOВходящиеПараметры[XDTOВходящийПараметрСвойство.Имя];
		МетодРасчетаЗначенияПараметра = XDTOВходящийПараметр.Источник.МетодРасчетаЗначения;
		ПараметрыФормирования = Новый Структура;
		
		ИмяПараметра = XDTOВходящийПараметр.ИмяПараметра;
		ЗначениеВходящегоПараметра = РассчитатьЗначениеПоМетодуРасчета(XDTOВходящийПараметр, ПараметрыФормирования, МетодРасчетаЗначенияПараметра);
		
		Если ЗначениеВходящегоПараметра = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;	
		
		ВходящиеПараметры.Вставить(ИмяПараметра, ЗначениеВходящегоПараметра);
		
	КонецЦикла;
	
	Попытка	
		
		Выполнить(ТекстКода);
		
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст =	"При вычислении дополнительной таблицы """+ОписаниеТаблицыОбъектXDTO.Имя+""" посредством выполнения произвольного кода произошла ошибка."+Символы.ПС
							+"Проверьте текст кода на корректность."+Символы.ПС+"Текст кода:"+Символы.ПС+ТекстКода;
		Сообщение.Сообщить();
		Возврат Неопределено;	
		
	КонецПопытки;	
	
	Если НЕ ТипЗнч(РезультатВыполненияКода) = Тип(ТипРезультата) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст =	"При вычислении дополнительной таблицы """+ОписаниеТаблицыОбъектXDTO.Имя+""" через выполнение кода был получен результат с типом, не соответствующим ожидаемому."+Символы.ПС
							+"Тип результата: "+ТипЗнч(РезультатВыполненияКода)+". Ожидаемый тип:"+ТипРезультата+"."+Символы.ПС+"Текст кода:"+Символы.ПС+ТекстКода;
		Сообщение.Сообщить();
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Входящие параметры кода:";
		Сообщение.Сообщить();
		Для Каждого ВходящийПараметр из ВходящиеПараметры Цикл
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Параметр "+ВходящийПараметр.Ключ+" - значение: "+ВходящийПараметр.Значение+Символы.ПС;
			Сообщение.Сообщить();
		КонецЦикла;
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат РезультатВыполненияКода;	
	
КонецФункции

// Функция обрабатывает результат запроса по табличным частям документов
// Входные параметры:
// Результат запроса по табличным частям
//
// Выходные параметры:
// Соответствие, где Ключ - ссылка на документ, Значение - Выборка табличной части по документу
Функция ОбработатьРезультатКакТабличнуюЧастьПоГруппировкам(Результат) 
	
	// Группируем результат запроса по ссылке на документ
	ТаблицаРезультат = Результат.Выгрузить();
	
	МассивСсылок = ТаблицаРезультат.Скопировать();
	МассивСсылок.Свернуть("Ссылка");
	МассивСсылок = МассивСсылок.ВыгрузитьКолонку("Ссылка"); 
	
	Соответствие = Новый Соответствие;
	
	Для Каждого Ссылка из МассивСсылок Цикл
		Отбор = Новый Структура();
		Отбор.Вставить("Ссылка", Ссылка);
		СтрокиПоСсылке = ТаблицаРезультат.НайтиСтроки(Отбор);
		Соответствие.Вставить(Ссылка, СтрокиПоСсылке);
	КонецЦикла;
	
	Возврат Соответствие;	
	
КонецФункции

// Функция обрабатывает результат запроса по табличным частям документов
// Входные параметры:
// Результат запроса по табличным частям
//
// Выходные параметры:
// Соответствие, где Ключ - ссылка на документ, Значение - Выборка табличной части по документу
Функция ОбработатьРезультатКакВыборкуПоГруппировкам(Результат) 
	
	Соответствие = Новый Соответствие;
	
	// Группируем результат запроса по ссылке на документ
	ВыборкаПоДокументу = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
		Пока ВыборкаПоДокументу.Следующий() Цикл
			// Табличная часть конкретного документа
			ВыборкаПоСтрокам = ВыборкаПоДокументу.Выбрать();
			Если ВыборкаПоСтрокам.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;	
			Соответствие.Вставить(ВыборкаПоДокументу.Ссылка, ВыборкаПоСтрокам);
		КонецЦикла; 
			
	Возврат Соответствие;	
	
КонецФункции
                                              
Процедура ЗаполнитьАтрибутЭлемента(Элемент, АтрибутОбъектXDTO, ПараметрыФормирования, ПредставлениеИсточникаДанныхАтрибута = "")
	
	ЗначениеАтрибута = Неопределено;
	
	Если НЕ АтрибутОбъектXDTO.Свойства().Получить("ВариантыИсточника") = Неопределено Тогда
			
		Если Тип(АтрибутОбъектXDTO.ВариантыИсточника.Вариант) = Тип("СписокXDTO") Тогда
			
			Для Каждого ВариантXDTO из АтрибутОбъектXDTO.ВариантыИсточника.Вариант Цикл
				
				УсловиеВыполнено = РезультатОбработкиУсловия(ВариантXDTO, ПараметрыФормирования);
				
				Если УсловиеВыполнено = Истина Тогда
					ЗначениеАтрибута = РассчитатьЗначениеПоМетодуРасчета(ВариантXDTO, ПараметрыФормирования);
					Прервать;	
				КонецЕсли;
				
			КонецЦикла;	
			
		Иначе
			
			ВариантXDTO = АтрибутОбъектXDTO.ВариантыИсточника.Вариант;
			
			УсловиеВыполнено = РезультатОбработкиУсловия(ВариантXDTO, ПараметрыФормирования);
			
			Если УсловиеВыполнено = Истина Тогда
				ЗначениеАтрибута = РассчитатьЗначениеПоМетодуРасчета(ВариантXDTO, ПараметрыФормирования);	
			КонецЕсли
				
		КонецЕсли;
		
		Если ЗначениеАтрибута = Неопределено И НЕ АтрибутОбъектXDTO.ВариантыИсточника.Свойства().Получить("ВариантИсключение") = Неопределено Тогда
			ЗначениеАтрибута = РассчитатьЗначениеПоМетодуРасчета(АтрибутОбъектXDTO.ВариантыИсточника.ВариантИсключение, ПараметрыФормирования);
		КонецЕсли;	
		
	Иначе	
		
		Если НЕ АтрибутОбъектXDTO.Свойства().Получить("УсловияВыгрузкиУзла") = Неопределено Тогда	
			УсловиеВыполнено = РезультатОбработкиУсловия(АтрибутОбъектXDTO, ПараметрыФормирования);
			Если УсловиеВыполнено = Ложь Тогда
				Возврат;
			КонецЕсли;	
		КонецЕсли;
		ЗначениеАтрибута = РассчитатьЗначениеПоМетодуРасчета(АтрибутОбъектXDTO, ПараметрыФормирования);	
		
	КонецЕсли;	
	
	Если ТипЗнч(Элемент) = Тип("ОбъектXDTO") Тогда
		
		Если АтрибутОбъектXDTO.Обязательный = "Истина" Тогда
			ЗаполнитьОбязательныйЭлемент_XDTO(Элемент[АтрибутОбъектXDTO.Имя], ЗначениеАтрибута, ПредставлениеИсточникаДанныхАтрибута+" "+АтрибутОбъектXDTO.Имя);	
		ИначеЕсли АтрибутОбъектXDTO.Обязательный = "Ложь" Тогда 
			ЗаполнитьНеобязательныйЭлемент_XDTO(Элемент[АтрибутОбъектXDTO.Имя], ЗначениеАтрибута);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Элемент) = Тип("ДокументDOM") ИЛИ ТипЗнч(Элемент) = Тип("ЭлементDOM") Тогда
		
		Если АтрибутОбъектXDTO.Обязательный = "Истина" Тогда
			ЗаполнитьОбязательныйАтрибут_DOM(Элемент, АтрибутОбъектXDTO.Имя,  ЗначениеАтрибута, ПредставлениеИсточникаДанныхАтрибута+" "+АтрибутОбъектXDTO.Имя);	
		ИначеЕсли АтрибутОбъектXDTO.Обязательный = "Ложь" Тогда 
			ЗаполнитьНеобязательныйАтрибут_DOM(Элемент, АтрибутОбъектXDTO.Имя, ЗначениеАтрибута);
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры	
                                 
Процедура ЗаполнитьТекстЭлемента(Элемент, ТекстОбъектXDTO, ПараметрыФормирования, ПредставлениеИсточникаДанныхАтрибута = "")
	
	ЗначениеТекста = Неопределено;
	
	Если НЕ ТекстОбъектXDTO.Свойства().Получить("ВариантыИсточника") = Неопределено Тогда
			
		Если Тип(ТекстОбъектXDTO.ВариантыИсточника.Вариант) = Тип("СписокXDTO") Тогда
			
			Для Каждого ВариантXDTO из ТекстОбъектXDTO.ВариантыИсточника.Вариант Цикл
				
				УсловиеВыполнено = РезультатОбработкиУсловия(ВариантXDTO, ПараметрыФормирования);
				
				Если УсловиеВыполнено = Истина Тогда
					ЗначениеАтрибута = РассчитатьЗначениеПоМетодуРасчета(ВариантXDTO, ПараметрыФормирования);
					Прервать;	
				КонецЕсли;
				
			КонецЦикла;	
			
		Иначе
			
			ВариантXDTO = ТекстОбъектXDTO.ВариантыИсточника.Вариант;
			
			УсловиеВыполнено = РезультатОбработкиУсловия(ВариантXDTO, ПараметрыФормирования);
			
			Если УсловиеВыполнено = Истина Тогда
				ЗначениеАтрибута = РассчитатьЗначениеПоМетодуРасчета(ВариантXDTO, ПараметрыФормирования);	
			КонецЕсли
				
		КонецЕсли;
		
		Если ЗначениеТекста = Неопределено И НЕ ТекстОбъектXDTO.ВариантыИсточника.Свойства().Получить("ВариантИсключение") = Неопределено Тогда
			ЗначениеТекста = РассчитатьЗначениеПоМетодуРасчета(ТекстОбъектXDTO.ВариантыИсточника.ВариантИсключение, ПараметрыФормирования);
		КонецЕсли;	
		
	Иначе	
		
		Если НЕ ТекстОбъектXDTO.Свойства().Получить("УсловияВыгрузкиУзла") = Неопределено Тогда	
			УсловиеВыполнено = РезультатОбработкиУсловия(ТекстОбъектXDTO, ПараметрыФормирования);
			Если УсловиеВыполнено = Ложь Тогда
				Возврат;
			КонецЕсли;	
		КонецЕсли;
		ЗначениеТекста = РассчитатьЗначениеПоМетодуРасчета(ТекстОбъектXDTO, ПараметрыФормирования);
		
	КонецЕсли;	
	
	Если ТипЗнч(Элемент) = Тип("ОбъектXDTO") Тогда
		Если Элемент.Свойства().Получить(ТекстОбъектXDTO.Имя) = Неопределено ИЛИ НЕ ТипЗнч(Элемент[ТекстОбъектXDTO.Имя]) = Тип("СписокXDTO") Тогда
			ЭлементДанныхString = ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "string");
			ЭлементДанных = ФабрикаXDTO.Создать(ЭлементДанныхString, ЗначениеТекста);
			Элемент.Добавить(ФормаXML.Элемент, ПараметрыФормирования.ОсновныеДанныеДокумента.ФорматВыгрузки, ТекстОбъектXDTO.Имя, ЭлементДанных);   
		Иначе
				Элемент[ТекстОбъектXDTO.Имя].Добавить(ЗначениеТекста);
		КонецЕсли;	
	ИначеЕсли ТипЗнч(Элемент) = Тип("ЭлементDOM") ИЛИ ТипЗнч(Элемент) = Тип("ДокументDOM") Тогда
		ДокументDOM = Элемент.ДокументВладелец;
		УзелТекста = ДокументDOM.СоздатьЭлемент(ТекстОбъектXDTO.Имя);
		УзелТекста.ТекстовоеСодержимое = ЗначениеТекста;
		Элемент.ДобавитьДочерний(УзелТекста);
	КонецЕсли;	
		
КонецПроцедуры
                                   
Процедура ОбработатьВложенныйЭлемент(ЭлементРодитель, ОбъектXDTOПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента = "")
	
	Если НЕ ОбъектXDTOПоНастройке.Свойства().Получить("УсловияВыгрузкиУзла") = Неопределено Тогда	
		УсловиеВыполнено = РезультатОбработкиУсловия(ОбъектXDTOПоНастройке, ПараметрыФормирования);
		Если УсловиеВыполнено = Ложь Тогда
			Возврат;
		КонецЕсли;	
	КонецЕсли;	
	
	Если Тип(ЭлементРодитель) = Тип("ОбъектXDTO") Тогда
		ОбъектЭлемента = ПолучитьОбъектXDTO(Фабрика, ЭлементРодитель.Тип(), ОбъектXDTOПоНастройке.Имя);
	ИначеЕсли Тип(ЭлементРодитель) = Тип("ДокументDOM") ИЛИ Тип(ЭлементРодитель) = Тип("ЭлементDOM") Тогда
		СтруктураЗначениеИВладельцецDOM = ПолучитьЗначениеУзлаИВладельцаПоПути_DOM(ЭлементРодитель, ОбъектXDTOПоНастройке.Имя);
		ОбъектЭлемента = СтруктураЗначениеИВладельцецDOM.Владелец;
	КонецЕсли;	
	
	Для Каждого СвойствоXDTO из ОбъектXDTOПоНастройке.Свойства() Цикл
		
		Если СвойствоXDTO.Форма = ФормаXML.Атрибут ИЛИ СвойствоXDTO.Имя = "УсловияВыгрузкиУзла" Тогда
			Продолжить;                                   
		КонецЕсли;
		
		ОбъектXDTO = ОбъектXDTOПоНастройке[СвойствоXDTO.Имя]; 
				
		Если ОбъектXDTO.Тип = "Атрибут" Тогда
			ЗаполнитьАтрибутЭлемента(ОбъектЭлемента, ОбъектXDTO, ПараметрыФормирования);
		ИначеЕсли ОбъектXDTO.Тип = "Элемент" Тогда
			ОбработатьВложенныйЭлемент(ОбъектЭлемента, ОбъектXDTO, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
		ИначеЕсли ОбъектXDTO.Тип = "Параметр" Тогда
			ЗаполнитьПараметрЭлемента(ОбъектЭлемента, ОбъектXDTO, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
		ИначеЕсли ОбъектXDTO.Тип = "Текст" Тогда
			ЗаполнитьТекстЭлемента(ЭлементРодитель, ОбъектXDTO, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);	
			Возврат; 	
		ИначеЕсли ОбъектXDTO.Тип = "МассивПоИсточнику" Тогда
			ЗаполнитьМассивЭлементаПоИсточнику(ОбъектЭлемента, ОбъектXDTO, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
		ИначеЕсли ОбъектXDTO.Тип = "Массив" Тогда
			ЗаполнитьМассивЭлемента(ОбъектЭлемента, ОбъектXDTO, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
		КонецЕсли;	
		
	КонецЦикла;
	
	Если ТипЗнч(ЭлементРодитель[ОбъектXDTOПоНастройке.Имя]) = Тип("СписокXDTO") Тогда
		ЭлементРодитель[ОбъектXDTOПоНастройке.Имя].Добавить(ОбъектЭлемента);
	Иначе	
		ЭлементРодитель[ОбъектXDTOПоНастройке.Имя] = ОбъектЭлемента;
	КонецЕсли;	
		
КонецПроцедуры	
                                    
Процедура ЗаполнитьПараметрЭлемента(Элемент, ПараметрОбъектXDTO, ПараметрыФормирования, ПредставлениеИсточникаДанныхАтрибута = "")
	
	Если НЕ ПараметрОбъектXDTO.Свойства().Получить("УсловияВыгрузкиУзла") = Неопределено Тогда	
		УсловиеВыполнено = РезультатОбработкиУсловия(ПараметрОбъектXDTO, ПараметрыФормирования);
		Если УсловиеВыполнено = Ложь Тогда
			Возврат;
		КонецЕсли;	
	КонецЕсли;
		
	ЗначениеПараметра = Неопределено;
	
	ЗначениеПараметра = РассчитатьЗначениеПоМетодуРасчета(ПараметрОбъектXDTO, ПараметрыФормирования);	
	
	Если ПараметрОбъектXDTO.Обязательный = "Истина" Тогда
		ЗаполнитьОбязательныйЭлемент_XDTO(Элемент[ПараметрОбъектXDTO.Имя], ЗначениеПараметра, ПредставлениеИсточникаДанныхАтрибута+" "+ПараметрОбъектXDTO.Имя);	
	ИначеЕсли ПараметрОбъектXDTO.Обязательный = "Ложь" Тогда 
		ЗаполнитьНеобязательныйЭлемент_XDTO(Элемент[ПараметрОбъектXDTO.Имя], ЗначениеПараметра);
	КонецЕсли;	
		
КонецПроцедуры
                                             
Процедура ЗаполнитьМассивЭлементаПоИсточнику(ЭлементРодитель, ОбъектXDTOМассиваПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента = "")
	
	Если НЕ ОбъектXDTOМассиваПоНастройке.Свойства().Получить("УсловияВыгрузкиУзла") = Неопределено Тогда	
		УсловиеВыполнено = РезультатОбработкиУсловия(ОбъектXDTOМассиваПоНастройке, ПараметрыФормирования);
		Если УсловиеВыполнено = Ложь Тогда
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	
	Если ОбъектXDTOМассиваПоНастройке.ИсточникДанныхДляМассива.Свойства().Получить("Источник") = Неопределено Тогда 
		ИсточникДанныхДляМассива = ПолучитьЗначениеИзПодготовленныхДанных(ОбъектXDTOМассиваПоНастройке.ИсточникДанныхДляМассива.ПутьКИсточнику, ОбъектXDTOМассиваПоНастройке.ИсточникДанныхДляМассива.ТипИсточника, ОбъектXDTOМассиваПоНастройке.Имя, ПараметрыФормирования);	
	Иначе
		ИсточникДанныхДляМассива = РассчитатьЗначениеПоМетодуРасчета(ОбъектXDTOМассиваПоНастройке.ИсточникДанныхДляМассива, ПараметрыФормирования);
	КонецЕсли;	
		
	Если ИсточникДанныхДляМассива = Неопределено Тогда
		// Ошибка!
		Возврат;
	КонецЕсли;	
	
	Если ТипЗнч(ЭлементРодитель) = Тип("ОбъектXDTO") Тогда
		
		#Область XDTO
		
		СписокXDTOМассива = ЭлементРодитель[ОбъектXDTOМассиваПоНастройке.Имя];
		
		Если ОбъектXDTOМассиваПоНастройке.ИсточникДанныхДляМассива.ТипИсточника = "ВыборкаИзРезультатаЗапроса" Тогда 
			
			СчетчикЭлементов = 1;
			Пока ИсточникДанныхДляМассива.Следующий() Цикл
				
				ПараметрыФормирования.Вставить("ИсточникДанныхДляМассива", ИсточникДанныхДляМассива);
				ПараметрыФормирования.Вставить("НомерОбрабатываемогоЭлемента", СчетчикЭлементов);
				
				ОбъектXDTOЭлементаМассива = ПолучитьОбъектXDTO(Фабрика, ЭлементРодитель.Тип(), ОбъектXDTOМассиваПоНастройке.Имя);
				
				Для Каждого СвойствоXDTOЭлементаМассиваПоНастройке из ОбъектXDTOМассиваПоНастройке.Свойства() Цикл
					
					Если СвойствоXDTOЭлементаМассиваПоНастройке.Форма = ФормаXML.Атрибут ИЛИ СвойствоXDTOЭлементаМассиваПоНастройке.Имя = "ИсточникДанныхДляМассива" Тогда
						Продолжить;	
					КонецЕсли;
					
					Если СвойствоXDTOЭлементаМассиваПоНастройке.Имя = "УсловияВыгрузкиУзла" Тогда
						Продолжить;
					КонецЕсли;
					
					ОбъектXDTOЭлементаМассиваПоНастройке = ОбъектXDTOМассиваПоНастройке[СвойствоXDTOЭлементаМассиваПоНастройке.Имя]; 
					
					Если ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Атрибут" Тогда
						ЗаполнитьАтрибутЭлемента(ОбъектXDTOЭлементаМассива, ОбъектXDTOЭлементаМассиваПоНастройке, ПараметрыФормирования);
					ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Элемент" Тогда
						ОбработатьВложенныйЭлемент(ОбъектXDTOЭлементаМассива, ОбъектXDTOЭлементаМассиваПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
					ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "Текст" Тогда
						ЗаполнитьТекстЭлемента(ОбъектXDTOЭлементаМассива, ОбъектXDTOЭлементаМассиваПоНастройке, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);	
					ИначеЕсли ОбъектXDTOЭлементаМассиваПоНастройке.Тип = "МассивПоИсточнику" Тогда
						ЗаполнитьМассивЭлементаПоИсточнику(ОбъектXDTOЭлементаМассива, ОбъектXDTOЭлементаМассиваПоНастройке, Фабрика, ПараметрыФормирования, ПредставлениеИсточникаДанныхЭлемента);
