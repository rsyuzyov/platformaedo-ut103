#Область ОбщиеПроцедурыФункции
// Блок экспортных процедур и функций, потенциально API-интерфейс внешней обработки

// Функция создает объект XDTO из XML по фабрике XDTO
//
// Входящие параметры
// XML - XML, которую требуется преобразовать в объект XDTO (ТипДанных: Строка)
// ФабрикаXDTO - фабрика, по которой необходимо разобрать XML в объект XDTO (ТипДанных: ФабрикаXDTO)
//
// Возвращаемые значения:
// ОбъектXDTO 	- объект XDTO, сериализованный из XML с помощью фабрики XDTO (ТипДанных: ОбъектXDTO)
Функция СоздатьОбъектXDTOИзXML(XML, ФабрикаXDTO) Экспорт
	
	// ВНИМАНИЕ! Вставить обработку исключения, если не получилось сериализовать XML с помощью переданной фабрики
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(XML);
	ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML); 	

	Возврат ОбъектXDTO;	
	
КонецФункции

// Функция создает фабрику XDTO по xsd схеме
//
// Входящие параметры
// XSD - XSD, которую требуется преобразовать в Фабрику XDTO (ТипДанных: Строка)
//
// Возвращаемые значения:
// ФабрикаXDTO 	- фабрика XDTO из XSD-схемы (ТипДанных: ФабрикаXDTO)
Функция СоздатьФабрикуXDTOИзXSD(XSD) Экспорт
	
	// Переводим xsd-схему шаблона в фабрику
	Файл = Новый ТекстовыйДокумент;
	Файл.ДобавитьСтроку(XSD);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xsd");
	Файл.Записать(ИмяВременногоФайла);
	Фабрика = СоздатьФабрикуXDTO(ИмяВременногоФайла);
	УдалитьФайлы(ИмяВременногоФайла);
	
	Возврат Фабрика;    
	
КонецФункции

// Функция получает объект XDTO по ссылке на документ
// Входящие значения:
// ДокументСсылка - документ, по которому требуется получить настроку
// Кэш 
//
// Возвращаемые значения:
// ОбъектXDTO 	- настройка для данного типа документов
// ВНИМАНИЕ!!! Продумать что делать, если не удалось вернуть настройку!!!
Функция ПолучитьОбъектНастройкиПоИмениМетаданных(ТипДокумента, Кэш) Экспорт
	
	Если Найти(ТипДокумента, Кэш.ПрефиксКонфигурации) > 0 Тогда
		ИмяНастройки = ТипДокумента;
	Иначе
		ИмяНастройки = "" + Кэш.ПрефиксКонфигурации + ТипДокумента;
	КонецЕсли;
	
	// Сначала смотрим, если в Кэш уже такой объект
	Если Кэш.НастройкиОбъект[ИмяНастройки] = Неопределено Тогда
		
		// Есть ли в Кэш уже распакованная настройка в виде XML
		Если Кэш.Настройки[ИмяНастройки] = Неопределено Тогда	
			
			// Если в Кэш настройки нет, то достаем настройку из хранилища общих настроек и кладем ее в Кэш для дальнейшего использования
			Настройка = ПолучитьНастройкуИзХранилищаОбщихНастроек(ИмяНастройки);
			Кэш.Настройки.Вставить(ИмяНастройки, Настройка);
			
		КонецЕсли;
		
		// Отловил. Глюк платформы.
		Если Кэш.ШаблонНастройки = Неопределено Тогда
			Кэш.Вставить("ШаблонНастройки", ПолучитьФабрикуНастроек());
		КонецЕсли;
		
		// Не смогла отловить глюк, иногда фабрика не сохраняется во временном хранилище настроек кэша
		Если ТипЗнч(Кэш.ШаблонНастройки) = Тип("Строка") Тогда
			Кэш.ШаблонНастройки = ПолучитьФабрикуНастроек();
		КонецЕсли;
				
		// Сериализуем объект настройки и добавляем его в Кэш
		Кэш.НастройкиОбъект.Вставить(ИмяНастройки, СоздатьОбъектXDTOИзXML(Кэш.Настройки[ИмяНастройки], Кэш.ШаблонНастройки));
		
		// Повторно развернем клиентские настройки
		МассивКлиентскихНастроек = ПолучитьСохраненныеКлиентскиеНастройки();
	
		Если Кэш.ШаблонНастройки = Неопределено Тогда
			Кэш.Вставить("ШаблонНастройки", ПолучитьФабрикуНастроек());
		КонецЕсли;
		
		Если НЕ МассивКлиентскихНастроек = Неопределено И ТипЗнч(МассивКлиентскихНастроек) = Тип("Массив") Тогда
			
			Для Каждого Элемент из МассивКлиентскихНастроек Цикл
				
				Если Элемент.Применять = Истина Тогда	
					// Сериализуем объект настройки и добавляем его в Кэш
					Кэш.НастройкиОбъект.Вставить(Элемент.ИмяФайлаНастройки, СоздатьОбъектXDTOИзXML(Элемент.ТекстНастройки, Кэш.ШаблонНастройки));
				КонецЕсли;	
					
			КонецЦикла;	
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Кэш.НастройкиОбъект[ИмяНастройки];
	
КонецФункции

// Функция получает фабрику XDTO по требуемому формату
// Входящие значения:
// Формат - формат для преобразования в фабрику (Тип данных: Строка)
// Кэш
//
// Возвращаемые значения:
// ФабрикаXDTO 	- фабрика для требуемого формата
// ВНИМАНИЕ!!! Продумать что делать, если не удалось вернуть фабрику!!!
Функция ПолучитьФабрикуФормата(Формат, Кэш) Экспорт
	
	//ИмяФабрики = Кэш.ПрефиксКонфигурации + ДокументСсылка.Метаданные().Имя;
	
	// Сначала смотрим, если в Кэш уже такая фабрика
	Если Кэш.ФорматыОбъект[Формат] = Неопределено Тогда
		
		// Есть ли в Кэш уже распакованная фабрика в виде XSD
		Если Кэш.Форматы[Формат] = Неопределено Тогда	
			
			// Если в Кэш настройки нет, то достаем настройку из хранилища общих настроек и кладем ее в Кэш для дальнейшего использования
			XSD = ПолучитьНастройкуИзХранилищаОбщихНастроек(Формат);
			Кэш.Форматы.Вставить(Формат, XSD);
			
		КонецЕсли;
		
		// Сериализуем объект настройки и добавляем его в Кэш
		Кэш.ФорматыОбъект.Вставить(Формат, СоздатьФабрикуXDTOИзXSD(Кэш.Форматы[Формат]));
		
	КонецЕсли;
	
	Возврат Кэш.ФорматыОбъект[Формат];
	
КонецФункции

// Функция получает объект XDTO по фабрике XDTO
Функция ПолучитьОбъектXDTO(Фабрика, Владелец, Имя, ЗначениеСвойства = "") Экспорт
    
    Если ТипЗнч(Владелец) = Тип("ПакетXDTO") Тогда
        СвойствоXDTO = Владелец.КорневыеСвойства.Получить(Имя);
    Иначе
        СвойствоXDTO = Владелец.Свойства.Получить(Имя);
	КонецЕсли;
	
	Если НЕ СвойствоXDTO = Неопределено Тогда
    	ТипXDTO = СвойствоXDTO.Тип;
	Иначе
		ТипXDTO = ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "anyType");
	КонецЕсли;
	
	Если  ТипЗнч(ТипXDTO) = Тип("ТипЗначенияXDTO") Тогда	
        ОбъектXDTO = Фабрика.Создать(ТипXDTO, ЗначениеСвойства);
    Иначе
        ОбъектXDTO = Фабрика.Создать(ТипXDTO);
    КонецЕсли;    
    Возврат ОбъектXDTO;
    
КонецФункции

// Функция получает комплексный объект XDTO по фабрике XDTO
Функция ПолучитьКомплексныйОбъектXDTO(Фабрика, ПространствоИмен, ТипОбъекта) Экспорт
    
	ТипОбъекта 	= Фабрика.Тип(ПространствоИмен, ТипОбъекта); 	
	
    Возврат Фабрика.Создать(ТипОбъекта);
    
КонецФункции

// Функция получает идентификатор участника ЭДО по ссылке на объект из регистра сведений
Функция ПолучитьИдентификаторЭДОПоСсылке(Ссылка, ХранениеИнформации1С, ИнтеграцияКаталог) Экспорт
	
	// Свойство в 1С 
	СвойствоСсылка = НайтиСвойствоВ1С(ХранениеИнформации1С.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Путь, ХранениеИнформации1С.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Наименование);    
	Если Не ЗначениеЗаполнено(СвойствоСсылка) Тогда
		СвойствоСсылка = ДобавитьСвойствоВ1С(ХранениеИнформации1С.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Путь, ХранениеИнформации1С.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Наименование, ХранениеИнформации1С.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Тип); 
	КонецЕсли;                                             
	
	НаборЗаписей = РегистрыСведений[ХранениеИнформации1С.Путь].СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(Ссылка);
	НаборЗаписей.Отбор.Свойство.Установить(СвойствоСсылка);       
	НаборЗаписей.Прочитать();
	
	// Не найдено Идентификатора ЭДО в базе
	Если НаборЗаписей.Количество() = 0 Тогда
		
		Если ИнтеграцияКаталог Тогда 	
			ДлинаИНН = СтрДлина(Ссылка.ИНН);
			Если ЗначениеЗаполнено(Ссылка.ИНН) и ((ДлинаИНН = 10 и ЗначениеЗаполнено(Ссылка.КПП))или ДлинаИНН>10) Тогда		
				НоваяЗаписьНабора = НаборЗаписей.Добавить();
				НоваяЗаписьНабора.Объект = Ссылка;
				НоваяЗаписьНабора.Свойство = СвойствоСсылка;
				НоваяЗаписьНабора.Значение = СоздатьИдентификаторЭДО(Ссылка);
				НаборЗаписей.Записать();				
			Иначе
				// невалидная запись 
				Возврат Неопределено;
			КонецЕсли;		
		Иначе			
			// невалидная запись 
			Возврат Неопределено;			
		КонецЕсли;
		
	Иначе		
		НоваяЗаписьНабора = НаборЗаписей.Получить(0);
	КонецЕсли;
	
	Возврат СокрЛП(Строка(НоваяЗаписьНабора.Значение));
	
КонецФункции

// Функция создает идентификатор ЭДО по данным ИНН\КПП (46 символов)
// Должна использоваться только в режиме работы каталог (придумать как установить это ограничении при написании модуля API)
Функция СоздатьИдентификаторЭДО(Ссылка) Экспорт
		
	Если ЭтоТестоваяОбработка Тогда
		// Тестовый
		Идентификатор = "2VO-";  
	Иначе	
		// Бой
		Идентификатор = "2VO-";
	КонецЕсли;
	
	ЮрФизЛицо = ?(СтрДлина(Ссылка.ИНН) = 10, "ЮЛ", "ИП");
	Идентификатор = Идентификатор + Ссылка.ИНН + "-";
	
	Если ЮрФизЛицо = "ЮЛ" Тогда  		
		Идентификатор = Идентификатор + Ссылка.КПП + "0000000000000000000000";   		
	КонецЕсли;
	
	Если ЮрФизЛицо = "ИП" Тогда  		
		Идентификатор = Идентификатор + "00000000000000000000000000000";   		
	КонецЕсли;
	
	Возврат Идентификатор;	
	
КонецФункции

// Функция выгружает документы одного типа 
// Входящие параметры
// МассивДокументов - список документов к выгрузке (ТипДанных: Массив со ссылками на документы одного типа)
// ТипВыгрузки - выходной формат выгружаемого документа
//
// Возвращаемые значения:
// Массив строк выгруженных xml-документов
Функция ВыгрузитьМассивДокументов(ТаблицаДокументов, Организация, ИмяНастройки = "", ФорматВыгрузки, Кэш, ФормированиеДляПредпросмотра = Ложь, ФункцияУПД = "") Экспорт 
	
	СистемнаяИнформация = Новый("СистемнаяИнформация");
	ВерсияПлатформы1С = СистемнаяИнформация.ВерсияПриложения;		
	СравнениеВерсийПлатформы_8_3_22 = ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияПлатформы1С, "8.3.21.9999");
	
	ИнформацияПоОшибкамФормирования = Новый Массив;
	
	ПараметрыФормирования = Новый Структура;
	ПараметрыФормирования.Вставить("ФорматВыгрузки", ФорматВыгрузки);                              
	ПараметрыФормирования.Вставить("ИнформацияПоОшибкамФормирования", ИнформацияПоОшибкамФормирования);
	
	ПараметрыАвторизацииИПодписанияОрганизации = Неопределено;
	
	Конфигурация = ПолучитьОбъектНастройкиПоИмениМетаданных("Конфигурация", Кэш); 
	
	Интеграция = ПолучитьИнтеграциюНаСервере();
	ИнтеграцияКаталог = Интеграция.СпособИнтеграции = 1;
	ИспользоватьПодписание = Ложь;
	
	Если Интеграция.Свойство("ПараметрыАвторизацииИПодписания") Тогда
		ПараметрыАвторизацииИПодписанияОрганизации = Интеграция.ПараметрыАвторизацииИПодписания.Получить(Организация);
		Если НЕ ПараметрыАвторизацииИподписанияОрганизации = Неопределено Тогда
			ИспользоватьПодписание = ?(ЗначениеЗаполнено(ПараметрыАвторизацииИподписанияОрганизации.ИспользуетсяПодписание), ПараметрыАвторизацииИподписанияОрганизации.ИспользуетсяПодписание, Ложь);
			Если ПараметрыАвторизацииИподписанияОрганизации.ИспользуетсяПодписание = Ложь тогда
				ПараметрыАвторизацииИподписанияОрганизации = Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ДокументыВМассиве = ТипЗнч(ТаблицаДокументов) = Тип("Массив");
	
	// Получаем универсальную структуру документов 
	Если НЕ ТипЗнч(ТаблицаДокументов) = Тип("Массив") Тогда	
		//Если НЕ СписокДокументов.Колонки.Найти("Фактура") = Неопределено Тогда
		//	СписокДокументов = СписокДокументов.Скопировать(, "Ссылка,Фактура");
		//Иначе
			СписокДокументов = ТаблицаДокументов.ВыгрузитьКолонку("Ссылка");
		//КонецЕсли;
	Иначе
		СписокДокументов = ТаблицаДокументов;
	КонецЕсли;	
	
	ТипДокумента = ?(НЕ ИмяНастройки = "", ИмяНастройки, ?(ДокументыВМассиве, СписокДокументов[0].Метаданные().Имя, СписокДокументов[0].Ссылка.Метаданные().Имя));
	Если ТипДокумента = "КорректировкаРеализации" И ФорматВыгрузки = "ON_NSCHFDOPPR" Тогда
		ТипДокумента = "ИсправлениеРеализации";
	КонецЕсли;	
	
	ВыгрузкаДокументов = Новый Массив; 
	
	Настройка = ПолучитьОбъектНастройкиПоИмениМетаданных(?(СтрНайти(ТипДокумента, ФорматВыгрузки)=0, ТипДокумента+"_"+ФорматВыгрузки, ТипДокумента), Кэш);
	
	Если НЕ Настройка.Свойства().Получить("ДополнительныеОбъектыНаОтправку") = Неопределено Тогда
		НастройкаВыгрузкиДополнительныхОбъектов = Настройка.ДополнительныеОбъектыНаОтправку;
	Иначе
		НастройкаВыгрузкиДополнительныхОбъектов = Неопределено;
	КонецЕсли;
	
	Если НЕ Настройка.Свойства().Получить("РедактированиеРезультата") = Неопределено Тогда
		НастройкаРедактированияРезультата = Настройка.РедактированиеРезультата;
	Иначе
		НастройкаРедактированияРезультата = Неопределено;
	КонецЕсли;
	
	// Если в настройке объявлены условия для отмены выгрузки, список документов перепроверяется.
	// Не удовлетворяющие условиям документы удаляются из списка.
	Если НЕ Настройка.Свойства().Получить("УсловияОтменыВыгрузки") = Неопределено Тогда
		УсловияОтменыВыгрузки = Настройка.УсловияОтменыВыгрузки; 
		СписокДокументов = ПроверитьСписокДокументовНаСоответствиеУсловиямОтменыВыгрузки(СписокДокументов, УсловияОтменыВыгрузки, ПараметрыФормирования);
	КонецЕсли;
	
	// Ни один документ не прошел проверку по условию.
	Если СписокДокументов.Количество() = 0 Тогда
		Возврат Неопределено;	
	КонецЕсли;	
		
	ПолучениеДанных = Настройка.ПолучениеДанныхДокументов;
	ОписаниеИсточникаДанных = ПолучениеДанных.ИсточникДанных;
	
	Если ОписаниеИсточникаДанных.МетодПолученияДанных = "АлгоритмБЭД" Тогда
				
		Если НЕ ПолучениеДанных.Свойства().Получить("ДополнительныеПараметры") = Неопределено Тогда
			ОписаниеДополнительныхПараметров = ПолучениеДанных.ДополнительныеПараметры;
		Иначе
			ОписаниеДополнительныхПараметров = Неопределено;
		КонецЕсли;
		
		Если НЕ ПолучениеДанных.Свойства().Получить("ДополнительныеПараметрыЭлементаВыборки") = Неопределено Тогда
			ОписаниеДополнительныхПараметровЭлементаВыборки = ПолучениеДанных.ДополнительныеПараметрыЭлементаВыборки;
		Иначе
			ОписаниеДополнительныхПараметровЭлементаВыборки = Неопределено;
		КонецЕсли;
		
		// Вызов стандартной процедуры формирования ЭД из БЭД.
		СравнениеВерсииБЭД_1_9 = ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ОбновлениеИнформационнойБазыБЭД.ВерсияБиблиотеки(), "1.9.0.0");
		
		МассивДокументов = СписокДокументов;
		СоответствиеДокументФактура = Новый Соответствие;
		Если ТипЗнч(ТаблицаДокументов) = Тип("ТаблицаЗначений") И НЕ ТаблицаДокументов.Колонки.Найти("Фактура") = Неопределено Тогда
			Для Каждого Строка из ТаблицаДокументов Цикл
				Если НЕ Строка.Фактура = Null И НЕ Строка.Фактура = Неопределено И ЗначениеЗаполнено(Строка.Фактура) Тогда
					СоответствиеДокументФактура.Вставить(Строка.Ссылка, Строка.Фактура);
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;	
		
		ТипЭД = "";
		Если НЕ ОписаниеИсточникаДанных.Свойства().Получить("ТипЭД") = Неопределено Тогда
			ТипЭД = ОписаниеИсточникаДанных.ТипЭД; 
		КонецЕсли;
		
		КодФормата = "";
