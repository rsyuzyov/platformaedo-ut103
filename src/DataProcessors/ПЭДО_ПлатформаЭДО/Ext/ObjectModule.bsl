Функция ПолучитьИдентификаторыДокументовИз1С(МассивДокументов, СвойствоИдентификатор) Экспорт
		
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СчетФактураВыданныйДокументыОснования.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ СчетаФактуры
	               |ИЗ
	               |	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	               |ГДЕ
	               |	СчетФактураВыданныйДокументыОснования.ДокументОснование В(&МассивОбъектов)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДополнительныеСведения.Объект КАК Ссылка,
	               |	ДополнительныеСведения.Значение КАК Значение
	               |ИЗ
	               |	РегистрСведений.ЗначенияСвойствОбъектов КАК ДополнительныеСведения
	               |ГДЕ
	               |	ДополнительныеСведения.Объект В(&МассивОбъектов)
	               |	И ДополнительныеСведения.Свойство = &СвойствоИдентификатор
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ДополнительныеСведения.Объект,
	               |	ДополнительныеСведения.Значение
	               |ИЗ
	               |	СчетаФактуры КАК СчетаФактуры
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ДополнительныеСведения
	               |		ПО СчетаФактуры.Ссылка = ДополнительныеСведения.Объект
	               |ГДЕ
	               |	ДополнительныеСведения.Свойство = &СвойствоИдентификатор";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивДокументов);
	Запрос.УстановитьПараметр("СвойствоИдентификатор", СвойствоИдентификатор);
	Результат = Запрос.Выполнить().Выбрать();
	
	ИдентификаторыДокументов = Новый Соответствие;
	
	Пока Результат.Следующий() Цикл 
		
		ИдентификаторыДокументов.Вставить(Результат.Ссылка, Результат.Значение);
		
	КонецЦикла;
	
	Возврат ИдентификаторыДокументов;
	
КонецФункции

Функция ПолучитьСтатусыДокументовИз1С(МассивПоиска, СвойствоСтатус = Неопределено, СвойствоИдентификатор = Неопределено, ПоискПоИдентификаторам = Ложь) Экспорт
	
	Если СвойствоИдентификатор = Неопределено ИЛИ СвойствоСтатус = Неопределено Тогда
		СтруктураХранения1С = ПолучитьСтруктуруХранения1С();
		Если СвойствоИдентификатор = Неопределено Тогда
			СвойствоИдентификатор = СтруктураХранения1С.СвойствоИдентификатор;
		КонецЕсли;
		Если СвойствоСтатус = Неопределено Тогда
			СвойствоСтатус = СтруктураХранения1С.СвойствоСтатус;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	
	Если ПоискПоИдентификаторам Тогда	
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ДополнительныеСведения.Объект КАК Ссылка
		               |ПОМЕСТИТЬ Документы
		               |ИЗ
		               |	РегистрСведений.ЗначенияСвойствОбъектов КАК ДополнительныеСведения
		               |ГДЕ
		               |	ДополнительныеСведения.Свойство = &СвойствоИдентификатор
		               |	И ДополнительныеСведения.Значение В(&МассивОбъектов)
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	Документы.Ссылка,
		               |	ДополнительныеСведения.Значение
		               |ИЗ
		               |	Документы КАК Документы
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ДополнительныеСведения
		               |		ПО Документы.Ссылка = ДополнительныеСведения.Объект
		               |ГДЕ
		               |	ДополнительныеСведения.Свойство = &СвойствоСтатус";
		
	Иначе	
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	СчетФактураВыданныйДокументыОснования.Ссылка КАК Ссылка
		               |ПОМЕСТИТЬ СвязанныеСчетаФактуры
		               |ИЗ
		               |	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
		               |ГДЕ
		               |	СчетФактураВыданныйДокументыОснования.ДокументОснование В(&МассивОбъектов)
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ДополнительныеСведения.Объект КАК Ссылка,
		               |	ДополнительныеСведения.Значение КАК Значение
		               |ИЗ
		               |	РегистрСведений.ЗначенияСвойствОбъектов КАК ДополнительныеСведения
		               |ГДЕ
		               |	ДополнительныеСведения.Свойство = &СвойствоСтатус
		               |	И ДополнительныеСведения.Объект В(&МассивОбъектов)
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	ДополнительныеСведения.Объект,
		               |	ДополнительныеСведения.Значение
		               |ИЗ
		               |	СвязанныеСчетаФактуры КАК СвязанныеСчетаФактуры
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ДополнительныеСведения
		               |		ПО СвязанныеСчетаФактуры.Ссылка = ДополнительныеСведения.Объект
		               |ГДЕ
		               |	ДополнительныеСведения.Свойство = &СвойствоСтатус";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивПоиска);
	Запрос.УстановитьПараметр("СвойствоСтатус", СвойствоСтатус);
	Если ПоискПоИдентификаторам Тогда
		Запрос.УстановитьПараметр("СвойствоИдентификатор", СвойствоИдентификатор);
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выбрать();
	
	ПолученныеСтатусыДокументов = Новый Соответствие;
	
	Пока Результат.Следующий() Цикл 
		
		ПолученныеСтатусыДокументов.Вставить(Результат.Ссылка, Результат.Значение);
		
	КонецЦикла;
	
	Возврат ПолученныеСтатусыДокументов;
	
КонецФункции

Процедура ЗафиксироватьАктуальныеСтатусыВ1С(АктуальныеСтатусы, ТекущиеСтатусы, СоответствиеIDДокументов, ОбновлениеПоСписку = Ложь, СтруктураХранения1С = Неопределено, СвойствоСтатус = Неопределено) Экспорт
	
	Если СвойствоСтатус = Неопределено Тогда	
		СтруктураХранения1С = ПолучитьСтруктуруХранения1С();
		СвойствоСтатус = СтруктураХранения1С.СвойствоСтатус;
	КонецЕсли;
	
	ПараметрыЗаписи = ПолучитьСтруктуруПараметровЗаписиВРегистрСведений();
	
	// При обновлении по списку документов мы отталкиваемся от списка ссылок, при общем обновлении от списка идентификаторов, вернувшихся с онлайн-сервива.
	// Этим обусловлена разница в обработке в обоих случаях, но в обоих случаях идёт работа с соответствиями, по общему принципу.
	
	Если ОбновлениеПоСписку Тогда
		СоответствиеОбхода = ТекущиеСтатусы;
		СоответствиеСравнения = АктуальныеСтатусы;
	Иначе
		СоответствиеОбхода = АктуальныеСтатусы;
		СоответствиеСравнения = ТекущиеСтатусы;
	КонецЕсли;
	
	Для Каждого Элемент из СоответствиеОбхода Цикл
		КлючСравнения = СоответствиеIDДокументов[Элемент.Ключ];
		Если НЕ КлючСравнения = Неопределено Тогда
			ЗначениеОбхода = Элемент.Значение;
			ЗначениеСравнения = СоответствиеСравнения[КлючСравнения];
			ЗначениеСравнения = ?(ЗначениеСравнения = Неопределено, 0, ЗначениеСравнения);
			
			Если НЕ ЗначениеОбхода = ЗначениеСравнения Тогда 
				
				ТекущийСтатусОписываетВариациюОшибки = ?(ОбновлениеПоСписку, 
														?(ЗначениеСравнения = 10 И ЗначениеОбхода >= 20 И ЗначениеОбхода < 30, Истина, Ложь), 
														?(ЗначениеОбхода = 10 И ЗначениеСравнения >= 20 И ЗначениеСравнения < 30, Истина, Ложь));
														
				Если ТекущийСтатусОписываетВариациюОшибки Тогда
					//Статус на онлайне - черновик. Значит, отправка была невозможна. 
					//Статус в 1С - ошибка (возможны несколько типов), описывающая причину невозможности отправки.
					//В этом случае перезаписывать статус 1С на "Черновик" не требуется.
				Иначе
					//Обновляется статус в 1С.
					АктуальныйСтатусДокумента = ?(ОбновлениеПоСписку, ЗначениеСравнения, ЗначениеОбхода);
					
					Если НЕ АктуальныйСтатусДокумента = 0 Тогда					
						ПараметрыЗаписи.НаименованиеРегистра	= СтруктураХранения1С.НаименованиеРегистра;
						ПараметрыЗаписи.Объект 					= ?(ОбновлениеПоСписку, Элемент.Ключ, КлючСравнения);
						ПараметрыЗаписи.Свойство 				= СвойствоСтатус;
						ПараметрыЗаписи.Значение 				= АктуальныйСтатусДокумента;
						
						РезультатЗаписи = ЗаписьВРегистрСведений(ПараметрыЗаписи);					
					КонецЕсли;					
				КонецЕсли;										
			КонецЕсли;
			
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСсылкуНаУчастникаПоИдентификаторуЭДО(Идентификатор, СвойствоИдентификатор = Неопределено, ЭтоОрганизация = Ложь)
	
	Если СвойствоИдентификатор = Неопределено Тогда
		Кэш = Инициализация(Ложь);
		СтруктураХранения1С = ПолучитьСтруктуруХранения1С(Кэш);
		СвойствоИдентификатор = СтруктураХранения1С.СвойствоИдентификаторУчастника;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	ДополнительныеСведения.Объект КАК Ссылка
	               |ИЗ
	               |	РегистрСведений.ЗначенияСвойствОбъектов КАК ДополнительныеСведения
	               |ГДЕ
	               |	ДополнительныеСведения.Свойство = &СвойствоИдентификатор
	               |	И ДополнительныеСведения.Значение = &Идентификатор
	               |	И ДополнительныеСведения.Объект ССЫЛКА Справочник."+?(ЭтоОрганизация, "Организации", "Контрагенты");
	Запрос.УстановитьПараметр("СвойствоИдентификатор", СвойствоИдентификатор);
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Результат = Результат.Выбрать();
		Результат.Следующий();
		Возврат Результат.Ссылка;
	Иначе	
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДокументыПоИдентификаторам1С(МассивИдентификаторов, СвойствоИдентификатор = Неопределено) Экспорт
	
	Если СвойствоИдентификатор = Неопределено Тогда
		СтруктураХранения1С = ПолучитьСтруктуруХранения1С();
		СвойствоИдентификатор = СтруктураХранения1С.СвойствоИдентификатор;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ДополнительныеСведения.Значение КАК Идентификатор,
	               |	ДополнительныеСведения.Объект КАК Ссылка
	               |ИЗ
	               |	РегистрСведений.ЗначенияСвойствОбъектов КАК ДополнительныеСведения
	               |ГДЕ
	               |	ДополнительныеСведения.Свойство = &СвойствоИдентификатор
	               |	И ДополнительныеСведения.Значение В(&МассивИдентификаторов)";
	
	Запрос.УстановитьПараметр("МассивИдентификаторов", МассивИдентификаторов);
	Запрос.УстановитьПараметр("СвойствоИдентификатор", СвойствоИдентификатор);
	Результат = Запрос.Выполнить().Выбрать();
	
	ДокументыПоИдентификаторам = Новый Соответствие;
	
	Пока Результат.Следующий() Цикл 
		
		ДокументыПоИдентификаторам.Вставить(Результат.Идентификатор, Результат.Ссылка);
		
	КонецЦикла;
	
	Возврат ДокументыПоИдентификаторам;
	
КонецФункции

Функция ПолучитьИдентификаторЭДОИз1СПоСсылке(Ссылка, СвойствоИдентификаторУчастника = Неопределено) Экспорт
	
	Если СвойствоИдентификаторУчастника = Неопределено Тогда
		СтруктураХранения1С = ПолучитьСтруктуруХранения1С();
		СвойствоИдентификатор = СтруктураХранения1С.СвойствоИдентификаторУчастника;
	КонецЕсли;
	
	Если СвойствоИдентификатор = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не удалось определить дополнительное свойство для хранения идентификатора участника ЭДО. Отправка невозморжна.";
		Сообщение.Сообщить();
		Возврат Неопределено;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ДополнительныеСведения.Значение КАК Идентификатор
	|ИЗ
	|	РегистрСведений."+СтруктураХранения1С.НаименованиеРегистра+ " КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Свойство.Наименование = &НаименованиеСвойства
	|	И ДополнительныеСведения.Объект = &Ссылка";	
	Запрос.УстановитьПараметр("НаименованиеСвойства", СвойствоИдентификатор.Наименование);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Результат = Результат.Выбрать();
		Результат.Следующий();
		Возврат СокрЛП(Результат.Идентификатор);
	Иначе
		Возврат "";
	КонецЕсли;	
		
КонецФункции

#КонецОбласти

#Область KeycloakВзаимодействие

Функция RefreshTokens(RefreshToken)
	
	scope = "openid+groups+organization%3Aorg+upid+organization%3Aorg.write+profile+email";
	
	СтрокаПараметров = "grant_type=refresh_token&client_id=1c-sso&refresh_token="+RefreshToken+"&scope="+scope;
		
	headers = Новый Соответствие;
	headers.Вставить("Content-Type", "application/x-www-form-urlencoded");
	
	HTTPСоединение = Новый HTTPСоединение("oauth-test.platformaofd.ru", 443 ,,,, 15, Новый ЗащищенноеСоединениеOpenSSL);
	СтрокаЗапроса = "realms/playground/protocol/openid-connect/token";
	
	Запрос = Новый HTTPЗапрос(СтрокаЗапроса, headers);
	
	Запрос.УстановитьТелоИзСтроки(СтрокаПараметров, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(Запрос);
	
	Если HTTPОтвет.КодСостояния = 200 Тогда
		Ответ = HTTPОтвет.ПолучитьТелоКакСтроку();
		Ответ = СтрЗаменить(Ответ, "not-before-policy", "not_before_policy");
		ЧтениеJSON = новый ЧтениеJSON();
		ЧтениеJSON.УстановитьСтроку(Ответ);
		Tokens = ПрочитатьJSON(ЧтениеJSON, Ложь);
		Возврат Tokens;
	 Иначе
		Сообщить("Произошла ошибка обращения к серверу," + "Токен не получен" +
				Символы.ПС + "Статус ответа сервера: " + HTTPОтвет.КодСостояния);
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

