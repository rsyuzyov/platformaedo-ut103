			МассивОбъектXDTO = СтруктураМассивОбъектаXDTO.ОбъектXDTO[СтруктураМассивОбъектаXDTO.Значение]; 
			Если ТипЗнч(МассивОбъектXDTO) = Тип("СписокXDTO") Тогда
				// Несколько элементов в массиве.
				Для Каждого ЭлементОбъектXDTO из МассивОбъектXDTO Цикл
					ОбработатьРезультатФормирования_XDTO(ЭлементОбъектXDTO, НастройкаОбъектXDTO, ФорматВыгрузки, Кэш, Документ, ПараметрыФормирования);
				КонецЦикла;	
			ИначеЕсли ТипЗнч(МассивОбъектXDTO) = Тип("ОбъектXDTO") Тогда
				// Один элемент в массиве.
				ОбработатьРезультатФормирования_XDTO(МассивОбъектXDTO, НастройкаОбъектXDTO, ФорматВыгрузки, Кэш, Документ, ПараметрыФормирования);  	
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЦикла;	

	Если ДанныеПереданыВВидеXDTO Тогда
		
		СтруктураДанных = ОбрабатываемыйОбъектXDTO;
		
