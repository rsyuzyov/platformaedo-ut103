#Область ИнициализацияНастроек

// Служебная функция для работы из справочника
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = Новый Структура;
	РегистрационныеДанные.Вставить("Наименование", "Платформа ЭДО (Электронный документооборот)"+?(ЭтоТестоваяОбработка, " для тестирования", ""));
	РегистрационныеДанные.Вставить("БезопасныйРежим", Ложь);
	РегистрационныеДанные.Вставить("Версия", "1.0.5.3.4.1");
	РегистрационныеДанные.Вставить("Вид", "ДополнительнаяОбработка");
	РегистрационныеДанные.Вставить("Информация", "Обмен документами в электронном виде");
	
	///////////// команды /////////////////////////
	тзКоманд = Новый ТаблицаЗначений;
	тзКоманд.Колонки.Добавить("Идентификатор");
	тзКоманд.Колонки.Добавить("Представление");
	тзКоманд.Колонки.Добавить("Модификатор");
	тзКоманд.Колонки.Добавить("ПоказыватьОповещение");
	тзКоманд.Колонки.Добавить("Использование");
	
	// Открытие главной формы.
	строкаКоманды = тзКоманд.Добавить();
	строкаКоманды.Идентификатор = "1";
	строкаКоманды.Представление = "Платформа ЭДО (Электронный документооборот)"+?(ЭтоТестоваяОбработка, " для тестирования", "");
	строкаКоманды.ПоказыватьОповещение = Истина; 
	строкаКоманды.Использование = Вычислить("ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы()"); 
	
	// Фоновое обновление статусов
	строкаКоманды = тзКоманд.Добавить();
	строкаКоманды.Идентификатор = "ФоновоеОбновлениеСтатусовОФДЭДО";
	строкаКоманды.Представление = "Обновление статусов эл. документов (Платформа ЭДО)";
	строкаКоманды.ПоказыватьОповещение = Истина; 
	строкаКоманды.Использование = Вычислить("ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода()");
	
	// Фоновое заполнение идентификаторов
	строкаКоманды = тзКоманд.Добавить();
	строкаКоманды.Идентификатор = "ФоновоеЗаполнениеИдентификаторовАбонентовЭДО";
	строкаКоманды.Представление = "Заполнение идентификаторов абонентов (Платформа ЭДО)";
	строкаКоманды.ПоказыватьОповещение = Истина; 
	строкаКоманды.Использование = Вычислить("ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода()");
	
	РегистрационныеДанные.Вставить("Команды", тзКоманд);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Функция запуска инициализации
// Определяет первый запуск или штатный запуск по наличию настроек в хранилище общих настроек
//
// Возвращаемые значения:
// Кэш (тип данных: Структура) 
Функция Инициализация(Откат) Экспорт
	
	ПервыйЗапуск = Истина;
	
	// Если настройки есть в хранилище настроек, то (Штатный запуск)
	// Иначе добавляем настройки из макета в хранилище настроек (Первый запуск)
	// Если есть команда "Откат=Истина" (Откат к стандартным настройкам), то делаем распаковку настроек из макета (Первый запуск)
	Если ОФД_ЭДО_ПолучитьСписокНастроек().Количество() > 0  и Не Откат Тогда
		ПервыйЗапуск = Ложь;
	КонецЕсли;
	
	Если ПервыйЗапуск Тогда
		Возврат ПервыйЗапуск(Откат);
	Иначе
		Возврат ШтатныйЗапуск();
	КонецЕсли;
		
КонецФункции

// Функция штатного запуска: 
// Инициализируем Кэш из хранилища общих настроек
//
// Возвращаемые значения:
// Кэш (тип данных: Структура) 
Функция ШтатныйЗапуск() Экспорт  	
	
	Кэш = ПроинициализироватьКэш();
	
	Если Кэш.ПрефиксКонфигурации = Ложь Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Конфигурация не поддерживается данной версией обработки.";
		Сообщение.Сообщить();
		Возврат Неопределено;	
	КонецЕсли;	
	
	Кэш.Настройки = РаспаковатьНастройкиИзХранилища(Кэш.ПрефиксКонфигурации);
	
	ДобавитьОбъектНастройкиВКэш(Кэш);	
		
	Возврат Кэш;
	
КонецФункции  

// Функция первого запуска: 
// 1. Определяем версию конфигурации;
// 2. Распаковываем из макета настройки в хранилище общих настроек в зависимости от конфигурации
// 3. Инициализируем кэш настройками из хранилища общих настроек
//
// Возвращаемые значения:
// Кэш (тип данных: Структура) 
Функция ПервыйЗапуск(Откат = Ложь) Экспорт  	
	
	// Предзаполнение Кэш
	Кэш = ПроинициализироватьКэш();
	
	// Что-то пошло не так и мы получили критическую ошибку при определении конфигураци 
	Если ТипЗнч(Кэш.ПрефиксКонфигурации) = Тип("Булево") и Не Кэш.ПрефиксКонфигурации Тогда
		Сообщить("Не удалось определить конфигурацию базы 1С.");
		Возврат Неопределено;
	КонецЕсли;
	
	// Конфигурация определена, но она не находится в списке поддерживаемых обработкой конфигураций
	Если Не ПоддерживаемаяКонфигурация(Кэш.ПрефиксКонфигурации) Тогда
		Сообщить("Конфигурация не поддерживается обработкой.");
		Возврат Неопределено;
	КонецЕсли;  	
	
	// Если все хорошо, то распаковываем настройки для нашей конфигурации и инициализируем Кэш для работы
	РаспаковатьНастройкиДляОбработки("Настройки", Кэш, Кэш.ПрефиксКонфигурации); 		// настройки для выгрузки документов
	РаспаковатьНастройкиДляОбработки("Форматы", Кэш);									// форматы для выгрузки документов    	
	ИнициализацияНастроек(Кэш.Настройки, Откат); 										// добавляем настройки в хранилище общий настроек (настройки для выгрузки)
	ДобавитьОбъектНастройкиВКэш(Кэш);													// добавляем объекты настроек в кэш для использования их в функциях на сервере без контекста
	ИнициализацияНастроек(Кэш.Форматы, Откат);                                          // добавляем форматы в хранилище общий настроек (форматы для выгрузки)
	
	Возврат Кэш;
	
КонецФункции   

// Процедура добавляет объекты настроек в Кэш
Процедура ДобавитьОбъектНастройкиВКэш(Кэш) 
	
	Для Каждого Настройка из Кэш.Настройки Цикл
		
		Кэш.НастройкиОбъект.Вставить(Настройка.Ключ, ПолучитьОбъектНастройкиПоИмениМетаданных(Настройка.Ключ, Кэш));
		
	КонецЦикла;     
	
	
	МассивКлиентскихНастроек = ПолучитьСохраненныеКлиентскиеНастройки();
	
	Если Кэш.ШаблонНастройки = Неопределено Тогда
		Кэш.Вставить("ШаблонНастройки", ПолучитьФабрикуНастроек());
	КонецЕсли;
	
	Если НЕ МассивКлиентскихНастроек = Неопределено И ТипЗнч(МассивКлиентскихНастроек) = Тип("Массив") Тогда
		
		Для Каждого Элемент из МассивКлиентскихНастроек Цикл
			
			Если Элемент.Применять = Истина Тогда	
				// Сериализуем объект настройки и добавляем его в Кэш
				Кэш.НастройкиОбъект.Вставить(Элемент.ИмяФайлаНастройки, СоздатьОбъектXDTOИзXML(Элемент.ТекстНастройки, Кэш.ШаблонНастройки));
			КонецЕсли;	
				
		КонецЦикла;	
		
	КонецЕсли;	
	
КонецПроцедуры

// Функция возвращает начальное заполнение Кэш
// 1. "ПрефиксКонфигурации" 	- Строковое представление конфигурации (Тип: Строка)
// 2. "ШаблонНастройки" 		- Фабрика XDTO для сериализации настроек (Тип: ФабрикаXDTO)
// 3. "Настройки" 				- Соответствие, где ключ: имя настройки (строка), значение: xml настройки (строка) 
// 4. "НастройкиОбъект"			- Соответствие, где ключ: имя настройки (строка), значение: объект XDTO настройки (объект XDTO)
//
// Возвращаемые значения:
// Кэш с предзаполненными указанными выше значениями (тип данных: Структура) 
Функция ПроинициализироватьКэш()
	
	Кэш = Новый Структура;
	
	Кэш.Вставить("ПрефиксКонфигурации", ПолучитьВерсиюКонфигурации());		// Строковое значение 
	Кэш.Вставить("ШаблонНастройки", ПолучитьФабрикуНастроек());				// Фабрика XDTO для сериализации настроек
	Кэш.Вставить("Настройки", Новый Соответствие);                          // Ключ: имя настройки (строка); Значение: xml настройки (строка)
	Кэш.Вставить("НастройкиОбъект", Новый Соответствие);					// Ключ: имя настройки (строка); Значение: объект XDTO настройки (объект XDTO)
	Кэш.Вставить("Форматы", Новый Соответствие);							// Ключ: имя формата; Значение: xsd формата(строка)
	Кэш.Вставить("ФорматыОбъект", Новый Соответствие);						// Ключ: имя формата; Значение: фабрика XDTO формата
	Кэш.Вставить("СпособИнтеграции");										// Способ интеграции (число 1 - каталог, 2 - API)
	Кэш.Вставить("КаталогОбмена");											// Каталог обмена (строка - каталог)
	//Кэш.Вставить("ТокенАвторизации");                                		// Токен авторизации (строка - API GUID)
	Кэш.Вставить("ДоступныеФорматы", Новый Соответствие);					// Список доступных форматов для выгрузок
	Кэш.Вставить("ДоступныеВерсииФорматов", Новый Соответствие);			// Список доступных версий форматов для выгрузок
		
	Возврат Кэш;
	
КонецФункции 	

// Функция получает шаблон настройки 
//Входящие параметры
// СтруктураНастроек		 - Структура с настройками
//
// Возвращаемые значения:
// Фабрика XDTO с шаблоном настройки
Функция ПолучитьФабрикуНастроек()
	
	// Переводим xsd-схему шаблона в фабрику
	ДанныеМакета = ПолучитьМакет("ШаблонНастройки");
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xsd");
	ДанныеМакета.Записать(ИмяВременногоФайла);
	ФабрикаШаблона = СоздатьФабрикуXDTO(ИмяВременногоФайла);
	УдалитьФайлы(ИмяВременногоФайла);
	
	Возврат ФабрикаШаблона;     
	
КонецФункции

// Функция определяет версию текущей конфигурации
//
// Возвращаемые значения:
// Строка с версией конфигурации
// Ложь 	- не удалось определеить конфигурацию базы
Функция ПолучитьВерсиюКонфигурации() Экспорт
	
	ВерсияКонфигурации = Новый Структура;
	ВерсияКонфигурации.Вставить("Имя", Метаданные.Имя);
	ВерсияКонфигурации.Вставить("КраткаяИнформация", Метаданные.КраткаяИнформация);
	ВерсияКонфигурации.Вставить("ПодробнаяИнформация", Метаданные.ПодробнаяИнформация);
	ВерсияКонфигурации.Вставить("Версия", Метаданные.Версия);
	
	Если СтрНайти(ВерсияКонфигурации.ПодробнаяИнформация, "ERP") > 0 И СтрНайти(ВерсияКонфигурации.Версия, "2.2") > 0 Тогда
		Возврат "ERP_2_2_";
	КонецЕсли;
	Если СтрНайти(ВерсияКонфигурации.ПодробнаяИнформация, "ERP") > 0 И СтрНайти(ВерсияКонфигурации.Версия, "2.4") > 0 Тогда
		Возврат "ERP_2_4_";
	КонецЕсли;
	Если СтрНайти(ВерсияКонфигурации.ПодробнаяИнформация, "ERP") > 0 И СтрНайти(ВерсияКонфигурации.Версия, "2.5") > 0 Тогда
		Возврат "ERP_2_5_";
	КонецЕсли;
	Если СтрНайти(ВерсияКонфигурации.ПодробнаяИнформация, "Бухгалтерия предприятия") > 0 И СтрНайти(ВерсияКонфигурации.Версия, "3.0") > 0 Тогда
		Возврат "БУХ_3_0_";
	КонецЕсли;
	Если СтрНайти(ВерсияКонфигурации.ПодробнаяИнформация, "Аренда и управление недвижимостью для ""1С:Бухгалтерия 8""") > 0 И СтрНайти(ВерсияКонфигурации.Версия, "3.0") > 0 Тогда
		Возврат "БУХ_3_0_";
	КонецЕсли;
	Если СтрНайти(ВерсияКонфигурации.ПодробнаяИнформация, "Управление торговлей, редакция 11") > 0 И СтрНайти(ВерсияКонфигурации.Версия, "11.4") > 0 Тогда
		Возврат "УТ_11_4_";
	КонецЕсли; 
	Если СтрНайти(ВерсияКонфигурации.ПодробнаяИнформация, "Управление торговлей (базовая), редакция 11") > 0 И СтрНайти(ВерсияКонфигурации.Версия, "11.4") > 0 Тогда
