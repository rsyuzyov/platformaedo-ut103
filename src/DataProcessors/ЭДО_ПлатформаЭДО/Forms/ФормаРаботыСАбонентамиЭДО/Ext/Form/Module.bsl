#Область ОтправитьПриглашение

&НаКлиенте
Процедура ОтправитьПриглашение(Команда)
	
	Если НЕ ЗначениеЗаполнено(Элементы.ПроизвольныйИдентификатор.ТекстРедактирования) Тогда
	
		Если Элементы.ИдентификаторыЭДО.ТекущиеДанные.СтатусПриглашения = "Не отправлялось" ИЛИ Элементы.ИдентификаторыЭДО.ТекущиеДанные.СтатусПриглашения =  "Не отправлялось. Отправка возможна." ИЛИ НЕ СтрНайти(Элементы.ИдентификаторыЭДО.ТекущиеДанные.СтатусПриглашения, "Отправка возможна") = 0 ИЛИ НЕ СтрНайти(Элементы.ИдентификаторыЭДО.ТекущиеДанные.СтатусПриглашения, "Отправка приглашения возможна") = 0 Тогда
			
			ПриглашениеБылоОтправлено = ОтправитьПриглашениеКЭДО(ИдентификаторОрганизацииВБД, Элементы.ИдентификаторыЭДО.ТекущиеДанные.ИдентификаторКонтрагента);
			
			Если ПриглашениеБылоОтправлено Тогда
				ИдентификаторыЭДО.Очистить();
				ЗаполнитьСписокПриглашений();
			КонецЕсли;	
			
		ИначеЕсли Элементы.ИдентификаторыЭДО.ТекущиеДанные.СтатусПриглашения = "Перейти на форму заявки" Тогда
			
			ЗапуститьПриложение("https://docs.google.com/forms/d/e/1FAIpQLSe7n6yoCZx9B4wQOXPrN1AmbI9k3dksnoSEfrzyLV0jbVnK_A/viewform"); 
		
		Иначе
			
			// Ничего.
		
		КонецЕсли;
	
	Иначе
		
		Если ПроизвольныйИдентификаторПоддерживается Тогда
			
			// Проверим, не было ли отправлено приглашение ранее.
			СтатусПриглашения = ПолучитьСостояниеПриглашения(ИдентификаторОрганизацииВБД, ПроизвольныйИдентификатор);
			
			Если СтатусПриглашения = "Не отправлялось" ИЛИ СтатусПриглашения = "Не отправлялось. Отправка возможна." ИЛИ НЕ СтрНайти(СтатусПриглашения, "Отправка возможна") = 0 ИЛИ НЕ СтрНайти(СтатусПриглашения, "Отправка приглашения возможна") = 0 Тогда
				// Ну тогда отправим.
				ПриглашениеБылоОтправлено = ОтправитьПриглашениеКЭДО(ИдентификаторОрганизацииВБД, ПроизвольныйИдентификатор);
			ИначеЕсли СтрНайти(СтатусПриглашения, "Ошибка") = 0 Тогда
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "Приглашение этому абоненту уже было отправлено ранее. Текущий статус приглашения - """+СтатусПриглашения+""".";
				Сообщение.Сообщить();
			Иначе
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = СтатусПриглашения;
				Сообщение.Сообщить();
			КонецЕсли;	
			
		Иначе
			
			ЗапуститьПриложение("https://docs.google.com/forms/d/e/1FAIpQLSe7n6yoCZx9B4wQOXPrN1AmbI9k3dksnoSEfrzyLV0jbVnK_A/viewform");
			
		КонецЕсли;	
		
	КонецЕсли;	
		
КонецПроцедуры

#КонецОбласти

#Область ИнтеграцияAPI

&НаКлиенте
Функция ПолучитьСостояниеПриглашения(ИдентификаорОтправителя, ИдентификаторПолучателя)
	
	СостояниеПриглашения = "Не отправлялось. Отправка возможна.";
	
	ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
	
	ПараметрыЗапроса.Параметры.Вставить("<sender_gid>", ИдентификаорОтправителя);
	ПараметрыЗапроса.Параметры.Вставить("<gids>", ИдентификаторПолучателя);
	
	СтатусРоумингаЭДО = ВыполнитьЗапросAPI("API_ПолучитьСтатусРоумингаЭДО", ПараметрыЗапроса);
	
	Если НЕ СтатусРоумингаЭДО.Ошибка Тогда
		
		Если НЕ СтатусРоумингаЭДО.Результат = Неопределено Тогда
			
			Для Каждого Результат Из СтатусРоумингаЭДО.Результат Цикл
				Если Результат.state.status = "ESTABLISHED" Тогда
					// Роуминг работает, отправка возможна.
					СостояниеПриглашения = "Роуминг работает. Приглашение не требуется.";
					Продолжить;
				ИначеЕсли Результат.state.status = "AWAIT_APPROVAL" Тогда
					// Для установки связи требуется наличие приглашения от второй стороны.
					СостояниеПриглашения = "Было отправлено. Ответ еще не получен.";
					Продолжить;
				ИначеЕсли Результат.state.status = "BROKEN" Тогда
					// Приглашение было обработано со стороны оператора-получателя.
					СостояниеПриглашения = "Связь по роумингу была отменена. Отправка приглашения возможна.";
					Продолжить;	
				КонецЕсли;	
			КонецЦикла; 
			
			Возврат СостояниеПриглашения;
			
		КонецЕсли;
		
	Иначе
				
		СостояниеПриглашения = "Ошибка получения данных о состоянии роуминга ЭДО.";
		Возврат СостояниеПриглашения;
			
	КонецЕсли;	
	
	ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
	
	ПараметрыЗапроса.Параметры.Вставить("<sender_gid>", ИдентификаорОтправителя);
	ПараметрыЗапроса.Параметры.Вставить("<recipient_gid>", ИдентификаторПолучателя);
	
	СтатусПриглашения = ВыполнитьЗапросAPI("API_ПолучитьСтатусПриглашенияКЭДО", ПараметрыЗапроса);
	
	Если НЕ СтатусПриглашения.Ошибка Тогда
		
		Если НЕ СтатусПриглашения.Результат = Неопределено Тогда
			
			Для Каждого Результат Из СтатусПриглашения.Результат Цикл
				Если Результат.type = "BREAK" Тогда
					// Приглашение было отклонено со стороны оператора-получателя.
					СостояниеПриглашения = "Отклонено. Отправка возможна.";
					Продолжить;
				ИначеЕсли НЕ Результат.type = "REQUEST" Тогда
					// Приглашение было обработано со стороны оператора-получателя.
					СостояниеПриглашения = "Было отправлено. Ответ еще не получен.";
					Продолжить;
				Иначе
					Если Результат.status = "SENDING" Тогда
						// В процессе отправки.	
						СостояниеПриглашения = "Было отправлено. Обрабатывается оператором получателя.";
						Продолжить;
					ИначеЕсли Результат.status = "SENT" Тогда
						// Отправлено.
						СтатусПриглашения = "Было доставлено. Ответ еще не получен.";
						Продолжить;
					ИначеЕсли Результат.status = "FAILED" Тогда
						// Произошла ошибка в процессе отправки.
						СостояниеПриглашения = "Ошибка отправки. Отправка возможна.";
						Продолжить;
					Иначе
						Продолжить;
					КонецЕсли;		
					Прервать;
				КонецЕсли;	
			КонецЦикла;	
			
		КонецЕсли;
		
	Иначе	
				
		СостояниеПриглашения = "Ошибка получения данных о пригашениях к ЭДО.";
		
	КонецЕсли;
	
	Возврат СостояниеПриглашения;
	
КонецФункции	

&НаКлиенте
Функция ОтправитьПриглашениеКЭДО(ИдентификаорОтправителя, ИдентификаторПолучателя)
	
	ПриглашениеБылоОтправлено = Ложь;
	
	ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
	
	ПараметрыЗапроса.Параметры.Вставить("<sender_gid>", ИдентификаорОтправителя);
	ПараметрыЗапроса.Параметры.Вставить("<recipient_gid>", ИдентификаторПолучателя);
	
	ОтправкаПриглашения = ВыполнитьЗапросAPI("API_ОтправитьАбонентуПриглашениеКЭДО", ПараметрыЗапроса);
	
	Если НЕ ОтправкаПриглашения.Ошибка Тогда
		
		Если ОтправкаПриглашения.КодСостояния = 204 Тогда
			ПриглашениеБылоОтправлено = Истина;
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Приглашение было успешно отправлено.";
			Сообщение.Сообщить();
		КонецЕсли;	
		
	Иначе	
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не удалось сформировать приглашение в системе ЭДО."+Символы.ПС+"Описание ошибки:"+Символы.ПС+ОтправкаПриглашения.Описание;
		Сообщение.Сообщить();
				
	КонецЕсли;
	
	Возврат ПриглашениеБылоОтправлено;
	
КонецФункции

// Функция возвращает результат любой функции обращения к API. Обращение к функциям напрямую возможно.
// Основная особенность функции - автоматический релогин, если метод требует авторизацию и первый ответ на запрос вернул ошибку 401.
// Автоматический релогин возможен только в том случае, если пользователь зарегистрировал свой сертификат в ЛК ЭДО.
&НаКлиенте
Функция ВыполнитьЗапросAPI(ИмяФункцииЗапроса, ВходящиеПараметрыЗапроса) Экспорт
	
	РезультатЗапроса = ПолучитьШаблонСтруктурыОтвета();
	РезультатЗапроса.Ошибка = Истина;
	
	ПараметрыЗапроса = СкопироватьКоллекцию(ВходящиеПараметрыЗапроса);
	
	Выполнить("РезультатЗапроса = "+ИмяФункцииЗапроса+"(ПараметрыЗапроса);");
	
	Если РезультатЗапроса.КодСостояния = 401 ИЛИ РезультатЗапроса.КодСостояния = 500 Тогда
		
		// Ошибка авторизации.
		// Попытка обновить токен по сертификату.
		Если ИспользоватьПодписание = Истина И НЕ ЗначениеЗаполнено(RefreshToken) Тогда
			
			Если ПараметрыЗапроса.Свойство("Заголовки") И НЕ ПараметрыЗапроса.Заголовки.Получить("Authorization") = Неопределено Тогда	
				НовыйТокен = ПолучитьТокенПоОтпечаткуСертификата(Base64Значение(ОтпечатокСертификатаBase64), ПарольДоступаКЗакрытомуКлючу);
				Если НЕ НовыйТокен = Неопределено Тогда
					ПараметрыЗапроса = СкопироватьКоллекцию(ВходящиеПараметрыЗапроса);
					ПараметрыЗапроса.Заголовки.Вставить("Authorization", "Bearer "+ НовыйТокен);
					Выполнить("РезультатЗапроса = "+ИмяФункцииЗапроса+"(ПараметрыЗапроса);");
					Если РезультатЗапроса.КодСостояния = 200 Тогда
						AccessToken = НовыйТокен;
						RefreshToken = "";
						СохранитьПараметрыАвторизацииИПодписанияОрганизации(Организация, AccessToken, RefreshToken, ИспользоватьПодписание, ОтпечатокСертификатаBase64, ПарольДоступаКЗакрытомуКлючу, ТипСубъектаПодписанта, МчдGUIDПодписанта, ДатаНачалаДействияМЧД, ДолжностьФизлица);
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(AccessToken) И ЗначениеЗаполнено(RefreshToken) Тогда 	
			
			FreshTokens = RefreshTokens(RefreshToken);
			Если НЕ FreshTokens = Неопределено Тогда
				НовыйAccessToken = FreshTokens.access_token;
				НовыйRefreshToken = FreshTokens.refresh_token;
				AccessToken = НовыйAccessToken;
				RefreshToken = НовыйRefreshToken;
				ПараметрыЗапроса = СкопироватьКоллекцию(ВходящиеПараметрыЗапроса);
				ПараметрыЗапроса.Заголовки.Вставить("Authorization", "Bearer "+ AccessToken);
				Выполнить("РезультатЗапроса = "+ИмяФункцииЗапроса+"(ПараметрыЗапроса);");
				Если РезультатЗапроса.КодСостояния = 200 Тогда	
					СохранитьПараметрыАвторизацииИПодписанияОрганизации(Организация, AccessToken, RefreshToken, ИспользоватьПодписание, ОтпечатокСертификатаBase64, ПарольДоступаКЗакрытомуКлючу, ТипСубъектаПодписанта, МчдGUIDПодписанта, ДатаНачалаДействияМЧД, ДолжностьФизлица);
				КонецЕсли;	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат РезультатЗапроса;
	
КонецФункции

