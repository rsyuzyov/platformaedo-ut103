#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ИмяОбработки") Тогда
		ИмяОбработки = Параметры.ИмяОбработки;
	КонецЕсли;
	Если Параметры.Свойство("AccessToken") Тогда
		AccessToken = Параметры.AccessToken;
	КонецЕсли;
	Если Параметры.Свойство("RefreshToken") Тогда
		RefreshToken = Параметры.RefreshToken;
	КонецЕсли;
	Если Параметры.Свойство("ВерсияНастроекОбработки") Тогда
		ВерсияНастроекОбработки = Параметры.ВерсияНастроекОбработки;
	КонецЕсли;
	Если Параметры.Свойство("ИспользоватьПодписание") Тогда
		ИспользоватьПодписание = Параметры.ИспользоватьПодписание;
	КонецЕсли;
	Если Параметры.Свойство("ОтпечатокСертификатаBase64") Тогда
		ОтпечатокСертификатаBase64 = Параметры.ОтпечатокСертификатаBase64;
	КонецЕсли;
	Если Параметры.Свойство("ПарольДоступаКЗакрытомуКлючу") Тогда
		ПарольДоступаКЗакрытомуКлючу = Параметры.ПарольДоступаКЗакрытомуКлючу;
	КонецЕсли;
	Если Параметры.Свойство("ТипСубъектаПодписанта") Тогда
		ТипСубъектаПодписанта = Параметры.ТипСубъектаПодписанта;
	КонецЕсли;
	Если Параметры.Свойство("МчдGUIDПодписанта") Тогда
		МчдGUIDПодписанта = Параметры.МчдGUIDПодписанта;
	КонецЕсли;
	Если Параметры.Свойство("ДатаНачалаДействияМЧД") Тогда
		ДатаНачалаДействияМЧД = Параметры.ДатаНачалаДействияМЧД;
	КонецЕсли;	
	Если Параметры.Свойство("ДолжностьФизлица") Тогда
		ДолжностьФизлица = Параметры.ДолжностьФизлица;
	КонецЕсли;
	Если Параметры.Свойство("АдресВременногоХранилищаКэш") Тогда
		АдресВременногоХранилищаКэш = Параметры.АдресВременногоХранилищаКэш;
	КонецЕсли;
	Если Параметры.Свойство("Организация") Тогда
		Организация = Параметры.Организация;
		ОрганизацияПриИзмененииНаСервере();
	КонецЕсли;
	
	ОпределитьИспользованиеТестовогоКонтура();
	
	УстановитьПараметрСвойстваИдентификатораДинспискаКонтрагентов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВедущийФрагментАдресаKeycloak = ?(Объект.ЭтоТестоваяОбработка = Истина, "oauth-test", "oauth");
	realmФрагментАдресаKeycloak = ?(Объект.ЭтоТестоваяОбработка = Истина, "playground", "production");
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	// Отобразим текущий идентификатор в БД, при наличии.
	ИдентификаторОрганизацииВБД = ПолучитьИдентификаторЭДОИз1СПоСсылке(Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	Если Элементы.СписокКонтрагентов.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если Контрагент = Элементы.СписокКонтрагентов.ТекущиеДанные.Ссылка Тогда
		Возврат;
	КонецЕсли;	
	
	ИдентификаторыЭДО.Очистить();
	
	Контрагент = Элементы.СписокКонтрагентов.ТекущиеДанные.Ссылка;
	
	Если НЕ Контрагент.Пустая() Тогда
		КонтрагентПриИзмененииНаСервере();
	Иначе
		ИдентификаторКонтагентаВБД = "";
	КонецЕсли;
	
	НайтиКонтрагентаВЭДО();
	
КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()
			
	ИННКонтрагента = Контрагент.ИНН; 
	КППКонтрагента = Контрагент.КПП;
	// Отобразим текущий идентификатор в БД, при наличии.
	ИдентификаторКонтагентаВБД = ПолучитьИдентификаторЭДОИз1СПоСсылке(Контрагент);
	
КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторыЭДОВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ИдентификаторАбонента	= Элемент.ТекущиеДанные.ИдентификаторКонтрагента;
	КППАбонента				= Элемент.ТекущиеДанные.КПП;
	
	Если НЕ ИдентификаторАбонента = "" Тогда
		Если КППАбонента = КППКонтрагента Тогда
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаСохраненияИдентификатораКонтрагента", ЭтотОбъект, ИдентификаторАбонента);			
			ПоказатьВопрос(Оповещение, "Текущий идентификатор контрагента: "+ИдентификаторКонтагентаВБД+Символы.ПС+"Выбранный идентификатор контрагента: "+ИдентификаторАбонента, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, "Обновить идентификатор контрагента "+Контрагент+"?");  	
		Иначе
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОНесоответствииКППКонтрагента", ЭтотОбъект, ИдентификаторАбонента);			
			ПоказатьВопрос(Оповещение, "КПП выбраного абонента не совпадает с КПП выбраного контрагента.", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, "Вы уверены?");  	
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторыЭДОПриАктивизацииСтроки(Элемент)

	Если ЗначениеЗаполнено(Элементы.ПроизвольныйИдентификатор.ТекстРедактирования) Тогда
		Возврат;
	КонецЕсли;	
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Элементы.ОтправитьПриглашение.Доступность = Ложь;
		Возврат;
	КонецЕсли;
	
	Если	Лев(Элемент.ТекущиеДанные.ИдентификаторКонтрагента, 3) = "2LD"
		ИЛИ Лев(Элемент.ТекущиеДанные.ИдентификаторКонтрагента, 3) = "2BK"
		ИЛИ Лев(Элемент.ТекущиеДанные.ИдентификаторКонтрагента, 3) = "2BE" 
		ИЛИ Лев(Элемент.ТекущиеДанные.ИдентификаторКонтрагента, 3) = "2AL"
		ИЛИ Лев(Элемент.ТекущиеДанные.ИдентификаторКонтрагента, 3) = "2BM"
		ИЛИ Лев(Элемент.ТекущиеДанные.ИдентификаторКонтрагента, 3) = "2AE"
		ИЛИ Лев(Элемент.ТекущиеДанные.ИдентификаторКонтрагента, 3) = "2AK"
		ИЛИ Лев(Элемент.ТекущиеДанные.ИдентификаторКонтрагента, 3) = "2LT"
		ИЛИ Лев(Элемент.ТекущиеДанные.ИдентификаторКонтрагента, 3) = "2AH"
		ИЛИ Лев(Элемент.ТекущиеДанные.ИдентификаторКонтрагента, 3) = "2EE"
		ИЛИ Лев(Элемент.ТекущиеДанные.ИдентификаторКонтрагента, 3) = "2LJ"
		ИЛИ Лев(Элемент.ТекущиеДанные.ИдентификаторКонтрагента, 3) = "2LG"
		ИЛИ Лев(Элемент.ТекущиеДанные.ИдентификаторКонтрагента, 3) = "2JM"
		ИЛИ Лев(Элемент.ТекущиеДанные.ИдентификаторКонтрагента, 3) = "2HX" Тогда
		
		//Если НЕ СтрНайти(Элемент.ТекущиеДанные.СтатусПриглашения, "Отправка возможна.") = 0 Тогда
			Элементы.ОтправитьПриглашение.Доступность = Истина;
		//Иначе
		//	Элементы.ОтправитьПриглашение.Доступность = Ложь;
		//КонецЕсли;	
		
	ИначеЕсли Элемент.ТекущиеДанные.СтатусПриглашения = "Перейти на форму заявки" Тогда
		
		Элементы.ОтправитьПриглашение.Доступность = Истина;	
		
	Иначе
		
		Элементы.ОтправитьПриглашение.Доступность = Ложь;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте 
Процедура ПослеЗакрытияВопросаСохраненияИдентификатораКонтрагента(РезультатВыбора, ИдентификаторАбонента) Экспорт

	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		
		МассивКонтрагентов = Новый Массив;
		ДанныеПоКонтрагенту = Новый Структура;
		ДанныеПоКонтрагенту.Вставить("Ссылка", Контрагент);
		ДанныеПоКонтрагенту.Вставить("ИНН", СокрЛП(Элементы.ИННКонтрагента.ТекстРедактирования));
		ДанныеПоКонтрагенту.Вставить("КПП", СокрЛП(Элементы.КППКонтрагента.ТекстРедактирования));
		ДанныеПоКонтрагенту.Вставить("Идентификатор", ИдентификаторАбонента);
		МассивКонтрагентов.Добавить(ДанныеПоКонтрагенту);
		
		ОбновитьИдентификаторыУчастниковЭДОНаСервере(МассивКонтрагентов);
		
		ИдентификаторКонтагентаВБД = ИдентификаторАбонента;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте 
Процедура ПослеЗакрытияВопросаОНесоответствииКППКонтрагента(РезультатВыбора, ИдентификаторАбонента) Экспорт

	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаСохраненияИдентификатораКонтрагента", ЭтотОбъект, ИдентификаторАбонента);			
		ПоказатьВопрос(Оповещение, "Текущий идентификатор контрагента: "+ИдентификаторКонтагентаВБД+Символы.ПС+"Выбранный идентификатор контрагента: "+ИдентификаторАбонента, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, "Обновить идентификатор контрагента "+Контрагент+"?");  	
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроизвольныйИдентификаторИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	
	ОбработатьИзменениеНабораИдентификаторов(Текст);	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеНабораИдентификаторов(Текст)
	
	Если СтрДлина(Текст) = 0 Тогда
		Элементы.ИдентификаторыЭДО.Доступность = Истина;
		Элементы.ОтправитьПриглашение.Доступность = Ложь;
		Элементы.ДекорацияНадписьЗаявка.Видимость = Ложь;
	Иначе
		Элементы.ИдентификаторыЭДО.Доступность = Ложь;
	КонецЕсли;	
	
	Если СтрДлина(Текст) >= 3 Тогда
		
		ДанныеОператора = ПолучитьПредставлениеИАвтороуминг(Лев(Текст, 3));
		
		Если ДанныеОператора = Неопределено тогда
			ПроизвольныйИдентификаторПоддерживается = Ложь;
			Элементы.ДекорацияНадписьОператорПроизвольногоИдентификатора.Заголовок = "";
			Элементы.ОтправитьПриглашение.Доступность = Ложь;
			Элементы.ДекорацияНадписьЗаявка.Видимость = Ложь;	
		Иначе
			ПроизвольныйИдентификаторПоддерживается = Истина;
			Элементы.ДекорацияНадписьОператорПроизвольногоИдентификатора.Заголовок = ДанныеОператора.Представление + " Приглашение не требуется";
			Если НЕ Лев(Текст, 3) = "2VO" тогда
				Элементы.ОтправитьПриглашение.Доступность = Истина;
			Иначе
				Элементы.ОтправитьПриглашение.Доступность = Ложь;
			КонецЕсли;
			
			Если ДанныеОператора.Автороуминг = "+" тогда
				Элементы.ДекорацияНадписьЗаявка.Видимость = Ложь;
			Иначе
                Элементы.ДекорацияНадписьЗаявка.Видимость = Истина;
			КонецЕсли;
			
		КонецЕсли;
	Иначе       
		ПроизвольныйИдентификаторПоддерживается = Ложь;
		Элементы.ДекорацияНадписьОператорПроизвольногоИдентификатора.Заголовок = "";
		Элементы.ОтправитьПриглашение.Доступность = Ложь;
		Элементы.ДекорацияНадписьЗаявка.Видимость = Ложь;
	КонецЕсли;	
	
КонецПроцедуры 

//Возвращаемое значение:
// Структура, ключ - Представление, значение - Автороуминг (булево)
&НаСервере
Функция ПолучитьПредставлениеИАвтороуминг(ИДОператора)
	
	СтруктураВозврата = Новый Структура;
		
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Макет = ОбработкаОбъект.ПолучитьМакет("СлужебныеДанные"); 
	
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(Макет.Область());
    Построитель.ДобавлениеПредставлений = ТипДобавленияПредставлений.НеДобавлять;
    Построитель.ЗаполнитьНастройки();
    Построитель.Выполнить();
	
	ТЗ = Построитель.Результат.Выгрузить(); 
	ОтборСтрок = Новый Структура;
	
	ОтборСтрок.Вставить("Идентификатор", ИДОператора);
	
	НайденныеСтроки = ТЗ.НайтиСтроки(ОтборСтрок);
	
	Если НЕ НайденныеСтроки.Количество() = 0 тогда
		СтруктураВозврата.Вставить("Идентификатор", НайденныеСтроки[0].Идентификатор);
		СтруктураВозврата.Вставить("Представление", НайденныеСтроки[0].Представление);
		СтруктураВозврата.Вставить("Автороуминг", НайденныеСтроки[0].Автороуминг);
	Иначе
	    СтруктураВозврата = Неопределено;
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыФункции

&НаКлиенте
Процедура НайтиКонтрагентаВЭДО()
	
	ИдентификаторыЭДО.Очистить();
	Элементы.ДекорацияНадписьКонтрагентНеОбнаружен.Видимость = Ложь;
	
	Если НЕ Контрагент.Пустая() И ЗначениеЗаполнено(ИННКонтрагента) Тогда
		ЗаполнитьСписокПриглашений();
	КонецЕсли;	      
	
	ОчиститьПроизвольныйИдентификатор();
	Элементы.ПроизвольныйИдентификатор.ОбновитьТекстРедактирования();
	ОбработатьИзменениеНабораИдентификаторов(ПроизвольныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруХранения1С() Экспорт
	
	ИмяМетаданных = "Конфигурация";
	Кэш = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаКэш);    
	
	Если Кэш.НастройкиОбъект[Кэш.ПрефиксКонфигурации+ИмяМетаданных] = Неопределено Тогда				
		ИнициализацияКэш(Истина);
		Кэш = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаКэш);		
	КонецЕсли;
	
	Настройка = Кэш.НастройкиОбъект[Кэш.ПрефиксКонфигурации+ИмяМетаданных].ХранениеИнформации1С;
	
	СтрокаВызоваСвойствоИдентификатор 			= Настройка.ОФД_ЭДО_ИдентификаторДокумента.ТипОбъектаМетаданных + "." + 
	Настройка.ОФД_ЭДО_ИдентификаторДокумента.Путь + ".НайтиПоНаименованию(" + Символ(034) + 
	Настройка.ОФД_ЭДО_ИдентификаторДокумента.Наименование + Символ(034) + ")";
	
	СтрокаВызоваСвойствоСтатус					= Настройка.ОФД_ЭДО_СтатусДокумента.ТипОбъектаМетаданных + "." + 
	Настройка.ОФД_ЭДО_СтатусДокумента.Путь + ".НайтиПоНаименованию(" + Символ(034) + 
	Настройка.ОФД_ЭДО_СтатусДокумента.Наименование + Символ(034) + ")";
	
	СтрокаВызоваСвойствоИдентификаторУчастника	= Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.ТипОбъектаМетаданных + "." + 
	Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Путь + ".НайтиПоНаименованию(" + Символ(034) + 
	Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Наименование + Символ(034) + ")";
	
	СвойствоИдентификатор 				= Вычислить(СтрокаВызоваСвойствоИдентификатор);									
	СвойствоСтатус						= Вычислить(СтрокаВызоваСвойствоСтатус);
	СвойствоИдентификаторУчастника		= Вычислить(СтрокаВызоваСвойствоИдентификаторУчастника);
	
	СтруктураХранения1С = Новый Структура;
	СтруктураХранения1С.Вставить("СвойствоИдентификатор",			СвойствоИдентификатор);
	СтруктураХранения1С.Вставить("СвойствоСтатус",					СвойствоСтатус);
	СтруктураХранения1С.Вставить("СвойствоИдентификаторУчастника",	СвойствоИдентификаторУчастника);
	СтруктураХранения1С.Вставить("НаименованиеРегистра",			Настройка.Путь);
	
	Возврат СтруктураХранения1С;
	
КонецФункции

&НаСервере
Процедура ИнициализацияКэш(Откат = Ложь)
	
	// Инициализируем Кэш 
	//МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
	Кэш = ЗагрузитьКэш(Откат);
	//ЗначениеВРеквизитФормы(МодульОбъектаОбработки, "Объект"); 
	СохранитьКэш(Кэш);
	// Инициализируем Кэш 
	
КонецПроцедуры

// Функция загрузки Кэш
// Если значение реквизита формы "АдресВременногоХранилищаКэш" заполнено, то берем Кэш из временного хранилища (ШтатныйЗапуск())
&НаСервере
Функция ЗагрузитьКэш(Откат = Ложь)       
	
	Если ЗначениеЗаполнено(ЭтаФорма.АдресВременногоХранилищаКэш) и Не Откат Тогда
		
		Возврат ПолучитьИзВременногоХранилища(ЭтаФорма.АдресВременногоХранилищаКэш);
		
	Иначе
		
		МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
		Кэш = МодульОбъектаОбработки.Инициализация(Откат);
		ЗначениеВРеквизитФормы(МодульОбъектаОбработки, "Объект"); 
		
		Возврат Кэш;
		
	КонецЕсли;
	
КонецФункции

// Функция сохранения Кэш в процессе работы
// В текущий Кэш записываем только требуемые для выгрузки настройки, остальные динамически подргружаем по мере необходимости
&НаСервере
Процедура СохранитьКэш(Кэш)
	
	// Удаляем предыдущее значение Кэш из временного хранилища
	Если ЗначениеЗаполнено(ЭтаФорма.АдресВременногоХранилищаКэш) Тогда
		//УдалитьИзВременногоХранилища(ЭтаФорма.АдресВременногоХранилищаКэш);
		Адрес = ЭтаФорма.АдресВременногоХранилищаКэш;
	Иначе
		Адрес = ЭтаФорма.УникальныйИдентификатор;
	КонецЕсли;
	
	// Записываем новое значение Кэш во временное хранилище
	ЭтаФорма.АдресВременногоХранилищаКэш = ПоместитьВоВременноеХранилище(Кэш, Адрес);	
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПараметрыАвторизацииИПодписанияОрганизации(Организация, AccessTokenОрганизации, RefreshTokenОрганизации, ИспользоватьПодписание, ОтпечатокСертификатаBase64Организации, ПарольДоступаКЗакрытомуКлючуОрганизации, ТипСубъектаОрганизации, МчдGUIDОрганизации, ДатаНачалаДействияМЧДОрганизации, ДолжностьФизлицаОрганизации)

	ПараметрыАвторизацииИПодписанияОрганизации = Новый Структура;
	
	ПараметрыАвторизацииИПодписанияОрганизации.Вставить("AccessToken", AccessTokenОрганизации);
	ПараметрыАвторизацииИПодписанияОрганизации.Вставить("RefreshToken", RefreshTokenОрганизации);
	ПараметрыАвторизацииИПодписанияОрганизации.Вставить("ИспользуетсяПодписание", ИспользоватьПодписание);
	
	ПараметрыПодписания = Новый Структура;
	 
	ПараметрыПодписания.Вставить("ОтпечатокСертификатаBase64", ОтпечатокСертификатаBase64Организации);
	ПараметрыПодписания.Вставить("ПарольДоступаКЗакрытомуКлючу", ПарольДоступаКЗакрытомуКлючуОрганизации);
	Менеджер = ПолучитьМенеджерКриптографии();
	Сертификат  = ПолучитьЭЦППоОтпечатку(Менеджер, Base64Значение(ОтпечатокСертификатаBase64Организации));
	Если ТипЗнч(Сертификат) = Тип("СертификатКриптографии") Тогда 
		ПараметрыПодписания.Вставить("Субъект", Сертификат.Субъект);
	Иначе
		ПараметрыПодписания.Вставить("Субъект", Неопределено);
	КонецЕсли;
	ПараметрыПодписания.Вставить("ТипСубъекта", ТипСубъектаОрганизации);
	ПараметрыПодписания.Вставить("МчдGUID", МчдGUIDОрганизации);
	ПараметрыПодписания.Вставить("ДатаНачалаДействияМЧД", ДатаНачалаДействияМЧДОрганизации);
	ПараметрыПодписания.Вставить("ДолжностьФизлица", ?(ЗначениеЗаполнено(ДолжностьФизлицаОрганизации), ДолжностьФизлицаОрганизации, Неопределено));
	
	ПараметрыАвторизацииИПодписанияОрганизации.Вставить("ПараметрыПодписания", ПараметрыПодписания);
	
	ОбновитьПараметрыАвторизацииИПодписанияОрганизации(Организация, ПараметрыАвторизацииИПодписанияОрганизации);	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПараметрыАвторизацииИПодписанияОрганизации(Организация, ПараметрыАвторизацииИПодписанияОрганизации)
	
	Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	
	Если НЕ Интеграция.Свойство("ПараметрыАвторизацииИПодписания") Тогда
		Интеграция.Вставить("ПараметрыАвторизацииИПодписания", Новый Соответствие);
	КонецЕсли;
		
	Интеграция.ПараметрыАвторизацииИПодписания.Вставить(Организация, ПараметрыАвторизацииИПодписанияОрганизации);	
	
	СохранитьИнтеграциюНаСервере(Интеграция);
	
КонецПроцедуры

// Функция получает параметры интеграции из хранилища общих настроек
// Параметры интеграции хранятся относительно текущего пользователя
&НаСервереБезКонтекста
Функция ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	СписокЗначений = ХранилищеОбщихНастроек.ПолучитьСписок("ОФД_ЭДО_НастройкиОбработки", ПолучитьТекущегоПользователя());
	Интеграция = СписокЗначений.НайтиПоЗначению("Интеграция");
	
	// Информация об интеграции уже есть в хранилище значений 
	Если ТипЗнч(Интеграция) = Тип("ЭлементСпискаЗначений") Тогда
		
		Возврат ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", 	// Ключ объекта
		"Интеграция",															// Ключ настройки 
		"Информация о способе интеграции обработки ОФД ЭДО.", 					// описание настройки
		ПолучитьТекущегоПользователя()); 										// Пользователь
		
	Иначе 
		// Это первый запуск, возвращаем пустую структуру
		Интеграция = Новый Структура;
		Интеграция.Вставить("СпособИнтеграции");
		Интеграция.Вставить("КаталогОбмена");
		Интеграция.Вставить("ИспользоватьКриптографию");
		Интеграция.Вставить("ПараметрыАвторизацииИПодписания", Новый Соответствие);
		Интеграция.Вставить("ВерсияНастроек", ВерсияНастроекОбработки);
		Интеграция.Вставить("МассоваяВыгрузка", Новый Структура);
		
		Возврат Интеграция;
		
	КонецЕсли; 	
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

// Функция сохраняет параметры интеграции в хранилище общих настроек
// Параметры интеграции хранятся относительно текущего пользователя
&НаСервереБезКонтекста
Процедура СохранитьИнтеграциюНаСервере(Интеграция) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", 								// Ключ объекта
	"Интеграция",											// Ключ настройки 
	Интеграция,												// Настройка
	"Информация о способе интеграции обработки ОФД ЭДО.", 	// описание настройки
	ПолучитьТекущегоПользователя()); 						// Пользователь     
	
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокПриглашений()
	
	ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
	
	ПараметрыЗапроса.Параметры.Вставить("<inn>", СокрЛП(ИННКонтрагента));	
	
	ИнформацияОКонтрагенте = ВыполнитьЗапросAPI("API_ИнформацияОКонтрагенте", ПараметрыЗапроса);
	
	Если Не ИнформацияОКонтрагенте.Ошибка Тогда
		
		// Контрагент найден
		ЗаполнитьСписокИдентификаторов(ИнформацияОКонтрагенте);	
		
	Иначе
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не удалось получить информацию о контрагенте из системы ОФД ЭДО."+Символы.ПС+"Описание ошибки:"+Символы.ПС+ИнформацияОКонтрагенте.Описание;
		Сообщение.Сообщить();
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СокрЛП(КППКонтрагента)) Тогда
		ПараметрыЗапроса.Параметры.Вставить("<kpp>", СокрЛП(КППКонтрагента));
	КонецЕсли;
	
	ИнформацияОКонтрагентеПоДаннымФНС = ВыполнитьЗапросAPI("API_ИнформацияОКонтрагентеПоДаннымФНС", ПараметрыЗапроса);
	
	Если Не ИнформацияОКонтрагентеПоДаннымФНС.Ошибка Тогда
		
		// Контрагент найден
		ЗаполнитьСписокИдентификаторов(ИнформацияОКонтрагентеПоДаннымФНС);
		
	КонецЕсли;	
	
	Если ИдентификаторыЭДО.Количество() = 0 Тогда
		Элементы.ДекорацияНадписьКонтрагентНеОбнаружен.Видимость = Истина;	
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ЗаполнитьСписокИдентификаторов(РезультатЗапроса)
	
	ИнформацияОКонтрагенте = РезультатЗапроса; 
	
	Если ТипЗнч(ИнформацияОКонтрагенте.Результат) = Тип("Массив") и ИнформацияОКонтрагенте.Результат.Количество() <> 0 Тогда
		Для Каждого ЭлементРезультата из ИнформацияОКонтрагенте.Результат Цикл
			ИдентификаторАбонента = ЭлементРезультата.gid;
			
			Если ЭлементРезультата.details.Свойство("kpp") Тогда
				КППАбонента = ЭлементРезультата.details.kpp;
			Иначе	
				КППАбонента = "";
			КонецЕсли;	
			
			ПараметрыПоиска = Новый Структура;
			ПараметрыПоиска.Вставить("ИдентификаторКонтрагента", ИдентификаторАбонента);
			СуществующиеСтроки = ИдентификаторыЭДО.НайтиСтроки(ПараметрыПоиска);
			Если НЕ СуществующиеСтроки.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;	
						
			НоваяСтрокаИдентификатора = ИдентификаторыЭДО.Добавить();
			НоваяСтрокаИдентификатора.КПП = КППАбонента;
			НоваяСтрокаИдентификатора.ИдентификаторКонтрагента = ИдентификаторАбонента;
			
			Если Лев(ИдентификаторАбонента, 3) = "2VO" Тогда
				НоваяСтрокаИдентификатора.Оператор = "Платформа ЭДО";
				НоваяСтрокаИдентификатора.СтатусПриглашения = "Не требуется.";
			ИначеЕсли Лев(ИдентификаторАбонента, 3) = "EVR" Тогда
				НоваяСтрокаИдентификатора.Оператор = "Платформа ЭДО тест";
				НоваяСтрокаИдентификатора.СтатусПриглашения = "Не требуется.";
			Иначе
				
				ДанныеОператора = ПолучитьПредставлениеИАвтороуминг(Лев(ИдентификаторАбонента, 3)); 
				
				Если НЕ ДанныеОператора = Неопределено Тогда 
					НоваяСтрокаИдентификатора.Оператор = ДанныеОператора.Представление;
					Если НЕ ДанныеОператора.Автороуминг = "+" Тогда
						НоваяСтрокаИдентификатора.СтатусПриглашения = "Перейти на форму заявки";
					Иначе
						НоваяСтрокаИдентификатора.СтатусПриглашения = ПолучитьСостояниеПриглашения(ИдентификаторОрганизацииВБД, ИдентификаторАбонента);
					КонецЕсли;
				Иначе
					НоваяСтрокаИдентификатора.Оператор = "Неизвестный оператор";
					НоваяСтрокаИдентификатора.СтатусПриглашения = "Перейти на форму заявки";
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;	
	КонецЕсли;	
	
КонецПроцедуры 

&НаСервере
Процедура ОчиститьПроизвольныйИдентификатор()
	
	ПроизвольныйИдентификатор = "";	
	
КонецПроцедуры

&НаКлиенте
Функция СкопироватьКоллекцию(ВходящаяКоллекция)
	
	Если ТипЗнч(ВходящаяКоллекция) = Тип("Структура") Тогда
		НоваяКоллекция = Новый Структура;
	ИначеЕсли ТипЗнч(ВходящаяКоллекция) = Тип("Соответствие") Тогда
		НоваяКоллекция = Новый Соответствие;
	КонецЕсли;
	
	Для Каждого ЭлементКоллекции из ВходящаяКоллекция Цикл
		
		Если ТипЗнч(ЭлементКоллекции.Значение) = Тип("Структура") ИЛИ ТипЗнч(ЭлементКоллекции.Значение) = Тип("Соответствие") Тогда				
			Значение = СкопироватьКоллекцию(ЭлементКоллекции.Значение);			
			НоваяКоллекция.Вставить(ЭлементКоллекции.Ключ, Значение);	
		Иначе
			НоваяКоллекция.Вставить(ЭлементКоллекции.Ключ, ЭлементКоллекции.Значение);
		КонецЕсли;
		
    КонецЦикла;
	
	Возврат НоваяКоллекция;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТекущегоПользователя()
	
	Возврат Неопределено;
	
	Если НЕ Метаданные.ОбщиеМодули.Найти("ПользователиИнформационнойБазы") = Неопределено Тогда
		ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Иначе
		ТекущийПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	КонецЕсли;	
	
	Возврат ТекущийПользователь;
	
КонецФункции

&НаСервере
Процедура УстановитьПараметрСвойстваИдентификатораДинспискаКонтрагентов()
	
	Кэш = ЗагрузитьКэш();
	
	МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
	Настройка = МодульОбъектаОбработки.ПолучитьОбъектНастройкиПоИмениМетаданных("Конфигурация", Кэш);
	
	//ЭтаФорма.СписокКонтрагентов.Параметры
	
	ПутьКЗначениюПараметраВ1С = Настройка.ХранениеИнформации1С["ОФД_ЭДО_ИдентификаторУчастникаЭДО"];
	ЗапросПараметра = Новый Запрос;
	ЗапросПараметра.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	                        |	ИсточникЗначенияПараметра.Ссылка
	                        |ИЗ
	                        |	"+ПутьКЗначениюПараметраВ1С.ИмяОбъектаМетаданных+"."+ПутьКЗначениюПараметраВ1С.Путь+" КАК ИсточникЗначенияПараметра
	                        |ГДЕ
	                        |	ИсточникЗначенияПараметра.Наименование = """+ПутьКЗначениюПараметраВ1С.Наименование+""""
							+?(ПутьКЗначениюПараметраВ1С.ТипОбъектаМетаданных = "Справочники" ИЛИ ПутьКЗначениюПараметраВ1С.ТипОбъектаМетаданных = "Документы" ИЛИ ПутьКЗначениюПараметраВ1С.ТипОбъектаМетаданных = "Обработки" ИЛИ ПутьКЗначениюПараметраВ1С.ТипОбъектаМетаданных = "ПланыВидовХарактеристик", Символы.ПС+"И ИсточникЗначенияПараметра.ПометкаУдаления = Ложь", "");
	ЗначениеПараметра = ЗапросПараметра.Выполнить().Выгрузить()[0].Ссылка;
	
	ЭтаФорма.СписокКонтрагентов.Параметры.УстановитьЗначениеПараметра("СвойствоИдентификаторАбонента", ЗначениеПараметра);
	
КонецПроцедуры	

&НаСервере
Процедура ОпределитьИспользованиеТестовогоКонтура()

	Объект.ЭтоТестоваяОбработка = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", 	// Ключ объекта
				"ЭтоТестовыйКонтур",																// Ключ настройки 
				"Служебный параметр, определяющий соединение с тестовым контуром", 					// описание настройки
				ПолучитьТекущегоПользователя());
				
				
	Если Объект.ЭтоТестоваяОбработка = Неопределено тогда
		
		Объект.ЭтоТестоваяОбработка = Ложь;
		
	КонецЕсли; 
		
КонецПроцедуры


#КонецОбласти

#Область КнопкаПолучитьИдентификаторОрганизации

&НаКлиенте
Процедура ПолучитьИдентификаторОрганизации(Команда)
	
	ИдентификаторАбонента = "";
	Элементы.ДекорацияНадписьОрганизацияНеОбнаружена.Видимость = Ложь;
	
	ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
	
	ПараметрыЗапроса.Параметры.Вставить("<inn>", СокрЛП(Элементы.ИННОрганизации.ТекстРедактирования));
	Если ЗначениеЗаполнено(СокрЛП(Элементы.КППОрганизации.ТекстРедактирования)) Тогда
		ПараметрыЗапроса.Параметры.Вставить("<kpp>", СокрЛП(Элементы.КППОрганизации.ТекстРедактирования));
	КонецЕсли;	
	
	ИнформацияОбОрганизации = ВыполнитьЗапросAPI("API_ИнформацияОКонтрагенте", ПараметрыЗапроса);
	
	Если Не ИнформацияОбОрганизации.Ошибка Тогда
		
		// Такого контрагента нет в системе ЭДО
		Если ИнформацияОбОрганизации.КодСостояния = 0 Тогда
			Элементы.ДекорацияНадписьОрганизацияНеОбнаружена.Видимость = Истина;
		КонецЕсли;
		
		// Контрагент найден
		Если ТипЗнч(ИнформацияОбОрганизации.Результат) = Тип("Массив") и ИнформацияОбОрганизации.Результат.Количество() <> 0 Тогда
			Для Каждого ЭлементРезультата из ИнформацияОбОрганизации.Результат Цикл
				Если Лев(ЭлементРезультата.gid, 3) = "2VO" ИЛИ Лев(ЭлементРезультата.gid, 3) = "EVR" Тогда
					// Найден идентификатор
					ИдентификаторАбонента = ЭлементРезультата.gid;
					Прервать;
				Иначе	
					Продолжить;
				КонецЕсли;
			КонецЦикла;
			
			Если ИдентификаторАбонента = "" Тогда
				Элементы.ДекорацияНадписьОрганизацияНеОбнаружена.Видимость = Истина;
			Иначе	
				Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаСохраненияИдентификатораОрганизации", ЭтотОбъект, ИдентификаторАбонента);			
				ПоказатьВопрос(Оповещение, "Текущий идентификатор организации: "+ИдентификаторОрганизацииВБД+Символы.ПС+"Новый идентификатор организации: "+ИдентификаторАбонента, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, "Обновить идентификатор организации "+Организация+"?");  	
			КонецЕсли;	
			
		Иначе
			Элементы.ДекорацияНадписьОрганизацияНеОбнаружена.Видимость = Истина;
		КонецЕсли;
		
	Иначе
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не удалось получить информацию об абоненте из системы ЭДО."+Символы.ПС+"Описание ошибки:"+Символы.ПС+ИнформацияОбОрганизации.Описание;
		Сообщение.Сообщить();	
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте 
Процедура ПослеЗакрытияВопросаСохраненияИдентификатораОрганизации(РезультатВыбора, ИдентификаторАбонента) Экспорт

	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		
		МассивОрганизаций = Новый Массив;
		ДанныеПоОрганизации = Новый Структура;
		ДанныеПоОрганизации.Вставить("Ссылка", Организация);
		ДанныеПоОрганизации.Вставить("ИНН", СокрЛП(Элементы.ИННОрганизации.ТекстРедактирования));
		ДанныеПоОрганизации.Вставить("КПП", СокрЛП(Элементы.КППОрганизации.ТекстРедактирования));
		ДанныеПоОрганизации.Вставить("Идентификатор", ИдентификаторАбонента);
		МассивОрганизаций.Добавить(ДанныеПоОрганизации);
		
		ОбновитьИдентификаторыУчастниковЭДОНаСервере(МассивОрганизаций);
		
		ИдентификаторОрганизацииВБД = ИдентификаторАбонента;
		
	КонецЕсли;	
	
КонецПроцедуры	
	
