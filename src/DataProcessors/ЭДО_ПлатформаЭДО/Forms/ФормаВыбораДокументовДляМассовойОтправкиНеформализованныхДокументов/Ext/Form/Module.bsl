#Область СлужебныеПроцедурыФункции

&НаСервере
Функция ПолучитьСтруктуруХранения1С() Экспорт
	
	ИмяМетаданных = "Конфигурация";
	Кэш = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаКэш);    
	
	Если Кэш.НастройкиОбъект[Кэш.ПрефиксКонфигурации+ИмяМетаданных] = Неопределено Тогда				
		ИнициализацияКэш(Истина);
		Кэш = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаКэш);		
	КонецЕсли;
	
	Настройка = Кэш.НастройкиОбъект[Кэш.ПрефиксКонфигурации+ИмяМетаданных].ХранениеИнформации1С;
	
	СтрокаВызоваСвойствоИдентификатор 			= Настройка.ОФД_ЭДО_ИдентификаторДокумента.ТипОбъектаМетаданных + "." + 
	Настройка.ОФД_ЭДО_ИдентификаторДокумента.Путь + ".НайтиПоНаименованию(" + Символ(034) + 
	Настройка.ОФД_ЭДО_ИдентификаторДокумента.Наименование + Символ(034) + ")";
	
	СтрокаВызоваСвойствоСтатус					= Настройка.ОФД_ЭДО_СтатусДокумента.ТипОбъектаМетаданных + "." + 
	Настройка.ОФД_ЭДО_СтатусДокумента.Путь + ".НайтиПоНаименованию(" + Символ(034) + 
	Настройка.ОФД_ЭДО_СтатусДокумента.Наименование + Символ(034) + ")";
	
	СтрокаВызоваСвойствоИдентификаторУчастника	= Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.ТипОбъектаМетаданных + "." + 
	Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Путь + ".НайтиПоНаименованию(" + Символ(034) + 
	Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Наименование + Символ(034) + ")";
	
	СвойствоИдентификатор 				= Вычислить(СтрокаВызоваСвойствоИдентификатор);									
	СвойствоСтатус						= Вычислить(СтрокаВызоваСвойствоСтатус);
	СвойствоИдентификаторУчастника		= Вычислить(СтрокаВызоваСвойствоИдентификаторУчастника);
	
	СтруктураХранения1С = Новый Структура;
	СтруктураХранения1С.Вставить("СвойствоИдентификатор",			СвойствоИдентификатор);
	СтруктураХранения1С.Вставить("СвойствоСтатус",					СвойствоСтатус);
	СтруктураХранения1С.Вставить("СвойствоИдентификаторУчастника",	СвойствоИдентификаторУчастника);
	СтруктураХранения1С.Вставить("НаименованиеРегистра",			Настройка.Путь);
	
	Возврат СтруктураХранения1С;
	
КонецФункции

&НаСервере
Процедура ИнициализацияКэш(Откат = Ложь)
	
	// Инициализируем Кэш 
	//МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
	Кэш = ЗагрузитьКэш(Откат);
	//ЗначениеВРеквизитФормы(МодульОбъектаОбработки, "Объект"); 
	СохранитьКэш(Кэш);
	// Инициализируем Кэш 
	
КонецПроцедуры

// Функция загрузки Кэш
// Если значение реквизита формы "АдресВременногоХранилищаКэш" заполнено, то берем Кэш из временного хранилища (ШтатныйЗапуск())
&НаСервере
Функция ЗагрузитьКэш(Откат = Ложь)       
	
	Если ЗначениеЗаполнено(ЭтаФорма.АдресВременногоХранилищаКэш) и Не Откат Тогда
		
		Возврат ПолучитьИзВременногоХранилища(ЭтаФорма.АдресВременногоХранилищаКэш);
		
	Иначе
		
		МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
		Кэш = МодульОбъектаОбработки.Инициализация(Откат);
		ЗначениеВРеквизитФормы(МодульОбъектаОбработки, "Объект"); 
		
		Возврат Кэш;
		
	КонецЕсли;
	
КонецФункции

// Функция сохранения Кэш в процессе работы
// В текущий Кэш записываем только требуемые для выгрузки настройки, остальные динамически подргружаем по мере необходимости
&НаСервере
Процедура СохранитьКэш(Кэш)
	
	// Удаляем предыдущее значение Кэш из временного хранилища
	Если ЗначениеЗаполнено(ЭтаФорма.АдресВременногоХранилищаКэш) Тогда
		//УдалитьИзВременногоХранилища(ЭтаФорма.АдресВременногоХранилищаКэш);
		Адрес = ЭтаФорма.АдресВременногоХранилищаКэш;
	Иначе
		Адрес = ЭтаФорма.УникальныйИдентификатор;
	КонецЕсли;
	
	// Записываем новое значение Кэш во временное хранилище
	ЭтаФорма.АдресВременногоХранилищаКэш = ПоместитьВоВременноеХранилище(Кэш, Адрес);	
	
КонецПроцедуры

&НаСервере
Процедура ОтобразитьИдентификаторОрганизации()
	
	// Отобразим текущий идентификатор в БД, при наличии.
	ИдентификаторОрганизацииВБД = ПолучитьИдентификаторЭДОИз1СПоСсылке(Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораТипаДанных(ВыбранныйЭлемент, СписокПараметров) Экспорт
	
	Если ВыбранныйЭлемент <> Неопределено Тогда
				
		ИмяОткрываемойФормы = "Документ."+ПолучитьИмяОбъектаМетаданных(ВыбранныйЭлемент.Значение)+".ФормаВыбора";	
		
		ПараметрыПодбора = Новый Структура;    
    	ПараметрыПодбора.Вставить("ЗакрыватьПриВыборе", Истина);
    	ПараметрыПодбора.Вставить("МножественныйВыбор", Истина);
		ПараметрыПодбора.Вставить("РежимВыбора", Истина);
		
		Оповещение = Новый ОписаниеОповещения("ОписаниеЗакрытияФормыВыбора", ЭтотОбъект);				
		ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыПодбора, ЭтаФорма, , , , Оповещение);
				
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИмяОбъектаМетаданных(Тип)
	
	Возврат Метаданные.НайтиПоТипу(Тип).Имя;	
	
КонецФункции	

&НаКлиенте
Процедура ОписаниеЗакрытияФормыВыбора(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатЗакрытия = Неопределено Тогда
		
		Для Каждого ОбъектДляПФ из РезультатЗакрытия Цикл
			СписокОбъектовДляВыбораПФ.Добавить(ОбъектДляПФ);
		КонецЦикла;	
		
		ПараметрыОткрытияФормы = Новый Структура();
		ПараметрыОткрытияФормы.Вставить("ЭкземплярДокумента", РезультатЗакрытия[0]);
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОписаниеЗакрытияФормыВыбораПФ", ЭтаФорма);
		ОткрытьФорму(ИмяОбработки + ".Форма.ФормаВыбораПФДляНеформалки", ПараметрыОткрытияФормы, ЭтаФорма, , , , ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеЗакрытияФормыВыбораПФ(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
		
	Если НЕ РезультатЗакрытия = Неопределено Тогда
		
		Для Каждого ОбъектПФ из СписокОбъектовДляВыбораПФ Цикл
			
			ДокументИсточникПечати	= ОбъектПФ.Значение;
			ПолучательПоДокументу	= ПолучитьКонтрагентаИзДокумента(ДокументИсточникПечати);
			ИдентификаторПолучателя	= ПолучитьИдентификаторЭДОИз1СПоСсылке(ПолучательПоДокументу);
			
			Для Каждого ПФ из РезультатЗакрытия Цикл
				
				Если ЗначениеЗаполнено(ПФ.Идентификатор) И ЗначениеЗаполнено(ПФ.МенеджерПечати) Тогда
					
					НоваяСтрока = ТаблицаНеформализованных.Добавить();
					
					НоваяСтрока.Документ					= ДокументИсточникПечати;
					НоваяСтрока.Получатель					= ПолучательПоДокументу;
					НоваяСтрока.ИдентификаторПолучателя		= ИдентификаторПолучателя;
					НоваяСтрока.ПредставлениеПечатнойФормы	= ПФ.Представление;
					НоваяСтрока.ФорматФайла					= ПФ.ФорматФайла;
					НоваяСтрока.ИмяМенеджераПечати			= ПФ.МенеджерПечати;
					НоваяСтрока.ИмяМакета					= ПФ.Идентификатор;
					НоваяСтрока.ДополнительныеПараметры		= ПФ.ДополнительныеПараметры;
					НоваяСтрока.ВидДокумента				= "Неформализованный";
					НоваяСтрока.ЗапрашиватьОтветнуюПодпись  = ЗапрашиватьОтветныеПодписи;
					
				КонецЕсли;
				
			КонецЦикла;	
			
		КонецЦикла;	
			
	КонецЕсли;
	
	СписокОбъектовДляВыбораПФ.Очистить();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКонтрагентаИзДокумента(Документ)
	
	Возврат Документ.Контрагент;
	
КонецФункции	

#КонецОбласти

#Область Интеграция1С

&НаСервере
Функция ПолучитьИдентификаторЭДОИз1СПоСсылке(Ссылка) Экспорт
	
	СтруктураХранения1С = ПолучитьСтруктуруХранения1С();
	СвойствоИдентификатор = СтруктураХранения1С.СвойствоИдентификаторУчастника;
	
	Если СвойствоИдентификатор = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не удалось определить дополнительное свойство для хранения идентификатора участника ЭДО. Отправка невозморжна.";
		Сообщение.Сообщить();
		Возврат Неопределено;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ДополнительныеСведения.Значение КАК Идентификатор
	|ИЗ
	|	РегистрСведений."+СтруктураХранения1С.НаименованиеРегистра+ " КАК ДополнительныеСведения
	|ГДЕ
