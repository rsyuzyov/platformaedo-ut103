#Область КнопкаДополнитьСписок

&НаКлиенте
Процедура ДополнитьСписокПодборомДокументов(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ОбработкаВыбораТипаДанных", ЭтотОбъект);
		
	СписокТипов.ПоказатьВыборЭлемента(Оповещение, "Выбор типа данных");
	
КонецПроцедуры

#КонецОбласти

#Область КнопкаТестФормированияПФ

&НаКлиенте
Процедура ТестФормированияПФ(Команда)
	
    ОписаниеПФ = Элементы.ТаблицаНеформализованных.ТекущиеДанные;
	
	МассивОбъектов = Новый Массив();
	МассивОбъектов.Добавить(ОписаниеПФ.Документ);
	
	ИмяМенеджераПечати				= ОписаниеПФ.ИмяМенеджераПечати;
	ИменаМакетов					= ?(ИмяМенеджераПечати = "СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки", "ВнешняяПечатнаяФорма."+ОписаниеПФ.ИмяМакета, ОписаниеПФ.ИмяМакета);
	ИдентификаторОтправителя		= ПолучитьИдентификаторЭДОИз1СПоСсылке(Организация);
	ИдентификаторПолучателя			= ОписаниеПФ.ИдентификаторПолучателя;
	ПараметрыПечати					= ?(ЗначениеЗаполнено(ОписаниеПФ.ДополнительныеПараметры), ОписаниеПФ.ДополнительныеПараметры, Новый Структура());
	ФорматФайла						= ?(ЗначениеЗаполнено(ОписаниеПФ.ФорматФайла), ОписаниеПФ.ФорматФайла, "pdf");
	ТипФорматаФайла					= ТипФайлаТабличногоДокумента.PDF;
	ДопустимыеТипыОбъектовПечати	= Неопределено;
	ИмяФайла						= СтрЗаменить(ОписаниеПФ.Документ, ":", ".") + ИменаМакетов;
	
	ПараметрыПечати.Вставить("ДополнитьКомплектВнешнимиПечатнымиФормами", Истина);
	ТабличныйДокументРезультат = ВызовФормированияПечатныхФормБСП(ИмяМенеджераПечати, ИменаМакетов, МассивОбъектов, ПараметрыПечати, ДопустимыеТипыОбъектовПечати);
	
	Если ТабличныйДокументРезультат = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Печатная форма """+ОписаниеПФ.ПредставлениеПечатнойФормы+""" по документу """+ОписаниеПФ.Документ+""""
		+Символы.ПС+"для получателя """+ОписаниеПФ.Получатель+""" не была сформирована и отправлена."
		+Символы.ПС+"Не удалось сформировать табличный документ.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;  
	
	Если ТабличныйДокументРезультат.ВысотаТаблицы = 0 Тогда
		// Пустой табличный документ.
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Печатная форма """+ОписаниеПФ.ПредставлениеПечатнойФормы+""" по документу """+ОписаниеПФ.Документ+""""
		+Символы.ПС+"для получателя """+ОписаниеПФ.Получатель+""" не была сформирована и отправлена."
		+Символы.ПС+"Эта печатная форма к указанному документу не применяется.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	ТабличныйДокументРезультат.Показать();
	
КонецПроцедуры

&НаСервере
Функция ВызовФормированияПечатныхФормБСП(ИмяМенеджераПечати, ИменаМакетов, МассивОбъектов, ПараметрыПечати, ДопустимыеТипыОбъектовПечати)
	
	Попытка
		ПечатныеФормы = УправлениеПечатью.СформироватьПечатныеФормы(ИмяМенеджераПечати, ИменаМакетов, МассивОбъектов, ПараметрыПечати, ДопустимыеТипыОбъектовПечати);
		ТабличныйДокументРезультат = ПечатныеФормы.КоллекцияПечатныхФорм[0].ТабличныйДокумент;
		Возврат ТабличныйДокументРезультат;	
	Исключение
		Возврат Неопределено;
	КонецПопытки; 
	
КонецФункции

