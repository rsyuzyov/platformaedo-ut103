#Область ОбработчикиКомандМастера

&НаКлиенте
Процедура МастерНастроекПродолжить(Команда)
	
	Если НомерШагаМастера = 1 и НЕ СпособИнтеграции = 1 тогда
		НомерШагаМастера = НомерШагаМастера + 1;
		ОтобразитьШагМастера();
	ИначеЕсли НомерШагаМастера = 1 И СпособИнтеграции = 1 тогда 
		//СохранитьИнтеграциюНаСервере(Интеграция);
		ЭтаФорма.Закрыть(); 
	ИначеЕсли НомерШагаМастера = 2 тогда
		ЭтаФорма.Закрыть();
	КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура МастерНастроекНазад(Команда)
	
	Если НЕ НомерШагаМастера = 1 тогда
		НомерШагаМастера = НомерШагаМастера - 1;
		ОтобразитьШагМастера();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовМастера

&НаКлиенте
Процедура СпособИнтеграцииМастерПриИзменении(Элемент)  
	
	Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	ОтобразитьСправкуОМетодеРаботы();
	
	Если СпособИнтеграции = 1 тогда
		ЭтаФорма.Элементы.КаталогОбменаМастер.Видимость = Истина;
		ЭтаФорма.Элементы.МастерНастроекПродолжить.Заголовок = "Закончить";
		Если СпособИнтеграции = 1 и Не ЗначениеЗаполнено(Интеграция.КаталогОбмена) Тогда
			КаталогОбмена = ВыбратьКаталог(КаталогОбмена);
		КонецЕсли;
		Интеграция.КаталогОбмена = КаталогОбмена;
		Интеграция.СпособИнтеграции = 1;
		СохранитьИнтеграциюНаСервере(Интеграция);
	ИначеЕсли СпособИнтеграции = 2 тогда 
		ЭтаФорма.Элементы.КаталогОбменаМастер.Видимость = Ложь; 
		ЭтаФорма.Элементы.МастерНастроекПродолжить.Заголовок = "Продолжить";
		// Сохраняем измененное значение интеграции
		Интеграция.СпособИнтеграции = 2;
		СохранитьИнтеграциюНаСервере(Интеграция);
	КонецЕсли;
	
КонецПроцедуры

