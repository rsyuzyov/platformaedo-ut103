&НаКлиенте
Процедура КлиентскиеНастройки(Команда)
	
	ПараметрыОткрытияФормы = Новый Структура(); 
	ПараметрыОткрытияФормы.Вставить("ПрефиксКонфигурации", ПрефиксКонфигурации);
	
	Оповещение = Новый ОписаниеОповещения("ОбработкаЗакрытияФормыПользовательскихНастроекВыгрузки", ЭтотОбъект);
	
	ОткрытьФорму(ИмяОбработки + ".Форма.ФормаРаботыСКлиентскимиФайламиНастроек", ПараметрыОткрытияФормы, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
