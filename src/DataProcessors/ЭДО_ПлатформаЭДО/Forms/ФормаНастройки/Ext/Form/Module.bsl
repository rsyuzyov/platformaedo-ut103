#Область СобытияЭлементовФормы

&НаКлиенте
Процедура СпособИнтеграцииПриИзменении(Элемент = Неопределено)
	
	// Получаем текущее значение интеграции
	Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	
	// Способ интеграции "Каталог"
	Если СпособИнтеграции = 1 Тогда
		Если СпособИнтеграции = 1 и Не ЗначениеЗаполнено(Интеграция.КаталогОбмена) Тогда
			КаталогОбмена = ВыбратьКаталог(КаталогОбмена);
		КонецЕсли;
		Интеграция.КаталогОбмена = КаталогОбмена;
		Интеграция.СпособИнтеграции = 1;  
		Если Не Интеграция.Свойство("ИнтерактивноОбновлятьСтатусыДО") Тогда 
			Интеграция.Вставить("ИнтерактивноОбновлятьСтатусыДО", Неопределено);
		КонецЕсли;
		Интеграция.ИнтерактивноОбновлятьСтатусыДО = Ложь;
		// Удалить++
		Если Не Интеграция.Свойство("РаботаПоУС") Тогда 
			Интеграция.Вставить("РаботаПоУС", Неопределено);
		КонецЕсли;
		Интеграция.РаботаПоУС = Ложь;
		// Удалить--
		
		// Сохраняем измененное значение интеграции
		СохранитьИнтеграциюНаСервере(Интеграция);	
	КонецЕсли;
	// Способ интеграции "Каталог"
	
	// Способ интеграции "API"
	Если СпособИнтеграции = 2 Тогда
		// Сохраняем измененное значение интеграции
		Интеграция.СпособИнтеграции = 2;
		СохранитьИнтеграциюНаСервере(Интеграция);
	КонецЕсли;
	// Способ интеграции "API"
	
	ОтобразитьСправкуОМетодеРаботы();
	
	ОбновитьВидимостьЭлементовФормы();
	
КонецПроцедуры

// Выбор каталога обмена
&НаКлиенте
Процедура КаталогОбменаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	// Диалог выбора
	КаталогОбмена	= ВыбратьКаталог(КаталогОбмена);
	// Сохраняем в настройки измененное значение
	КаталогОбменаПриИзменении(Элемент);
	
КонецПроцедуры

// При изменении каталога обмена (событие отрабатывает по нажатии клавиши Enter после изменения поля ввода)
// Сохраняет изменнное значение каталога в настройки
&НаКлиенте
Процедура КаталогОбменаПриИзменении(Элемент)
	
	Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	Интеграция.КаталогОбмена = КаталогОбмена;
	СохранитьИнтеграциюНаСервере(Интеграция);
	
КонецПроцедуры

&НаКлиенте
Процедура ИнтерактивноОбновлятьСтатусыДОПриИзменении(Элемент)
	
	Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	
	Если Не Интеграция.Свойство("ИнтерактивноОбновлятьСтатусыДО") Тогда 
		Интеграция.Вставить("ИнтерактивноОбновлятьСтатусыДО", Неопределено);
	КонецЕсли;
	
	Если ИнтерактивноОбновлятьСтатусыДО Тогда
		Интеграция.ИнтерактивноОбновлятьСтатусыДО = Истина;
	Иначе 
		Интеграция.ИнтерактивноОбновлятьСтатусыДО = Ложь;
	КонецЕсли;
	
	СохранитьИнтеграциюНаСервере(Интеграция);
	
КонецПроцедуры

// Удалить++
&НаКлиенте
Процедура РаботаПоУСПриИзменении(Элемент)
	
	Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	
	Если Не Интеграция.Свойство("РаботаПоУС") Тогда 
		Интеграция.Вставить("РаботаПоУС", Неопределено);
	КонецЕсли;
	
	Если РаботаемПоУС Тогда
		Интеграция.РаботаПоУС = Истина;
	Иначе 
		Интеграция.РаботаПоУС = Ложь;
	КонецЕсли;
	
	СохранитьИнтеграциюНаСервере(Интеграция);
	
КонецПроцедуры
