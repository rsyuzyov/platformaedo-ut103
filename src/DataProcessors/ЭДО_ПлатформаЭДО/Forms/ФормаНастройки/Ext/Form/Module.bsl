#Область КнопкиАвторизации

&НаКлиенте
Процедура ОткрытьФормуАвторизации(Команда)
	
	ПорядковыйНомерГруппы = Число(Прав(Команда.Имя, СтрДлина(Команда.Имя) - СтрДлина("ОткрытьФормуАвторизации")));
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("Организация", ЭтаФорма["Авторизация_Организация"+ПорядковыйНомерГруппы]);
	ПараметрыОткрытияФормы.Вставить("ПорядковыйНомерГруппы", ПорядковыйНомерГруппы);
	
	ОповещениеОЗакрытииФормыАвторизации = Новый ОписаниеОповещения("ПослеЗакрытияФормыАвторизации", ЭтотОбъект);
	ОткрытьФорму(ИмяОбработки + ".Форма.ФормаАвторизацииПользователя", ПараметрыОткрытияФормы, ЭтаФорма, , , , ОповещениеОЗакрытииФормыАвторизации, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыАвторизации(Результат, ДопПараметры) Экспорт

	Если НЕ Результат = Неопределено Тогда
		
		Если Результат.АвторизацияУспешна = Истина Тогда
			
			ПорядковыйНомерГруппы = Результат.ПорядковыйНомерГруппы;
			
			ЭтаФорма["Авторизация_AccessTokenОрганизации"+ПорядковыйНомерГруппы] = Результат.AccessToken;
			ЭтаФорма["Авторизация_RefreshTokenОрганизации"+ПорядковыйНомерГруппы] = Результат.RefreshToken;
			
			ОбновитьПараметрыАвторизации(ПорядковыйНомерГруппы);
			
		КонецЕсли;	
		
	КонецЕсли;	
	
КонецПроцедуры

