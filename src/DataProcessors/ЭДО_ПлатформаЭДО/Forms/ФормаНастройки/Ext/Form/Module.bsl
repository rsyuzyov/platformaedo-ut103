&НаКлиенте
Процедура ОтобразитьМастерНастроек()
	
	//Скрываем основные элементы для вывода мастера
	Этаформа.Элементы.ОсновнаяГруппа.Видимость = Ложь;
	ЭтаФорма.Элементы.МастерНастроек.Видимость = Истина; 
	ЭтаФорма.Элементы.ПараметрыАвторизацииИПодписания.Видимость = Ложь; 
	ЭтаФорма.Заголовок = "Мастер настройки";
	ЭтотОбъект.ПоказыватьСлужебныеРеквизиты = Истина;
	ОтобразитьСправкуОМетодеРаботы();
	ОтобразитьШагМастера();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьШагМастера()
	
	Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	ДобавитьРеквизитыМастера();
	СпособИнтеграцииМастерПриИзменении(ЭтаФорма.Элементы.СпособИнтеграцииМастер);
	
	Если НомерШагаМастера = 1 тогда
		
		ТекстШагаМастера = "Произведите первоначальную настройку обработки." + Символы.ПС +  "Выберите способ интеграции:";
		Если СпособИнтеграции = 1 тогда
			ЭтаФорма.Элементы.КаталогОбменаМастер.Видимость = Истина; 
			ЭтаФорма.Элементы.МастерНастроекПродолжить.Заголовок = "Закончить";
		КонецЕсли; 
		
		ЭтаФорма.Элементы.ГруппаШаг2.Видимость = Ложь;
		ЭтаФорма.Элементы.МастерНастроекНазад.Видимость = Ложь; 
		ЭтаФорма.Элементы.ТекущийПользователь.Видимость = Ложь;
		
	КонецЕсли;
	
	Если НомерШагаМастера = 2 тогда
		
		//Скрываем предыдущий шаг
		ЭтаФорма.Элементы.ГруппаШаг1.Видимость = Ложь;
		ЭтаФорма.Элементы.СпособИнтеграцииМастер.Видимость = Ложь;
		ЭтаФорма.Элементы.ПолеСправкаОМетодеРаботыМастер.Видимость = Ложь;
		
		ЭтаФорма.Элементы.ГруппаШаг2.Видимость = Истина;
		ЭтаФорма.Элементы.ТекущийПользователь.Видимость = Истина;

		//To do: добавить возможность скрывать часть орагнизаций из списка
		Если СпособИнтеграции = 2 тогда  //API
			
			//ТекстШагаМастера = ПолучитьТекстВторогоШага();
			//ЭтаФорма.Элементы.ПолеТекстШага.АвтоМаксимальнаяВысота = Истина;
			//ЭтаФорма.Элементы.ПолеТекстШага.РастягиватьПоВертикали = Истина;
			ЭтаФорма.Элементы.ПолеТекстШага.Видимость = Ложь;
			ЭтаФорма.Элементы.ОписаниеШага2.Видимость = Истина;
			
		ИначеЕсли СпособИнтеграции = 1 тогда //Каталога
			
			ЭтаФорма.Элементы.КаталогОбменаМастер.Видимость = Истина;
			ЭтаФорма.Элементы.ПараметрыАвторизацииИПодписания.Видимость = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьРеквизитыМастера()
	
	Если НомерШагаМастера = 1 тогда 
		
		ЭтаФорма.Элементы.МастерНастроекПродолжить.Заголовок = "Следующий шаг";
		СпособИнтеграции = 2; 
		
	ИначеЕсли НомерШагаМастера = 2 тогда 
		
		ЭтаФорма.Элементы.Переместить(ЭтаФорма.Элементы.ПараметрыАвторизацииИПодписания, ЭтаФорма.Элементы.ГруппаШаг2);
		ЭтаФорма.Элементы.Переместить(ЭтаФорма.Элементы.ПолеТекстШага, ЭтаФорма.Элементы.ПараметрыАвторизацииИПодписания, ЭтаФорма.Элементы.ГруппаОрганизация1ДанныеЭДО);
		ЭтаФорма.Элементы.ПараметрыАвторизацииИПодписания.Видимость = Истина;
		ЭтаФорма.Элементы.МастерНастроекПродолжить.Заголовок = "Закончить"; 
		
	КонецЕсли
	
КонецПроцедуры

