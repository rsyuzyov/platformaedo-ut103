&НаКлиенте
Процедура ЗаполнитьСписокСертификатовВСписке(ПорядковыйНомерГруппы)
	
	Элемент = Элементы["СертификатОрганизации"+ПорядковыйНомерГруппы];
	
	Попытка
		Менеджер = ПолучитьМенеджерКриптографии();			
	Исключение
		ЭтаФорма["СертификатОрганизации"+ПорядковыйНомерГруппы] = "Сертификаты не обнаружены";
		Сообщить("Подключение " + Элемент.ВыделенныйТекст + " не удалось.");
		Возврат ;
	КонецПопытки;
	
	Элементы["СертификатОрганизации"+ПорядковыйНомерГруппы].СписокВыбора.Очистить();
	
	СписокДоступныхСертификатов = ЗаполнитьСписокСертификатов(Менеджер);
	
	Если СписокДоступныхСертификатов.Количество() <> 0 Тогда
		
		КоличествоДоступныхСертификатовОрганизации = 0;
		
		Для Каждого ТекущийСертификат Из СписокДоступныхСертификатов Цикл
			
			Сертификат_ИНН = "";
			
			Если ТекущийСертификат.Значение.Субъект.Свойство("OID1_2_643_100_4") Тогда
				Сертификат_ИНН = ТекущийСертификат.Значение.Субъект.OID1_2_643_100_4;
			ИначеЕсли ТекущийСертификат.Значение.Субъект.Свойство("OID1_2_643_3_131_1_1") Тогда
				Сертификат_ИНН = ТекущийСертификат.Значение.Субъект.OID1_2_643_3_131_1_1;
			ИначеЕсли ТекущийСертификат.Значение.Субъект.Свойство("INNLE") Тогда
				Сертификат_ИНН = ТекущийСертификат.Значение.Субъект.INNLE;
			ИначеЕсли ТекущийСертификат.Значение.Субъект.Свойство("ИННЮЛ") Тогда
				Сертификат_ИНН = ТекущийСертификат.Значение.Субъект.ИННЮЛ;
			ИначеЕсли ТекущийСертификат.Значение.Субъект.Свойство("ИНН_ЮЛ") Тогда
				Сертификат_ИНН = ТекущийСертификат.Значение.Субъект.ИНН_ЮЛ;
			ИначеЕсли ТекущийСертификат.Значение.Субъект.Свойство("ИНН") Тогда
				Сертификат_ИНН = ТекущийСертификат.Значение.Субъект.ИНН;
			ИначеЕсли ТекущийСертификат.Значение.Субъект.Свойство("ИННОрганизации") Тогда
				Сертификат_ИНН = ТекущийСертификат.Значение.Субъект.ИННОрганизации;
			ИначеЕсли ТекущийСертификат.Значение.Субъект.Свойство("ИНН_Организации") Тогда
				Сертификат_ИНН = ТекущийСертификат.Значение.Субъект.ИНН_Организации;	
			КонецЕсли;	
			
			Если Сертификат_ИНН = "" Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрДлина(Сертификат_ИНН) = 12 И Лев(Сертификат_ИНН, 2) = "00" Тогда
				Сертификат_ИНН = Прав(Сертификат_ИНН, 10);	
			КонецЕсли;	
			
			ЭтоСертификатЮЛ = Ложь;
			ЭтоСертификатИП = Ложь;
			ЭтоСертификатФЛ = Ложь;
			
			Если НЕ ЭтаФорма["ИНН_Организации"+ПорядковыйНомерГруппы] = "" Тогда
				
				СубъектСодержитОГРНИП = Ложь;
				
				Если ТекущийСертификат.Значение.Субъект.Свойство("OID1_2_643_100_5") Тогда
					СубъектСодержитОГРНИП = Истина;
				ИначеЕсли ТекущийСертификат.Значение.Субъект.Свойство("OID_1_2_643_100_1") Тогда
					СубъектСодержитОГРНИП = Истина;	
				ИначеЕсли ТекущийСертификат.Значение.Субъект.Свойство("ОГРН") Тогда
					СубъектСодержитОГРНИП = Истина;
				ИначеЕсли ТекущийСертификат.Значение.Субъект.Свойство("ОГРНИП") Тогда
					СубъектСодержитОГРНИП = Истина;	
				ИначеЕсли ТекущийСертификат.Значение.Субъект.Свойство("OGRN") Тогда
					СубъектСодержитОГРНИП = Истина;
				ИначеЕсли ТекущийСертификат.Значение.Субъект.Свойство("OGRNIP") Тогда
					СубъектСодержитОГРНИП = Истина;	
				КонецЕсли;	
				
				Если СтрНайти(Сертификат_ИНН, ЭтаФорма["ИНН_Организации"+ПорядковыйНомерГруппы])>0 Тогда
					// Это сертификат ЮЛ или ИП.
					Если СтрДлина(Сертификат_ИНН) = 10 Тогда
						// Если ИНН 10 символов - ЮЛ.
						ЭтоСертификатЮЛ = Истина;
					ИначеЕсли СтрДлина(Сертификат_ИНН) = 12 И СубъектСодержитОГРНИП Тогда	
						// Если ИНН 12 символов и есть ОГРН ИП, то сертификат ИП.
						ЭтоСертификатИП = Истина;
					КонецЕсли;	
				Иначе
					// Если в структуре субъекта нет ОГРН ИП, это сертификат ФЛ.
					Если СтрДлина(Сертификат_ИНН) = 12 И НЕ Лев(Сертификат_ИНН, 2) = "00" И НЕ СубъектСодержитОГРНИП Тогда
						ЭтоСертификатФЛ = Истина;
					ИначеЕсли СтрДлина(Сертификат_ИНН) = 12 И НЕ Лев(Сертификат_ИНН, 2) = "00" И СубъектСодержитОГРНИП Тогда
						// Если ИНН 12 символов и есть ОГРН ИП, то сертификат ИП.
						// Даже если ИП сам по себе не является "организацией-продавцом".
						ЭтоСертификатИП = Истина;	
					КонецЕсли;	
				КонецЕсли;	
				
			КонецЕсли;	
			
			Если ЭтоСертификатЮЛ ИЛИ ЭтоСертификатИП Тогда 
				Если НЕ ЭтаФорма["ИНН_Организации"+ПорядковыйНомерГруппы] = "" И СтрНайти(Сертификат_ИНН, ЭтаФорма["ИНН_Организации"+ПорядковыйНомерГруппы])>0 Тогда
					Представление = ?(ТекущийСертификат.Значение.Субъект.Свойство("T"), ТекущийСертификат.Значение.Субъект.T+ " ", "ИП ") + 
					?(ТекущийСертификат.Значение.Субъект.Свойство("CN"), ТекущийСертификат.Значение.Субъект.CN + " / ", " / ") + 
					ТекущийСертификат.Значение.Субъект.SN + " " + 
					?(ТекущийСертификат.Значение.Субъект.Свойство("GN"), ТекущийСертификат.Значение.Субъект.GN, "") + 
					" действует до " + Формат(ТекущийСертификат.Значение.ДатаОкончания, "ДФ=dd.MM.yyyy");
					Элементы["СертификатОрганизации"+ПорядковыйНомерГруппы].СписокВыбора.Добавить(Base64Строка(ТекущийСертификат.Значение.Отпечаток), Представление);
					КоличествоДоступныхСертификатовОрганизации = КоличествоДоступныхСертификатовОрганизации+1;
				КонецЕсли;
			ИначеЕсли ЭтоСертификатФЛ Тогда
				Представление = "Физическое лицо " + 
				ТекущийСертификат.Значение.Субъект.CN +   
				" действует до " + Формат(ТекущийСертификат.Значение.ДатаОкончания, "ДФ=dd.MM.yyyy");
				Элементы["СертификатОрганизации"+ПорядковыйНомерГруппы].СписокВыбора.Добавить(Base64Строка(ТекущийСертификат.Значение.Отпечаток), Представление);
				КоличествоДоступныхСертификатовОрганизации = КоличествоДоступныхСертификатовОрганизации+1;
			КонецЕсли;
			
		КонецЦикла;
		
		Если КоличествоДоступныхСертификатовОрганизации = 0 Тогда
			Элементы["СертификатОрганизации"+ПорядковыйНомерГруппы].Доступность = Ложь;
			ЭтаФорма["СертификатОрганизации"+ПорядковыйНомерГруппы] = "Сертификаты не обнаружены";
			Элементы["ПарольДоступаКЗакрытомуКлючу"+ПорядковыйНомерГруппы].Доступность = Ложь;
			Элементы["КнопкаПолучитьТокенАвторизацииПоПодписи"+ПорядковыйНомерГруппы].Доступность = Ложь;
		Иначе
			Элементы["СертификатОрганизации"+ПорядковыйНомерГруппы].Доступность = Истина;
			Элементы["ПарольДоступаКЗакрытомуКлючу"+ПорядковыйНомерГруппы].Доступность = Истина;
			Элементы["КнопкаПолучитьТокенАвторизацииПоПодписи"+ПорядковыйНомерГруппы].Доступность = Истина;
		КонецЕсли;	
		
	Иначе
		//Сообщить("Персональные сертификаты отсутствуют в менеджере криптографии.");			
	КонецЕсли; 		
	
КонецПроцедуры

&НаКлиенте
Процедура СертификатВСпискеПриИзменении(Элемент)
	
	Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	
	ЭтоСертификатФЛ = Ложь;
	
	ПорядковыйНомерГруппы = Число(Прав(Элемент.Имя, СтрДлина(Элемент.Имя) - СтрДлина("СертификатОрганизации")));
	
	Если ЭтаФорма["СертификатОрганизации"+ПорядковыйНомерГруппы] = "" ИЛИ ЭтаФорма["СертификатОрганизации"+ПорядковыйНомерГруппы] = "Сертификаты не обнаружены" Тогда
		ЭтаФорма.Элементы["ГруппаОрганизация"+ПорядковыйНомерГруппы+"ДанныеМЧД"].Видимость = Ложь;
		ЭтаФорма["ОтпечатокСертификатаОрганизацииBase64"+ПорядковыйНомерГруппы] = "";
		ЭтаФорма["GUIDДоверенности"+ПорядковыйНомерГруппы] = "";
		ЭтаФорма["ПарольДоступаКЗакрытомуКлючу"+ПорядковыйНомерГруппы] = "";
		//ЭтаФорма["Авторизация_ТокенОрганизации"+ПорядковыйНомерГруппы] = "";
		ОбновитьПараметрыАвторизации(ПорядковыйНомерГруппы);
		Возврат;
	КонецЕсли;	
	
	Этаформа["ОтпечатокСертификатаОрганизацииBase64"+ПорядковыйНомерГруппы] = ЭтаФорма["СертификатОрганизации"+ПорядковыйНомерГруппы];
	
	Менеджер = ПолучитьМенеджерКриптографии();
	
	Сертификат  = ПолучитьЭЦППоОтпечатку(Менеджер, Base64Значение(Этаформа["ОтпечатокСертификатаОрганизацииBase64"+ПорядковыйНомерГруппы]));
	
	Если НЕ Сертификат = Неопределено Тогда
		
		Сертификат_ИНН = "";
		
		Если Сертификат.Субъект.Свойство("OID1_2_643_100_4") Тогда
			Сертификат_ИНН = Сертификат.Субъект.OID1_2_643_100_4;
		ИначеЕсли Сертификат.Субъект.Свойство("OID1_2_643_3_131_1_1") Тогда
			Сертификат_ИНН = Сертификат.Субъект.OID1_2_643_3_131_1_1;
		ИначеЕсли Сертификат.Субъект.Свойство("INNLE") Тогда
			Сертификат_ИНН = Сертификат.Субъект.INNLE;
		ИначеЕсли Сертификат.Субъект.Свойство("ИННЮЛ") Тогда
			Сертификат_ИНН = Сертификат.Субъект.ИННЮЛ;
		ИначеЕсли Сертификат.Субъект.Свойство("ИНН_ЮЛ") Тогда
			Сертификат_ИНН = Сертификат.Субъект.ИНН_ЮЛ;
		ИначеЕсли Сертификат.Субъект.Свойство("ИНН") Тогда
			Сертификат_ИНН = Сертификат.Субъект.ИНН;
		ИначеЕсли Сертификат.Субъект.Свойство("ИННОрганизации") Тогда
			Сертификат_ИНН = Сертификат.Субъект.ИННОрганизации;
		ИначеЕсли Сертификат.Субъект.Свойство("ИНН_Организации") Тогда
			Сертификат_ИНН = Сертификат.Субъект.ИНН_Организации;	
		КонецЕсли;
		
		СубъектСодержитОГРНИП = Ложь;
		
		Если Сертификат.Субъект.Свойство("OID1_2_643_100_5") Тогда
			СубъектСодержитОГРНИП = Истина;
		ИначеЕсли Сертификат.Субъект.Свойство("OID_1_2_643_100_1") Тогда
			СубъектСодержитОГРНИП = Истина;	
		ИначеЕсли Сертификат.Субъект.Свойство("ОГРН") Тогда
			СубъектСодержитОГРНИП = Истина;
		ИначеЕсли Сертификат.Субъект.Свойство("ОГРНИП") Тогда
			СубъектСодержитОГРНИП = Истина;	
		ИначеЕсли Сертификат.Субъект.Свойство("OGRN") Тогда
			СубъектСодержитОГРНИП = Истина;
		ИначеЕсли Сертификат.Субъект.Свойство("OGRNIP") Тогда
			СубъектСодержитОГРНИП = Истина;	
		КонецЕсли;
		
		Если НЕ СтрНайти(Сертификат_ИНН, ЭтаФорма["ИНН_Организации"+ПорядковыйНомерГруппы])>0 И СтрДлина(Сертификат_ИНН) = 12 И НЕ Лев(Сертификат_ИНН, 2) = "00" И НЕ СубъектСодержитОГРНИП Тогда
			// Это сертификат ФЛ.
			ЭтоСертификатФЛ = Истина;
		КонецЕсли;  
		ЭтаФорма.Элементы["GUIDДоверенности"+ПорядковыйНомерГруппы].Доступность = ЭтоСертификатФЛ;
		СертификатСтрока = ?(ЭтоСертификатФЛ, "Физическое лицо", ?(Сертификат.Субъект.Свойство("T"), Сертификат.Субъект.T, "ИП")) + " " + Сертификат.Субъект.CN + " / " + Сертификат.Субъект.SN + " " + Сертификат.Субъект.GN;		
		
	Иначе
		
		ЭтаФорма["ПриРаботеСОрганизациейИспользуетсяПодписание"+ПорядковыйНомерГруппы] = Ложь;	
		
	КонецЕсли;	
	
	Организация = ЭтаФорма["Авторизация_Организация"+ПорядковыйНомерГруппы];
	ПараметрыАвторизацииИПодписанияОрганизации = Интеграция.ПараметрыАвторизацииИПодписания.Получить(Организация);
	
	Если НЕ ПараметрыАвторизацииИПодписанияОрганизации = Неопределено И ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.Свойство("ОтпечатокСертификатаBase64") И НЕ Этаформа["ОтпечатокСертификатаОрганизацииBase64"+ПорядковыйНомерГруппы] = ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.ОтпечатокСертификатаBase64	Тогда
		ЭтаФорма["GUIDДоверенности"+ПорядковыйНомерГруппы] = "";
		ЭтаФорма["ПарольДоступаКЗакрытомуКлючу"+ПорядковыйНомерГруппы] = "";
		ЭтаФорма["ПриРаботеСОрганизациейИспользуетсяПодписание"+ПорядковыйНомерГруппы] = Ложь;
	КонецЕсли;	
	
	ЭтаФорма["СертификатОрганизации"+ПорядковыйНомерГруппы] = СертификатСтрока;
	ЭтаФорма["ТипСертификатаОрганизации"+ПорядковыйНомерГруппы] = ?(ЭтоСертификатФЛ, "ФЛ", "ЮЛ/ИП");
	ЭтаФорма["ПриРаботеСОрганизациейИспользуетсяПодписание"+ПорядковыйНомерГруппы] = Истина;
	Элементы["ГруппаОрганизация"+ПорядковыйНомерГруппы+"ДанныеМЧД"].Видимость = ?(ЭтоСертификатФЛ, Истина, Ложь);
	
	Если ЭтоСертификатФЛ тогда
	ПереместитьЭлементФормы("ГруппаОрганизация"+ПорядковыйНомерГруппы+"ДанныеМЧД", "ГруппаОрганизация"+ПорядковыйНомерГруппы+"ДанныеЭДО", "ГруппаОрганизация"+ПорядковыйНомерГруппы+"Кнопки");
	КонецЕсли;

	ОбновитьПараметрыАвторизации(ПорядковыйНомерГруппы);
	ОбновитьВидимостьЭлементовФормы();
	
КонецПроцедуры

&НаСервере
Процедура ПереместитьЭлементФормы(ПеремещаемыйЭлемент, КудаПереместить, Порядок)
	
	Если НЕ Порядок = "" тогда
		ЭтаФорма.Элементы.Переместить(ЭтаФорма.Элементы[ПеремещаемыйЭлемент], ЭтаФорма.Элементы[КудаПереместить], ЭтаФорма.Элементы[Порядок]);
	Иначе
		ЭтаФорма.Элементы.Переместить(ЭтаФорма.Элементы[ПеремещаемыйЭлемент], ЭтаФорма.Элементы[КудаПереместить]);
	КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура GUIDДоверенностиВСпискеПриИзменении(Элемент)
	
	ПорядковыйНомерГруппы = Число(Прав(Элемент.Имя, СтрДлина(Элемент.Имя) - СтрДлина("GUIDДоверенности")));
	ИдентификаторОрганизации = "";
	ДатаВыдачиДоверенности = "";
	
	ОрганизацияГруппы = ЭтаФорма["Авторизация_Организация"+ПорядковыйНомерГруппы];
	ИННОрганизацииГруппы = ЭтаФорма["ИНН_Организации"+ПорядковыйНомерГруппы];
	КППОрганизацииГруппы = ЭтаФорма["КПП_Организации"+ПорядковыйНомерГруппы];
	GUIDДоверенностиГруппы = ЭтаФорма["GUIDДоверенности"+ПорядковыйНомерГруппы];
	ИдентификаторОрганизации = ПолучитьИдентификаторЭДОИз1СПоСсылке(ЭтаФорма["Авторизация_Организация"+ПорядковыйНомерГруппы]);
	
	Если НЕ ЗначениеЗаполнено(ЭтаФорма["Авторизация_AccessTokenОрганизации"+ПорядковыйНомерГруппы]) Тогда
		Возврат
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторОрганизации) Тогда		
		ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
		ПараметрыЗапроса.Параметры.Вставить("<inn>", ИННОрганизацииГруппы);
		Если ЗначениеЗаполнено(КППОрганизацииГруппы) Тогда
			ПараметрыЗапроса.Параметры.Вставить("<kpp>", КППОрганизацииГруппы);
		КонецЕсли;	
		ИнформацияОбАбоненте = ВыполнитьЗапросAPI("API_ИнформацияОбАбоненте", ПараметрыЗапроса, ПорядковыйНомерГруппы);		
		Если Не ИнформацияОбАбоненте.Ошибка Тогда
			Если ТипЗнч(ИнформацияОбАбоненте.Результат) = Тип("Массив") и ИнформацияОбАбоненте.Результат.Количество() <> 0 Тогда
				Для Каждого ЭлементРезультата из ИнформацияОбАбоненте.Результат Цикл
					Если Лев(ЭлементРезультата.gid, 3) = "2VO" Тогда
						ИдентификаторОрганизации = ЭлементРезультата.gid;
					КонецЕсли;
				КонецЦикла;		
			КонецЕсли;
		Иначе
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Сообщение.Текст = "Не удалось получить информацию об абоненте организации "+ОрганизацияГруппы+" для получения идентификатора абонента."+Символы.ПС+"Описание ошибки:";
			Сообщение.Сообщить();
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ИнформацияОбАбоненте.Описание;
			Сообщение.Сообщить();
		КонецЕсли;			
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторОрганизации) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Сообщение.Текст = "Не удалось получить информацию об абоненте организации "+ОрганизацияГруппы+" для получения идентификатора абонента."
		+Символы.ПС+"Получение инфомации по МЧД возможно только при наличии идентификатора абонента ЭДО.";
		Сообщение.Сообщить();
		ЭтаФорма["ДатаНачалаДействияМЧД"+ПорядковыйНомерГруппы] = "";
		Возврат;
	КонецЕсли;	
	
	ПараметрыЗапросаДанныхАбонента = ПолучитьШаблонПараметровЗапроса();
	ПараметрыЗапросаДанныхАбонента.Параметры.Вставить("<gid>", ИдентификаторОрганизации);
	РезультатЗапросаДанныхАбонента = ВыполнитьЗапросAPI("API_ИнформацияОбАбоненте", ПараметрыЗапросаДанныхАбонента, ПорядковыйНомерГруппы);
	Если РезультатЗапросаДанныхАбонента.Ошибка = Истина Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось получить информацию об абоненте организации "+ОрганизацияГруппы+" с идентификатором "+ИдентификаторОрганизации+".";
		Сообщение.Сообщить();
		ЭтаФорма["ДатаНачалаДействияМЧД"+ПорядковыйНомерГруппы] = "";
		Возврат;
	ИначеЕсли НЕ ЗначениеЗаполнено(РезультатЗапросаДанныхАбонента.Результат) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось получить информацию об абоненте организации "+ОрганизацияГруппы+" с идентификатором "+ИдентификаторОрганизации+".";
		Сообщение.Сообщить();
		ЭтаФорма["ДатаНачалаДействияМЧД"+ПорядковыйНомерГруппы] = "";
		Возврат;
	ИначеЕсли РезультатЗапросаДанныхАбонента.Результат.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось получить информацию об абоненте организации "+ОрганизацияГруппы+" с идентификатором "+ИдентификаторОрганизации+".";
		Сообщение.Сообщить();
		ЭтаФорма["ДатаНачалаДействияМЧД"+ПорядковыйНомерГруппы] = "";
		Возврат;
	КонецЕсли;
	ИдентификаторАбонентаОрганизации = Формат(РезультатЗапросаДанныхАбонента.Результат[0].id, "ЧГ=0");
	ПараметрыЗапросаДанныхМЧД = ПолучитьШаблонПараметровЗапроса();
	ПараметрыЗапросаДанныхМЧД.Параметры.Вставить("<МчдGUID>",		ЭтаФорма["GUIDДоверенности"+ПорядковыйНомерГруппы]);
	ПараметрыЗапросаДанныхМЧД.Параметры.Вставить("<issuer-inn>",	ИННОрганизацииГруппы);
	ПараметрыЗапросаДанныхМЧД.Параметры.Вставить("<subscriber-id>",	ИдентификаторАбонентаОрганизации);
	Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	
	СтруктураДанныхФЛ = ПолучитьИННФЛ(Интеграция.ПараметрыАвторизацииИПодписания[ОрганизацияГруппы].ПараметрыПодписания.Субъект);
	ИННДоверенногоЛица = СтруктураДанныхФЛ.ИННФЛ;
	ПараметрыЗапросаДанныхМЧД.Параметры.Вставить("<&attorney-inn>", ИННДоверенногоЛица);
		
	РезультатЗапросаДанныхМЧД = ВыполнитьЗапросAPI("API_ПолучитьИнформациюПоМЧД", ПараметрыЗапросаДанныхМЧД, ПорядковыйНомерГруппы);
		
	Если РезультатЗапросаДанныхМЧД.Ошибка = Истина Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось определить дату выдачи МЧД от организации "+ОрганизацияГруппы+" для подписи физического лица."
		+Символы.ПС+"Указанный номер доверенности: "+GUIDДоверенностиГруппы+".";
		Сообщение.Сообщить();
		ЭтаФорма["ДатаНачалаДействияМЧД"+ПорядковыйНомерГруппы] = "";
		Возврат;
	КонецЕсли;
	ДатаВыдачиДоверенности = РезультатЗапросаДанныхМЧД.Результат.content.документ.довер.свДов.датаВыдДовер;
	
	ЭтаФорма["ДатаНачалаДействияМЧД"+ПорядковыйНомерГруппы] = ДатаВыдачиДоверенности;
	
	ОбновитьПараметрыАвторизации(ПорядковыйНомерГруппы);
	
КонецПроцедуры

Функция ПолучитьИННФЛ(СтруктураСубъекта);
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ИННФЛ", "");
	
	Если СтруктураСубъекта.Свойство("OID1_2_643_3_131_1_1") тогда
		СтруктураВозврата.ИННФЛ = СтруктураСубъекта.OID1_2_643_3_131_1_1;
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаКлиенте
Процедура ДолжностьФизлицаПриИзменении(Элемент)
	
	ПорядковыйНомерГруппы = Число(Прав(Элемент.Имя, СтрДлина(Элемент.Имя) - СтрДлина("ДолжностьФизлица")));
	
	ОбновитьПараметрыАвторизации(ПорядковыйНомерГруппы);
	
КонецПроцедуры

&НаКлиенте
Процедура AccessТокенВСпискеПриИзменении(Элемент)
	
	ПорядковыйНомерГруппы = Число(Прав(Элемент.Имя, СтрДлина(Элемент.Имя) - СтрДлина("AccessTokenОрганизации")));
	
	ОбновитьПараметрыАвторизации(ПорядковыйНомерГруппы);
	
КонецПроцедуры

&НаКлиенте
Процедура RefreshТокенВСпискеПриИзменении(Элемент)
	
	ПорядковыйНомерГруппы = Число(Прав(Элемент.Имя, СтрДлина(Элемент.Имя) - СтрДлина("RefreshTokenОрганизации")));
	
	ОбновитьПараметрыАвторизации(ПорядковыйНомерГруппы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПарольДоступаКЗакрытомуКлючуВСпискеПриИзменении(Элемент)
	
	ПорядковыйНомерГруппы = Число(Прав(Элемент.Имя, СтрДлина(Элемент.Имя) - СтрДлина("ПарольДоступаКЗакрытомуКлючу")));
	
	ОбновитьПараметрыАвторизации(ПорядковыйНомерГруппы);
	
КонецПроцедуры

&НаКлиенте
Процедура АвторизацияПоСертификатуВСпискеПриИзменении(Элемент)
		
	ОбновитьВидимостьЭлементовФормы();	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПараметрыАвторизации(ПорядковыйНомерГруппы = Неопределено)
	
	Если НЕ ПорядковыйНомерГруппы = Неопределено Тогда 
		
		ИспользоватьПодписание = ЭтаФорма["ПриРаботеСОрганизациейИспользуетсяПодписание"+ПорядковыйНомерГруппы];
		
		Если ИспользоватьПодписание Тогда
			Менеджер = ПолучитьМенеджерКриптографии(); 
		КонецЕсли;
		
		Организация = ЭтаФорма["Авторизация_Организация"+ПорядковыйНомерГруппы];
		
		ПараметрыАвторизацииИПодписанияОрганизации = Новый Структура;	
		ПараметрыАвторизацииИПодписанияОрганизации.Вставить("AccessToken", ЭтаФорма["Авторизация_AccessTokenОрганизации"+ПорядковыйНомерГруппы]);
		ПараметрыАвторизацииИПодписанияОрганизации.Вставить("RefreshToken", ЭтаФорма["Авторизация_RefreshTokenОрганизации"+ПорядковыйНомерГруппы]);
		ПараметрыАвторизацииИПодписанияОрганизации.Вставить("ИспользуетсяПодписание", ЭтаФорма["ПриРаботеСОрганизациейИспользуетсяПодписание"+ПорядковыйНомерГруппы]);
		
		ПараметрыПодписания = Новый Структура;
		
		
		Если ИспользоватьПодписание И НЕ ЭтаФорма["ОтпечатокСертификатаОрганизацииBase64"+ПорядковыйНомерГруппы] = "" Тогда  
			
			ПараметрыПодписания.Вставить("ОтпечатокСертификатаBase64", ЭтаФорма["ОтпечатокСертификатаОрганизацииBase64"+ПорядковыйНомерГруппы]);
			ПараметрыПодписания.Вставить("ПарольДоступаКЗакрытомуКлючу", ЭтаФорма["ПарольДоступаКЗакрытомуКлючу"+ПорядковыйНомерГруппы]);
			Сертификат  = ПолучитьЭЦППоОтпечатку(Менеджер, Base64Значение(Этаформа["ОтпечатокСертификатаОрганизацииBase64"+ПорядковыйНомерГруппы]));
			
			Если НЕ Сертификат = Неопределено Тогда
				
				ПараметрыПодписания.Вставить("Субъект", Сертификат.Субъект);
				
				ЭтоСертификатЮЛ = Ложь;
				ЭтоСертификатИП = Ложь;
				ЭтоСертификатФЛ = Ложь;
				
				Сертификат_ИНН = "";
				
				Если Сертификат.Субъект.Свойство("OID1_2_643_100_4") Тогда
					Сертификат_ИНН = Сертификат.Субъект.OID1_2_643_100_4;
				ИначеЕсли Сертификат.Субъект.Свойство("OID1_2_643_3_131_1_1") Тогда
					Сертификат_ИНН = Сертификат.Субъект.OID1_2_643_3_131_1_1;
				ИначеЕсли Сертификат.Субъект.Свойство("INNLE") Тогда
					Сертификат_ИНН = Сертификат.Субъект.INNLE;
				ИначеЕсли Сертификат.Субъект.Свойство("ИННЮЛ") Тогда
					Сертификат_ИНН = Сертификат.Субъект.ИННЮЛ;
				ИначеЕсли Сертификат.Субъект.Свойство("ИНН_ЮЛ") Тогда
					Сертификат_ИНН = Сертификат.Субъект.ИНН_ЮЛ;
				ИначеЕсли Сертификат.Субъект.Свойство("ИНН") Тогда
					Сертификат_ИНН = Сертификат.Субъект.ИНН;
				ИначеЕсли Сертификат.Субъект.Свойство("ИННОрганизации") Тогда
					Сертификат_ИНН = Сертификат.Субъект.ИННОрганизации;
				ИначеЕсли Сертификат.Субъект.Свойство("ИНН_Организации") Тогда
					Сертификат_ИНН = Сертификат.Субъект.ИНН_Организации;	
				КонецЕсли;
				
				СубъектСодержитОГРНИП = Ложь;
				
				Если Сертификат.Субъект.Свойство("OID1_2_643_100_5") Тогда
					СубъектСодержитОГРНИП = Истина;
				ИначеЕсли Сертификат.Субъект.Свойство("OID_1_2_643_100_1") Тогда
					СубъектСодержитОГРНИП = Истина;	
				ИначеЕсли Сертификат.Субъект.Свойство("ОГРН") Тогда
					СубъектСодержитОГРНИП = Истина;
				ИначеЕсли Сертификат.Субъект.Свойство("ОГРНИП") Тогда
					СубъектСодержитОГРНИП = Истина;	
				ИначеЕсли Сертификат.Субъект.Свойство("OGRN") Тогда
					СубъектСодержитОГРНИП = Истина;
				ИначеЕсли Сертификат.Субъект.Свойство("OGRNIP") Тогда
					СубъектСодержитОГРНИП = Истина;	
				КонецЕсли;
				
				Если СтрДлина(Сертификат_ИНН) = 12 И Лев(Сертификат_ИНН, 2) = "00" Тогда
					Сертификат_ИНН = Прав(Сертификат_ИНН, 10);	
				КонецЕсли;
				
				Если СтрНайти(Сертификат_ИНН, ЭтаФорма["ИНН_Организации"+ПорядковыйНомерГруппы])>0 Тогда
					// Это сертификат ЮЛ или ИП.
					Если СтрДлина(ЭтаФорма["ИНН_Организации"+ПорядковыйНомерГруппы]) = 10 Тогда
						// Если ИНН 10 символов - ЮЛ.
						ЭтоСертификатЮЛ = Истина;
					ИначеЕсли СтрДлина(Сертификат_ИНН) = 12 И СубъектСодержитОГРНИП Тогда	
						// Если ИНН 12 символов и есть ОГРН ИП, то сертификат ИП.
						ЭтоСертификатИП = Истина;
					КонецЕсли;	
				Иначе
					// Если в структуре субъекта нет ОГРН ИП, это сертификат ФЛ.
					Если СтрДлина(Сертификат_ИНН) = 12 И НЕ Лев(Сертификат_ИНН, 2) = "00" И НЕ СубъектСодержитОГРНИП Тогда
						ЭтоСертификатФЛ = Истина;
					ИначеЕсли СтрДлина(Сертификат_ИНН) = 12 И НЕ Лев(Сертификат_ИНН, 2) = "00" И СубъектСодержитОГРНИП Тогда
						// Если ИНН 12 символов и есть ОГРН ИП, то сертификат ИП.
						// Даже если ИП сам по себе не является "организацией-продавцом".
						ЭтоСертификатИП = Истина;	
					КонецЕсли;
				КонецЕсли;	
				
				Если ЭтоСертификатЮЛ Тогда
					ПараметрыПодписания.Вставить("ТипСубъекта", "ЮЛ");
				ИначеЕсли ЭтоСертификатИП Тогда                       
					ПараметрыПодписания.Вставить("ТипСубъекта", "ИП");
				ИначеЕсли ЭтоСертификатФЛ Тогда                       
					ПараметрыПодписания.Вставить("ТипСубъекта", "ФЛ");
				КонецЕсли;	
				
				Если ЭтоСертификатФЛ Тогда 
					ПараметрыПодписания.Вставить("МчдGUID", ЭтаФорма["GUIDДоверенности"+ПорядковыйНомерГруппы]);
					ПараметрыПодписания.Вставить("ДатаНачалаДействияМЧД", ЭтаФорма["ДатаНачалаДействияМЧД"+ПорядковыйНомерГруппы]);
					ПараметрыПодписания.Вставить("ДолжностьФизлица", ЭтаФорма["ДолжностьФизлица"+ПорядковыйНомерГруппы]);
				Иначе	                                                                                        
					ПараметрыПодписания.Вставить("МчдGUID", Неопределено);
					ПараметрыПодписания.Вставить("ДатаНачалаДействияМЧД", Неопределено);
					ПараметрыПодписания.Вставить("ДолжностьФизлица", Неопределено);
				КонецЕсли;	
				
			КонецЕсли;
			
		КонецЕсли;
		
		
		ПараметрыАвторизацииИПодписанияОрганизации.Вставить("ПараметрыПодписания", ПараметрыПодписания);
		
		ОбновитьПараметрыАвторизацииИПодписанияОрганизации(Организация, ПараметрыАвторизацииИПодписанияОрганизации);		
		
	Иначе	
		
		Счетчик = 1;	
		Пока НЕ Счетчик = ОбработаноОрганизаций Цикл
			
			ИспользоватьПодписание = ЭтаФорма["ПриРаботеСОрганизациейИспользуетсяПодписание"+Счетчик];
			
			Если ИспользоватьПодписание Тогда
				Менеджер = ПолучитьМенеджерКриптографии();
			Иначе
				Менеджер = Неопределено;
			КонецЕсли;
			
			Организация = ЭтаФорма["Авторизация_Организация"+Счетчик];
			
			ПараметрыАвторизацииИПодписанияОрганизации = Новый Структура;	
			ПараметрыАвторизацииИПодписанияОрганизации.Вставить("AccessToken", ЭтаФорма["Авторизация_AccessTokenОрганизации"+Счетчик]);
			ПараметрыАвторизацииИПодписанияОрганизации.Вставить("RefreshToken", ЭтаФорма["Авторизация_RefreshTokenОрганизации"+Счетчик]);
			ПараметрыАвторизацииИПодписанияОрганизации.Вставить("ИспользуетсяПодписание", ЭтаФорма["ПриРаботеСОрганизациейИспользуетсяПодписание"+Счетчик]);
			
			ПараметрыПодписания = Новый Структура;
			
			
			Если ИспользоватьПодписание И НЕ ЭтаФорма["ОтпечатокСертификатаОрганизацииBase64"+Счетчик] = "" Тогда  
				
				ПараметрыПодписания.Вставить("ОтпечатокСертификатаBase64", ЭтаФорма["ОтпечатокСертификатаОрганизацииBase64"+Счетчик]);
				ПараметрыПодписания.Вставить("ПарольДоступаКЗакрытомуКлючу", ЭтаФорма["ПарольДоступаКЗакрытомуКлючу"+Счетчик]);
				Сертификат  = ПолучитьЭЦППоОтпечатку(Менеджер, Base64Значение(Этаформа["ОтпечатокСертификатаОрганизацииBase64"+Счетчик]));
				
				Если НЕ Сертификат = Неопределено Тогда 
					
					ПараметрыПодписания.Вставить("Субъект", Сертификат.Субъект);  
					
					ЭтоСертификатЮЛ = Ложь;
					ЭтоСертификатИП = Ложь;
					ЭтоСертификатФЛ = Ложь;
					
					Сертификат_ИНН = "";
					
					Если Сертификат.Субъект.Свойство("OID1_2_643_100_4") Тогда
						Сертификат_ИНН = Сертификат.Субъект.OID1_2_643_100_4;
					ИначеЕсли Сертификат.Субъект.Свойство("OID1_2_643_3_131_1_1") Тогда
						Сертификат_ИНН = Сертификат.Субъект.OID1_2_643_3_131_1_1;
					ИначеЕсли Сертификат.Субъект.Свойство("INNLE") Тогда
						Сертификат_ИНН = Сертификат.Субъект.INNLE;
					ИначеЕсли Сертификат.Субъект.Свойство("ИННЮЛ") Тогда
						Сертификат_ИНН = Сертификат.Субъект.ИННЮЛ;
					ИначеЕсли Сертификат.Субъект.Свойство("ИНН_ЮЛ") Тогда
						Сертификат_ИНН = Сертификат.Субъект.ИНН_ЮЛ;
					ИначеЕсли Сертификат.Субъект.Свойство("ИНН") Тогда
						Сертификат_ИНН = Сертификат.Субъект.ИНН;
					ИначеЕсли Сертификат.Субъект.Свойство("ИННОрганизации") Тогда
						Сертификат_ИНН = Сертификат.Субъект.ИННОрганизации;
					ИначеЕсли Сертификат.Субъект.Свойство("ИНН_Организации") Тогда
						Сертификат_ИНН = Сертификат.Субъект.ИНН_Организации;	
					КонецЕсли;
					
					СубъектСодержитОГРНИП = Ложь;
					
					Если Сертификат.Субъект.Свойство("OID1_2_643_100_5") Тогда
						СубъектСодержитОГРНИП = Истина;
					ИначеЕсли Сертификат.Субъект.Свойство("OID_1_2_643_100_1") Тогда
						СубъектСодержитОГРНИП = Истина;	
					ИначеЕсли Сертификат.Субъект.Свойство("ОГРН") Тогда
						СубъектСодержитОГРНИП = Истина;
					ИначеЕсли Сертификат.Субъект.Свойство("ОГРНИП") Тогда
						СубъектСодержитОГРНИП = Истина;	
					ИначеЕсли Сертификат.Субъект.Свойство("OGRN") Тогда
						СубъектСодержитОГРНИП = Истина;
					ИначеЕсли Сертификат.Субъект.Свойство("OGRNIP") Тогда
						СубъектСодержитОГРНИП = Истина;	
					КонецЕсли;
					
					Если СтрДлина(Сертификат_ИНН) = 12 И Лев(Сертификат_ИНН, 2) = "00" Тогда
						Сертификат_ИНН = Прав(Сертификат_ИНН, 10);	
					КонецЕсли;
					
					Если СтрНайти(Сертификат_ИНН, ЭтаФорма["ИНН_Организации"+Счетчик])>0 Тогда
						// Это сертификат ЮЛ или ИП.
						Если СтрДлина(ЭтаФорма["ИНН_Организации"+ПорядковыйНомерГруппы]) = 10 Тогда
							// Если ИНН 10 символов - ЮЛ.
							ЭтоСертификатЮЛ = Истина;
						ИначеЕсли СтрДлина(Сертификат_ИНН) = 12 И СубъектСодержитОГРНИП Тогда	
							// Если ИНН 12 символов и есть ОГРН ИП, то сертификат ИП.
							ЭтоСертификатИП = Истина;
						КонецЕсли;	
					Иначе
						// Если в структуре субъекта нет ОГРН ИП, это сертификат ФЛ.
						Если СтрДлина(Сертификат_ИНН) = 12 И НЕ Лев(Сертификат_ИНН, 2) = "00" И НЕ СубъектСодержитОГРНИП Тогда
							ЭтоСертификатФЛ = Истина;
						ИначеЕсли СтрДлина(Сертификат_ИНН) = 12 И НЕ Лев(Сертификат_ИНН, 2) = "00" И СубъектСодержитОГРНИП Тогда
							// Если ИНН 12 символов и есть ОГРН ИП, то сертификат ИП.
							// Даже если ИП сам по себе не является "организацией-продавцом".
							ЭтоСертификатИП = Истина;	
						КонецЕсли;
					КонецЕсли;
					
					Если ЭтоСертификатЮЛ Тогда
						ПараметрыПодписания.Вставить("ТипСубъекта", "ЮЛ");
					ИначеЕсли ЭтоСертификатИП Тогда                       
						ПараметрыПодписания.Вставить("ТипСубъекта", "ИП");
					ИначеЕсли ЭтоСертификатФЛ Тогда                       
						ПараметрыПодписания.Вставить("ТипСубъекта", "ФЛ");
					КонецЕсли;	
					
					Если ЭтоСертификатФЛ Тогда 
						ПараметрыПодписания.Вставить("МчдGUID", ЭтаФорма["GUIDДоверенности"+Счетчик]);
						ПараметрыПодписания.Вставить("ДатаНачалаДействияМЧД", ЭтаФорма["ДатаНачалаДействияМЧД"+Счетчик]);
						ПараметрыПодписания.Вставить("ДолжностьФизлица", ЭтаФорма["ДолжностьФизлица"+Счетчик]);
					Иначе	                                                                                        
						ПараметрыПодписания.Вставить("МчдGUID", Неопределено);
						ПараметрыПодписания.Вставить("ДатаНачалаДействияМЧД", Неопределено);
						ПараметрыПодписания.Вставить("ДолжностьФизлица", Неопределено);
					КонецЕсли;
					
				КонецЕсли; 
				
			КонецЕсли;
			
			
			ПараметрыАвторизацииИПодписанияОрганизации.Вставить("ПараметрыПодписания", ПараметрыПодписания);
			
			ОбновитьПараметрыАвторизацииИПодписанияОрганизации(Организация, ПараметрыАвторизацииИПодписанияОрганизации);
			
			Счетчик = Счетчик+1;
			
		КонецЦикла;	
		
	КонецЕсли;	
	
КонецПроцедуры  

