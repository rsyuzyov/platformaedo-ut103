#Область ЭлементыФормы_ПараметрыАвторизацииИПодписания

&НаКлиенте
Процедура ОтобразитьОрганизацииИСертификатыПриОткрытии(Интеграция)
	
	ОбработаноОрганизаций = 0;
	ОтобразитьОрганизацииИСертификатыПриОткрытииНаСервере(ОбработаноОрганизаций);
	
	Если ОбработаноОрганизаций = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Счетчик = 1;	
	Пока НЕ Счетчик = ОбработаноОрганизаций Цикл
		
		//Если ИспользоватьПодписание Тогда
		ЗаполнитьСписокСертификатовВСписке(Счетчик);	
		//КонецЕсли;
		
		Если Интеграция.Свойство("ПараметрыАвторизацииИПодписания") Тогда
			Организация = ЭтаФорма["Авторизация_Организация"+Счетчик];
			ПараметрыАвторизацииИПодписанияОрганизации = Интеграция.ПараметрыАвторизацииИПодписания.Получить(Организация);
			Если НЕ ПараметрыАвторизацииИПодписанияОрганизации = Неопределено Тогда
				Если ПараметрыАвторизацииИПодписанияОрганизации.Свойство("AccessToken") Тогда
					ЭтаФорма["Авторизация_AccessTokenОрганизации"+Счетчик] = ПараметрыАвторизацииИПодписанияОрганизации.AccessToken;
				КонецЕсли;
				Если ПараметрыАвторизацииИПодписанияОрганизации.Свойство("RefreshToken") Тогда
					ЭтаФорма["Авторизация_RefreshTokenОрганизации"+Счетчик] = ПараметрыАвторизацииИПодписанияОрганизации.RefreshToken;
				КонецЕсли;	
				Если ПараметрыАвторизацииИПодписанияОрганизации.Свойство("ПараметрыПодписания") 
					И ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.Свойство("ОтпечатокСертификатаBase64")
					И НЕ ЭтаФорма["СертификатОрганизации"+Счетчик] = "Сертификаты не обнаружены" Тогда
					ЭтаФорма["СертификатОрганизации"+Счетчик] = ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.ОтпечатокСертификатаBase64;
					Если ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.Свойство("ПарольДоступаКЗакрытомуКлючу") Тогда 
						ЭтаФорма["ПарольДоступаКЗакрытомуКлючу"+Счетчик] = ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.ПарольДоступаКЗакрытомуКлючу;
					КонецЕсли;	
					Если ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.Свойство("ТипСубъекта") 
						И ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.ТипСубъекта = "ФЛ" Тогда
						ЭтаФорма["ТипСертификатаОрганизации"+Счетчик] = "ФЛ";	
						Если ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.Свойство("МчдGUID") Тогда	
							ЭтаФорма["GUIDДоверенности"+Счетчик] = ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.МчдGUID;
						КонецЕсли;
						Если ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.Свойство("ДатаНачалаДействияМЧД") Тогда	
							ЭтаФорма["ДатаНачалаДействияМЧД"+Счетчик] = ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.ДатаНачалаДействияМЧД;
						КонецЕсли;
						Если ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.Свойство("ДолжностьФизлица") Тогда	
							ЭтаФорма["ДолжностьФизлица"+Счетчик] = ПараметрыАвторизацииИПодписанияОрганизации.ПараметрыПодписания.ДолжностьФизлица;
						КонецЕсли;
					Иначе
						ЭтаФорма["ТипСертификатаОрганизации"+Счетчик] = "ЮЛ/ИП";
					КонецЕсли;
				КонецЕсли;
				Если НЕ ЭтаФорма["СертификатОрганизации"+Счетчик] = "Сертификаты не обнаружены" Тогда
					СертификатВСпискеПриИзменении(Элементы["СертификатОрганизации"+Счетчик]);
					Если ЭтаФорма["ПриРаботеСОрганизациейИспользуетсяПодписание"+Счетчик] = Истина Тогда
						Если ЗначениеЗаполнено(ЭтаФорма["Авторизация_RefreshTokenОрганизации"+Счетчик]) Тогда
							ЭтаФорма["АвторизацияПоСертификату"+Счетчик] = Ложь;
						Иначе
							ЭтаФорма["АвторизацияПоСертификату"+Счетчик] = Истина;
						КонецЕсли;
					Иначе
						ЭтаФорма["АвторизацияПоСертификату"+Счетчик] = Ложь;
					КонецЕсли;
				Иначе
					ЭтаФорма["АвторизацияПоСертификату"+Счетчик] = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
		
		Счетчик = Счетчик+1;
		
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура ОтобразитьОрганизацииИСертификатыПриОткрытииНаСервере(ПорядковыйНомерГруппы)
	
	Организации = ПолучитьДоступныеОрганизации1С();
	
	Если Организации = Неопределено Тогда
		Возврат;	
	КонецЕсли;	
	
	ПорядковыйНомерГруппы = 1;
	
	Для Каждого Организация из Организации Цикл
		
		// Реквизиты
		МассивРеквизитов = Новый Массив;
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.Организации"));
		ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
		МассивРеквизитов.Добавить(Новый РеквизитФормы("Авторизация_Организация"+ПорядковыйНомерГруппы, ОписаниеТипов, , ""));
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("Строка"));
		ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
		МассивРеквизитов.Добавить(Новый РеквизитФормы("ИНН_Организации"+ПорядковыйНомерГруппы, ОписаниеТипов, , ""));
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("Строка"));
		ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
		МассивРеквизитов.Добавить(Новый РеквизитФормы("КПП_Организации"+ПорядковыйНомерГруппы, ОписаниеТипов, , ""));
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("Булево"));
		ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
		МассивРеквизитов.Добавить(Новый РеквизитФормы("ПриРаботеСОрганизациейИспользуетсяПодписание"+ПорядковыйНомерГруппы, ОписаниеТипов, , ""));
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("Строка"));
		ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
		МассивРеквизитов.Добавить(Новый РеквизитФормы("СертификатОрганизации"+ПорядковыйНомерГруппы, ОписаниеТипов, , ""));
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("Строка"));
		ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
		МассивРеквизитов.Добавить(Новый РеквизитФормы("ТипСертификатаОрганизации"+ПорядковыйНомерГруппы, ОписаниеТипов, , ""));
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("Строка"));
		ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
		МассивРеквизитов.Добавить(Новый РеквизитФормы("ОтпечатокСертификатаОрганизацииBase64"+ПорядковыйНомерГруппы, ОписаниеТипов, , ""));
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("Строка"));
		ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
		МассивРеквизитов.Добавить(Новый РеквизитФормы("ПарольДоступаКЗакрытомуКлючу"+ПорядковыйНомерГруппы, ОписаниеТипов, , ""));
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("Строка"));
		ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
		МассивРеквизитов.Добавить(Новый РеквизитФормы("GUIDДоверенности"+ПорядковыйНомерГруппы, ОписаниеТипов, , ""));
		
