#Область СлужебныеПроцедурыФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ИмяОбработки") Тогда
		ИмяОбработки = Параметры.ИмяОбработки;
	КонецЕсли;
	Если Параметры.Свойство("ПрефиксКонфигурации") Тогда
		ПрефиксКонфигурации = Параметры.ПрефиксКонфигурации;
	КонецЕсли;
	Если Параметры.Свойство("ВерсияНастроекОбработки") Тогда
		ВерсияНастроекОбработки = Параметры.ВерсияНастроекОбработки;
	КонецЕсли;
	Если Параметры.Свойство("АдресВременногоХранилищаКэш") Тогда
		АдресВременногоХранилищаКэш = Параметры.АдресВременногоХранилищаКэш;
	КонецЕсли;
	Если Параметры.Свойство("ПоказыватьНастройкиРазработчика") Тогда 
		ПоказыватьНастройкиРазработчика = Параметры.ПоказыватьНастройкиРазработчика;
	КонецЕсли;	
	
	Объект.ЭтоТестоваяОбработка = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", 	// Ключ объекта
				"ЭтоТестовыйКонтур",																// Ключ настройки 
				"Служебный параметр, определяющий соединение с тестовым контуром", 					// описание настройки
				ПолучитьТекущегоПользователя()); 
				
	Если Объект.ЭтоТестоваяОбработка = Неопределено тогда
		
		Объект.ЭтоТестоваяОбработка = Ложь;
		
	КонецЕсли; 
	
	ОпределитьВерсиюБЭД();
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)	
	
	ВедущийФрагментАдресаKeycloak = ?(Объект.ЭтоТестоваяОбработка = Истина, "oauth-test", "oauth");
	realmФрагментАдресаKeycloak = ?(Объект.ЭтоТестоваяОбработка = Истина, "playground", "production");
	
	ЗаполнитьТекущегоПользователя();
	
	Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	
	СпособИнтеграции = Интеграция.СпособИнтеграции;
	КаталогОбмена = Интеграция.КаталогОбмена;
	
	ИнтерактивноОбновлятьСтатусыДО = ?(Интеграция.Свойство("ИнтерактивноОбновлятьСтатусыДО"), Интеграция.ИнтерактивноОбновлятьСтатусыДО, Ложь);
	
	//Удалить++
	РаботаемПоУС = ?(Интеграция.Свойство("РаботаПоУС"), Интеграция.РаботаПоУС, Ложь);
	//Удалить--
	
	ОтобразитьОрганизацииИСертификатыПриОткрытии(Интеграция);
	
	//work in progress
	//ПоказыватьСлужебныеРеквизитыПриИзмененииНаСервере();
	
	Если СпособИнтеграции = 0 Тогда
		СпособИнтеграции = 1;
	КонецЕсли;
		
	Если НЕ Параметры.ЭтоМастерНастроек тогда
		
		ОтобразитьСправкуОМетодеРаботы();		
		ОбновитьВидимостьЭлементовФормы();
		
	Иначе
		
		НомерШагаМастера = 1;
		ОтобразитьМастерНастроек();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	СписокЗначений = ХранилищеОбщихНастроек.ПолучитьСписок("ОФД_ЭДО_НастройкиОбработки", ПолучитьТекущегоПользователя());
	Интеграция = СписокЗначений.НайтиПоЗначению("Интеграция");
	
	// Информация об интеграции уже есть в хранилище значений 
	Если ТипЗнч(Интеграция) = Тип("ЭлементСпискаЗначений") Тогда
		
		Возврат ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", 	// Ключ объекта
		"Интеграция",															// Ключ настройки 
		"Информация о способе интеграции обработки ОФД ЭДО.", 					// описание настройки
		ПолучитьТекущегоПользователя()); 										// Пользователь
		
	Иначе 
		// Это первый запуск, возвращаем пустую структуру
		Интеграция = Новый Структура;
		Интеграция.Вставить("СпособИнтеграции", 1);
		Интеграция.Вставить("КаталогОбмена");
		Интеграция.Вставить("ИспользоватьКриптографию", Ложь);
		Интеграция.Вставить("ИнтерактивноОбновлятьСтатусыДО", Ложь);
		Интеграция.Вставить("ПараметрыАвторизацииИПодписания", Новый Соответствие);
		Интеграция.Вставить("ВерсияНастроек", ВерсияНастроекОбработки);
		Интеграция.Вставить("МассоваяВыгрузка", Новый Структура);
		// Удалить++
		Интеграция.Вставить("РаботаПоУС", Ложь);
		// Удалить--
		
		Возврат Интеграция;
		
	КонецЕсли; 	
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

// Функция сохраняет параметры интеграции в хранилище общих настроек
// Параметры интеграции хранятся относительно текущего пользователя
&НаСервереБезКонтекста
Процедура СохранитьИнтеграциюНаСервере(Интеграция) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", 	// Ключ объекта
	"Интеграция",											// Ключ настройки 
	Интеграция,												// Настройка
	"Информация о способе интеграции обработки ОФД ЭДО.", 	// описание настройки
	ПолучитьТекущегоПользователя()); 						// Пользователь     
	
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры

// Диалог выбора каталога обмена
&НаКлиенте
Функция ВыбратьКаталог(СтароеЗначение)
	
	ДиалогОткрытия 				= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога); 
	ДиалогОткрытия.Каталог		= СтароеЗначение;
	ДиалогОткрытия.Заголовок	= "Выберите каталог обмена"; 
	
	Если ДиалогОткрытия.Выбрать() Тогда 
		Возврат ДиалогОткрытия.Каталог + "\"; 
	КонецЕсли;
	
	Возврат	СтароеЗначение;
	
КонецФункции

&НаКлиенте
Процедура ОтобразитьСправкуОМетодеРаботы()
	
	Если СпособИнтеграции = 1 Тогда
		
		СправкаОМетодеРаботы = "При выборе метода работы ""Каталог"" формируемые эл. документы будут помещаться в указанный каталог обмена."
		+Символы.ПС+" - При выбранном сертификате организации, в случае наличия сертификата, данные о подписанте "
		+"документа и его должности будут взяты из данных сертификата."
		+Символы.ПС+" - При пустом значении сертификата, данные о подписанте и его должности будут "
		+"заполнены из данных о руководителе организации в 1С.";
		
	ИначеЕсли СпособИнтеграции = 2 Тогда
		
		СправкаОМетодеРаботы = "При выборе метода работы ""API"" формируемые эл. документы будут сразу загружаться в сервис ЭДО."
		+Символы.ПС+" - При установленном сертификате организации, документ будет загружен и отправлен получателю. "
		+"Данные о подписанте документа и его должности будут взяты из данных сертификата."
		+Символы.ПС+" - При пустом значении сертификата, документ будет загружен в сервис как черновик. "
		+"Данные о подписанте и его должности будут заполнены из данных о руководителе организации в 1С.";
		
	Иначе
		
		СправкаОМетодеРаботы = "";
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьЭлементовФормы()
	
	//Каталог
	Если СпособИнтеграции = 1 Тогда		
		ЭтаФорма.Элементы.КаталогОбмена.Видимость = Истина;	
		ЭтаФорма.Элементы.ИнтерактивноОбновлятьСтатусыДО.Видимость = Ложь;
		// Удалить++
		ЭтаФорма.Элементы.РаботаемПоУС.Видимость = Ложь;
		// Удалить--
		Счетчик = 1;	
		Пока НЕ Счетчик = ОбработаноОрганизаций Цикл		
			Элементы["AccessTokenОрганизации"+Счетчик].Видимость = Ложь;
			Счетчик = Счетчик+1;
		КонецЦикла;		
	КонецЕсли;	
	
	//API
	Если СпособИнтеграции = 2 Тогда	
		ЭтаФорма.Элементы.КаталогОбмена.Видимость = Ложь;
		ЭтаФорма.Элементы.ИнтерактивноОбновлятьСтатусыДО.Видимость = Истина;
		// Удалить++
		//ЭтаФорма.Элементы.РаботаемПоУС.Видимость = Истина;
		// Удалить--
		Счетчик = 1;	
		Пока НЕ Счетчик = ОбработаноОрганизаций Цикл		
			Элементы["AccessTokenОрганизации"+Счетчик].Видимость = Истина;
			Счетчик = Счетчик+1;
		КонецЦикла;	
	КонецЕсли;
	
	Счетчик = 1;	
	Пока НЕ Счетчик = ОбработаноОрганизаций Цикл
		Если ЭтаФорма["ПриРаботеСОрганизациейИспользуетсяПодписание"+Счетчик] = Истина Тогда
			Элементы["АвторизацияПоСертификату"+Счетчик].Доступность = Истина;
			Элементы["СертификатОрганизации"+Счетчик].Видимость = Истина;
			Элементы["ПарольДоступаКЗакрытомуКлючу"+Счетчик].Видимость = Истина;
			Элементы["GUIDДоверенности"+Счетчик].Видимость = Истина;
			Если СпособИнтеграции = 2 Тогда
				Элементы["АвторизацияПоСертификату"+Счетчик].Видимость = Истина;
				Если ЭтаФорма["АвторизацияПоСертификату"+Счетчик] = Истина Тогда
					Элементы["КнопкаПолучитьТокенАвторизацииПоПодписи"+Счетчик].Видимость = Истина;
					Элементы["КнопкаОткрытьФормуАвторизации"+Счетчик].Видимость = Ложь;
				Иначе
					Элементы["КнопкаПолучитьТокенАвторизацииПоПодписи"+Счетчик].Видимость = Ложь;
					Элементы["КнопкаОткрытьФормуАвторизации"+Счетчик].Видимость = Истина;
				КонецЕсли;	
			Иначе
				Элементы["АвторизацияПоСертификату"+Счетчик].Видимость = Ложь;
				Элементы["КнопкаПолучитьТокенАвторизацииПоПодписи"+Счетчик].Видимость = Ложь;
				Элементы["КнопкаОткрытьФормуАвторизации"+Счетчик].Видимость = Ложь;
			КонецЕсли;
		Иначе
			Элементы["СертификатОрганизации"+Счетчик].Видимость = Истина;
			Элементы["ПарольДоступаКЗакрытомуКлючу"+Счетчик].Видимость = Ложь;
			Элементы["GUIDДоверенности"+Счетчик].Видимость = Ложь;
			Элементы["КнопкаПолучитьТокенАвторизацииПоПодписи"+Счетчик].Видимость = Ложь;
			ЭтаФорма["АвторизацияПоСертификату"+Счетчик] = Ложь;
			Элементы["АвторизацияПоСертификату"+Счетчик].Доступность = Ложь;
			Если СпособИнтеграции = 2 Тогда
				Элементы["АвторизацияПоСертификату"+Счетчик].Видимость = Истина;
				Элементы["КнопкаОткрытьФормуАвторизации"+Счетчик].Видимость = Истина;
			Иначе
				Элементы["АвторизацияПоСертификату"+Счетчик].Видимость = Ложь;
				Элементы["КнопкаОткрытьФормуАвторизации"+Счетчик].Видимость = Ложь;
			КонецЕсли;	
		КонецЕсли;
		Счетчик = Счетчик+1;
	КонецЦикла;
	
	Элементы.НастройкиРазработчика.Видимость = ЭтотОбъект.ПоказыватьНастройкиРазработчика;

КонецПроцедуры

&НаКлиенте
Функция СкопироватьКоллекцию(ВходящаяКоллекция)
	
	Если ТипЗнч(ВходящаяКоллекция) = Тип("Структура") Тогда
		НоваяКоллекция = Новый Структура;
	ИначеЕсли ТипЗнч(ВходящаяКоллекция) = Тип("Соответствие") Тогда
		НоваяКоллекция = Новый Соответствие;
	КонецЕсли;
	
	Для Каждого ЭлементКоллекции из ВходящаяКоллекция Цикл
		
		Если ТипЗнч(ЭлементКоллекции.Значение) = Тип("Структура") ИЛИ ТипЗнч(ЭлементКоллекции.Значение) = Тип("Соответствие") Тогда				
			Значение = СкопироватьКоллекцию(ЭлементКоллекции.Значение);			
			НоваяКоллекция.Вставить(ЭлементКоллекции.Ключ, Значение);	
		Иначе
			НоваяКоллекция.Вставить(ЭлементКоллекции.Ключ, ЭлементКоллекции.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НоваяКоллекция;
	
КонецФункции

&НаСервере
Процедура СохранитьКлиентскиеНастройкиРаботыСДокументами(МассивНастроек)
	
	ПользовательВладелецНастроек = ПолучитьТекущегоПользователя();
	
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", 												// Ключ объекта
	"КлиентскиеНастройки",																				// Ключ настройки 
	МассивНастроек,																						// Настройка
	"Клиентские настройки формирования исходящих эл. документов и загрузки входящих эл. документов.", 	// описание настройки
	ПользовательВладелецНастроек); 																		// Пользователь     
	
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры	

&НаСервере
Процедура ОбновитьКэш()       
	
	Кэш = ЗагрузитьКэш(); 
	СохранитьКэш(Кэш); 
	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьКэш()       
	
	МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
	Кэш = МодульОбъектаОбработки.Инициализация(Ложь);
	
	Возврат Кэш; 
	
КонецФункции

&НаСервере
Процедура СохранитьКэш(Кэш)
	
	// Записываем новое значение Кэш во временное хранилище
	ПоместитьВоВременноеХранилище(Кэш, АдресВременногоХранилищаКэш);	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекущегоПользователя()
	
	Возврат Неопределено;
	
	Если НЕ Метаданные.ОбщиеМодули.Найти("ПользователиИнформационнойБазы") = Неопределено Тогда
		ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Иначе
		ТекущийПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	КонецЕсли;	
	
	Возврат ТекущийПользователь;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТекущегоПользователя()
	
	Если НЕ Метаданные.ОбщиеМодули.Найти("ПользователиИнформационнойБазы") = Неопределено Тогда
		ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Иначе
		ТекущийПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСтруктуруХранения1С(Кэш = Неопределено) Экспорт
	
	Если Кэш = Неопределено Тогда
		Кэш = ЗагрузитьКэш();	
	КонецЕсли;	
	
	ИмяМетаданных = "Конфигурация";    
	
	Настройка = Кэш.НастройкиОбъект[Кэш.ПрефиксКонфигурации+ИмяМетаданных].ХранениеИнформации1С;
	
	СтрокаВызоваСвойствоИдентификатор 			= Настройка.ОФД_ЭДО_ИдентификаторДокумента.ТипОбъектаМетаданных + "." + 
	Настройка.ОФД_ЭДО_ИдентификаторДокумента.Путь + ".НайтиПоНаименованию(" + Символ(034) + 
	Настройка.ОФД_ЭДО_ИдентификаторДокумента.Наименование + Символ(034) + ")";
	
	СтрокаВызоваСвойствоСтатус					= Настройка.ОФД_ЭДО_СтатусДокумента.ТипОбъектаМетаданных + "." + 
	Настройка.ОФД_ЭДО_СтатусДокумента.Путь + ".НайтиПоНаименованию(" + Символ(034) + 
	Настройка.ОФД_ЭДО_СтатусДокумента.Наименование + Символ(034) + ")";
	
	СтрокаВызоваСвойствоИдентификаторУчастника	= Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.ТипОбъектаМетаданных + "." + 
	Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Путь + ".НайтиПоНаименованию(" + Символ(034) + 
	Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Наименование + Символ(034) + ")";
	
	СвойствоИдентификатор 				= Вычислить(СтрокаВызоваСвойствоИдентификатор);									
	СвойствоСтатус						= Вычислить(СтрокаВызоваСвойствоСтатус);
	СвойствоИдентификаторУчастника		= Вычислить(СтрокаВызоваСвойствоИдентификаторУчастника);
	
	СтруктураХранения1С = Новый Структура;
	СтруктураХранения1С.Вставить("СвойствоИдентификатор",			СвойствоИдентификатор);
	СтруктураХранения1С.Вставить("СвойствоСтатус",					СвойствоСтатус);
	СтруктураХранения1С.Вставить("СвойствоИдентификаторУчастника",	СвойствоИдентификаторУчастника);
	СтруктураХранения1С.Вставить("НаименованиеРегистра",			Настройка.Путь);
	
	Возврат СтруктураХранения1С;
	
КонецФункции

