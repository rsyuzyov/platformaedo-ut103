#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ИмяОбработки") Тогда
		ИмяОбработки = Параметры.ИмяОбработки;
	КонецЕсли;
	Если Параметры.Свойство("Организация") Тогда
		Организация = Параметры.Организация;
	КонецЕсли;
	Если Параметры.Свойство("АдресВременногоХранилищаКэш") Тогда
		АдресВременногоХранилищаКэш = Параметры.АдресВременногоХранилищаКэш;
	КонецЕсли;
	Если Параметры.Свойство("ИдентификаторОрганизацииВБД") Тогда
		ИдентификаторОрганизацииВБД = Параметры.ИдентификаторОрганизацииВБД;
	КонецЕсли;
	Если Параметры.Свойство("AccessToken") Тогда
		AccessToken = Параметры.AccessToken;
	КонецЕсли;
	Если Параметры.Свойство("RefreshToken") Тогда
		RefreshToken = Параметры.RefreshToken;
	КонецЕсли;
	Если Параметры.Свойство("ИспользоватьПодписание") Тогда
		ИспользоватьПодписание = Параметры.ИспользоватьПодписание;
	КонецЕсли;
	Если Параметры.Свойство("ВерсияНастроекОбработки") Тогда
		ВерсияНастроекОбработки = Параметры.ВерсияНастроекОбработки;
	КонецЕсли;
	Если Параметры.Свойство("ОтпечатокСертификатаBase64") Тогда
		ОтпечатокСертификатаBase64 = Параметры.ОтпечатокСертификатаBase64;
	КонецЕсли;
	Если Параметры.Свойство("ПарольДоступаКЗакрытомуКлючу") Тогда
		ПарольДоступаКЗакрытомуКлючу = Параметры.ПарольДоступаКЗакрытомуКлючу;
	КонецЕсли;
	Если Параметры.Свойство("ТипСубъектаПодписанта") Тогда
		ТипСубъектаПодписанта = Параметры.ТипСубъектаПодписанта;
	КонецЕсли;
	Если Параметры.Свойство("МчдGUIDПодписанта") Тогда
		МчдGUIDПодписанта = Параметры.МчдGUIDПодписанта;
	КонецЕсли;
	Если Параметры.Свойство("ДатаНачалаДействияМЧД") Тогда
		ДатаНачалаДействияМЧД = Параметры.ДатаНачалаДействияМЧД;
	КонецЕсли;
	Если Параметры.Свойство("ДолжностьФизлица") Тогда
		ДолжностьФизлица = Параметры.ДолжностьФизлица;
	КонецЕсли;
	
	ТекстПредупреждения = "Обработка списков большого объема занимает большое количества времени и системных ресурсов. "
								+"Рекомендуется делить файлы с большим количеством строк на части."
								+Символы.ПС+"На вход ожидается типовой CSV-файл, содержащий ИНН, КПП и идентификатор абонента, с разделителем в виде запятой или точки с запятой.";
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВедущийФрагментАдресаKeycloak = ?(Объект.ЭтоТестоваяОбработка = Истина, "oauth-test", "oauth");
	realmФрагментАдресаKeycloak = ?(Объект.ЭтоТестоваяОбработка = Истина, "playground", "production");
		
КонецПроцедуры

#КонецОбласти

#Область СобытияЭлементовФормы

#Область КнопкаЗагрузитьТаблицуИзФайла

&НаКлиенте
Процедура ЗагрузитьТаблицуИзФайла(Команда)
	
	ТаблицаСопоставления.Очистить();
	
	Разделитель = ",";
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выбор файла";
	Диалог.ИндексФильтра = 0;
	Диалог.ПредварительныйПросмотр = Ложь;
	Диалог.ПроверятьСуществованиеФайла = Истина;
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Фильтр = "Файлы CSV(*.csv)|*.csv";
	
	Если Диалог.Выбрать() Тогда
		
		ИмяФайла = Диалог.ПолноеИмяФайла;
		
		Чтение = Новый ЧтениеТекста(ИмяФайла, КодировкаТекста.UTF8);
		
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			СообщениеТекст = "В указанном CSV файле не обнаружено валидных данных.";
			ВывестиСообщениеВОтдельнойФорме(СообщениеТекст);
			Возврат;
		КонецЕсли;
		Если СтрНайти(СтрокаФайла, Разделитель) = 0 Тогда
			Если НЕ СтрНайти(СтрокаФайла, ";") = 0 Тогда
				Разделитель = ";";
			Иначе
				СообщениеТекст = "В выбранном CSV файле не обнаружены разделители строк ("","" или "";"").";
				ВывестиСообщениеВОтдельнойФорме(СообщениеТекст);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		Пока СтрокаФайла <> Неопределено Цикл
			Поля = РазобратьСтрокуCSV(СтрокаФайла, Разделитель);
			НоваяСтрока = ТаблицаСопоставления.Добавить();
			НоваяСтрока.ИНН = Поля[0];
			НоваяСтрока.КПП = Поля[1];
			НоваяСтрока.Идентификатор = Поля[2];
			ДанныеОператора = ПолучитьПредставлениеИАвтороумингОператора(Лев(НоваяСтрока.Идентификатор, 3));
			Если НЕ ДанныеОператора = Неопределено Тогда 
				НоваяСтрока.Оператор = ДанныеОператора.Представление;
				Если ДанныеОператора.Автороуминг = "+" Тогда
					НоваяСтрока.Автороуминг = Истина;
				КонецЕсли;
			КонецЕсли;
			СтрокаФайла = Чтение.ПрочитатьСтроку();
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция РазобратьСтрокуCSV(Знач СтрокаCSV, Знач Разделитель = ";")
	
	Результат  = Новый Массив;
	Значение   = "";
	ВКавычках  = Ложь;
	Длина      = СтрДлина(СтрокаCSV);
	
	Индекс = 1;
	Пока Индекс <= Длина Цикл
		Символ = Сред(СтрокаCSV, Индекс, 1);
		
		Если Символ = """" Тогда
			Если ВКавычках И Сред(СтрокаCSV, Индекс + 1, 1) = """" Тогда
				Значение = Значение + """";
				Индекс = Индекс + 1;
			Иначе
				ВКавычках = НЕ ВКавычках;
			КонецЕсли;
		ИначеЕсли Символ = Разделитель И НЕ ВКавычках Тогда
			Результат.Добавить(Значение);
			Значение = "";
		Иначе
			Значение = Значение + Символ;
		КонецЕсли;
		
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Результат.Добавить(Значение);
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область КнопкаЗапуститьСопоставление

&НаКлиенте
Процедура ЗапуститьСопоставление(Команда)
	
	ЗаполнитьТаблицуСоответствиями();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуСоответствиями()
	
	СтруктураХранения1С = ПолучитьСтруктуруХранения1С();
	СвойствоИдентификатор = СтруктураХранения1С.СвойствоИдентификаторУчастника;
	
	Если СвойствоИдентификатор = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не удалось определить дополнительное свойство для хранения идентификатора участника ЭДО.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	ТаблицаДляСоответствий = РеквизитФормыВЗначение("ТаблицаСопоставления");
	ТаблицаДляСоответствий = ТаблицаДляСоответствий.Скопировать(, "ИНН,КПП,Идентификатор,Оператор,Автороуминг");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ТаблицаДляСопоставления.ИНН КАК СТРОКА(12)) КАК ИНН,
	               |	ВЫРАЗИТЬ(ТаблицаДляСопоставления.КПП КАК СТРОКА(9)) КАК КПП,
	               |	ТаблицаДляСопоставления.Идентификатор КАК Идентификатор,
	               |	ТаблицаДляСопоставления.Оператор КАК Оператор,
	               |	ТаблицаДляСопоставления.Автороуминг КАК Автороуминг
	               |ПОМЕСТИТЬ ТаблицаДляСопоставления
	               |ИЗ
	               |	&ТаблицаДляСопоставления КАК ТаблицаДляСопоставления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаДляСопоставления.ИНН КАК ИНН,
	               |	ТаблицаДляСопоставления.КПП КАК КПП,
	               |	ТаблицаДляСопоставления.Идентификатор КАК Идентификатор,
	               |	ТаблицаДляСопоставления.Оператор КАК Оператор,
	               |	ТаблицаДляСопоставления.Автороуминг КАК Автороуминг,
	               |	Контрагенты.Ссылка КАК Контрагент
	               |ПОМЕСТИТЬ ТаблицаКонтрагенты
	               |ИЗ
	               |	ТаблицаДляСопоставления КАК ТаблицаДляСопоставления
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	               |		ПО ТаблицаДляСопоставления.ИНН = Контрагенты.ИНН
	               |			И ТаблицаДляСопоставления.КПП = Контрагенты.КПП
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаКонтрагенты.ИНН КАК ИНН,
	               |	ТаблицаКонтрагенты.КПП КАК КПП,
	               |	ТаблицаКонтрагенты.Идентификатор КАК Идентификатор,
	               |	ТаблицаКонтрагенты.Оператор КАК Оператор,
	               |	ТаблицаКонтрагенты.Автороуминг КАК Автороуминг,
	               |	ЕСТЬNULL(ТаблицаКонтрагенты.Контрагент, ""Не обнаружен"") КАК Контрагент,
	               |	ДополнительныеСведения.Значение КАК ТекущийИдентификатор,
	               |	"""" КАК СостояниеРоуминга,
				   |	"""" КАК СтатусПриглашения,
	               |	ВЫБОР
	               |		КОГДА НЕ ТаблицаКонтрагенты.Контрагент ЕСТЬ NULL
	               |			ТОГДА ТаблицаКонтрагенты.Контрагент.ИНН
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК КонтрагентИНН,
	               |	ВЫБОР
	               |		КОГДА НЕ ТаблицаКонтрагенты.Контрагент ЕСТЬ NULL
	               |			ТОГДА ТаблицаКонтрагенты.Контрагент.КПП
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК КонтрагентКПП
	               |ИЗ
	               |	ТаблицаКонтрагенты КАК ТаблицаКонтрагенты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	               |		ПО (НЕ ТаблицаКонтрагенты.Контрагент ЕСТЬ NULL)
	               |			И ТаблицаКонтрагенты.Контрагент = ДополнительныеСведения.Объект
	               |			И (ДополнительныеСведения.Свойство = &СвойстроИдентификаторАбонента)";
	Запрос.УстановитьПараметр("ТаблицаДляСопоставления", ТаблицаДляСоответствий);
	Запрос.УстановитьПараметр("СвойстроИдентификаторАбонента", СвойствоИдентификатор);
	Результат = Запрос.Выполнить().Выгрузить();
	
	ЗначениеВРеквизитФормы(Результат, "ТаблицаСопоставления");
	
КонецПроцедуры

#КонецОбласти

