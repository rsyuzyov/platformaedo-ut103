#КонецОбласти

#Область КнопкаЗапроситьСостояниеРоуминга

&НаКлиенте
Процедура ЗапроситьСостоянияРоуминга(Команда)
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторОрганизацииВБД) Тогда
		ТекстСообщения = "Идентификатор организации не заполнен."+Символы.ПС+"Заполните идентификатор на форме работы с контрагентами.";
		ВывестиСообщениеВОтдельнойФорме(ТекстСообщения);
	КонецЕсли;
	
	Для Каждого Строка из ТаблицаСопоставления Цикл
		
		Если Строка.Оператор = "Платформа ЭДО" Тогда
			Строка.СостояниеРоуминга = "Не требуется";
			Строка.СтатусПриглашения = "Не требуется";
			Продолжить;
		КонецЕсли;
		
		СостояниеРоуминга = ПолучитьСостояниеРоуминга(ИдентификаторОрганизацииВБД, Строка.ТекущийИдентификатор);
		Если НЕ СостояниеРоуминга = "Отсутствует" Тогда
			СтатусПриглашения = ПолучитьСостояниеПриглашения(ИдентификаторОрганизацииВБД, Строка.ТекущийИдентификатор);
		Иначе
			СтатусПриглашения = "";
		КонецЕсли;
		Строка.СостояниеРоуминга = СостояниеРоуминга;
		Строка.СтатусПриглашения = СтатусПриглашения;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область КнопкаОтправитьПриглашения

&НаКлиенте
Процедура ОтправитьПриглашения(Команда)
	
	Для Каждого Строка из ТаблицаСопоставления Цикл
		
		Если Строка.СостояниеРоуминга = "Не требуется" ИЛИ Строка.СостояниеРоуминга = "Работает" ИЛИ Строка.СостояниеРоуминга = "Ожидает подтверждения" Тогда
			Продолжить;
		КонецЕсли;
		
		ОтправкаУспешна = ОтправитьПриглашениеКЭДО(ИдентификаторОрганизацииВБД, Строка.ТекущийИдентификатор);
		Если ОтправкаУспешна = Истина Тогда
			СтатусПриглашения = "Было отправлено";
		Иначе
			СтатусПриглашения = "Ошибка отправки";
		КонецЕсли;
		Строка.СтатусПриглашения = СтатусПриглашения;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ТаблицаСопоставленияИдентификаторПриИзменении(Элемент)
	
	Если СтрДлина(Элементы.ТаблицаСопоставления.ТекущиеДанные.Идентификатор) > 3 Тогда 
		ДанныеОператора = ПолучитьПредставлениеИАвтороумингОператора(Лев(Элементы.ТаблицаСопоставления.ТекущиеДанные.Идентификатор, 3));
		Если НЕ ДанныеОператора = Неопределено Тогда 
			Элементы.ТаблицаСопоставления.ТекущиеДанные.Оператор = ДанныеОператора.Представление;
			Если ДанныеОператора.Автороуминг = "+" Тогда
				Элементы.ТаблицаСопоставления.ТекущиеДанные.Автороуминг = Истина;
			Иначе
				Элементы.ТаблицаСопоставления.ТекущиеДанные.Автороуминг = Ложь;
			КонецЕсли;
		Иначе
			Элементы.ТаблицаСопоставления.ТекущиеДанные.Оператор = "";
			Элементы.ТаблицаСопоставления.ТекущиеДанные.Автороуминг = Ложь;
		КонецЕсли;
	Иначе
		Элементы.ТаблицаСопоставления.ТекущиеДанные.Оператор = "";
		Элементы.ТаблицаСопоставления.ТекущиеДанные.Автороуминг = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСопоставленияКонтрагентПриИзменении(Элемент)

	ТаблицаСопоставленияКонтрагентПриИзмененииНаСервере();
	
	Если ЗначениеЗаполнено(Элементы.ТаблицаСопоставления.ТекущиеДанные.СостояниеРоуминга) Тогда
		СостояниеРоуминга = ПолучитьСостояниеРоуминга(ИдентификаторОрганизацииВБД, Элементы.ТаблицаСопоставления.ТекущиеДанные.ТекущийИдентификатор);
		СтатусПриглашения = ПолучитьСостояниеПриглашения(ИдентификаторОрганизацииВБД, Элементы.ТаблицаСопоставления.ТекущиеДанные.ТекущийИдентификатор);
		Элементы.ТаблицаСопоставления.ТекущиеДанные.СостояниеРоуминга = СостояниеРоуминга;
		Элементы.ТаблицаСопоставления.ТекущиеДанные.СтатусПриглашения = СтатусПриглашения;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ТаблицаСопоставленияКонтрагентПриИзмененииНаСервере()
	
	Если ТипЗнч(Элементы.ТаблицаСопоставления.ТекущиеДанные.Контрагент) = Тип("Строка") Тогда
		Элементы.ТаблицаСопоставления.ТекущиеДанные.КонтрагентИНН = "";
		Элементы.ТаблицаСопоставления.ТекущиеДанные.КонтрагентКПП = "";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Элементы.ТаблицаСопоставления.ТекущиеДанные.Контрагент) ИЛИ ТипЗнч(Элементы.ТаблицаСопоставления.ТекущиеДанные.Контрагент) = Тип("Строка") Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ТипЗнч(Элементы.ТаблицаСопоставления.ТекущиеДанные.Контрагент) = Тип("Строка") Тогда
		Элементы.ТаблицаСопоставления.ТекущиеДанные.КонтрагентИНН = Элементы.ТаблицаСопоставления.ТекущиеДанные.Контрагент.ИНН;
		Элементы.ТаблицаСопоставления.ТекущиеДанные.КонтрагентКПП = Элементы.ТаблицаСопоставления.ТекущиеДанные.Контрагент.КПП;
	КонецЕсли;
	
	ИдентификаторКонтрагента = ПолучитьИдентификаторЭДОИз1СПоСсылке(Элементы.ТаблицаСопоставления.ТекущиеДанные.Контрагент);
	Если ЗначениеЗаполнено(ИдентификаторКонтрагента) Тогда
		Элементы.ТаблицаСопоставления.ТекущиеДанные.ТекущийИдентификатор = ИдентификаторКонтрагента;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыФункции

&НаСервере
Процедура ИнициализацияКэш(Откат = Ложь)
	
	// Инициализируем Кэш 
	Кэш = ЗагрузитьКэш(Откат); 
	СохранитьКэш(Кэш); 
	
КонецПроцедуры

// Функция загрузки Кэш
// Если значение реквизита формы "АдресВременногоХранилищаКэш" заполнено, то берем Кэш из временного хранилища (ШтатныйЗапуск())
&НаСервере
Функция ЗагрузитьКэш(Откат = Ложь)       
	
	Если ЗначениеЗаполнено(ЭтаФорма.АдресВременногоХранилищаКэш) и Не Откат Тогда
		
		Кэш = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресВременногоХранилищаКэш);
		
		Если НЕ ЗначениеЗаполнено(Кэш) Тогда
			МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
			Кэш = МодульОбъектаОбработки.Инициализация(Откат);
			ЗначениеВРеквизитФормы(МодульОбъектаОбработки, "Объект");
		КонецЕсли;	
		
		Возврат Кэш;
		
	Иначе
		
		МодульОбъектаОбработки = РеквизитФормыВЗначение("Объект");
		Кэш = МодульОбъектаОбработки.Инициализация(Откат);
		ЗначениеВРеквизитФормы(МодульОбъектаОбработки, "Объект"); 
		
		Возврат Кэш;
		
	КонецЕсли;
	
КонецФункции

// Функция сохранения Кэш в процессе работы
// В текущий Кэш записываем только требуемые для выгрузки настройки, остальные динамически подргружаем по мере необходимости
&НаСервере
Процедура СохранитьКэш(Кэш)
	
	// Удаляем предыдущее значение Кэш из временного хранилища
	Если ЗначениеЗаполнено(ЭтаФорма.АдресВременногоХранилищаКэш) Тогда
		//УдалитьИзВременногоХранилища(ЭтаФорма.АдресВременногоХранилищаКэш);
		Адрес = ЭтаФорма.АдресВременногоХранилищаКэш;
	Иначе
		Адрес = ЭтаФорма.УникальныйИдентификатор;
	КонецЕсли;
	
	// Записываем новое значение Кэш во временное хранилище
	ЭтаФорма.АдресВременногоХранилищаКэш = ПоместитьВоВременноеХранилище(Кэш, Адрес);	
	
КонецПроцедуры

&НаКлиенте
Функция СкопироватьКоллекцию(ВходящаяКоллекция)
	
	Если ТипЗнч(ВходящаяКоллекция) = Тип("Структура") Тогда
		НоваяКоллекция = Новый Структура;
	ИначеЕсли ТипЗнч(ВходящаяКоллекция) = Тип("Соответствие") Тогда
		НоваяКоллекция = Новый Соответствие;
	КонецЕсли;
	
	Для Каждого ЭлементКоллекции из ВходящаяКоллекция Цикл
		
		Если ТипЗнч(ЭлементКоллекции.Значение) = Тип("Структура") ИЛИ ТипЗнч(ЭлементКоллекции.Значение) = Тип("Соответствие") Тогда				
			Значение = СкопироватьКоллекцию(ЭлементКоллекции.Значение);			
			НоваяКоллекция.Вставить(ЭлементКоллекции.Ключ, Значение);	
		Иначе
			НоваяКоллекция.Вставить(ЭлементКоллекции.Ключ, ЭлементКоллекции.Значение);
		КонецЕсли;
		
    КонецЦикла;
	
	Возврат НоваяКоллекция;
	
КонецФункции

&НаКлиенте
Процедура СохранитьПараметрыАвторизацииИПодписанияОрганизации(Организация, AccessTokenОрганизации, RefreshTokenОрганизации, ИспользоватьПодписание, ОтпечатокСертификатаBase64Организации, ПарольДоступаКЗакрытомуКлючуОрганизации, ТипСубъектаОрганизации, МчдGUIDОрганизации, ДатаНачалаДействияМЧДОрганизации, ДолжностьФизлицаОрганизации)

	ПараметрыАвторизацииИПодписанияОрганизации = Новый Структура;
	
	ПараметрыАвторизацииИПодписанияОрганизации.Вставить("AccessToken", AccessTokenОрганизации);
	ПараметрыАвторизацииИПодписанияОрганизации.Вставить("RefreshToken", RefreshTokenОрганизации);
	ПараметрыАвторизацииИПодписанияОрганизации.Вставить("ИспользуетсяПодписание", ИспользоватьПодписание);
	
	ПараметрыПодписания = Новый Структура;
	 
	ПараметрыПодписания.Вставить("ОтпечатокСертификатаBase64", ОтпечатокСертификатаBase64Организации);
	ПараметрыПодписания.Вставить("ПарольДоступаКЗакрытомуКлючу", ПарольДоступаКЗакрытомуКлючуОрганизации);
	Менеджер = ПолучитьМенеджерКриптографии(, Ложь);
	Сертификат  = ПолучитьЭЦППоОтпечатку(Менеджер, Base64Значение(ОтпечатокСертификатаBase64Организации), Ложь);
	Если ТипЗнч(Сертификат) = Тип("СертификатКриптографии") Тогда 
		ПараметрыПодписания.Вставить("Субъект", Сертификат.Субъект);
	Иначе
		ПараметрыПодписания.Вставить("Субъект", Неопределено);
	КонецЕсли;
	ПараметрыПодписания.Вставить("ТипСубъекта", ТипСубъектаОрганизации);
	ПараметрыПодписания.Вставить("МчдGUID", МчдGUIDОрганизации);
	ПараметрыПодписания.Вставить("ДатаНачалаДействияМЧД", ДатаНачалаДействияМЧДОрганизации);
	ПараметрыПодписания.Вставить("ДолжностьФизлица", ?(ЗначениеЗаполнено(ДолжностьФизлицаОрганизации), ДолжностьФизлицаОрганизации, Неопределено));
	
	ПараметрыАвторизацииИПодписанияОрганизации.Вставить("ПараметрыПодписания", ПараметрыПодписания);
	
	ОбновитьПараметрыАвторизацииИПодписанияОрганизации(Организация, ПараметрыАвторизацииИПодписанияОрганизации);	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПараметрыАвторизацииИПодписанияОрганизации(Организация, ПараметрыАвторизацииИПодписанияОрганизации)
	
	Интеграция = ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки);
	
	Если НЕ Интеграция.Свойство("ПараметрыАвторизацииИПодписания") Тогда
		Интеграция.Вставить("ПараметрыАвторизацииИПодписания", Новый Соответствие);
	КонецЕсли;
		
	Интеграция.ПараметрыАвторизацииИПодписания.Вставить(Организация, ПараметрыАвторизацииИПодписанияОрганизации);	
	
	СохранитьИнтеграциюНаСервере(Интеграция);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИнтеграциюНаСервере(ВерсияНастроекОбработки) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	СписокЗначений = ХранилищеОбщихНастроек.ПолучитьСписок("ОФД_ЭДО_НастройкиОбработки", ПолучитьТекущегоПользователя());
	Интеграция = СписокЗначений.НайтиПоЗначению("Интеграция");
	
	// Информация об интеграции уже есть в хранилище значений 
	Если ТипЗнч(Интеграция) = Тип("ЭлементСпискаЗначений") Тогда
		
		Возврат ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", 	// Ключ объекта
		"Интеграция",															// Ключ настройки 
		"Информация о способе интеграции обработки ОФД ЭДО.", 					// описание настройки
		ПолучитьТекущегоПользователя()); 										// Пользователь
		
	Иначе 
		// Это первый запуск, возвращаем пустую структуру
		Интеграция = Новый Структура;
		Интеграция.Вставить("СпособИнтеграции");
		Интеграция.Вставить("КаталогОбмена");
		Интеграция.Вставить("ИспользоватьКриптографию");
		Интеграция.Вставить("ПараметрыАвторизацииИПодписания", Новый Соответствие);
		Интеграция.Вставить("ВерсияНастроек", ВерсияНастроекОбработки);
		Интеграция.Вставить("МассоваяВыгрузка", Новый Структура);
		
		Возврат Интеграция;
		
	КонецЕсли; 	
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

&НаСервереБезКонтекста
Процедура СохранитьИнтеграциюНаСервере(Интеграция) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", 								// Ключ объекта
	"Интеграция",											// Ключ настройки 
	Интеграция,												// Настройка
	"Информация о способе интеграции обработки ОФД ЭДО.", 	// описание настройки
	ПолучитьТекущегоПользователя()); 						// Пользователь     
	
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекущегоПользователя()
	
	Возврат Неопределено;
	
	Если НЕ Метаданные.ОбщиеМодули.Найти("ПользователиИнформационнойБазы") = Неопределено Тогда
		ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Иначе
		ТекущийПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	КонецЕсли;	
	
	Возврат ТекущийПользователь;
	
КонецФункции

&НаКлиенте
Процедура ВывестиСообщениеВОтдельнойФорме(ТекстСообщения, ПолныйТехническийТекстСообщения = "")
	
	Если НЕ ЗначениеЗаполнено(ТекстСообщения) Тогда
		Возврат;
	КонецЕсли;
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения();
	ПараметрыОткрытияФормы = Новый Структура();
	ПараметрыОткрытияФормы.Вставить("ТекстСообщения", ТекстСообщения);
	Если ЗначениеЗаполнено(ПолныйТехническийТекстСообщения) Тогда
		ПараметрыОткрытияФормы.Вставить("ПолныйТехническийТекстСообщения", ПолныйТехническийТекстСообщения);
	КонецЕсли;
	ОповещениеОЗакрытии = Новый ОписаниеОповещения();
	ОткрытьФорму(ИмяОбработки + ".Форма.ФормаВыводаСообщений", ПараметрыОткрытияФормы, ЭтаФорма, , , , ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

//Возвращаемое значение:
// Структура, ключ - Представление, значение - Автороуминг (булево)
&НаСервере
Функция ПолучитьПредставлениеИАвтороумингОператора(ИДОператора)
	
	СтруктураВозврата = Новый Структура;
		
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Макет = ОбработкаОбъект.ПолучитьМакет("СлужебныеДанные"); 
	
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(Макет.Область());
    Построитель.ДобавлениеПредставлений = ТипДобавленияПредставлений.НеДобавлять;
    Построитель.ЗаполнитьНастройки();
    Построитель.Выполнить();
	
	ТЗ = Построитель.Результат.Выгрузить(); 
	ОтборСтрок = Новый Структура;
	
	ОтборСтрок.Вставить("Идентификатор", ИДОператора);
	
	НайденныеСтроки = ТЗ.НайтиСтроки(ОтборСтрок);
	
	Если НЕ НайденныеСтроки.Количество() = 0 тогда
		СтруктураВозврата.Вставить("Идентификатор", НайденныеСтроки[0].Идентификатор);
		СтруктураВозврата.Вставить("Представление", НайденныеСтроки[0].Представление);
		СтруктураВозврата.Вставить("Автороуминг", НайденныеСтроки[0].Автороуминг);
	Иначе
	    СтруктураВозврата = Неопределено;
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаСервере
Функция ПолучитьСтруктуруХранения1С() Экспорт
	
	ИмяМетаданных = "Конфигурация";
	Кэш = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаКэш);    
	
	Если Кэш.НастройкиОбъект[Кэш.ПрефиксКонфигурации+ИмяМетаданных] = Неопределено Тогда				
		ИнициализацияКэш(Истина);
		Кэш = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаКэш);		
	КонецЕсли;
	
	Настройка = Кэш.НастройкиОбъект[Кэш.ПрефиксКонфигурации+ИмяМетаданных].ХранениеИнформации1С;
	
	СтрокаВызоваСвойствоИдентификатор 			= Настройка.ОФД_ЭДО_ИдентификаторДокумента.ТипОбъектаМетаданных + "." + 
	Настройка.ОФД_ЭДО_ИдентификаторДокумента.Путь + ".НайтиПоНаименованию(" + Символ(034) + 
	Настройка.ОФД_ЭДО_ИдентификаторДокумента.Наименование + Символ(034) + ")";
	
	СтрокаВызоваСвойствоСтатус					= Настройка.ОФД_ЭДО_СтатусДокумента.ТипОбъектаМетаданных + "." + 
	Настройка.ОФД_ЭДО_СтатусДокумента.Путь + ".НайтиПоНаименованию(" + Символ(034) + 
	Настройка.ОФД_ЭДО_СтатусДокумента.Наименование + Символ(034) + ")";
	
	СтрокаВызоваСвойствоИдентификаторУчастника	= Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.ТипОбъектаМетаданных + "." + 
	Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Путь + ".НайтиПоНаименованию(" + Символ(034) + 
	Настройка.ОФД_ЭДО_ИдентификаторУчастникаЭДО.Наименование + Символ(034) + ")";
	
	СвойствоИдентификатор 				= Вычислить(СтрокаВызоваСвойствоИдентификатор);									
	СвойствоСтатус						= Вычислить(СтрокаВызоваСвойствоСтатус);
	СвойствоИдентификаторУчастника		= Вычислить(СтрокаВызоваСвойствоИдентификаторУчастника);
	
	СтруктураХранения1С = Новый Структура;
	СтруктураХранения1С.Вставить("СвойствоИдентификатор",			СвойствоИдентификатор);
	СтруктураХранения1С.Вставить("СвойствоСтатус",					СвойствоСтатус);
	СтруктураХранения1С.Вставить("СвойствоИдентификаторУчастника",	СвойствоИдентификаторУчастника);
	СтруктураХранения1С.Вставить("НаименованиеРегистра",			Настройка.Путь);
	
	Возврат СтруктураХранения1С;
	
КонецФункции

#КонецОбласти

#Область ИнтеграцияAPI

&НаКлиенте
Функция ПолучитьСостояниеРоуминга(ИдентификаорОтправителя, ИдентификаторПолучателя)
	
	СостояниеРоуминга = "Не настроен";
	
	Если ЗначениеЗаполнено(ИдентификаторПолучателя) Тогда
		
		ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
		
		ПараметрыЗапроса.Параметры.Вставить("<sender_gid>", ИдентификаорОтправителя);
		ПараметрыЗапроса.Параметры.Вставить("<gids>", ИдентификаторПолучателя);
		
		СтатусРоумингаЭДО = ВыполнитьЗапросAPI("API_ПолучитьСтатусРоумингаЭДО", ПараметрыЗапроса);
		
		Если НЕ СтатусРоумингаЭДО.Ошибка Тогда
			
			Если НЕ СтатусРоумингаЭДО.Результат = Неопределено Тогда
				
				Для Каждого Результат Из СтатусРоумингаЭДО.Результат Цикл
					Если Результат.state.status = "ESTABLISHED" Тогда
						// Роуминг работает, отправка возможна.
						СостояниеРоуминга = "Работает";
						Продолжить;
					ИначеЕсли Результат.state.status = "AWAIT_APPROVAL" Тогда
						// Для установки связи требуется наличие приглашения от второй стороны.
						СостояниеРоуминга = "Ожидает подтверждения";
						Продолжить;
					ИначеЕсли Результат.state.status = "BROKEN" Тогда
						// Приглашение было обработано со стороны оператора-получателя.
						СостояниеРоуминга = "Был отменен";
						Продолжить;	
					КонецЕсли;	
				КонецЦикла; 
				
				Возврат СостояниеРоуминга;
				
			КонецЕсли;
			
		Иначе
					
			СостояниеРоуминга = "Ошибка получения данных о состоянии роуминга ЭДО.";
			Возврат СостояниеРоуминга;
				
		КонецЕсли;
		
	Иначе
		
		СостояниеРоуминга = "Отсутствует";
		
	КонецЕсли;
	
	Возврат СостояниеРоуминга;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСостояниеПриглашения(ИдентификаорОтправителя, ИдентификаторПолучателя)
	
	СостояниеПриглашения = "Не отправлялось.";	
	
	ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
	
	ПараметрыЗапроса.Параметры.Вставить("<sender_gid>", ИдентификаорОтправителя);
	ПараметрыЗапроса.Параметры.Вставить("<recipient_gid>", ИдентификаторПолучателя);
	
	СтатусПриглашения = ВыполнитьЗапросAPI("API_ПолучитьСтатусПриглашенияКЭДО", ПараметрыЗапроса);
	
	Если НЕ СтатусПриглашения.Ошибка Тогда
		
		Если НЕ СтатусПриглашения.Результат = Неопределено Тогда
			
			Для Каждого Результат Из СтатусПриглашения.Результат Цикл
				Если Результат.type = "BREAK" Тогда
					// Приглашение было отклонено со стороны оператора-получателя.
					СостояниеПриглашения = "Отклонено. Отправка возможна.";
					Продолжить;
				ИначеЕсли НЕ Результат.type = "REQUEST" Тогда
					// Приглашение было обработано со стороны оператора-получателя.
					СостояниеПриглашения = "Было отправлено. Ответ еще не получен.";
					Продолжить;
				Иначе
					Если Результат.status = "SENDING" Тогда
						// В процессе отправки.	
						СостояниеПриглашения = "Было отправлено. Обрабатывается оператором получателя.";
						Продолжить;
					ИначеЕсли Результат.status = "SENT" Тогда
						// Отправлено.
						СтатусПриглашения = "Было доставлено.";
						Продолжить;
					ИначеЕсли Результат.status = "FAILED" Тогда
						// Произошла ошибка в процессе отправки.
						СостояниеПриглашения = "Ошибка отправки. Отправка возможна.";
						Продолжить;
					Иначе
						Продолжить;
					КонецЕсли;		
					Прервать;
				КонецЕсли;	
			КонецЦикла;	
			
		КонецЕсли;
		
	Иначе	
				
		СостояниеПриглашения = "Ошибка получения данных о пригашениях к ЭДО.";
		
	КонецЕсли;
	
	Возврат СостояниеПриглашения;
	
КонецФункции

&НаКлиенте
Функция ОтправитьПриглашениеКЭДО(ИдентификаорОтправителя, ИдентификаторПолучателя)
	
	ПриглашениеБылоОтправлено = Ложь;
	
	ПараметрыЗапроса = ПолучитьШаблонПараметровЗапроса();
	
	ПараметрыЗапроса.Параметры.Вставить("<sender_gid>", ИдентификаорОтправителя);
	ПараметрыЗапроса.Параметры.Вставить("<recipient_gid>", ИдентификаторПолучателя);
	
	ОтправкаПриглашения = ВыполнитьЗапросAPI("API_ОтправитьАбонентуПриглашениеКЭДО", ПараметрыЗапроса);
	
	Если НЕ ОтправкаПриглашения.Ошибка Тогда
		
		Если ОтправкаПриглашения.КодСостояния = 204 Тогда
			ПриглашениеБылоОтправлено = Истина;
		КонецЕсли;	
		
	Иначе	
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не удалось сформировать приглашение в системе ЭДО."+Символы.ПС+"Описание ошибки:"+Символы.ПС+ОтправкаПриглашения.Описание;
		Сообщение.Сообщить();
				
	КонецЕсли;
	
	Возврат ПриглашениеБылоОтправлено;
	
КонецФункции

&НаКлиенте
Функция ВыполнитьЗапросAPI(ИмяФункцииЗапроса, ВходящиеПараметрыЗапроса) Экспорт
	
	РезультатЗапроса = ПолучитьШаблонСтруктурыОтвета();
	РезультатЗапроса.Ошибка = Истина;
	
	ПараметрыЗапроса = СкопироватьКоллекцию(ВходящиеПараметрыЗапроса);
	
	Выполнить("РезультатЗапроса = "+ИмяФункцииЗапроса+"(ПараметрыЗапроса);");
	
	Если РезультатЗапроса.КодСостояния = 401 ИЛИ РезультатЗапроса.КодСостояния = 500 Тогда
		
		// Ошибка авторизации.
		// Попытка обновить токен по сертификату.
		Если ИспользоватьПодписание = Истина И НЕ ЗначениеЗаполнено(RefreshToken) Тогда
			
			Если ПараметрыЗапроса.Свойство("Заголовки") И НЕ ПараметрыЗапроса.Заголовки.Получить("Authorization") = Неопределено Тогда	
				НовыйТокен = ПолучитьТокенПоОтпечаткуСертификата(Base64Значение(ОтпечатокСертификатаBase64), ПарольДоступаКЗакрытомуКлючу);
				Если НЕ НовыйТокен = Неопределено Тогда
					ПараметрыЗапроса = СкопироватьКоллекцию(ВходящиеПараметрыЗапроса);
					ПараметрыЗапроса.Заголовки.Вставить("Authorization", "Bearer "+ НовыйТокен);
					Выполнить("РезультатЗапроса = "+ИмяФункцииЗапроса+"(ПараметрыЗапроса);");
					Если РезультатЗапроса.КодСостояния = 200 Тогда
						AccessToken = НовыйТокен;
						RefreshToken = "";
						СохранитьПараметрыАвторизацииИПодписанияОрганизации(Организация, AccessToken, RefreshToken, ИспользоватьПодписание, ОтпечатокСертификатаBase64, ПарольДоступаКЗакрытомуКлючу, ТипСубъектаПодписанта, МчдGUIDПодписанта, ДатаНачалаДействияМЧД, ДолжностьФизлица);
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(AccessToken) И ЗначениеЗаполнено(RefreshToken) Тогда 	
			
			Если ПараметрыЗапроса.Свойство("Заголовки") И НЕ ПараметрыЗапроса.Заголовки.Получить("Authorization") = Неопределено Тогда
				FreshTokens = RefreshTokens(RefreshToken);
				Если НЕ FreshTokens = Неопределено Тогда
					НовыйAccessToken = FreshTokens.access_token;
					НовыйRefreshToken = FreshTokens.refresh_token;
					AccessToken = НовыйAccessToken;
					RefreshToken = НовыйRefreshToken;
					ПараметрыЗапроса = СкопироватьКоллекцию(ВходящиеПараметрыЗапроса);
					ПараметрыЗапроса.Заголовки.Вставить("Authorization", "Bearer "+ AccessToken);
					Выполнить("РезультатЗапроса = "+ИмяФункцииЗапроса+"(ПараметрыЗапроса);");
					Если РезультатЗапроса.КодСостояния = 200 Тогда	
						СохранитьПараметрыАвторизацииИПодписанияОрганизации(Организация, AccessToken, RefreshToken, ИспользоватьПодписание, ОтпечатокСертификатаBase64, ПарольДоступаКЗакрытомуКлючу, ТипСубъектаПодписанта, МчдGUIDПодписанта, ДатаНачалаДействияМЧД, ДолжностьФизлица);
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат РезультатЗапроса;
	
КонецФункции

