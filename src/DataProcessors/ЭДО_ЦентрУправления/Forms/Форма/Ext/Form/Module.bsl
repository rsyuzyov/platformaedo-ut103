////////////////////////////////////////////////////////////////////////////////
// Центр управления ЭДО: рабочее место разбора.
//
// Форма показывает, переключает и зовет действия. Все показатели считает ЭДО_Витрина,
// действия (снятие паузы, ручная отправка) выполняет ЭДО_Сервер: дублировать здесь отбор
// или логику отправки нельзя, иначе витрина, карточка и очередь разойдутся молча.
////////////////////////////////////////////////////////////////////////////////

// Последняя открытая расшифровка: после смены отбора или "Обновить" она пересобирается
// по новому отбору, а не очищается. Список на экране всегда соответствует текущему отбору.
&НаКлиенте
Перем ВидРазбора;
&НаКлиенте
Перем ЗначениеРазбора;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Период = ЭДО_Витрина.ПериодПоУмолчанию();
	НачалоПериода = Период.Начало;
	КонецПериода = Период.Конец;
	ОтборВидДокументов = "Все";
	НастроитьУсловноеОформление();   // ЩА 14.10.2026 [yan]

	ЗаполнитьДанные();

КонецПроцедуры

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	ОбновитьИПовторитьРазбор();

КонецПроцедуры

// ++ ЩА 23.10.2026 [yan]: «Документ №» - номер документа, Enter открывает его карточку ЭДО без поиска по группам
// дашборда. Несколько документов с таким номером (разные годы или вхождение) - выбор из списка.
&НаКлиенте
Процедура ПолеНомерДокументаПриИзменении(Элемент)

	Если НЕ ЗначениеЗаполнено(ПоискНомерДокумента) Тогда
		Возврат;
	КонецЕсли;
	Найденные = ЭДО_Витрина.ДокументыПоНомеру(ПоискНомерДокумента);
	Если Найденные.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Документ с номером «" + ПоискНомерДокумента + "» не найден"
			+ " (реализации, корректировки и акты сверки; вхождение номера - за полгода).");
		Возврат;
	КонецЕсли;
	Если Найденные.Количество() = 1 Тогда
		ЭДО_Клиент.ОткрытьКарточкуСостоянияЭДО(Найденные[0], ЭтотОбъект);
		Возврат;
	КонецЕсли;
	Список = Новый СписокЗначений;
	Для Каждого Ссылка Из Найденные Цикл
		Список.Добавить(Ссылка, Строка(Ссылка));
	КонецЦикла;
	Список.ПоказатьВыборЭлемента(Новый ОписаниеОповещения("ПолеНомерДокументаВыборЗавершение", ЭтотОбъект),
		"Документы с номером «" + ПоискНомерДокумента + "»");

КонецПроцедуры

&НаКлиенте
Процедура ПолеНомерДокументаВыборЗавершение(Выбранный, Параметры) Экспорт

	Если Выбранный <> Неопределено Тогда
		ЭДО_Клиент.ОткрытьКарточкуСостоянияЭДО(Выбранный.Значение, ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры
// -- ЩА 23.10.2026 [yan].

&НаКлиенте
Процедура ОбновитьВыполнить(Команда)

	ОбновитьИПовторитьРазбор();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИПовторитьРазбор()

	НаРазборе = Элементы.СтраницыЦентра.ТекущаяСтраница = Элементы.СтраницаРазбор;
	ОбновитьНаСервере();
	Если НЕ НаРазборе ИЛИ НЕ ЗначениеЗаполнено(ВидРазбора) Тогда
		Возврат;
	КонецЕсли;

	Если ВидРазбора = "Группа" Тогда
		ПоказатьДокументыГруппы(ЗначениеРазбора);
	ИначеЕсли ВидРазбора = "Состояние" Тогда
		ПоказатьДокументыСостояния(ЗначениеРазбора);
	ИначеЕсли ВидРазбора = "Признак" Тогда
		ПоказатьКонтрагентовПризнака(ЗначениеРазбора);
	ИначеЕсли ВидРазбора = "Контрагент" Тогда
		ПоказатьДокументыКонтрагента(ЗначениеРазбора);
	ИначеЕсли ВидРазбора = "АдресПолучателя" Тогда
		ПоказатьРасхожденияАдресов();
	ИначеЕсли ВидРазбора = "БезАдреса" Тогда
		ПоказатьКонтрагентовБезАдреса();
	ИначеЕсли ВидРазбора = "НашиАннулирования" Тогда
		ПоказатьНашиАннулирования();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗапомнитьРазбор(Знач Вид, Знач Значение = Неопределено)

	ВидРазбора = Вид;
	ЗначениеРазбора = Значение;

КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()

	ЗаполнитьДанные();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанные()

	Сводка = ЭДО_Витрина.СводкаИсходящих(НачалоПериода, КонецПериода, ОтборОрганизация, ОтборВидДокументов,
		ОтборКонтрагент);
	ЗагрузитьВТаблицу(Состояния, Сводка);
	ЗагрузитьВТаблицу(ИтогиГрупп, ЭДО_Витрина.ИтогиПоГруппам(Сводка));
	ЗагрузитьВТаблицу(Контур, ЭДО_Витрина.СводкаКонтура());
	ОставитьВКонтуреОрганизациюОтбора();   // ЩА 14.10.2026 [yan]
	ЗагрузитьВТаблицу(Контрагенты, ЭДО_Витрина.СводкаКонтрагентов(НачалоПериода, КонецПериода, ОтборКонтрагент));
	ЗагрузитьВТаблицу(Организации, ЭДО_Витрина.СводкаОрганизаций(НачалоПериода, КонецПериода, ОтборВидДокументов));

	// Приглашения при открытии и при смене отбора НЕ считаются - список строится по всем
	// контрагентам периода, и на боевой базе это десятки секунд, а нужен список не каждый раз.
	// Собирает его кнопка "Заполнить список" (см. ЗаполнитьПриглашенияНаСервере). Здесь только
	// очищаем то, что уже показано: иначе после смены организации или периода на экране
	// остался бы список приглашений от ПРЕЖНЕГО отбора, а "Пригласить всех" ушло бы по чужим
	// адресам.
	Приглашения.Очистить();
	ПриглашенияВсе.Очистить();
	ПриглашенияСводка.Очистить();
	ПрименитьОтборВходящих();   // ЩА 20.10.2026 [yan]: прочитанный список не сбрасывается, а отбирается

	Документы.Очистить();
	СписокКонтрагентов.Очистить();
	Элементы.КнопкаНазадККонтрагентам.Видимость = Ложь;
	ТекстРазбора = "Выберите строку на дашборде";
	Элементы.НадписьРазбор.Заголовок = ТекстРазбора;

	ТекстПосчитано = "Рассчитано " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");
	Элементы.НадписьПосчитано.Заголовок = ТекстПосчитано;
	ПоказатьСостояниеОбмена();   // ЩА 14.10.2026 [yan]

КонецПроцедуры

// ++ ЩА 14.10.2026 [yan]: строка «Обмен» и кнопка «Обмен сейчас».
&НаСервере
Процедура ПоказатьСостояниеОбмена()
	Состояние = ЭДО_Регламенты.СостояниеОбмена();
	// ЩА 14.10.2026 [yan]: первым словом - вердикт, его читают с первого взгляда; красный на форме значит
	// «нужно действие человека».
	Текст = СтрЗаменить(Состояние.Текст, "Обмен: ", "");
	// Вердикт считает ядро по состоянию регламентов, форма его только показывает.
	Вердикт = ?(Состояние.Свойство("Вердикт") И ЗначениеЗаполнено(Состояние.Вердикт), Состояние.Вердикт, "Обмен");
	Элементы.НадписьОбмен.Заголовок = Вердикт + " · " + Текст;
	Элементы.НадписьОбмен.ЦветТекста = ?(Состояние.Красный, ЦветаСтиля.ЦветОсобогоТекста, ЦветаСтиля.ЦветТекстаФормы);
КонецПроцедуры

// ЩА 14.10.2026 [yan]: при выбранной организации в «Состоянии контура» - только ее строки и общие.
// Строки по организации заканчиваются «: <организация>» (сертификат, подпись на сервере); строки других
// организаций базы убираются, общие (версия, настройки, свойства) остаются.
&НаСервере
Процедура ОставитьВКонтуреОрганизациюОтбора()
	Если НЕ ЗначениеЗаполнено(ОтборОрганизация) Тогда
		Возврат;
	КонецЕсли;
	Чужие = Новый Массив;
	Для Каждого Запись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
		Если ЗначениеЗаполнено(Запись.Организация) И Запись.Организация <> ОтборОрганизация Тогда
			Чужие.Добавить(": " + Строка(Запись.Организация));
		КонецЕсли;
	КонецЦикла;
	Индекс = Контур.Количество() - 1;
	Пока Индекс >= 0 Цикл
		СтрокаКонтура = Контур[Индекс];
		Для Каждого Хвост Из Чужие Цикл
			Если СтрЗаканчиваетсяНа(СтрокаКонтура.Показатель, Хвост) Тогда
				Контур.Удалить(СтрокаКонтура);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Индекс = Индекс - 1;
	КонецЦикла;
КонецПроцедуры

// Красный на форме - только то, что требует действия: застрявшие и требующие решения документы,
// тревоги «Состояния контура».
&НаСервере
Процедура НастроитьУсловноеОформление()

	Элемент = УсловноеОформление.Элементы.Добавить();
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Контур.Тревога");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаКонтура");

	Срочные = Новый СписокЗначений;
	Срочные.Добавить("Застряло у нас");
	Срочные.Добавить("Требует решения");
	Элемент = УсловноеОформление.Элементы.Добавить();
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ИтогиГрупп.Группа");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	Отбор.ПравоеЗначение = Срочные;
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ИтогиГрупп.Количество");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	Отбор.ПравоеЗначение = 0;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаИтогов");

	// ЩА 15.10.2026 [yan]: документ изменен после отправки - строка красным; ошибка Честного знака - красным.
	Элемент = УсловноеОформление.Элементы.Добавить();
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Документы.СуммаРасходится");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаДокументов");

	Элемент = УсловноеОформление.Элементы.Добавить();
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Документы.ЧестныйЗнак");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.НачинаетсяС;
	Отбор.ПравоеЗначение = "Ошибка";
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ДокЧестныйЗнак");

КонецПроцедуры

// ЩА 15.10.2026 [yan]: окно «Настройки ЭДО» - флаги контрагентов галочками; без права изменения
// открывается на просмотр.
&НаКлиенте
Процедура НастройкиЭДОВыполнить(Команда)

	ОткрытьФорму("Обработка.ЭДО_НастройкиЭДО.Форма", , ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОбменСейчасВыполнить(Команда)
	Текст = ЗапуститьОбменНаСервере();
	ПоказатьОповещениеПользователя("Обмен ЭДО", , Текст);
КонецПроцедуры

&НаСервере
Функция ЗапуститьОбменНаСервере()
	Текст = ЭДО_Регламенты.ЗапуститьОбменСейчас();
	ПоказатьСостояниеОбмена();
	Возврат Текст;
КонецФункции
// -- ЩА 14.10.2026 [yan].

// Построчная загрузка вместо ЗначениеВРеквизитФормы: у части таблиц витрины колонки
// нетипизированы, и загрузка целиком упирается в несовпадение описаний типов.
&НаСервере
Процедура ЗагрузитьВТаблицу(ТаблицаФормы, Знач Данные)

	ТаблицаФормы.Очистить();
	Для Каждого СтрокаДанных Из Данные Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаФормы.Добавить(), СтрокаДанных);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИтоговВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТаблицаИтогов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗапомнитьРазбор("Группа", ТекущиеДанные.Группа);
	ПоказатьДокументыГруппы(ТекущиеДанные.Группа);

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСостоянийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТаблицаСостояний.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗапомнитьРазбор("Состояние", ТекущиеДанные.Состояние);
	ПоказатьДокументыСостояния(ТекущиеДанные.Состояние);

КонецПроцедуры

&НаСервере
Процедура ПоказатьДокументыГруппы(Знач Группа)

	СписокСостояний = Новый Массив;
	Для Каждого СтрокаСводки Из Состояния Цикл
		Если СтрокаСводки.Группа = Группа Тогда
			СписокСостояний.Добавить(СтрокаСводки.Состояние);
		КонецЕсли;
	КонецЦикла;

	Данные = ЭДО_Витрина.ДокументыПоСостояниям(СписокСостояний, НачалоПериода, КонецПериода, ОтборОрганизация,
		ЛимитСтрокРазбора(), ОтборВидДокументов, ОтборКонтрагент);
	ЗагрузитьВТаблицу(Документы, Данные);
	ЗаполнитьПричиныОтказа();
	ПоказатьРазбор("Группа: " + Группа, Истина);

КонецПроцедуры

// Сколько документов грузить в разбор группы или состояния. Счетчик на дашборде считает все документы,
// и разбор должен с ним сходиться: прежняя 1000 молча обрезала «Застряло у нас» (1 773 в moroz).
// Потолок остается, чтобы форма не подвисала на десятках тысяч строк «Не взято в очередь».
&НаСервере
Функция ЛимитСтрокРазбора()
	Возврат 5000;
КонецФункции

&НаСервере
Процедура ПоказатьДокументыСостояния(Знач Состояние)

	Данные = ЭДО_Витрина.ДокументыПоСостоянию(Состояние, НачалоПериода, КонецПериода, ОтборОрганизация,
		ЛимитСтрокРазбора(), ОтборВидДокументов, ОтборКонтрагент);
	ЗагрузитьВТаблицу(Документы, Данные);
	ЗаполнитьПричиныОтказа();
	ПоказатьРазбор("Состояние: " + Состояние, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаКонтураВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТаблицаКонтура.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗапомнитьРазбор(ТекущиеДанные.Расшифровка);
	Если ТекущиеДанные.Расшифровка = "АдресПолучателя" Тогда
		ПоказатьРасхожденияАдресов();
	ИначеЕсли ТекущиеДанные.Расшифровка = "БезАдреса" Тогда
		ПоказатьКонтрагентовБезАдреса();
	ИначеЕсли ТекущиеДанные.Расшифровка = "НашиАннулирования" Тогда
		ПоказатьНашиАннулирования();
	КонецЕсли;

КонецПроцедуры

// Наши ПОА, которые контрагент не подтвердил дольше срока из настроек: по ним дожимают контрагентов.
// Сумма в снимке не хранится, поэтому колонка суммы скрыта.
&НаСервере
Процедура ПоказатьНашиАннулирования()

	ЗагрузитьВТаблицу(Документы, ЭДО_Витрина.ДокументыНашихАннулирований());
	ПоказатьРазбор("Наши ПОА без ответа контрагента (по прогону сторожа)", Истина);
	Элементы.ДокСумма.Видимость = Ложь;
	Элементы.ДокСуммаВЭДО.Видимость = Ложь;   // ЩА 15.10.2026 [yan]
	Элементы.ДокДатаПОА.Видимость = Истина;
	Элементы.ДокСтатусОператора.Видимость = Истина;
	Элементы.ДокСтатусОператора.Заголовок = "Ответ контрагента";

КонецПроцедуры

// Расшифровка "Ушли не на текущий адрес" по снимку сторожа адресов.
&НаСервере
Процедура ПоказатьРасхожденияАдресов()

	ЗагрузитьВТаблицу(Документы, ЭДО_Витрина.ДокументыАдресовПолучателя());
	ПоказатьРазбор("Ушли не на текущий адрес (по прогону сторожа)", Истина);
	Элементы.ДокОтправленоНа.Видимость = Истина;
	Элементы.ДокТекущийАдрес.Видимость = Истина;
	Элементы.ДокСтатусОператора.Видимость = Истина;

КонецПроцедуры

&НаСервере
Процедура ПоказатьКонтрагентовБезАдреса()

	ПризнакРазбора = ПризнакБезАдреса();
	ЗагрузитьВТаблицу(СписокКонтрагентов, ЭДО_Витрина.КонтрагентыБезАдреса());
	ПоказатьРазбор("Живая связь без адреса (по прогону сторожа)", Ложь);
	Элементы.КаНетАдреса.Видимость = Истина;

КонецПроцедуры

// Признак возврата к списку "живая связь без адреса": он берется из снимка сторожа, а не из витрины контрагентов.
&НаКлиентеНаСервереБезКонтекста
Функция ПризнакБезАдреса()

	Возврат "#СторожБезАдреса";

КонецФункции

&НаКлиенте
Процедура ТаблицаПризнаковВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТаблицаПризнаков.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗапомнитьРазбор("Признак", ТекущиеДанные.Признак);
	ПоказатьКонтрагентовПризнака(ТекущиеДанные.Признак);

КонецПроцедуры

&НаСервере
Процедура ПоказатьКонтрагентовПризнака(Знач Признак)

	ПризнакРазбора = Признак;
	Данные = ЭДО_Витрина.КонтрагентыПоПризнаку(Признак, НачалоПериода, КонецПериода, ОтборКонтрагент);
	ЗагрузитьВТаблицу(СписокКонтрагентов, Данные);
	ПоказатьРазбор("Контрагенты: " + Признак, Ложь);

КонецПроцедуры

// Документы контрагента за период. Список контрагентов при этом очищается,
// поэтому возврат к нему перечитывает признак, по которому он был открыт.
&НаСервере
Процедура ПоказатьДокументыКонтрагента(Знач Контрагент)

	Данные = ЭДО_Витрина.ДокументыКонтрагента(Контрагент, НачалоПериода, КонецПериода, , ОтборВидДокументов);
	ЗагрузитьВТаблицу(Документы, Данные);
	ЗаполнитьПричиныОтказа();
	ПоказатьРазбор("Документы контрагента " + Строка(Контрагент), Истина);
	Элементы.КнопкаНазадККонтрагентам.Видимость = ЗначениеЗаполнено(ПризнакРазбора);

КонецПроцедуры

&НаКлиенте
Процедура НазадККонтрагентамВыполнить(Команда)

	Если ПризнакРазбора = ПризнакБезАдреса() Тогда
		ЗапомнитьРазбор("БезАдреса");
		ПоказатьКонтрагентовБезАдреса();
	ИначеЕсли ЗначениеЗаполнено(ПризнакРазбора) Тогда
		ЗапомнитьРазбор("Признак", ПризнакРазбора);
		ПоказатьКонтрагентовПризнака(ПризнакРазбора);
	КонецЕсли;

КонецПроцедуры

// Переключение страницы разбора. Показываем ровно одну таблицу: у документов
// и контрагентов разные колонки, и обе сразу читались бы как один список.
&НаСервере
Процедура ПоказатьРазбор(Знач Заголовок, Знач ЭтоДокументы)

	Если ЭтоДокументы Тогда
		СписокКонтрагентов.Очистить();
		Количество = Документы.Количество();
		// Расшифровки по снимкам сторожей вид не несут - определяем по ссылке.
		Для Каждого СтрокаДокумента Из Документы Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаДокумента.Вид) Тогда
				СтрокаДокумента.Вид = ЭДО_Витрина.ВидДокумента(СтрокаДокумента.Документ);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Документы.Очистить();
		Количество = СписокКонтрагентов.Количество();
	КонецЕсли;

	Элементы.ТаблицаДокументов.Видимость = ЭтоДокументы;
	Элементы.ТаблицаСписокКА.Видимость = НЕ ЭтоДокументы;
	Элементы.КнопкаНазадККонтрагентам.Видимость = Ложь;

	// Колонки расшифровок по снимкам сторожей включает сама расшифровка.
	Элементы.ДокОтправленоНа.Видимость = Ложь;
	Элементы.ДокТекущийАдрес.Видимость = Ложь;
	Элементы.ДокСтатусОператора.Видимость = Ложь;
	Элементы.ДокСтатусОператора.Заголовок = "Статус у оператора";
	Элементы.ДокДатаПОА.Видимость = Ложь;
	Элементы.ДокСумма.Видимость = Истина;
	Элементы.ДокСуммаВЭДО.Видимость = Истина;   // ЩА 15.10.2026 [yan]
	Элементы.КаНетАдреса.Видимость = Ложь;

	ТекстРазбора = Заголовок + ", строк: " + Формат(Количество, "ЧГ=0")
		+ ?(ЭтоДокументы И Количество >= ЛимитСтрокРазбора(), " (показаны первые " + Формат(ЛимитСтрокРазбора(), "ЧГ=0")
			+ " - сузьте период или отбор)", "");
	Элементы.НадписьРазбор.Заголовок = ТекстРазбора;
	Элементы.СтраницыЦентра.ТекущаяСтраница = Элементы.СтраницаРазбор;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	// Двойной щелчок открывает карточку "Состояние ЭДО" с историей отправок, сам документ - кнопкой "Открыть".
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТаблицаДокументов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// В расшифровке наших ПОА документ бывает не найден в базе: номер и дата там - от оператора.
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда
		ПоказатьПредупреждение(, "Документ " + ТекущиеДанные.Номер + " в базе не найден.");
		Возврат;
	КонецЕсли;
	ЭДО_Клиент.ОткрытьКарточкуСостоянияЭДО(ТекущиеДанные.Документ, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСписокКАВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	// Двойной щелчок раскрывает документы контрагента за период, карточка контрагента - кнопкой "Открыть".
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТаблицаСписокКА.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ЗапомнитьРазбор("Контрагент", ТекущиеДанные.Контрагент);
		ПоказатьДокументыКонтрагента(ТекущиеДанные.Контрагент);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЭлементВыполнить(Команда)

	Если Элементы.ТаблицаДокументов.Видимость И Элементы.ТаблицаДокументов.ТекущиеДанные <> Неопределено Тогда
		Если ЗначениеЗаполнено(Элементы.ТаблицаДокументов.ТекущиеДанные.Документ) Тогда
			ОткрытьЗначение(Элементы.ТаблицаДокументов.ТекущиеДанные.Документ);
		Иначе
			ПоказатьПредупреждение(, "Документ в базе не найден");
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Элементы.ТаблицаСписокКА.Видимость И Элементы.ТаблицаСписокКА.ТекущиеДанные <> Неопределено Тогда
		ОткрытьЗначение(Элементы.ТаблицаСписокКА.ТекущиеДанные.Контрагент);
		Возврат;
	КонецЕсли;

	ПоказатьПредупреждение(, "Выберите строку на закладке Разбор");

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьAPIВыполнить(Команда)

	ПоказатьПредупреждение(, ПроверитьAPIНаСервере());

КонецПроцедуры

// Единственное место формы, которое ходит в сеть, и только по кнопке.
&НаСервере
Функция ПроверитьAPIНаСервере()

	// ЩА 14.10.2026 [yan]: проверка - по организации отбора, а без нее - по каждой учетной записи базы.
	// Без организации в базе с несколькими учетными записями токен не получить: неизвестно, чьим
	// сертификатом подписывать, и кнопка отвечала «связи нет» при живой связи (ГХ: Лион и ТД ЛИОН).
	ОрганизацииДляПроверки = Новый Массив;
	Если ЗначениеЗаполнено(ОтборОрганизация) Тогда
		ОрганизацииДляПроверки.Добавить(ОтборОрганизация);
	Иначе
		Для Каждого Запись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
			Если ЗначениеЗаполнено(Запись.Организация) И ОрганизацииДляПроверки.Найти(Запись.Организация) = Неопределено Тогда
				ОрганизацииДляПроверки.Добавить(Запись.Организация);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ОрганизацииДляПроверки.Количество() = 0 Тогда
		ОрганизацииДляПроверки.Добавить(Неопределено);   // учетная запись одна, без организации
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого Организация Из ОрганизацииДляПроверки Цикл
		Префикс = ?(Организация = Неопределено, "", Строка(Организация) + ": ");
		Попытка
			Результат = ЭДО_Сервер.ПроверитьКонтурAPI(Организация);
		Исключение
			Строки.Добавить(Префикс + "проверка не выполнена - " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("Описание") Тогда
			// ПроверитьКонтурAPI возвращает Структура (Годен, Описание): раньше форма выводила слово «Структура».
			Строки.Добавить(Префикс + ?(Результат.Свойство("Годен") И Результат.Годен = Истина,
				"связь в порядке", "СВЯЗИ НЕТ") + Символы.ПС + "   " + Строка(Результат.Описание));
		Иначе
			Строки.Добавить(Префикс + Строка(Результат));
		КонецЕсли;
	КонецЦикла;

	Возврат "Проверка связи с оператором" + Символы.ПС + СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаКлиенте
Процедура СнятьПаузуВыполнить(Команда)

	Если НЕ Элементы.ТаблицаСписокКА.Видимость ИЛИ Элементы.ТаблицаСписокКА.ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите контрагента на закладке Разбор");
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элементы.ТаблицаСписокКА.ТекущиеДанные;
	Если НЕ ТекущиеДанные.НаПаузе Тогда
		ПоказатьПредупреждение(, "У этого контрагента отправка не приостановлена");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("СнятьПаузуЗавершение", ЭтотОбъект, ТекущиеДанные.Контрагент);
	ПоказатьВопрос(Оповещение, "Возобновить отправку контрагенту " + ТекущиеДанные.Контрагент + "?",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СнятьПаузуЗавершение(Ответ, Контрагент) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	СнятьПаузуНаСервере(Контрагент);
	ОбновитьНаСервере();
	ПоказатьПредупреждение(, "Отправка возобновлена");

КонецПроцедуры

&НаСервере
Процедура СнятьПаузуНаСервере(Знач Контрагент)

	ЭДО_Сервер.ВозобновитьОтправкуКонтрагенту(Контрагент);

КонецПроцедуры

// Отправка из разбора - та же ручная отправка, что в карточке (ЭДО_Сервер.ОтправитьВручную), пакетом.
// Вопросы задаются один раз на пакет: до отправки - про подписанные, после первого прохода - про
// преодолимый гейт (до отправки неизвестно, в какую причину упрется документ).
&НаКлиенте
Процедура ОтправитьВыделенныеВыполнить(Команда)

	Если НЕ Элементы.ТаблицаДокументов.Видимость
		ИЛИ Элементы.ТаблицаДокументов.ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выделите документы на закладке Разбор");
		Возврат;
	КонецЕсли;

	Выделенные = Новый Массив;
	Подписанные = Новый Массив;
	Для Каждого Ид Из Элементы.ТаблицаДокументов.ВыделенныеСтроки Цикл
		СтрокаДокумента = Документы.НайтиПоИдентификатору(Ид);
		Если СтрокаДокумента = Неопределено ИЛИ НЕ ЗначениеЗаполнено(СтрокаДокумента.Документ) Тогда
			Продолжить;
		КонецЕсли;
		Выделенные.Добавить(Ид);
		// Подписанность - по тексту колонки ЭДО, как в витрине: ЭДО_КодСостояния в бою пуст.
		// ЩА 15.10.2026 [yan]: «Подписан контрагентом», до переписывания - прежнее «Принят»; отклоненное
		// аннулирование - тоже подписанный документ.
		ТекстСостояния = СокрЛП(СтрокаДокумента.Состояние);
		Если ТекстСостояния = "Подписан контрагентом" ИЛИ ТекстСостояния = "Принят"
			ИЛИ ТекстСостояния = "Аннулирование отклонено контрагентом" Тогда
			Подписанные.Добавить(Ид);
		КонецЕсли;
	КонецЦикла;

	Если Выделенные.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Среди выделенных нет документов базы");
		Возврат;
	КонецЕсли;

	Если Выделенные.Количество() > МаксДокументовЗаРаз() Тогда
		ПоказатьПредупреждение(, "Выделено документов: " + Выделенные.Количество()
			+ ". За одно нажатие отправляется не больше " + МаксДокументовЗаРаз()
			+ " - иначе вызов сервера обрывается по таймауту на середине пакета.");
		Возврат;
	КонецЕсли;

	Текст = "Отправить в ЭДО документов: " + Выделенные.Количество() + "?"
		+ Символы.ПС + "Уже отправленные уйдут повторно, у контрагента появится новый экземпляр.";
	Кнопки = Новый СписокЗначений;
	Если Подписанные.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + Символы.ПС
			+ "Из них ПОДПИСАНЫ контрагентом: " + Подписанные.Количество()
			+ ". Переотправка создаст у него второй экземпляр на ту же отгрузку.";
		Если Подписанные.Количество() < Выделенные.Количество() Тогда
			Кнопки.Добавить("БезПодписанных", "Без подписанных ("
				+ (Выделенные.Количество() - Подписанные.Количество()) + ")");
		КонецЕсли;
		Кнопки.Добавить("Все", "Отправить все");
	Иначе
		Кнопки.Добавить("Все", "Отправить");
	КонецЕсли;
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, "Отмена");

	Контекст = Новый Структура("Выделенные, Подписанные", Выделенные, Подписанные);
	ПоказатьВопрос(Новый ОписаниеОповещения("ОтправитьВыделенныеЗавершение", ЭтотОбъект, Контекст),
		Текст, Кнопки, , КодВозвратаДиалога.Отмена);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВыделенныеЗавершение(Ответ, Контекст) Экспорт

	Если Ответ <> "Все" И Ответ <> "БезПодписанных" Тогда
		Возврат;
	КонецЕсли;

	Отправки = Новый Массив;
	Для Каждого Ид Из Контекст.Выделенные Цикл
		Если Ответ = "БезПодписанных" И Контекст.Подписанные.Найти(Ид) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Отправки.Добавить(Новый Структура("Ид, Гейт", Ид, ""));
	КонецЦикла;

	ВыполнитьОтправку(Отправки);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОтправку(Знач Отправки)

	Состояние("Центр управления ЭДО", , "Отправляю документов: " + Отправки.Количество() + "…");
	Сводка = ОтправитьСтрокиНаСервере(Отправки);
	Состояние();

	Если Сводка.Преодолимые.Количество() > 0 Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ОтправитьПреодолевГейтЗавершение", ЭтотОбъект, Сводка),
			Сводка.Текст + Символы.ПС + Символы.ПС
			+ "Не ушли, но человек вправе отправить их сам: " + Сводка.Преодолимые.Количество()
			+ " (старше даты начала работы с оператором или уже уходили через СБИС)." + Символы.ПС
			+ "Если документ уже был принят контрагентом по прежнему каналу, у него появится"
			+ " второй экземпляр на ту же отгрузку." + Символы.ПС + Символы.ПС
			+ "Все равно отправить их?",
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		Возврат;
	КонецЕсли;

	ПоказатьПредупреждение(, Сводка.Текст);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьПреодолевГейтЗавершение(Ответ, Сводка) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	// Второй проход только по упершимся в преодолимый гейт и только с их кодом причины:
	// снятие одного гейта не должно открывать документу другой.
	ВыполнитьОтправку(Сводка.Преодолимые);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция МаксДокументовЗаРаз()

	Возврат 100;

КонецФункции

// Отправка строк разбора. Итог по каждому документу уходит в сообщения формы (там его видно
// списком и можно перейти к документу), колонка "Состояние" перечитывается из базы.
&НаСервере
Функция ОтправитьСтрокиНаСервере(Знач Отправки)

	Сводка = Новый Структура("Текст, Преодолимые", "", Новый Массив);
	Отправлено = 0;
	Удержано = 0;
	Ошибок = 0;

	СвСостояние = ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние");
	Для Каждого Отправка Из Отправки Цикл
		СтрокаДокумента = Документы.НайтиПоИдентификатору(Отправка.Ид);
		Если СтрокаДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Итог = ЭДО_Сервер.ОтправитьВручную(СтрокаДокумента.Документ, Отправка.Гейт);
		Если Итог.Успех Тогда
			Отправлено = Отправлено + 1;
		ИначеЕсли Итог.ГейтПреодолим И НЕ ЗначениеЗаполнено(Отправка.Гейт) Тогда
			Сводка.Преодолимые.Добавить(Новый Структура("Ид, Гейт", Отправка.Ид, Итог.КодПричины));
		ИначеЕсли Итог.Заголовок = "Ошибка отправки" Тогда
			Ошибок = Ошибок + 1;
		Иначе
			Удержано = Удержано + 1;
		КонецЕсли;

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Строка(СтрокаДокумента.Документ) + ": " + Итог.Заголовок + ". " + Итог.Текст;
		Сообщение.Сообщить();

		Если СвСостояние <> Неопределено И НЕ СвСостояние.Пустая() Тогда
			Значение = ЭДО_Сервер.ЗначениеСвойстваОбъекта(СтрокаДокумента.Документ, СвСостояние);
			СтрокаДокумента.Состояние = ?(Значение = Неопределено, "", Строка(Значение));
		КонецЕсли;
	КонецЦикла;

	Сводка.Текст = "Отправлено: " + Отправлено
		+ ?(Удержано > 0, ", не пропущено механизмом: " + Удержано, "")
		+ ?(Ошибок > 0, ", ошибок: " + Ошибок, "")
		+ ?(Сводка.Преодолимые.Количество() > 0, ", ждут решения: " + Сводка.Преодолимые.Количество(), "")
		+ ". Итог по каждому документу - в сообщениях под формой.";

	Возврат Сводка;

КонецФункции

// Проверка кодов маркировки в Честном знаке по выделенным строкам разбора - только показ,
// ничего не меняет в документах и не влияет на отправку. Профиль базы может не поддерживать
// это вовсе (у ядра своего обращения в Честный знак нет) - тогда просто покажем его отказ.
&НаКлиенте
Процедура ПроверитьКодыМаркировкиВыполнить(Команда)

	Если НЕ Элементы.ТаблицаДокументов.Видимость Тогда
		ПоказатьПредупреждение(, "Выделите документы на закладке Разбор");
		Возврат;
	КонецЕсли;

	Ид = Элементы.ТаблицаДокументов.ВыделенныеСтроки;
	Если Ид.Количество() = 0 И Элементы.ТаблицаДокументов.ТекущиеДанные <> Неопределено Тогда
		// Ничего не выделено - берем строку, на которой стоит курсор, как и остальные
		// команды разбора, действующие "по выделенным".
		Ид = Новый Массив;
		Ид.Добавить(Элементы.ТаблицаДокументов.ТекущиеДанные.ПолучитьИдентификатор());
	КонецЕсли;

	Если Ид.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выделите документы на закладке Разбор");
		Возврат;
	КонецЕсли;

	Максимум = МаксДокументовМаркировкиЗаРаз();
	Если Ид.Количество() > Максимум Тогда
		ВыделеноВсего = Ид.Количество();
		ПоказатьПредупреждение(, "Выделено документов: " + ВыделеноВсего
			+ ". За одно нажатие проверяется не больше " + Максимум
			+ " - иначе обращение в Честный знак идет слишком долго. Осталось проверить: "
			+ (ВыделеноВсего - Максимум) + ".");
		Возврат;
	КонецЕсли;

	Состояние("Центр управления ЭДО", , "Проверяю коды маркировки в Честном знаке…");
	Текст = ПроверитьКодыМаркировкиНаСервере(Ид);
	Состояние();
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция МаксДокументовМаркировкиЗаРаз()

	Возврат 50;

КонецФункции

&НаСервере
Функция ПроверитьКодыМаркировкиНаСервере(Знач СписокИд)

	Ссылки = Новый Массив;
	Для Каждого Ид Из СписокИд Цикл
		СтрокаДокумента = Документы.НайтиПоИдентификатору(Ид);
		Если СтрокаДокумента <> Неопределено И ЗначениеЗаполнено(СтрокаДокумента.Документ) Тогда
			Ссылки.Добавить(СтрокаДокумента.Документ);
		КонецЕсли;
	КонецЦикла;

	Если Ссылки.Количество() = 0 Тогда
		Возврат "Среди выделенных нет документов базы";
	КонецЕсли;

	Результат = ЭДО_Сервер.ПроверитьКодыМаркировки(Ссылки);
	Если НЕ Результат.Поддержано Тогда
		Возврат Результат.Текст;
	КонецЕсли;

	// Не "Заголовок": это свойство формы, и присваивание переименовало бы окно
	// Центра управления в "Проверено документов: ..." (замечание автора ядра к PR #49).
	ТекстИтога = "Проверено документов: " + Ссылки.Количество() + ", кодов: " + Результат.Всего
		+ ?(Результат.Ошибок > 0, ", ошибок проверки: " + Результат.Ошибок, "");

	Возврат ТекстИтога + Символы.ПС + Символы.ПС + Результат.Текст;

КонецФункции

// Причина отказа нужна прямо в списке: без нее разбор отказов - это открытие карточек по одной.
// Спрашиваем оператора только по отказам и ошибкам отправки, пачками по 50 цепочек.
&НаСервере
Процедура ЗаполнитьПричиныОтказа()

	// Не "Состояния": это имя реквизита формы, присваивание ему падает в работе.
	СостоянияСПричиной = Новый Соответствие;
	Для Каждого Текст Из ЭДО_Сервер.ТекстыСтатусаСПрежними(ЭДО_Сервер.ТекстОтклоненКонтрагентом()) Цикл
		СостоянияСПричиной.Вставить(ВРег(Текст), Истина);
	КонецЦикла;
	Для Каждого Текст Из ЭДО_Сервер.ТекстыСтатусаСПрежними(ЭДО_Сервер.ТекстОшибкаОтправкиУОператора()) Цикл
		СостоянияСПричиной.Вставить(ВРег(Текст), Истина);
	КонецЦикла;
	СостоянияСПричиной.Вставить(ВРег(ЭДО_Сервер.ТекстПолучательНеПринимаетАктыСверки()), Истина);

	Ссылки = Новый Массив;
	Для Каждого СтрокаДокумента Из Документы Цикл
		Если СостоянияСПричиной.Получить(ВРег(СокрЛП(СтрокаДокумента.Состояние))) <> Неопределено
			И Ссылки.Количество() < МаксПричинЗаРаз() Тогда
			Ссылки.Добавить(СтрокаДокумента.Документ);
		КонецЕсли;
	КонецЦикла;
	Если Ссылки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Причины = ЭДО_Сервер.ПричиныОтказаДокументов(Ссылки);
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ЗаполнитьПричиныОтказа: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		// Причина - подсказка, список без нее все равно полезен.
		Возврат;
	КонецПопытки;

	Для Каждого СтрокаДокумента Из Документы Цикл
		ТекстПричины = Причины.Получить(СтрокаДокумента.Документ);
		Если ТекстПричины <> Неопределено Тогда
			Если ЭДО_Сервер.ПолучательНеПринимаетАктыСверки(ТекстПричины) Тогда
				ТекстПричины = ЭДО_Сервер.ПонятнаяПричинаОтказаОтправки(ТекстПричины);
			КонецЕсли;
			ТекстПричины = ?(ЗначениеЗаполнено(ТекстПричины), ТекстПричины, "(причина не указана)");
			// ЩА 15.10.2026 [yan]: пояснение витрины (документ изменен после отправки) не затираем.
			СтрокаДокумента.Причина = ?(ЗначениеЗаполнено(СтрокаДокумента.Причина),
				ТекстПричины + "; " + СтрокаДокумента.Причина, ТекстПричины);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Потолок, чтобы щелчок по большой группе не превращался в минутное ожидание: 500 документов - 10 запросов.
&НаСервереБезКонтекста
Функция МаксПричинЗаРаз()

	Возврат 500;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Приглашения контрагентов.
//
// Таблица заполняется по кнопке "Заполнить список" (ЗаполнитьПриглашенияНаСервере), а не при
// открытии формы и не в общем ЗаполнитьДанные - список строится по всем контрагентам периода,
// и на боевой базе это десятки секунд. Полный список хранится отдельно в ПриглашенияВсе:
// щелчок по строке сводки фильтрует видимую таблицу Приглашения БЕЗ повторного похода
// в витрину. Обновление состояний и сама рассылка приглашений - действия наружу, к оператору,
// поэтому идут по кнопке и обязательно переспрашивают подтверждение с числом адресов.
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ТаблицаПриглашенияСводкаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТаблицаПриглашенияСводка.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПоказатьПриглашенияСостояния(ТекущиеДанные.Состояние);

КонецПроцедуры

&НаСервере
Процедура ПоказатьПриглашенияСостояния(Знач Состояние)

	Приглашения.Очистить();
	Для Каждого СтрокаДанных Из ПриглашенияВсе Цикл
		Если СтрокаДанных.Состояние = Состояние Тогда
			ЗаполнитьЗначенияСвойств(Приглашения.Добавить(), СтрокаДанных);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПриглашенияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	// Двойной щелчок показывает ВСЕ ящики контрагента с их состояниями: у одного ИНН их
	// бывает несколько у разных операторов, и в строке виден только рабочий. Карточка самого
	// контрагента открывается щелчком по колонке "Контрагент".
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТаблицаПриглашения.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Поле = Элементы.ПрКонтрагент Тогда
		ОткрытьЗначение(ТекущиеДанные.Контрагент);
		Возврат;
	КонецЕсли;

	ПоказатьПредупреждение(, ЯщикиКонтрагентаТекстом(ТекущиеДанные.Контрагент));

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция МаксАдресовПриглашенийЗаРаз()

	Возврат 300;

КонецФункции

&НаКлиенте
Процедура ОбновитьСостоянияПриглашенийВыполнить(Команда)

	Если НужнаОрганизацияДляПриглашения() Тогда
		ПоказатьПредупреждение(, "Выберите организацию в шапке: приглашения и их состояния ведутся по организации");
		Возврат;
	КонецЕсли;
	Адреса = ПриглашенияАдресаИзСписка();
	Если Адреса.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "В списке приглашений нет адресов для опроса");
		Возврат;
	КонецЕсли;

	Состояние("Центр управления ЭДО", , "Опрашиваю оператора по адресам: " + Адреса.Количество() + "...");
	Свод = ОбновитьСостоянияПриглашенийНаСервере(Адреса);
	Состояние();

	ПоказатьПредупреждение(, Свод);

КонецПроцедуры

// Адреса из уже показанной (видимой, отфильтрованной) таблицы Приглашения, без пустых и без
// повторов - именно "текущий список", как требует кнопка "Обновить состояние".
&НаСервере
Функция ПриглашенияАдресаИзСписка()

	Уникальные = Новый Соответствие;
	Для Каждого СтрокаДанных Из Приглашения Цикл
		Если ЗначениеЗаполнено(СтрокаДанных.Адрес) Тогда
			Уникальные.Вставить(СтрокаДанных.Адрес, Истина);
		КонецЕсли;
	КонецЦикла;

	Адреса = Новый Массив;
	Для Каждого КлючЗначение Из Уникальные Цикл
		Адреса.Добавить(КлючЗначение.Ключ);
	КонецЦикла;

	Возврат Адреса;

КонецФункции

// Адреса контрагентов, кому еще не звали, из ПОЛНОГО списка (ПриглашенияВсе) - "пригласить
// всех" не должно зависеть от того, отфильтрован ли сейчас видимый список щелчком по сводке.
&НаСервере
Функция ПриглашенияАдресаНеЗваных()

	Уникальные = Новый Соответствие;
	Для Каждого СтрокаДанных Из ПриглашенияВсе Цикл
		Если СтрокаДанных.Состояние = "Не звали" И ЗначениеЗаполнено(СтрокаДанных.Адрес) Тогда
			Уникальные.Вставить(СтрокаДанных.Адрес, Истина);
		КонецЕсли;
	КонецЦикла;

	Адреса = Новый Массив;
	Для Каждого КлючЗначение Из Уникальные Цикл
		Адреса.Добавить(КлючЗначение.Ключ);
	КонецЦикла;

	Возврат Адреса;

КонецФункции

// Обновление состояний перечитывает СВОЙ список, а не весь дашборд: ЗаполнитьДанные пересчитывает
// показатели по всем закладкам и заново стер бы видимые Приглашения (закладка использует свою
// кнопку "Заполнить список", а не общее "Обновить" формы).
&НаСервере
Функция ОбновитьСостоянияПриглашенийНаСервере(Знач Адреса)

	Результат = ЭДО_Сервер.ОбновитьСостоянияПриглашений(Адреса, ОтборОрганизация);
	ЗаполнитьПриглашенияНаСервере();
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ПригласитьВыделенныеВыполнить(Команда)

	Если Элементы.ТаблицаПриглашения.ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выделите контрагентов в списке приглашений");
		Возврат;
	КонецЕсли;

	Адреса = ПриглашенияАдресаВыделенных(Элементы.ТаблицаПриглашения.ВыделенныеСтроки);
	Если Адреса.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "У выделенных контрагентов нет адреса ЭДО - звать некуда");
		Возврат;
	КонецЕсли;

	СпроситьИПригласить(Адреса, "Отправить приглашение в ЭДО по адресам");

КонецПроцедуры

&НаСервере
Функция ПриглашенияАдресаВыделенных(Знач Идентификаторы)

	Уникальные = Новый Соответствие;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		СтрокаПриглашения = Приглашения.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаПриглашения = Неопределено ИЛИ НЕ ЗначениеЗаполнено(СтрокаПриглашения.Адрес) Тогда
			Продолжить;
		КонецЕсли;
		Уникальные.Вставить(СтрокаПриглашения.Адрес, Истина);
	КонецЦикла;

	Адреса = Новый Массив;
	Для Каждого КлючЗначение Из Уникальные Цикл
		Адреса.Добавить(КлючЗначение.Ключ);
	КонецЦикла;

	Возврат Адреса;

КонецФункции

&НаКлиенте
Процедура ПригласитьВсехНеЗваныхВыполнить(Команда)

	Адреса = ПриглашенияАдресаНеЗваных();
	Если Адреса.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Все контрагенты с адресом ЭДО уже позваны");
		Возврат;
	КонецЕсли;

	СпроситьИПригласить(Адреса, "Отправить приглашение всем контрагентам, кому еще не звали");

КонецПроцедуры

// Общее подтверждение для обеих кнопок приглашения: рассылка - действие наружу, к оператору,
// поэтому спрашиваем число адресов до отправки, а не после. Один вызов уводит не больше
// МаксАдресовПриглашенийЗаРаз - в вопросе явно называем, сколько уйдет сейчас и сколько
// останется, иначе число в вопросе (все выделенные) и число в свершившемся факте (не больше
// потолка) расходятся, и это выглядит как ошибка.
&НаКлиенте
Процедура СпроситьИПригласить(Знач Адреса, Знач ТекстДействия)

	// ЩА 23.10.2026 [yan]: при «всех организациях» приглашение ушло бы от первой учетной записи - не угадываем.
	Если НужнаОрганизацияДляПриглашения() Тогда
		ПоказатьПредупреждение(, "Выберите организацию в шапке: приглашение уходит от ее учетной записи ЭДО");
		Возврат;
	КонецЕсли;

	Всего = Адреса.Количество();
	Потолок = МаксАдресовПриглашенийЗаРаз();
	УйдетСейчас = Мин(Всего, Потолок);
	Останется = Макс(Всего - Потолок, 0);

	Вопрос = ТекстДействия + ": " + Всего + "?";
	Если Останется > 0 Тогда
		Вопрос = Вопрос + Символы.ПС + "За этот раз уйдет " + УйдетСейчас
			+ ", останется " + Останется + " - вызовите действие еще раз для остатка.";
	КонецЕсли;
	Вопрос = Вопрос + Символы.ПС + "Действие уходит наружу, к оператору ЭДО.";

	Оповещение = Новый ОписаниеОповещения("ПригласитьПоАдресамЗавершение", ЭтотОбъект, Адреса);
	ПоказатьВопрос(Оповещение, Вопрос, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаСервере
Функция НужнаОрганизацияДляПриглашения()

	Возврат НЕ ЗначениеЗаполнено(ОтборОрганизация) И ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО();

КонецФункции

&НаКлиенте
Процедура ПригласитьПоАдресамЗавершение(Ответ, Адреса) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние("Центр управления ЭДО", , "Отправляю приглашения: " + Адреса.Количество() + "...");
	Свод = ПригласитьПоСпискуНаСервере(Адреса);
	Состояние();

	ПоказатьПредупреждение(, Свод);

КонецПроцедуры

&НаСервере
Функция ПригласитьПоСпискуНаСервере(Знач Адреса)

	Результат = ЭДО_Сервер.ПригласитьПоСписку(Адреса, ОтборОрганизация);
	ЗаполнитьПриглашенияНаСервере();
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ЗаполнитьПриглашенияВыполнить(Команда)

	// ЩА 23.10.2026 [yan]: состояния приглашений хранятся по организации - без нее при нескольких учетных
	// записях КэшСостоянийПриглашений падал исключением.
	Если НужнаОрганизацияДляПриглашения() Тогда
		ПоказатьПредупреждение(, "Выберите организацию в шапке: приглашения и их состояния ведутся по организации");
		Возврат;
	КонецЕсли;
	ЗаполнитьПриглашенияНаСервере();

КонецПроцедуры

// Полный несфильтрованный список кладется отдельно (ПриглашенияВсе) - щелчок по сводке
// фильтрует видимую таблицу Приглашения без повторного обращения к витрине.
&НаСервере
Процедура ЗаполнитьПриглашенияНаСервере()

	СводДанныхПриглашений = ЭДО_Витрина.СводкаПриглашений(НачалоПериода, КонецПериода, ОтборОрганизация,
		ОтборКонтрагент);
	ЗагрузитьВТаблицу(ПриглашенияВсе, СводДанныхПриглашений);
	ЗагрузитьВТаблицу(Приглашения, СводДанныхПриглашений);
	ЗагрузитьВТаблицу(ПриглашенияСводка, ЭДО_Витрина.ИтогиПриглашений(СводДанныхПриглашений));

КонецПроцедуры

// Все ящики контрагента текстом: адрес, оператор, состояние, даты. Рабочий помечен звездочкой -
// именно на него уходят документы и приглашение из списка.
&НаСервере
Функция ЯщикиКонтрагентаТекстом(Знач Контрагент)

	Ящики = ЭДО_Витрина.ЯщикиКонтрагента(Контрагент, ОтборОрганизация);
	Если Ящики.Количество() = 0 Тогда
		Возврат "У контрагента " + Строка(Контрагент) + " ящиков ЭДО не найдено";
	КонецЕсли;

	Текст = Строка(Контрагент) + ", ящиков: " + Ящики.Количество();
	Для Каждого Ящик Из Ящики Цикл
		Текст = Текст + Символы.ПС + ?(Ящик.Рабочий, "* ", "  ") + Ящик.Адрес
			+ " | " + Ящик.Оператор + " | " + Ящик.Состояние
			+ ?(ЗначениеЗаполнено(Ящик.ДатаПриглашения), " | звали " + Формат(Ящик.ДатаПриглашения, "ДФ=dd.MM.yyyy"), "");
	КонецЦикла;

	Возврат Текст;

КонецФункции

#Область Входящие

// Входящие УПД за период. Список не строится при открытии формы и при смене отбора: это
// обращение к оператору, а нужен он не каждый раз (как и список приглашений).
&НаКлиенте
Процедура ПолучитьВходящиеВыполнить(Команда)

	ТекстОшибки = ПолучитьВходящиеНаСервере();
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьВходящиеНаСервере()

	ВходящиеВсе.Очистить();
	Ошибки = Новый Массив;
	Попытка
		Данные = ЭДО_Сервер.ВходящиеУПДЗаПериод(НачалоПериода, КонецПериода, ОтборОрганизация, Ошибки);
	Исключение
		// ЩА 20.10.2026 [yan], ревью Codex 877: показанный список очищается вместе с исходным - иначе на экране
		// остались бы строки прежнего чтения при нулевой сводке.
		ВходящиеПрочитаныПо = "";
		ЗаполнитьСводкуВходящих();
		ПоказатьВходящиеСостояния("");
		Возврат "Список входящих не получен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Для Каждого Входящий Из Данные Цикл
		СтрокаСписка = ВходящиеВсе.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСписка, Входящий, "Ид, Дата, Номер, Продавец, ИННПродавца, Организация, Статус, Документ");
		ЗаполнитьЗначенияСвойств(СтрокаСписка, Входящий, "Вид, Версия, ЭтоУКД, ГидПродавца, Функция");   // ЩА 20.10.2026 [yan]
		СтрокаСписка.СостояниеЭДО = ЭДО_Сервер.ТекстСтатусаВходящего(СтрокаСписка.Статус);   // ЩА 15.10.2026 [yan]
		СтрокаСписка.Загрузка = СостояниеЗагрузкиВходящего(СтрокаСписка.Документ);
		// ЩА 20.10.2026 [yan]: поступление по этому УПД уже завел склад - привязать, а не создавать второе.
		Если НЕ ЗначениеЗаполнено(СтрокаСписка.Документ) И Входящий.Свойство("Кандидаты")
			И Входящий.Кандидаты.Количество() > 0 Тогда
			СтрокаСписка.Загрузка = ТекстЕстьПоступление();
			Представления = Новый Массив;
			Для Каждого Кандидат Из Входящий.Кандидаты Цикл
				Представления.Добавить(Строка(Кандидат));
			КонецЦикла;
			СтрокаСписка.Замечания = "Уже заведено: " + СтрСоединить(Представления, ", ") + " - «Привязать к поступлению»";
		КонецЕсли;
	КонецЦикла;
	ВходящиеВсе.Сортировать("Дата Убыв, Номер");
	// ЩА 20.10.2026 [yan], ревью Codex 877: неполный список (ошибка по части организаций) отбором не сужается -
	// при смене отбора он очищается с напоминанием получить его заново.
	ВходящиеПрочитаныПо = ?(Ошибки.Количество() = 0, КлючПрочтенияВходящих(ОтборОрганизация), МеткаНеполногоСпискаВходящих());
	ЗаполнитьСводкуВходящих();
	ПоказатьВходящиеСостояния("");
	Если Ошибки.Количество() > 0 Тогда
		Возврат "Список получен не по всем организациям:" + Символы.ПС + СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;
	Возврат "";

КонецФункции

// ЩА 20.10.2026 [yan]: отбор «Организация» и «Документы» шапки применяется к уже прочитанному списку
// входящих. Список читался за другой период или по другой организации - очищается: его получают
// заново («Получить список»), и он сразу приходит с отбором.
&НаСервере
Процедура ПрименитьОтборВходящих()
	Если ВходящиеВсе.Количество() > 0 И НЕ ВходящиеПодходятКОтбору() Тогда
		Если ВходящиеПрочитаныПо = МеткаНеполногоСпискаВходящих() Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Список входящих был получен не по всем организациям (с ошибками) - получите его заново"
				+ " кнопкой «Получить список», он придёт уже с новым отбором.";
			Сообщение.Сообщить();
		КонецЕсли;
		ВходящиеВсе.Очистить();
		ВходящиеПрочитаныПо = "";
	КонецЕсли;
	ЗаполнитьСводкуВходящих();
	ПоказатьВходящиеСостояния("");
КонецПроцедуры

// Отметка списка, прочитанного с ошибками по части организаций: отбором его не сужаем.
&НаСервереБезКонтекста
Функция МеткаНеполногоСпискаВходящих()
	Возврат "неполный";
КонецФункции

// Период и организация, по которым прочитан список: «начало|конец|организация» (пусто - все организации).
&НаСервере
Функция КлючПрочтенияВходящих(Знач Организация)
	Возврат Формат(НачалоПериода, "ДФ=yyyyMMdd") + "|" + Формат(КонецПериода, "ДФ=yyyyMMdd") + "|"
		+ ?(ЗначениеЗаполнено(Организация), Строка(Организация.УникальныйИдентификатор()), "");
КонецФункции

&НаСервере
Функция ВходящиеПодходятКОтбору()
	Если ВходящиеПрочитаныПо = КлючПрочтенияВходящих(ОтборОрганизация) Тогда
		Возврат Истина;
	КонецЕсли;
	// Прочитан по всем организациям за тот же период - годится для любой организации отбора.
	Возврат ВходящиеПрочитаныПо = КлючПрочтенияВходящих(Неопределено);
КонецФункции

// Строка входящих подходит под отбор организации и вида документов шапки.
&НаСервере
Функция ВходящийВОтборе(Знач СтрокаСписка)
	Если ЗначениеЗаполнено(ОтборОрганизация) И СтрокаСписка.Организация <> ОтборОрганизация Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ОтборВидДокументов) ИЛИ ОтборВидДокументов = "Все" Тогда
		Возврат Истина;
	ИначеЕсли ОтборВидДокументов = "УПД" Тогда
		Возврат НЕ СтрокаСписка.ЭтоУКД;
	ИначеЕсли ОтборВидДокументов = "УКД" Тогда
		Возврат СтрокаСписка.ЭтоУКД;
	КонецЕсли;
	Возврат Ложь;   // акты сверки и прочие виды во входящих пока не читаются
КонецФункции

// ЩА 20.10.2026 [yan]: состояние строки, когда подходящее поступление уже заведено, но не привязано.
&НаКлиентеНаСервереБезКонтекста
Функция ТекстЕстьПоступление()
	Возврат "Есть поступление";
КонецФункции

&НаСервереБезКонтекста
Функция СостояниеЗагрузкиВходящего(Знач Документ)
	Возврат ?(ЗначениеЗаполнено(Документ), "Загружено", "Не загружено");
КонецФункции

&НаСервере
Процедура ЗаполнитьСводкуВходящих()

	ВходящиеСводка.Очистить();
	Отобранные = ВходящиеВсе.Количество();
	Для Каждого СтрокаВходящего Из ВходящиеВсе Цикл
		Если НЕ ВходящийВОтборе(СтрокаВходящего) Тогда
			Отобранные = Отобранные - 1;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Состояние Из СтрРазделить("Не загружено," + ТекстЕстьПоступление() + ",Загружено", ",") Цикл
		СтрокаСписка = ВходящиеСводка.Добавить();
		СтрокаСписка.Состояние = Состояние;
		СтрокаСписка.Количество = 0;
		Для Каждого СтрокаВходящего Из ВходящиеВсе.НайтиСтроки(Новый Структура("Загрузка", Состояние)) Цикл
			Если ВходящийВОтборе(СтрокаВходящего) Тогда
				СтрокаСписка.Количество = СтрокаСписка.Количество + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Итого = ВходящиеСводка.Добавить();
	Итого.Состояние = "Все";
	Итого.Количество = Отобранные;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВходящиеСводкаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТаблицаВходящиеСводка.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоказатьВходящиеСостояния(?(ТекущиеДанные.Состояние = "Все", "", ТекущиеДанные.Состояние));
	КонецЕсли;

КонецПроцедуры

// Показать входящие с состоянием загрузки ("" - все).
&НаСервере
Процедура ПоказатьВходящиеСостояния(Знач Состояние)

	Входящие.Очистить();
	Для Каждого СтрокаСписка Из ВходящиеВсе Цикл
		Если (НЕ ЗначениеЗаполнено(Состояние) ИЛИ СтрокаСписка.Загрузка = Состояние) И ВходящийВОтборе(СтрокаСписка) Тогда
			ЗаполнитьЗначенияСвойств(Входящие.Добавить(), СтрокаСписка);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВходящиеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТаблицаВходящие.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// ЩА 20.10.2026 [yan]: щелчок по колонке документа базы - сам документ; иначе - карточка входящего
	// (просмотр, печатная форма, подписать, отказать, уточнение, аннулирование).
	Если Поле = Элементы.ВхДокумент И ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда
		ПоказатьЗначение(, ТекущиеДанные.Документ);
		Возврат;
	КонецЕсли;
	ПараметрыКарточки = Новый Структура("Ид, Организация, Вид, Номер, Дата, Продавец, ИННПродавца, ГидПродавца, Статус, Версия, ЭтоУКД, ФункцияДокумента");
	ЗаполнитьЗначенияСвойств(ПараметрыКарточки, ТекущиеДанные);
	ПараметрыКарточки.ФункцияДокумента = ТекущиеДанные.Функция;
	Если ТипЗнч(ТекущиеДанные.Документ) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		ПараметрыКарточки.Вставить("Документ", ТекущиеДанные.Документ);
	КонецЕсли;
	ОткрытьФорму("Обработка.ЭДО_КарточкаДокумента.Форма.ФормаВходящего", ПараметрыКарточки, ЭтотОбъект, ТекущиеДанные.Ид, , ,
		Новый ОписаниеОповещения("КарточкаВходящегоЗакрыта", ЭтотОбъект, ТекущиеДанные.ПолучитьИдентификатор()));

КонецПроцедуры

// После карточки входящего строка списка перечитывает связь с документом базы и статус у оператора.
&НаКлиенте
Процедура КарточкаВходящегоЗакрыта(Результат, ИдСтроки) Экспорт
	ОбновитьСтрокуВходящегоНаСервере(ИдСтроки);
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтрокуВходящегоНаСервере(Знач ИдСтроки)
	СтрокаСписка = Входящие.НайтиПоИдентификатору(ИдСтроки);
	Если СтрокаСписка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить(СтрокаСписка.Ид);
	СтрокаСписка.Документ = ЭДО_Сервер.ДокументыПоВходящим(Идентификаторы).Получить(СтрокаСписка.Ид);
	// Перехват обоснован: статус у оператора - уточнение строки; не ответил - строка остается прежней, в ЖР подробно.
	Попытка
		НовыйСтатус = ЭДО_Сервер.СтатусВходящегоУОператора(СтрокаСписка.Ид, СтрокаСписка.Организация);
		Если НовыйСтатус <> Неопределено Тогда
			СтрокаСписка.Статус = НовыйСтатус;
			СтрокаСписка.СостояниеЭДО = ЭДО_Сервер.ТекстСтатусаВходящего(НовыйСтатус);
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Статус входящего " + СтрокаСписка.Ид + " не обновлен: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Если ЗначениеЗаполнено(СтрокаСписка.Документ) Тогда
		СтрокаСписка.Загрузка = СостояниеЗагрузкиВходящего(СтрокаСписка.Документ);
	КонецЕсли;
	Для Каждого Исходная Из ВходящиеВсе.НайтиСтроки(Новый Структура("Ид", СтрокаСписка.Ид)) Цикл
		ЗаполнитьЗначенияСвойств(Исходная, СтрокаСписка, "Документ, Загрузка, Статус, СостояниеЭДО");
	КонецЦикла;
	ЗаполнитьСводкуВходящих();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПоступленияПоВходящимВыполнить(Команда)

	Выделенные = Новый Массив;
	Для Каждого Ид Из Элементы.ТаблицаВходящие.ВыделенныеСтроки Цикл
		Выделенные.Добавить(Ид);
	КонецЦикла;
	Если Выделенные.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выделите входящие документы в списке");
		Возврат;
	КонецЕсли;
	Если Выделенные.Количество() > МаксВходящихЗаРаз() Тогда
		ПоказатьПредупреждение(, "Выделено документов: " + Выделенные.Количество() + ". За одно нажатие создается не больше "
			+ МаксВходящихЗаРаз() + " - иначе вызов сервера обрывается по таймауту на середине пакета.");
		Возврат;
	КонецЕсли;
	Итог = СоздатьПоступленияНаСервере(Выделенные);
	ПоказатьПредупреждение(, Итог);

КонецПроцедуры

// ЩА 20.10.2026 [yan]: привязать входящий к поступлению, которое уже завели в базе (склад по ТТН ЕГАИС).
// Сначала - поступления с номером входящего, равным номеру УПД, затем все от поставщика за 10 дней.
&НаКлиенте
Процедура ПривязатьКПоступлениюВыполнить(Команда)

	ТекущиеДанные = Элементы.ТаблицаВходящие.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Выделите входящий документ в списке");
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда
		ПоказатьПредупреждение(, "Этот входящий уже связан с документом " + ТекущиеДанные.Документ);
		Возврат;
	КонецЕсли;
	Если ТекущиеДанные.ЭтоУКД Тогда
		ПоказатьПредупреждение(, ТекстУКДНеПривязывается());
		Возврат;
	КонецЕсли;
	ИдСтроки = ТекущиеДанные.ПолучитьИдентификатор();
	Список = ПоступленияДляПривязки(ИдСтроки);
	Если Список.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Поступлений этой организации от поставщика за 10 дней вокруг даты УПД, не связанных"
			+ " с другими входящими, нет");
		Возврат;
	КонецЕсли;
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПривязатьКПоступлениюЗавершение", ЭтотОбъект, ИдСтроки),
		Список, Элементы.ТаблицаВходящие);

КонецПроцедуры

&НаКлиенте
Процедура ПривязатьКПоступлениюЗавершение(ВыбранныйЭлемент, ИдСтроки) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, ПривязатьКПоступлениюНаСервере(ИдСтроки, ВыбранныйЭлемент.Значение));

КонецПроцедуры

&НаСервере
Функция ПоступленияДляПривязки(Знач ИдСтроки)

	Список = Новый СписокЗначений;
	СтрокаСписка = Входящие.НайтиПоИдентификатору(ИдСтроки);
	Если СтрокаСписка = Неопределено Тогда
		Возврат Список;
	КонецЕсли;
	Входящий = Новый Структура("Ид, Организация, ИННПродавца, Номер, Дата");
	ЗаполнитьЗначенияСвойств(Входящий, СтрокаСписка);
	ОдинВходящий = Новый Массив;
	ОдинВходящий.Добавить(Входящий);
	Наборы = Новый Массив;
	Наборы.Добавить(Новый Структура("ПоНомеру, Документы", Истина,
		ЭДО_Сервер.ДокументыКандидатыПоВходящим(ОдинВходящий, Истина).Получить(СтрокаСписка.Ид)));
	Наборы.Добавить(Новый Структура("ПоНомеру, Документы", Ложь,
		ЭДО_Сервер.ДокументыКандидатыПоВходящим(ОдинВходящий, Ложь).Получить(СтрокаСписка.Ид)));
	Для Каждого Набор Из Наборы Цикл
		Если Набор.Документы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Документ Из Набор.Документы Цикл
			Если Список.НайтиПоЗначению(Документ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Реквизиты = Новый Структура("НомерВходящегоДокумента, СуммаДокумента", "", 0);
			ЗаполнитьЗначенияСвойств(Реквизиты, Документ);
			Список.Добавить(Документ, Строка(Документ) + ", вх. № " + СокрЛП(Реквизиты.НомерВходящегоДокумента) + ", "
				+ Формат(Реквизиты.СуммаДокумента, "ЧДЦ=2; ЧН=0") + ?(Набор.ПоНомеру, " - номер совпадает", ""));
		КонецЦикла;
	КонецЦикла;
	Возврат Список;

КонецФункции

// Ид УКД в связи поступления заменил бы УПД, по которому оно заведено.
&НаКлиентеНаСервереБезКонтекста
Функция ТекстУКДНеПривязывается()
	Возврат "УКД к поступлению не привязывается: связь поступления занята его УПД";
КонецФункции

&НаСервере
Функция ПривязатьКПоступлениюНаСервере(Знач ИдСтроки, Знач Документ)

	СтрокаСписка = Входящие.НайтиПоИдентификатору(ИдСтроки);
	Если СтрокаСписка = Неопределено Тогда
		Возврат "Строка списка не найдена - обновите список входящих";
	КонецЕсли;
	Если СтрокаСписка.ЭтоУКД Тогда
		Возврат ТекстУКДНеПривязывается();
	КонецЕсли;
	Итог = ЭДО_Сервер.ПривязатьВходящийКДокументу(СтрокаСписка.Ид, СтрокаСписка.Организация, Документ, СтрокаСписка.Статус);
	Если Итог.Успех Тогда
		СтрокаСписка.Документ = Итог.Документ;
	КонецЕсли;
	СтрокаСписка.Загрузка = СостояниеЗагрузкиВходящего(СтрокаСписка.Документ);
	СтрокаСписка.Замечания = СтрСоединить(Итог.Сообщения, "; ");
	Для Каждого Исходная Из ВходящиеВсе.НайтиСтроки(Новый Структура("Ид", СтрокаСписка.Ид)) Цикл
		ЗаполнитьЗначенияСвойств(Исходная, СтрокаСписка, "Документ, Загрузка, Замечания");
	КонецЦикла;
	ЗаполнитьСводкуВходящих();
	Возврат "УПД № " + СтрокаСписка.Номер + ": " + Итог.Текст
		+ ?(Итог.Сообщения.Количество() > 0, Символы.ПС + СтрСоединить(Итог.Сообщения, Символы.ПС), "");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция МаксВходящихЗаРаз()
	Возврат 20;
КонецФункции

// Итог по каждому документу - в сообщения формы, строка списка обновляется на месте.
&НаСервере
Функция СоздатьПоступленияНаСервере(Знач Выделенные)

	Создано = 0;
	Ошибок = 0;
	Для Каждого Ид Из Выделенные Цикл
		СтрокаСписка = Входящие.НайтиПоИдентификатору(Ид);
		Если СтрокаСписка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаСписка.ЭтоУКД Тогда   // ЩА 20.10.2026 [yan]
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрокаСписка.Вид + " № " + СтрокаСписка.Номер + ": по корректировочному документу поступление не создаётся";
			Сообщение.Сообщить();
			Ошибок = Ошибок + 1;
			Продолжить;
		КонецЕсли;
		Попытка
			Итог = ЭДО_Сервер.СоздатьДокументПоВходящему(СтрокаСписка.Ид, СтрокаСписка.Организация, СтрокаСписка.Статус);
		Исключение
			Итог = Новый Структура("Успех, Документ, Текст, Сообщения", Ложь, Неопределено,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Новый Массив);
		КонецПопытки;
		Если Итог.Успех Тогда
			Создано = Создано + 1;
			СтрокаСписка.Документ = Итог.Документ;
		Иначе
			Ошибок = Ошибок + 1;
		КонецЕсли;
		СтрокаСписка.Загрузка = СостояниеЗагрузкиВходящего(СтрокаСписка.Документ);
		СтрокаСписка.Замечания = СтрСоединить(Итог.Сообщения, "; ");
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "УПД № " + СтрокаСписка.Номер + " от " + Формат(СтрокаСписка.Дата, "ДФ=dd.MM.yyyy") + " (" + СтрокаСписка.Продавец + "): "
			+ Итог.Текст + ?(Итог.Сообщения.Количество() > 0, Символы.ПС + СтрСоединить(Итог.Сообщения, Символы.ПС), "");
		Сообщение.Сообщить();
		Найденные = ВходящиеВсе.НайтиСтроки(Новый Структура("Ид", СтрокаСписка.Ид));
		Для Каждого Исходная Из Найденные Цикл
			ЗаполнитьЗначенияСвойств(Исходная, СтрокаСписка, "Документ, Загрузка, Замечания");
		КонецЦикла;
	КонецЦикла;
	ЗаполнитьСводкуВходящих();
	Возврат "Создано или привязано поступлений: " + Создано + ?(Ошибок > 0, ", не создано: " + Ошибок, "")
		+ ". Подробности - в сообщениях под формой и в колонке «Замечания».";

КонецФункции

#КонецОбласти
