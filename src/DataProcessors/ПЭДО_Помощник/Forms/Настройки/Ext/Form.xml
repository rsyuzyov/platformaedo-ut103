							<v8:content>Хост API</v8:content>
						</v8:item>
					</Title>
					<ToolTip>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Меняется только при переезде оператора.</v8:content>
						</v8:item>
					</ToolTip>
