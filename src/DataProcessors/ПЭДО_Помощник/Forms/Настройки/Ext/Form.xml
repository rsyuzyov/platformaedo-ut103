							<v8:content>Документов за прогон</v8:content>
						</v8:item>
					</Title>
					<ToolTip>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Остаток уходит следующим прогоном.</v8:content>
						</v8:item>
					</ToolTip>
					<SpinButton>true</SpinButton>
					<ContextMenu name="ЛимитДокументовЗаПрогонКонтекстноеМеню" id="20"/>
