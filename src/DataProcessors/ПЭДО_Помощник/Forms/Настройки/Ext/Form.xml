			</Title>
			<Group>Vertical</Group>
			<Representation>WeakSeparation</Representation>
			<ShowTitle>true</ShowTitle>
			<ExtendedTooltip name="ГруппаОтправкаРасширеннаяПодсказка" id="12"/>
			<ChildItems>
				<InputField name="ДатаНачалаОтправки" id="13">
					<DataPath>ДатаНачалаОтправки</DataPath>
					<Title>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Отправлять с даты</v8:content>
						</v8:item>
					</Title>
					<ToolTip>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Дата запуска ЭДО в бой. Документы раньше неё регламент не берёт никогда.</v8:content>
						</v8:item>
					</ToolTip>
					<AutoMarkIncomplete>true</AutoMarkIncomplete>
					<ContextMenu name="ДатаНачалаОтправкиКонтекстноеМеню" id="14"/>
					<ExtendedTooltip name="ДатаНачалаОтправкиРасширеннаяПодсказка" id="15"/>
