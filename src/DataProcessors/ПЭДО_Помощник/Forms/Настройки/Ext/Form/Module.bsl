// Настройки расширения «ПлатформаЭДО»: одно место, где видно и правится всё,
// от чего зависит работа отправки.
//
// 🔑 Форма ничего не знает про состав настроек: и поля, и проверка готовности идут
//    от реестра `ПЭДО_Сервер.ОписаниеНастроекЭДО()`. Добавил параметр в реестр —
//    он появляется в проверке сам; на форму остаётся добавить только поле.
//
// ⚠️🔴 Все настройки пишутся в ОБЩЕЕ хранилище (пользователь ""), а не в персональное.
//    До 22.08.2026 отпечаток подписанта лежал в настройках того, кто его задал: работало
//    лишь потому, что настраивал и отправлял один служебный пользователь, а у бухгалтера
//    из его сеанса подпись не находилась.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПрочитатьНастройкиВФорму();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьНастройки(Команда)
	ЗаписатьНастройкиНаСервере();
	Оповестить("ПЭДО_НастройкиИзменены");
	ПоказатьПредупреждение(, "Настройки записаны.");
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьГотовность(Команда)
	ПрочитатьНастройкиВФорму();
КонецПроцедуры

&НаКлиенте
Процедура ЗавестиСвойства(Команда)
	Вопрос = "Завести недостающие свойства объектов? Существующие не изменяются.";
	ПоказатьВопрос(Новый ОписаниеОповещения("ЗавестиСвойстваЗавершение", ЭтотОбъект),
		Вопрос, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ЗавестиСвойстваЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, ЗавестиСвойстваНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВОбщие(Команда)
	// ⚠️ Разовая операция для баз, настроенных до 22.08.2026: поднимает персональные
	//    значения в общие, чтобы настройки видел не только тот, кто их задавал.
	ПоказатьПредупреждение(, ПеренестиВОбщиеНаСервере());
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПрочитатьНастройкиВФорму()

	ДатаНачалаОтправки      = ПЭДО_Сервер.НастройкаЭДО("ДатаНачалаОтправки");
	ГлубинаДнейОтправки     = ПЭДО_Сервер.НастройкаЭДО("ГлубинаДнейОтправки");
	ЛимитДокументовЗаПрогон = ПЭДО_Сервер.НастройкаЭДО("ЛимитДокументовЗаПрогон");
	ОтпечатокПодписанта     = ПЭДО_Сервер.НастройкаЭДО("ОтпечатокПодписанта");
	Хост                    = ПЭДО_Сервер.НастройкаЭДО("Хост");
	ПрочиеНашиАдресаЭДО     = ПЭДО_Сервер.НастройкаЭДО("ПрочиеНашиАдресаЭДО");
	ГотовыеСтатусыЗаказа    = ПЭДО_Сервер.НастройкаЭДО("ГотовыеСтатусыЗаказа");
	ГлубинаДнейСинхронизацииСтатусов = ПЭДО_Сервер.НастройкаЭДО("ГлубинаДнейСинхронизацииСтатусов");
	ТаймаутHTTPСек          = ПЭДО_Сервер.НастройкаЭДО("ТаймаутHTTPСек");

	// какое окно отбора получится из двух ограничений — показываем, чтобы не считать в уме
	Граница = ПЭДО_Сервер.НижняяГраницаОтбора();
	ДействующееОкно = "с " + Формат(Граница, "ДФ=dd.MM.yyyy")
		+ ?(ЗначениеЗаполнено(ДатаНачалаОтправки) И Граница = НачалоДня(ДатаНачалаОтправки),
			" (по дате начала)", " (по глубине в днях)");

	ЗаполнитьСостояниеГотовности();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСостояниеГотовности()
	Недостающее = ПЭДО_Сервер.НедостающиеНастройкиЭДО();
	Если Недостающее.Количество() = 0 Тогда
		СостояниеГотовности = "Всё настроено — отправка работать может.";
	Иначе
		СостояниеГотовности = "Отправка НЕ РАБОТАЕТ, пока не устранено:" + Символы.ПС
			+ "• " + СтрСоединить(Недостающее, Символы.ПС + "• ");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиНаСервере()
	ПЭДО_Сервер.УстановитьНастройкуЭДО("ДатаНачалаОтправки", ДатаНачалаОтправки);
	ПЭДО_Сервер.УстановитьНастройкуЭДО("ГлубинаДнейОтправки", ГлубинаДнейОтправки);
	ПЭДО_Сервер.УстановитьНастройкуЭДО("ЛимитДокументовЗаПрогон", ЛимитДокументовЗаПрогон);
	ПЭДО_Сервер.УстановитьНастройкуЭДО("ОтпечатокПодписанта", СокрЛП(ОтпечатокПодписанта));
	ПЭДО_Сервер.УстановитьНастройкуЭДО("Хост", СокрЛП(Хост));
	ПЭДО_Сервер.УстановитьНастройкуЭДО("ПрочиеНашиАдресаЭДО", СокрЛП(ПрочиеНашиАдресаЭДО));
	ПЭДО_Сервер.УстановитьНастройкуЭДО("ГотовыеСтатусыЗаказа", СокрЛП(ГотовыеСтатусыЗаказа));
	ПЭДО_Сервер.УстановитьНастройкуЭДО("ГлубинаДнейСинхронизацииСтатусов", ГлубинаДнейСинхронизацииСтатусов);
	ПЭДО_Сервер.УстановитьНастройкуЭДО("ТаймаутHTTPСек", ТаймаутHTTPСек);
	ПрочитатьНастройкиВФорму();
КонецПроцедуры

&НаСервере
Функция ЗавестиСвойстваНаСервере()
	Итог = ПЭДО_Сервер.ОбеспечитьСвойстваОбъектов();
	ЗаполнитьСостояниеГотовности();
	Возврат СтрСоединить(Итог, Символы.ПС);
КонецФункции

&НаСервере
Функция ПеренестиВОбщиеНаСервере()
	Итог = ПЭДО_Сервер.ПеренестиНастройкиВОбщие();
	ПрочитатьНастройкиВФорму();
	Возврат СтрСоединить(Итог, Символы.ПС);
КонецФункции

#КонецОбласти
