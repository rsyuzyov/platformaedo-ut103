// Помощник отправки ЭДО через «Платформа ЭДО» (Эвотор ОФД) для УТ 10.3.
//
// Что делает:
//   «Заполнить»         — собирает документы периода и раскладывает по состояниям
//                         (к отправке / уже ушёл / нет связи / нет флага бухучёта / заказ не готов);
//   «Отправить»         — отправляет пачкой то, что помечено «К ОТПРАВКЕ» (не более «За раз, док»);
//   «Двойные отправки»  — документы, у которых заполнены идентификаторы И СБИС, И Платформы;
//   двойной щелчок      — открывает документ.
//
// Правило отбора к отправке (оператор, 13.08.2026): проведён + ОтражатьВБухгалтерскомУчете
//   + (заказа покупателя нет ИЛИ все заказы документа в «готовом» статусе)
//   + документ ещё не отправлен + у контрагента есть идентификатор ЭДО и установленная связь.
//
// ⚠️ Набор «готовых» статусов заказа в разных базах РАЗНЫЙ (где-то только «Отгружена», где-то ещё и
//    «Передана на отгрузку») — подбирается по фактическому составу Перечисление.СтатусыЗаявок.
// ⚠️ Свойств «ДокументСБИС_*» в базе может не быть вовсе (если СБИС не использовали) — код это учитывает.
// ⚠️ Справочник «Организации» в УТ 10.3 НЕиерархический: поля «ЭтоГруппа» у него нет, запрос с ним
//    падает ещё при открытии формы. Условие добавляется, только если справочник иерархический
//    (в КА/УПП структура может отличаться).

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаОкончания = КонецДня(ТекущаяДата());
	ДатаНачала    = НачалоДня(ТекущаяДата()) - 3 * 86400;
	ЛимитОтправки = 25;

	// если организация в базе одна — подставляем её
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 2 Орг.Ссылка КАК Ссылка ИЗ Справочник.Организации КАК Орг
		|ГДЕ НЕ Орг.ПометкаУдаления";
	Если Метаданные.Справочники.Организации.Иерархический Тогда
		ТекстЗапроса = ТекстЗапроса + " И НЕ Орг.ЭтоГруппа";
	КонецЕсли;
	Запрос = Новый Запрос(ТекстЗапроса);
	Выборка = Запрос.Выполнить().Выгрузить();
	Если Выборка.Количество() = 1 Тогда
		Организация = Выборка[0].Ссылка;
	КонецЕсли;

	Элементы.НадписьИтоги.Заголовок = "Нажмите «Заполнить»";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьКоманда(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДвойныеОтправкиКоманда(Команда)
	ДвойныеНаСервере();
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаДвойные;
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьКоманда(Команда)

	КОтправке = 0;
	Для Каждого Строка Из Очередь Цикл
		Если Строка.Причина = "К ОТПРАВКЕ" Тогда
			КОтправке = КОтправке + 1;
		КонецЕсли;
	КонецЦикла;

	Если КОтправке = 0 Тогда
		ПоказатьПредупреждение(, "В очереди нет документов, готовых к отправке. Нажмите «Заполнить».");
		Возврат;
	КонецЕсли;

	Порция = ?(ЛимитОтправки > 0, Мин(ЛимитОтправки, КОтправке), КОтправке);
	Текст = "Отправить контрагентам " + Порция + " документ(ов) из " + КОтправке + "?"
		+ Символы.ПС + "Отправка необратима: документы уйдут получателям через оператора ЭДО.";
	ПоказатьВопрос(Новый ОписаниеОповещения("ОтправитьЗавершение", ЭтотОбъект), Текст, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЗавершение(Ответ, Параметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	СостояниеОтправки = ОтправитьНаСервере();
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЛог;
	ПоказатьПредупреждение(, СостояниеОтправки);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокументКоманда(Команда)
	ОткрытьТекущийДокумент();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОчередьВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьТекущийДокумент();
КонецПроцедуры

&НаКлиенте
Процедура ДвойныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьТекущийДокумент();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьТекущийДокумент()

	Данные = Неопределено;
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаДвойные Тогда
		Данные = Элементы.Двойные.ТекущиеДанные;
	Иначе
		Данные = Элементы.Очередь.ТекущиеДанные;
	КонецЕсли;

	Если Данные = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Данные.Документ) Тогда
		Возврат;
	КонецЕсли;

	ПоказатьЗначение(, Данные.Документ);

КонецПроцедуры

// Готовые статусы заказа покупателя: состав перечисления в базах расходится,
// поэтому берём только те значения, которые в этой конфигурации есть.
&НаСервереБезКонтекста
Функция ГотовыеСтатусыЗаказа()

	Результат = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Отгружена,ПереданаНаОтгрузку", ",") Цикл
		Если Метаданные.Перечисления.СтатусыЗаявок.ЗначенияПеречисления.Найти(СокрЛП(Имя)) <> Неопределено Тогда
			Результат.Добавить(Перечисления.СтатусыЗаявок[СокрЛП(Имя)]);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция СвойствоПоИмени(Знач Имя)

	Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(Имя);
	Если Свойство = Неопределено Тогда
		Возврат ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка();
	КонецЕсли;
	Возврат Свойство;

КонецФункции

&НаСервере
Процедура ЗаполнитьНаСервере()

	Очередь.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Тов.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ЗаказНеГотов
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК Тов
	|ГДЕ
	|	Тов.ЗаказПокупателя <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|	И НЕ Тов.ЗаказПокупателя.Статус В (&ГотовыеСтатусы)
	|	И Тов.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|;
	|ВЫБРАТЬ ПЕРВЫЕ 3000
	|	РТУ.Ссылка КАК Документ,
	|	РТУ.Номер КАК Номер,
	|	РТУ.Дата КАК Дата,
	|	РТУ.Контрагент КАК Контрагент,
	|	РТУ.СуммаДокумента КАК Сумма,
	|	ЕСТЬNULL(ЭДОСтатус.Значение, """") КАК СтатусЭДО,
	|	ВЫБОР
	|		КОГДА НЕ РТУ.ОтражатьВБухгалтерскомУчете ТОГДА ""нет флага бухучёта""
	|		КОГДА НеГотов.Ссылка ЕСТЬ НЕ NULL ТОГДА ""заказ не готов""
	|		КОГДА ЭДОСБИС.Объект ЕСТЬ НЕ NULL ТОГДА ""уже ушёл через СБИС""
	|		КОГДА ЭДОПлат.Объект ЕСТЬ НЕ NULL ТОГДА ""уже ушёл через Платформу""
	|		КОГДА ЭДОИд.Значение ЕСТЬ NULL ТОГДА ""нет идентификатора ЭДО""
	|		КОГДА НЕ (ЭДОСвязь.Значение = ""ESTABLISHED"" ИЛИ ЭДОСвязь.Значение = ""DIRECT"") ТОГДА ""связь не установлена""
	|		ИНАЧЕ ""К ОТПРАВКЕ""
	|	КОНЕЦ КАК Причина
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РТУ
	|	ЛЕВОЕ СОЕДИНЕНИЕ ЗаказНеГотов КАК НеГотов
	|		ПО НеГотов.Ссылка = РТУ.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЭДОСБИС
	|		ПО ЭДОСБИС.Объект = РТУ.Ссылка И ЭДОСБИС.Свойство = &СвойствоСБИС
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЭДОПлат
	|		ПО ЭДОПлат.Объект = РТУ.Ссылка И ЭДОПлат.Свойство = &СвойствоПлатформа
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЭДОСтатус
	|		ПО ЭДОСтатус.Объект = РТУ.Ссылка И ЭДОСтатус.Свойство = &СвойствоСтатус
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЭДОИд
	|		ПО ВЫРАЗИТЬ(ЭДОИд.Объект КАК Справочник.Контрагенты) = РТУ.Контрагент И ЭДОИд.Свойство = &СвойствоИдентификатор
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЭДОСвязь
	|		ПО ВЫРАЗИТЬ(ЭДОСвязь.Объект КАК Справочник.Контрагенты) = РТУ.Контрагент И ЭДОСвязь.Свойство = &СвойствоСвязь
	|ГДЕ
	|	РТУ.Проведен
	|	И РТУ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И (&БезОтбораОрганизации ИЛИ РТУ.Организация = &Организация)
	|УПОРЯДОЧИТЬ ПО
	|	Причина,
	|	Дата";

	Запрос.УстановитьПараметр("ГотовыеСтатусы", ГотовыеСтатусыЗаказа());
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("БезОтбораОрганизации", НЕ ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("СвойствоСБИС", СвойствоПоИмени("ДокументСБИС_Ид"));
	Запрос.УстановитьПараметр("СвойствоПлатформа", СвойствоПоИмени("ОФД_ЭДО_ИдентификаторДокумента"));
	Запрос.УстановитьПараметр("СвойствоСтатус", СвойствоПоИмени("ОФД_ЭДО_СтатусДокумента"));
	Запрос.УстановитьПараметр("СвойствоИдентификатор", СвойствоПоИмени("ОФД_ЭДО_ИдентификаторУчастникаЭДО"));
	Запрос.УстановитьПараметр("СвойствоСвязь", СвойствоПоИмени("ОФД_ЭДО_СтатусСвязи"));

	Таблица = Запрос.Выполнить().Выгрузить();
	Очередь.Загрузить(Таблица);

	// сводка по состояниям
	Свод = Новый Соответствие;
	СуммаКОтправке = 0;
	КоличествоКОтправке = 0;
	Для Каждого Строка Из Таблица Цикл
		Свод.Вставить(Строка.Причина, ?(Свод[Строка.Причина] = Неопределено, 0, Свод[Строка.Причина]) + 1);
		Если Строка.Причина = "К ОТПРАВКЕ" Тогда
			КоличествоКОтправке = КоличествоКОтправке + 1;
			СуммаКОтправке = СуммаКОтправке + Строка.Сумма;
		КонецЕсли;
	КонецЦикла;

	Части = Новый Массив;
	Части.Добавить("Всего " + Таблица.Количество() + " док."
		+ ?(Таблица.Количество() >= 3000, " (показаны первые 3000 — сузьте период)", ""));
	Части.Добавить("К отправке " + КоличествоКОтправке + " на " + Формат(СуммаКОтправке, "ЧЦ=15; ЧДЦ=2") + " руб.");
	Для Каждого КлючЗначение Из Свод Цикл
		Если КлючЗначение.Ключ <> "К ОТПРАВКЕ" Тогда
			Части.Добавить(КлючЗначение.Ключ + ": " + КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	Элементы.НадписьИтоги.Заголовок = СтрСоединить(Части, " | ");

КонецПроцедуры

&НаСервере
Функция ОтправитьНаСервере()

	Если НЕ ЗначениеЗаполнено(ЛимитОтправки) Тогда
		ЛимитОтправки = 25;
	КонецЕсли;

	Отправлено = 0;
	Ошибок = 0;
	Строки = Новый Массив;
	Строки.Добавить("=== отправка " + Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'") + " ===");

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Для Каждого Строка Из Очередь Цикл

		Если Строка.Причина <> "К ОТПРАВКЕ" Тогда
			Продолжить;
		КонецЕсли;
		Если Отправлено + Ошибок >= ЛимитОтправки Тогда
			Прервать;
		КонецЕсли;

		Попытка
			Результат = ПЭДО_Сервер.ОтправитьПоЭДО(Строка.Документ);
			Если ЗначениеЗаполнено(Результат.ИдДокумента) Тогда
				Отправлено = Отправлено + 1;
				Строка.Причина = "уже ушёл через Платформу";
				Строка.СтатусЭДО = Строка(Результат.Статус);
				Строки.Добавить("OK  " + СокрЛП(Строка.Номер) + " → " + Строка(Результат.Статус) + " " + Результат.ИдДокумента);
			Иначе
				Ошибок = Ошибок + 1;
				Строки.Добавить("ОШИБКА " + СокрЛП(Строка.Номер) + " → " + Строка(Результат.Статус)
					+ ": " + Лев(Строка(Результат.Сообщение), 300));
			КонецЕсли;
		Исключение
			Ошибок = Ошибок + 1;
			Строки.Добавить("СБОЙ " + СокрЛП(Строка.Номер) + ": " + Лев(ОписаниеОшибки(), 300));
		КонецПопытки;

	КонецЦикла;

	Секунд = Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000, 1);
	Итог = "Отправлено " + Отправлено + ", ошибок " + Ошибок + ", за " + Секунд + " c";
	Строки.Добавить(Итог);

	Лог = ?(ПустаяСтрока(Лог), "", Лог + Символы.ПС) + СтрСоединить(Строки, Символы.ПС);

	Возврат Итог;

КонецФункции

&НаСервере
Процедура ДвойныеНаСервере()

	Двойные.Очистить();

	СвойствоСБИС = СвойствоПоИмени("ДокументСБИС_Ид");
	Если НЕ ЗначениеЗаполнено(СвойствоСБИС) Тогда
		Элементы.НадписьИтоги.Заголовок = "В этой базе нет свойства «ДокументСБИС_Ид» — контроль двойных отправок неприменим";
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РТУ.Ссылка КАК Документ,
	|	РТУ.Номер КАК Номер,
	|	РТУ.Дата КАК Дата,
	|	РТУ.Контрагент КАК Контрагент,
	|	ЭДОСБИС.Значение КАК ИдСБИС,
	|	ЭДОПлат.Значение КАК ИдПлатформа
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РТУ
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЭДОСБИС
	|		ПО ЭДОСБИС.Объект = РТУ.Ссылка И ЭДОСБИС.Свойство = &СвойствоСБИС
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЭДОПлат
	|		ПО ЭДОПлат.Объект = РТУ.Ссылка И ЭДОПлат.Свойство = &СвойствоПлатформа
	|ГДЕ
	|	РТУ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И (&БезОтбораОрганизации ИЛИ РТУ.Организация = &Организация)
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";

	Запрос.УстановитьПараметр("СвойствоСБИС", СвойствоСБИС);
	Запрос.УстановитьПараметр("СвойствоПлатформа", СвойствоПоИмени("ОФД_ЭДО_ИдентификаторДокумента"));
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("БезОтбораОрганизации", НЕ ЗначениеЗаполнено(Организация));

	Таблица = Запрос.Выполнить().Выгрузить();
	Двойные.Загрузить(Таблица);

	Элементы.НадписьИтоги.Заголовок = "Двойных отправок за период: " + Таблица.Количество();

КонецПроцедуры

