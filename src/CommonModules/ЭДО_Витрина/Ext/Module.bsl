////////////////////////////////////////////////////////////////////////////////
// Витрина центра управления ЭДО: быстрые показатели по данным базы, без обращений к API.
// Все, что требует обхода оператора, считают сторожа и кладут снимком - витрина его только читает.
// Источник - колонка ЭДО_Состояние, которую ведет ядро. Витрина ее группирует и не повторяет
// логику отбора: свой запрос разошелся бы с очередью молча.
////////////////////////////////////////////////////////////////////////////////

// Группы состояний. Порядок задает и порядок вывода на форме: сверху то,
// что требует действия от нас, снизу то, где делать нечего.
Функция ГруппыСостояний() Экспорт

	Группы = Новый Массив;
	Группы.Добавить("Застряло у нас");
	Группы.Добавить("Требует решения");
	Группы.Добавить("Ждем контрагента");
	Группы.Добавить("Не взято в очередь");
	Группы.Добавить("Завершено");
	Группы.Добавить("Прочее");

	Возврат Группы;

КонецФункции

// Группа для текста колонки. У групп разный исполнитель: "Застряло у нас" разбирает администратор,
// "Требует решения" - бухгалтер, "Не взято в очередь" чинится данными, "Ждем контрагента" - ничего.
Функция ГруппаСостояния(Знач Текст) Экспорт

	Значение = ЭДО_Сервер.АктуальныйТекстКолонки(Текст);   // ЩА 15.10.2026 [yan]: прежние формулировки - в свою группу
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "Прочее";
	КонецЕсли;

	Если СостоянияЗастрялоУНас().Найти(Значение) <> Неопределено Тогда
		Возврат "Застряло у нас";
	КонецЕсли;
	Если СостоянияТребуетРешения().Найти(Значение) <> Неопределено Тогда
		Возврат "Требует решения";
	КонецЕсли;
	Если СостоянияЖдемКонтрагента().Найти(Значение) <> Неопределено Тогда
		Возврат "Ждем контрагента";
	КонецЕсли;
	Если СостоянияЗавершено().Найти(Значение) <> Неопределено Тогда
		Возврат "Завершено";
	КонецЕсли;
	Если СостоянияНеВзятоВОчередь().Найти(Значение) <> Неопределено Тогда
		Возврат "Не взято в очередь";
	КонецЕсли;

	// Незнакомый статус связи ядро печатает с префиксом и показывает как есть.
	Если Найти(Значение, ЭДО_Сервер.ПрефиксПричиныСвязи()) = 1 Тогда
		Возврат "Не взято в очередь";
	КонецЕсли;
	// У корректировки на паузе перед автоотправкой в тексте время окончания паузы.
	Если Найти(Значение, ЭДО_Сервер.ПрефиксОжиданияПроверкиУКД()) = 1 Тогда
		Возврат "Не взято в очередь";
	КонецЕсли;

	// Незнакомое не прячем: рост группы "Прочее" - сигнал, что карта статусов ядра что-то не знает.
	Возврат "Прочее";

КонецФункции

// Документ взят оператором, а дальше ход прервался. Это наша работа, а не контрагента.
Функция СостоянияЗастрялоУНас() Экспорт

	Тексты = Новый Массив;
	Тексты.Добавить(ЭДО_Сервер.ТекстОшибкаОтправкиУОператора());
	// Честный знак не принял фиксацию, документ покупателю не ушел: переотправить исправленным - наша работа.
	Тексты.Добавить(ЭДО_Сервер.ТекстОшибкаФиксацииЧЗ());
	Тексты.Добавить("Взят в отправку, прогон не завершен");
	Тексты.Добавить("Взят в отправку, прогон не завершён");
	Тексты.Добавить("Состояние у оператора неизвестно");
	// Карточку удалили у оператора, а документ в базе жив: контрагент его не получил,
	// и решить, отправлять ли заново, некому, кроме нас.
	Тексты.Добавить(ЭДО_Сервер.ТекстКарточкаУдалена());
	Тексты.Добавить(ЭДО_Сервер.ТекстОшибкиФЛК());

	Возврат Тексты;

КонецФункции

// Ответ контрагента получен, и он требует решения человека.
Функция СостоянияТребуетРешения() Экспорт

	Тексты = Новый Массив;
	Тексты.Добавить(ЭДО_Сервер.ТекстОтклоненКонтрагентом());
	Тексты.Добавить(ЭДО_Сервер.ТекстЗапросаАннулирования());
	Тексты.Добавить(ЭДО_Сервер.ТекстАннулированиеОтклонено());
	// Корректировка-исправление ошибки уходит не регламентом, а решением человека.
	Тексты.Добавить(ЭДО_Сервер.ТекстКорректировкаНеУКД());
	// Акт сверки не принимается получателем или его оператором: отправить другим способом решает человек.
	Тексты.Добавить(ЭДО_Сервер.ТекстПолучательНеПринимаетАктыСверки());
	Тексты.Добавить(ЭДО_Сервер.ТекстКолонкиАктыСверкиОператоруНеОтправляются());

	Возврат Тексты;

КонецФункции

// Документ у контрагента, делать нечего - только ждать.
Функция СостоянияЖдемКонтрагента() Экспорт

	Тексты = Новый Массив;
	Тексты.Добавить("Отправляется");
	Тексты.Добавить(ЭДО_Сервер.ТекстОтправлен());
	Тексты.Добавить(ЭДО_Сервер.ТекстДоставлен());
	Тексты.Добавить(ЭДО_Сервер.ТекстАннулированиеЖдемОтвета());
	// УКД к реализации, которую покупатель еще не подписал: уйдет сама после его подписи.
	Тексты.Добавить(ЭДО_Сервер.ТекстИсходникНеПодписан());

	Возврат Тексты;

КонецФункции

// Цикл документа закончен либо отправка по нему не нужна.
Функция СостоянияЗавершено() Экспорт

	Тексты = Новый Массив;
	Тексты.Добавить(ЭДО_Сервер.ТекстПодписанКонтрагентом());
	Тексты.Добавить(ЭДО_Сервер.ТекстАннулирован());
	Тексты.Добавить(ЭДО_Сервер.ТекстСтатусаОтправкаНеТребуется());
	Тексты.Добавить(ЭДО_Сервер.ТекстОтправленДругимОператором());
	Тексты.Добавить("Уже отправлен этому получателю");
	// Корректировка без измененных строк: УКД по ней не нужен вовсе.
	Тексты.Добавить(ЭДО_Сервер.ТекстКорректировкаБезИзменений());

	Возврат Тексты;

КонецФункции

// Причины, по которым документ не попал в очередь. Набор берется у ядра: своя копия расходилась бы
// с ним при каждой правке формулировки, и документы молча уходили бы в "Прочее".
Функция СостоянияНеВзятоВОчередь() Экспорт

	Тексты = Новый Массив;
	Для Каждого Текст Из ЭДО_Сервер.ТекстыПричинНеотправки() Цикл
		Если Текст = "Отправляется" Тогда
			Продолжить;   // это ход отправки, а не причина простоя
		КонецЕсли;
		Если Текст = ЭДО_Сервер.ТекстОтправленДругимОператором() Тогда
			Продолжить;   // ушел другим каналом, работа по нему закончена
		КонецЕсли;
		Тексты.Добавить(Текст);
	КонецЦикла;
	Для Каждого Текст Из ЭДО_Сервер.УстаревшиеТекстыПричин() Цикл
		Тексты.Добавить(Текст);
	КонецЦикла;

	Возврат Тексты;

КонецФункции

// Период по умолчанию - текущий год, но не раньше даты подключения ЭДО: у более ранних документов
// состояния нет, и витрина показывала бы в основном пустую группу. Период на форме меняется руками.
Функция ПериодПоУмолчанию() Экспорт

	Период = Новый Структура("Начало, Конец");
	Сегодня = ТекущаяДатаСеанса();   // ЩА 23.10.2026 [yan], ревью Codex: дата пользователя, а не сервера
	Период.Начало = НачалоГода(Сегодня);
	Период.Конец = КонецДня(Сегодня);

	Граница = ЭДО_Сервер.РанняяДатаНачалаОтправки();
	Если НЕ ЗначениеЗаполнено(Граница) Тогда
		Граница = ЭДО_Сервер.НижняяГраницаОтбора();
	КонецЕсли;
	Если ЗначениеЗаполнено(Граница) И НачалоДня(Граница) > Период.Начало Тогда
		Период.Начало = НачалоДня(Граница);
	КонецЕсли;

	Возврат Период;

КонецФункции

// Виды документов для переключателя на форме. "Все" - без отбора по виду.
Функция ВидыДокументов() Экспорт

	Виды = Новый Массив;
	Виды.Добавить("Все");
	Виды.Добавить("УПД");
	Виды.Добавить("УКД");

	Возврат Виды;

КонецФункции

// Вид документа для колонки "Вид" в разборе.
Функция ВидДокумента(Знач Ссылка) Экспорт

	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Возврат "УПД";
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		Возврат "УКД";
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.АктСверкиВзаиморасчетов") Тогда
		Возврат "Акт сверки";
	ИначеЕсли ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка.Метаданные().Синоним;
	КонецЕсли;
	Возврат "";

КонецФункции

// Исходящие документы периода одним источником для запросов витрины: псевдоним РТУ и поля
// Ссылка, Дата, Номер, Контрагент, Организация, СуммаДокумента. Отбор по проведению и периоду
// уже внутри. Новый вид документа добавляется здесь, запросы витрины его подхватят.
// Корректировки берутся с даты начала автоотправки УКД: раньше их не отправляли, и без
// состояния они заняли бы "Прочее". Отправленные вручную до этой даты тоже видны - по состоянию.
// Параметры ставит УстановитьПараметрыИсточника.
Функция ТекстИсточникаДокументов(Знач ВидДокументов)

	Части = Новый Массив;
	Если ВидДокументов <> "УКД" Тогда
		Части.Добавить(
			"ВЫБРАТЬ
			|	Реализация.Ссылка КАК Ссылка,
			|	Реализация.Дата КАК Дата,
			|	Реализация.Номер КАК Номер,
			|	Реализация.Контрагент КАК Контрагент,
			|	Реализация.Организация КАК Организация,
			|	Реализация.СуммаДокумента КАК СуммаДокумента
			|ИЗ Документ.РеализацияТоваровУслуг КАК Реализация
			|ГДЕ Реализация.Проведен
			|	И Реализация.Дата МЕЖДУ &Начало И &Конец");
	КонецЕсли;
	Если ВидДокументов <> "УПД" Тогда
		Части.Добавить(
			"ВЫБРАТЬ
			|	Корректировка.Ссылка,
			|	Корректировка.Дата,
			|	Корректировка.Номер,
			|	Корректировка.Контрагент,
			|	Корректировка.Организация,
			|	Корректировка.СуммаДокумента
			|ИЗ Документ.КорректировкаРеализации КАК Корректировка
			|ГДЕ Корректировка.Проведен
			|	И Корректировка.Дата МЕЖДУ &Начало И &Конец
			|	И (Корректировка.Дата >= &НачалоУКД
			|		ИЛИ Корректировка.Ссылка В
			|			(ВЫБРАТЬ
			|				СостУКД.Объект
			|			ИЗ РегистрСведений.ЗначенияСвойствОбъектов КАК СостУКД
			|			ГДЕ СостУКД.Свойство = &СвСостояниеИсточника
			|				И СостУКД.Объект ССЫЛКА Документ.КорректировкаРеализации))");
	КонецЕсли;

	Возврат "(" + СтрСоединить(Части, "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|") + ")";

КонецФункции

// ЩА 23.10.2026 [yan]: отбор Центра управления по контрагенту - условие в том же запросе, без отдельных выборок.
Процедура УстановитьОтборКонтрагента(Запрос, Знач Контрагент)

	Запрос.УстановитьПараметр("БезОтбораКонтрагента", НЕ ЗначениеЗаполнено(Контрагент));
	Запрос.УстановитьПараметр("Контрагент", ?(ЗначениеЗаполнено(Контрагент), Контрагент,
		Справочники.Контрагенты.ПустаяСсылка()));

КонецПроцедуры

// ЩА 23.10.2026 [yan]: документы ЭДО по номеру - для поля «Документ №» Центра управления. Сначала точное
// совпадение номера (индекс), если нет - вхождение за полгода (номер вводят без префикса или нулей).
// Возврат: Массив ссылок, новые сверху, не больше 20.
Функция ДокументыПоНомеру(Знач Номер) Экспорт

	Номер = ВРег(СокрЛП(Номер));
	Если СтрДлина(Номер) < 3 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Виды = Новый Массив;
	Для Каждого Имя Из СтрРазделить("РеализацияТоваровУслуг,КорректировкаРеализации,АктСверкиВзаиморасчетов", ",") Цикл
		Если Метаданные.Документы.Найти(Имя) <> Неопределено Тогда
			Виды.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	// Два запроса, не цикл: точное совпадение по индексу номера дешево, вхождение - только если его нет.
	Результат = ДокументыПоНомеруЗапросом(Виды, Номер, Истина);
	Если Результат.Количество() = 0 Тогда
		Результат = ДокументыПоНомеруЗапросом(Виды, Номер, Ложь);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ДокументыПоНомеруЗапросом(Знач Виды, Знач Номер, Знач Точно)

	Результат = Новый Массив;
	Если Виды.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Части = Новый Массив;
	Для Каждого Имя Из Виды Цикл
		// ЩА 23.10.2026 [yan], ревью Codex (КАТАП №24): без ПЕРВЫЕ во внутренних частях - иначе ограничение
		// срабатывало до сортировки по дате, и при 30 совпадениях свежие документы могли не попасть в выдачу.
		Части.Добавить("ВЫБРАТЬ Д.Ссылка КАК Ссылка, Д.Дата КАК Дата ИЗ Документ." + Имя + " КАК Д ГДЕ "
			+ ?(Точно, "Д.Номер = &Номер", "Д.Дата >= &Граница И Д.Номер ПОДОБНО &Образец"));
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 20 Т.Ссылка КАК Ссылка ИЗ (" + СтрСоединить(Части, " ОБЪЕДИНИТЬ ВСЕ ")
		+ ") КАК Т УПОРЯДОЧИТЬ ПО Т.Дата УБЫВ");
	Запрос.УстановитьПараметр("Номер", Номер);
	Запрос.УстановитьПараметр("Образец", "%" + Номер + "%");
	Запрос.УстановитьПараметр("Граница", ДобавитьМесяц(НачалоДня(ТекущаяДатаСеанса()), -6));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура УстановитьПараметрыИсточника(Запрос, Знач Начало, Знач Конец)

	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец)); // дата «по» из поля формы приходит с 00:00:00
	НачалоУКД = ЭДО_Сервер.ДатаНачалаАвтоотправкиУКД();
	Запрос.УстановитьПараметр("НачалоУКД", ?(ЗначениеЗаполнено(НачалоУКД), НачалоУКД, '39991231'));
	Запрос.УстановитьПараметр("СвСостояниеИсточника", ПустаяЕслиНеНайдено(ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние")));

КонецПроцедуры

// Сводка исходящих: состояние, группа, количество, сумма.
// Возврат: ТаблицаЗначений с колонками Группа, Состояние, Количество, Сумма.
// Контрагент - отбор по покупателю (пусто - все). ЩА 23.10.2026 [yan]
Функция СводкаИсходящих(Знач Начало = '00010101', Знач Конец = '00010101', Знач Организация = Неопределено,
	Знач ВидДокументов = "Все", Знач Контрагент = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(Начало) ИЛИ НЕ ЗначениеЗаполнено(Конец) Тогда
		Период = ПериодПоУмолчанию();
		Начало = ?(ЗначениеЗаполнено(Начало), Начало, Период.Начало);
		Конец = ?(ЗначениеЗаполнено(Конец), Конец, Период.Конец);
	КонецЕсли;

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Группа", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));

	СвСостояние = ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние");
	Если СвСостояние = Неопределено ИЛИ СвСостояние.Пустая() Тогда
		Возврат Результат;   // свойства нет - показывать нечего, но и падать незачем
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)), """") КАК Состояние,
		|	КОЛИЧЕСТВО(РТУ.Ссылка) КАК Количество,
		|	СУММА(РТУ.СуммаДокумента) КАК Сумма
		|ИЗ " + ТекстИсточникаДокументов(ВидДокументов) + " КАК РТУ
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Сост
		|		ПО Сост.Объект = РТУ.Ссылка И Сост.Свойство = &СвСостояние
		|ГДЕ (&БезОтбораОрганизации ИЛИ РТУ.Организация = &Организация)
		|	И (&БезОтбораКонтрагента ИЛИ РТУ.Контрагент = &Контрагент)
		|СГРУППИРОВАТЬ ПО ЕСТЬNULL(ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)), """")";
	Запрос.УстановитьПараметр("СвСостояние", СвСостояние);
	УстановитьПараметрыИсточника(Запрос, Начало, Конец);
	УстановитьОтборКонтрагента(Запрос, Контрагент);
	Запрос.УстановитьПараметр("БезОтбораОрганизации", НЕ ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("Организация", ?(ЗначениеЗаполнено(Организация), Организация,
		Справочники.Организации.ПустаяСсылка()));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Состояние = ?(ЗначениеЗаполнено(Выборка.Состояние), Выборка.Состояние, "Не обработан");
		НоваяСтрока.Группа = ГруппаСостояния(Выборка.Состояние);
		НоваяСтрока.Количество = Выборка.Количество;
		НоваяСтрока.Сумма = ?(Выборка.Сумма = NULL, 0, Выборка.Сумма);
	КонецЦикла;

	Результат.Сортировать("Группа, Количество Убыв");

	Возврат Результат;

КонецФункции

// Итоги по группам для верхнего блока формы.
// Возврат: ТаблицаЗначений с колонками Группа, Количество, Сумма.
Функция ИтогиПоГруппам(Знач Сводка) Экспорт

	Итоги = Новый ТаблицаЗначений;
	Итоги.Колонки.Добавить("Группа", Новый ОписаниеТипов("Строка"));
	Итоги.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Итоги.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));

	Для Каждого Имя Из ГруппыСостояний() Цикл
		НоваяСтрока = Итоги.Добавить();
		НоваяСтрока.Группа = Имя;
	КонецЦикла;

	Для Каждого СтрокаСводки Из Сводка Цикл
		Найденная = Итоги.Найти(СтрокаСводки.Группа, "Группа");
		Если Найденная = Неопределено Тогда
			Найденная = Итоги.Добавить();
			Найденная.Группа = СтрокаСводки.Группа;
		КонецЕсли;
		Найденная.Количество = Найденная.Количество + СтрокаСводки.Количество;
		Найденная.Сумма = Найденная.Сумма + СтрокаСводки.Сумма;
	КонецЦикла;

	Возврат Итоги;

КонецФункции

// Документы в заданном состоянии - расшифровка по щелчку.
Функция ДокументыПоСостоянию(Знач Состояние, Знач Начало = '00010101', Знач Конец = '00010101',
	Знач Организация = Неопределено, Знач Лимит = 1000, Знач ВидДокументов = "Все", Знач Контрагент = Неопределено) Экспорт

	Состояния = Новый Массив;
	Состояния.Добавить(Состояние);

	Возврат ДокументыПоСостояниям(Состояния, Начало, Конец, Организация, Лимит, ВидДокументов, Контрагент);

КонецФункции

// Документы в любом из перечисленных состояний. Щелчок по группе на дашборде открывает
// все ее состояния разом, поэтому отбор принимает массив, а не одно значение.
// Лимит намеренный: список на тысячи строк человеку бесполезен, а форму он подвесит.
Функция ДокументыПоСостояниям(Знач Состояния, Знач Начало = '00010101', Знач Конец = '00010101',
	Знач Организация = Неопределено, Знач Лимит = 1000, Знач ВидДокументов = "Все", Знач Контрагент = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(Начало) ИЛИ НЕ ЗначениеЗаполнено(Конец) Тогда
		Период = ПериодПоУмолчанию();
		Начало = ?(ЗначениеЗаполнено(Начало), Начало, Период.Начало);
		Конец = ?(ЗначениеЗаполнено(Конец), Конец, Период.Конец);
	КонецЕсли;

	Результат = НоваяТаблицаДокументов();
	СвСостояние = ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние");
	Если СвСостояние = Неопределено ИЛИ СвСостояние.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;

	// "Не обработан" - это наша подпись для пустого значения, в базе его нет.
	ИскатьПустое = Ложь;
	Искомые = Новый Массив;
	Для Каждого Состояние Из Состояния Цикл
		Если СокрЛП(Состояние) = "Не обработан" ИЛИ НЕ ЗначениеЗаполнено(Состояние) Тогда
			ИскатьПустое = Истина;
		Иначе
			Искомые.Добавить(СокрЛП(Состояние));
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаДокументов(Лимит,
		"И (&БезОтбораОрганизации ИЛИ РТУ.Организация = &Организация)
		|	И (&БезОтбораКонтрагента ИЛИ РТУ.Контрагент = &Контрагент)
		|	И ((&ИскатьПустое И ЕСТЬNULL(ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)), """") = """")
		|		ИЛИ ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)) В (&Искомые))", ВидДокументов);
	УстановитьОтборКонтрагента(Запрос, Контрагент);
	Запрос.УстановитьПараметр("СвСостояние", СвСостояние);
	Запрос.УстановитьПараметр("СвИдентификатор", ПустаяЕслиНеНайдено(ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента")));
	УстановитьПараметрыКолонок(Запрос);
	УстановитьПараметрыИсточника(Запрос, Начало, Конец);
	Запрос.УстановитьПараметр("ИскатьПустое", ИскатьПустое);
	Запрос.УстановитьПараметр("Искомые", Искомые);
	Запрос.УстановитьПараметр("БезОтбораОрганизации", НЕ ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("Организация", ?(ЗначениеЗаполнено(Организация), Организация,
		Справочники.Организации.ПустаяСсылка()));

	ЗаполнитьДокументы(Результат, Запрос);

	Возврат Результат;

КонецФункции

// Документы контрагента за период - расшифровка щелчка по контрагенту в разборе.
// Без отбора по организации: счетчик документов в списке контрагентов считается по всем.
Функция ДокументыКонтрагента(Знач Контрагент, Знач Начало = '00010101', Знач Конец = '00010101',
	Знач Лимит = 1000, Знач ВидДокументов = "Все") Экспорт

	Если НЕ ЗначениеЗаполнено(Начало) ИЛИ НЕ ЗначениеЗаполнено(Конец) Тогда
		Период = ПериодПоУмолчанию();
		Начало = ?(ЗначениеЗаполнено(Начало), Начало, Период.Начало);
		Конец = ?(ЗначениеЗаполнено(Конец), Конец, Период.Конец);
	КонецЕсли;

	Результат = НоваяТаблицаДокументов();
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаДокументов(Лимит, "И РТУ.Контрагент = &Контрагент", ВидДокументов);
	Запрос.УстановитьПараметр("СвСостояние", ПустаяЕслиНеНайдено(ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние")));
	Запрос.УстановитьПараметр("СвИдентификатор", ПустаяЕслиНеНайдено(ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента")));
	УстановитьПараметрыКолонок(Запрос);
	УстановитьПараметрыИсточника(Запрос, Начало, Конец);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	ЗаполнитьДокументы(Результат, Запрос);

	Возврат Результат;

КонецФункции

Функция НоваяТаблицаДокументов()

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Документ");
	Результат.Колонки.Добавить("Вид", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Контрагент");
	Результат.Колонки.Добавить("Организация");
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ИдОператора", Новый ОписаниеТипов("Строка"));
	// ЩА 15.10.2026 [yan]: сумма, с которой документ ушел в ЭДО, и состояние в Честном знаке.
	Результат.Колонки.Добавить("СуммаВЭДО", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("СуммаРасходится", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("Причина", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ЧестныйЗнак", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ЗначениеСуммыВЭДО", Новый ОписаниеТипов("Строка"));

	Возврат Результат;

КонецФункции

// Общий текст выборки документов для расшифровок. УсловиеОтбора дописывается к ГДЕ
// и начинается с "И".
Функция ТекстЗапросаДокументов(Знач Лимит, Знач УсловиеОтбора, Знач ВидДокументов = "Все")

	Возврат
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧН=0; ЧГ=0") + "
		|	РТУ.Ссылка КАК Документ,
		|	РТУ.Дата КАК Дата,
		|	РТУ.Номер КАК Номер,
		|	РТУ.Контрагент КАК Контрагент,
		|	РТУ.Организация КАК Организация,
		|	РТУ.СуммаДокумента КАК Сумма,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)), """") КАК Состояние,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Ид.Значение КАК СТРОКА(50)), """") КАК ИдОператора,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(СуммаЭДО.Значение КАК СТРОКА(50)), """") КАК ЗначениеСуммыВЭДО,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(ЧЗ.Значение КАК СТРОКА(100)), """") КАК ЧестныйЗнак
		|ИЗ " + ТекстИсточникаДокументов(ВидДокументов) + " КАК РТУ
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Сост
		|		ПО Сост.Объект = РТУ.Ссылка И Сост.Свойство = &СвСостояние
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Ид
		|		ПО Ид.Объект = РТУ.Ссылка И Ид.Свойство = &СвИдентификатор
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК СуммаЭДО
		|		ПО СуммаЭДО.Объект = РТУ.Ссылка И СуммаЭДО.Свойство = &СвСуммаВЭДО
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЧЗ
		|		ПО ЧЗ.Объект = РТУ.Ссылка И ЧЗ.Свойство = &СвСтатусГИСМТ
		|ГДЕ ИСТИНА
		|	" + УсловиеОтбора + "
		|УПОРЯДОЧИТЬ ПО Дата УБЫВ";

КонецФункции

Процедура ЗаполнитьДокументы(Результат, Знач Запрос)

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Вид = ВидДокумента(НоваяСтрока.Документ);
		НоваяСтрока.ИдОператора = СокрЛП(НоваяСтрока.ИдОператора);
		НоваяСтрока.ЧестныйЗнак = ЭДО_Сервер.ТекстЧестногоЗнакаДляПоказа(НоваяСтрока.ЧестныйЗнак);
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.Состояние) Тогда
			НоваяСтрока.Состояние = "Не обработан";
		КонецЕсли;
	КонецЦикла;
	ЗаполнитьСуммыВЭДО(Результат);

КонецПроцедуры

Процедура УстановитьПараметрыКолонок(Запрос)

	Запрос.УстановитьПараметр("СвСуммаВЭДО",
		ПустаяЕслиНеНайдено(ЭДО_Сервер.СвойствоОбъектов(ЭДО_Сервер.ИмяСвойстваСуммыВЭДО())));
	Запрос.УстановитьПараметр("СвСтатусГИСМТ", ПустаяЕслиНеНайдено(ЭДО_Сервер.СвойствоОбъектов("ЭДО_СтатусГИСМТ")));

КонецПроцедуры

// ++ ЩА 15.10.2026 [yan]: сумма в ЭДО - из карточки оператора текущего экземпляра. Ее запоминает точечная
// сверка; чего нет (документ подписали раньше, чем появилось свойство, или переотправили), список
// дозапрашивает у оператора пачками и запоминает. Сравнивается только УПД: у корректировки в карточке
// своя сумма, с суммой документа ее не сравнить.
Процедура ЗаполнитьСуммыВЭДО(Результат)

	СвойствоЕсть = НЕ ПустаяЕслиНеНайдено(ЭДО_Сервер.СвойствоОбъектов(ЭДО_Сервер.ИмяСвойстваСуммыВЭДО())).Пустая();
	ВидУПД = "УПД";   // см. ВидДокумента
	ПоОрганизациям = Новый Соответствие;
	НесколькоЗаписей = ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО();
	Для Каждого СтрокаДокумента Из Результат Цикл
		Если СтрокаДокумента.Вид <> ВидУПД ИЛИ НЕ ЗначениеЗаполнено(СтрокаДокумента.ИдОператора) Тогда
			Продолжить;
		КонецЕсли;
		Сумма = ЭДО_Сервер.СуммаВЭДОЭкземпляра(СтрокаДокумента.ЗначениеСуммыВЭДО, СтрокаДокумента.ИдОператора);
		Если Сумма <> Неопределено Тогда
			УстановитьСуммуВЭДО(СтрокаДокумента, Сумма);
		ИначеЕсли СвойствоЕсть Тогда
			Ключ = ?(НесколькоЗаписей, СтрокаДокумента.Организация, "");   // Неопределено ключом Соответствия не хранится
			Группа = ПоОрганизациям.Получить(Ключ);
			Если Группа = Неопределено Тогда
				Группа = Новый Массив;
				ПоОрганизациям.Вставить(Ключ, Группа);
			КонецЕсли;
			Группа.Добавить(СтрокаДокумента.ИдОператора);
		КонецЕсли;
	КонецЦикла;
	Если ПоОрганизациям.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Дозапрос - подсказка к списку, и список не должен его ждать: за одно открытие не больше
	// ПределДозапросаСумм() карточек, пачками по 100 и в пределах СекундДозапросаСумм(); первая же
	// неотвеченная пачка останавливает дозапрос. Чего не дозапросили - без суммы, возьмется
	// при следующем открытии или точечной сверкой.
	Маршруты = Новый Соответствие;
	Ошибки = Новый Массив;
	Срок = ТекущаяУниверсальнаяДатаВМиллисекундах() + СекундДозапросаСумм() * 1000;
	Осталось = ПределДозапросаСумм();
	Попытка
		Для Каждого Группа Из ПоОрганизациям Цикл
			Индекс = 0;
			Пока Индекс < Группа.Значение.Количество() И Осталось > 0 Цикл
				Если ТекущаяУниверсальнаяДатаВМиллисекундах() > Срок ИЛИ Ошибки.Количество() > 0 Тогда
					Прервать;
				КонецЕсли;
				Пачка = Новый Массив;
				Пока Индекс < Группа.Значение.Количество() И Пачка.Количество() < 100 И Осталось > 0 Цикл
					Пачка.Добавить(Группа.Значение[Индекс]);
					Индекс = Индекс + 1;
					Осталось = Осталось - 1;
				КонецЦикла;
				ПолучателиКарточек(Пачка, ?(НесколькоЗаписей, Группа.Ключ, Неопределено), Маршруты, Ошибки);
			КонецЦикла;
		КонецЦикла;
	Исключение
		// токен не получили - список без дозапрошенных сумм
		ЗаписьЖурналаРегистрации("ЭДО.СуммаВЭДО", УровеньЖурналаРегистрации.Предупреждение, , ,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	УстановитьПривилегированныйРежим(Истина);
	Для Каждого СтрокаДокумента Из Результат Цикл
		Если СтрокаДокумента.Вид <> ВидУПД ИЛИ НЕ ЗначениеЗаполнено(СтрокаДокумента.ИдОператора) Тогда
			Продолжить;
		КонецЕсли;
		Маршрут = Маршруты.Получить(СтрокаДокумента.ИдОператора);
		Если Маршрут = Неопределено ИЛИ Маршрут.Сумма = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УстановитьСуммуВЭДО(СтрокаДокумента, Маршрут.Сумма);
		Попытка
			ЭДО_Сервер.ЗапомнитьСуммуВЭДО(СтрокаДокумента.Документ, СтрокаДокумента.ИдОператора, Маршрут.Сумма,
				СтрокаДокумента.ЗначениеСуммыВЭДО);
		Исключение
			// не запомнили - спросим оператора при следующем открытии списка
			ЗаписьЖурналаРегистрации("ЭДО.СуммаВЭДО", УровеньЖурналаРегистрации.Предупреждение, , СтрокаДокумента.Документ,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Функция ПределДозапросаСумм()
	Возврат 300;
КонецФункции

Функция СекундДозапросаСумм()
	Возврат 15;
КонецФункции

Процедура УстановитьСуммуВЭДО(СтрокаДокумента, Знач Сумма)

	СтрокаДокумента.СуммаВЭДО = Сумма;
	СтрокаДокумента.СуммаРасходится = Макс(Сумма, СтрокаДокумента.Сумма) - Мин(Сумма, СтрокаДокумента.Сумма) >= 0.01;
	Если СтрокаДокумента.СуммаРасходится Тогда
		СтрокаДокумента.Причина = "Документ изменен после отправки: в ЭДО ушло "
			+ Формат(Сумма, "ЧДЦ=2; ЧН=0") + ", сейчас " + Формат(СтрокаДокумента.Сумма, "ЧДЦ=2; ЧН=0");
	КонецЕсли;

КонецПроцедуры
// -- ЩА 15.10.2026 [yan]

// Документы контрагента за период с адресом и оператором, куда они фактически ушли:
// реализации, корректировки и акты сверки. Адрес берется из карточки у оператора по
// сохраненному идентификатору, а не из карточки контрагента: адрес после отправки меняют.
// Возврат: Структура (Документы - ТаблицаЗначений (Документ, Дата, Организация, Состояние,
// ИдОператора, Адрес, Оператор, СтатусОператора); Ошибка - Строка, "" если оператор ответил по всем).
Функция ДокументыКонтрагентаСМаршрутом(Знач Контрагент, Знач Начало, Знач Конец) Экспорт

	ТаблицаДокументов = Новый ТаблицаЗначений;
	ТаблицаДокументов.Колонки.Добавить("Документ");
	ТаблицаДокументов.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ТаблицаДокументов.Колонки.Добавить("Организация");
	ТаблицаДокументов.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));
	ТаблицаДокументов.Колонки.Добавить("ИдОператора", Новый ОписаниеТипов("Строка"));
	ТаблицаДокументов.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка"));
	ТаблицаДокументов.Колонки.Добавить("Оператор", Новый ОписаниеТипов("Строка"));
	ТаблицаДокументов.Колонки.Добавить("СтатусОператора", Новый ОписаниеТипов("Строка"));
	Итог = Новый Структура("Документы, Ошибка", ТаблицаДокументов, "");

	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Итог;
	КонецЕсли;

	// Акт сверки не проводится, у него отбор по пометке удаления.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Реализация.Ссылка КАК Документ,
		|	Реализация.Дата КАК Дата,
		|	Реализация.Организация КАК Организация
		|ПОМЕСТИТЬ ДокументыКонтрагента
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Реализация
		|ГДЕ
		|	Реализация.Проведен
		|	И Реализация.Контрагент = &Контрагент
		|	И Реализация.Дата МЕЖДУ &Начало И &Конец
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Корректировка.Ссылка,
		|	Корректировка.Дата,
		|	Корректировка.Организация
		|ИЗ
		|	Документ.КорректировкаРеализации КАК Корректировка
		|ГДЕ
		|	Корректировка.Проведен
		|	И Корректировка.Контрагент = &Контрагент
		|	И Корректировка.Дата МЕЖДУ &Начало И &Конец
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	АктСверки.Ссылка,
		|	АктСверки.Дата,
		|	АктСверки.Организация
		|ИЗ
		|	Документ.АктСверкиВзаиморасчетов КАК АктСверки
		|ГДЕ
		|	НЕ АктСверки.ПометкаУдаления
		|	И АктСверки.Контрагент = &Контрагент
		|	И АктСверки.Дата МЕЖДУ &Начало И &Конец
		|;
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1000
		|	ДокументыКонтрагента.Документ КАК Документ,
		|	ДокументыКонтрагента.Дата КАК Дата,
		|	ДокументыКонтрагента.Организация КАК Организация,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)), """") КАК Состояние,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Ид.Значение КАК СТРОКА(50)), """") КАК ИдОператора
		|ИЗ
		|	ДокументыКонтрагента КАК ДокументыКонтрагента
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Сост
		|		ПО (Сост.Объект = ДокументыКонтрагента.Документ)
		|			И (Сост.Свойство = &СвСостояние)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Ид
		|		ПО (Ид.Объект = ДокументыКонтрагента.Документ)
		|			И (Ид.Свойство = &СвИдентификатор)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";
	Запрос.УстановитьПараметр("СвСостояние", ПустаяЕслиНеНайдено(ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние")));
	Запрос.УстановитьПараметр("СвИдентификатор", ПустаяЕслиНеНайдено(ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента")));
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец)); // дата «по» из поля формы приходит с 00:00:00

	// Идентификаторы группируются по организации: оператора спрашиваем токеном ее учетной записи.
	ПоОрганизациям = Новый Соответствие;
	НесколькоЗаписей = ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ИдОператора = СокрЛП(НоваяСтрока.ИдОператора);
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.Состояние) Тогда
			НоваяСтрока.Состояние = "Не обработан";
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.ИдОператора) Тогда
			Продолжить;
		КонецЕсли;
		// Соответствие не хранит ключ Неопределено, поэтому при одной учетной записи ключ - пустая строка.
		Ключ = ?(НесколькоЗаписей, Выборка.Организация, "");
		Группа = ПоОрганизациям.Получить(Ключ);
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			ПоОрганизациям.Вставить(Ключ, Группа);
		КонецЕсли;
		Группа.Добавить(НоваяСтрока.ИдОператора);
	КонецЦикла;

	Маршруты = Новый Соответствие;
	Ошибки = Новый Массив;
	Для Каждого Группа Из ПоОрганизациям Цикл
		ПолучателиКарточек(Группа.Значение, ?(НесколькоЗаписей, Группа.Ключ, Неопределено), Маршруты, Ошибки);
	КонецЦикла;
	Итог.Ошибка = СтрСоединить(Ошибки, "; ");

	Операторы = ЭДО_Сервер.ОператорыЭДО();
	Для Каждого СтрокаДокумента Из ТаблицаДокументов Цикл
		Маршрут = Маршруты.Получить(СтрокаДокумента.ИдОператора);
		Если Маршрут = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаДокумента.Адрес = Маршрут.Адрес;
		СтрокаДокумента.Оператор = ЭДО_Сервер.ИмяОператораЭДО(Маршрут.Адрес, Операторы);
		СтрокаДокумента.СтатусОператора = Маршрут.Статус;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Получатель и статус карточек у оператора по идентификаторам: список documents?id=...
// интервала дат не требует. Маршруты - Соответствие (ид -> Структура(Адрес, Статус)).
Процедура ПолучателиКарточек(Знач Идентификаторы, Знач Организация, Маршруты, Ошибки)

	Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Ложь, Организация) Тогда
		Ошибки.Добавить("не удалось получить токен Платформы");
		Возврат;
	КонецЕсли;
	Соединение = ЭДО_Сервер.СоединениеСОператором(20);
	// page_size обязателен: без него выдача режется до 20 записей.
	РазмерПачки = 100;
	Индекс = 0;
	Пока Индекс < Идентификаторы.Количество() Цикл
		Пачка = Новый Массив;
		Пока Индекс < Идентификаторы.Количество() И Пачка.Количество() < РазмерПачки Цикл
			Пачка.Добавить("id=" + Идентификаторы[Индекс]);
			Индекс = Индекс + 1;
		КонецЦикла;
		Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/documents?"
			+ СтрСоединить(Пачка, "&") + "&page_size=" + РазмерПачки;

		Ответ = ОтветОператораНаСписок(Соединение, Путь, Организация);
		Если Ответ = Неопределено ИЛИ Ответ.КодСостояния <> 200 Тогда
			Ошибки.Добавить("оператор не ответил по " + Пачка.Количество() + " документам"
				+ ?(Ответ = Неопределено, "", " (HTTP " + Ответ.КодСостояния + ")"));
			Продолжить;
		КонецЕсли;
		ДобавитьМаршрутыКарточек(Ответ.ПолучитьТелоКакСтроку("UTF-8"), Маршруты);
	КонецЦикла;

КонецПроцедуры

// GET к оператору; на 401 токен перевыпускается один раз. Неопределено - соединение оборвалось.
Функция ОтветОператораНаСписок(Соединение, Знач Путь, Знач Организация)

	Для НомерПопытки = 1 По 2 Цикл
		ЗапросОператору = Новый HTTPЗапрос(Путь);
		ЗапросОператору.Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
		ЗапросОператору.Заголовки.Вставить("accept", "application/json;charset=UTF-8");
		Попытка
			Ответ = Соединение.Получить(ЗапросОператору);
		Исключение
			ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ОтветОператораНаСписок: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
			Возврат Неопределено;
		КонецПопытки;
		Если Ответ.КодСостояния <> 401 ИЛИ НомерПопытки = 2 Тогда
			Возврат Ответ;
		КонецЕсли;
		ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Процедура ДобавитьМаршрутыКарточек(Знач Тело, Маршруты)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Тело);
	Карточки = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Если ТипЗнч(Карточки) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Карточка Из Карточки Цикл
		Если ТипЗнч(Карточка) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		// Идентификатор приходит числом, Строка() вставила бы разделители групп.
		ИдКарточки = Карточка.Получить("id");
		ИдКарточки = ?(ТипЗнч(ИдКарточки) = Тип("Число"), Формат(ИдКарточки, "ЧГ=0"), СокрЛП(Строка(ИдКарточки)));
		Получатель = Карточка.Получить("recipient");
		ИдПолучателя = ?(ТипЗнч(Получатель) = Тип("Соответствие"), Получатель.Получить("id"), Неопределено);
		Статус = Карточка.Получить("status");
		Маршруты.Вставить(ИдКарточки, Новый Структура("Адрес, Статус, Сумма",
			?(ИдПолучателя = Неопределено, "", ВРег(СокрЛП(Строка(ИдПолучателя)))),
			?(Статус = Неопределено, "", СокрЛП(Строка(Статус))),
			ЭДО_Сервер.СуммаКарточкиОператора(Карточка)));   // ЩА 15.10.2026 [yan]
	КонецЦикла;

КонецПроцедуры

// Сводка по контрагентам, у которых за период были проведенные отгрузки: по всему справочнику
// счетчики вроде "без адреса ЭДО" ничего бы не значили.
// Контрагент - отбор Центра управления (ЩА 23.10.2026 [yan]).
// Возврат: ТаблицаЗначений с колонками Признак, Количество.
Функция СводкаКонтрагентов(Знач Начало = '00010101', Знач Конец = '00010101', Знач Контрагент = Неопределено) Экспорт

	Данные = ДанныеКонтрагентов(Начало, Конец, , Контрагент);

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Признак", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));

	Для Каждого Имя Из ПризнакиКонтрагентов() Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Признак = Имя;
	КонецЦикла;

	Для Каждого СтрокаДанных Из Данные Цикл
		Для Каждого Имя Из ПризнакиКонтрагента(СтрокаДанных) Цикл
			Найденная = Результат.Найти(Имя, "Признак");
			Если Найденная = Неопределено Тогда
				Найденная = Результат.Добавить();
				Найденная.Признак = Имя;
			КонецЕсли;
			Найденная.Количество = Найденная.Количество + 1;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Порядок признаков на форме. Сверху то, что мешает отправке прямо сейчас.
Функция ПризнакиКонтрагентов() Экспорт

	Имена = Новый Массив;
	Имена.Добавить("Всего отгружали за период");
	Имена.Добавить("Отправка на паузе");
	Имена.Добавить("Нет адреса ЭДО");
	Имена.Добавить("Адрес есть, связи нет");
	Имена.Добавить("Ждем подтверждения роуминга");
	Имена.Добавить("Связь разорвана");
	Имена.Добавить("Адрес не закреплен");
	Имена.Добавить("Резервный канал не закреплен, отправка удержана");
	Имена.Добавить("Резервный канал, доставка не подтверждается");
	Имена.Добавить("Обмен налажен");

	Возврат Имена;

КонецФункции

// Какие признаки подходят строке данных о контрагенте. Признаки не исключают друг друга:
// контрагент на паузе может быть и без закрепленного адреса, и это разные работы.
Функция ПризнакиКонтрагента(Знач Данные) Экспорт

	Имена = Новый Массив;
	Имена.Добавить("Всего отгружали за период");

	Если Данные.НаПаузе Тогда
		Имена.Добавить("Отправка на паузе");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Данные.Адрес) Тогда
		Имена.Добавить("Нет адреса ЭДО");
	Иначе
		// Статусы пишет сверка связей из ответа Платформы: DIRECT - обмен внутри Платформы без роуминга,
		// AWAIT_APPROVAL - наше приглашение в роуминг ждет, пока его примет контрагент.
		Статус = ВРег(СокрЛП(Данные.СтатусСвязи));
		Если Статус = "ESTABLISHED" ИЛИ Статус = "DIRECT" Тогда
			Имена.Добавить("Обмен налажен");
		ИначеЕсли Статус = "AWAIT_APPROVAL" Тогда
			Имена.Добавить("Ждем подтверждения роуминга");
		ИначеЕсли Статус = "BROKEN" Тогда
			Имена.Добавить("Связь разорвана");
		Иначе
			Имена.Добавить("Адрес есть, связи нет");
		КонецЕсли;

		Если НЕ Данные.АдресЗакреплен Тогда
			Имена.Добавить("Адрес не закреплен");
		КонецЕсли;

		// Без закрепления ядро на такой адрес не отправляет, а с закреплением отправляет, но статус SENT
		// там окончательный: прочтение видно только по подписи.
		Если ЭДО_Сервер.АдресЭДОВнеАвтовыбора(Данные.Адрес) Тогда
			Если Данные.АдресЗакреплен Тогда
				Имена.Добавить("Резервный канал, доставка не подтверждается");
			Иначе
				Имена.Добавить("Резервный канал не закреплен, отправка удержана");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Имена;

КонецФункции

// Контрагенты по признаку - расшифровка по щелчку. Контрагент - отбор Центра управления.
Функция КонтрагентыПоПризнаку(Знач Признак, Знач Начало = '00010101', Знач Конец = '00010101',
	Знач Контрагент = Неопределено) Экспорт

	Данные = ДанныеКонтрагентов(Начало, Конец, , Контрагент);

	Результат = Данные.СкопироватьКолонки();
	Для Каждого СтрокаДанных Из Данные Цикл
		Если ПризнакиКонтрагента(СтрокаДанных).Найти(Признак) <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), СтрокаДанных);
		КонецЕсли;
	КонецЦикла;

	Результат.Сортировать("Документов Убыв");

	Возврат Результат;

КонецФункции

// Данные о контрагентах с отгрузками за период: адрес, оператор, связь, пауза, закрепление,
// сколько документов отправлено и сколько из них контрагент еще не подписал.
// Организация - тот же отбор, что у СводкаИсходящих: Неопределено значит "по всем организациям".
// ЩА 23.10.2026 [yan]: Контрагент - отбор Центра управления; ДажеБезОтгрузок - контрагент отбора попадает
// в результат строкой с нулями и без отгрузок за период (приглашение до первой отгрузки).
Функция ДанныеКонтрагентов(Знач Начало = '00010101', Знач Конец = '00010101', Знач Организация = Неопределено,
	Знач Контрагент = Неопределено, Знач ДажеБезОтгрузок = Ложь) Экспорт

	Если НЕ ЗначениеЗаполнено(Начало) ИЛИ НЕ ЗначениеЗаполнено(Конец) Тогда
		Период = ПериодПоУмолчанию();
		Начало = ?(ЗначениеЗаполнено(Начало), Начало, Период.Начало);
		Конец = ?(ЗначениеЗаполнено(Конец), Конец, Период.Конец);
	КонецЕсли;

	СвАдрес = ЭДО_Сервер.СвойствоОбъектов("ЭДО_АдресКонтрагента");
	СвСвязь = ЭДО_Сервер.СвойствоСтатусаСвязиОрганизации(Организация);   // ЩА 20.10.2026 [yan]: связь организации отбора
	СвПауза = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ОтправкаПриостановлена");
	СвПричина = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ПричинаПаузы");
	СвЗакреп = ЭДО_Сервер.СвойствоОбъектов("ЭДО_АдресЗакреплён");
	СвСостояние = ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние");

	НеПодписанные = СостоянияЖдемКонтрагента();
	Отправленные = Новый Массив;
	Для Каждого Текст Из НеПодписанные Цикл
		Отправленные.Добавить(Текст);
	КонецЦикла;
	Для Каждого Текст Из СостоянияТребуетРешения() Цикл
		Отправленные.Добавить(Текст);
	КонецЦикла;
	Отправленные.Добавить(ЭДО_Сервер.ТекстПодписанКонтрагентом());
	Отправленные.Добавить(ЭДО_Сервер.ТекстАннулирован());
	// ЩА 15.10.2026 [yan]: и прежние формулировки - до их переписывания.
	Для Каждого Текст Из Отправленные Цикл
		Для Каждого Прежний Из ЭДО_Сервер.ТекстыСтатусаСПрежними(Текст) Цикл
			Если Отправленные.Найти(Прежний) = Неопределено Тогда
				Отправленные.Добавить(Прежний);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	РТУ.Контрагент КАК Контрагент,
		|	КОЛИЧЕСТВО(РТУ.Ссылка) КАК Документов,
		|	СУММА(РТУ.СуммаДокумента) КАК Сумма,
		|	СУММА(ВЫБОР КОГДА ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)) В (&Отправленные)
		|		ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Отправлено,
		|	СУММА(ВЫБОР КОГДА ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)) В (&НеПодписанные)
		|		ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК НеПодписано
		|ПОМЕСТИТЬ Отгрузки
		|ИЗ Документ.РеализацияТоваровУслуг КАК РТУ
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Сост
		|		ПО Сост.Объект = РТУ.Ссылка И Сост.Свойство = &СвСостояние
		|ГДЕ РТУ.Проведен
		|	И РТУ.Дата МЕЖДУ &Начало И &Конец
		|	И (&БезОтбораОрганизации ИЛИ РТУ.Организация = &Организация)
		|	И (&БезОтбораКонтрагента ИЛИ РТУ.Контрагент = &Контрагент)
		|СГРУППИРОВАТЬ ПО РТУ.Контрагент
		|;
		|ВЫБРАТЬ
		|	Отгрузки.Контрагент КАК Контрагент,
		|	Отгрузки.Документов КАК Документов,
		|	Отгрузки.Сумма КАК Сумма,
		|	Отгрузки.Отправлено КАК Отправлено,
		|	Отгрузки.НеПодписано КАК НеПодписано
		|ПОМЕСТИТЬ Активные
		|ИЗ Отгрузки КАК Отгрузки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Контрагенты.Ссылка,
		|	0,
		|	0,
		|	0,
		|	0
		|ИЗ Справочник.Контрагенты КАК Контрагенты
		|ГДЕ &ДажеБезОтгрузок
		|	И Контрагенты.Ссылка = &Контрагент
		|	И НЕ Контрагенты.Ссылка В (ВЫБРАТЬ БылиОтгрузки.Контрагент ИЗ Отгрузки КАК БылиОтгрузки)
		|;
		|ВЫБРАТЬ
		|	Активные.Контрагент КАК Контрагент,
		|	Активные.Документов КАК Документов,
		|	Активные.Сумма КАК Сумма,
		|	Активные.Отправлено КАК Отправлено,
		|	Активные.НеПодписано КАК НеПодписано,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Адрес.Значение КАК СТРОКА(50)), """") КАК Адрес,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Связь.Значение КАК СТРОКА(50)), """") КАК СтатусСвязи,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Причина.Значение КАК СТРОКА(50)), """") КАК ПричинаПаузы,
		|	ВЫБОР КОГДА ВЫРАЗИТЬ(Пауза.Значение КАК БУЛЕВО) = ИСТИНА
		|			ИЛИ ВЫРАЗИТЬ(Пауза.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК НаПаузе,
		|	ВЫБОР КОГДА ВЫРАЗИТЬ(Закреп.Значение КАК БУЛЕВО) = ИСТИНА
		|			ИЛИ ВЫРАЗИТЬ(Закреп.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК АдресЗакреплен
		|ИЗ Активные КАК Активные
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Адрес
		|		ПО ВЫРАЗИТЬ(Адрес.Объект КАК Справочник.Контрагенты) = Активные.Контрагент
		|			И Адрес.Свойство = &СвАдрес
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Связь
		|		ПО ВЫРАЗИТЬ(Связь.Объект КАК Справочник.Контрагенты) = Активные.Контрагент
		|			И Связь.Свойство = &СвСвязь
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Пауза
		|		ПО ВЫРАЗИТЬ(Пауза.Объект КАК Справочник.Контрагенты) = Активные.Контрагент
		|			И Пауза.Свойство = &СвПауза
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Причина
		|		ПО ВЫРАЗИТЬ(Причина.Объект КАК Справочник.Контрагенты) = Активные.Контрагент
		|			И Причина.Свойство = &СвПричина
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Закреп
		|		ПО ВЫРАЗИТЬ(Закреп.Объект КАК Справочник.Контрагенты) = Активные.Контрагент
		|			И Закреп.Свойство = &СвЗакреп";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец)); // дата «по» из поля формы приходит с 00:00:00
	Запрос.УстановитьПараметр("СвАдрес", ПустаяЕслиНеНайдено(СвАдрес));
	Запрос.УстановитьПараметр("СвСвязь", ПустаяЕслиНеНайдено(СвСвязь));
	Запрос.УстановитьПараметр("СвПауза", ПустаяЕслиНеНайдено(СвПауза));
	Запрос.УстановитьПараметр("СвПричина", ПустаяЕслиНеНайдено(СвПричина));
	Запрос.УстановитьПараметр("СвЗакреп", ПустаяЕслиНеНайдено(СвЗакреп));
	Запрос.УстановитьПараметр("СвСостояние", ПустаяЕслиНеНайдено(СвСостояние));
	Запрос.УстановитьПараметр("Отправленные", Отправленные);
	Запрос.УстановитьПараметр("НеПодписанные", НеПодписанные);
	Запрос.УстановитьПараметр("БезОтбораОрганизации", НЕ ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("Организация", ?(ЗначениеЗаполнено(Организация), Организация,
		Справочники.Организации.ПустаяСсылка()));
	УстановитьОтборКонтрагента(Запрос, Контрагент);
	Запрос.УстановитьПараметр("ДажеБезОтгрузок", ДажеБезОтгрузок И ЗначениеЗаполнено(Контрагент));

	Результат = Запрос.Выполнить().Выгрузить();

	Результат.Колонки.Добавить("Оператор", Новый ОписаниеТипов("Строка"));
	Операторы = ЭДО_Сервер.ОператорыЭДО();
	Для Каждого СтрокаДанных Из Результат Цикл
		СтрокаДанных.Оператор = ЭДО_Сервер.ИмяОператораЭДО(СтрокаДанных.Адрес, Операторы);
	КонецЦикла;

	Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Приглашения контрагентов: кто позван, кто принял, у кого связь уже есть.
//
// Строится ТОЛЬКО из уже посчитанного: своих данных о контрагенте (ДанныеКонтрагентов) и
// КЭША состояний приглашений (ЭДО_Сервер.КэшСостоянийПриглашений). Сетевых обращений здесь
// нет ни одного - иначе страница открывалась бы столько же, сколько сам опрос оператора.
// Исключение - один контрагент из отбора без адреса и без записи в кэше реестра: его адреса
// спрашиваются у реестра ФНС (СводкаПриглашений).
// Актуальность кэша - забота кнопки "Обновить состояние" (ЭДО_Сервер.ОбновитьСостоянияПриглашений).
////////////////////////////////////////////////////////////////////////////////

// Порядок состояний на форме - см. ЭДО_Сервер.СписокСостоянийПриглашений (единственный
// источник списка: ОбновитьСостоянияПриглашений считает по нему же счетчики свода прогона,
// и порядки не должны разойтись).
Функция СостоянияПриглашений() Экспорт

	Возврат ЭДО_Сервер.СписокСостоянийПриглашений();

КонецФункции

// Сводка приглашений по контрагентам с отгрузками за период. Организация - тот же отбор,
// что у ДанныеКонтрагентов; тем же значением читается и кэш состояний (см. КэшСостоянийПриглашений
// в ЭДО_Сервер - он теперь хранится по организации, чтобы связь одной организации не показывалась
// у другой).
// ЩА 23.10.2026 [yan]: Контрагент - отбор Центра управления; он попадает в список и без отгрузок за период,
// чтобы позвать в ЭДО до первой отгрузки.
// Возврат: ТаблицаЗначений (Контрагент, ИНН, Адрес, Оператор, Состояние, ДатаПриглашения,
// ДатаОтвета, Документов).
Функция СводкаПриглашений(Знач Начало = '00010101', Знач Конец = '00010101', Знач Организация = Неопределено,
	Знач Контрагент = Неопределено) Экспорт

	Данные = ДанныеКонтрагентов(Начало, Конец, Организация, Контрагент, Истина);

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Контрагент");
	Результат.Колонки.Добавить("ИНН", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Оператор", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ДатаПриглашения", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("ДатаОтвета", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("Документов", Новый ОписаниеТипов("Число"));
	// Сколько всего ящиков у этого ИНН по реестру: единица - обычный случай, больше -
	// повод посмотреть, туда ли идут документы (раскрытие по двойному щелчку в форме).
	Результат.Колонки.Добавить("Ящиков", Новый ОписаниеТипов("Число"));

	Реестр = ЭДО_Сервер.ЗагрузитьРеестрАдресов();
	Маршруты = ЭДО_Сервер.ЗагрузитьФактическиеМаршруты();
	Кэш = ЭДО_Сервер.КэшСостоянийПриглашений(Организация);
	Операторы = ЭДО_Сервер.ОператорыЭДО();

	Для Каждого СтрокаДанных Из Данные Цикл
		Адрес = СокрЛП(СтрокаДанных.Адрес);
		Если НЕ ЗначениеЗаполнено(Адрес) Тогда
			// своего адреса у контрагента нет - берем первый пригодный кандидат из кэша
			// реестра ФНС, тот же источник, что и у ПригласитьНовыхКонтрагентов.
			Адрес = ПервыйПригодныйАдресКандидата(СтрокаДанных.Контрагент, Реестр, Маршруты, Кэш);
		КонецЕсли;
		// ЩА 23.10.2026 [yan]: контрагента отбора, которому не отгружали, в кэше реестра нет - спросить реестр ФНС.
		ОтветРеестра = "";
		ИННСтроки = СокрЛП(Строка(СтрокаДанных.Контрагент.ИНН));
		Если НЕ ЗначениеЗаполнено(Адрес) И ЗначениеЗаполнено(Контрагент) И ЗначениеЗаполнено(ИННСтроки)
			И Реестр[ИННСтроки] = Неопределено Тогда
			Найденные = ЭДО_Сервер.АдресаКонтрагентаИзРеестраФНС(СтрокаДанных.Контрагент, Организация);
			Если Найденные.Ошибка Тогда
				ОтветРеестра = "реестр ФНС не ответил";
			Иначе
				Реестр.Вставить(ИННСтроки, Новый Структура("Адреса", Найденные.Адреса));
				Адрес = ПервыйПригодныйАдресКандидата(СтрокаДанных.Контрагент, Реестр, Маршруты, Кэш);
				ОтветРеестра = ?(ЗначениеЗаполнено(Адрес), "", "в реестре ФНС адресов нет");
			КонецЕсли;
		КонецЕсли;

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Контрагент = СтрокаДанных.Контрагент;
		НоваяСтрока.ИНН = СокрЛП(Строка(СтрокаДанных.Контрагент.ИНН));
		НоваяСтрока.Адрес = Адрес;
		НоваяСтрока.Документов = СтрокаДанных.Документов;
		НоваяСтрока.Ящиков = ЯщиковПоИНН(НоваяСтрока.ИНН, Реестр);
		НоваяСтрока.Оператор = ?(ЗначениеЗаполнено(Адрес), ЭДО_Сервер.ИмяОператораЭДО(Адрес, Операторы), ОтветРеестра);

		Если НЕ ЗначениеЗаполнено(Адрес) Тогда
			НоваяСтрока.Состояние = "Не звали";
			Продолжить;
		КонецЕсли;

		ИзКэша = Кэш[ВРег(Адрес)];
		Если ИзКэша <> Неопределено Тогда
			НоваяСтрока.Состояние = ИзКэша.Состояние;
			НоваяСтрока.ДатаПриглашения = ИзКэша.ДатаПриглашения;
			НоваяСтрока.ДатаОтвета = ИзКэша.ДатаОтвета;
			Продолжить;
		КонецЕсли;

		// Обновление состояний по этому адресу еще не запускали - все, что можно сказать
		// без сети, уже есть в свежей сверке связей (ДанныеКонтрагентов ее тоже читает).
		Статус = ВРег(СокрЛП(СтрокаДанных.СтатусСвязи));
		НоваяСтрока.Состояние = ?(Статус = "ESTABLISHED" ИЛИ Статус = "DIRECT", "Связь есть", "Не звали");
	КонецЦикла;

	Результат.Сортировать("Состояние, Документов Убыв");

	Возврат Результат;

КонецФункции

// Итоги по состояниям для верхней таблицы страницы "Приглашения" - по образцу ИтогиПоГруппам.
Функция ИтогиПриглашений(Знач Сводка) Экспорт

	Итоги = Новый ТаблицаЗначений;
	Итоги.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));
	Итоги.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));

	Для Каждого Имя Из СостоянияПриглашений() Цикл
		НоваяСтрока = Итоги.Добавить();
		НоваяСтрока.Состояние = Имя;
	КонецЦикла;

	Для Каждого СтрокаСводки Из Сводка Цикл
		Найденная = Итоги.Найти(СтрокаСводки.Состояние, "Состояние");
		Если Найденная = Неопределено Тогда
			Найденная = Итоги.Добавить();
			Найденная.Состояние = СтрокаСводки.Состояние;
		КонецЕсли;
		Найденная.Количество = Найденная.Количество + 1;
	КонецЦикла;

	Возврат Итоги;

КонецФункции

// Первый пригодный адрес-кандидат из кэша реестра адресов ФНС (ЭДО_Сервер.ЗагрузитьРеестрАдресов)
// для контрагента без собственного адреса ЭДО. Тот же отбор, что у
// ЭДО_Сервер.ПригласитьНовыхКонтрагентов: без каналов вне автовыбора и без наших же адресов -
// иначе в списке "кому звать" попадали бы адреса, звать по которым бессмысленно.
Функция ПервыйПригодныйАдресКандидата(Знач Контрагент, Знач Реестр, Знач Маршруты, Знач Кэш = Неопределено)

	ИНН = СокрЛП(Строка(Контрагент.ИНН));
	Если НЕ ЗначениеЗаполнено(ИНН) Тогда
		Возврат "";
	КонецЕсли;

	// Фактический маршрут (куда документы реально доходили раньше) приоритетнее кандидатов
	// из реестра ФНС - тот же порядок, что у ОбновитьСвязиЭДО. Маршруты[ИНН] дает Неопределено,
	// если записи нет - СокрЛП на нем упал бы "несовместимые типы".
	ФактическийАдрес = Маршруты[ИНН];
	Если ЗначениеЗаполнено(ФактическийАдрес) Тогда
		Возврат СокрЛП(ФактическийАдрес);
	КонецЕсли;

	ЗаписьРеестра = Реестр[ИНН];
	Если ЗаписьРеестра = Неопределено ИЛИ ТипЗнч(ЗаписьРеестра) <> Тип("Структура")
		ИЛИ НЕ ЗаписьРеестра.Свойство("Адреса") Тогда
		Возврат "";
	КонецЕсли;

	// Из нескольких ящиков одного ИНН нужен РАБОЧИЙ, а не первый попавшийся: реестр ФНС
	// отдает и давно брошенные. Прецедент 25.09.2026: у ООО "Лион-Трейд" четыре адреса,
	// первым шел 2EE, обмен же идет через 2BM, и вся строка выглядела как "не звали".
	// Порядок: где связь уже есть, потом куда звали, потом по приоритету оператора.
	Пригодные = Новый Массив;
	Для Каждого Кандидат Из ЗаписьРеестра.Адреса Цикл
		Адрес = СокрЛП(Кандидат);
		Если НЕ ЗначениеЗаполнено(Адрес) ИЛИ ЭДО_Сервер.АдресЭДОВнеАвтовыбора(Адрес)
			ИЛИ ЭДО_Сервер.АдресЭДОНаш(Адрес) Тогда
			Продолжить;
		КонецЕсли;
		Пригодные.Добавить(Адрес);
	КонецЦикла;

	Если Пригодные.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Если Кэш <> Неопределено Тогда
		Лучший = "";
		ЛучшийВес = -1;
		Для Каждого Адрес Из Пригодные Цикл
			ИзКэша = Кэш[ВРег(Адрес)];
			Если ИзКэша = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Вес = ?(ИзКэша.Состояние = "Связь есть", 3, ?(ИзКэша.Состояние = "Приглашение отправлено", 2, 1));
			Если Вес > ЛучшийВес Тогда
				ЛучшийВес = Вес;
				Лучший = Адрес;
			КонецЕсли;
		КонецЦикла;
		Если ЗначениеЗаполнено(Лучший) Тогда
			Возврат Лучший;
		КонецЕсли;
	КонецЕсли;

	Возврат Пригодные[0];

КонецФункции

// Сколько ящиков у ИНН по кэшу реестра адресов. Ноль - контрагента в реестре нет вовсе.
Функция ЯщиковПоИНН(Знач ИНН, Знач Реестр)

	ЗаписьРеестра = Реестр[СокрЛП(ИНН)];
	Если ЗаписьРеестра = Неопределено ИЛИ ТипЗнч(ЗаписьРеестра) <> Тип("Структура")
		ИЛИ НЕ ЗаписьРеестра.Свойство("Адреса") Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ЗаписьРеестра.Адреса.Количество();

КонецФункции

// Все ящики контрагента со своими состояниями - для раскрытия строки в форме. Организация -
// тот же отбор формы, что и у СводкаПриглашений: важно передать его, иначе кэш прочитает
// состояния по умолчанию (первой) организации, а не по выбранной.
// Возврат: ТаблицаЗначений (Адрес, Оператор, Состояние, ДатаПриглашения, ДатаОтвета, Рабочий).
Функция ЯщикиКонтрагента(Знач Контрагент, Знач Организация = Неопределено) Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Оператор", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ДатаПриглашения", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("ДатаОтвета", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("Рабочий", Новый ОписаниеТипов("Булево"));

	Реестр = ЭДО_Сервер.ЗагрузитьРеестрАдресов();
	Маршруты = ЭДО_Сервер.ЗагрузитьФактическиеМаршруты();
	Кэш = ЭДО_Сервер.КэшСостоянийПриглашений(Организация);
	Операторы = ЭДО_Сервер.ОператорыЭДО();

	ИНН = СокрЛП(Строка(Контрагент.ИНН));
	// ЩА 23.10.2026 [yan], ревью Codex (КАТАП №24): контрагента без отгрузок в кэше реестра нет - строка списка
	// приглашений берет его адреса из реестра ФНС (СводкаПриглашений), и расшифровка должна видеть те же.
	Если ЗначениеЗаполнено(ИНН) И Реестр[ИНН] = Неопределено Тогда
		Найденные = ЭДО_Сервер.АдресаКонтрагентаИзРеестраФНС(Контрагент, Организация);
		Если НЕ Найденные.Ошибка Тогда
			Реестр.Вставить(ИНН, Новый Структура("Адреса", Найденные.Адреса));
		КонецЕсли;
	КонецЕсли;
	Рабочий = ПервыйПригодныйАдресКандидата(Контрагент, Реестр, Маршруты, Кэш);
	// Собственный адрес контрагента (свойство ЭДО_АдресКонтрагента) главнее вычисленного:
	// он проставлен ядром по подтвержденной связи либо закреплен человеком.
	СвАдрес = ЭДО_Сервер.СвойствоОбъектов("ЭДО_АдресКонтрагента");
	СобственныйАдрес = "";
	Если СвАдрес <> Неопределено И НЕ СвАдрес.Пустая() Тогда
		СобственныйАдрес = СокрЛП(Строка(ЭДО_Сервер.ЗначениеСвойстваОбъекта(Контрагент, СвАдрес)));
	КонецЕсли;
	Если ЗначениеЗаполнено(СобственныйАдрес) Тогда
		Рабочий = СобственныйАдрес;
	КонецЕсли;

	ЗаписьРеестра = Реестр[ИНН];
	Адреса = Новый Массив;
	Если ЗаписьРеестра <> Неопределено И ТипЗнч(ЗаписьРеестра) = Тип("Структура")
		И ЗаписьРеестра.Свойство("Адреса") Тогда
		Для Каждого Кандидат Из ЗаписьРеестра.Адреса Цикл
			Адреса.Добавить(СокрЛП(Кандидат));
		КонецЦикла;
	КонецЕсли;
	Если ЗначениеЗаполнено(Рабочий) И Адреса.Найти(Рабочий) = Неопределено Тогда
		Адреса.Добавить(Рабочий);
	КонецЕсли;

	Для Каждого Адрес Из Адреса Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Адрес = Адрес;
		НоваяСтрока.Оператор = ЭДО_Сервер.ИмяОператораЭДО(Адрес, Операторы);
		НоваяСтрока.Рабочий = (ВРег(Адрес) = ВРег(Рабочий));
		ИзКэша = Кэш[ВРег(Адрес)];
		Если ИзКэша = Неопределено Тогда
			НоваяСтрока.Состояние = "Не звали";
			Продолжить;
		КонецЕсли;
		НоваяСтрока.Состояние = ИзКэша.Состояние;
		НоваяСтрока.ДатаПриглашения = ИзКэша.ДатаПриглашения;
		НоваяСтрока.ДатаОтвета = ИзКэша.ДатаОтвета;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Организации базы и разрешение отправки. Без флага организация не отправляет ничего, а со стороны
// это неотличимо от пустой очереди - поэтому разрешение показывается явно.
Функция СводкаОрганизаций(Знач Начало = '00010101', Знач Конец = '00010101', Знач ВидДокументов = "Все") Экспорт

	Если НЕ ЗначениеЗаполнено(Начало) ИЛИ НЕ ЗначениеЗаполнено(Конец) Тогда
		Период = ПериодПоУмолчанию();
		Начало = ?(ЗначениеЗаполнено(Начало), Начало, Период.Начало);
		Конец = ?(ЗначениеЗаполнено(Конец), Конец, Период.Конец);
	КонецЕсли;

	СвРазрешена = ЭДО_Сервер.СвойствоОбъектов("ЭДО_РазрешенаОтправка");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	РТУ.Организация КАК Организация,
		|	КОЛИЧЕСТВО(РТУ.Ссылка) КАК Документов
		|ПОМЕСТИТЬ Отгрузки
		|ИЗ " + ТекстИсточникаДокументов(ВидДокументов) + " КАК РТУ
		|СГРУППИРОВАТЬ ПО РТУ.Организация
		|;
		|ВЫБРАТЬ
		|	Орг.Ссылка КАК Организация,
		|	Орг.ИНН КАК ИНН,
		|	ЕСТЬNULL(Отгрузки.Документов, 0) КАК Документов,
		|	ВЫБОР КОГДА ВЫРАЗИТЬ(Разр.Значение КАК БУЛЕВО) = ИСТИНА
		|			ИЛИ ВЫРАЗИТЬ(Разр.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК РазрешенаОтправка
		|ИЗ Справочник.Организации КАК Орг
		|	ЛЕВОЕ СОЕДИНЕНИЕ Отгрузки КАК Отгрузки ПО Отгрузки.Организация = Орг.Ссылка
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Разр
		|		ПО ВЫРАЗИТЬ(Разр.Объект КАК Справочник.Организации) = Орг.Ссылка
		|			И Разр.Свойство = &СвРазрешена
		|ГДЕ НЕ Орг.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО Документов УБЫВ";
	УстановитьПараметрыИсточника(Запрос, Начало, Конец);
	Запрос.УстановитьПараметр("СвРазрешена", ПустаяЕслиНеНайдено(СвРазрешена));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Состояние контура: то, что ломает отправку молча.
// Сюда идет только дешевое - без обращения к API. Проверка контура ходит в сеть
// и вызывается отдельной кнопкой.
Функция СводкаКонтура() Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Показатель", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Значение", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Тревога", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("Расшифровка", Новый ОписаниеТипов("Строка"));

	ДобавитьСтрокуКонтура(Результат, "Версия расширения", ВерсияРасширения(), Ложь);

	Недостающие = ЭДО_Сервер.НедостающиеНастройкиЭДО();
	ДобавитьСтрокуКонтура(Результат, "Настройки интеграции",
		?(Недостающие.Количество() = 0, "заполнены",
			"не заполнено: " + СтрСоединить(Недостающие, ", ")),
		Недостающие.Количество() > 0);

	// Сертификат свой у каждой организации, поэтому строка на каждую учетную запись.
	Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
		Заголовок = "Сертификат подписанта: " + Строка(УчетнаяЗапись.Организация);
		Попытка
			Сертификат = ЭДО_Сервер.СостояниеСертификатаПодписанта(Ложь, УчетнаяЗапись.Организация);
			Если Сертификат.Найден Тогда
				ДобавитьСтрокуКонтура(Результат, Заголовок,
					Формат(Сертификат.ДействителенПо, "ДЛФ=D") + ", осталось дней: "
						+ Формат(Сертификат.ДнейОсталось, "ЧН=0; ЧГ=0"),
					Сертификат.ДнейОсталось < 30);
			Иначе
				ДобавитьСтрокуКонтура(Результат, Заголовок, Сертификат.Описание, Истина);
			КонецЕсли;
		Исключение
			ДобавитьСтрокуКонтура(Результат, Заголовок,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
		КонецПопытки;
	КонецЦикла;

	// Подпись на сервере - тоже строкой на учетную запись, иначе не видно, у кого ее нет.
	УчетныеЗаписи = ЭДО_Сервер.УчетныеЗаписиЭДО();
	Если УчетныеЗаписи.Количество() = 0 Тогда
		ДобавитьСтрокуКонтура(Результат, "Подпись на сервере",
			"нет ни одной учетной записи организации", Истина);
	КонецЕсли;
	Для Каждого УчетнаяЗапись Из УчетныеЗаписи Цикл
		Доступна = ЭДО_Сервер.ПодписьНаСервереДоступна(УчетнаяЗапись.Организация);
		ДобавитьСтрокуКонтура(Результат,
			"Подпись на сервере: " + Строка(УчетнаяЗапись.Организация),
			?(Доступна, "доступна", "недоступна"), НЕ Доступна);
	КонецЦикла;

	Пропущенные = Новый Массив;
	Для Каждого Имя Из ЭДО_Сервер.ОбязательныеСвойстваОбъектов() Цикл
		Свойство = ЭДО_Сервер.СвойствоОбъектов(Имя);
		Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
			Пропущенные.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	ДобавитьСтрокуКонтура(Результат, "Свойства объектов",
		?(Пропущенные.Количество() = 0, "заведены все",
			"не заведено: " + СтрСоединить(Пропущенные, ", ")),
		Пропущенные.Количество() > 0);

	Расхождения = СводкаРасхождений();
	Если Расхождения.Всего = 0 Тогда
		ДобавитьСтрокуКонтура(Результат, "Расходятся с отправленным", "нет", Ложь);
	Иначе
		ДобавитьСтрокуКонтура(Результат, "Расходятся с отправленным",
			Формат(Расхождения.Всего, "ЧГ=0") + " - подписано контрагентом "
				+ Формат(Расхождения.Подписано, "ЧГ=0")
				+ ", ещё не подписано " + Формат(Расхождения.НеПодписано, "ЧГ=0")
				+ ?(Расхождения.СменаПокупателя > 0, ", сменен покупатель у "
					+ Формат(Расхождения.СменаПокупателя, "ЧГ=0"), ""),
			Истина);
	КонецЕсли;

	ДобавитьСтрокиСторожаАдресов(Результат);
	ДобавитьСтрокуНашихАннулирований(Результат);

	Возврат Результат;

КонецФункции

// Строка контура по снимку сторожа наших ПОА. Срок ожидания ответа берется из настройки
// в момент показа, сторож его не знает.
Процедура ДобавитьСтрокуНашихАннулирований(Результат)

	Показатель = "Наши ПОА без ответа контрагента";
	Снимок = ЭДО_Сторожа.СнимокНашихАннулирований();
	Если Снимок = Неопределено Тогда
		ДобавитьСтрокуКонтура(Результат, Показатель, "сторож еще не запускался", Ложь);
		Возврат;
	КонецЕсли;

	ДнейОжидания = ДнейБезПодтвержденияПОА();
	Старых = ПросроченныеНашиАннулирования(Снимок, ДнейОжидания).Количество();
	ДобавитьСтрокуКонтура(Результат, Показатель,
		?(Старых = 0, "нет", Формат(Старых, "ЧН=0; ЧГ=0")) + " старше " + Формат(ДнейОжидания, "ЧН=0; ЧГ=0") + " дн."
			+ " (всего без ответа " + Формат(Снимок.Предложения.Количество(), "ЧН=0; ЧГ=0")
			+ ", прогон " + Формат(Снимок.ДатаПрогона, "ДФ='dd.MM.yyyy HH:mm'")
			+ ?(Снимок.Неполно, ", НЕПОЛНЫЙ", "") + ")",
		Старых > 0 ИЛИ Снимок.Неполно, "НашиАннулирования");

КонецПроцедуры

Функция ДнейБезПодтвержденияПОА()

	Возврат Макс(0, ЭДО_Сервер.НастройкаЭДО("ДнейБезПодтвержденияПОА"));

КонецФункции

// Строки снимка, чей ПОА ждет ответа дольше срока.
Функция ПросроченныеНашиАннулирования(Знач Снимок, Знач ДнейОжидания)

	Граница = ТекущаяДатаСеанса() - ДнейОжидания * 86400;
	Результат = Новый Массив;
	Для Каждого СтрокаСнимка Из Снимок.Предложения Цикл
		Если СтрокаСнимка.Создан < Граница Тогда
			Результат.Добавить(СтрокаСнимка);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Расшифровка строки контура "Наши ПОА без ответа контрагента": ПОА старше срока из настройки.
// Номер и дата - из базы, если документ найден, иначе из карточки оператора.
Функция ДокументыНашихАннулирований() Экспорт

	Результат = НоваяТаблицаДокументов();
	Результат.Колонки.Добавить("ДатаПОА", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("Причина", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("СтатусОператора", Новый ОписаниеТипов("Строка"));

	Снимок = ЭДО_Сторожа.СнимокНашихАннулирований();
	Если Снимок = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого СтрокаСнимка Из ПросроченныеНашиАннулирования(Снимок, ДнейБезПодтвержденияПОА()) Цикл
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСнимка, "Документ, Контрагент, Организация, Номер, Причина");
		НоваяСтрока.Дата = СтрокаСнимка.ДатаДок;
		НоваяСтрока.ДатаПОА = СтрокаСнимка.Создан;
		НоваяСтрока.ИдОператора = СтрокаСнимка.ИдНашего;
		НоваяСтрока.СтатусОператора = ?(СтрокаСнимка.Статус = "REJECTED", "отклонен", "нет ответа");
	КонецЦикла;

	ДополнитьДаннымиДокументов(Результат);
	Для Каждого СтрокаДокумента Из Результат Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаДокумента.Документ) Тогда
			СтрокаДокумента.Состояние = "Документ не найден в базе";
		КонецЕсли;
	КонецЦикла;

	Результат.Сортировать("ДатаПОА");

	Возврат Результат;

КонецФункции

// Строки контура по итогу сторожа адреса получателя. Сторож ходит к оператору раз в сутки
// и кладет снимок, поэтому рядом с числом показывается время прогона.
Процедура ДобавитьСтрокиСторожаАдресов(Результат)

	Снимок = ЭДО_Сторожа.СнимокСторожаАдресов();
	Если Снимок = Неопределено Тогда
		ДобавитьСтрокуКонтура(Результат, ПоказательАдресовПолучателя(), "сторож еще не запускался", Ложь);
		Возврат;
	КонецЕсли;

	Прогон = " (прогон " + Формат(Снимок.ДатаПрогона, "ДФ='dd.MM.yyyy HH:mm'")
		+ ?(Снимок.Неполно, ", НЕПОЛНЫЙ", "") + ")";

	Расхождений = Снимок.Расхождения.Количество();
	НеВСчет = 0;
	Если Снимок.Свойство("НеВСчет") И Снимок.НеВСчет > 0 Тогда
		НеВСчет = Снимок.НеВСчет;
	КонецЕсли;
	ДобавитьСтрокуКонтура(Результат, ПоказательАдресовПолучателя(),
		?(Расхождений = 0, "нет",
			Формат(Расхождений, "ЧН=0; ЧГ=0") + " на " + Формат(Снимок.Расхождения.Итог("Сумма"), "ЧДЦ=2; ЧН=0") + " руб.")
			+ ?(НеВСчет > 0, ", не в счет " + Формат(НеВСчет, "ЧГ=0"), "")
			+ Прогон,
		Расхождений > 0 ИЛИ Снимок.Неполно, "АдресПолучателя");

	БезАдреса = Снимок.БезАдреса;
	БезАдресаЭДО = БезАдреса.НайтиСтроки(Новый Структура("ЕстьАдресЭДО", Ложь)).Количество();
	БезАдресаКИ = БезАдреса.НайтиСтроки(Новый Структура("ЕстьАдресКИ", Ложь)).Количество();
	ДобавитьСтрокуКонтура(Результат, "Живая связь без адреса",
		?(БезАдреса.Количество() = 0, "нет",
			Формат(БезАдреса.Количество(), "ЧН=0; ЧГ=0") + ": без адреса ЭДО " + Формат(БезАдресаЭДО, "ЧН=0; ЧГ=0")
				+ ", без почтового " + Формат(БезАдресаКИ, "ЧН=0; ЧГ=0"))
			+ Прогон,
		БезАдреса.Количество() > 0, "БезАдреса");

КонецПроцедуры

Функция ПоказательАдресовПолучателя()
	Возврат "Ушли не на текущий адрес";
КонецФункции

// Расшифровка строки контура "Ушли не на текущий адрес": документы из снимка сторожа, по группам причин.
// Адреса, статус у оператора, причина и сумма - на момент прогона, дата, номер и состояние ЭДО - из базы сейчас.
Функция ДокументыАдресовПолучателя() Экспорт

	Результат = НоваяТаблицаДокументов();
	Результат.Колонки.Добавить("ОтправленоНа", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ТекущийАдрес", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("СтатусОператора", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Причина", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ПорядокПричины", Новый ОписаниеТипов("Число"));

	Снимок = ЭДО_Сторожа.СнимокСторожаАдресов();
	Если Снимок = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ЕстьПричины = Снимок.Расхождения.Колонки.Найти("Причина") <> Неопределено;
	Для Каждого СтрокаСнимка Из Снимок.Расхождения Цикл
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСнимка, "Документ, Контрагент, ОтправленоНа, ТекущийАдрес, Сумма");
		Если ЕстьПричины Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСнимка, "Причина, ПорядокПричины");
		КонецЕсли;
		НоваяСтрока.ИдОператора = СтрокаСнимка.Ид;
		НоваяСтрока.СтатусОператора = СтрокаСнимка.Статус;
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.ТекущийАдрес) Тогда
			НоваяСтрока.ТекущийАдрес = "адреса нет";
		КонецЕсли;
	КонецЦикла;

	ДополнитьДаннымиДокументов(Результат);
	Для Каждого СтрокаДокумента Из Результат Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаДокумента.Состояние) Тогда
			СтрокаДокумента.Состояние = "Не обработан";
		КонецЕсли;
	КонецЦикла;

	Результат.Сортировать("ПорядокПричины, Причина, Сумма Убыв");

	Возврат Результат;

КонецФункции

// Дата, номер, организация и состояние ЭДО из базы для строк с заполненным документом.
// Документы разных видов: накладные, корректировки, акты сверки - запрос на каждый вид.
Процедура ДополнитьДаннымиДокументов(Результат)

	ПоВидам = Новый Соответствие;
	Для Каждого СтрокаДокумента Из Результат Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(СтрокаДокумента.Документ));
		Если ОбъектМетаданных = Неопределено ИЛИ НЕ Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		Ссылки = ПоВидам.Получить(ОбъектМетаданных.Имя);
		Если Ссылки = Неопределено Тогда
			Ссылки = Новый Массив;
			ПоВидам.Вставить(ОбъектМетаданных.Имя, Ссылки);
		КонецЕсли;
		Ссылки.Добавить(СтрокаДокумента.Документ);
	КонецЦикла;

	ДанныеДокументов = Новый Соответствие;
	Если ПоВидам.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапросаДанныхДокументов(ПоВидам);
		Запрос.УстановитьПараметр("СвСостояние", ПустаяЕслиНеНайдено(ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние")));
		Для Каждого Вид Из ПоВидам Цикл
			Запрос.УстановитьПараметр("Ссылки" + Вид.Ключ, Вид.Значение);
		КонецЦикла;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ДанныеДокументов.Вставить(Выборка.Документ,
				Новый Структура("Дата, Номер, Организация, Состояние",
					Выборка.Дата, Выборка.Номер, Выборка.Организация, Выборка.Состояние));
		КонецЦикла;
	КонецЕсли;

	Для Каждого СтрокаДокумента Из Результат Цикл
		Данные = ДанныеДокументов.Получить(СтрокаДокумента.Документ);
		Если Данные <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаДокумента, Данные);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Дата, номер, организация и состояние ЭДО документов разных видов одним запросом.
// ПоВидам - Соответствие: ключ - имя вида документа, значение - массив ссылок в параметре "Ссылки<Имя вида>".
Функция ТекстЗапросаДанныхДокументов(Знач ПоВидам)

	Части = Новый Массив;
	Для Каждого Вид Из ПоВидам Цикл
		ЕстьОрганизация = Метаданные.Документы[Вид.Ключ].Реквизиты.Найти("Организация") <> Неопределено;
		Части.Добавить(
		"ВЫБРАТЬ
		|	Док.Ссылка КАК Документ,
		|	Док.Дата КАК Дата,
		|	Док.Номер КАК Номер,
		|	" + ?(ЕстьОрганизация, "Док.Организация", "НЕОПРЕДЕЛЕНО") + " КАК Организация,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)), """") КАК Состояние
		|ИЗ
		|	Документ." + Вид.Ключ + " КАК Док
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Сост
		|		ПО Сост.Объект = Док.Ссылка
		|			И Сост.Свойство = &СвСостояние
		|ГДЕ
		|	Док.Ссылка В (&Ссылки" + Вид.Ключ + ")");
	КонецЦикла;

	Возврат СтрСоединить(Части, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);

КонецФункции

// Расшифровка строки контура "Живая связь без адреса": контрагенты из снимка сторожа.
// Возврат: ТаблицаЗначений (Контрагент, СтатусСвязи, НетАдреса).
Функция КонтрагентыБезАдреса() Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Контрагент");
	Результат.Колонки.Добавить("СтатусСвязи", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("НетАдреса", Новый ОписаниеТипов("Строка"));

	Снимок = ЭДО_Сторожа.СнимокСторожаАдресов();
	Если Снимок = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого СтрокаСнимка Из Снимок.БезАдреса Цикл
		НетАдресов = Новый Массив;
		Если НЕ СтрокаСнимка.ЕстьАдресЭДО Тогда
			НетАдресов.Добавить("адреса ЭДО");
		КонецЕсли;
		Если НЕ СтрокаСнимка.ЕстьАдресКИ Тогда
			НетАдресов.Добавить("почтового адреса");
		КонецЕсли;

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Контрагент = СтрокаСнимка.Контрагент;
		НоваяСтрока.СтатусСвязи = СтрокаСнимка.Связь;
		НоваяСтрока.НетАдреса = "нет " + СтрСоединить(НетАдресов, " и ");
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сколько документов разошлись с тем, что ушло контрагенту. Подписанные и неподписанные - разная работа:
// неподписанный лечится переотправкой, подписанный - только аннулированием с подтверждением контрагента.
// Подписанность - по тексту «Подписан контрагентом» в ЭДО_Состояние: ЭДО_КодСостояния в боевой базе практически пуст.
// Признак расхождения ставит сторож, здесь только подсчет без обращения к оператору.
// Смена покупателя считается отдельно: такой документ новому покупателю не уходил вовсе.
// Возврат: Структура (Всего, Подписано, НеПодписано, СменаПокупателя).
Функция СводкаРасхождений() Экспорт

	Результат = Новый Структура("Всего, Подписано, НеПодписано, СменаПокупателя", 0, 0, 0, 0);

	СвойствоРасхождение = ЭДО_Сервер.СвойствоОбъектов("ЭДО_РасхождениеСОтправленным");
	СвойствоСостояние = ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние");
	Если СвойствоРасхождение = Неопределено ИЛИ СвойствоРасхождение.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СвРасхождение", СвойствоРасхождение);
	Запрос.УстановитьПараметр("СвСостояние", СвойствоСостояние);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Расх.Объект КАК Объект,
	|	ВЫРАЗИТЬ(Расх.Значение КАК СТРОКА(50)) КАК Расхождение,
	|	ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)) КАК Состояние
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК Расх
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Сост
	|		ПО Сост.Объект = Расх.Объект
	|			И Сост.Свойство = &СвСостояние
	|ГДЕ
	|	Расх.Свойство = &СвРасхождение
	|	И ВЫРАЗИТЬ(Расх.Значение КАК СТРОКА(50)) <> """"";
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Состояние = ?(Выборка.Состояние = NULL, "", СокрЛП(Строка(Выборка.Состояние)));
		Результат.Всего = Результат.Всего + 1;
		Если СтрНачинаетсяС(СокрЛП(Строка(Выборка.Расхождение)), ЭДО_Сторожа.ПрефиксСменыПокупателя()) Тогда
			Результат.СменаПокупателя = Результат.СменаПокупателя + 1;
		КонецЕсли;
		Если ЭДО_Сервер.ПодписанПоТекстуКолонки(Состояние) Тогда
			Результат.Подписано = Результат.Подписано + 1;
		Иначе
			Результат.НеПодписано = Результат.НеПодписано + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Версия расширения из его метаданных.
// ЩА 23.10.2026 [yan]: ВСеансе - версия, загруженная этим сеансом при входе (ИсточникРасширенийКонфигурации.
// СеансАктивные): после установки новой версии сеанс работает на прежней до перезапуска 1С. Без него -
// установленная в информационной базе.
Функция ВерсияРасширения(Знач ВСеансе = Ложь) Экспорт

	Попытка
		Расширения = ?(ВСеансе, РасширенияКонфигурации.Получить(, ИсточникРасширенийКонфигурации.СеансАктивные),
			РасширенияКонфигурации.Получить());
		Для Каждого Расширение Из Расширения Цикл
			Если Расширение.Имя = "ЦентрУправленияЭДО" Тогда
				Возврат Расширение.Версия;
			КонецЕсли;
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ВерсияРасширения: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат "не определена";
	КонецПопытки;

	Возврат "не определена";

КонецФункции

Процедура ДобавитьСтрокуКонтура(Таблица, Знач Показатель, Знач Значение, Знач Тревога, Знач Расшифровка = "")

	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Показатель = Показатель;
	НоваяСтрока.Значение = Строка(Значение);
	НоваяСтрока.Тревога = Тревога;
	НоваяСтрока.Расшифровка = Расшифровка;

КонецПроцедуры

// НайтиПоНаименованию возвращает ПУСТУЮ ССЫЛКУ, а не Неопределено. Соединение по пустому
// свойству находит чужие записи - документ получил бы чужое значение (грабля ядра 24.08.2026).

// Неопределено заменяется пустой ссылкой, чтобы параметр соединения в запросе всегда был ссылкой на свойство.
Функция ПустаяЕслиНеНайдено(Знач Свойство)

	Если Свойство = Неопределено Тогда
		Возврат ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка();
	КонецЕсли;

	Возврат Свойство;

КонецФункции
