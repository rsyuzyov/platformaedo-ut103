////////////////////////////////////////////////////////////////////////////////
// Витрина центра управления ЭДО: быстрые показатели, считаемые ПО БАЗЕ.
//
// Здесь нет ни одного обращения к API. Все, что требует обхода оператора
// (молчащие дольше порога, расхождения с ГИС МТ, входящие, состояния связей),
// считают сторожа минутами и кладут снимком - витрина такой показатель только читает.
// Иначе форма открывалась бы полминуты и упиралась в токен Keycloak.
//
// Источник быстрых показателей - колонка ЭДО_Состояние, которую уже ведет ядро
// (ЭДО_Сервер.ОбновитьПричиныНеотправки и регламент сверки статусов). Витрина ее
// ГРУППИРУЕТ и не повторяет логику отбора: два разных запроса о том, что уходит,
// разошлись бы молча, и человек увидел бы цифру, не совпадающую с очередью.
////////////////////////////////////////////////////////////////////////////////

// Группы состояний. Порядок задает и порядок вывода на форме: сверху то,
// что требует действия от нас, снизу то, где делать нечего.
Функция ГруппыСостояний() Экспорт

	Группы = Новый Массив;
	Группы.Добавить("Застряло у нас");
	Группы.Добавить("Требует решения");
	Группы.Добавить("Ждем контрагента");
	Группы.Добавить("Не взято в очередь");
	Группы.Добавить("Завершено");
	Группы.Добавить("Прочее");

	Возврат Группы;

КонецФункции

// К какой группе отнести текст колонки.
// Разложение по группам не косметика: действие у групп разное. "Застряло у нас" разбирает
// администратор, "Требует решения" - бухгалтер, "Ждем контрагента" не требует ничего,
// а "Не взято в очередь" почти всегда чинится данными. Одна общая цифра
// "незавершенных" не подсказывает, кому идти работать.
Функция ГруппаСостояния(Знач Текст) Экспорт

	Значение = СокрЛП(Текст);
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "Прочее";
	КонецЕсли;

	Если СостоянияЗастрялоУНас().Найти(Значение) <> Неопределено Тогда
		Возврат "Застряло у нас";
	КонецЕсли;
	Если СостоянияТребуетРешения().Найти(Значение) <> Неопределено Тогда
		Возврат "Требует решения";
	КонецЕсли;
	Если СостоянияЖдемКонтрагента().Найти(Значение) <> Неопределено Тогда
		Возврат "Ждем контрагента";
	КонецЕсли;
	Если СостоянияЗавершено().Найти(Значение) <> Неопределено Тогда
		Возврат "Завершено";
	КонецЕсли;
	Если СостоянияНеВзятоВОчередь().Найти(Значение) <> Неопределено Тогда
		Возврат "Не взято в очередь";
	КонецЕсли;

	// Незнакомый статус связи ядро печатает с префиксом и показывает как есть.
	Если Найти(Значение, ЭДО_Сервер.ПрефиксПричиныСвязи()) = 1 Тогда
		Возврат "Не взято в очередь";
	КонецЕсли;
	// У корректировки на паузе перед автоотправкой в тексте время окончания паузы.
	Если Найти(Значение, ЭДО_Сервер.ПрефиксОжиданияПроверкиУКД()) = 1 Тогда
		Возврат "Не взято в очередь";
	КонецЕсли;

	// Незнакомое НЕ прячем: группа "Прочее" на виду и есть сигнал, что карта статусов
	// ядра чего-то не знает.
	Возврат "Прочее";

КонецФункции

// Документ взят оператором, а дальше ход прервался. Это наша работа, а не контрагента.
Функция СостоянияЗастрялоУНас() Экспорт

	Тексты = Новый Массив;
	Тексты.Добавить("Ошибка: не отправлен");
	Тексты.Добавить("Взят в отправку, прогон не завершен");
	Тексты.Добавить("Взят в отправку, прогон не завершён");
	Тексты.Добавить("Состояние у оператора неизвестно");
	// Карточку удалили у оператора, а документ в базе жив: контрагент его не получил,
	// и решить, отправлять ли заново, некому, кроме нас.
	Тексты.Добавить(ЭДО_Сервер.ТекстКарточкаУдалена());

	Возврат Тексты;

КонецФункции

// Ответ контрагента получен, и он требует решения человека.
Функция СостоянияТребуетРешения() Экспорт

	Тексты = Новый Массив;
	Тексты.Добавить("Отказ контрагента");
	Тексты.Добавить("Запрошено аннулирование");
	Тексты.Добавить(ЭДО_Сервер.ТекстЗапросаАннулирования());

	Возврат Тексты;

КонецФункции

// Документ у контрагента, делать нечего - только ждать.
Функция СостоянияЖдемКонтрагента() Экспорт

	Тексты = Новый Массив;
	Тексты.Добавить("Отправляется");
	Тексты.Добавить("Отправлен");
	Тексты.Добавить("Доставлен");

	Возврат Тексты;

КонецФункции

// Цикл документа закончен либо отправка по нему не нужна.
Функция СостоянияЗавершено() Экспорт

	Тексты = Новый Массив;
	Тексты.Добавить("Принят");
	Тексты.Добавить("Аннулирован");
	Тексты.Добавить(ЭДО_Сервер.ТекстСтатусаОтправкаНеТребуется());
	Тексты.Добавить("Отправлен через СБИС");
	Тексты.Добавить("Уже отправлен этому получателю");

	Возврат Тексты;

КонецФункции

// Причины, по которым документ не попал в очередь. Набор берется у ядра, а не
// переписывается здесь: расхождение в одну букву дало бы группу "Прочее",
// растущую молча при каждой правке формулировки.
Функция СостоянияНеВзятоВОчередь() Экспорт

	Тексты = Новый Массив;
	Для Каждого Текст Из ЭДО_Сервер.ТекстыПричинНеотправки() Цикл
		Если Текст = "Отправляется" Тогда
			Продолжить;   // это ход отправки, а не причина простоя
		КонецЕсли;
		Если Текст = "Отправлен через СБИС" Тогда
			Продолжить;   // ушел другим каналом, работа по нему закончена
		КонецЕсли;
		Тексты.Добавить(Текст);
	КонецЦикла;
	Для Каждого Текст Из ЭДО_Сервер.УстаревшиеТекстыПричин() Цикл
		Тексты.Добавить(Текст);
	КонецЦикла;

	Возврат Тексты;

КонецФункции

// Период по умолчанию - текущий год, но не раньше даты подключения ЭДО.
//
// Правило оператора от 25.08.2026 задает год, однако у документов ДО подключения
// колонки состояния нет вовсе, и они приезжают в витрину пустой группой. Замер на боевой
// prodline 09.09.2026: за год 59 462 документа, из них 48 623 без состояния - витрина
// показывала бы в основном шум. С даты подключения пустых не остается ни одного,
// и тот же запрос идет 84 мс вместо 429.
// Границу можно сдвинуть руками: поле периода на форме остается за человеком.
Функция ПериодПоУмолчанию() Экспорт

	Период = Новый Структура("Начало, Конец");
	Период.Начало = НачалоГода(ТекущаяДата());
	Период.Конец = КонецДня(ТекущаяДата());

	Граница = ЭДО_Сервер.РанняяДатаНачалаОтправки();
	Если НЕ ЗначениеЗаполнено(Граница) Тогда
		Граница = ЭДО_Сервер.НижняяГраницаОтбора();
	КонецЕсли;
	Если ЗначениеЗаполнено(Граница) И НачалоДня(Граница) > Период.Начало Тогда
		Период.Начало = НачалоДня(Граница);
	КонецЕсли;

	Возврат Период;

КонецФункции

// Сводка исходящих: состояние, группа, количество, сумма.
// Возврат: ТаблицаЗначений с колонками Группа, Состояние, Количество, Сумма.
Функция СводкаИсходящих(Знач Начало = '00010101', Знач Конец = '00010101', Знач Организация = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(Начало) ИЛИ НЕ ЗначениеЗаполнено(Конец) Тогда
		Период = ПериодПоУмолчанию();
		Начало = ?(ЗначениеЗаполнено(Начало), Начало, Период.Начало);
		Конец = ?(ЗначениеЗаполнено(Конец), Конец, Период.Конец);
	КонецЕсли;

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Группа", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));

	СвСостояние = ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние");
	Если СвСостояние = Неопределено ИЛИ СвСостояние.Пустая() Тогда
		Возврат Результат;   // свойства нет - показывать нечего, но и падать незачем
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)), """") КАК Состояние,
		|	КОЛИЧЕСТВО(РТУ.Ссылка) КАК Количество,
		|	СУММА(РТУ.СуммаДокумента) КАК Сумма
		|ИЗ Документ.РеализацияТоваровУслуг КАК РТУ
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Сост
		|		ПО Сост.Объект = РТУ.Ссылка И Сост.Свойство = &СвСостояние
		|ГДЕ РТУ.Проведен
		|	И РТУ.Дата МЕЖДУ &Начало И &Конец
		|	И (&БезОтбораОрганизации ИЛИ РТУ.Организация = &Организация)
		|СГРУППИРОВАТЬ ПО ЕСТЬNULL(ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)), """")";
	Запрос.УстановитьПараметр("СвСостояние", СвСостояние);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("БезОтбораОрганизации", НЕ ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("Организация", ?(ЗначениеЗаполнено(Организация), Организация,
		Справочники.Организации.ПустаяСсылка()));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Состояние = ?(ЗначениеЗаполнено(Выборка.Состояние), Выборка.Состояние, "Не обработан");
		НоваяСтрока.Группа = ГруппаСостояния(Выборка.Состояние);
		НоваяСтрока.Количество = Выборка.Количество;
		НоваяСтрока.Сумма = ?(Выборка.Сумма = NULL, 0, Выборка.Сумма);
	КонецЦикла;

	Результат.Сортировать("Группа, Количество Убыв");

	Возврат Результат;

КонецФункции

// Итоги по группам для верхнего блока формы.
// Возврат: ТаблицаЗначений с колонками Группа, Количество, Сумма.
Функция ИтогиПоГруппам(Знач Сводка) Экспорт

	Итоги = Новый ТаблицаЗначений;
	Итоги.Колонки.Добавить("Группа", Новый ОписаниеТипов("Строка"));
	Итоги.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Итоги.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));

	Для Каждого Имя Из ГруппыСостояний() Цикл
		НоваяСтрока = Итоги.Добавить();
		НоваяСтрока.Группа = Имя;
	КонецЦикла;

	Для Каждого СтрокаСводки Из Сводка Цикл
		Найденная = Итоги.Найти(СтрокаСводки.Группа, "Группа");
		Если Найденная = Неопределено Тогда
			Найденная = Итоги.Добавить();
			Найденная.Группа = СтрокаСводки.Группа;
		КонецЕсли;
		Найденная.Количество = Найденная.Количество + СтрокаСводки.Количество;
		Найденная.Сумма = Найденная.Сумма + СтрокаСводки.Сумма;
	КонецЦикла;

	Возврат Итоги;

КонецФункции

// Документы в заданном состоянии - расшифровка по щелчку.
Функция ДокументыПоСостоянию(Знач Состояние, Знач Начало = '00010101', Знач Конец = '00010101',
	Знач Организация = Неопределено, Знач Лимит = 1000) Экспорт

	Состояния = Новый Массив;
	Состояния.Добавить(Состояние);

	Возврат ДокументыПоСостояниям(Состояния, Начало, Конец, Организация, Лимит);

КонецФункции

// Документы в любом из перечисленных состояний. Щелчок по группе на дашборде открывает
// все ее состояния разом, поэтому отбор принимает массив, а не одно значение.
// Лимит намеренный: список на тысячи строк человеку бесполезен, а форму он подвесит.
Функция ДокументыПоСостояниям(Знач Состояния, Знач Начало = '00010101', Знач Конец = '00010101',
	Знач Организация = Неопределено, Знач Лимит = 1000) Экспорт

	Если НЕ ЗначениеЗаполнено(Начало) ИЛИ НЕ ЗначениеЗаполнено(Конец) Тогда
		Период = ПериодПоУмолчанию();
		Начало = ?(ЗначениеЗаполнено(Начало), Начало, Период.Начало);
		Конец = ?(ЗначениеЗаполнено(Конец), Конец, Период.Конец);
	КонецЕсли;

	Результат = НоваяТаблицаДокументов();
	СвСостояние = ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние");
	Если СвСостояние = Неопределено ИЛИ СвСостояние.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;

	// "Не обработан" - это наша подпись для пустого значения, в базе его нет.
	ИскатьПустое = Ложь;
	Искомые = Новый Массив;
	Для Каждого Состояние Из Состояния Цикл
		Если СокрЛП(Состояние) = "Не обработан" ИЛИ НЕ ЗначениеЗаполнено(Состояние) Тогда
			ИскатьПустое = Истина;
		Иначе
			Искомые.Добавить(СокрЛП(Состояние));
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаДокументов(Лимит,
		"И (&БезОтбораОрганизации ИЛИ РТУ.Организация = &Организация)
		|	И ((&ИскатьПустое И ЕСТЬNULL(ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)), """") = """")
		|		ИЛИ ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)) В (&Искомые))");
	Запрос.УстановитьПараметр("СвСостояние", СвСостояние);
	Запрос.УстановитьПараметр("СвИдентификатор", ПустаяЕслиНеНайдено(ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента")));
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("ИскатьПустое", ИскатьПустое);
	Запрос.УстановитьПараметр("Искомые", Искомые);
	Запрос.УстановитьПараметр("БезОтбораОрганизации", НЕ ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("Организация", ?(ЗначениеЗаполнено(Организация), Организация,
		Справочники.Организации.ПустаяСсылка()));

	ЗаполнитьДокументы(Результат, Запрос);

	Возврат Результат;

КонецФункции

// Документы контрагента за период - расшифровка щелчка по контрагенту в разборе.
// Без отбора по организации: счетчик документов в списке контрагентов считается по всем.
Функция ДокументыКонтрагента(Знач Контрагент, Знач Начало = '00010101', Знач Конец = '00010101',
	Знач Лимит = 1000) Экспорт

	Если НЕ ЗначениеЗаполнено(Начало) ИЛИ НЕ ЗначениеЗаполнено(Конец) Тогда
		Период = ПериодПоУмолчанию();
		Начало = ?(ЗначениеЗаполнено(Начало), Начало, Период.Начало);
		Конец = ?(ЗначениеЗаполнено(Конец), Конец, Период.Конец);
	КонецЕсли;

	Результат = НоваяТаблицаДокументов();
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаДокументов(Лимит, "И РТУ.Контрагент = &Контрагент");
	Запрос.УстановитьПараметр("СвСостояние", ПустаяЕслиНеНайдено(ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние")));
	Запрос.УстановитьПараметр("СвИдентификатор", ПустаяЕслиНеНайдено(ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента")));
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	ЗаполнитьДокументы(Результат, Запрос);

	Возврат Результат;

КонецФункции

Функция НоваяТаблицаДокументов()

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Документ");
	Результат.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Контрагент");
	Результат.Колонки.Добавить("Организация");
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ИдОператора", Новый ОписаниеТипов("Строка"));

	Возврат Результат;

КонецФункции

// Общий текст выборки документов для расшифровок. УсловиеОтбора дописывается к ГДЕ
// и начинается с "И".
Функция ТекстЗапросаДокументов(Знач Лимит, Знач УсловиеОтбора)

	Возврат
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧН=0; ЧГ=0") + "
		|	РТУ.Ссылка КАК Документ,
		|	РТУ.Дата КАК Дата,
		|	РТУ.Номер КАК Номер,
		|	РТУ.Контрагент КАК Контрагент,
		|	РТУ.Организация КАК Организация,
		|	РТУ.СуммаДокумента КАК Сумма,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)), """") КАК Состояние,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Ид.Значение КАК СТРОКА(50)), """") КАК ИдОператора
		|ИЗ Документ.РеализацияТоваровУслуг КАК РТУ
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Сост
		|		ПО Сост.Объект = РТУ.Ссылка И Сост.Свойство = &СвСостояние
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Ид
		|		ПО Ид.Объект = РТУ.Ссылка И Ид.Свойство = &СвИдентификатор
		|ГДЕ РТУ.Проведен
		|	И РТУ.Дата МЕЖДУ &Начало И &Конец
		|	" + УсловиеОтбора + "
		|УПОРЯДОЧИТЬ ПО Дата УБЫВ";

КонецФункции

Процедура ЗаполнитьДокументы(Результат, Знач Запрос)

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.Состояние) Тогда
			НоваяСтрока.Состояние = "Не обработан";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Сводка по контрагентам, у которых за период были проведенные отгрузки.
//
// Считаем именно по активным, а не по всему справочнику: контрагентов тысячи, и почти все
// давно не отгружаются - счетчик "без адреса ЭДО" по всему справочнику показал бы тысячи
// и не значил бы ничего.
// Возврат: ТаблицаЗначений с колонками Признак, Количество.
Функция СводкаКонтрагентов(Знач Начало = '00010101', Знач Конец = '00010101') Экспорт

	Данные = ДанныеКонтрагентов(Начало, Конец);

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Признак", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));

	Для Каждого Имя Из ПризнакиКонтрагентов() Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Признак = Имя;
	КонецЦикла;

	Для Каждого СтрокаДанных Из Данные Цикл
		Для Каждого Имя Из ПризнакиКонтрагента(СтрокаДанных) Цикл
			Найденная = Результат.Найти(Имя, "Признак");
			Если Найденная = Неопределено Тогда
				Найденная = Результат.Добавить();
				Найденная.Признак = Имя;
			КонецЕсли;
			Найденная.Количество = Найденная.Количество + 1;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Порядок признаков на форме. Сверху то, что мешает отправке прямо сейчас.
Функция ПризнакиКонтрагентов() Экспорт

	Имена = Новый Массив;
	Имена.Добавить("Всего отгружали за период");
	Имена.Добавить("Отправка на паузе");
	Имена.Добавить("Нет адреса ЭДО");
	Имена.Добавить("Адрес есть, связи нет");
	Имена.Добавить("Ждем подтверждения роуминга");
	Имена.Добавить("Связь разорвана");
	Имена.Добавить("Адрес не закреплен");
	Имена.Добавить("Резервный канал не закреплен, отправка удержана");
	Имена.Добавить("Резервный канал, доставка не подтверждается");
	Имена.Добавить("Обмен налажен");

	Возврат Имена;

КонецФункции

// Какие признаки подходят строке данных о контрагенте. Признаки не исключают друг друга:
// контрагент на паузе может быть и без закрепленного адреса, и это разные работы.
Функция ПризнакиКонтрагента(Знач Данные) Экспорт

	Имена = Новый Массив;
	Имена.Добавить("Всего отгружали за период");

	Если Данные.НаПаузе Тогда
		Имена.Добавить("Отправка на паузе");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Данные.Адрес) Тогда
		Имена.Добавить("Нет адреса ЭДО");
	Иначе
		// Статусы пишет сверка связей из ответа Платформы: DIRECT - обмен внутри Платформы без роуминга,
		// AWAIT_APPROVAL - наше приглашение в роуминг ждет, пока его примет контрагент.
		Статус = ВРег(СокрЛП(Данные.СтатусСвязи));
		Если Статус = "ESTABLISHED" ИЛИ Статус = "DIRECT" Тогда
			Имена.Добавить("Обмен налажен");
		ИначеЕсли Статус = "AWAIT_APPROVAL" Тогда
			Имена.Добавить("Ждем подтверждения роуминга");
		ИначеЕсли Статус = "BROKEN" Тогда
			Имена.Добавить("Связь разорвана");
		Иначе
			Имена.Добавить("Адрес есть, связи нет");
		КонецЕсли;

		Если НЕ Данные.АдресЗакреплен Тогда
			Имена.Добавить("Адрес не закреплен");
		КонецЕсли;

		// Без закрепления ядро на такой адрес не отправляет, а с закреплением отправляет, но статус SENT
		// там окончательный: прочтение видно только по подписи.
		Если ЭДО_Сервер.АдресЭДОВнеАвтовыбора(Данные.Адрес) Тогда
			Если Данные.АдресЗакреплен Тогда
				Имена.Добавить("Резервный канал, доставка не подтверждается");
			Иначе
				Имена.Добавить("Резервный канал не закреплен, отправка удержана");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Имена;

КонецФункции

// Контрагенты по признаку - расшифровка по щелчку.
Функция КонтрагентыПоПризнаку(Знач Признак, Знач Начало = '00010101', Знач Конец = '00010101') Экспорт

	Данные = ДанныеКонтрагентов(Начало, Конец);

	Результат = Данные.СкопироватьКолонки();
	Для Каждого СтрокаДанных Из Данные Цикл
		Если ПризнакиКонтрагента(СтрокаДанных).Найти(Признак) <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), СтрокаДанных);
		КонецЕсли;
	КонецЦикла;

	Результат.Сортировать("Документов Убыв");

	Возврат Результат;

КонецФункции

// Данные о контрагентах с отгрузками за период: адрес, оператор, связь, пауза, закрепление,
// сколько документов отправлено и сколько из них контрагент еще не подписал.
Функция ДанныеКонтрагентов(Знач Начало = '00010101', Знач Конец = '00010101') Экспорт

	Если НЕ ЗначениеЗаполнено(Начало) ИЛИ НЕ ЗначениеЗаполнено(Конец) Тогда
		Период = ПериодПоУмолчанию();
		Начало = ?(ЗначениеЗаполнено(Начало), Начало, Период.Начало);
		Конец = ?(ЗначениеЗаполнено(Конец), Конец, Период.Конец);
	КонецЕсли;

	СвАдрес = ЭДО_Сервер.СвойствоОбъектов("ЭДО_АдресКонтрагента");
	СвСвязь = ЭДО_Сервер.СвойствоОбъектов("ЭДО_СтатусСвязи");
	СвПауза = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ОтправкаПриостановлена");
	СвПричина = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ПричинаПаузы");
	СвЗакреп = ЭДО_Сервер.СвойствоОбъектов("ЭДО_АдресЗакреплён");
	СвСостояние = ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние");

	НеПодписанные = СостоянияЖдемКонтрагента();
	Отправленные = Новый Массив;
	Для Каждого Текст Из НеПодписанные Цикл
		Отправленные.Добавить(Текст);
	КонецЦикла;
	Для Каждого Текст Из СостоянияТребуетРешения() Цикл
		Отправленные.Добавить(Текст);
	КонецЦикла;
	Отправленные.Добавить("Принят");
	Отправленные.Добавить("Аннулирован");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	РТУ.Контрагент КАК Контрагент,
		|	КОЛИЧЕСТВО(РТУ.Ссылка) КАК Документов,
		|	СУММА(РТУ.СуммаДокумента) КАК Сумма,
		|	СУММА(ВЫБОР КОГДА ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)) В (&Отправленные)
		|		ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Отправлено,
		|	СУММА(ВЫБОР КОГДА ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)) В (&НеПодписанные)
		|		ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК НеПодписано
		|ПОМЕСТИТЬ Активные
		|ИЗ Документ.РеализацияТоваровУслуг КАК РТУ
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Сост
		|		ПО Сост.Объект = РТУ.Ссылка И Сост.Свойство = &СвСостояние
		|ГДЕ РТУ.Проведен
		|	И РТУ.Дата МЕЖДУ &Начало И &Конец
		|СГРУППИРОВАТЬ ПО РТУ.Контрагент
		|;
		|ВЫБРАТЬ
		|	Активные.Контрагент КАК Контрагент,
		|	Активные.Документов КАК Документов,
		|	Активные.Сумма КАК Сумма,
		|	Активные.Отправлено КАК Отправлено,
		|	Активные.НеПодписано КАК НеПодписано,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Адрес.Значение КАК СТРОКА(50)), """") КАК Адрес,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Связь.Значение КАК СТРОКА(50)), """") КАК СтатусСвязи,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Причина.Значение КАК СТРОКА(50)), """") КАК ПричинаПаузы,
		|	ВЫБОР КОГДА ВЫРАЗИТЬ(Пауза.Значение КАК БУЛЕВО) = ИСТИНА
		|			ИЛИ ВЫРАЗИТЬ(Пауза.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК НаПаузе,
		|	ВЫБОР КОГДА ВЫРАЗИТЬ(Закреп.Значение КАК БУЛЕВО) = ИСТИНА
		|			ИЛИ ВЫРАЗИТЬ(Закреп.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК АдресЗакреплен
		|ИЗ Активные КАК Активные
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Адрес
		|		ПО ВЫРАЗИТЬ(Адрес.Объект КАК Справочник.Контрагенты) = Активные.Контрагент
		|			И Адрес.Свойство = &СвАдрес
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Связь
		|		ПО ВЫРАЗИТЬ(Связь.Объект КАК Справочник.Контрагенты) = Активные.Контрагент
		|			И Связь.Свойство = &СвСвязь
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Пауза
		|		ПО ВЫРАЗИТЬ(Пауза.Объект КАК Справочник.Контрагенты) = Активные.Контрагент
		|			И Пауза.Свойство = &СвПауза
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Причина
		|		ПО ВЫРАЗИТЬ(Причина.Объект КАК Справочник.Контрагенты) = Активные.Контрагент
		|			И Причина.Свойство = &СвПричина
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Закреп
		|		ПО ВЫРАЗИТЬ(Закреп.Объект КАК Справочник.Контрагенты) = Активные.Контрагент
		|			И Закреп.Свойство = &СвЗакреп";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("СвАдрес", ПустаяЕслиНеНайдено(СвАдрес));
	Запрос.УстановитьПараметр("СвСвязь", ПустаяЕслиНеНайдено(СвСвязь));
	Запрос.УстановитьПараметр("СвПауза", ПустаяЕслиНеНайдено(СвПауза));
	Запрос.УстановитьПараметр("СвПричина", ПустаяЕслиНеНайдено(СвПричина));
	Запрос.УстановитьПараметр("СвЗакреп", ПустаяЕслиНеНайдено(СвЗакреп));
	Запрос.УстановитьПараметр("СвСостояние", ПустаяЕслиНеНайдено(СвСостояние));
	Запрос.УстановитьПараметр("Отправленные", Отправленные);
	Запрос.УстановитьПараметр("НеПодписанные", НеПодписанные);

	Результат = Запрос.Выполнить().Выгрузить();

	Результат.Колонки.Добавить("Оператор", Новый ОписаниеТипов("Строка"));
	Операторы = ЭДО_Сервер.ОператорыЭДО();
	Для Каждого СтрокаДанных Из Результат Цикл
		СтрокаДанных.Оператор = ЭДО_Сервер.ИмяОператораЭДО(СтрокаДанных.Адрес, Операторы);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Организации базы и разрешение отправки.
// Умолчание - запрет: организация без флага не отправляет ничего. Витрина обязана это
// показывать, потому что "очередь пуста" и "организации не разрешена отправка" со стороны
// выглядят одинаково - именно так в moroz ушли 440 дублей.
Функция СводкаОрганизаций(Знач Начало = '00010101', Знач Конец = '00010101') Экспорт

	Если НЕ ЗначениеЗаполнено(Начало) ИЛИ НЕ ЗначениеЗаполнено(Конец) Тогда
		Период = ПериодПоУмолчанию();
		Начало = ?(ЗначениеЗаполнено(Начало), Начало, Период.Начало);
		Конец = ?(ЗначениеЗаполнено(Конец), Конец, Период.Конец);
	КонецЕсли;

	СвРазрешена = ЭДО_Сервер.СвойствоОбъектов("ЭДО_РазрешенаОтправка");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	РТУ.Организация КАК Организация,
		|	КОЛИЧЕСТВО(РТУ.Ссылка) КАК Документов
		|ПОМЕСТИТЬ Отгрузки
		|ИЗ Документ.РеализацияТоваровУслуг КАК РТУ
		|ГДЕ РТУ.Проведен
		|	И РТУ.Дата МЕЖДУ &Начало И &Конец
		|СГРУППИРОВАТЬ ПО РТУ.Организация
		|;
		|ВЫБРАТЬ
		|	Орг.Ссылка КАК Организация,
		|	Орг.ИНН КАК ИНН,
		|	ЕСТЬNULL(Отгрузки.Документов, 0) КАК Документов,
		|	ВЫБОР КОГДА ВЫРАЗИТЬ(Разр.Значение КАК БУЛЕВО) = ИСТИНА
		|			ИЛИ ВЫРАЗИТЬ(Разр.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК РазрешенаОтправка
		|ИЗ Справочник.Организации КАК Орг
		|	ЛЕВОЕ СОЕДИНЕНИЕ Отгрузки КАК Отгрузки ПО Отгрузки.Организация = Орг.Ссылка
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Разр
		|		ПО ВЫРАЗИТЬ(Разр.Объект КАК Справочник.Организации) = Орг.Ссылка
		|			И Разр.Свойство = &СвРазрешена
		|ГДЕ НЕ Орг.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО Документов УБЫВ";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("СвРазрешена", ПустаяЕслиНеНайдено(СвРазрешена));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Состояние контура: то, что ломает отправку молча.
// Сюда идет только дешевое - без обращения к API. Проверка контура ходит в сеть
// и вызывается отдельной кнопкой.
Функция СводкаКонтура() Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Показатель", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Значение", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Тревога", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("Расшифровка", Новый ОписаниеТипов("Строка"));

	ДобавитьСтрокуКонтура(Результат, "Версия расширения", ВерсияРасширения(), Ложь);

	Недостающие = ЭДО_Сервер.НедостающиеНастройкиЭДО();
	ДобавитьСтрокуКонтура(Результат, "Настройки интеграции",
		?(Недостающие.Количество() = 0, "заполнены",
			"не заполнено: " + СтрСоединить(Недостающие, ", ")),
		Недостающие.Количество() > 0);

	// Сертификат свой у каждой организации, поэтому строка на каждую учетную запись.
	Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
		Заголовок = "Сертификат подписанта: " + Строка(УчетнаяЗапись.Организация);
		Попытка
			Сертификат = ЭДО_Сервер.СостояниеСертификатаПодписанта(Ложь, УчетнаяЗапись.Организация);
			Если Сертификат.Найден Тогда
				ДобавитьСтрокуКонтура(Результат, Заголовок,
					Формат(Сертификат.ДействителенПо, "ДЛФ=D") + ", осталось дней: "
						+ Формат(Сертификат.ДнейОсталось, "ЧН=0; ЧГ=0"),
					Сертификат.ДнейОсталось < 30);
			Иначе
				ДобавитьСтрокуКонтура(Результат, Заголовок, Сертификат.Описание, Истина);
			КонецЕсли;
		Исключение
			ДобавитьСтрокуКонтура(Результат, Заголовок,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
		КонецПопытки;
	КонецЦикла;

	// Строка на каждую учетную запись: у организаций разные сертификаты, и одна строка
	// на базу скрывает, у кого именно подписи нет.
	УчетныеЗаписи = ЭДО_Сервер.УчетныеЗаписиЭДО();
	Если УчетныеЗаписи.Количество() = 0 Тогда
		ДобавитьСтрокуКонтура(Результат, "Подпись на сервере",
			"нет ни одной учетной записи организации", Истина);
	КонецЕсли;
	Для Каждого УчетнаяЗапись Из УчетныеЗаписи Цикл
		Доступна = ЭДО_Сервер.ПодписьНаСервереДоступна(УчетнаяЗапись.Организация);
		ДобавитьСтрокуКонтура(Результат,
			"Подпись на сервере: " + Строка(УчетнаяЗапись.Организация),
			?(Доступна, "доступна", "недоступна"), НЕ Доступна);
	КонецЦикла;

	Пропущенные = Новый Массив;
	Для Каждого Имя Из ЭДО_Сервер.ОбязательныеСвойстваОбъектов() Цикл
		Свойство = ЭДО_Сервер.СвойствоОбъектов(Имя);
		Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
			Пропущенные.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	ДобавитьСтрокуКонтура(Результат, "Свойства объектов",
		?(Пропущенные.Количество() = 0, "заведены все",
			"не заведено: " + СтрСоединить(Пропущенные, ", ")),
		Пропущенные.Количество() > 0);

	Расхождения = СводкаРасхождений();
	Если Расхождения.Всего = 0 Тогда
		ДобавитьСтрокуКонтура(Результат, "Расходятся с отправленным", "нет", Ложь);
	Иначе
		ДобавитьСтрокуКонтура(Результат, "Расходятся с отправленным",
			Формат(Расхождения.Всего, "ЧГ=0") + " - подписано контрагентом "
				+ Формат(Расхождения.Подписано, "ЧГ=0")
				+ ", ещё не подписано " + Формат(Расхождения.НеПодписано, "ЧГ=0")
				+ ?(Расхождения.СменаПокупателя > 0, ", сменен покупатель у "
					+ Формат(Расхождения.СменаПокупателя, "ЧГ=0"), ""),
			Истина);
	КонецЕсли;

	ДобавитьСтрокиСторожаАдресов(Результат);
	ДобавитьСтрокуНашихАннулирований(Результат);

	Возврат Результат;

КонецФункции

// Строка контура по снимку сторожа наших ПОА. Срок ожидания ответа берется из настройки
// в момент показа, сторож его не знает.
Процедура ДобавитьСтрокуНашихАннулирований(Результат)

	Показатель = "Наши ПОА без ответа контрагента";
	Снимок = ЭДО_Сторожа.СнимокНашихАннулирований();
	Если Снимок = Неопределено Тогда
		ДобавитьСтрокуКонтура(Результат, Показатель, "сторож еще не запускался", Ложь);
		Возврат;
	КонецЕсли;

	ДнейОжидания = ДнейБезПодтвержденияПОА();
	Старых = ПросроченныеНашиАннулирования(Снимок, ДнейОжидания).Количество();
	ДобавитьСтрокуКонтура(Результат, Показатель,
		?(Старых = 0, "нет", Формат(Старых, "ЧН=0; ЧГ=0")) + " старше " + Формат(ДнейОжидания, "ЧН=0; ЧГ=0") + " дн."
			+ " (всего без ответа " + Формат(Снимок.Предложения.Количество(), "ЧН=0; ЧГ=0")
			+ ", прогон " + Формат(Снимок.ДатаПрогона, "ДФ='dd.MM.yyyy HH:mm'")
			+ ?(Снимок.Неполно, ", НЕПОЛНЫЙ", "") + ")",
		Старых > 0 ИЛИ Снимок.Неполно, "НашиАннулирования");

КонецПроцедуры

Функция ДнейБезПодтвержденияПОА()

	Возврат Макс(0, ЭДО_Сервер.НастройкаЭДО("ДнейБезПодтвержденияПОА"));

КонецФункции

// Строки снимка, чей ПОА ждет ответа дольше срока.
Функция ПросроченныеНашиАннулирования(Знач Снимок, Знач ДнейОжидания)

	Граница = ТекущаяДатаСеанса() - ДнейОжидания * 86400;
	Результат = Новый Массив;
	Для Каждого СтрокаСнимка Из Снимок.Предложения Цикл
		Если СтрокаСнимка.Создан < Граница Тогда
			Результат.Добавить(СтрокаСнимка);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Расшифровка строки контура "Наши ПОА без ответа контрагента": ПОА старше срока из настройки.
// Номер и дата - из базы, если документ найден, иначе из карточки оператора.
Функция ДокументыНашихАннулирований() Экспорт

	Результат = НоваяТаблицаДокументов();
	Результат.Колонки.Добавить("ДатаПОА", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("Причина", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("СтатусОператора", Новый ОписаниеТипов("Строка"));

	Снимок = ЭДО_Сторожа.СнимокНашихАннулирований();
	Если Снимок = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого СтрокаСнимка Из ПросроченныеНашиАннулирования(Снимок, ДнейБезПодтвержденияПОА()) Цикл
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСнимка, "Документ, Контрагент, Организация, Номер, Причина");
		НоваяСтрока.Дата = СтрокаСнимка.ДатаДок;
		НоваяСтрока.ДатаПОА = СтрокаСнимка.Создан;
		НоваяСтрока.ИдОператора = СтрокаСнимка.ИдНашего;
		НоваяСтрока.СтатусОператора = ?(СтрокаСнимка.Статус = "REJECTED", "отклонен", "нет ответа");
	КонецЦикла;

	ДополнитьДаннымиДокументов(Результат);
	Для Каждого СтрокаДокумента Из Результат Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаДокумента.Документ) Тогда
			СтрокаДокумента.Состояние = "Документ не найден в базе";
		КонецЕсли;
	КонецЦикла;

	Результат.Сортировать("ДатаПОА");

	Возврат Результат;

КонецФункции

// Строки контура по итогу сторожа адреса получателя. Сторож ходит к оператору раз в сутки
// и кладет снимок, поэтому рядом с числом показывается время прогона.
Процедура ДобавитьСтрокиСторожаАдресов(Результат)

	Снимок = ЭДО_Сторожа.СнимокСторожаАдресов();
	Если Снимок = Неопределено Тогда
		ДобавитьСтрокуКонтура(Результат, ПоказательАдресовПолучателя(), "сторож еще не запускался", Ложь);
		Возврат;
	КонецЕсли;

	Прогон = " (прогон " + Формат(Снимок.ДатаПрогона, "ДФ='dd.MM.yyyy HH:mm'")
		+ ?(Снимок.Неполно, ", НЕПОЛНЫЙ", "") + ")";

	Расхождений = Снимок.Расхождения.Количество();
	ДобавитьСтрокуКонтура(Результат, ПоказательАдресовПолучателя(),
		?(Расхождений = 0, "нет",
			Формат(Расхождений, "ЧН=0; ЧГ=0") + " на " + Формат(Снимок.Расхождения.Итог("Сумма"), "ЧДЦ=2; ЧН=0") + " руб.")
			+ Прогон,
		Расхождений > 0 ИЛИ Снимок.Неполно, "АдресПолучателя");

	БезАдреса = Снимок.БезАдреса;
	БезАдресаЭДО = БезАдреса.НайтиСтроки(Новый Структура("ЕстьАдресЭДО", Ложь)).Количество();
	БезАдресаКИ = БезАдреса.НайтиСтроки(Новый Структура("ЕстьАдресКИ", Ложь)).Количество();
	ДобавитьСтрокуКонтура(Результат, "Живая связь без адреса",
		?(БезАдреса.Количество() = 0, "нет",
			Формат(БезАдреса.Количество(), "ЧН=0; ЧГ=0") + ": без адреса ЭДО " + Формат(БезАдресаЭДО, "ЧН=0; ЧГ=0")
				+ ", без почтового " + Формат(БезАдресаКИ, "ЧН=0; ЧГ=0"))
			+ Прогон,
		БезАдреса.Количество() > 0, "БезАдреса");

КонецПроцедуры

Функция ПоказательАдресовПолучателя()
	Возврат "Ушли не на текущий адрес";
КонецФункции

// Расшифровка строки контура "Ушли не на текущий адрес": документы из снимка сторожа.
// Адреса, статус у оператора и сумма - на момент прогона, дата, номер и состояние ЭДО - из базы сейчас.
Функция ДокументыАдресовПолучателя() Экспорт

	Результат = НоваяТаблицаДокументов();
	Результат.Колонки.Добавить("ОтправленоНа", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ТекущийАдрес", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("СтатусОператора", Новый ОписаниеТипов("Строка"));

	Снимок = ЭДО_Сторожа.СнимокСторожаАдресов();
	Если Снимок = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого СтрокаСнимка Из Снимок.Расхождения Цикл
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСнимка, "Документ, Контрагент, ОтправленоНа, ТекущийАдрес, Сумма");
		НоваяСтрока.ИдОператора = СтрокаСнимка.Ид;
		НоваяСтрока.СтатусОператора = СтрокаСнимка.Статус;
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.ТекущийАдрес) Тогда
			НоваяСтрока.ТекущийАдрес = "адреса нет";
		КонецЕсли;
	КонецЦикла;

	ДополнитьДаннымиДокументов(Результат);
	Для Каждого СтрокаДокумента Из Результат Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаДокумента.Состояние) Тогда
			СтрокаДокумента.Состояние = "Не обработан";
		КонецЕсли;
	КонецЦикла;

	Результат.Сортировать("Сумма Убыв");

	Возврат Результат;

КонецФункции

// Дата, номер, организация и состояние ЭДО из базы для строк с заполненным документом.
// Документы разных видов: накладные, корректировки, акты сверки - запрос на каждый вид.
Процедура ДополнитьДаннымиДокументов(Результат)

	ПоВидам = Новый Соответствие;
	Для Каждого СтрокаДокумента Из Результат Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(СтрокаДокумента.Документ));
		Если ОбъектМетаданных = Неопределено ИЛИ НЕ Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		Ссылки = ПоВидам.Получить(ОбъектМетаданных.Имя);
		Если Ссылки = Неопределено Тогда
			Ссылки = Новый Массив;
			ПоВидам.Вставить(ОбъектМетаданных.Имя, Ссылки);
		КонецЕсли;
		Ссылки.Добавить(СтрокаДокумента.Документ);
	КонецЦикла;

	ДанныеДокументов = Новый Соответствие;
	Если ПоВидам.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапросаДанныхДокументов(ПоВидам);
		Запрос.УстановитьПараметр("СвСостояние", ПустаяЕслиНеНайдено(ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние")));
		Для Каждого Вид Из ПоВидам Цикл
			Запрос.УстановитьПараметр("Ссылки" + Вид.Ключ, Вид.Значение);
		КонецЦикла;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ДанныеДокументов.Вставить(Выборка.Документ,
				Новый Структура("Дата, Номер, Организация, Состояние",
					Выборка.Дата, Выборка.Номер, Выборка.Организация, Выборка.Состояние));
		КонецЦикла;
	КонецЕсли;

	Для Каждого СтрокаДокумента Из Результат Цикл
		Данные = ДанныеДокументов.Получить(СтрокаДокумента.Документ);
		Если Данные <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаДокумента, Данные);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Дата, номер, организация и состояние ЭДО документов разных видов одним запросом.
// ПоВидам - Соответствие: ключ - имя вида документа, значение - массив ссылок в параметре "Ссылки<Имя вида>".
Функция ТекстЗапросаДанныхДокументов(Знач ПоВидам)

	Части = Новый Массив;
	Для Каждого Вид Из ПоВидам Цикл
		ЕстьОрганизация = Метаданные.Документы[Вид.Ключ].Реквизиты.Найти("Организация") <> Неопределено;
		Части.Добавить(
		"ВЫБРАТЬ
		|	Док.Ссылка КАК Документ,
		|	Док.Дата КАК Дата,
		|	Док.Номер КАК Номер,
		|	" + ?(ЕстьОрганизация, "Док.Организация", "НЕОПРЕДЕЛЕНО") + " КАК Организация,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)), """") КАК Состояние
		|ИЗ
		|	Документ." + Вид.Ключ + " КАК Док
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Сост
		|		ПО Сост.Объект = Док.Ссылка
		|			И Сост.Свойство = &СвСостояние
		|ГДЕ
		|	Док.Ссылка В (&Ссылки" + Вид.Ключ + ")");
	КонецЦикла;

	Возврат СтрСоединить(Части, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);

КонецФункции

// Расшифровка строки контура "Живая связь без адреса": контрагенты из снимка сторожа.
// Возврат: ТаблицаЗначений (Контрагент, СтатусСвязи, НетАдреса).
Функция КонтрагентыБезАдреса() Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Контрагент");
	Результат.Колонки.Добавить("СтатусСвязи", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("НетАдреса", Новый ОписаниеТипов("Строка"));

	Снимок = ЭДО_Сторожа.СнимокСторожаАдресов();
	Если Снимок = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого СтрокаСнимка Из Снимок.БезАдреса Цикл
		НетАдресов = Новый Массив;
		Если НЕ СтрокаСнимка.ЕстьАдресЭДО Тогда
			НетАдресов.Добавить("адреса ЭДО");
		КонецЕсли;
		Если НЕ СтрокаСнимка.ЕстьАдресКИ Тогда
			НетАдресов.Добавить("почтового адреса");
		КонецЕсли;

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Контрагент = СтрокаСнимка.Контрагент;
		НоваяСтрока.СтатусСвязи = СтрокаСнимка.Связь;
		НоваяСтрока.НетАдреса = "нет " + СтрСоединить(НетАдресов, " и ");
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сколько документов разошлись с тем, что ушло контрагенту.
//
// Разделение на подписанные и неподписанные - не украшение: это РАЗНАЯ работа.
// Неподписанный лечится переотправкой сегодня же, подписанный - только двусторонним
// аннулированием, которое контрагент подтверждает неделями (замер по 14 аннулированиям
// кодов маркировки: на девятые сутки подтверждено 6). Одним числом пользоваться нельзя.
//
// Подписанность берётся из ЭДО_Состояние по тексту "Принят", а НЕ из ЭДО_КодСостояния:
// замер 12.09.2026 показал, что код состояния в боевой базе практически пуст
// (6 954 пустых значения и одно "40"), и классификация по нему дала бы ноль подписанных
// при живых 4 101.
//
// Признак расхождения ставит сторож, здесь только считаем - витрина не должна ходить
// к оператору и не должна зависеть от его доступности.
// Смена покупателя считается отдельно: такой документ новому покупателю не уходил вовсе.
// Возврат: Структура (Всего, Подписано, НеПодписано, СменаПокупателя).
Функция СводкаРасхождений() Экспорт

	Результат = Новый Структура("Всего, Подписано, НеПодписано, СменаПокупателя", 0, 0, 0, 0);

	СвойствоРасхождение = ЭДО_Сервер.СвойствоОбъектов("ЭДО_РасхождениеСОтправленным");
	СвойствоСостояние = ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние");
	Если СвойствоРасхождение = Неопределено ИЛИ СвойствоРасхождение.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СвРасхождение", СвойствоРасхождение);
	Запрос.УстановитьПараметр("СвСостояние", СвойствоСостояние);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Расх.Объект КАК Объект,
	|	ВЫРАЗИТЬ(Расх.Значение КАК СТРОКА(50)) КАК Расхождение,
	|	ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)) КАК Состояние
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК Расх
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Сост
	|		ПО Сост.Объект = Расх.Объект
	|			И Сост.Свойство = &СвСостояние
	|ГДЕ
	|	Расх.Свойство = &СвРасхождение
	|	И ВЫРАЗИТЬ(Расх.Значение КАК СТРОКА(50)) <> """"";
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Состояние = ?(Выборка.Состояние = NULL, "", СокрЛП(Строка(Выборка.Состояние)));
		Результат.Всего = Результат.Всего + 1;
		Если СтрНачинаетсяС(СокрЛП(Строка(Выборка.Расхождение)), ЭДО_Сторожа.ПрефиксСменыПокупателя()) Тогда
			Результат.СменаПокупателя = Результат.СменаПокупателя + 1;
		КонецЕсли;
		Если ВРег(Состояние) = ВРег("Принят") Тогда
			Результат.Подписано = Результат.Подписано + 1;
		Иначе
			Результат.НеПодписано = Результат.НеПодписано + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Версия расширения из его метаданных.
Функция ВерсияРасширения() Экспорт

	Попытка
		Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
			Если Расширение.Имя = "ЦентрУправленияЭДО" Тогда
				Возврат Расширение.Версия;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат "не определена";
	КонецПопытки;

	Возврат "не определена";

КонецФункции

Процедура ДобавитьСтрокуКонтура(Таблица, Знач Показатель, Знач Значение, Знач Тревога, Знач Расшифровка = "")

	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Показатель = Показатель;
	НоваяСтрока.Значение = Строка(Значение);
	НоваяСтрока.Тревога = Тревога;
	НоваяСтрока.Расшифровка = Расшифровка;

КонецПроцедуры

// НайтиПоНаименованию возвращает ПУСТУЮ ССЫЛКУ, а не Неопределено. Соединение по пустому
// свойству находит чужие записи - документ получил бы чужое значение (грабля ядра 24.08.2026).
Функция ПустаяЕслиНеНайдено(Знач Свойство)

	Если Свойство = Неопределено Тогда
		Возврат ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка();
	КонецЕсли;

	Возврат Свойство;

КонецФункции
