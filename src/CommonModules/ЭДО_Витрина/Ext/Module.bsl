////////////////////////////////////////////////////////////////////////////////
// Витрина центра управления ЭДО: быстрые показатели, считаемые ПО БАЗЕ.
//
// Здесь нет ни одного обращения к API. Все, что требует обхода оператора
// (молчащие дольше порога, расхождения с ГИС МТ, входящие, состояния связей),
// считают сторожа минутами и кладут снимком - витрина такой показатель только читает.
// Иначе форма открывалась бы полминуты и упиралась в токен Keycloak.
//
// Источник быстрых показателей - колонка ЭДО_Состояние, которую уже ведет ядро
// (ЭДО_Сервер.ОбновитьПричиныНеотправки и регламент сверки статусов). Витрина ее
// ГРУППИРУЕТ и не повторяет логику отбора: два разных запроса о том, что уходит,
// разошлись бы молча, и человек увидел бы цифру, не совпадающую с очередью.
////////////////////////////////////////////////////////////////////////////////

// Группы состояний. Порядок задает и порядок вывода на форме: сверху то,
// что требует действия от нас, снизу то, где делать нечего.
Функция ГруппыСостояний() Экспорт

	Группы = Новый Массив;
	Группы.Добавить("Застряло у нас");
	Группы.Добавить("Требует решения");
	Группы.Добавить("Ждем контрагента");
	Группы.Добавить("Не взято в очередь");
	Группы.Добавить("Завершено");
	Группы.Добавить("Прочее");

	Возврат Группы;

КонецФункции

// К какой группе отнести текст колонки.
// Разложение по группам не косметика: действие у групп разное. "Застряло у нас" разбирает
// администратор, "Требует решения" - бухгалтер, "Ждем контрагента" не требует ничего,
// а "Не взято в очередь" почти всегда чинится данными. Одна общая цифра
// "незавершенных" не подсказывает, кому идти работать.
Функция ГруппаСостояния(Знач Текст) Экспорт

	Значение = СокрЛП(Текст);
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "Прочее";
	КонецЕсли;

	Если СостоянияЗастрялоУНас().Найти(Значение) <> Неопределено Тогда
		Возврат "Застряло у нас";
	КонецЕсли;
	Если СостоянияТребуетРешения().Найти(Значение) <> Неопределено Тогда
		Возврат "Требует решения";
	КонецЕсли;
	Если СостоянияЖдемКонтрагента().Найти(Значение) <> Неопределено Тогда
		Возврат "Ждем контрагента";
	КонецЕсли;
	Если СостоянияЗавершено().Найти(Значение) <> Неопределено Тогда
		Возврат "Завершено";
	КонецЕсли;
	Если СостоянияНеВзятоВОчередь().Найти(Значение) <> Неопределено Тогда
		Возврат "Не взято в очередь";
	КонецЕсли;

	// Незнакомый статус связи ядро печатает с префиксом и показывает как есть.
	Если Найти(Значение, ЭДО_Сервер.ПрефиксПричиныСвязи()) = 1 Тогда
		Возврат "Не взято в очередь";
	КонецЕсли;

	Возврат "Прочее";

КонецФункции

// Документ взят оператором, а дальше ход прервался. Это наша работа, а не контрагента.
Функция СостоянияЗастрялоУНас() Экспорт

	Тексты = Новый Массив;
	Тексты.Добавить("Ошибка: не отправлен");
	Тексты.Добавить("Взят в отправку, прогон не завершен");
	Тексты.Добавить("Взят в отправку, прогон не завершён");
	Тексты.Добавить("Состояние у оператора неизвестно");

	Возврат Тексты;

КонецФункции

// Ответ контрагента получен, и он требует решения человека.
Функция СостоянияТребуетРешения() Экспорт

	Тексты = Новый Массив;
	Тексты.Добавить("Отказ контрагента");
	Тексты.Добавить("Запрошено аннулирование");

	Возврат Тексты;

КонецФункции

// Документ у контрагента, делать нечего - только ждать.
Функция СостоянияЖдемКонтрагента() Экспорт

	Тексты = Новый Массив;
	Тексты.Добавить("Отправляется");
	Тексты.Добавить("Отправлен");
	Тексты.Добавить("Доставлен");

	Возврат Тексты;

КонецФункции

// Цикл документа закончен либо отправка по нему не нужна.
Функция СостоянияЗавершено() Экспорт

	Тексты = Новый Массив;
	Тексты.Добавить("Принят");
	Тексты.Добавить("Аннулирован");
	Тексты.Добавить(ЭДО_Сервер.ТекстСтатусаОтправкаНеТребуется());
	Тексты.Добавить("Отправлен через СБИС");
	Тексты.Добавить("Уже отправлен этому получателю");

	Возврат Тексты;

КонецФункции

// Причины, по которым документ не попал в очередь. Набор берется у ядра, а не
// переписывается здесь: расхождение в одну букву дало бы группу "Прочее",
// растущую молча при каждой правке формулировки.
Функция СостоянияНеВзятоВОчередь() Экспорт

	Тексты = Новый Массив;
	Для Каждого Текст Из ЭДО_Сервер.ТекстыПричинНеотправки() Цикл
		Если Текст = "Отправляется" Тогда
			Продолжить;   // это ход отправки, а не причина простоя
		КонецЕсли;
		Если Текст = "Отправлен через СБИС" Тогда
			Продолжить;   // ушел другим каналом, работа по нему закончена
		КонецЕсли;
		Тексты.Добавить(Текст);
	КонецЦикла;
	Для Каждого Текст Из ЭДО_Сервер.УстаревшиеТекстыПричин() Цикл
		Тексты.Добавить(Текст);
	КонецЦикла;

	Возврат Тексты;

КонецФункции

// Период по умолчанию - текущий год.
// Правило оператора от 25.08.2026: номер документа уникален только в пределах года,
// и работаем мы за текущий год.
Функция ПериодПоУмолчанию() Экспорт

	Период = Новый Структура("Начало, Конец");
	Период.Начало = НачалоГода(ТекущаяДата());
	Период.Конец = КонецДня(ТекущаяДата());

	Возврат Период;

КонецФункции

// Сводка исходящих: состояние, группа, количество, сумма.
// Возврат: ТаблицаЗначений с колонками Группа, Состояние, Количество, Сумма.
Функция СводкаИсходящих(Знач Начало = '00010101', Знач Конец = '00010101', Знач Организация = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(Начало) ИЛИ НЕ ЗначениеЗаполнено(Конец) Тогда
		Период = ПериодПоУмолчанию();
		Начало = ?(ЗначениеЗаполнено(Начало), Начало, Период.Начало);
		Конец = ?(ЗначениеЗаполнено(Конец), Конец, Период.Конец);
	КонецЕсли;

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Группа", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));

	СвСостояние = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_Состояние");
	Если СвСостояние = Неопределено ИЛИ СвСостояние.Пустая() Тогда
		Возврат Результат;   // свойства нет - показывать нечего, но и падать незачем
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)), """") КАК Состояние,
		|	КОЛИЧЕСТВО(РТУ.Ссылка) КАК Количество,
		|	СУММА(РТУ.СуммаДокумента) КАК Сумма
		|ИЗ Документ.РеализацияТоваровУслуг КАК РТУ
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Сост
		|		ПО Сост.Объект = РТУ.Ссылка И Сост.Свойство = &СвСостояние
		|ГДЕ РТУ.Проведен
		|	И РТУ.Дата МЕЖДУ &Начало И &Конец
		|	И (&БезОтбораОрганизации ИЛИ РТУ.Организация = &Организация)
		|СГРУППИРОВАТЬ ПО ЕСТЬNULL(ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)), """")";
	Запрос.УстановитьПараметр("СвСостояние", СвСостояние);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("БезОтбораОрганизации", НЕ ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("Организация", ?(ЗначениеЗаполнено(Организация), Организация,
		Справочники.Организации.ПустаяСсылка()));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Состояние = ?(ЗначениеЗаполнено(Выборка.Состояние), Выборка.Состояние, "Не обработан");
		НоваяСтрока.Группа = ГруппаСостояния(Выборка.Состояние);
		НоваяСтрока.Количество = Выборка.Количество;
		НоваяСтрока.Сумма = ?(Выборка.Сумма = NULL, 0, Выборка.Сумма);
	КонецЦикла;

	Результат.Сортировать("Группа, Количество Убыв");

	Возврат Результат;

КонецФункции

// Итоги по группам для верхнего блока формы.
// Возврат: ТаблицаЗначений с колонками Группа, Количество, Сумма.
Функция ИтогиПоГруппам(Знач Сводка) Экспорт

	Итоги = Новый ТаблицаЗначений;
	Итоги.Колонки.Добавить("Группа", Новый ОписаниеТипов("Строка"));
	Итоги.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Итоги.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));

	Для Каждого Имя Из ГруппыСостояний() Цикл
		НоваяСтрока = Итоги.Добавить();
		НоваяСтрока.Группа = Имя;
	КонецЦикла;

	Для Каждого СтрокаСводки Из Сводка Цикл
		Найденная = Итоги.Найти(СтрокаСводки.Группа, "Группа");
		Если Найденная = Неопределено Тогда
			Найденная = Итоги.Добавить();
			Найденная.Группа = СтрокаСводки.Группа;
		КонецЕсли;
		Найденная.Количество = Найденная.Количество + СтрокаСводки.Количество;
		Найденная.Сумма = Найденная.Сумма + СтрокаСводки.Сумма;
	КонецЦикла;

	Возврат Итоги;

КонецФункции

// Документы в заданном состоянии - расшифровка по щелчку.
Функция ДокументыПоСостоянию(Знач Состояние, Знач Начало = '00010101', Знач Конец = '00010101',
	Знач Организация = Неопределено, Знач Лимит = 1000) Экспорт

	Состояния = Новый Массив;
	Состояния.Добавить(Состояние);

	Возврат ДокументыПоСостояниям(Состояния, Начало, Конец, Организация, Лимит);

КонецФункции

// Документы в любом из перечисленных состояний. Щелчок по группе на дашборде открывает
// все ее состояния разом, поэтому отбор принимает массив, а не одно значение.
// Лимит намеренный: список на тысячи строк человеку бесполезен, а форму он подвесит.
Функция ДокументыПоСостояниям(Знач Состояния, Знач Начало = '00010101', Знач Конец = '00010101',
	Знач Организация = Неопределено, Знач Лимит = 1000) Экспорт

	Если НЕ ЗначениеЗаполнено(Начало) ИЛИ НЕ ЗначениеЗаполнено(Конец) Тогда
		Период = ПериодПоУмолчанию();
		Начало = ?(ЗначениеЗаполнено(Начало), Начало, Период.Начало);
		Конец = ?(ЗначениеЗаполнено(Конец), Конец, Период.Конец);
	КонецЕсли;

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Документ");
	Результат.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Контрагент");
	Результат.Колонки.Добавить("Организация");
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));

	СвСостояние = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_Состояние");
	Если СвСостояние = Неопределено ИЛИ СвСостояние.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;

	// "Не обработан" - это наша подпись для пустого значения, в базе его нет.
	ИскатьПустое = Ложь;
	Искомые = Новый Массив;
	Для Каждого Состояние Из Состояния Цикл
		Если СокрЛП(Состояние) = "Не обработан" ИЛИ НЕ ЗначениеЗаполнено(Состояние) Тогда
			ИскатьПустое = Истина;
		Иначе
			Искомые.Добавить(СокрЛП(Состояние));
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
		|	РТУ.Ссылка КАК Документ,
		|	РТУ.Дата КАК Дата,
		|	РТУ.Номер КАК Номер,
		|	РТУ.Контрагент КАК Контрагент,
		|	РТУ.Организация КАК Организация,
		|	РТУ.СуммаДокумента КАК Сумма,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)), """") КАК Состояние
		|ИЗ Документ.РеализацияТоваровУслуг КАК РТУ
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Сост
		|		ПО Сост.Объект = РТУ.Ссылка И Сост.Свойство = &СвСостояние
		|ГДЕ РТУ.Проведен
		|	И РТУ.Дата МЕЖДУ &Начало И &Конец
		|	И (&БезОтбораОрганизации ИЛИ РТУ.Организация = &Организация)
		|	И ((&ИскатьПустое И ЕСТЬNULL(ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)), """") = """")
		|		ИЛИ ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)) В (&Искомые))
		|УПОРЯДОЧИТЬ ПО Дата УБЫВ";
	Запрос.УстановитьПараметр("СвСостояние", СвСостояние);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("ИскатьПустое", ИскатьПустое);
	Запрос.УстановитьПараметр("Искомые", Искомые);
	Запрос.УстановитьПараметр("БезОтбораОрганизации", НЕ ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("Организация", ?(ЗначениеЗаполнено(Организация), Организация,
		Справочники.Организации.ПустаяСсылка()));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.Состояние) Тогда
			НоваяСтрока.Состояние = "Не обработан";
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сводка по контрагентам, у которых за период были проведенные отгрузки.
//
// Считаем именно по активным, а не по всему справочнику: контрагентов тысячи, и почти все
// давно не отгружаются - счетчик "без адреса ЭДО" по всему справочнику показал бы тысячи
// и не значил бы ничего.
// Возврат: ТаблицаЗначений с колонками Признак, Количество.
Функция СводкаКонтрагентов(Знач Начало = '00010101', Знач Конец = '00010101') Экспорт

	Данные = ДанныеКонтрагентов(Начало, Конец);

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Признак", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));

	Для Каждого Имя Из ПризнакиКонтрагентов() Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Признак = Имя;
	КонецЦикла;

	Для Каждого СтрокаДанных Из Данные Цикл
		Для Каждого Имя Из ПризнакиКонтрагента(СтрокаДанных) Цикл
			Найденная = Результат.Найти(Имя, "Признак");
			Если Найденная = Неопределено Тогда
				Найденная = Результат.Добавить();
				Найденная.Признак = Имя;
			КонецЕсли;
			Найденная.Количество = Найденная.Количество + 1;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Порядок признаков на форме. Сверху то, что мешает отправке прямо сейчас.
Функция ПризнакиКонтрагентов() Экспорт

	Имена = Новый Массив;
	Имена.Добавить("Всего отгружали за период");
	Имена.Добавить("Отправка на паузе");
	Имена.Добавить("Нет адреса ЭДО");
	Имена.Добавить("Адрес есть, связи нет");
	Имена.Добавить("Ждем подтверждения приглашения");
	Имена.Добавить("Связь разорвана");
	Имена.Добавить("Адрес не закреплен");
	Имена.Добавить("Обмен налажен");

	Возврат Имена;

КонецФункции

// Какие признаки подходят строке данных о контрагенте. Признаки не исключают друг друга:
// контрагент на паузе может быть и без закрепленного адреса, и это разные работы.
Функция ПризнакиКонтрагента(Знач Данные) Экспорт

	Имена = Новый Массив;
	Имена.Добавить("Всего отгружали за период");

	Если Данные.НаПаузе Тогда
		Имена.Добавить("Отправка на паузе");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Данные.Адрес) Тогда
		Имена.Добавить("Нет адреса ЭДО");
	Иначе
		Статус = ВРег(СокрЛП(Данные.СтатусСвязи));
		Если Статус = "ESTABLISHED" Тогда
			Имена.Добавить("Обмен налажен");
		ИначеЕсли Статус = "INVITED" ИЛИ Статус = "SENT" Тогда
			Имена.Добавить("Ждем подтверждения приглашения");
		ИначеЕсли Статус = "REJECTED" ИЛИ Статус = "REVOKED" Тогда
			Имена.Добавить("Связь разорвана");
		Иначе
			Имена.Добавить("Адрес есть, связи нет");
		КонецЕсли;
		Если НЕ Данные.АдресЗакреплен Тогда
			Имена.Добавить("Адрес не закреплен");
		КонецЕсли;
	КонецЕсли;

	Возврат Имена;

КонецФункции

// Контрагенты по признаку - расшифровка по щелчку.
Функция КонтрагентыПоПризнаку(Знач Признак, Знач Начало = '00010101', Знач Конец = '00010101') Экспорт

	Данные = ДанныеКонтрагентов(Начало, Конец);

	Результат = Данные.СкопироватьКолонки();
	Для Каждого СтрокаДанных Из Данные Цикл
		Если ПризнакиКонтрагента(СтрокаДанных).Найти(Признак) <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), СтрокаДанных);
		КонецЕсли;
	КонецЦикла;

	Результат.Сортировать("Документов Убыв");

	Возврат Результат;

КонецФункции

// Данные о контрагентах с отгрузками за период: адрес, связь, пауза, закрепление.
Функция ДанныеКонтрагентов(Знач Начало = '00010101', Знач Конец = '00010101') Экспорт

	Если НЕ ЗначениеЗаполнено(Начало) ИЛИ НЕ ЗначениеЗаполнено(Конец) Тогда
		Период = ПериодПоУмолчанию();
		Начало = ?(ЗначениеЗаполнено(Начало), Начало, Период.Начало);
		Конец = ?(ЗначениеЗаполнено(Конец), Конец, Период.Конец);
	КонецЕсли;

	СвАдрес = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_АдресКонтрагента");
	СвСвязь = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_СтатусСвязи");
	СвПауза = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_ОтправкаПриостановлена");
	СвПричина = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_ПричинаПаузы");
	СвЗакреп = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_АдресЗакреплён");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	РТУ.Контрагент КАК Контрагент,
		|	КОЛИЧЕСТВО(РТУ.Ссылка) КАК Документов,
		|	СУММА(РТУ.СуммаДокумента) КАК Сумма
		|ПОМЕСТИТЬ Активные
		|ИЗ Документ.РеализацияТоваровУслуг КАК РТУ
		|ГДЕ РТУ.Проведен
		|	И РТУ.Дата МЕЖДУ &Начало И &Конец
		|СГРУППИРОВАТЬ ПО РТУ.Контрагент
		|;
		|ВЫБРАТЬ
		|	Активные.Контрагент КАК Контрагент,
		|	Активные.Документов КАК Документов,
		|	Активные.Сумма КАК Сумма,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Адрес.Значение КАК СТРОКА(50)), """") КАК Адрес,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Связь.Значение КАК СТРОКА(50)), """") КАК СтатусСвязи,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Причина.Значение КАК СТРОКА(50)), """") КАК ПричинаПаузы,
		|	ВЫБОР КОГДА ВЫРАЗИТЬ(Пауза.Значение КАК БУЛЕВО) = ИСТИНА
		|			ИЛИ ВЫРАЗИТЬ(Пауза.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК НаПаузе,
		|	ВЫБОР КОГДА ВЫРАЗИТЬ(Закреп.Значение КАК БУЛЕВО) = ИСТИНА
		|			ИЛИ ВЫРАЗИТЬ(Закреп.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК АдресЗакреплен
		|ИЗ Активные КАК Активные
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Адрес
		|		ПО ВЫРАЗИТЬ(Адрес.Объект КАК Справочник.Контрагенты) = Активные.Контрагент
		|			И Адрес.Свойство = &СвАдрес
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Связь
		|		ПО ВЫРАЗИТЬ(Связь.Объект КАК Справочник.Контрагенты) = Активные.Контрагент
		|			И Связь.Свойство = &СвСвязь
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Пауза
		|		ПО ВЫРАЗИТЬ(Пауза.Объект КАК Справочник.Контрагенты) = Активные.Контрагент
		|			И Пауза.Свойство = &СвПауза
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Причина
		|		ПО ВЫРАЗИТЬ(Причина.Объект КАК Справочник.Контрагенты) = Активные.Контрагент
		|			И Причина.Свойство = &СвПричина
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Закреп
		|		ПО ВЫРАЗИТЬ(Закреп.Объект КАК Справочник.Контрагенты) = Активные.Контрагент
		|			И Закреп.Свойство = &СвЗакреп";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("СвАдрес", ПустаяЕслиНеНайдено(СвАдрес));
	Запрос.УстановитьПараметр("СвСвязь", ПустаяЕслиНеНайдено(СвСвязь));
	Запрос.УстановитьПараметр("СвПауза", ПустаяЕслиНеНайдено(СвПауза));
	Запрос.УстановитьПараметр("СвПричина", ПустаяЕслиНеНайдено(СвПричина));
	Запрос.УстановитьПараметр("СвЗакреп", ПустаяЕслиНеНайдено(СвЗакреп));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Организации базы и разрешение отправки.
// Умолчание - запрет: организация без флага не отправляет ничего. Витрина обязана это
// показывать, потому что "очередь пуста" и "организации не разрешена отправка" со стороны
// выглядят одинаково - именно так в moroz ушли 440 дублей.
Функция СводкаОрганизаций(Знач Начало = '00010101', Знач Конец = '00010101') Экспорт

	Если НЕ ЗначениеЗаполнено(Начало) ИЛИ НЕ ЗначениеЗаполнено(Конец) Тогда
		Период = ПериодПоУмолчанию();
		Начало = ?(ЗначениеЗаполнено(Начало), Начало, Период.Начало);
		Конец = ?(ЗначениеЗаполнено(Конец), Конец, Период.Конец);
	КонецЕсли;

	СвРазрешена = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_РазрешенаОтправка");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	РТУ.Организация КАК Организация,
		|	КОЛИЧЕСТВО(РТУ.Ссылка) КАК Документов
		|ПОМЕСТИТЬ Отгрузки
		|ИЗ Документ.РеализацияТоваровУслуг КАК РТУ
		|ГДЕ РТУ.Проведен
		|	И РТУ.Дата МЕЖДУ &Начало И &Конец
		|СГРУППИРОВАТЬ ПО РТУ.Организация
		|;
		|ВЫБРАТЬ
		|	Орг.Ссылка КАК Организация,
		|	Орг.ИНН КАК ИНН,
		|	ЕСТЬNULL(Отгрузки.Документов, 0) КАК Документов,
		|	ВЫБОР КОГДА ВЫРАЗИТЬ(Разр.Значение КАК БУЛЕВО) = ИСТИНА
		|			ИЛИ ВЫРАЗИТЬ(Разр.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК РазрешенаОтправка
		|ИЗ Справочник.Организации КАК Орг
		|	ЛЕВОЕ СОЕДИНЕНИЕ Отгрузки КАК Отгрузки ПО Отгрузки.Организация = Орг.Ссылка
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Разр
		|		ПО ВЫРАЗИТЬ(Разр.Объект КАК Справочник.Организации) = Орг.Ссылка
		|			И Разр.Свойство = &СвРазрешена
		|ГДЕ НЕ Орг.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО Документов УБЫВ";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("СвРазрешена", ПустаяЕслиНеНайдено(СвРазрешена));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Состояние контура: то, что ломает отправку молча.
// Сюда идет только дешевое - без обращения к API. Проверка контура ходит в сеть
// и вызывается отдельной кнопкой.
Функция СводкаКонтура() Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Показатель", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Значение", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Тревога", Новый ОписаниеТипов("Булево"));

	ДобавитьСтрокуКонтура(Результат, "Версия расширения", ВерсияРасширения(), Ложь);

	Недостающие = ЭДО_Сервер.НедостающиеНастройкиЭДО();
	ДобавитьСтрокуКонтура(Результат, "Настройки интеграции",
		?(Недостающие.Количество() = 0, "заполнены",
			"не заполнено: " + СтрСоединить(Недостающие, ", ")),
		Недостающие.Количество() > 0);

	Попытка
		Сертификат = ЭДО_Сервер.СостояниеСертификатаПодписанта(Ложь);
		Если Сертификат.Свойство("ДатаОкончания") И ЗначениеЗаполнено(Сертификат.ДатаОкончания) Тогда
			Осталось = Цел((НачалоДня(Сертификат.ДатаОкончания) - НачалоДня(ТекущаяДата())) / 86400);
			ДобавитьСтрокуКонтура(Результат, "Сертификат подписанта",
				Формат(Сертификат.ДатаОкончания, "ДЛФ=D") + ", осталось дней: " + Формат(Осталось, "ЧГ=0"),
				Осталось < 30);
		Иначе
			ДобавитьСтрокуКонтура(Результат, "Сертификат подписанта", "не определен", Истина);
		КонецЕсли;
	Исключение
		ДобавитьСтрокуКонтура(Результат, "Сертификат подписанта",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
	КонецПопытки;

	ДобавитьСтрокуКонтура(Результат, "Подпись на сервере",
		?(ЭДО_Сервер.ПодписьНаСервереДоступна(), "доступна", "недоступна"),
		НЕ ЭДО_Сервер.ПодписьНаСервереДоступна());

	Пропущенные = Новый Массив;
	Для Каждого Имя Из ЭДО_Сервер.ОбязательныеСвойстваОбъектов() Цикл
		Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(Имя);
		Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
			Пропущенные.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	ДобавитьСтрокуКонтура(Результат, "Свойства объектов",
		?(Пропущенные.Количество() = 0, "заведены все",
			"не заведено: " + СтрСоединить(Пропущенные, ", ")),
		Пропущенные.Количество() > 0);

	Возврат Результат;

КонецФункции

// Версия расширения из его метаданных.
Функция ВерсияРасширения() Экспорт

	Попытка
		Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
			Если Расширение.Имя = "ПлатформаЭДО" Тогда
				Возврат Расширение.Версия;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат "не определена";
	КонецПопытки;

	Возврат "не определена";

КонецФункции

Процедура ДобавитьСтрокуКонтура(Таблица, Знач Показатель, Знач Значение, Знач Тревога)

	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Показатель = Показатель;
	НоваяСтрока.Значение = Строка(Значение);
	НоваяСтрока.Тревога = Тревога;

КонецПроцедуры

// НайтиПоНаименованию возвращает ПУСТУЮ ССЫЛКУ, а не Неопределено. Соединение по пустому
// свойству находит чужие записи - документ получил бы чужое значение (грабля ядра 24.08.2026).
Функция ПустаяЕслиНеНайдено(Знач Свойство)

	Если Свойство = Неопределено Тогда
		Возврат ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка();
	КонецЕсли;

	Возврат Свойство;

КонецФункции
