			ИначеЕсли С.Статус = "ESTABLISHED" Тогда
				Est = Est + 1;
			ИначеЕсли С.Статус = "BROKEN" Тогда
				Brk = Brk + 1;
				Если СписокBroken.Количество() < 20 Тогда
					СписокBroken.Добавить(А + " (" + Формат(С.Обновлён, "ДФ=dd.MM HH:mm") + ")");
				КонецЕсли;
			Иначе
				Проч = Проч + 1;
