////////////////////////////////////////////////////////////////////////////////
// Сторожа ЭДО: наблюдение за тем, чего из самой отправки не видно.
// Каждый сторож судится по строке-своду в журнале регистрации, а не по коду возврата.
////////////////////////////////////////////////////////////////////////////////

// Сторож "доставлено, но не принято": УПД, по которым контрагент ничего не сделал, -
// карточка у оператора живет дольше порога, а титула покупателя (ACCEPTED) нет.
// Порог считается от создания карточки у оператора, а не от даты накладной: документ мог
// пролежать в очереди. Каналы без обратной связи (2LT, 2VO) молчат по своей природе:
// их не перечисляем, а считаем одной строкой.
Функция ВыполнитьСторожНеПринятых(Знач Организация = Неопределено) Экспорт

	Если Организация = Неопределено И ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Своды = Новый Массив;
		Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
			Своды.Добавить(ВыполнитьСторожНеПринятых(УчетнаяЗапись.Организация));
		КонецЦикла;
		Возврат СтрСоединить(Своды, Символы.ПС);
	КонецЕсли;

	Попытка
		ПорогДней   = 14;
		ГлубинаДней = 45;   // окно обхода: все, что старше, разбирать уже поздно, а обход дорожает
		ПоказатьМакс = 40;  // потолок списка в логе, чтобы одна авария не залила его целиком

		Финалы = Новый Соответствие;   // статусы, после которых ждать нечего
		Финалы.Вставить("ACCEPTED", Истина);
		Финалы.Вставить("REJECTED", Истина);
		Финалы.Вставить("CANCELLED", Истина);
		Финалы.Вставить("SENDING_FAILED", Истина);
		Финалы.Вставить("SENDING", Истина);
		Финалы.Вставить("NEW", Истина);

		МолчащиеКаналы = Новый Соответствие;   // каналы без обратной связи - считаем, но не перечисляем
		МолчащиеКаналы.Вставить("2LT", Истина);
		МолчащиеКаналы.Вставить("2VO", Истина);

		ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
		Токен = ЭДО_Сервер.ТекущийТокен(Организация);
		ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
		НашГид = ЭДО_Сервер.ГидОрганизации(Организация);
		Соед = ЭДО_Сервер.СоединениеСОператором(60);
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
		Заголовки.Вставить("accept", "application/json;charset=UTF-8");

		Строки = Новый Массив;
		ПоКаналам = Новый Соответствие;
		Молчащих = 0;
		Всего = 0;
		СуммаВисит = 0;
		Ошибки = "";
		Финиш = НачалоДня(ТекущаяУниверсальнаяДата()) - ПорогДней * 86400;

		Для Сдвиг = 0 По ГлубинаДней - ПорогДней Цикл
			День = Финиш - Сдвиг * 86400;
			ОтДата = Формат(День, "ДФ=yyyy-MM-dd");
			ВозрастДней = ПорогДней + Сдвиг;
			Для Страница = 0 По 9 Цикл
				// Токен Keycloak живет 15 минут и перевыпускается по времени, а не по числу запросов.
				Если ТекущаяУниверсальнаяДатаВМиллисекундах() - ТокенПолучен > 600000 Тогда
					ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
					Токен = ЭДО_Сервер.ТекущийТокен(Организация);
					ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
					Заголовки.Вставить("Authorization", "Bearer " + Токен);
				КонецЕсли;
				Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/documents?created_from=" + ОтДата + "T00:00:00.000Z"
					+ "&created_till=" + ОтДата + "T23:59:59.000Z&sender_id=" + НашГид
					+ "&page=" + Страница + "&page_size=100";
				Карточки = Неопределено;
				Для НомерПопытки = 1 По 3 Цикл
					Запрос = Новый HTTPЗапрос(Путь, Заголовки);
					Попытка
						Ответ = Соед.Получить(Запрос);
					Исключение
						Продолжить;   // сеть моргнула - пробуем еще раз
					КонецПопытки;
					Если Ответ.КодСостояния = 401 Тогда
						ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
						Токен = ЭДО_Сервер.ТекущийТокен(Организация);
						ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
						Заголовки.Вставить("Authorization", "Bearer " + Токен);
						Продолжить;
					КонецЕсли;
					Если Ответ.КодСостояния <> 200 Тогда
						Ошибки = Ошибки + ОтДата + " стр." + Страница + ": HTTP " + Ответ.КодСостояния + "; ";
						Прервать;
					КонецЕсли;
					Чтение = Новый ЧтениеJSON;
					Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
					Карточки = ПрочитатьJSON(Чтение, Ложь);
					Чтение.Закрыть();
					Прервать;
				КонецЦикла;
				Если Карточки = Неопределено Тогда
					Прервать;
				КонецЕсли;
				Для Каждого Карточка Из Карточки Цикл
					Если Строка(Карточка.type) <> "ON_NSCHFDOPPR" Тогда
						Продолжить;
					КонецЕсли;
					Если Финалы.Получить(Строка(Карточка.status)) <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
					Всего = Всего + 1;
					// свои карточки (наш ИНН и наш же ящик) отсекаем в источнике, иначе они всплывают
					// в каждом отчете как проблемные
					Если ЭДО_Сервер.АдресЭДОНаш(Строка(Карточка.recipient.id)) Тогда
						Продолжить;
					КонецЕсли;
					Канал = Лев(Строка(Карточка.recipient.id), 3);
					Если МолчащиеКаналы.Получить(Канал) <> Неопределено Тогда
						Молчащих = Молчащих + 1;
						Продолжить;
					КонецЕсли;
					Счётчик = ПоКаналам.Получить(Канал);
					ПоКаналам.Вставить(Канал, ?(Счётчик = Неопределено, 1, Счётчик + 1));
					Номер = "";
					Сумма = 0;
					Покупатель = "";
					Если Карточка.Свойство("invoice") И Карточка.invoice <> Неопределено Тогда
						Инв = Карточка.invoice;
						Если Инв.Свойство("num") Тогда
							Номер = СокрЛП(Строка(Инв.num));
						КонецЕсли;
						Если Инв.Свойство("sum") Тогда
							Сумма = Число(Инв.sum);
						КонецЕсли;
						Если Инв.Свойство("buyer") И Инв.buyer <> Неопределено Тогда
							Пок = Инв.buyer;
							Если Пок.Свойство("name") И Пок.name <> Неопределено Тогда
								Имя = Пок.name;
								Если ТипЗнч(Имя) = Тип("Строка") Тогда
									Покупатель = СокрЛП(Имя);
								Иначе
									// ИП: имя приходит разобранным на части
									Части = Новый Массив;
									Если Имя.Свойство("last") Тогда Части.Добавить(Строка(Имя.last)); КонецЕсли;
									Если Имя.Свойство("first") Тогда Части.Добавить(Строка(Имя.first)); КонецЕсли;
									Если Имя.Свойство("middle") Тогда Части.Добавить(Строка(Имя.middle)); КонецЕсли;
									Покупатель = СокрЛП(СтрСоединить(Части, " "));
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					СуммаВисит = СуммаВисит + Сумма;
					Строки.Добавить(Формат(ВозрастДней, "ЧН=0; ЧГ=0") + " дн. | " + Номер + " | "
						+ Лев(Покупатель, 38) + " | " + Формат(Сумма, "ЧДЦ=2; ЧГ=0") + " | " + Канал
						+ " | " + Строка(Карточка.status));
				КонецЦикла;
				Если Карточки.Количество() < 100 Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

		Свод = "";
		Для Каждого КЗ Из ПоКаналам Цикл
			Свод = Свод + ?(Свод = "", "", ", ") + КЗ.Ключ + ": " + КЗ.Значение;
		КонецЦикла;
		Лог = Новый Массив;
		Лог.Добавить("ЭДО, приёмка: без титула покупателя дольше " + ПорогДней + " дн. — "
			+ Строки.Количество() + " док на " + Формат(СуммаВисит, "ЧДЦ=2; ЧГ=0") + " руб"
			+ ?(Свод = "", "", " (" + Свод + ")")
			+ "; каналы без обратной связи (2LT/2VO) пропущено: " + Молчащих
			+ ?(Ошибки = "", "", "; ОШИБКИ ОБХОДА: " + Ошибки));
		Показано = 0;
		Для Каждого С Из Строки Цикл
			Если Показано >= ПоказатьМакс Тогда
				Лог.Добавить("    … и ещё " + (Строки.Количество() - Показано) + " — полный список в журнале регистрации");
				Прервать;
			КонецЕсли;
			Лог.Добавить("    " + С);
			Показано = Показано + 1;
		КонецЦикла;
		Текст = СтрСоединить(Лог, Символы.ПС);

		ЗаписьЖурналаРегистрации("ЭДО.КонтрольПриёмки",
			?(Строки.Количество() > 0, УровеньЖурналаРегистрации.Предупреждение, УровеньЖурналаРегистрации.Информация),
			, , Лев(Текст, 5000));

		Результат = Текст;
	Исключение
		Результат = "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	Результат = ?(Организация = Неопределено, "", "[" + Строка(Организация) + "] ") + Результат;
	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Строка(Результат)), "ОШИБКА") > 0,
		"ЭДО.Регламент.СторожНеПринятых");
	Возврат Результат;

КонецФункции

// Сторож паузы: контрагент, который за окно не подписал ни одного документа и у которого
// есть документ, висящий дольше порога, ставится на паузу - отправка ему прекращается.
// Второе условие обязательно: без него под правило попадает всякий, кто просто не успел
// подписать. Пауза снимается сама, как только за окно появилась подпись.
// В счет висящих идут только документы, ушедшие на действующий адрес контрагента:
// отправленное на прежний ящик он не видел.
//
// СухойПрогон - посчитать и записать в журнал то же самое, но пауз не ставить и не снимать
// (приемка правок в бою в день выкатки). Регламент зовет функцию без параметров.
Функция ВыполнитьСторожПаузы(Знач СухойПрогон = Ложь, Знач Организация = Неопределено) Экспорт

	Если Организация = Неопределено И ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Своды = Новый Массив;
		Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
			Своды.Добавить(ВыполнитьСторожПаузы(СухойПрогон, УчетнаяЗапись.Организация));
		КонецЦикла;
		Возврат СтрСоединить(Своды, Символы.ПС);
	КонецЕсли;

	Попытка
		// Пауза ставится сразу, без списка на разбор: контрагент, которому ЭДО нужно, обратится
		// сам, и пауза снимается за минуту.
		СтавитьПаузу = НЕ СухойПрогон;
		ПорогДней    = 14;     // возраст висящего документа, после которого молчание систематическое
		// Окно широкое: за его горизонтом подпись не видна, и давно подписавший выглядел бы молчуном.
		ОкноДней     = 90;     // окно, в котором ищем подписи и висящие документы

		ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
		Токен = ЭДО_Сервер.ТекущийТокен(Организация);
		ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
		НашГид = ЭДО_Сервер.ГидОрганизации(Организация);
		Соед = ЭДО_Сервер.СоединениеСОператором(60);
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
		Заголовки.Вставить("accept", "application/json;charset=UTF-8");

		// каналы без обратной связи: там молчание - свойство канала, а не поведение контрагента
		МолчащиеКаналы = Новый Соответствие;
		МолчащиеКаналы.Вставить("2LT", Истина);
		МолчащиеКаналы.Вставить("2VO", Истина);
		// статусы, после которых ждать подписи нечего
		Финалы = Новый Соответствие;
		Финалы.Вставить("REJECTED", Истина);
		Финалы.Вставить("CANCELLED", Истина);
		Финалы.Вставить("SENDING_FAILED", Истина);
		Финалы.Вставить("SENDING", Истина);
		Финалы.Вставить("NEW", Истина);

		// ИНН -> карточки контрагента в базе (их может быть несколько на один ИНН - норма для точек).
		// Строится ДО обхода оператора: действующие адреса нужны уже при подсчете просроченных.
		СвИд = ЭДО_Сервер.СвойствоОбъектов("ЭДО_АдресКонтрагента");
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("СвИд", СвИд);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	З.Объект                КАК Контрагент,
		|	З.Объект.Наименование   КАК Имя,
		|	З.Объект.ИНН            КАК ИНН,
		|	З.Значение              КАК Адрес
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК З
		|ГДЕ
		|	З.Свойство = &СвИд
		|	И НЕ З.Объект.ИНН = """"";
		ПоАдресу = Новый Соответствие;      // ИНН -> Массив карточек
		АдресаПоИНН = Новый Соответствие;   // ИНН -> Соответствие действующих адресов
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ИННКлюч = СокрЛП(Выборка.ИНН);
			Список = ПоАдресу.Получить(ИННКлюч);
			Если Список = Неопределено Тогда
				Список = Новый Массив;
				ПоАдресу.Вставить(ИННКлюч, Список);
				АдресаПоИНН.Вставить(ИННКлюч, Новый Соответствие);
			КонецЕсли;
			Список.Добавить(Новый Структура("Контрагент, Имя", Выборка.Контрагент, СокрЛП(Выборка.Имя)));
			Адрес = ВРег(СокрЛП(Строка(Выборка.Адрес)));
			Если ЗначениеЗаполнено(Адрес) Тогда
				АдресаПоИНН.Получить(ИННКлюч).Вставить(Адрес, Истина);
			КонецЕсли;
		КонецЦикла;

		Отправлено   = Новый Соответствие;
		Принято      = Новый Соответствие;
		Просроченные = Новый Соответствие;
		Суммы        = Новый Соответствие;
		ОтброшеноЧужойАдрес = 0;
		Ошибки = "";
		Финиш = НачалоДня(ТекущаяУниверсальнаяДата());

		Для Сдвиг = 1 По ОкноДней Цикл
			День = Финиш - Сдвиг * 86400;
			ОтДата = Формат(День, "ДФ=yyyy-MM-dd");
			Для Страница = 0 По 9 Цикл
				// Токен Keycloak живет 15 минут и перевыпускается по времени, а не по числу запросов.
				Если ТекущаяУниверсальнаяДатаВМиллисекундах() - ТокенПолучен > 600000 Тогда
					ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
					Токен = ЭДО_Сервер.ТекущийТокен(Организация);
					ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
					Заголовки.Вставить("Authorization", "Bearer " + Токен);
				КонецЕсли;
				Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/documents?created_from=" + ОтДата + "T00:00:00.000Z"
					+ "&created_till=" + ОтДата + "T23:59:59.000Z&sender_id=" + НашГид
					+ "&page=" + Страница + "&page_size=100";
				Карточки = Неопределено;
				Для НомерПопытки = 1 По 3 Цикл
					Попытка
						Ответ = Соед.Получить(Новый HTTPЗапрос(Путь, Заголовки));
					Исключение
						Продолжить;   // сеть моргнула - пробуем еще раз
					КонецПопытки;
					Если Ответ.КодСостояния = 401 Тогда
						ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
						Токен = ЭДО_Сервер.ТекущийТокен(Организация);
						ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
						Заголовки.Вставить("Authorization", "Bearer " + Токен);
						Продолжить;
					КонецЕсли;
					Если Ответ.КодСостояния <> 200 Тогда
						Ошибки = Ошибки + ОтДата + " стр." + Страница + ": HTTP " + Ответ.КодСостояния + "; ";
						Прервать;
					КонецЕсли;
					Чтение = Новый ЧтениеJSON;
					Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
					Карточки = ПрочитатьJSON(Чтение, Ложь);
					Чтение.Закрыть();
					Прервать;
				КонецЦикла;
				Если Карточки = Неопределено Тогда
					Прервать;
				КонецЕсли;
				Для Каждого Карточка Из Карточки Цикл
					Если Строка(Карточка.type) <> "ON_NSCHFDOPPR" Тогда
						Продолжить;
					КонецЕсли;
					АдресПолучателя = СокрЛП(Строка(Карточка.recipient.id));
					Получатель = АдресПолучателя;
					// свои карточки отсекаем в источнике, а не в отчете
					Если ЭДО_Сервер.АдресЭДОНаш(Получатель) Тогда
						Продолжить;
					КонецЕсли;
					// Считаем по ИНН покупателя, а не по адресу получателя: контрагент, сменивший оператора,
					// по старому адресу выглядит молчащим, хотя у нового исправно подписывает; по адресу
					// его карточка к тому же может не находиться вовсе.
					Ключ = "";
					Если Карточка.Свойство("invoice") И Карточка.invoice <> Неопределено
						И Карточка.invoice.Свойство("buyer") И Карточка.invoice.buyer <> Неопределено
						И Карточка.invoice.buyer.Свойство("inn") Тогда
						Ключ = СокрЛП(Строка(Карточка.invoice.buyer.inn));
					КонецЕсли;
					Если НЕ ЗначениеЗаполнено(Ключ) Тогда
						Продолжить;   // без ИНН покупателя судить не о ком
					КонецЕсли;
					Получатель = Ключ;
					Статус = Строка(Карточка.status);
					// Канал без обратной связи молчит по своему устройству: такие карточки не идут в счет
					// висящих, но подпись в них засчитывается наравне с остальными.
					Молчащий = (МолчащиеКаналы.Получить(Лев(Строка(Карточка.recipient.id), 3)) <> Неопределено);
					Если НЕ Молчащий Тогда
						Счёт = Отправлено.Получить(Получатель);
						Отправлено.Вставить(Получатель, ?(Счёт = Неопределено, 1, Счёт + 1));
					КонецЕсли;
					Сумма = 0;
					Если Карточка.Свойство("invoice") И Карточка.invoice <> Неопределено
						И Карточка.invoice.Свойство("sum") Тогда
						Сумма = Число(Карточка.invoice.sum);
					КонецЕсли;
					Если НЕ Молчащий Тогда
						НакопСумма = Суммы.Получить(Получатель);
						Суммы.Вставить(Получатель, ?(НакопСумма = Неопределено, Сумма, НакопСумма + Сумма));
					КонецЕсли;
					Если Статус = "ACCEPTED" Тогда
						СчётП = Принято.Получить(Получатель);
						Принято.Вставить(Получатель, ?(СчётП = Неопределено, 1, СчётП + 1));
						Продолжить;
					КонецЕсли;
					Если Финалы.Получить(Статус) <> Неопределено ИЛИ Молчащий Тогда
						Продолжить;
					КонецЕсли;
					Если Сдвиг >= ПорогДней Тогда
						// Документ, ушедший на адрес, которым контрагент больше не пользуется, молчанием
						// не считается: он его не видел. Адрес неизвестен (карточки нет или свойство пустое) -
						// судим как раньше.
						ДействующиеАдреса = АдресаПоИНН.Получить(Получатель);
						АдресДействующий = (ДействующиеАдреса = Неопределено
							ИЛИ ДействующиеАдреса.Количество() = 0
							ИЛИ ДействующиеАдреса.Получить(ВРег(АдресПолучателя)) <> Неопределено);
						Если АдресДействующий Тогда
							СчётС = Просроченные.Получить(Получатель);
							Просроченные.Вставить(Получатель, ?(СчётС = Неопределено, 1, СчётС + 1));
						Иначе
							ОтброшеноЧужойАдрес = ОтброшеноЧужойАдрес + 1;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				Если Карточки.Количество() < 100 Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

		Кандидаты = Новый Массив;
		НаПаузе = Новый Массив;
		КандидатыНаСнятие = Новый Массив;
		ВсегоДок = 0;
		ВсегоСумма = 0;
		Поставлено = 0;
		СнятоВсего = 0;
		Для Каждого КЗ Из Отправлено Цикл
			Список = ПоАдресу.Получить(СокрЛП(КЗ.Ключ));
			Карта = ?(Список = Неопределено ИЛИ Список.Количество() = 0, Неопределено, Список[0]);
			Имя = ?(Карта = Неопределено, "ИНН " + КЗ.Ключ, Карта.Имя);
			Пауза = ?(Карта = Неопределено, "", ЭДО_Сервер.ПричинаПаузыКонтрагента(Карта.Контрагент));
			ЕстьПодписи = (Принято.Получить(КЗ.Ключ) <> Неопределено);
			Если ЗначениеЗаполнено(Пауза) Тогда
				// Появилась подпись за окно - паузу снимаем сами, на всех карточках этого ИНН.
				Если ЕстьПодписи Тогда
					Снято = 0;
					Если Список <> Неопределено И СтавитьПаузу Тогда
						Для Каждого КарточкаКА Из Список Цикл
							ЭДО_Сервер.ВозобновитьОтправкуКонтрагенту(КарточкаКА.Контрагент);
							Снято = Снято + 1;
						КонецЦикла;
					КонецЕсли;
					СнятоВсего = СнятоВсего + Снято;
					КандидатыНаСнятие.Добавить(Лев(Имя, 40) + " | подписал "
						+ Принято.Получить(КЗ.Ключ) + " док за месяц — пауза снята с " + Снято + " карточек");
				Иначе
					НаПаузе.Добавить(Лев(Имя, 40) + " | " + Пауза);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Если ЕстьПодписи Тогда
				Продолжить;
			КонецЕсли;
			Стар = Просроченные.Получить(КЗ.Ключ);
			Если Стар = Неопределено Тогда
				Продолжить;   // подписей нет, но и просроченных тоже - просто еще не успел
			КонецЕсли;
			ВсегоДок = ВсегоДок + КЗ.Значение;
			ВсегоСумма = ВсегоСумма + Суммы.Получить(КЗ.Ключ);
			Кандидаты.Добавить(Лев(Имя, 40) + " | " + КЗ.Значение + " док за месяц, из них старше "
				+ ПорогДней + " дн.: " + Стар + " | "
				+ Формат(Суммы.Получить(КЗ.Ключ), "ЧДЦ=2; ЧГ=0") + " руб | ИНН " + КЗ.Ключ
				+ ?(Список = Неопределено, " | КАРТОЧКА НЕ НАЙДЕНА", " | карточек: " + Список.Количество()));
			Если СтавитьПаузу И Список <> Неопределено Тогда
				// Свойство "причина" - строка 50 символов, поэтому формулировка короткая.
				// Карточек на один ИНН бывает много: пауза ставится на все, иначе документ выпишут
				// на соседнюю и он уйдет мимо правила.
				Для Каждого КарточкаКА Из Список Цикл
					ЭДО_Сервер.ПриостановитьОтправкуКонтрагенту(КарточкаКА.Контрагент,
						"нет подписей " + ОкноДней + " дн., " + Стар + " старше " + ПорогДней + " дн.");
					Поставлено = Поставлено + 1;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;

		Лог = Новый Массив;
		Лог.Добавить("ЭДО, пауза: под правило подпадает " + Кандидаты.Количество() + " контрагентов ("
			+ ВсегоДок + " док, " + Формат(ВсегоСумма, "ЧДЦ=2; ЧГ=0") + " руб)"
			+ ?(СтавитьПаузу, "; ПОСТАВЛЕНО НА ПАУЗУ: " + Поставлено, "; сухой прогон, пометки не ставились")
			+ "; уже на паузе: " + НаПаузе.Количество()
			+ ?(ОтброшеноЧужойАдрес = 0, "",
				"; не в счёт (ушло на прежний адрес контрагента): " + ОтброшеноЧужойАдрес)
			+ ?(КандидатыНаСнятие.Количество() = 0, "",
				"; ПОЯВИЛИСЬ ПОДПИСИ у " + КандидатыНаСнятие.Количество()
				+ " — пауза снята с " + СнятоВсего + " карточек")
			+ ?(Ошибки = "", "", "; ОШИБКИ ОБХОДА: " + Ошибки));
		Для Каждого С Из Кандидаты Цикл
			Лог.Добавить("    " + С);
		КонецЦикла;
		Для Каждого С Из КандидатыНаСнятие Цикл
			Лог.Добавить("    СНЯТО: " + С);
		КонецЦикла;
		Текст = СтрСоединить(Лог, Символы.ПС);
		ЗаписьЖурналаРегистрации("ЭДО.ПаузаОтправки",
			?(Кандидаты.Количество() > 0, УровеньЖурналаРегистрации.Предупреждение, УровеньЖурналаРегистрации.Информация),
			, , Лев(Текст, 5000));
		Результат = Текст;
	Исключение
		Результат = "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	Результат = ?(Организация = Неопределено, "", "[" + Строка(Организация) + "] ") + Результат;
	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Строка(Результат)), "ОШИБКА") > 0,
		"ЭДО.Регламент.СторожПаузы");
	Возврат Результат;

КонецФункции

// Обход ГИС МТ ("Честный ЗНАК") по нашим исходящим УПД. Отвечает на два вопроса,
// которых из ЭДО не видно:
// 1) какие документы ЧЗ отвергла и с какой формулировкой (commonErrors из /doc/{имя}/info);
// 2) какие подписаны покупателем, но до ЧЗ не доехали.
// В ЧЗ документ попадает только после подписи покупателя (статус ACCEPTED): пока он
// SENT/DELIVERED, отсутствие в ЧЗ - норма.
// Первая строка результата - сводка для журнала, дальше построчно отказы и "пропавшие".
Функция ВыполнитьСторожГИСМТ(Знач Организация = Неопределено) Экспорт

	Если Организация = Неопределено И ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Своды = Новый Массив;
		Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
			Своды.Добавить(ВыполнитьСторожГИСМТ(УчетнаяЗапись.Организация));
		КонецЦикла;
		Возврат СтрСоединить(Своды, Символы.ПС);
	КонецЕсли;

	Попытка
		ГлубинаСверки = 7;   // дней назад по дате накладной для поиска "подписан, но не доехал"
		ГлубинаСписка = 7;   // дней назад обходим doc/list ГИС МТ
		// Окно списка не должно быть уже окна сверки: документ, подписанный позже, попадает
		// в ЧЗ своим днем и при узком окне объявляется пропавшим.
		ЛимитСписка = "1000";// строкой: Строка(1000) дает "1 000" с разделителем групп, и URL ломается
		// doc/list отвечает на это ошибкой, и обход молча дает "наших исходящих 0". Пагинации
		// у метода нет: при меньшем лимите суточный поток не влезает, и лишнее печатается
		// как "не доехал в ЧЗ".
		ЛагЧасов = 2;        // ЧЗ получает документ через минуту-другую после подписи покупателя,
		// а не после отправки; двух часов на обработку хватает с запасом.
		ПоказатьМакс = 40;   // потолок списка в логе, чтобы одна авария не залила его целиком

		// -- 1. Аутентификация в ГИС МТ: та же КЭП, что для Платформы, подпись ПРИСОЕДИНЕННАЯ ---
		СоедГ = Новый HTTPСоединение("markirovka.crpt.ru", 443, , , , 90, Новый ЗащищенноеСоединениеOpenSSL());
		ЗапКлюч = Новый HTTPЗапрос("/api/v3/true-api/auth/key");
		ЗапКлюч.Заголовки.Вставить("Accept", "application/json");
		ЧКлюч = Новый ЧтениеJSON;
		ЧКлюч.УстановитьСтроку(СоедГ.Получить(ЗапКлюч).ПолучитьТелоКакСтроку("UTF-8"));
		СтрКлюч = ПрочитатьJSON(ЧКлюч, Ложь);
		ЧКлюч.Закрыть();
		ДанныеДляПодписи = ПолучитьДвоичныеДанныеИзСтроки(СтрКлюч.data, "UTF-8", Ложь);
		ОбрЭДО = Обработки.ЭДО_ПлатформаЭДО.Создать();
		ОтказПодписи = Ложь;
		ОписаниеПодписи = "";
		ПодписьCMS = ОбрЭДО.ПрисоединитьПодпись(ЭДО_Сервер.ПодписатьДанные(ДанныеДляПодписи, Организация), ДанныеДляПодписи, ОтказПодписи, ОписаниеПодписи);
		Подпись64 = СтрЗаменить(СтрЗаменить(Base64Строка(ПодписьCMS), Символы.ПС, ""), Символы.ВК, "");
		ЗапВход = Новый HTTPЗапрос("/api/v3/true-api/auth/simpleSignIn");
		ЗапВход.Заголовки.Вставить("Content-Type", "application/json");
		ЗапВход.Заголовки.Вставить("Accept", "application/json");
		ЗапВход.УстановитьТелоИзСтроки("{""uuid"":""" + СтрКлюч.uuid + """,""data"":""" + Подпись64 + """}", КодировкаТекста.UTF8);
		ЧВход = Новый ЧтениеJSON;
		ЧВход.УстановитьСтроку(СоедГ.ОтправитьДляОбработки(ЗапВход).ПолучитьТелоКакСтроку("UTF-8"));
		СтрВход = ПрочитатьJSON(ЧВход, Ложь);
		ЧВход.Закрыть();
		ТокенГ = СтрВход.token;

		// -- 2. Обход doc/list по суткам и товарным группам ---
		// pg обязателен, один документ приходит в нескольких группах; пагинации у метода нет,
		// поэтому берем максимальный limit и отдельно следим за упором в него.
		Группы = СтрРазделить("conserve,milk,water,grocery,softdrinks,vegetableoil", ",");
		СтатусыГИС = Новый Соответствие;   // номер накладной -> статус (CHECKED_OK приоритетнее)
		ИменаФайлов = Новый Соответствие;  // номер накладной -> имя файла ЭДО для /info
		ПолученоЧЗ = Новый Соответствие;   // номер накладной -> когда ЧЗ приняла этот экземпляр
		СчОК = 0;
		СчНеОК = 0;
		СчВРаботе = 0;
		СрезНеполон = "";                  // сутки/группы, где выдача уперлась в ЛимитСписка
		Сегодня = НачалоДня(ТекущаяДата());
		Для Сдвиг = 1 По ГлубинаСписка Цикл
			День = Сегодня - Сдвиг * 86400;
			ОтДаты = Формат(День, "ДФ=yyyy-MM-dd") + "T00:00:00.000Z";
			ДоДаты = Формат(День, "ДФ=yyyy-MM-dd") + "T23:59:59.000Z";
			Для Каждого Группа Из Группы Цикл
				ЗапСписок = Новый HTTPЗапрос("/api/v4/true-api/doc/list?limit=" + ЛимитСписка + "&pg=" + Группа + "&dateFrom=" + ОтДаты + "&dateTo=" + ДоДаты);
				ЗапСписок.Заголовки.Вставить("Authorization", "Bearer " + ТокенГ);
				ЗапСписок.Заголовки.Вставить("Accept", "application/json");
				Попытка
					ЧСписок = Новый ЧтениеJSON;
					ЧСписок.УстановитьСтроку(СоедГ.Получить(ЗапСписок).ПолучитьТелоКакСтроку("UTF-8"));
					Ответ = ПрочитатьJSON(ЧСписок, Ложь);
					ЧСписок.Закрыть();
					// упор в потолок выдачи = срез за эти сутки неполон, и "пропавшие" ниже станут враньем
					Если Ответ.results.Количество() >= Число(ЛимитСписка) Тогда
						СрезНеполон = СрезНеполон + ?(СрезНеполон = "", "", ", ") + Формат(День, "ДФ=dd.MM") + "/" + Группа;
					КонецЕсли;
					Для Каждого Элемент Из Ответ.results Цикл
						Если Элемент.input Тогда
							Продолжить;
						КонецЕсли;
						Прежний = СтатусыГИС.Получить(Элемент.invoiceNumber);
						Если Прежний = Неопределено ИЛИ Элемент.status = "CHECKED_OK" Тогда
							СтатусыГИС.Вставить(Элемент.invoiceNumber, Элемент.status);
							ИменаФайлов.Вставить(Элемент.invoiceNumber, Элемент.number);
							МеткаЧЗ = Строка(Элемент.receivedAt);
							Если СтрДлина(МеткаЧЗ) >= 19 Тогда
								ПолученоЧЗ.Вставить(Элемент.invoiceNumber, Дата(Число(Сред(МеткаЧЗ, 1, 4)), Число(Сред(МеткаЧЗ, 6, 2)), Число(Сред(МеткаЧЗ, 9, 2)),
									Число(Сред(МеткаЧЗ, 12, 2)), Число(Сред(МеткаЧЗ, 15, 2)), Число(Сред(МеткаЧЗ, 18, 2))));
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				Исключение
				КонецПопытки;
			КонецЦикла;
		КонецЦикла;
		Отказы = Новый Массив;
		Для Каждого Пара Из СтатусыГИС Цикл
			Если Пара.Значение = "CHECKED_OK" Тогда
				СчОК = СчОК + 1;
			ИначеЕсли Пара.Значение = "IN_PROGRESS" Тогда
				СчВРаботе = СчВРаботе + 1;
			Иначе
				СчНеОК = СчНеОК + 1;
				Отказы.Добавить(Пара.Ключ);
			КонецЕсли;
		КонецЦикла;

		// -- 3. Причины отказов: только в /info, поле commonErrors (в списке errors всегда null) ---
		СтрокиОтказов = Новый Массив;
		ТекстыОтказов = Новый Соответствие;
		Для Каждого НомерН Из Отказы Цикл
			Попытка
				ЗапИнфо = Новый HTTPЗапрос("/api/v4/true-api/doc/" + ИменаФайлов.Получить(НомерН) + "/info");
				ЗапИнфо.Заголовки.Вставить("Authorization", "Bearer " + ТокенГ);
				ЗапИнфо.Заголовки.Вставить("Accept", "application/json");
				ЧИнфо = Новый ЧтениеJSON;
				ЧИнфо.УстановитьСтроку(СоедГ.Получить(ЗапИнфо).ПолучитьТелоКакСтроку("UTF-8"));
				Инфо = ПрочитатьJSON(ЧИнфо, Ложь);
				ЧИнфо.Закрыть();
				Карточка = ?(ТипЗнч(Инфо) = Тип("Массив") И Инфо.Количество() > 0, Инфо[0], Инфо);
				Текст = "";
				Если Карточка.Свойство("commonErrors") И Карточка["commonErrors"] <> Неопределено Тогда
					Показано = 0;
					Для Каждого Ошибка Из Карточка["commonErrors"] Цикл
						Показано = Показано + 1;
						Если Показано > 2 Тогда
							Текст = Текст + " (…ещё)";
							Прервать;
						КонецЕсли;
						Текст = Текст + ?(Текст = "", "", "; ") + Строка(Ошибка["errorCode"]) + " " + Лев(Строка(Ошибка["errorMessage"]), 120);
					КонецЦикла;
				КонецЕсли;
				ТекстыОтказов.Вставить(НомерН, ?(Текст = "", "(причина не указана)", Текст));
			Исключение
				ТекстыОтказов.Вставить(НомерН, "причину получить не удалось: " + Лев(ОписаниеОшибки(), 100));
			КонецПопытки;
		КонецЦикла;

		// -- 4. Тихий исход: подписан покупателем, но в ЧЗ его нет ---
		// Признак "подписан" берем у Платформы (status = ACCEPTED); маркировку - по ТЧ ШтрихкодыУпаковок.
		Пропавшие = Новый Массив;
		СверкаСделана = Ложь;
		Попытка
			СвойствоИД = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
			ЗапросНаши = Новый Запрос;
			ЗапросНаши.Текст =
				"ВЫБРАТЬ РАЗЛИЧНЫЕ Р.Номер КАК Номер, Р.Дата КАК Дата
				|ИЗ Документ.РеализацияТоваровУслуг КАК Р
				|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.ШтрихкодыУпаковок КАК ШУ
				|		ПО ШУ.Ссылка = Р.Ссылка
				|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ИД
				|		ПО ИД.Объект = Р.Ссылка И ИД.Свойство = &СвойствоИД
				|ГДЕ Р.Проведен И Р.Дата МЕЖДУ &ОтДаты И &ДоДаты
				|	И (&ВсеОрганизации ИЛИ Р.Организация.ИНН = &ИННОрганизации)";
				ЗапросНаши.УстановитьПараметр("СвойствоИД", СвойствоИД);
			ЗапросНаши.УстановитьПараметр("ОтДаты", Сегодня - ГлубинаСверки * 86400);
			ЗапросНаши.УстановитьПараметр("ВсеОрганизации", Организация = Неопределено);
			ЗапросНаши.УстановитьПараметр("ИННОрганизации", ?(Организация = Неопределено, "", СокрЛП(Организация.ИНН)));
			ЗапросНаши.УстановитьПараметр("ДоДаты", КонецДня(Сегодня - 86400));
			НашиМаркированные = Новый Соответствие;
			Для Каждого СтрокаТЗ Из ЗапросНаши.Выполнить().Выгрузить() Цикл
				НашиМаркированные.Вставить(СтрокаТЗ.Номер, СтрокаТЗ.Дата);
			КонецЦикла;

			ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
			ТокенП = ЭДО_Сервер.ТекущийТокен(Организация);
			ЗаголовкиП = Новый Соответствие;
			ЗаголовкиП.Вставить("Authorization", "Bearer " + ТокенП);
			ЗаголовкиП.Вставить("accept", "application/json;charset=UTF-8");
			СоедП = ЭДО_Сервер.СоединениеСОператором(120);   // обход суток терпит длинный ответ
			НашGid = ЭДО_Сервер.ГидОрганизации(Организация);
			Подписанные = Новый Соответствие;
			ПоследняяОтправка = Новый Соответствие;   // время создания последнего экземпляра
			ПодписанВ = Новый Соответствие;           // время подписи покупателем (modified у ACCEPTED)
			// с нуля, а НЕ с единицы: переотправка могла быть сегодня, и без текущих суток
			// фильтр по лагу доставки не увидит свежий экземпляр и объявит документ пропавшим.
			Для Сдвиг = 0 По ГлубинаСверки Цикл
				День = Сегодня - Сдвиг * 86400;
				ОтМетка = Формат(День, "ДФ=yyyy-MM-dd") + "T00:00:00.000Z";
				ДоМетка = Формат(День, "ДФ=yyyy-MM-dd") + "T23:59:59.999Z";
				Для Страница = 0 По 9 Цикл
					Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/documents?sender_id=" + НашGid
						+ "&created_from=" + ОтМетка + "&created_till=" + ДоМетка
						+ "&page=" + Страница + "&page_size=100";
					ОтветП = СоедП.Получить(Новый HTTPЗапрос(Путь, ЗаголовкиП));
					Если ОтветП.КодСостояния <> 200 Тогда
						Прервать;
					КонецЕсли;
					ЧП = Новый ЧтениеJSON;
					ЧП.УстановитьСтроку(ОтветП.ПолучитьТелоКакСтроку("UTF-8"));
					МассивП = ПрочитатьJSON(ЧП, Ложь);
					ЧП.Закрыть();
					Если ТипЗнч(МассивП) <> Тип("Массив") ИЛИ МассивП.Количество() = 0 Тогда
						Прервать;
					КонецЕсли;
					Для Каждого Запись Из МассивП Цикл
						Если НЕ Запись.Свойство("invoice") ИЛИ Запись["invoice"] = Неопределено Тогда
							Продолжить;
						КонецЕсли;
						Счет = Запись["invoice"];
						Если НЕ Счет.Свойство("num") Тогда
							Продолжить;
						КонецЕсли;
						НомерСчета = Строка(Счет["num"]);
						// Судим по последнему экземпляру: у переотправленного документа старый экземпляр
						// остается ACCEPTED, и свежий неподписанный выглядел бы "подписанным и потерянным".
						// created - ISO-8601 в UTC, "2026-08-20T04:40:09.314396Z".
						Метка = Строка(Запись.created);
						Если СтрДлина(Метка) < 19 Тогда
							Продолжить;
						КонецЕсли;
						Создан = Дата(Число(Сред(Метка, 1, 4)), Число(Сред(Метка, 6, 2)), Число(Сред(Метка, 9, 2)),
							Число(Сред(Метка, 12, 2)), Число(Сред(Метка, 15, 2)), Число(Сред(Метка, 18, 2)));
						Прежняя = ПоследняяОтправка.Получить(НомерСчета);
						Если Прежняя = Неопределено ИЛИ Прежняя < Создан Тогда
							ПоследняяОтправка.Вставить(НомерСчета, Создан);
							ЭтоПодписан = (Строка(Запись.status) = "ACCEPTED");
							Подписанные.Вставить(НомерСчета, ?(ЭтоПодписан, 1, 0));
							МеткаИзм = Строка(Запись.modified);
							Если ЭтоПодписан И СтрДлина(МеткаИзм) >= 19 Тогда
								ПодписанВ.Вставить(НомерСчета, Дата(Число(Сред(МеткаИзм, 1, 4)), Число(Сред(МеткаИзм, 6, 2)), Число(Сред(МеткаИзм, 9, 2)),
									Число(Сред(МеткаИзм, 12, 2)), Число(Сред(МеткаИзм, 15, 2)), Число(Сред(МеткаИзм, 18, 2))));
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
					Если МассивП.Количество() < 100 Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			Для Каждого Пара Из НашиМаркированные Цикл
				Если Подписанные.Получить(Пара.Ключ) <> 1 Тогда
					Продолжить;   // последний экземпляр покупателем еще не подписан - в ЧЗ его быть и не должно
				КонецЕсли;
				Если СтатусыГИС.Получить(Пара.Ключ) = "CHECKED_OK" Тогда
					Продолжить;
				КонецЕсли;
				Если СтатусыГИС.Получить(Пара.Ключ) = "IN_PROGRESS" Тогда
					Продолжить;
				КонецЕсли;
				Подписан = ПодписанВ.Получить(Пара.Ключ);
				Если Подписан <> Неопределено И Подписан > ТекущаяУниверсальнаяДата() - ЛагЧасов * 3600 Тогда
					Продолжить;   // подписан только что - ЧЗ еще не успела разобрать
				КонецЕсли;
				Пропавшие.Добавить(Пара.Ключ + " (" + Формат(Пара.Значение, "ДФ=dd.MM") + ")");
			КонецЦикла;
			СверкаСделана = Истина;
		Исключение
			СтрокиОтказов.Добавить("Сверка «подписан, но нет в ЧЗ» не отработала: " + Лев(ОписаниеОшибки(), 140));
		КонецПопытки;

		// Отказ, после которого документ уже переотправлен, - не работа, а история: иначе он висит
		// в логе все ГлубинаСписка суток и приучает лог не читать.
		Актуальных = 0;
		СтрокиАктуальных = Новый Массив;
		СтрокиПерекрытых = Новый Массив;
		Для Каждого ПараОтказа Из ТекстыОтказов Цикл
			Отправлен = ПоследняяОтправка.Получить(ПараОтказа.Ключ);
			Принят = ПолученоЧЗ.Получить(ПараОтказа.Ключ);
			Перекрыт = (Отправлен <> Неопределено И Принят <> Неопределено И Отправлен > Принят);
			Если Перекрыт Тогда
				СтрокиПерекрытых.Добавить("отказ перекрыт переотправкой: " + ПараОтказа.Ключ);
			Иначе
				Актуальных = Актуальных + 1;
				СтрокиАктуальных.Добавить("ОТКАЗ ЧЗ " + ПараОтказа.Ключ + " -> " + ПараОтказа.Значение);
			КонецЕсли;
		КонецЦикла;
		Для Каждого ТекстСтроки Из СтрокиАктуальных Цикл
			СтрокиОтказов.Добавить(ТекстСтроки);
		КонецЦикла;
		Для Каждого ТекстСтроки Из СтрокиПерекрытых Цикл
			СтрокиОтказов.Добавить(ТекстСтроки);
		КонецЦикла;

		Сводка = "ГИС МТ, обход за " + ГлубинаСписка + " дн.: наших исходящих " + СтатусыГИС.Количество()
			+ ", CHECKED_OK " + СчОК + ", отвергнуто " + СчНеОК + " (требуют работы " + Актуальных + ")"
			+ ", в обработке " + СчВРаботе;
		Если СверкаСделана Тогда
			Сводка = Сводка + "; подписаны покупателем, но нет в ЧЗ за " + ГлубинаСверки + " дн.: " + Пропавшие.Количество();
		КонецЕсли;
		Если СрезНеполон <> "" Тогда
			Сводка = Сводка + "; ⚠️ срез ЧЗ неполон (упор в limit " + ЛимитСписка + "): " + СрезНеполон
				+ " — список пропавших ниже считать недостоверным";
		КонецЕсли;
		Итог = Новый Массив;
		Итог.Добавить(Сводка);
		Для Каждого ТекстОтказа Из СтрокиОтказов Цикл
			Итог.Добавить(ТекстОтказа);
		КонецЦикла;
		Напечатано = 0;
		Для Каждого ТекстПропажи Из Пропавшие Цикл
			Напечатано = Напечатано + 1;
			Если Напечатано > ПоказатьМакс Тогда
				Итог.Добавить("… ещё " + (Пропавшие.Количество() - ПоказатьМакс) + " не показаны");
				Прервать;
			КонецЕсли;
			Итог.Добавить("НЕ ДОЕХАЛ В ЧЗ " + ТекстПропажи);
		КонецЦикла;
		Результат = СтрСоединить(Итог, Символы.ПС);
	Исключение
		Результат = "ОШИБКА обхода ГИС МТ: " + ОписаниеОшибки();
	КонецПопытки;

	Результат = ?(Организация = Неопределено, "", "[" + Строка(Организация) + "] ") + Результат;
	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Строка(Результат)), "ОШИБКА") > 0,
		"ЭДО.Регламент.СторожГИСМТ");
	Возврат Результат;

КонецФункции

// Контроль связей по фиксированному списку адресов 2BE: сколько в ESTABLISHED, сколько
// снова в BROKEN. Проверяет гипотезу, что разрыв связи - отложенное последствие приглашения.
Функция ВыполнитьСторожСвязей(Знач Организация = Неопределено) Экспорт

	Если Организация = Неопределено И ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Своды = Новый Массив;
		Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
			Своды.Добавить(ВыполнитьСторожСвязей(УчетнаяЗапись.Организация));
		КонецЦикла;
		Возврат СтрСоединить(Своды, Символы.ПС);
	КонецЕсли;

	Попытка
		ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
		НашГид = ЭДО_Сервер.ГидОрганизации(Организация);
		Защита = Новый ЗащищенноеСоединениеOpenSSL(Новый СертификатКлиентаWindows(), Неопределено);
		Соед = ЭДО_Сервер.СоединениеСОператором(90);   // разбор связей терпит длинный ответ
