		КонецЕсли;

		ЗаписьЖурналаРегистрации("ЭДО.КонтрольСвязей", УровеньЖурналаРегистрации.Информация, , , Лев(Текст, 5000));
		Результат = Текст;
	Исключение
		Результат = "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	Результат = ?(Организация = Неопределено, "", "[" + Строка(Организация) + "] ") + Результат;
	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Строка(Результат)), "ОШИБКА") > 0,
		"ЭДО.Регламент.СторожСвязей");
	Возврат Результат;

КонецФункции

// Сторож брошенных отметок отправки: документы, занятые прогоном и не доехавшие до конца.
// Отметка 1 ("взят в отправку") ставится до обращения к оператору, 10 - когда связь
// оборвалась до получения идентификатора; с обеими документ выпадает из работы навсегда.
// Снимать отметку вслепую нельзя: карточка у оператора могла уже создаться, и документ уйдет
// вторым экземпляром. Поэтому каждая отметка сверяется с оператором: карточка есть -
// записываем ее id, карточки нет - снимаем отметку, документ вернется в очередь.
// Работает только под замком прогона; замок занят - сторож уходит до следующего запуска.
Функция ВыполнитьСторожБрошенныхОтметок() Экспорт

	Попытка
		Если НЕ ЭДО_Сервер.ЗанятьПрогонОтправки() Тогда
			Результат = "ЭДО, брошенные отметки: идёт отправка, разбор отложен до следующего запуска";
			ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, Ложь, "ЭДО.Регламент.СторожБрошенных");
			Возврат Результат;
		КонецЕсли;

		Попытка
			Результат = РазобратьБрошенныеОтметки();
		Исключение
			Результат = "ОШИБКА: " + ОписаниеОшибки();
		КонецПопытки;
		ЭДО_Сервер.ОсвободитьПрогонОтправки();
	Исключение
		Результат = "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Строка(Результат)), "ОШИБКА") > 0,
		"ЭДО.Регламент.СторожБрошенных");
	Возврат Результат;

КонецФункции

// Разбор отметок под уже захваченным замком.
Функция РазобратьБрошенныеОтметки()

	СвойствоСтатус = ЭДО_Сервер.СвойствоОбъектов("ЭДО_КодСостояния");
	СвойствоИд = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если СвойствоСтатус = Неопределено ИЛИ СвойствоСтатус.Пустая() Тогда
		Возврат "ЭДО, брошенные отметки: свойство состояния не заведено, разбирать нечего";
	КонецЕсли;

	// Берем только отметки БЕЗ идентификатора: с идентификатором документ у оператора
	// заведомо создан, и его судьбой занимается сверка статусов, а не этот сторож.
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Сост.Объект КАК Объект,
		|	Сост.Значение КАК Код
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов КАК Сост
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Идент
		|	ПО Идент.Объект = Сост.Объект И Идент.Свойство = &СвойствоИд
		|ГДЕ Сост.Свойство = &СвойствоСтатус
		|	И (Сост.Значение = &Занят ИЛИ Сост.Значение = &Обрыв)
		|	И (Идент.Объект ЕСТЬ NULL ИЛИ Идент.Значение = """")");
	Запрос.УстановитьПараметр("СвойствоСтатус", СвойствоСтатус);
	Запрос.УстановитьПараметр("СвойствоИд", СвойствоИд);
	Запрос.УстановитьПараметр("Занят", 1);
	Запрос.УстановитьПараметр("Обрыв", 10);
	Выборка = Запрос.Выполнить().Выбрать();

	Всего = 0;
	Снято = 0;
	Закреплено = 0;
	НеОпрошено = 0;
	Примеры = Новый Массив;
	// Потолок на прогон: каждая отметка - это запрос (а то и несколько) к оператору,
	// и разбор сотен документов подряд занял бы замок на десятки минут.
	Предел = 100;

	Пока Выборка.Следующий() Цикл
		Всего = Всего + 1;
		Если Всего > Предел Тогда
			Прервать;
		КонецЕсли;

		Ссылка = Выборка.Объект;
		Опрос = ЭДО_Сервер.ЖивойЭкземплярУОператора(Ссылка);

		Если НЕ Опрос.Опрошено Тогда
			// Ничего не трогаем: неизвестность - не основание ни снять, ни закрепить.
			НеОпрошено = НеОпрошено + 1;
			Продолжить;
		КонецЕсли;

		Если Опрос.Найден Тогда
			// Документ у оператора есть - база просто не успела записать идентификатор.
			ЭДО_Сервер.ЗаписатьСтатусЭДО(Ссылка, 40, Опрос.Ид);
			Закреплено = Закреплено + 1;
			Если Примеры.Количество() < 5 Тогда
				Примеры.Добавить(СокрЛП(Строка(Ссылка)) + " → карточка " + Опрос.Ид + " " + Опрос.Статус);
			КонецЕсли;
		Иначе
			// Карточки нет - документ до оператора не доехал, возвращаем в очередь.
			ЭДО_Сервер.ОсвободитьДокумент(Ссылка);
			Снято = Снято + 1;
			Если Примеры.Количество() < 5 Тогда
				Примеры.Добавить(СокрЛП(Строка(Ссылка)) + " → отметка снята, вернётся в очередь");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Текст = "ЭДО, брошенные отметки: найдено " + Всего
		+ ", возвращено в очередь " + Снято
		+ ", закреплено по карточке оператора " + Закреплено
		+ ?(НеОпрошено > 0, ", НЕ ОПРОШЕНО " + НеОпрошено, "")
		+ ?(Всего > Предел, " (разобрано " + Предел + ", остаток — следующим прогоном)", "");
	Если Примеры.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + СтрСоединить(Примеры, Символы.ПС);
	КонецЕсли;

	Возврат Текст;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Сторож расхождений: документ правят после отправки, и у контрагента остается старый.
// Сверяются сумма документа и ИНН покупателя: с какими он ушел против того, что в базе сейчас.
// Гейт готовности этот класс не ловит: на момент отправки документ был готов.
// Сторож не чинит сам: переотправка без разбора дает контрагенту дубль, решение
// "переотправить или аннулировать" принимает человек по списку.
////////////////////////////////////////////////////////////////////////////////

// Сверить отпечаток отправки с текущим состоянием документа.
//
// ТолькоПроверка - посчитать и записать свод в журнал, но свойства не трогать.
// Единственный способ принять правку сторожа, не меняя данные в бою.
Функция ВыполнитьСторожРасхождений(Знач ТолькоПроверка = Ложь) Экспорт

	Попытка
		Результат = СверитьОтпечаткиОтправки(ТолькоПроверка);
	Исключение
		Результат = "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Строка(Результат)), "ОШИБКА") > 0,
		"ЭДО.Регламент.СторожРасхождений");
	Возврат Результат;

КонецФункции

// Разбор: сверить и проставить признак расхождения.
Функция СверитьОтпечаткиОтправки(Знач ТолькоПроверка)

	СвойствоОтпечаток = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ОтпечатокОтправки");
	СвойствоРасхождение = ЭДО_Сервер.СвойствоОбъектов("ЭДО_РасхождениеСОтправленным");
	Если СвойствоОтпечаток = Неопределено ИЛИ СвойствоОтпечаток.Пустая()
		ИЛИ СвойствоРасхождение = Неопределено ИЛИ СвойствоРасхождение.Пустая() Тогда
		Возврат "ЭДО, расхождения: свойств отпечатка нет в базе, сверять нечем";
	КонецЕсли;

	// Окно намеренно ограничено: документ годовой давности правят редко, а сверка всей
	// истории каждый час - лишняя нагрузка на ровном месте.
	ОкноДней = ЭДО_Сервер.НастройкаЭДО("ОкноСверкиРасхожденийДней");
	Если НЕ ЗначениеЗаполнено(ОкноДней) Тогда
		ОкноДней = 45;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СвОтпечаток", СвойствоОтпечаток);
	Запрос.УстановитьПараметр("СвРасхождение", СвойствоРасхождение);
	Запрос.УстановитьПараметр("Граница", НачалоДня(ТекущаяДата()) - Число(ОкноДней) * 86400);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РТУ.Ссылка КАК Ссылка,
	|	ВЫРАЗИТЬ(Отп.Значение КАК СТРОКА(50)) КАК Отпечаток,
	|	ВЫРАЗИТЬ(Расх.Значение КАК СТРОКА(50)) КАК Расхождение
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РТУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Отп
	|		ПО Отп.Объект = РТУ.Ссылка
	|			И Отп.Свойство = &СвОтпечаток
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Расх
	|		ПО Расх.Объект = РТУ.Ссылка
	|			И Расх.Свойство = &СвРасхождение
	|ГДЕ
	|	РТУ.Дата >= &Граница
	|	И РТУ.Проведен";
	Выборка = Запрос.Выполнить().Выбрать();

	Ссылки = Новый Массив;
	Хранимое = Новый Соответствие;
	Прежнее = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.Отпечаток) Тогда
			Продолжить;
		КонецЕсли;
		Ссылки.Добавить(Выборка.Ссылка);
		Хранимое.Вставить(Выборка.Ссылка, Выборка.Отпечаток);
		Прежнее.Вставить(Выборка.Ссылка, ?(Выборка.Расхождение = NULL, "", СокрЛП(Строка(Выборка.Расхождение))));
	КонецЦикла;

	Если Ссылки.Количество() = 0 Тогда
		Возврат "ЭДО, расхождения: отправленных документов с отпечатком за " + ОкноДней + " дн. нет";
	КонецЕсли;

	Текущие = ЭДО_Сервер.ОтпечаткиДокументов(Ссылки);

	Разошлось = 0;
	СменаПокупателя = 0;
	Поставлено = 0;
	Снято = 0;
	Примеры = Новый Массив;

	Для Каждого Ссылка Из Ссылки Цикл
		Было = ЭДО_Сервер.РазобратьОтпечаток(Хранимое.Получить(Ссылка));
		Стало = ЭДО_Сервер.РазобратьОтпечаток(Текущие.Получить(Ссылка));
		Если НЕ Было.Разобран ИЛИ НЕ Стало.Разобран Тогда
			Продолжить;
		КонецЕсли;

		// Хеш состава не заводим (см. ОтпечатокДокумента): пересорт "позицию заменили, сумма
		// та же" эта сверка не увидит - осознанная цена.
		СуммаРазошлась = (Макс(Было.Сумма, Стало.Сумма) - Мин(Было.Сумма, Стало.Сумма)) > 0.01;
		ПокупательСменился = Было.ЕстьИНН И Стало.ЕстьИНН И ВРег(Было.ИНН) <> ВРег(Стало.ИНН);

		Если СуммаРазошлась ИЛИ ПокупательСменился Тогда
			Разошлось = Разошлось + 1;
			Если ПокупательСменился Тогда
				СменаПокупателя = СменаПокупателя + 1;
			КонецЕсли;
			Текст = ТекстРасхожденияСОтправленным(Было, Стало, СуммаРазошлась, ПокупательСменился);
			Если Прежнее.Получить(Ссылка) <> Текст Тогда
				Если НЕ ТолькоПроверка Тогда
					ЭДО_Сервер.ЗаписатьСвойствоОбъекта(Ссылка, СвойствоРасхождение, Текст);
				КонецЕсли;
				Поставлено = Поставлено + 1;
			КонецЕсли;
			Если Примеры.Количество() < 5 Тогда
				Примеры.Добавить(СокрЛП(Строка(Ссылка)) + ": " + Текст);
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(Прежнее.Получить(Ссылка)) Тогда
			// Документ переотправили либо вернули к прежнему виду - признак снимаем сами,
			// иначе он остается навсегда и перестает что-либо значить.
			Если НЕ ТолькоПроверка Тогда
				ЭДО_Сервер.ЗаписатьСвойствоОбъекта(Ссылка, СвойствоРасхождение, "");
			КонецЕсли;
			Снято = Снято + 1;
		КонецЕсли;
	КонецЦикла;

	Текст = "ЭДО, расхождения" + ?(ТолькоПроверка, " (сухой прогон)", "") + ": проверено "
		+ Ссылки.Количество() + " за " + ОкноДней + " дн., расходится " + Разошлось
		+ " (из них сменен покупатель " + СменаПокупателя + ")"
		+ ", помечено " + Поставлено + ", снято " + Снято;
	Если Примеры.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + СтрСоединить(Примеры, Символы.ПС);
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Текст признака расхождения. Значение свойства ограничено 50 символами, поэтому при смене
// покупателя сумма упоминается одним словом: документ все равно уходит новому покупателю заново.
Функция ТекстРасхожденияСОтправленным(Знач Было, Знач Стало, Знач СуммаРазошлась, Знач ПокупательСменился)

	Если НЕ ПокупательСменился Тогда
		Возврат "сумма " + Формат(Было.Сумма, "ЧДЦ=2; ЧГ=0; ЧРД=.") + " -> "
			+ Формат(Стало.Сумма, "ЧДЦ=2; ЧГ=0; ЧРД=.");
	КонецЕсли;

	Текст = ПрефиксСменыПокупателя() + " " + ?(ЗначениеЗаполнено(Было.ИНН), Было.ИНН, "пусто")
		+ " -> " + ?(ЗначениеЗаполнено(Стало.ИНН), Стало.ИНН, "пусто");
	Если СуммаРазошлась Тогда
		Текст = Текст + ", сумма";
	КонецЕсли;

	Возврат Лев(Текст, 50);

КонецФункции

// Начало текста признака, по которому смену покупателя отличают от расхождения суммы.
Функция ПрефиксСменыПокупателя() Экспорт

	Возврат "ИНН покупателя";

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Сторож входящих запросов на аннулирование (ПОА от контрагентов).
//
// Сторож показывает запрос: на документ ставится свойство ЭДО_ЗапросАннулирования с датой
// и причиной. Сам он принимает запрос, только когда аннулируемый экземпляр уже не отражает
// документ базы: по документу отправлен другой экземпляр либо сумма документа изменилась
// после отправки. Остальное решает человек.
//
// Копии подтверждения наших аннулирований приходят тем же типом CANCELLATION в статусе SENT,
// их отличает хвост _acceptance в имени файла.
////////////////////////////////////////////////////////////////////////////////

// ТолькоПроверка - посчитать и записать свод в журнал, свойства не трогать.
Функция ВыполнитьСторожЗапросовАннулирования(Знач ТолькоПроверка = Ложь, Знач Организация = Неопределено) Экспорт

	Если Организация = Неопределено И ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Своды = Новый Массив;
		Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
			Своды.Добавить(ВыполнитьСторожЗапросовАннулирования(ТолькоПроверка, УчетнаяЗапись.Организация));
		КонецЦикла;
		Возврат СтрСоединить(Своды, Символы.ПС);
	КонецЕсли;

	Попытка
		Результат = РазобратьПредложенияАннулирования(ТолькоПроверка, Организация);
	Исключение
		Результат = "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	Результат = ?(Организация = Неопределено, "", "[" + Строка(Организация) + "] ") + Результат;
	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Строка(Результат)), "ОШИБКА") > 0,
		"ЭДО.Регламент.СторожЗапросовАннулирования");
	Возврат Результат;

КонецФункции

// Входящие запросы на аннулирование за окно, с привязкой к нашим документам.
// Возврат: Массив структур (ИдПОА, Статус, Создан, Отправитель, Подписант, Причина, ИдНашего, Номер, ДатаДок, Ссылка).
Функция ВходящиеПредложенияАннулирования(Знач ОкноДней = 62, Знач Организация = Неопределено) Экспорт

	Предложения = Новый Массив;

	ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("accept", "application/json;charset=UTF-8");
	Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
	Соед = ЭДО_Сервер.СоединениеСОператором(30);
	Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/";
	НашГид = ЭДО_Сервер.ГидОрганизации(Организация);

	// Метод отдает не больше 31 дня за запрос, окно режем кусками с конца.
	Граница = НачалоДня(ТекущаяУниверсальнаяДата()) + 86400;
	Начало = Граница - ОкноДней * 86400;
	Пока Граница > Начало Цикл
		ОтДаты = Макс(Начало, Граница - 31 * 86400);
		Для Страница = 0 По 9 Цикл
			Карточки = КарточкиОператора(Соед, Заголовки, Организация, Путь + "documents?recipient_id=" + НашГид
				+ "&type=CANCELLATION&created_from=" + ДатаДляОператора(ОтДаты)
				+ "&created_till=" + ДатаДляОператора(Граница)
				+ "&page=" + Формат(Страница, "ЧН=0; ЧГ=0") + "&page_size=100");
			Для Каждого Карточка Из Карточки Цикл
				Если ВРег(Прав(Строка(Карточка["fileId"]), 11)) = "_ACCEPTANCE" Тогда
					Продолжить;
				КонецЕсли;
				Предложения.Добавить(ОписаниеЗапросаАннулирования(Карточка));
			КонецЦикла;
			Если Карточки.Количество() < 100 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Граница = ОтДаты;
	КонецЦикла;

	// Наш документ называет только имя файла внутри ПОА, поэтому для открытых запросов
	// читаем содержимое и ищем карточку в переписке с этим контрагентом около даты файла.
	Кэш = Новый Соответствие;
	Для Каждого Предложение Из Предложения Цикл
		Если Предложение.Статус <> "SENT" Тогда
			Продолжить;
		КонецЕсли;
		ИмяФайла = ИмяАннулируемогоФайла(Соед, Заголовки, Организация, Путь + "documents/" + Предложение.ИдПОА + "/content");
		ДатаФайла = ДатаИзИмениФайла(ИмяФайла);
		Если НЕ ЗначениеЗаполнено(ДатаФайла) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Предложение.Отправитель + Формат(ДатаФайла, "ДФ=yyyyMMdd");
		Переписка = Кэш.Получить(Ключ);
		Если Переписка = Неопределено Тогда
			Переписка = КарточкиОператора(Соед, Заголовки, Организация, Путь + "documents?sender_id=" + НашГид
				+ "&recipient_id=" + Предложение.Отправитель
				+ "&created_from=" + ДатаДляОператора(ДатаФайла - 86400)
				+ "&created_till=" + ДатаДляОператора(ДатаФайла + 2 * 86400)
				+ "&page=0&page_size=100");
			Кэш.Вставить(Ключ, Переписка);
		КонецЕсли;
		Для Каждого Наш Из Переписка Цикл
			Если СтрНайти(ИмяФайла, Строка(Наш["fileId"])) = 1 Тогда
				Предложение.ИдНашего = ЭДО_Регламенты.ИдентификаторСтрокой(Наш["id"]);
				Счет = Наш.Получить("invoice");
				Если Счет <> Неопределено Тогда
					Предложение.Номер = СокрЛП(Строка(Счет.Получить("num")));
					Предложение.ДатаДок = ДатаИзДДММГГГГ(Строка(Счет.Получить("date")));
					Если ТипЗнч(Счет.Получить("sum")) = Тип("Число") Тогда
						Предложение.СуммаНашего = Счет.Получить("sum");
					КонецЕсли;
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		// Отказ универсальным сообщением статус ПОА не меняет: он остается SENT, а ответ
		// ложится в цепочку внутрь ПОА. Без этой проверки отклоненный запрос висел бы вечно.
		Если ЗначениеЗаполнено(Предложение.ИдНашего) Тогда
			Цепочка = КарточкиОператора(Соед, Заголовки, Организация, Путь + "document-flows?id=" + Предложение.ИдНашего);
			Если МыОтветилиНаПредложение(Цепочка, Предложение.ИдПОА) Тогда
				Предложение.Статус = "REJECTED";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	ПривязатьКДокументамБазы(Предложения, Организация);
	Возврат Предложения;

КонецФункции

Функция РазобратьПредложенияАннулирования(Знач ТолькоПроверка, Знач Организация = Неопределено)

	Свойство = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ЗапросАннулирования");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат "ЭДО, запросы аннулирования: ОШИБКА - нет свойства ЭДО_ЗапросАннулирования,"
			+ " нужен вызов ЭДО_Сервер.ОбеспечитьСвойстваОбъектов()";
	КонецЕсли;

	ОкноДней = 62;
	Предложения = ВходящиеПредложенияАннулирования(ОкноДней, Организация);

	Открытые = Новый Соответствие;
	Ждут = 0;
	НеНайдено = 0;
	Примеры = Новый Массив;
	Для Каждого Предложение Из Предложения Цикл
		Если Предложение.Статус <> "SENT" Тогда
			Продолжить;
		КонецЕсли;
		Ждут = Ждут + 1;
		Если Предложение.Ссылка = Неопределено Тогда
			НеНайдено = НеНайдено + 1;
		Иначе
			Текст = Лев(Формат(Предложение.Создан, "ДФ=dd.MM") + " " + СокрЛП(СтрЗаменить(Предложение.Причина, Символы.ПС, " ")), 50);
			Открытые.Вставить(Предложение.Ссылка, Текст);
		КонецЕсли;
		Если Примеры.Количество() < 20 Тогда
			Примеры.Добавить(Формат(Предложение.Создан, "ДФ=dd.MM.yyyy") + " " + ?(ЗначениеЗаполнено(Предложение.Номер), Предложение.Номер, "ид " + Предложение.ИдПОА)
				+ " - " + Предложение.Подписант + " - " + Лев(СтрЗаменить(Предложение.Причина, Символы.ПС, " "), 100));
		КонецЕсли;
	КонецЦикла;

	// Прежние пометки: снимаем там, где запрос уже закрыт или ушел за окно.
	ЗапросБазы = Новый Запрос(
		"ВЫБРАТЬ Объект КАК Объект, ВЫРАЗИТЬ(Значение КАК СТРОКА(50)) КАК Значение
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Свойство = &Свойство И ВЫРАЗИТЬ(Значение КАК СТРОКА(50)) <> """"");
	ЗапросБазы.УстановитьПараметр("Свойство", Свойство);
	Прежние = Новый Соответствие;
	Для Каждого Запись Из ЗапросБазы.Выполнить().Выгрузить() Цикл
		Прежние.Вставить(Запись.Объект, СокрЛП(Запись.Значение));
	КонецЦикла;

	Принято = 0;
	Если НЕ ТолькоПроверка Тогда
		Для Каждого Предложение Из Предложения Цикл
			Если Предложение.Статус <> "SENT" ИЛИ Предложение.Ссылка = Неопределено
				ИЛИ НЕ ЗначениеЗаполнено(Предложение.ИдНашего) Тогда
				Продолжить;
			КонецЕсли;
			Основание = ОснованиеАвтоприемаАннулирования(Предложение);
			Если НЕ ЗначениеЗаполнено(Основание) Тогда
				Продолжить;
			КонецЕсли;
			Ответ = ЭДО_Сервер.ПринятьПредложениеАннулирования(Предложение.ИдПОА, Организация);
			Если Ответ.Успех Тогда
				Принято = Принято + 1;
				Открытые.Удалить(Предложение.Ссылка);
				ЭДО_Сервер.ЗаписьЖР("ЭДО.АннулированиеПринято", "Информация", Предложение.Ссылка.Метаданные(),
					Предложение.Ссылка, "Запрос контрагента на аннулирование экземпляра " + Предложение.ИдНашего
					+ " принят автоматически: " + Основание);
			Иначе
				Примеры.Добавить("не удалось принять " + Предложение.ИдПОА + ": " + Ответ.Текст);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Поставлено = 0;
	Снято = 0;
	Для Каждого КЗ Из Открытые Цикл
		Если Прежние.Получить(КЗ.Ключ) <> КЗ.Значение Тогда
			Если НЕ ТолькоПроверка Тогда
				ЭДО_Сервер.ЗаписатьСвойствоОбъекта(КЗ.Ключ, Свойство, КЗ.Значение);
			КонецЕсли;
			Поставлено = Поставлено + 1;
		КонецЕсли;
	КонецЦикла;
	Для Каждого КЗ Из Прежние Цикл
		Если Открытые.Получить(КЗ.Ключ) = Неопределено Тогда
			Если НЕ ТолькоПроверка Тогда
				ЭДО_Сервер.ЗаписатьСвойствоОбъекта(КЗ.Ключ, Свойство, "");
			КонецЕсли;
			Снято = Снято + 1;
		КонецЕсли;
	КонецЦикла;

	Текст = "ЭДО, запросы аннулирования" + ?(ТолькоПроверка, " (сухой прогон)", "") + ": за " + ОкноДней
		+ " дн. от контрагентов " + Предложения.Количество() + ", ждут нашего ответа " + Ждут
		+ ", из них документ не найден в базе " + НеНайдено + ", принято автоматически " + Принято
		+ ", помечено " + Поставлено + ", снято " + Снято;
	Если Примеры.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + СтрСоединить(Примеры, Символы.ПС);
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Почему запрос можно принять без человека. Пустая строка - решать человеку.
Функция ОснованиеАвтоприемаАннулирования(Знач Предложение)

	Свойство = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если Свойство <> Неопределено И НЕ Свойство.Пустая() Тогда
		ТекущийИд = СокрЛП(Строка(ЭДО_Сервер.ЗначениеСвойстваОбъекта(Предложение.Ссылка, Свойство)));
		Если ЗначениеЗаполнено(ТекущийИд) И ТекущийИд <> СокрЛП(Предложение.ИдНашего) Тогда
			Возврат "по документу уже отправлен другой экземпляр " + ТекущийИд;
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(Предложение.СуммаНашего) = Тип("Число") Тогда
		СуммаДокумента = Неопределено;
		Попытка
			СуммаДокумента = Предложение.Ссылка.СуммаДокумента;
		Исключение
			СуммаДокумента = Неопределено;
		КонецПопытки;
		Если ТипЗнч(СуммаДокумента) = Тип("Число") И Окр(СуммаДокумента, 2) <> Окр(Предложение.СуммаНашего, 2) Тогда
			Возврат "сумма документа " + Формат(СуммаДокумента, "ЧДЦ=2; ЧН=0")
				+ " отличается от отправленной " + Формат(Предложение.СуммаНашего, "ЧДЦ=2; ЧН=0");
		КонецЕсли;
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ОписаниеЗапросаАннулирования(Знач Карточка)

	Предложение = Новый Структура("ИдПОА, Статус, Создан, Отправитель, Подписант, Причина, ИдНашего, Номер, ДатаДок, Ссылка, СуммаНашего",
		ЭДО_Регламенты.ИдентификаторСтрокой(Карточка["id"]), Строка(Карточка["status"]), '00010101',
		"", "", "", "", "", '00010101', Неопределено, Неопределено);

	Создан = СтрЗаменить(Лев(Строка(Карточка["created"]), 10), "-", "");
	Попытка
		Предложение.Создан = Дата(Создан);
	Исключение
		Предложение.Создан = '00010101';
	КонецПопытки;

	Отправитель = Карточка.Получить("sender");
	Если ТипЗнч(Отправитель) = Тип("Соответствие") Тогда
		Предложение.Отправитель = Строка(Отправитель.Получить("id"));
	КонецЕсли;
	Подпись = Карточка.Получить("cmsData");
	Если ТипЗнч(Подпись) = Тип("Соответствие") Тогда
		Предложение.Подписант = СтрЗаменить(Строка(Подпись.Получить("commonName")), "\", "");
	КонецЕсли;
	Доп = Карточка.Получить("extra");
	Если ТипЗнч(Доп) = Тип("Соответствие") И Доп.Получить("reason") <> Неопределено Тогда
		Предложение.Причина = Строка(Доп.Получить("reason"));
	КонецЕсли;

	Возврат Предложение;

КонецФункции

// Есть ли внутри ПОА наш ответ: универсальное сообщение с отказом или уведомление об уточнении.
Функция МыОтветилиНаПредложение(Знач Узлы, Знач ИдПОА)

	Если ТипЗнч(Узлы) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Узел Из Узлы Цикл
		Если ТипЗнч(Узел) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Подчиненные = Узел.Получить("slaves");
		Если ЭДО_Регламенты.ИдентификаторСтрокой(Узел.Получить("id")) = ИдПОА Тогда
			Если ТипЗнч(Подчиненные) <> Тип("Массив") Тогда
				Возврат Ложь;
			КонецЕсли;
			Для Каждого Ответ Из Подчиненные Цикл
				ТипОтвета = Строка(Ответ.Получить("type"));
				Если ТипОтвета = "DP_UVUTOCH" Тогда
					Возврат Истина;
				КонецЕсли;
				Сведения = Ответ.Получить("universalMessageInfo");
				Если ТипОтвета = "DP_UNISOOBSCH" И ТипЗнч(Сведения) = Тип("Соответствие")
					И Строка(Сведения.Получить("status")) = "REJECTION" Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЦикла;
			Возврат Ложь;
		КонецЕсли;
		Если МыОтветилиНаПредложение(Подчиненные, ИдПОА) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Находим документы базы по идентификатору у оператора.
Процедура ПривязатьКДокументамБазы(Предложения, Знач Организация = Неопределено)

	Иды = Новый Массив;
	Для Каждого Предложение Из Предложения Цикл
		Если ЗначениеЗаполнено(Предложение.ИдНашего) Тогда
			Иды.Добавить(Предложение.ИдНашего);
		КонецЕсли;
	КонецЦикла;
	Если Иды.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ЗапросБазы = Новый Запрос(
		"ВЫБРАТЬ Объект КАК Объект, ВЫРАЗИТЬ(Значение КАК СТРОКА(50)) КАК Ид
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Свойство = &Свойство И ВЫРАЗИТЬ(Значение КАК СТРОКА(50)) В (&Иды)");
	ЗапросБазы.УстановитьПараметр("Свойство", ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента"));
	ЗапросБазы.УстановитьПараметр("Иды", Иды);
	ПоИду = Новый Соответствие;
	Для Каждого Запись Из ЗапросБазы.Выполнить().Выгрузить() Цикл
		ПоИду.Вставить(СокрЛП(Запись.Ид), Запись.Объект);
	КонецЦикла;

	Для Каждого Предложение Из Предложения Цикл
		Если ЗначениеЗаполнено(Предложение.ИдНашего) Тогда
			Предложение.Ссылка = ПоИду.Получить(Предложение.ИдНашего);
		КонецЕсли;
		// После переотправки в базе записан ид новой копии, а контрагент просит аннулировать
		// прежнюю. Тогда ищем документ по номеру и дате из карточки оператора.
		Если Предложение.Ссылка = Неопределено И ЗначениеЗаполнено(Предложение.Номер) И ЗначениеЗаполнено(Предложение.ДатаДок) Тогда
			Предложение.Ссылка = ДокументПоНомеруИДате(Предложение.Номер, Предложение.ДатаДок, Организация);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Реализация или корректировка по номеру и дате. Дата у оператора может уехать на сутки
// из-за UTC, поэтому окно три дня; при нескольких совпадениях не выбираем ничего.
Функция ДокументПоНомеруИДате(Знач Номер, Знач ДатаДок, Знач Организация = Неопределено)

	ЗапросБазы = Новый Запрос(
		"ВЫБРАТЬ Р.Ссылка КАК Ссылка
		|ИЗ Документ.РеализацияТоваровУслуг КАК Р
		|ГДЕ Р.Номер = &Номер И Р.Дата МЕЖДУ &Нач И &Кон И НЕ Р.ПометкаУдаления
		|	И (&ВсеОрганизации ИЛИ Р.Организация.ИНН = &ИННОрганизации)
		|ОБЪЕДИНИТЬ ВСЕ
		|ВЫБРАТЬ К.Ссылка
		|ИЗ Документ.КорректировкаРеализации КАК К
		|ГДЕ К.Номер = &Номер И К.Дата МЕЖДУ &Нач И &Кон И НЕ К.ПометкаУдаления
		|	И (&ВсеОрганизации ИЛИ К.Организация.ИНН = &ИННОрганизации)");
	ЗапросБазы.УстановитьПараметр("Номер", Номер);
	ЗапросБазы.УстановитьПараметр("ВсеОрганизации", Организация = Неопределено);
	ЗапросБазы.УстановитьПараметр("ИННОрганизации", ?(Организация = Неопределено, "", СокрЛП(Организация.ИНН)));
	ЗапросБазы.УстановитьПараметр("Нач", НачалоДня(ДатаДок) - 86400);
	ЗапросБазы.УстановитьПараметр("Кон", КонецДня(ДатаДок) + 86400);
	Найдено = ЗапросБазы.Выполнить().Выгрузить();
	Если Найдено.Количество() = 1 Тогда
		Возврат Найдено[0].Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Дата из строки вида 03.09.2026.
Функция ДатаИзДДММГГГГ(Знач Текст)

	Части = СтрРазделить(СокрЛП(Текст), ".", Ложь);
	Если Части.Количество() <> 3 Тогда
		Возврат '00010101';
	КонецЕсли;
	Попытка
		Возврат Дата(Число(Части[2]), Число(Части[1]), Число(Части[0]));
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

// GET к оператору с повтором: метод периодически не отвечает и лечится повтором,
// токен живет 15 минут и на 401 перевыпускается. Возврат: Массив карточек, пустой при отказе.
Функция КарточкиОператора(Соед, Заголовки, Знач Организация, Знач Адрес)

	Для НомерПопытки = 1 По 3 Цикл
		Попытка
			Ответ = Соед.Получить(Новый HTTPЗапрос(Адрес, Заголовки));
		Исключение
			Продолжить;
		КонецПопытки;
		Если Ответ.КодСостояния = 401 Тогда
			ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
			Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
			Продолжить;
		КонецЕсли;
		Если Ответ.КодСостояния <> 200 Тогда
			ВызватьИсключение "оператор ответил HTTP " + Ответ.КодСостояния + ": " + Лев(Ответ.ПолучитьТелоКакСтроку("UTF-8"), 300);
		КонецЕсли;
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
		Карточки = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Возврат Карточки;
	КонецЦикла;

	ВызватьИсключение "оператор не ответил за три попытки: " + Адрес;

КонецФункции

// Имя файла аннулируемого документа из содержимого ПОА (атрибут ИмяАнФайла).
Функция ИмяАннулируемогоФайла(Соед, Заголовки, Знач Организация, Знач Адрес)

	Для НомерПопытки = 1 По 3 Цикл
		Попытка
			Ответ = Соед.Получить(Новый HTTPЗапрос(Адрес, Заголовки));
		Исключение
			Продолжить;
		КонецПопытки;
		Если Ответ.КодСостояния = 401 Тогда
			ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
			Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
			Продолжить;
		КонецЕсли;
		Если Ответ.КодСостояния <> 200 Тогда
			Возврат "";
		КонецЕсли;
		Текст = ПолучитьСтрокуИзДвоичныхДанных(Ответ.ПолучитьТелоКакДвоичныеДанные(), "windows-1251");
		Маркер = "ИмяАнФайла=""";
		Позиция = СтрНайти(Текст, Маркер);
		Если Позиция = 0 Тогда
			Возврат "";
		КонецЕсли;
		Хвост = Сред(Текст, Позиция + СтрДлина(Маркер));
		Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);
	КонецЦикла;

	Возврат "";

КонецФункции

// Дата из имени файла ЭДО: восьмизначная часть вида 20260903.
Функция ДатаИзИмениФайла(Знач ИмяФайла)

	Для Каждого Часть Из СтрРазделить(ИмяФайла, "_") Цикл
		Если СтрДлина(Часть) = 8 И Лев(Часть, 2) = "20" Тогда
			Попытка
				Возврат Дата(Часть);
			Исключение
				Возврат '00010101';
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	Возврат '00010101';

КонецФункции

Функция ДатаДляОператора(Знач Момент)

	Возврат Формат(Момент, "ДФ=yyyy-MM-dd") + "T" + Формат(Момент, "ДФ=HH:mm:ss") + "Z";

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Наши запросы на аннулирование, которые контрагент не подтвердил.
//
// Пока контрагент не подписал наш ПОА, исходный экземпляр у него действует, а у оператора
// ПОА просто висит в SENT. Сторож собирает наши ПОА без ответа и кладет снимок для центра
// управления: по нему бухгалтерия дожимает контрагентов. Сколько дней ждать ответа, решает
// витрина по настройке ДнейБезПодтвержденияПОА, поэтому смена срока не требует прогона.
//
// Отдельного задания нет: сторож идет следом за сторожем входящих запросов тем же заданием.
// Разбор содержимого ПОА и поиск аннулируемой карточки - те же, что у входящих.
////////////////////////////////////////////////////////////////////////////////

// Сколько дней назад смотреть наши ПОА.
Функция ОкноНашихАннулированийДней()
	Возврат 90;
КонецФункции

Функция ВыполнитьСторожНашихАннулирований() Экспорт

	Строки = Новый Массив;
	ЕстьОшибка = Ложь;

	Организации = Новый Массив;
	Если ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
			Организации.Добавить(УчетнаяЗапись.Организация);
		КонецЦикла;
	Иначе
		Организации.Добавить(Неопределено);
	КонецЕсли;

	Прежний = СнимокНашихАннулирований();
	Снимок = НовыйСнимокНашихАннулирований();

	Для Каждого Организация Из Организации Цикл
		Префикс = ?(Организация = Неопределено, "", "[" + Строка(Организация) + "] ");
		Попытка
			Сверка = НашиПредложенияАннулирования(ОкноНашихАннулированийДней(), Организация, Прежний);
			Для Каждого СтрокаСверки Из Сверка.Предложения Цикл
				ЗаполнитьЗначенияСвойств(Снимок.Предложения.Добавить(), СтрокаСверки);
			КонецЦикла;
			Строки.Добавить(Префикс + ОписаниеНашихАннулирований(Сверка));
		Исключение
			ЕстьОшибка = Истина;
			Снимок.Неполно = Истина;
			Строки.Добавить(Префикс + "ЭДО, наши запросы аннулирования: ОШИБКА " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Попытка
		УстановитьПривилегированныйРежим(Истина);
		ХранилищеОбщихНастроек.Сохранить(КлючСнимкаНашихАннулирований(), "Снимок", Снимок,
			"наши запросы аннулирования без ответа", "");
	Исключение
		ЕстьОшибка = Истина;
		Строки.Добавить("ЭДО, наши запросы аннулирования: снимок для центра не сохранен - " + ОписаниеОшибки());
	КонецПопытки;

	Результат = СтрСоединить(Строки, Символы.ПС);
	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, ЕстьОшибка, "ЭДО.Регламент.СторожНашихАннулирований");
	Возврат Результат;

КонецФункции

// Итог последнего прогона для центра управления.
// Возврат: Неопределено, если сторож еще не запускался, иначе Структура
//   ДатаПрогона, ОкноДней, Неполно - прогон прочитал оператора не целиком;
//   Предложения - ТаблицаЗначений, колонки см. НовыйСнимокНашихАннулирований.
Функция СнимокНашихАннулирований() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Значение = ХранилищеОбщихНастроек.Загрузить(КлючСнимкаНашихАннулирований(), "Снимок", , "");
	Если ТипЗнч(Значение) <> Тип("Структура") ИЛИ НЕ Значение.Свойство("Предложения") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция КлючСнимкаНашихАннулирований()
	Возврат "ЭДО_СторожНашихАннулирований";
КонецФункции

// Пустой снимок наших ПОА. Колонка Статус - SENT (ответа нет) или REJECTED (контрагент
// отклонил, у оператора ПОА остается SENT); Документ - документ базы или Неопределено,
// если аннулируемый экземпляр в базе не найден.
Функция НовыйСнимокНашихАннулирований()

	Предложения = Новый ТаблицаЗначений;
	Предложения.Колонки.Добавить("ИдПОА", Новый ОписаниеТипов("Строка"));
	Предложения.Колонки.Добавить("Создан", Новый ОписаниеТипов("Дата"));
	Предложения.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка"));
	Предложения.Колонки.Добавить("Получатель", Новый ОписаниеТипов("Строка"));
	Предложения.Колонки.Добавить("Причина", Новый ОписаниеТипов("Строка"));
	Предложения.Колонки.Добавить("ИдНашего", Новый ОписаниеТипов("Строка"));
	Предложения.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	Предложения.Колонки.Добавить("ДатаДок", Новый ОписаниеТипов("Дата"));
	Предложения.Колонки.Добавить("Документ");
	Предложения.Колонки.Добавить("Контрагент");
	Предложения.Колонки.Добавить("Организация");

	Возврат Новый Структура("ДатаПрогона, ОкноДней, Неполно, Предложения",
		ТекущаяДатаСеанса(), ОкноНашихАннулированийДней(), Ложь, Предложения);

КонецФункции

// Наши ПОА за окно, на которые контрагент не ответил согласием.
// Прежний - снимок прошлого прогона: у ПОА, уже сопоставленного с карточкой, содержимое
// повторно не читается, иначе каждый прогон стоил бы сотни запросов.
// Возврат: Структура (Наших, Ждут, Отклонено, НетВБазе, Запросов, Предложения - ТаблицаЗначений).
Функция НашиПредложенияАннулирования(Знач ОкноДней, Знач Организация, Знач Прежний)

	Итог = Новый Структура("Наших, Ждут, Отклонено, НетВБазе, Запросов, Предложения",
		0, 0, 0, 0, 0, НовыйСнимокНашихАннулирований().Предложения);

	Сопоставленные = Новый Соответствие;
	Если Прежний <> Неопределено Тогда
		Для Каждого СтрокаПрежнего Из Прежний.Предложения Цикл
			Если ЗначениеЗаполнено(СтрокаПрежнего.ИдНашего) Тогда
				Сопоставленные.Вставить(СтрокаПрежнего.ИдПОА, СтрокаПрежнего);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация) Тогда
		ВызватьИсключение "не удалось получить токен";
	КонецЕсли;
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("accept", "application/json;charset=UTF-8");
	Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
	Соед = ЭДО_Сервер.СоединениеСОператором(30);
	Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/";
	НашГид = ЭДО_Сервер.ГидОрганизации(Организация);

	// Подтвержденный ПОА у оператора ACCEPTED, у абонентов самой Платформы - SENT с newStatus
	// CANCELLED. SENDING_FAILED до контрагента не дошел, дожимать там некого.
	Предложения = Новый Массив;
	Граница = НачалоДня(ТекущаяУниверсальнаяДата()) + 86400;
	Начало = Граница - ОкноДней * 86400;
	Пока Граница > Начало Цикл
		ОтДаты = Макс(Начало, Граница - 31 * 86400);
		Для Страница = 0 По 9 Цикл
			Карточки = КарточкиОператора(Соед, Заголовки, Организация, Путь + "documents?sender_id=" + НашГид
				+ "&type=CANCELLATION&created_from=" + ДатаДляОператора(ОтДаты)
				+ "&created_till=" + ДатаДляОператора(Граница)
				+ "&page=" + Формат(Страница, "ЧН=0; ЧГ=0") + "&page_size=100");
			Итог.Запросов = Итог.Запросов + 1;
			Для Каждого Карточка Из Карточки Цикл
				Если ВРег(Прав(Строка(Карточка["fileId"]), 11)) = "_ACCEPTANCE" Тогда
					Продолжить;
				КонецЕсли;
				Итог.Наших = Итог.Наших + 1;
				Если Строка(Карточка["status"]) <> "SENT" ИЛИ Строка(Карточка["newStatus"]) <> "SENT" Тогда
					Продолжить;
				КонецЕсли;
				Предложения.Добавить(ОписаниеНашегоЗапросаАннулирования(Карточка));
			КонецЦикла;
			Если Карточки.Количество() < 100 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Граница = ОтДаты;
	КонецЦикла;

	// Аннулируемый экземпляр называет только имя файла внутри ПОА: ищем карточку в переписке
	// с получателем ПОА около даты из имени файла.
	Кэш = Новый Соответствие;
	Для Каждого Предложение Из Предложения Цикл
		СтрокаПрежнего = Сопоставленные.Получить(Предложение.ИдПОА);
		Если СтрокаПрежнего <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Предложение, СтрокаПрежнего, "ИдНашего, Номер, ДатаДок");
			Продолжить;
		КонецЕсли;

		ИмяФайла = ИмяАннулируемогоФайла(Соед, Заголовки, Организация, Путь + "documents/" + Предложение.ИдПОА + "/content");
		Итог.Запросов = Итог.Запросов + 1;
		ДатаФайла = ДатаИзИмениФайла(ИмяФайла);
		Если НЕ ЗначениеЗаполнено(ДатаФайла) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Предложение.Получатель + Формат(ДатаФайла, "ДФ=yyyyMMdd");
		Переписка = Кэш.Получить(Ключ);
		Если Переписка = Неопределено Тогда
			Переписка = КарточкиОператора(Соед, Заголовки, Организация, Путь + "documents?sender_id=" + НашГид
				+ "&recipient_id=" + Предложение.Получатель
				+ "&created_from=" + ДатаДляОператора(ДатаФайла - 86400)
				+ "&created_till=" + ДатаДляОператора(ДатаФайла + 2 * 86400)
				+ "&page=0&page_size=100");
			Итог.Запросов = Итог.Запросов + 1;
			Кэш.Вставить(Ключ, Переписка);
		КонецЕсли;
		Для Каждого Наш Из Переписка Цикл
			Если СтрНайти(ИмяФайла, Строка(Наш["fileId"])) = 1 Тогда
				Предложение.ИдНашего = ЭДО_Регламенты.ИдентификаторСтрокой(Наш["id"]);
				Счет = Наш.Получить("invoice");
				Если Счет <> Неопределено Тогда
					Предложение.Номер = СокрЛП(Строка(Счет.Получить("num")));
					Предложение.ДатаДок = ДатаИзДДММГГГГ(Строка(Счет.Получить("date")));
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Итог.Запросов = Итог.Запросов + ОтметитьОтклоненныеКонтрагентом(Предложения, Соед, Заголовки, Организация, Путь);
	ПривязатьКДокументамБазы(Предложения, Организация);
	КонтрагентыПоАдресам = КонтрагентыПоАдресуЭДО();

	Для Каждого Предложение Из Предложения Цикл
		НоваяСтрока = Итог.Предложения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Предложение, "ИдПОА, Создан, Статус, Получатель, Причина, ИдНашего, Номер, ДатаДок");
		НоваяСтрока.Документ = Предложение.Ссылка;
		НоваяСтрока.Организация = Организация;
		НоваяСтрока.Контрагент = КонтрагентыПоАдресам.Получить(Предложение.Получатель);
		Если Предложение.Ссылка = Неопределено Тогда
			Итог.НетВБазе = Итог.НетВБазе + 1;
		ИначеЕсли Предложение.Ссылка.Метаданные().Реквизиты.Найти("Контрагент") <> Неопределено Тогда
			НоваяСтрока.Контрагент = Предложение.Ссылка.Контрагент;
		КонецЕсли;
		Если Предложение.Статус = "REJECTED" Тогда
			Итог.Отклонено = Итог.Отклонено + 1;
		Иначе
			Итог.Ждут = Итог.Ждут + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

Функция ОписаниеНашегоЗапросаАннулирования(Знач Карточка)

	Предложение = Новый Структура("ИдПОА, Статус, Создан, Получатель, Причина, ИдНашего, Номер, ДатаДок, Ссылка",
		ЭДО_Регламенты.ИдентификаторСтрокой(Карточка["id"]), "SENT", '00010101', "", "", "", "", '00010101', Неопределено);

	// Оператор отдает время в UTC, в снимке - местное: с ним сравнивает витрина.
	Создан = СтрЗаменить(СтрЗаменить(СтрЗаменить(Лев(Строка(Карточка["created"]), 19), "-", ""), "T", ""), ":", "");
	Попытка
		Предложение.Создан = МестноеВремя(Дата(Создан));
	Исключение
		Предложение.Создан = '00010101';
	КонецПопытки;

	Получатель = Карточка.Получить("recipient");
	Если ТипЗнч(Получатель) = Тип("Соответствие") Тогда
		Предложение.Получатель = ВРег(СокрЛП(Строка(Получатель.Получить("id"))));
	КонецЕсли;
	Доп = Карточка.Получить("extra");
	Если ТипЗнч(Доп) = Тип("Соответствие") И Доп.Получить("reason") <> Неопределено Тогда
		Предложение.Причина = Строка(Доп.Получить("reason"));
	КонецЕсли;

	Возврат Предложение;

КонецФункции

// Отказ контрагента от нашего ПОА статус не меняет: ответ ложится внутрь ПОА в цепочке
// аннулируемого документа. Цепочки читаем пачками по 50 - больше метод не отдает.
// Возврат: число запросов к оператору.
Функция ОтметитьОтклоненныеКонтрагентом(Предложения, Соед, Заголовки, Знач Организация, Знач Путь)

	Запросов = 0;
	Пачка = Новый Массив;
	Индекс = 0;
	Для Каждого Предложение Из Предложения Цикл
		Индекс = Индекс + 1;
		Если ЗначениеЗаполнено(Предложение.ИдНашего) И Пачка.Найти(Предложение.ИдНашего) = Неопределено Тогда
			Пачка.Добавить(Предложение.ИдНашего);
		КонецЕсли;
		Если (Пачка.Количество() < 50 И Индекс < Предложения.Количество()) ИЛИ Пачка.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Цепочки = КарточкиОператора(Соед, Заголовки, Организация, Путь + "document-flows?id="
			+ СтрСоединить(Пачка, ",") + "&page=0&page_size=50");
		Запросов = Запросов + 1;
		Для Каждого Проверяемое Из Предложения Цикл
			Если Пачка.Найти(Проверяемое.ИдНашего) <> Неопределено
				И МыОтветилиНаПредложение(Цепочки, Проверяемое.ИдПОА) Тогда
				Проверяемое.Статус = "REJECTED";
			КонецЕсли;
		КонецЦикла;
		Пачка = Новый Массив;
	КонецЦикла;

	Возврат Запросов;

КонецФункции

// Соответствие "адрес ЭДО прописными" -> контрагент по свойству ЭДО_АдресКонтрагента.
Функция КонтрагентыПоАдресуЭДО()

	Результат = Новый Соответствие;
	Свойство = ЭДО_Сервер.СвойствоОбъектов("ЭДО_АдресКонтрагента", Истина);
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Объект КАК Объект, ВЫРАЗИТЬ(Значение КАК СТРОКА(100)) КАК Адрес
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Свойство = &Свойство И Объект ССЫЛКА Справочник.Контрагенты");
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Адрес = ВРег(СокрЛП(Выборка.Адрес));
		Если ЗначениеЗаполнено(Адрес) И Результат.Получить(Адрес) = Неопределено Тогда
			Результат.Вставить(Адрес, Выборка.Объект);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ОписаниеНашихАннулирований(Знач Сверка)

	Текст = "ЭДО, наши запросы аннулирования: за " + ОкноНашихАннулированийДней() + " дн. наших ПОА "
		+ Сверка.Наших + ", без ответа " + Сверка.Ждут + ", отклонено контрагентом " + Сверка.Отклонено
		+ ", документ не найден в базе " + Сверка.НетВБазе + ", запросов к оператору " + Сверка.Запросов;

	Примеры = Новый Массив;
	Для Каждого СтрокаСверки Из Сверка.Предложения Цикл
		Если Примеры.Количество() >= 20 Тогда
			Прервать;
		КонецЕсли;
		Примеры.Добавить(Формат(СтрокаСверки.Создан, "ДФ=dd.MM.yyyy") + " "
			+ ?(ЗначениеЗаполнено(СтрокаСверки.Номер), СтрокаСверки.Номер, "ПОА " + СтрокаСверки.ИдПОА)
			+ " - " + Строка(СтрокаСверки.Контрагент) + ?(СтрокаСверки.Статус = "REJECTED", " - ОТКЛОНЕН", "")
			+ " - " + Лев(СтрЗаменить(СтрокаСверки.Причина, Символы.ПС, " "), 80));
	КонецЦикла;
	Если Примеры.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + СтрСоединить(Примеры, Символы.ПС);
	КонецЕсли;

	Возврат Текст;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Аннулирование лишних экземпляров документа.
//
// У документа, отправленного несколько раз, у контрагента должен действовать один экземпляр -
// тот, чей ид записан в документе (ЭДО_ИдентификаторДокумента). По остальным действующим
// экземплярам регламент шлет предложение об аннулировании (ПОА) с причиной "дубль отправки".
// Только документы старше 7 дней: оперативную работу не трогаем.
//
// Экземпляры ищутся у оператора по текущему адресу контрагента: ушедший на прежний адрес не виден.
// Документ, у которого записанный экземпляр не среди действующих, не трогаем - это разбор для человека.
////////////////////////////////////////////////////////////////////////////////

// Сколько ПОА регламент готов отправить за прогон. Больше - признак ошибки отбора, а не
// реальных дублей: не отправляем ничего и пишем ошибку в журнал.
Функция ПотолокАннулированийЗаПрогон()
	Возврат 20;
КонецФункции

// ТолькоПроверка - найти лишние экземпляры и записать свод в журнал, ПОА не отправлять.
Функция ВыполнитьАннулированиеЛишнихЭкземпляров(Знач ТолькоПроверка = Ложь, Знач Организация = Неопределено) Экспорт

	Если Организация = Неопределено И ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Своды = Новый Массив;
		Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
			Своды.Добавить(ВыполнитьАннулированиеЛишнихЭкземпляров(ТолькоПроверка, УчетнаяЗапись.Организация));
		КонецЦикла;
		Возврат СтрСоединить(Своды, Символы.ПС);
	КонецЕсли;

	Попытка
		Результат = АннулироватьЛишниеЭкземпляры(ТолькоПроверка, Организация);
	Исключение
		Результат = "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	Результат = ?(Организация = Неопределено, "", "[" + Строка(Организация) + "] ") + Результат;
	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Строка(Результат)), "ОШИБКА") > 0,
		"ЭДО.Регламент.АннулированиеЛишнихЭкземпляров");
	Возврат Результат;

КонецФункции

Функция АннулироватьЛишниеЭкземпляры(Знач ТолькоПроверка, Знач Организация = Неопределено)

	Заголовок = "ЭДО, лишние экземпляры" + ?(ТолькоПроверка, " (сухой прогон)", "");
	СвойствоИд = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если СвойствоИд = Неопределено ИЛИ СвойствоИд.Пустая() Тогда
		Возврат Заголовок + ": ОШИБКА - нет свойства ЭДО_ИдентификаторДокумента";
	КонецЕсли;

	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	ЗапросБазы = Новый Запрос(
		"ВЫБРАТЬ Р.Ссылка КАК Ссылка, ВЫРАЗИТЬ(З.Значение КАК СТРОКА(50)) КАК Ид
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов КАК З
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Р
		|	ПО З.Объект = Р.Ссылка
		|ГДЕ З.Свойство = &Свойство
		|	И ВЫРАЗИТЬ(З.Значение КАК СТРОКА(50)) <> """"
		|	И Р.Дата МЕЖДУ &Начало И &Конец
		|	И НЕ Р.ПометкаУдаления
		|	И (&ВсеОрганизации ИЛИ Р.Организация.ИНН = &ИННОрганизации)");
	ЗапросБазы.УстановитьПараметр("Свойство", СвойствоИд);
	ЗапросБазы.УстановитьПараметр("Начало", Сегодня - 14 * 86400);
	ЗапросБазы.УстановитьПараметр("Конец", Сегодня - 7 * 86400 - 1);
	ЗапросБазы.УстановитьПараметр("ВсеОрганизации", Организация = Неопределено);
	ЗапросБазы.УстановитьПараметр("ИННОрганизации", ?(Организация = Неопределено, "", СокрЛП(Организация.ИНН)));
	ОтправленныеДокументы = ЗапросБазы.Выполнить().Выгрузить();

	Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация) Тогда
		Возврат Заголовок + ": ОШИБКА - не удалось получить токен";
	КонецЕсли;
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("accept", "application/json;charset=UTF-8");
	Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
	Соединение = ЭДО_Сервер.СоединениеСОператором(5);
	НашГид = ЭДО_Сервер.ГидОрганизации(Организация);

	Предложенные = ПредложенныеАннулирования();
	Кандидаты = Новый Массив;
	НеОпрошено = 0;
	БезАдреса = 0;
	ТекущийНеДействует = 0;
	УжеПредложено = 0;
	Черновики = 0;
	Примеры = Новый Массив;
	Для Каждого СтрокаДокумента Из ОтправленныеДокументы Цикл
		ГидПолучателя = ЭДО_Сервер.ИдентификаторУчастникаЭДО(СтрокаДокумента.Ссылка.Контрагент);
		Если НЕ ЗначениеЗаполнено(ГидПолучателя) Тогда
			БезАдреса = БезАдреса + 1;
			Продолжить;
		КонецЕсли;
		Опрос = ЭДО_Сервер.КарточкиДокументаУОператора(Соединение, Заголовки, НашГид, ГидПолучателя,
			СокрЛП(СтрокаДокумента.Ссылка.Номер), СтрокаДокумента.Ссылка.Дата);
		Если НЕ Опрос.Опрошено Тогда
			НеОпрошено = НеОпрошено + 1;
			Продолжить;
		КонецЕсли;

		ТекущийИд = СокрЛП(СтрокаДокумента.Ид);
		Лишние = Новый Массив;
		ТекущийДействует = Ложь;
		Для Каждого Карточка Из Опрос.Карточки Цикл
			Если НЕ Карточка.Живая Тогда
				Продолжить;
			ИначеЕсли НЕ КарточкаУшлаКонтрагенту(Карточка.Статус) Тогда
				Черновики = Черновики + 1;
				Продолжить;
			ИначеЕсли Карточка.Ид = ТекущийИд Тогда
				ТекущийДействует = Истина;
			Иначе
				Лишние.Добавить(Карточка.Ид);
			КонецЕсли;
		КонецЦикла;
		Если Лишние.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ТекущийДействует Тогда
			ТекущийНеДействует = ТекущийНеДействует + 1;
			Если Примеры.Количество() < 20 Тогда
				Примеры.Добавить(СокрЛП(СтрокаДокумента.Ссылка.Номер) + ": записанный экземпляр " + ТекущийИд
					+ " не действует, действуют " + СтрСоединить(Лишние, ", ") + " - пропущен");
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Для Каждого ИдЛишнего Из Лишние Цикл
			Если Предложенные.Получить(ИдЛишнего) <> Неопределено Тогда
				УжеПредложено = УжеПредложено + 1;
				Продолжить;
			КонецЕсли;
			Кандидаты.Добавить(Новый Структура("Ссылка, ИдЛишнего, ТекущийИд", СтрокаДокумента.Ссылка, ИдЛишнего, ТекущийИд));
		КонецЦикла;
	КонецЦикла;

	Отправлено = 0;
	Ошибки = 0;
	Если Кандидаты.Количество() > ПотолокАннулированийЗаПрогон() Тогда
		Примеры.Вставить(0, "ОШИБКА - лишних экземпляров " + Кандидаты.Количество() + ", больше потолка "
			+ ПотолокАннулированийЗаПрогон() + ": ничего не отправлено, нужен разбор");
	Иначе
		Для Каждого Кандидат Из Кандидаты Цикл
			Описание = СокрЛП(Кандидат.Ссылка.Номер) + " экземпляр " + Кандидат.ИдЛишнего
				+ " (действует " + Кандидат.ТекущийИд + ")";
			Если ТолькоПроверка Тогда
				Если Примеры.Количество() < 20 Тогда
					Примеры.Добавить(Описание);
				КонецЕсли;
				Продолжить;
			КонецЕсли;

			Ответ = ЭДО_Сервер.ПредложитьАннулирование(Кандидат.ИдЛишнего, ЭДО_Сервер.ПричинаАннулированияДубля(), Кандидат.Ссылка);
			Если Ответ.Успех Тогда
				Отправлено = Отправлено + 1;
				Предложенные.Вставить(Кандидат.ИдЛишнего, ТекущаяДатаСеанса());
				ЭДО_Сервер.ЗаписьЖР("ЭДО.АннулированиеПредложено", "Информация", Кандидат.Ссылка.Метаданные(),
					Кандидат.Ссылка, "Лишний экземпляр " + Кандидат.ИдЛишнего + " (действует " + Кандидат.ТекущийИд
					+ "): " + Ответ.Текст);
			Иначе
				Ошибки = Ошибки + 1;
				Примеры.Добавить("ОШИБКА " + Описание + ": " + Ответ.Текст);
			КонецЕсли;
		КонецЦикла;
		Если Отправлено > 0 Тогда
			СохранитьПредложенныеАннулирования(Предложенные);
		КонецЕсли;
	КонецЕсли;

	Текст = Заголовок + ": документов " + ОтправленныеДокументы.Количество() + " (" + Формат(Сегодня - 14 * 86400, "ДФ=dd.MM")
		+ "-" + Формат(Сегодня - 7 * 86400 - 1, "ДФ=dd.MM") + "), не опрошено " + НеОпрошено
		+ ", без адреса " + БезАдреса + ", записанный экземпляр не действует " + ТекущийНеДействует
		+ ", неотправленных черновиков " + Черновики
		+ ", лишних " + Кандидаты.Количество() + ", уже предлагали " + УжеПредложено
		+ ", отправлено ПОА " + Отправлено + ", ошибок " + Ошибки;
	Если Примеры.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + СтрСоединить(Примеры, Символы.ПС);
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Дошел ли экземпляр до контрагента. Черновик (NEW) и экземпляр, ждущий подписи или оплаты
// (AWAIT_...), контрагент не получал: аннулировать там нечего.
Функция КарточкаУшлаКонтрагенту(Знач Статус)

	Статус = ВРег(СокрЛП(Статус));
	Возврат Статус <> "NEW" И Лев(Статус, 6) <> "AWAIT_";

КонецФункции

// Экземпляры, по которым регламент уже отправил ПОА: Соответствие "ид экземпляра" -> дата.
// Нужно, чтобы после отказа контрагента не слать ему то же предложение каждый день.
Функция ПредложенныеАннулирования()

	УстановитьПривилегированныйРежим(Истина);
	Значение = ХранилищеОбщихНастроек.Загрузить("ЭДО_АннулированиеЛишних", "Предложенные", , "");
	Предложенные = Новый Соответствие;
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Граница = ТекущаяДатаСеанса() - 90 * 86400;
		Для Каждого КЗ Из Значение Цикл
			Если КЗ.Значение > Граница Тогда
				Предложенные.Вставить(КЗ.Ключ, КЗ.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Предложенные;

КонецФункции

Процедура СохранитьПредложенныеАннулирования(Знач Предложенные)

	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить("ЭДО_АннулированиеЛишних", "Предложенные", Предложенные, , "");

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Сторож адреса получателя: документ ушел не туда, куда контрагенту надо слать сегодня.
//
// Документ помнит адрес, на который его отправили, карточка контрагента - адрес, куда слать
// сейчас. Расходятся они молча: у оператора документ честно SENT, ошибки нет.
//
// Расхождение - только SENT и DELIVERED. ACCEPTED в прежнем ящике трогать нельзя (контрагент
// подписал), REJECTED и SENDING_FAILED - другие классы, их ведут свои механизмы.
//
// Заодно сторож перечисляет контрагентов с живой связью, у которых нет адреса: адреса ЭДО
// (при отгрузках за окно) или почтового адреса, без которого оператор бракует УПД.
//
// Сторож только сообщает: ничего не переотправляет и адреса не меняет.
////////////////////////////////////////////////////////////////////////////////

// Сколько дней назад смотреть карточки оператора.
Функция ОкноСторожаАдресовДней()
	Возврат 45;
КонецФункции

// Сколько строк списка писать в журнал: запись журнала режется на 5000 символов.
Функция СтрокСпискаАдресов()
	Возврат 25;
КонецФункции

Функция ВыполнитьСторожАдресовПолучателя() Экспорт

	Строки = Новый Массив;
	ЕстьОшибка = Ложь;

	Организации = Новый Массив;
	Если ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
			Организации.Добавить(УчетнаяЗапись.Организация);
		КонецЦикла;
	Иначе
		Организации.Добавить(Неопределено);
	КонецЕсли;

	Снимок = НовыйСнимокСторожаАдресов();

	Для Каждого Организация Из Организации Цикл
		Префикс = ?(Организация = Неопределено, "", "[" + Строка(Организация) + "] ");
		Попытка
			Сверка = РасхожденияАдресовПолучателя(ОкноСторожаАдресовДней(), Организация);
			Строки.Добавить(Префикс + ОписаниеСверкиАдресов(Сверка));
			ДобавитьСверкуВСнимок(Снимок, Сверка);
			Если Сверка.НеполныхДней > 0 ИЛИ Сверка.ПереполненоДней > 0 Тогда
				Снимок.Неполно = Истина;
			КонецЕсли;
			Если Сверка.НеполныхДней > 0 Тогда
				ЕстьОшибка = Истина;
			КонецЕсли;
		Исключение
			ЕстьОшибка = Истина;
			Снимок.Неполно = Истина;
			Строки.Добавить(Префикс + "ЭДО, адрес получателя: ОШИБКА " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Попытка
		Карточки = КарточкиСЖивойСвязьюБезАдреса(ОкноСторожаАдресовДней());
		Строки.Добавить(ОписаниеКарточекБезАдреса(Карточки));
		Снимок.БезАдреса = Карточки;
	Исключение
		ЕстьОшибка = Истина;
		Строки.Добавить("ЭДО, живая связь без адреса: ОШИБКА " + ОписаниеОшибки());
	КонецПопытки;

	// Снимок читает центр управления. Его сбой не должен терять запись журнала.
	Попытка
		СохранитьСнимокСторожаАдресов(Снимок);
	Исключение
		ЕстьОшибка = Истина;
		Строки.Добавить("ЭДО, адрес получателя: снимок для центра не сохранен - " + ОписаниеОшибки());
	КонецПопытки;

	Результат = СтрСоединить(Строки, Символы.ПС);
	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, ЕстьОшибка, "ЭДО.Регламент.СторожАдресовПолучателя");
	Возврат Результат;

КонецФункции

// Итог последнего прогона сторожа адреса получателя для центра управления.
// Возврат: Неопределено, если сторож еще не запускался, иначе Структура
//   ДатаПрогона, ОкноДней, Неполно - прогон прочитал оператора не целиком;
//   Расхождения - ТаблицаЗначений (Документ, Контрагент, Ид, Статус, ОтправленоНа, ТекущийАдрес, Сумма);
//   БезАдреса - ТаблицаЗначений (Контрагент, Связь, ЕстьАдресЭДО, ЕстьАдресКИ).
Функция СнимокСторожаАдресов() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Значение = ХранилищеОбщихНастроек.Загрузить(КлючСнимкаСторожаАдресов(), "Снимок", , "");
	Если ТипЗнч(Значение) <> Тип("Структура") ИЛИ НЕ Значение.Свойство("Расхождения") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция КлючСнимкаСторожаАдресов()
	Возврат "ЭДО_СторожАдресовПолучателя";
КонецФункции

Функция НовыйСнимокСторожаАдресов()

	Расхождения = Новый ТаблицаЗначений;
	Расхождения.Колонки.Добавить("Документ");
	Расхождения.Колонки.Добавить("Контрагент");
	Расхождения.Колонки.Добавить("Ид", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("ОтправленоНа", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("ТекущийАдрес", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));

	БезАдреса = Новый ТаблицаЗначений;
	БезАдреса.Колонки.Добавить("Контрагент");
	БезАдреса.Колонки.Добавить("Связь", Новый ОписаниеТипов("Строка"));
	БезАдреса.Колонки.Добавить("ЕстьАдресЭДО", Новый ОписаниеТипов("Булево"));
	БезАдреса.Колонки.Добавить("ЕстьАдресКИ", Новый ОписаниеТипов("Булево"));

	Возврат Новый Структура("ДатаПрогона, ОкноДней, Неполно, Расхождения, БезАдреса",
		ТекущаяДатаСеанса(), ОкноСторожаАдресовДней(), Ложь, Расхождения, БезАдреса);

КонецФункции

Процедура ДобавитьСверкуВСнимок(Снимок, Знач Сверка)

	Для Каждого СтрокаСверки Из Сверка.Расхождения Цикл
		ЗаполнитьЗначенияСвойств(Снимок.Расхождения.Добавить(), СтрокаСверки);
	КонецЦикла;

КонецПроцедуры

Процедура СохранитьСнимокСторожаАдресов(Знач Снимок)

	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить(КлючСнимкаСторожаАдресов(), "Снимок", Снимок,
		"итог сторожа адреса получателя", "");

КонецПроцедуры

// Отправленные документы, чья действующая карточка у оператора ушла не на текущий адрес контрагента.
//
// Карточки обходятся по суткам: интервал шире суток с постраничным обходом теряет часть карточек.
// С документом базы карточка сопоставляется по ЭДО_ИдентификаторДокумента, поэтому прежние
// экземпляры переотправленного документа в сверку не попадают.
//
// Возврат: Структура
//   Расхождения - ТаблицаЗначений (Документ, Контрагент, Ид, Статус, ОтправленоНа, ТекущийАдрес, Сумма, Документов);
//   Отправленных, Сверено, НетВБазе, НеполныхДней, ПереполненоДней, Запросов, Ошибки, ОкноДней - счетчики.
Функция РасхожденияАдресовПолучателя(Знач ОкноДней = 45, Знач Организация = Неопределено) Экспорт

	Итог = Новый Структура("Отправленных, Сверено, НетВБазе, НеполныхДней, ПереполненоДней, Запросов, Ошибки, ОкноДней, Расхождения",
		0, 0, 0, 0, 0, 0, "", ОкноДней, Неопределено);

	Расхождения = Новый ТаблицаЗначений;
	Расхождения.Колонки.Добавить("Документ");
	Расхождения.Колонки.Добавить("Контрагент");
	Расхождения.Колонки.Добавить("Ид", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("ОтправленоНа", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("ТекущийАдрес", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Расхождения.Колонки.Добавить("Документов", Новый ОписаниеТипов("Число"));
	Итог.Расхождения = Расхождения;

	СвойствоИд = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента", Истина);
	СвойствоАдреса = ЭДО_Сервер.СвойствоОбъектов("ЭДО_АдресКонтрагента", Истина);

	Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация) Тогда
		ВызватьИсключение "не удалось получить токен";
	КонецЕсли;
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("accept", "application/json;charset=UTF-8");
	Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
	Соединение = ЭДО_Сервер.СоединениеСОператором(30);
	Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/documents?sender_id=" + ЭДО_Сервер.ГидОрганизации(Организация);

	// Ид карточки -> Структура(Получатель, Статус, Сумма): только отправленные и доставленные.
	Отправленные = Новый Соответствие;
	РазмерСтраницы = 100;
	Финиш = НачалоДня(ТекущаяУниверсальнаяДата());
	Интервалы = Новый Массив;
	День = Финиш - (ОкноДней - 1) * 86400;
	Пока День <= Финиш Цикл
		Интервалы.Добавить(Новый Структура("Начало, Конец", День, День + 86399));
		День = День + 86400;
	КонецЦикла;

	// Оператор отвечает HTTP 400 на page=10, поэтому из интервала видно не больше 1000 карточек.
	// Упершийся в потолок интервал делится пополам и обходится заново: повтор безопасен,
	// карточки складываются по ид. Потолок числа интервалов - на случай аварии выдачи.
	ПотолокИнтервалов = ОкноДней * 32;
	Индекс = 0;
	Пока Индекс < Интервалы.Количество() Цикл
		Интервал = Интервалы[Индекс];
		Индекс = Индекс + 1;
		Попытка
			Для Страница = 0 По 9 Цикл
				Карточки = КарточкиОператора(Соединение, Заголовки, Организация, Путь
					+ "&created_from=" + ДатаДляОператора(Интервал.Начало)
					+ "&created_till=" + ДатаДляОператора(Интервал.Конец)
					+ "&page=" + Формат(Страница, "ЧН=0; ЧГ=0") + "&page_size=" + Формат(РазмерСтраницы, "ЧГ=0"));
				Итог.Запросов = Итог.Запросов + 1;
				Для Каждого Карточка Из Карточки Цикл
					ДобавитьОтправленнуюКарточку(Отправленные, Карточка);
				КонецЦикла;
				Если Карточки.Количество() < РазмерСтраницы Тогда
					Прервать;
				КонецЕсли;
				Если Страница < 9 Тогда
					Продолжить;
				КонецЕсли;
				Середина = Интервал.Начало + Цел((Интервал.Конец - Интервал.Начало) / 2);
				Если Интервалы.Количество() + 2 > ПотолокИнтервалов ИЛИ Середина <= Интервал.Начало Тогда
					Итог.ПереполненоДней = Итог.ПереполненоДней + 1;
				Иначе
					Интервалы.Добавить(Новый Структура("Начало, Конец", Интервал.Начало, Середина));
					Интервалы.Добавить(Новый Структура("Начало, Конец", Середина + 1, Интервал.Конец));
				КонецЕсли;
			КонецЦикла;
		Исключение
			Итог.НеполныхДней = Итог.НеполныхДней + 1;
			Если НЕ ЗначениеЗаполнено(Итог.Ошибки) Тогда
				Итог.Ошибки = Формат(Интервал.Начало, "ДФ=dd.MM HH:mm") + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;

	Итог.Отправленных = Отправленные.Количество();
	Если Отправленные.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;

	Иды = Новый Массив;
	Для Каждого КЗ Из Отправленные Цикл
		Иды.Добавить(КЗ.Ключ);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЗначениеИд.Значение КАК СТРОКА(50)) КАК Ид,
	|	ЗначениеИд.Объект КАК ДокументБазы,
	|	ВЫБОР
	|		КОГДА ЗначениеИд.Объект ССЫЛКА Документ.РеализацияТоваровУслуг
	|			ТОГДА ВЫРАЗИТЬ(ЗначениеИд.Объект КАК Документ.РеализацияТоваровУслуг).Контрагент
	|		КОГДА ЗначениеИд.Объект ССЫЛКА Документ.КорректировкаРеализации
	|			ТОГДА ВЫРАЗИТЬ(ЗначениеИд.Объект КАК Документ.КорректировкаРеализации).Контрагент
	|		КОГДА ЗначениеИд.Объект ССЫЛКА Документ.АктСверкиВзаиморасчетов
	|			ТОГДА ВЫРАЗИТЬ(ЗначениеИд.Объект КАК Документ.АктСверкиВзаиморасчетов).Контрагент
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Контрагент
	|ПОМЕСТИТЬ ДокументыСИд
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначениеИд
	|ГДЕ
	|	ЗначениеИд.Свойство = &СвойствоИд
	|	И ВЫРАЗИТЬ(ЗначениеИд.Значение КАК СТРОКА(50)) В (&Иды)
	|;
	|ВЫБРАТЬ
	|	Док.Ид КАК Ид,
	|	Док.ДокументБазы КАК ДокументБазы,
	|	Док.Контрагент КАК Контрагент,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Адрес.Значение КАК СТРОКА(50)), """") КАК ТекущийАдрес
	|ИЗ
	|	ДокументыСИд КАК Док
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Адрес
	|		ПО Адрес.Объект = Док.Контрагент
	|			И Адрес.Свойство = &СвойствоАдреса";
	Запрос.УстановитьПараметр("СвойствоИд", СвойствоИд);
	Запрос.УстановитьПараметр("СвойствоАдреса", СвойствоАдреса);
	Запрос.УстановитьПараметр("Иды", Иды);
	Выборка = Запрос.Выполнить().Выбрать();

	Найдено = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Ид = СокрЛП(Выборка.Ид);
		Отправленная = Отправленные.Получить(Ид);
		Если Отправленная = Неопределено ИЛИ Найдено.Получить(Ид) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Найдено.Вставить(Ид, Истина);
		Итог.Сверено = Итог.Сверено + 1;

		ТекущийАдрес = ВРег(СокрЛП(Выборка.ТекущийАдрес));
		Если ТекущийАдрес = Отправленная.Получатель Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Расхождения.Добавить();
		НоваяСтрока.Документ = Выборка.ДокументБазы;
		НоваяСтрока.Контрагент = Выборка.Контрагент;
		НоваяСтрока.Ид = Ид;
		НоваяСтрока.Статус = Отправленная.Статус;
		НоваяСтрока.ОтправленоНа = Отправленная.Получатель;
		НоваяСтрока.ТекущийАдрес = ТекущийАдрес;
		НоваяСтрока.Сумма = Отправленная.Сумма;
		НоваяСтрока.Документов = 1;
	КонецЦикла;

	Итог.НетВБазе = Отправленные.Количество() - Итог.Сверено;
	Возврат Итог;

КонецФункции

Процедура ДобавитьОтправленнуюКарточку(Отправленные, Знач Карточка)

	Если ТипЗнч(Карточка) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	Статус = ВРег(СокрЛП(Строка(Карточка.Получить("status"))));
	Если Статус <> "SENT" И Статус <> "DELIVERED" Тогда
		Возврат;
	КонецЕсли;
	Получатель = Карточка.Получить("recipient");
	Если ТипЗнч(Получатель) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	Сумма = 0;
	Счет = Карточка.Получить("invoice");
	Если ТипЗнч(Счет) = Тип("Соответствие") И ТипЗнч(Счет.Получить("sum")) = Тип("Число") Тогда
		Сумма = Счет.Получить("sum");
	КонецЕсли;

	Отправленные.Вставить(ЭДО_Регламенты.ИдентификаторСтрокой(Карточка.Получить("id")),
		Новый Структура("Получатель, Статус, Сумма", ВРег(СокрЛП(Строка(Получатель.Получить("id")))), Статус, Сумма));

КонецПроцедуры

Функция ОписаниеСверкиАдресов(Знач Сверка)

	Расхождения = Сверка.Расхождения;
	СуммаВсего = Расхождения.Итог("Сумма");
	БезАдреса = Расхождения.НайтиСтроки(Новый Структура("ТекущийАдрес", "")).Количество();

	Текст = "ЭДО, адрес получателя: за " + Формат(Сверка.ОкноДней, "ЧН=0; ЧГ=0") + " дн. у оператора отправлено и доставлено "
		+ Формат(Сверка.Отправленных, "ЧН=0; ЧГ=0")
		+ ", сверено с базой " + Формат(Сверка.Сверено, "ЧН=0; ЧГ=0") + ", нет в базе " + Формат(Сверка.НетВБазе, "ЧН=0; ЧГ=0")
		+ ", ушли не на текущий адрес " + Формат(Расхождения.Количество(), "ЧН=0; ЧГ=0")
		+ " на " + Формат(СуммаВсего, "ЧДЦ=2; ЧН=0; ЧГ=0; ЧРД=.") + " руб."
		+ ?(БезАдреса > 0, ", из них у контрагента адреса нет вовсе " + Формат(БезАдреса, "ЧГ=0"), "")
		+ ", запросов " + Формат(Сверка.Запросов, "ЧН=0; ЧГ=0");
	Если Сверка.ПереполненоДней > 0 Тогда
		Текст = Текст + Символы.ПС + "НЕПОЛНО: интервалов, где карточек больше 1000 и делить дальше нельзя, - " + Формат(Сверка.ПереполненоДней, "ЧГ=0");
	КонецЕсли;
	Если Сверка.НеполныхДней > 0 Тогда
		Текст = Текст + Символы.ПС + "ОШИБКА: не прочитано интервалов " + Формат(Сверка.НеполныхДней, "ЧГ=0") + ", первая - " + Сверка.Ошибки;
	КонецЕсли;
	Если Расхождения.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Группы = Расхождения.Скопировать(, "Контрагент, ОтправленоНа, ТекущийАдрес, Сумма, Документов");
	Группы.Свернуть("Контрагент, ОтправленоНа, ТекущийАдрес", "Сумма, Документов");
	Группы.Сортировать("Сумма Убыв");
	Счетчик = 0;
	Для Каждого Группа Из Группы Цикл
		Счетчик = Счетчик + 1;
		Если Счетчик > СтрокСпискаАдресов() Тогда
			Текст = Текст + Символы.ПС + "... и еще групп " + Формат(Группы.Количество() - СтрокСпискаАдресов(), "ЧГ=0");
			Прервать;
		КонецЕсли;
		Текст = Текст + Символы.ПС + СокрЛП(Строка(Группа.Контрагент)) + ": " + Формат(Группа.Документов, "ЧГ=0")
			+ " док. на " + Формат(Группа.Сумма, "ЧДЦ=2; ЧН=0; ЧГ=0; ЧРД=.") + ", ушли на " + Группа.ОтправленоНа
			+ ", сейчас " + ?(ЗначениеЗаполнено(Группа.ТекущийАдрес), Группа.ТекущийАдрес, "адреса нет");
	КонецЦикла;

	Возврат Текст;

КонецФункции

// Контрагенты с живой связью (ESTABLISHED, DIRECT), у которых нет адреса: адреса ЭДО при
// отгрузках за окно либо почтового адреса по той же цепочке, что и гейт отправки
// (карточка, затем карточка-тезка по ИНН).
// Возврат: ТаблицаЗначений (Контрагент, Связь, ЕстьАдресЭДО, ЕстьАдресКИ).
Функция КарточкиСЖивойСвязьюБезАдреса(Знач ОкноДней = 45) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = ЭДО_Сервер.ТекстТаблицАдресаПокупателя() + "
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Реализация.Контрагент КАК Контрагент
	|ПОМЕСТИТЬ СОтгрузками
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализация
	|ГДЕ
	|	Реализация.Дата >= &Граница
	|	И Реализация.Проведен
	|ИНДЕКСИРОВАТЬ ПО
	|	Контрагент
	|;
	|ВЫБРАТЬ
	|	Карточка.Ссылка КАК Контрагент,
	|	ВЫРАЗИТЬ(Связь.Значение КАК СТРОКА(50)) КАК Связь,
	|	НЕ АдресЭДО.Объект ЕСТЬ NULL КАК ЕстьАдресЭДО,
	|	НЕ (САдресом.Контрагент ЕСТЬ NULL И ИННСАдресом.ИНН ЕСТЬ NULL) КАК ЕстьАдресКИ
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК Связь
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Карточка
	|		ПО Связь.Объект = Карточка.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК АдресЭДО
	|		ПО АдресЭДО.Объект = Карточка.Ссылка
	|			И АдресЭДО.Свойство = &СвойствоАдреса
	|			И ВЫРАЗИТЬ(АдресЭДО.Значение КАК СТРОКА(50)) <> """"
	|		ЛЕВОЕ СОЕДИНЕНИЕ КарточкиСАдресом КАК САдресом
	|		ПО САдресом.Контрагент = Карточка.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ИННСАдресом КАК ИННСАдресом
	|		ПО ИННСАдресом.ИНН = Карточка.ИНН
	|			И НЕ Карточка.ИНН = """"
	|		ЛЕВОЕ СОЕДИНЕНИЕ СОтгрузками КАК СОтгрузками
	|		ПО СОтгрузками.Контрагент = Карточка.Ссылка
	|ГДЕ
	|	Связь.Свойство = &СвойствоСвязи
	|	И ВЫРАЗИТЬ(Связь.Значение КАК СТРОКА(50)) В (&ЖивыеСвязи)
	|	И НЕ Карточка.ПометкаУдаления
	|	И (АдресЭДО.Объект ЕСТЬ NULL
	|				И НЕ СОтгрузками.Контрагент ЕСТЬ NULL
	|			ИЛИ САдресом.Контрагент ЕСТЬ NULL
	|				И ИННСАдресом.ИНН ЕСТЬ NULL)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Карточка.Наименование";
	ЭДО_Сервер.УстановитьПараметрыАдресаПокупателя(Запрос);
	ЖивыеСвязи = Новый Массив;
	ЖивыеСвязи.Добавить("ESTABLISHED");
	ЖивыеСвязи.Добавить("DIRECT");
	Запрос.УстановитьПараметр("ЖивыеСвязи", ЖивыеСвязи);
	Запрос.УстановитьПараметр("СвойствоСвязи", ЭДО_Сервер.СвойствоОбъектов("ЭДО_СтатусСвязи", Истина));
	Запрос.УстановитьПараметр("СвойствоАдреса", ЭДО_Сервер.СвойствоОбъектов("ЭДО_АдресКонтрагента", Истина));
	Запрос.УстановитьПараметр("Граница", НачалоДня(ТекущаяДатаСеанса()) - ОкноДней * 86400);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ОписаниеКарточекБезАдреса(Знач Карточки)

	БезАдресаЭДО = Карточки.НайтиСтроки(Новый Структура("ЕстьАдресЭДО", Ложь)).Количество();
	БезАдресаКИ = Карточки.НайтиСтроки(Новый Структура("ЕстьАдресКИ", Ложь)).Количество();
	Текст = "ЭДО, живая связь без адреса: контрагентов " + Формат(Карточки.Количество(), "ЧН=0; ЧГ=0")
		+ ", без адреса ЭДО при отгрузках за окно " + Формат(БезАдресаЭДО, "ЧН=0; ЧГ=0")
		+ ", без почтового адреса (и у тезок по ИНН) " + Формат(БезАдресаКИ, "ЧН=0; ЧГ=0");

	Счетчик = 0;
	Для Каждого Карточка Из Карточки Цикл
		Счетчик = Счетчик + 1;
		Если Счетчик > СтрокСпискаАдресов() Тогда
			Текст = Текст + Символы.ПС + "... и еще " + Формат(Карточки.Количество() - СтрокСпискаАдресов(), "ЧГ=0");
			Прервать;
		КонецЕсли;
		НетАдресов = Новый Массив;
		Если НЕ Карточка.ЕстьАдресЭДО Тогда
			НетАдресов.Добавить("адреса ЭДО");
		КонецЕсли;
		Если НЕ Карточка.ЕстьАдресКИ Тогда
			НетАдресов.Добавить("почтового адреса");
		КонецЕсли;
		Текст = Текст + Символы.ПС + СокрЛП(Строка(Карточка.Контрагент)) + " (" + Карточка.Связь + "): нет "
			+ СтрСоединить(НетАдресов, " и ");
	КонецЦикла;

	Возврат Текст;

КонецФункции
