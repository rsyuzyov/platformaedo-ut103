		КонецЦикла;

		Итог = "контроль связей 2BE: всего " + Адреса.Количество()
			+ ", ESTABLISHED " + Est + ", BROKEN " + Brk + ", нет записи " + Нет + ", прочее " + Проч
			+ ?(Brk > 1, "  <-- ОТВАЛИЛИСЬ ПОВТОРНО, гипотеза про приглашение подтверждается", "");
