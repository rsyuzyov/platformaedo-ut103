////////////////////////////////////////////////////////////////////////////////
// Окно «Настройки ЭДО»: флаги ЭДО контрагентов галочками вместо дополнительных реквизитов.
// ЩА 15.10.2026 [yan]: решение владельца. Данные - те же свойства объектов, логика ядра не меняется:
// окно только читает и пишет значения через функции ЭДО_Сервер. Менять может право «Администрирование»
// или типовая роль НастройкаПараметровЭД, остальным окно открывается на просмотр; права проверяются
// и при записи. История изменений - в ХранилищеОбщихНастроек по контрагенту (журнал регистрации
// ротируется), своя в каждой базе: свойства уходят обменом, хранилище - нет.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Может ли текущий пользователь менять настройки ЭДО контрагентов.
Функция МожноМенять() Экспорт
	Если ПравоДоступа("Администрирование", Метаданные) Тогда
		Возврат Истина;
	КонецЕсли;
	Роль = Метаданные.Роли.Найти("НастройкаПараметровЭД");
	Возврат Роль <> Неопределено И РольДоступна(Роль);
КонецФункции

// Флаги, которые окно показывает галочками: колонка формы -> свойство объектов.
// Пауза и закрепление адреса сюда не входят: у них своя логика записи.
Функция ОписаниеФлагов() Экспорт
	Флаги = Новый Массив;
	Флаги.Добавить(Новый Структура("Колонка, Свойство, Представление",
		"Автоотправка", "ЭДО_АвтоотправкаРазрешена", "Автоотправка"));
	Флаги.Добавить(Новый Структура("Колонка, Свойство, Представление",
		"ПриемУПД", "ЭДО_АвтоматическоеПринятиеУПД", "Прием УПД"));
	Флаги.Добавить(Новый Структура("Колонка, Свойство, Представление",
		"ПриемУКД", "ЭДО_АвтоматическоеПринятиеУКД", "Прием УКД"));
	Флаги.Добавить(Новый Структура("Колонка, Свойство, Представление",
		"СверкаУПД", "ЭДО_СверкаПередПринятиемУПД", "Сверка УПД"));
	Возврат Флаги;
КонецФункции

// Колонки флагов, свойства которых в базе не заведены: окно делает их недоступными.
Функция НезаведенныеФлаги() Экспорт
	Колонки = Новый Массив;
	Для Каждого ОписаниеФлага Из ОписаниеФлагов() Цикл
		Если ЭДО_Сервер.СвойствоОбъектов(ОписаниеФлага.Свойство).Пустая() Тогда
			Колонки.Добавить(ОписаниеФлага.Колонка);
		КонецЕсли;
	КонецЦикла;
	Если ЭДО_Сервер.СвойствоОбъектов("ЭДО_ОтправкаПриостановлена").Пустая() Тогда
		Колонки.Добавить("Пауза");
	КонецЕсли;
	Возврат Колонки;
КонецФункции

// Сколько строк окно показывает самое большее: дальше - уточнять отбор.
Функция ПределСписка() Экспорт
	Возврат 3000;
КонецФункции

// Список контрагентов для окна.
// Параметры: Поиск (строка по наименованию или ИНН), МесяцевОтгрузок (0 - весь справочник),
// ТолькоСНастройками (только контрагенты, у которых есть хоть одна настройка ЭДО).
// Возврат: Структура (Строки - Массив структур (Контрагент, ИНН, АдресЭДО, АдресЗакреплен, Автоотправка,
// ПриемУПД, ПриемУКД, СверкаУПД, Пауза, ПричинаПаузы); Обрезан - подходящих строк больше ПределСписка()).
Функция СписокКонтрагентов(Знач Поиск, Знач МесяцевОтгрузок, Знач ТолькоСНастройками) Экспорт

	Свойства = Новый Соответствие;
	ВсеСвойства = Новый Массив;
	Для Каждого Имя Из ИменаСвойствКонтрагента() Цикл
		Свойство = ЭДО_Сервер.СвойствоОбъектов(Имя);
		Свойства.Вставить(Имя, Свойство);
		Если НЕ Свойство.Пустая() И Имя <> "ЭДО_ПричинаПаузы" Тогда
			ВсеСвойства.Добавить(Свойство);
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Справочник.Ссылка КАК Контрагент
		|ПОМЕСТИТЬ Отобранные
		|ИЗ
		|	Справочник.Контрагенты КАК Справочник
		|ГДЕ
		|	&ВесьСправочник
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	Реализация.Контрагент
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Реализация
		|ГДЕ
		|	&УчитыватьОтгрузки
		|	И Реализация.Проведен
		|	И Реализация.Дата >= &ДатаОтгрузок
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(Значения.Объект КАК Справочник.Контрагенты)
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК Значения
		|ГДЕ
		|	Значения.Объект ССЫЛКА Справочник.Контрагенты
		|	И Значения.Свойство В (&ВсеСвойства)
		|;
		|
		|ВЫБРАТЬ ПЕРВЫЕ 3001
		|	Контрагенты.Ссылка КАК Контрагент,
		|	Контрагенты.ИНН КАК ИНН,
		|	Адрес.Значение КАК АдресЭДО,
		|	Закреп.Значение КАК АдресЗакреплен,
		|	Авто.Значение КАК Автоотправка,
		|	ПриемУПД.Значение КАК ПриемУПД,
		|	ПриемУКД.Значение КАК ПриемУКД,
		|	Сверка.Значение КАК СверкаУПД,
		|	Пауза.Значение КАК Пауза,
		|	Причина.Значение КАК ПричинаПаузы
		|ИЗ
		|	Отобранные КАК Отобранные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО Отобранные.Контрагент = Контрагенты.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Адрес
		|		ПО (Адрес.Объект = Контрагенты.Ссылка) И (Адрес.Свойство = &СвАдрес)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Закреп
		|		ПО (Закреп.Объект = Контрагенты.Ссылка) И (Закреп.Свойство = &СвЗакреп)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Авто
		|		ПО (Авто.Объект = Контрагенты.Ссылка) И (Авто.Свойство = &СвАвто)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ПриемУПД
		|		ПО (ПриемУПД.Объект = Контрагенты.Ссылка) И (ПриемУПД.Свойство = &СвПриемУПД)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ПриемУКД
		|		ПО (ПриемУКД.Объект = Контрагенты.Ссылка) И (ПриемУКД.Свойство = &СвПриемУКД)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Сверка
		|		ПО (Сверка.Объект = Контрагенты.Ссылка) И (Сверка.Свойство = &СвСверка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Пауза
		|		ПО (Пауза.Объект = Контрагенты.Ссылка) И (Пауза.Свойство = &СвПауза)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Причина
		|		ПО (Причина.Объект = Контрагенты.Ссылка) И (Причина.Свойство = &СвПричина)
		|ГДЕ
		|	НЕ Контрагенты.ЭтоГруппа
		|	И НЕ Контрагенты.ПометкаУдаления
		|	И (&БезПоиска
		|			ИЛИ Контрагенты.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		|			ИЛИ Контрагенты.ИНН ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~"")
		|	И (НЕ &ТолькоСНастройками
		|			ИЛИ Закреп.Значение = ИСТИНА
		|			ИЛИ Авто.Значение = ИСТИНА
		|			ИЛИ ПриемУПД.Значение = ИСТИНА
		|			ИЛИ ПриемУКД.Значение = ИСТИНА
		|			ИЛИ Сверка.Значение = ИСТИНА
		|			ИЛИ Пауза.Значение = ИСТИНА
		|			ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Закреп.Значение КАК СТРОКА(10)), """") НЕ В (&Выключено)
		|			ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Авто.Значение КАК СТРОКА(10)), """") НЕ В (&Выключено)
		|			ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(ПриемУПД.Значение КАК СТРОКА(10)), """") НЕ В (&Выключено)
		|			ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(ПриемУКД.Значение КАК СТРОКА(10)), """") НЕ В (&Выключено)
		|			ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Сверка.Значение КАК СТРОКА(10)), """") НЕ В (&Выключено)
		|			ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Пауза.Значение КАК СТРОКА(10)), """") НЕ В (&Выключено))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Контрагенты.Наименование";
	// Период 0 - весь справочник; с периодом - отгрузки за период плюс все, у кого есть значения свойств ЭДО.
	Запрос.УстановитьПараметр("ВесьСправочник", МесяцевОтгрузок = 0 И НЕ ТолькоСНастройками);
	Запрос.УстановитьПараметр("УчитыватьОтгрузки", МесяцевОтгрузок > 0 И НЕ ТолькоСНастройками);
	Запрос.УстановитьПараметр("ТолькоСНастройками", ТолькоСНастройками);
	Запрос.УстановитьПараметр("Выключено", ВыключенныеСтроковыеФлаги());
	Запрос.УстановитьПараметр("ДатаОтгрузок", ДобавитьМесяц(НачалоДня(ТекущаяДатаСеанса()), -МесяцевОтгрузок));
	Запрос.УстановитьПараметр("ВсеСвойства", ВсеСвойства);
	Запрос.УстановитьПараметр("СвАдрес", Свойства.Получить("ЭДО_АдресКонтрагента"));
	Запрос.УстановитьПараметр("СвЗакреп", Свойства.Получить("ЭДО_АдресЗакреплён"));
	Запрос.УстановитьПараметр("СвАвто", Свойства.Получить("ЭДО_АвтоотправкаРазрешена"));
	Запрос.УстановитьПараметр("СвПриемУПД", Свойства.Получить("ЭДО_АвтоматическоеПринятиеУПД"));
	Запрос.УстановитьПараметр("СвПриемУКД", Свойства.Получить("ЭДО_АвтоматическоеПринятиеУКД"));
	Запрос.УстановитьПараметр("СвСверка", Свойства.Получить("ЭДО_СверкаПередПринятиемУПД"));
	Запрос.УстановитьПараметр("СвПауза", Свойства.Получить("ЭДО_ОтправкаПриостановлена"));
	Запрос.УстановитьПараметр("СвПричина", Свойства.Получить("ЭДО_ПричинаПаузы"));
	Поиск = СокрЛП(Поиск);
	Запрос.УстановитьПараметр("БезПоиска", НЕ ЗначениеЗаполнено(Поиск));
	Запрос.УстановитьПараметр("Шаблон", "%" + ЭкранироватьДляПодобно(Поиск) + "%");

	Результат = Новый Структура("Строки, Обрезан", Новый Массив, Ложь);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Результат.Строки.Количество() >= ПределСписка() Тогда
			Результат.Обрезан = Истина;
			Прервать;
		КонецЕсли;
		СтрокаСписка = Новый Структура("Контрагент, ИНН, АдресЭДО, АдресЗакреплен, Автоотправка, ПриемУПД, ПриемУКД,
			|СверкаУПД, Пауза, ПричинаПаузы");
		СтрокаСписка.Контрагент = Выборка.Контрагент;
		СтрокаСписка.ИНН = СокрЛП(Выборка.ИНН);
		СтрокаСписка.АдресЭДО = ?(Выборка.АдресЭДО = NULL, "", СокрЛП(Строка(Выборка.АдресЭДО)));
		СтрокаСписка.АдресЗакреплен = ФлагВключен(Выборка.АдресЗакреплен);
		СтрокаСписка.Автоотправка = ФлагВключен(Выборка.Автоотправка);
		СтрокаСписка.ПриемУПД = ФлагВключен(Выборка.ПриемУПД);
		СтрокаСписка.ПриемУКД = ФлагВключен(Выборка.ПриемУКД);
		СтрокаСписка.СверкаУПД = ФлагВключен(Выборка.СверкаУПД);
		СтрокаСписка.Пауза = ФлагВключен(Выборка.Пауза);
		СтрокаСписка.ПричинаПаузы = ?(СтрокаСписка.Пауза И Выборка.ПричинаПаузы <> NULL, СокрЛП(Строка(Выборка.ПричинаПаузы)), "");
		Результат.Строки.Добавить(СтрокаСписка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Записать измененные строки окна.
// Изменения - Массив структур (Контрагент, Было, Стало): в Стало - только поля, которые поменял пользователь
// (Автоотправка, ПриемУПД, ПриемУКД, СверкаУПД, Пауза; с паузой - ПричинаПаузы), в Было - их значения
// на момент чтения списка. Контрагент пишется целиком в одной транзакции под исключительной блокировкой
// его свойств вместе с историей. Если в базе уже не то, что пользователь видел (поменял другой), строка
// не пишется - конфликт; поля, которые пользователь не трогал, не пишутся вовсе.
// Возврат: Структура (Записано - число изменений, Ошибки - Массив строк, НеЗаписаны - Массив контрагентов).
Функция ЗаписатьИзменения(Знач Изменения) Экспорт

	Если НЕ МожноМенять() Тогда
		ВызватьИсключение "Недостаточно прав для изменения настроек ЭДО: нужно право «Администрирование»"
			+ " или роль «Настройка параметров ЭД».";
	КонецЕсли;
	// Права проверены выше; запись свойств и общих настроек - в привилегированном режиме: у роли
	// НастройкаПараметровЭД может не быть прав на регистр значений свойств.
	УстановитьПривилегированныйРежим(Истина);

	Итог = Новый Структура("Записано, Ошибки, НеЗаписаны", 0, Новый Массив, Новый Массив);
	Пользователь = ИмяТекущегоПользователя();
	Сейчас = ТекущаяДатаСеанса();

	Для Каждого Изменение Из Изменения Цикл
		Контрагент = Изменение.Контрагент;
		НачатьТранзакцию();
		Попытка
			ЗаблокироватьКонтрагента(Контрагент);
			Записи = ЗаписатьИзмененияКонтрагента(Контрагент, Изменение.Было, Изменение.Стало, Сейчас, Пользователь);
			Если Записи.Количество() > 0 Тогда
				ДописатьИсторию(Контрагент, Записи);
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			Итог.Ошибки.Добавить(Строка(Контрагент) + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Итог.НеЗаписаны.Добавить(Контрагент);
			Продолжить;
		КонецПопытки;
		Итог.Записано = Итог.Записано + Записи.Количество();
	КонецЦикла;
	Возврат Итог;

КонецФункции

// История изменений настроек ЭДО контрагента в этой базе, новые сверху.
// Возврат: Массив структур (Дата, Пользователь, Настройка, Было, Стало).
Функция ИсторияКонтрагента(Знач Контрагент) Экспорт
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	История = ХранилищеОбщихНастроек.Загрузить(КлючИстории(), КлючКонтрагента(Контрагент), , "");
	Если ТипЗнч(История) <> Тип("Массив") Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Результат = Новый Массив;
	Для Индекс = 1 По История.Количество() Цикл
		Результат.Добавить(История[История.Количество() - Индекс]);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Исключительная блокировка свойств контрагента: проверка «в базе то, что видел пользователь», запись
// и история - одним шагом; второе окно с тем же контрагентом ждет.
Процедура ЗаблокироватьКонтрагента(Знач Контрагент)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.ЗначенияСвойствОбъектов");
	Элемент.УстановитьЗначение("Объект", Контрагент);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
КонецПроцедуры

// Записать поля, которые поменял пользователь. Вызывается в транзакции под блокировкой контрагента.
// Возврат: Массив записей истории.
Функция ЗаписатьИзмененияКонтрагента(Знач Контрагент, Знач Было, Знач Стало, Знач Сейчас, Знач Пользователь)

	Записи = Новый Массив;
	Для Каждого ОписаниеФлага Из ОписаниеФлагов() Цикл
		Если НЕ Стало.Свойство(ОписаниеФлага.Колонка) Тогда
			Продолжить;
		КонецЕсли;
		Свойство = ЭДО_Сервер.СвойствоОбъектов(ОписаниеФлага.Свойство);
		Если Свойство.Пустая() Тогда
			ВызватьИсключение "в базе не заведено свойство " + ОписаниеФлага.Свойство
				+ " (заведите свойства в настройках ЭДО)";
		КонецЕсли;
		ВБазе = ФлагВключен(ЭДО_Сервер.ЗначениеСвойстваОбъекта(Контрагент, Свойство));
		ПроверитьНеИзменено(ОписаниеФлага.Представление, ВБазе, Было[ОписаниеФлага.Колонка]);
		Если ВБазе <> Стало[ОписаниеФлага.Колонка] Тогда
			ЭДО_Сервер.ЗаписатьФлагСвойства(Контрагент, Свойство, Стало[ОписаниеФлага.Колонка]);
			Записи.Добавить(ЗаписьИстории(Сейчас, Пользователь, ОписаниеФлага.Представление,
				ТекстФлага(ВБазе), ТекстФлага(Стало[ОписаниеФлага.Колонка])));
		КонецЕсли;
	КонецЦикла;

	Если Стало.Свойство("Пауза") Тогда
		ПричинаБыла = ЭДО_Сервер.ПричинаПаузыКонтрагента(Контрагент);
		ПаузаВБазе = ЗначениеЗаполнено(ПричинаБыла);
		ПроверитьНеИзменено("Пауза", ПаузаВБазе, Было.Пауза);
		Если Стало.Пауза И НЕ ПаузаВБазе Тогда
			Причина = СокрЛП(Стало.ПричинаПаузы);
			ЭДО_Сервер.ПриостановитьОтправкуКонтрагенту(Контрагент,
				?(ЗначениеЗаполнено(Причина), Причина, "поставлена вручную"));
			Записи.Добавить(ЗаписьИстории(Сейчас, Пользователь, "Пауза", "нет", "пауза: " + Причина));
		ИначеЕсли НЕ Стало.Пауза И ПаузаВБазе Тогда
			ЭДО_Сервер.ВозобновитьОтправкуКонтрагенту(Контрагент);
			Записи.Добавить(ЗаписьИстории(Сейчас, Пользователь, "Пауза", "пауза: " + ПричинаБыла, "снята"));
		КонецЕсли;
	КонецЕсли;
	Возврат Записи;

КонецФункции

Процедура ПроверитьНеИзменено(Знач Настройка, Знач ВБазе, Знач Видел)
	Если ВБазе <> Видел Тогда
		ВызватьИсключение "«" + Настройка + "» уже изменил другой пользователь (сейчас: " + ТекстФлага(ВБазе)
			+ "). Обновите список и повторите.";
	КонецЕсли;
КонецПроцедуры

Функция ИменаСвойствКонтрагента()
	Имена = Новый Массив;
	Имена.Добавить("ЭДО_АдресКонтрагента");
	Имена.Добавить("ЭДО_АдресЗакреплён");
	Имена.Добавить("ЭДО_ОтправкаПриостановлена");
	Имена.Добавить("ЭДО_ПричинаПаузы");
	Для Каждого ОписаниеФлага Из ОписаниеФлагов() Цикл
		Имена.Добавить(ОписаниеФлага.Свойство);
	КонецЦикла;
	Возврат Имена;
КонецФункции

// Строковые значения флага, которые ФлагСвойстваВключён считает выключенными: в запросе
// СокрЛП и ВРег нет, поэтому - с крайними пробелами и в ходовых регистрах.
Функция ВыключенныеСтроковыеФлаги()
	Значения = Новый Массив;
	Для Каждого Слово Из СтрРазделить(",Нет,Ложь,False,0", ",") Цикл
		Для Каждого Вариант Из СтрРазделить(Слово + "|" + ВРег(Слово) + "|" + НРег(Слово), "|") Цикл
			Для Каждого Обрамленный Из СтрРазделить(Вариант + "|" + " " + Вариант + "|" + Вариант + " ", "|") Цикл
				Если Значения.Найти(Обрамленный) = Неопределено Тогда
					Значения.Добавить(Обрамленный);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Значения;
КонецФункции

Функция ФлагВключен(Знач Значение)
	Если Значение = NULL ИЛИ Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЭДО_Сервер.ФлагСвойстваВключён(Значение);
КонецФункции

Функция ТекстФлага(Знач Значение)
	Возврат ?(Значение, "включено", "выключено");
КонецФункции

Функция ЭкранироватьДляПодобно(Знач Текст)
	Для Каждого Знак Из СтрРазделить("~,%,_,[,]", ",") Цикл
		Текст = СтрЗаменить(Текст, Знак, "~" + Знак);
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ИмяТекущегоПользователя()
	Попытка
		Имя = Строка(ПараметрыСеанса.ТекущийПользователь);
	Исключение
		Имя = "";
	КонецПопытки;
	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Имя = ИмяПользователя();
	КонецЕсли;
	Возврат Имя;
КонецФункции

Функция ЗаписьИстории(Знач Дата, Знач Пользователь, Знач Настройка, Знач Было, Знач Стало)
	Возврат Новый Структура("Дата, Пользователь, Настройка, Было, Стало", Дата, Пользователь, Настройка, Было, Стало);
КонецФункции

Функция КлючИстории()
	Возврат "ОФД_ЭДО_ИсторияНастроек";
КонецФункции

Функция КлючКонтрагента(Знач Контрагент)
	Возврат Строка(Контрагент.УникальныйИдентификатор());
КонецФункции

Функция ПределИстории()
	Возврат 100;
КонецФункции

// Дописать записи в историю контрагента; хранится не больше ПределИстории() последних.
Процедура ДописатьИсторию(Знач Контрагент, Знач Записи)
	История = ХранилищеОбщихНастроек.Загрузить(КлючИстории(), КлючКонтрагента(Контрагент), , "");
	Если ТипЗнч(История) <> Тип("Массив") Тогда
		История = Новый Массив;
	КонецЕсли;
	Для Каждого Запись Из Записи Цикл
		История.Добавить(Запись);
	КонецЦикла;
	Пока История.Количество() > ПределИстории() Цикл
		История.Удалить(0);
	КонецЦикла;
	ХранилищеОбщихНастроек.Сохранить(КлючИстории(), КлючКонтрагента(Контрагент), История, , "");
КонецПроцедуры

#КонецОбласти
