////////////////////////////////////////////////////////////////////////////////
// ЭДО_Клиент — клиентский ФАСАД программной отправки УПД по ЭДО.
// Расширение «Дополнения», УТ 10.3.
//
// С 2026-07-25 (п.5 трека) весь цикл, включая крипто, умеет работать на СЕРВЕРЕ
// (контейнер КЭП в реестре учётки службы кластера) — см. ЭДО_Сервер.
// Этот модуль:
//   • вызывается из общей команды «Доп_ОтправитьПоЭДО» и из форм (интерактивный путь);
//   • по умолчанию делегирует ВСЁ серверу — один вызов, без client-round-trip;
//   • если серверного ключа нет (ПодписьНаСервереДоступна() = Ложь) — работает
//     СТАРОЙ схемой: крипто-фазы 0a/3 на клиенте, остальное на сервере (фолбэк, чтобы
//     метод остался рабочим на машинах/базах, где ключ только в хранилище пользователя).
//
// Флаги модуля: Клиент (управляемое приложение) = Истина, Клиент (обычное приложение) = Истина,
// Сервер = Ложь, ВызовСервера = Ложь.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Программная отправка ОДНОГО документа по ЭДО (полный цикл).
// Возврат: Структура (Ссылка, Статус, ИдДокумента, Сообщение),
//   Статус ∈ "Отправлен" | "ТребуетВнимания" | "Отсеян" | "Ошибка".
Функция Доп_ОтправитьПоЭДО(Ссылка) Экспорт
	Если ЭДО_Сервер.ПодписьНаСервереДоступна() Тогда
		// основной путь: весь цикл одним серверным вызовом
		Возврат ЭДО_Сервер.ОтправитьПоЭДО(Ссылка);
	КонецЕсли;
	Возврат ОтправитьЧерезКлиентскуюПодпись(Ссылка);
КонецФункции

// Программная отправка МАССИВА документов. «Чистые» уходят, исключения помечаются.
// Возврат: Массив структур-результатов (как у Доп_ОтправитьПоЭДО).
Функция Доп_ОтправитьМассивПоЭДО(МассивСсылок) Экспорт
	Если ЭДО_Сервер.ПодписьНаСервереДоступна() Тогда
		Возврат ЭДО_Сервер.ОтправитьМассивПоЭДО(МассивСсылок);
	КонецЕсли;
	Результаты = Новый Массив;
	Для Каждого Ссылка Из МассивСсылок Цикл
		Результаты.Добавить(ОтправитьЧерезКлиентскуюПодпись(Ссылка));
	КонецЦикла;
	Возврат Результаты;
КонецФункции

// Обслуживает ли наш контур ЭДО документ (или первый документ массива).
// 🔑 На этом условии стоят перехваты типового меню «ЭДО»: чужие документы (банк, МЧД,
//    присоединённые файлы) обязаны уходить в типовой механизм через ПродолжитьВызов,
//    иначе расширение сломает places, к ЭДО через Платформу отношения не имеющие.
Функция НашКонтурЭДО(Знач Параметр) Экспорт
	Ссылка = ПерваяСсылка(Параметр);
	Если Ссылка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ТипДокумента = ТипЗнч(Ссылка);
	Возврат ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.АктСверкиВзаиморасчетов");
КонецФункции

// Интерактивная отправка из формы документа или формы списка: отправляет и ПОКАЗЫВАЕТ итог.
// ⚠️ Акты сверки идут своим путём (ЭДО_Сервер.ОтправитьАктСверкиПоЭДО): у них другой формат
//    ФНС и другой сборщик XML, движок вендора в этой ветке не участвует.
Процедура ОтправитьИнтерактивно(Знач Параметр) Экспорт
	Ссылки = МассивСсылок(Параметр);
	Если Ссылки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Отправка по ЭДО: документ не выбран.");
		Возврат;
	КонецЕсли;

	Акты = Новый Массив;
	Прочие = Новый Массив;
	Для Каждого Ссылка Из Ссылки Цикл
		Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.АктСверкиВзаиморасчетов") Тогда
			Акты.Добавить(Ссылка);
		Иначе
			Прочие.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;

	Результаты = Новый Массив;
	Если Прочие.Количество() > 0 Тогда
		// массивом: токен берётся один раз на пакет, замок прогона один
		Для Каждого Результат Из Доп_ОтправитьМассивПоЭДО(Прочие) Цикл
			Результаты.Добавить(Результат);
		КонецЦикла;
	КонецЕсли;
	Для Каждого Ссылка Из Акты Цикл
		Результаты.Добавить(ЭДО_Сервер.ОтправитьАктСверкиПоЭДО(Ссылка));
	КонецЦикла;

	ПоказатьИтогОтправки(Результаты);
КонецПроцедуры

// Карточка «Состояние ЭДО» по документу — наша замена типовому «Открыть актуальный ЭД».
// ⚠️ Карточка живёт в конфигурации (Обработка.ОбработкаЗаявок.Форма.СостояниеЭДО), а не
//    в расширении: зависимость односторонняя, открываем по имени формы.
Процедура ОткрытьКарточкуСостоянияЭДО(Знач Параметр, Знач ВладелецФормы = Неопределено) Экспорт
	Ссылка = ПерваяСсылка(Параметр);
	Если Ссылка = Неопределено Тогда
		ПоказатьПредупреждение(, "Состояние ЭДО: документ не выбран.");
		Возврат;
	КонецЕсли;
	// 🔑 Карточку открываем и по накладной, и по акту сверки: акт уходит по ЭДО своим
	//    форматом, а в обработке заявок его нет вовсе — до состояния оттуда не добраться
	//    (замечание оператора 07.09.2026). Прежний текст отсылал именно туда и был неверен.
	ТипДокумента = ТипЗнч(Ссылка);
	Если ТипДокумента <> Тип("ДокументСсылка.РеализацияТоваровУслуг")
		И ТипДокумента <> Тип("ДокументСсылка.АктСверкиВзаиморасчетов") Тогда
		ПоказатьПредупреждение(,
			"Карточка «Состояние ЭДО» открывается по накладной или по акту сверки."
			+ Символы.ПС + "По этому документу состояние смотрите у оператора ЭДО.");
		Возврат;
	КонецЕсли;
	// ⚠️🔴 Форма живёт в КОНФИГУРАЦИИ, а конфигурации доменов расходятся: в базе, где
	//    Обработки.ОбработкаЗаявок нет или у неё нет этой формы, ОткрытьФорму бросает
	//    исключение прямо из перехвата типового меню — то есть ломает пункт, который
	//    до нас хотя бы что-то делал. Ловим и объясняем.
	// ⚠️ Параметр «Реализация» объявлен в форме с типом ДокументСсылка.РеализацияТоваровУслуг,
	//    акт туда не положить ⟹ для акта отдельный параметр «Документ».
	ПараметрыКарточки = ?(ТипДокумента = Тип("ДокументСсылка.АктСверкиВзаиморасчетов"),
		Новый Структура("Документ", Ссылка),
		Новый Структура("Реализация", Ссылка));
	// ⚠️🔴 Карточка — УПРАВЛЯЕМАЯ форма, а формы документов в УТ 10.3 обычные и открываются
	//    в толстом клиенте обычного приложения: он управляемую форму не показывает и НЕ
	//    выбрасывает исключение — пункт меню просто молчит (замечание оператора 07.09.2026).
	//    ⟹ мало поймать ошибку, надо ещё проверить, что форма действительно открылась.
	Форма = Неопределено;
	Попытка
		Форма = ОткрытьФорму("Обработка.ОбработкаЗаявок.Форма.СостояниеЭДО", ПараметрыКарточки, ВладелецФормы);
	Исключение
		Форма = Неопределено;
	КонецПопытки;
	Если Форма = Неопределено Тогда
		// Фолбэк: то же состояние по данным базы, текстом. Без истории из API Платформы —
		// её показывает карточка, доступная в обработке заявок (тонкий клиент).
		ПоказатьПредупреждение(, ЭДО_Сервер.СводкаСостоянияЭДО(Ссылка));
	КонецЕсли;
КонецПроцедуры

// Пункт типового меню, который в нашем контуре не работает: объясняем, а не молчим.
// 🎯 Мотив: тихое ничего пользователь читает как поломку и идёт с этим к нам.
Процедура СообщитьПунктОтключен(Знач Текст) Экспорт
	ПоказатьПредупреждение(, Текст);
КонецПроцедуры

// Итог отправки: краткая сводка окном + подробности в сообщениях.
Процедура ПоказатьИтогОтправки(Знач Результаты) Экспорт
	Отправлено = 0;
	Внимание = 0;
	Ошибок = 0;
	Детали = "";
	Для Каждого Результат Из Результаты Цикл
		Если Результат.Статус = "Отправлен" Тогда
			Отправлено = Отправлено + 1;
		ИначеЕсли Результат.Статус = "Ошибка" Тогда
			Ошибок = Ошибок + 1;
			Детали = Детали + Символы.ПС + Строка(Результат.Ссылка) + " — ошибка: " + Результат.Сообщение;
		Иначе
			Внимание = Внимание + 1;
			Детали = Детали + Символы.ПС + Строка(Результат.Ссылка) + " — " + Результат.Статус
				+ ": " + Результат.Сообщение;
		КонецЕсли;
	КонецЦикла;

	Сводка = "Отправка по ЭДО: отправлено " + Отправлено
		+ ", требует внимания/отсеяно " + Внимание
		+ ", ошибок " + Ошибок;

	Если ЗначениеЗаполнено(Детали) Тогда
		Сообщить(Сводка + Детали);
	КонецЕсли;

	// 🔑 Одиночный документ — показываем причину прямо в окне: сообщения в форме документа
	//    пользователь не читает, а именно по ним 05.09 карточка «молчала о результате».
	Если Результаты.Количество() = 1 Тогда
		Результат = Результаты[0];
		Текст = ?(Результат.Статус = "Отправлен",
			"Документ отправлен по ЭДО." + ?(ЗначениеЗаполнено(Результат.ИдДокумента),
				Символы.ПС + "Идентификатор у оператора: " + Результат.ИдДокумента, ""),
			Результат.Статус + ": " + Результат.Сообщение);
		ПоказатьПредупреждение(, Текст);
	Иначе
		ПоказатьПредупреждение(, Сводка);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ФОЛБЭК: прежняя схема с чередованием client/server —
// крипто-фазы 0a (подпись авторизации) и 3 (подпись титула) на клиенте,
// сборка XML / ФЛК / присоединение подписи / write-back — на сервере.
Функция ОтправитьЧерезКлиентскуюПодпись(Ссылка)
	Результат = Новый Структура("Ссылка, Статус, ИдДокумента, Сообщение", Ссылка, "", "", "");

	// 1) Готовность (проведён + идентификатор ЭДО контрагента) — до любого обращения к API
	Готовность = ЭДО_Сервер.ПроверитьГотовностьКОтправке(Ссылка);
	Если НЕ Готовность.Готов Тогда
		// «Отправлять не надо» (розничная продажа) — не ошибка: помечаем и уводим из очереди
		Если Готовность.ОтправкаНеТребуется Тогда
			ЭДО_Сервер.ЗаписатьЧитаемыйСтатус(Ссылка, ЭДО_Сервер.ТекстСтатусаОтправкаНеТребуется());
			Результат.Статус = "Отсеян";
		Иначе
			Результат.Статус = "ТребуетВнимания";
		КонецЕсли;
		Результат.Сообщение = Готовность.Причина;
		Возврат Результат;
	КонецЕсли;

	// 2) Токен авторизации (перевыпускается при отсутствии)
	Если НЕ ОбеспечитьТокен(Ложь) Тогда
		Результат.Статус = "Ошибка";
		Результат.Сообщение = "Не удалось получить токен авторизации (КЭП/подпись)";
		Возврат Результат;
	КонецЕсли;

	// 3) Подготовка XML + ФЛК (сервер), один перевыпуск токена по 401
	Подготовка = ЭДО_Сервер.ПодготовитьДокументИФЛК(Ссылка);
	Если Подготовка.Статус = "НуженТокен" И ОбеспечитьТокен(Истина) Тогда
		Подготовка = ЭДО_Сервер.ПодготовитьДокументИФЛК(Ссылка);
	КонецЕсли;
	Если Подготовка.Статус = "Отсеян" Тогда
		Результат.Статус = "Отсеян";
		Результат.Сообщение = Подготовка.Сообщение;
		Возврат Результат;
	ИначеЕсли Подготовка.Статус <> "ОК" Тогда
		Результат.Статус = "Ошибка";
		Результат.Сообщение = ?(Подготовка.Статус = "НуженТокен",
			"Не удалось авторизоваться (401 после перевыпуска токена)", Подготовка.Сообщение);
		Возврат Результат;
	КонецЕсли;
	Результат.ИдДокумента = Подготовка.ИдДокумента;

	// 4) Подпись титула на клиенте (отсоединённая CMS)
	ПодписьДокумента = ПодписатьДанные(Подготовка.ДвоичныеXML);
	Если ПодписьДокумента = Неопределено Тогда
		Результат.Статус = "ТребуетВнимания";
		Результат.Сообщение = "Документ создан у оператора (id " + Подготовка.ИдДокумента
			+ "), но не подписан КЭП — завершить/удалить вручную";
		Возврат Результат;
	КонецЕсли;

	// 5) Присоединение подписи (отправка стартует) + write-back, один перевыпуск по 401
	Присоединение = ЭДО_Сервер.ПрисоединитьПодписьИЗаписать(Ссылка, Подготовка.ИдДокумента, ПодписьДокумента);
	Если Присоединение.Статус = "НуженТокен" И ОбеспечитьТокен(Истина) Тогда
		Присоединение = ЭДО_Сервер.ПрисоединитьПодписьИЗаписать(Ссылка, Подготовка.ИдДокумента, ПодписьДокумента);
	КонецЕсли;

	Если Присоединение.Статус = "Отправлен" Тогда
		Результат.Статус = "Отправлен";
	Иначе
		Результат.Статус = "Ошибка";
		Результат.Сообщение = ?(Присоединение.Статус = "НуженТокен",
			"Не удалось авторизоваться при присоединении подписи", Присоединение.Сообщение);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Обеспечить действующий токен авторизации КЛИЕНТСКОЙ подписью (фолбэк-путь).
// Принудительный = Истина → перевыпуск даже если токен в хранилище есть (реакция на 401).
// ⚠️ Срок токена (15 мин) не проверяем — истёкший всплывёт как 401 → перевыпуск.
Функция ОбеспечитьТокен(Принудительный)
	Если НЕ Принудительный И ЗначениеЗаполнено(ЭДО_Сервер.ТекущийТокен()) Тогда
		Возврат Истина;
	КонецЕсли;
	// 0a (клиент): подпись служебного JSON {ts,nonce}
	ДанныеJSON = ДанныеАвторизацииJSON();
	ПодписьJSON = ПодписатьДанные(ДанныеJSON);
	Если ПодписьJSON = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	// 0b (сервер): attached CMS + POST токена (⚠️ сразу за подписью — ts живёт секунды)
	Ответ = ЭДО_Сервер.ПолучитьТокенПоПодписиАвторизации(ДанныеJSON, ПодписьJSON);
	Возврат Ответ.Успех;
КонецФункции

// Служебный JSON авторизации {"ts":<unix>,"nonce":<uuid>} как ДвоичныеДанные (UTF-8).
Функция ДанныеАвторизацииJSON()
	JSON = "{""ts"":" + Формат(УниверсальноеВремя(ТекущаяДата()) - Дата(1970, 1, 1), "ЧГ=0")
		+ ",""nonce"":""" + Строка(Новый УникальныйИдентификатор()) + """}";
	Поток = Новый ПотокВПамяти;
	ЗаписьТекста = Новый ЗаписьТекста(Поток, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(JSON);
	ЗаписьТекста.Закрыть();
	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();
КонецФункции

// Подпись двоичных данных КЭП подписанта (отсоединённая CMS). КЛИЕНТСКИЙ контекст.
// Возврат: ДвоичныеДанные подписи либо Неопределено (нет сертификата/ошибка крипто).
Функция ПодписатьДанные(Данные)
	Попытка
		МенеджерКриптографии = Новый МенеджерКриптографии("", "", 80); // ГОСТ-2012-256, как в обработке провайдера
		МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = "";
		Хранилище = МенеджерКриптографии.ПолучитьХранилищеСертификатов(
			ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
		Сертификат = Хранилище.НайтиПоОтпечатку(Base64Значение(ЭДО_Сервер.ОтпечатокПодписанта()));
		Если Сертификат = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат МенеджерКриптографии.Подписать(Данные, Сертификат);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Первая ссылка из параметра команды (Ссылка, Массив или Неопределено).
Функция ПерваяСсылка(Знач Параметр)
	Если ТипЗнч(Параметр) = Тип("Массив") Тогда
		Для Каждого Элемент Из Параметр Цикл
			Если ЗначениеЗаполнено(Элемент) Тогда
				Возврат Элемент;
			КонецЕсли;
		КонецЦикла;
		Возврат Неопределено;
	КонецЕсли;
	Возврат ?(ЗначениеЗаполнено(Параметр), Параметр, Неопределено);
КонецФункции

// Параметр команды → массив непустых ссылок (форма документа даёт одну, форма списка — массив).
Функция МассивСсылок(Знач Параметр)
	Ссылки = Новый Массив;
	Если ТипЗнч(Параметр) = Тип("Массив") Тогда
		Для Каждого Элемент Из Параметр Цикл
			Если ЗначениеЗаполнено(Элемент) Тогда
				Ссылки.Добавить(Элемент);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(Параметр) Тогда
		Ссылки.Добавить(Параметр);
	КонецЕсли;
	Возврат Ссылки;
КонецФункции

#КонецОбласти
