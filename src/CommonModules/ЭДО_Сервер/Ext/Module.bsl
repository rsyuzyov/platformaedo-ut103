// ++ ЩА 15.10.2026 [yan]: состояние входящего словами - то же, что у исходящих, только мы получатель.
// Код оператора (с учетом newStatus) показывается рядом колонкой «Код API».
Функция ТекстСтатусаВходящего(Знач КодAPI) Экспорт
	Код = ВРег(СокрЛП(КодAPI));
	Карта = Новый Соответствие;
	Карта.Вставить("NEW", "Поступает");
	Карта.Вставить("SENT_TO_OPERATOR", "Поступает");
	Карта.Вставить("SENT", "Ждет нашей подписи");
	Карта.Вставить("DELIVERED", "Ждет нашей подписи");
	Карта.Вставить("ACCEPTED", "Подписан нами");
	Карта.Вставить("REJECTED", "Мы отказали");
	Карта.Вставить("CANCELLATION_REQUESTED", "Запрошено аннулирование");
	Карта.Вставить("CANCELLED", "Аннулирован");
	Карта.Вставить("SENDING_FAILED", "Ошибка доставки у оператора");
	Карта.Вставить("FIXATION_FAILED", "Ошибка ЧЗ");
	Карта.Вставить("DELETED", "Удален отправителем");
	Текст = Карта.Получить(Код);
	Возврат ?(Текст = Неопределено, Код, Текст);
КонецФункции

// Статус карточки оператора, по которому судим о документе. Поле status - ход документооборота
// (ACCEPTED - покупатель подписал) и после аннулирования не меняется; итоговое состояние, в том
// числе CANCELLATION_REQUESTED и CANCELLED, лежит в newStatus. Карточка - Структура или Соответствие.
Функция СтатусКарточкиОператора(Знач Карточка) Экспорт
	Новый_ = Неопределено;
	Прежний = Неопределено;
	Если ТипЗнч(Карточка) = Тип("Структура") Тогда
		Карточка.Свойство("newStatus", Новый_);
		Карточка.Свойство("status", Прежний);
	ИначеЕсли ТипЗнч(Карточка) = Тип("Соответствие") Тогда
		Новый_ = Карточка.Получить("newStatus");
		Прежний = Карточка.Получить("status");
	КонецЕсли;
	Если Новый_ <> Неопределено И ЗначениеЗаполнено(СокрЛП(Строка(Новый_))) Тогда
		Возврат ВРег(СокрЛП(Строка(Новый_)));
	КонецЕсли;
	Возврат ?(Прежний = Неопределено, "", ВРег(СокрЛП(Строка(Прежний))));
КонецФункции

// Прежние формулировки статусов оператора -> текущие.
Функция ПрежниеТекстыСтатусов() Экспорт
	Карта = Новый Соответствие;
	Карта.Вставить("Принят", ТекстПодписанКонтрагентом());
	Карта.Вставить("Доставлен", ТекстДоставлен());
	Карта.Вставить("Отказ контрагента", ТекстОтклоненКонтрагентом());
	Карта.Вставить("Ошибка: не отправлен", ТекстОшибкаОтправкиУОператора());
	Карта.Вставить("FIXATION_FAILED", ТекстОшибкаФиксацииЧЗ());
	Карта.Вставить("Запрошено аннулирование", ТекстАннулированиеЖдемОтвета());
	Карта.Вставить("Контрагент просит аннулировать", ТекстЗапросаАннулирования());
	Возврат Карта;
КонецФункции

// Прежние формулировки причин неотправки -> текущие.
