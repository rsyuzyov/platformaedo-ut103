Функция ПрежнийПрефиксПричиныСвязи() Экспорт
	Возврат "Связь с контрагентом: ";
КонецФункции

// Текст колонки в текущей формулировке: прежний переводится, остальное - как есть.
Функция АктуальныйТекстКолонки(Знач Текст) Экспорт
	Значение = СокрЛП(Текст);
	Новый_ = ПрежниеТекстыСтатусов().Получить(Значение);
	Если Новый_ = Неопределено Тогда
		Новый_ = ПрежниеТекстыПричин().Получить(Значение);
	КонецЕсли;
	Если Новый_ <> Неопределено Тогда
		Возврат Новый_;
	КонецЕсли;
	Если Найти(Значение, ПрежнийПрефиксПричиныСвязи()) = 1 Тогда
		Возврат Лев(ПрефиксПричиныСвязи() + Сред(Значение, СтрДлина(ПрежнийПрефиксПричиныСвязи()) + 1), 50);
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Текст и все его прежние формулировки - для запросов, отбирающих по колонке.
Функция ТекстыСтатусаСПрежними(Знач Текст) Экспорт
	Тексты = Новый Массив;
	Тексты.Добавить(Текст);
	Для Каждого КЗ Из ПрежниеТекстыСтатусов() Цикл
		Если КЗ.Значение = Текст Тогда
			Тексты.Добавить(КЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КЗ Из ПрежниеТекстыПричин() Цикл
		Если КЗ.Значение = Текст Тогда
			Тексты.Добавить(КЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Тексты;
КонецФункции

// Переписать в колонке ЭДО прежние формулировки текущими - разово после обновления. Пишет
// напрямую в регистр, без извещения профиля: состояние документа не меняется, только слова.
// Отметка выполнения - в общих настройках; Лимит - сколько записей за вызов.
// Возврат: Структура (Переписано, Осталось).
Функция ПереписатьПрежниеТекстыКолонки(Знач Лимит = 0) Экспорт
	// Общие настройки лежат под пользователем "": для обычного пользователя это чужой слот, без привилегий - «Нарушение прав доступа».
	УстановитьПривилегированныйРежим(Истина);
	Итог = Новый Структура("Переписано, Осталось", 0, 0);
	Если ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", "ВерсияТекстовКолонки", , "") = 2 Тогда
		Возврат Итог;
	КонецЕсли;
	Свойство = СвойствоОбъектов("ЭДО_Состояние");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат Итог;
	КонецЕсли;
	Прежние = Новый Массив;
	Для Каждого КЗ Из ПрежниеТекстыСтатусов() Цикл
		Прежние.Добавить(КЗ.Ключ);
	КонецЦикла;
	Для Каждого КЗ Из ПрежниеТекстыПричин() Цикл
		Прежние.Добавить(КЗ.Ключ);
	КонецЦикла;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	З.Объект КАК Объект,
		|	ВЫРАЗИТЬ(З.Значение КАК СТРОКА(50)) КАК Текст
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК З
		|ГДЕ
		|	З.Свойство = &Свойство
		|	И (ВЫРАЗИТЬ(З.Значение КАК СТРОКА(50)) В (&Прежние)
		|		ИЛИ ВЫРАЗИТЬ(З.Значение КАК СТРОКА(50)) ПОДОБНО &ПрефиксСвязи)");
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Запрос.УстановитьПараметр("Прежние", Прежние);
	Запрос.УстановитьПараметр("ПрефиксСвязи", ПрежнийПрефиксПричиныСвязи() + "%");
	Таблица = Запрос.Выполнить().Выгрузить();
	Обработано = 0;
	Для Каждого Строчка Из Таблица Цикл
		Если Лимит > 0 И Обработано >= Лимит Тогда
			Итог.Осталось = Таблица.Количество() - Обработано;
			Возврат Итог;
		КонецЕсли;
		Обработано = Обработано + 1;
		Если ПереписатьПрежнийТекстЗаписи(Строчка.Объект, Свойство, Строчка.Текст) Тогда
			Итог.Переписано = Итог.Переписано + 1;
		КонецЕсли;
	КонецЦикла;
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", "ВерсияТекстовКолонки", 2, , "");
	Возврат Итог;
КонецФункции
// Одна запись колонки: перечитать под исключительной блокировкой пары «объект, свойство» и
// перевести, только если там всё ещё прочитанный прежний текст. Иначе сверка или карточка, успевшая
// записать свежий статус (например, «Аннулирован») между выборкой и записью, была бы затёрта
// переводом устаревшего «Принят». Транзакция - на одну запись, порцию не держим.
// Возврат: Истина - запись переведена.
Функция ПереписатьПрежнийТекстЗаписи(Знач Объект, Знач Свойство, Знач ПрочитанныйТекст)
	Прежний = СокрЛП(ПрочитанныйТекст);
	Новый_ = АктуальныйТекстКолонки(Прежний);
	Если Новый_ = Прежний Тогда
		Возврат Ложь;
	КонецЕсли;
	Переведено = Ложь;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.ЗначенияСвойствОбъектов");
		Элемент.УстановитьЗначение("Объект", Объект);
		Элемент.УстановитьЗначение("Свойство", Свойство);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		Текущее = ЗначениеСвойстваОбъекта(Объект, Свойство);
		Если Текущее <> Неопределено И СокрЛП(Строка(Текущее)) = Прежний Тогда
			ЗаписатьЗначениеСвойства(Объект, Свойство, Новый_);
			Переведено = Истина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Переведено;
КонецФункции

// Подписан ли документ контрагентом - по тексту колонки. «Аннулирование отклонено контрагентом» -
// тоже подпись: контрагент отказался аннулировать подписанный документ.
// Идентификатор экземпляра документа у оператора, состояние которого показано в колонке.
Функция ИдентификаторЭкземпляраДокумента(Знач Ссылка) Экспорт
	Свойство = СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	Значение = ЗначениеСвойстваОбъекта(Ссылка, Свойство);
	Возврат ?(Значение = Неопределено, "", СокрЛП(СтрЗаменить(Строка(Значение), Символы.НПП, "")));
КонецФункции

Функция ПодписанПоТекстуКолонки(Знач Текст) Экспорт
	Значение = АктуальныйТекстКолонки(Текст);
	Возврат Значение = ТекстПодписанКонтрагентом() ИЛИ Значение = ТекстАннулированиеОтклонено();
КонецФункции

// Все тексты колонки, означающие подпись контрагента (с прежними) - для запросов.
Функция ТекстыПодписанного() Экспорт
	Тексты = ТекстыСтатусаСПрежними(ТекстПодписанКонтрагентом());
	Тексты.Добавить(ТекстАннулированиеОтклонено());
	Возврат Тексты;
КонецФункции
// -- ЩА 15.10.2026 [yan].

// Документы с открытым запросом на аннулирование: Соответствие ссылка -> Истина.
// Одним запросом на прогон - сверка статусов обходит тысячи документов.
Функция ДокументыСЗапросомАннулирования() Экспорт
	Результат = Новый Соответствие;
	Свойство = СвойствоОбъектов("ЭДО_ЗапросАннулирования");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Объект КАК Объект
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Свойство = &Свойство И ВЫРАЗИТЬ(Значение КАК СТРОКА(50)) <> """"");
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Для Каждого Строчка Из Запрос.Выполнить().Выгрузить() Цикл
		Результат.Вставить(Строчка.Объект, Истина);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Текст колонки с учетом открытого запроса на аннулирование. Подменяет статус Платформы,
// кроме уже аннулированного документа: там запрос исполнен, и статус важнее.
// ЗапросыДокументов - результат ДокументыСЗапросомАннулирования(); не передан - спросим сами.
// ИдЭкземпляра - идентификатор экземпляра у оператора, чей статус переводится (ревью Codex 691):
// сверка и карточка выбирают экземпляр сами, и сохраненный в свойстве может быть другим. Не передан -
// берется сохраненный.
Функция ТекстКолонкиСУчетомЗапросаАннулирования(Знач Ссылка, Знач ТекстСтатуса,
	Знач ЗапросыДокументов = Неопределено, Знач ОтклоненныеАннулирования = Неопределено,
	Знач ИдЭкземпляра = "") Экспорт
	Если ТекстСтатуса = ТекстАннулирован() Тогда
		Возврат ТекстСтатуса;
	КонецЕсли;
	Если ЗапросыДокументов = Неопределено Тогда
		ЗапросыДокументов = ДокументыСЗапросомАннулирования();
	КонецЕсли;
	Если ЗапросыДокументов.Получить(Ссылка) <> Неопределено Тогда
		Возврат ТекстЗапросаАннулирования();
	КонецЕсли;
	// ЩА 15.10.2026 [yan]: наше предложение об аннулировании контрагент отклонил, документ остался подписанным -
	// без этого текста колонка молча вернулась бы к «Подписан контрагентом», и решение потерялось бы.
	Если ТекстСтатуса = ТекстПодписанКонтрагентом() Тогда
		Если ОтклоненныеАннулирования = Неопределено Тогда
			ОтклоненныеАннулирования = ДокументыСОтклоненнымАннулированием();
		КонецЕсли;
		// Только если отклонено предложение по тому экземпляру, что показан в колонке: отказ
		// аннулировать дубль к основному документу отношения не имеет.
		Экземпляры = ОтклоненныеАннулирования.Получить(Ссылка);
		Если Экземпляры <> Неопределено И НЕ ЗначениеЗаполнено(ИдЭкземпляра) Тогда
			ИдЭкземпляра = ИдентификаторЭкземпляраДокумента(Ссылка);
		КонецЕсли;
		Если Экземпляры <> Неопределено
			И Экземпляры.Найти(СокрЛП(ИдЭкземпляра)) <> Неопределено Тогда
			Возврат ТекстАннулированиеОтклонено();
		КонецЕсли;
	КонецЕсли;
	Возврат ТекстСтатуса;
КонецФункции

// ЩА 15.10.2026 [yan]: документы, по которым контрагент отклонил наше предложение об аннулировании, - из снимка
// сторожа наших аннулирований (у оператора отклоненное предложение остается SENT, а документ -
// ACCEPTED, по карточке документа отклонение не видно). Соответствие ссылка -> Массив
// идентификаторов экземпляров, к которым относились отклоненные предложения.
Функция ДокументыСОтклоненнымАннулированием() Экспорт
	Результат = Новый Соответствие;
	Попытка
		Снимок = ЭДО_Сторожа.СнимокНашихАннулирований();
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ДокументыСОтклоненнымАннулированием: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Снимок = Неопределено;
	КонецПопытки;
	Если Снимок = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Предложение Из Снимок.Предложения Цикл
		Если Предложение.Статус = "REJECTED" И ЗначениеЗаполнено(Предложение.Документ)
			И ЗначениеЗаполнено(Предложение.ИдНашего) Тогда
			Экземпляры = Результат.Получить(Предложение.Документ);
			Если Экземпляры = Неопределено Тогда
				Экземпляры = Новый Массив;
				Результат.Вставить(Предложение.Документ, Экземпляры);
			КонецЕсли;
			Экземпляры.Добавить(СокрЛП(Предложение.ИдНашего));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Текст колонки для статуса Платформы DELETED - карточка документа удалена у оператора.
// Держится здесь, а не только в карте статусов регламента: ядро обязано узнавать его своим
// (см. ЗначениеКолонкиНаше), а витрина - относить к группе.
Функция ТекстКарточкаУдалена() Экспорт
	Возврат "Удален у оператора";
КонецФункции

// Текст колонки для документа, который ФЛК оператора отклоняет по содержимому. Причина
// длиннее колонки, поэтому она пишется в журнал регистрации.
Функция ТекстОшибкиФЛК() Экспорт
	Возврат "Ошибка ФЛК, см. журнал регистрации";
КонецФункции

// Человеческое описание известных отказов ФЛК Платформы: что не так и где заполнить.
// Для незнакомых ответов возвращает "" - текст оператора остается как есть.
// Пополняется по мере разбора обращений: сигнатура - имя XSD-типа или узла из ответа ФЛК.
Функция ЧеловеческоеОписаниеОшибкиФЛК(Знач ТекстОтвета) Экспорт

	Если СтрНайти(ТекстОтвета, "ОГРНИПТип") > 0 Тогда
		Возврат "Не заполнен ОГРНИП. Заполните реквизит ""ОГРН"" в карточке контрагента "
			+ "(для ИП это ОГРНИП, 15 цифр - есть в выписке ЕГРИП по ИНН) и отправьте снова";
	КонецЕсли;
	Если СтрНайти(ТекстОтвета, "ОГРНТип") > 0 Тогда
		Возврат "Не заполнен ОГРН. Заполните реквизит ""ОГРН"" в карточке контрагента и отправьте снова";
	КонецЕсли;
	Если СтрНайти(ТекстОтвета, "ОКЕИТип") > 0 Тогда
		Возврат "У товара не заполнен код единицы измерения по ОКЕИ. Откройте единицу измерения "
			+ "в карточке номенклатуры и задайте ""Единицу по классификатору""";
	КонецЕсли;
	Если СтрНайти(ТекстОтвета, "ИННФЛТип") > 0 ИЛИ СтрНайти(ТекстОтвета, "ИННЮЛТип") > 0 Тогда
		Возврат "Не заполнен или неверен ИНН участника. Проверьте ИНН в карточке контрагента "
			+ "и в сведениях своей организации, затем отправьте снова";
	КонецЕсли;
	Если СтрНайти(ТекстОтвета, "АдрТекст") > 0 ИЛИ СтрНайти(ТекстОтвета, "АдресТип") > 0 Тогда
		Возврат "Не заполнен адрес участника. Заполните юридический и фактический адрес "
			+ "в контактной информации карточки";
	КонецЕсли;
	Если СтрНайти(ТекстОтвета, "cvc-pattern-valid") > 0 Тогда
		Возврат "Одно из полей не заполнено или не соответствует формату (какое - видно по типу "
			+ "в подробностях). Проверьте карточку контрагента и документ";
	КонецЕсли;
	Возврат "";

КонецФункции

// Отказ ФЛК виден в колонке, а полный текст причины - в журнале регистрации. Регламент повторяет
// попытку каждый прогон, поэтому журнал пишется только при первом отказе.
Процедура ЗафиксироватьОшибкуФЛК(Знач Ссылка, Знач ТекстОшибки)

	Текущий = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Ссылка, СвойствоОбъектов("ЭДО_Состояние", Истина))));
	Если Текущий = ТекстОшибкиФЛК() Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьЧитаемыйСтатус(Ссылка, ТекстОшибкиФЛК());
	ЗаписьЖурналаРегистрации("ЭДО.ОшибкаФЛК", УровеньЖурналаРегистрации.Ошибка, , Ссылка,
		Лев(ТекстОшибки, 5000));

КонецПроцедуры

// Наше ли это значение колонки, то есть можно ли его перезаписывать.
Функция ЗначениеКолонкиНаше(Знач Текст) Экспорт
	Значение = СокрЛП(Текст);
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Истина;   // пусто - писать можно
	КонецЕсли;
	Если Значение = ТекстСтатусаОтправкаНеТребуется() Тогда
		Возврат Ложь;     // его же ищет отбор очереди - не трогать ни при каких условиях
	КонецЕсли;
	Если ТекстыПричинНеотправки().Найти(Значение) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если УстаревшиеТекстыПричин().Найти(Значение) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	// Карточка у оператора удалена, а идентификатор сняли: сверка документ больше не видит, и без
	// этой ветки колонка навсегда застыла бы на удаленной карточке. Документ с идентификатором
	// отсюда не перезапишется: ПричинаНеотправки для него возвращает пустую строку.
	Если Значение = ТекстКарточкаУдалена() ИЛИ ВРег(Значение) = "DELETED" Тогда
		Возврат Истина;
	КонецЕсли;
	Если Найти(Значение, ПрефиксОжиданияПроверкиУКД()) = 1 Тогда
		Возврат Истина;
	КонецЕсли;
	// ЩА 15.10.2026 [yan]: прежний префикс незнакомого статуса связи и прежний текст удержания канала.
	Если Найти(Значение, ПрежнийПрефиксПричиныСвязи()) = 1 ИЛИ Найти(Значение, "Удержан: ") = 1 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Найти(Значение, ПрефиксПричиныСвязи()) = 1;
КонецФункции

// Почему документ не уходит - текстом для колонки "ЭДО".
// Порядок веток повторяет порядок отсева самой отправки: сначала "уже в работе",
// потом "ушел другим каналом", потом причины, по которым документ не берется в очередь.
Функция ПричинаНеотправки(Знач ИдПлатформы, Знач КодСтатуса, Знач ЕстьСБИС,
	Знач АдресЭДО, Знач СтатусСвязи, Знач ОтражатьВБухучете = Истина, Знач ЗаказГотов = Истина,
	Знач ГотовКОтправке = Истина, Знач АдресЗакреплен = Истина, Знач ОрганизацияРазрешена = Истина,
	Знач НаПаузе = Ложь, Знач ЕстьАдресПокупателя = Истина, Знач ВнеСпискаАвтоотправки = Ложь) Экспорт

	Если ЗначениеЗаполнено(ИдПлатформы) Тогда
 // Карточка у оператора создана - документ вне зоны этого механизма: статус пишет отправка
 // и сверки по данным оператора. Пустая строка - "не мой документ, не трогать".
		Возврат "";
	КонецЕсли;
	Если КодСтатуса = 1 Тогда
		Возврат "Взят в отправку, прогон не завершен";
	КонецЕсли;
	Если КодСтатуса = 10 Тогда
		Возврат "Состояние у оператора неизвестно";
	КонецЕсли;
	Если ЕстьСБИС Тогда
		Возврат ТекстОтправленДругимОператором();
	КонецЕсли;

	// Запрет по организации - раньше прочих признаков документа: он не снимается ни печатью,
	// ни отгрузкой, ни связью, и "Ждет печати или пометки" у такого документа врёт.
	Если НЕ ОрганизацияРазрешена Тогда
		Возврат ТекстЗапретаПоОрганизации();
	КонецЕсли;

	// Здесь не пишем "Отправка не требуется": этот текст - фильтр отбора очереди, документ с ним
	// исключается навсегда, а галку бухучета могут поставить задним числом. Причина описывает
	// состояние документа и снимается сама на следующем прогоне.
	Если НЕ ОтражатьВБухучете Тогда
		Возврат "Не отправлен: не в бухучете";
	КонецЕсли;
	Если НЕ ЗаказГотов Тогда
		Возврат "Не отправлен: заказ не отгружен";
	КонецЕсли;
	// Пауза - после признаков самого документа (они не уйдут и без паузы), но до адреса и связи:
	// снять её может только человек, и это первое, что ему надо увидеть.
	Если НаПаузе Тогда
		Возврат ТекстПаузыКонтрагента();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(АдресЭДО) Тогда
		Возврат "Не отправлен: нет адреса ЭДО";
	КонецЕсли;

	// Удержание каналом вне автовыбора идет до разбора связи: связь там исправна (2VO - DIRECT,
	// 2LT - ESTABLISHED), и без этой ветки удержанный документ выглядел бы стоящим в очереди.
	Если АдресЭДОВнеАвтовыбора(АдресЭДО) И НЕ АдресЗакреплен Тогда
		Возврат ТекстУдержанияКанала(ИмяКаналаЭДО(АдресЭДО));
	КонецЕсли;
	Если НЕ ЕстьАдресПокупателя Тогда
		Возврат ТекстНетАдресаПокупателя();
	КонецЕсли;

	Связь = ВРег(СокрЛП(СтатусСвязи));
	Если НЕ ЗначениеЗаполнено(Связь) Тогда
		Возврат "Не отправлен: связь ещё не проверена";
	ИначеЕсли Связь = "ESTABLISHED" ИЛИ Связь = "DIRECT" Тогда
 // Документ годен по всем признакам, но состав ещё не подтверждён: его не печатали
 // и не помечали. Бухгалтеру важно отличать это от "сейчас уйдёт" - иначе документ,
 // ждущий печати, выглядит так же, как стоящий в очереди.
		Если НЕ ГотовКОтправке Тогда
			Возврат "Не отправлен: ждёт печати или пометки";
		КонецЕсли;
		// Документ годен, но очередь его не возьмет: контрагент вне списка автоотправки.
		Возврат ?(ВнеСпискаАвтоотправки, ТекстВнеСпискаАвтоотправки(), "В очереди на отправку");
	ИначеЕсли Связь = "NO_CONTACT" Тогда
		Возврат "Не отправлен: нет связи с контрагентом";
	ИначеЕсли Связь = "AWAIT_APPROVAL" Тогда
		Возврат "Не отправлен: приглашение не принято";
	ИначеЕсли Связь = "BROKEN" Тогда
		Возврат "Не отправлен: связь разорвана";
	КонецЕсли;
	Возврат Лев(ПрефиксПричиныСвязи() + СокрЛП(СтатусСвязи), 50);
КонецФункции

// Проставить причину неотправки всем проведенным документам окна отбора. Отбор шире, чем
// у очереди, намеренно: колонка объясняет и негодные документы, иначе "не уйдет никогда"
// не отличить от "еще не ушло". Причина перечитывается каждый прогон и снимается сама.
// Чужие значения колонки не перезаписываются - см. ЗначениеКолонкиНаше.
// Возврат: Структура (Просмотрено, Записано, Сводка).
Функция ОбновитьПричиныНеотправки(Знач МаксЗаписей = 5000) Экспорт

	Результат = Новый Структура("Просмотрено, Записано, Сводка", 0, 0, "");

	СвойствоТекст = СвойствоОбъектов("ЭДО_Состояние");
	Если СвойствоТекст = Неопределено ИЛИ СвойствоТекст.Пустая() Тогда
		Результат.Сводка = "свойство ЭДО_Состояние не заведено";
		Возврат Результат;
	КонецЕсли;

	СвСБИС  = СвойствоОбъектов("ДокументСБИС_Ид");
	СвПлат  = СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	СвСтат  = СвойствоОбъектов("ЭДО_КодСостояния");
	СвИд    = СвойствоОбъектов("ЭДО_АдресКонтрагента");
	СвСвязь = СвойствоСтатусаСвязиОрганизации();   // ЩА 20.10.2026 [yan]: в запросе - по организации документа
	СвПометка = СвойствоОбъектов("ЭДО_ПометкаКОтправке");
	СвЗакреп = СвойствоОбъектов("ЭДО_АдресЗакреплён");
	// НайтиПоНаименованию возвращает пустую ссылку, а не Неопределено: без проверки на пустоту запрос
	// соединялся бы с регистром по пустому свойству, и документ мог получить чужую причину "ушел через СБИС".
	ЕстьСвойствоСБИС = (СвСБИС <> Неопределено И НЕ СвСБИС.Пустая());

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаСГейтомЗаказа(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ Тов.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ЗаказНеГотов
		|ИЗ Документ.РеализацияТоваровУслуг.Товары КАК Тов
		|ГДЕ Тов.ЗаказПокупателя <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
		|	И (НЕ Тов.ЗаказПокупателя.Статус В (&ГотовыеСтатусы)
		|		ИЛИ НАЧАЛОПЕРИОДА(Тов.ЗаказПокупателя.ДатаОтгрузки, ДЕНЬ) > &СегодняНачалоДня)
		|	И Тов.Ссылка.Дата >= &Дата
		|;
		|" + ТекстТаблицАдресаПокупателя() + "
		|;
		|ВЫБРАТЬ
		|	РТУ.Ссылка КАК Ссылка,
		|	ВЫБОР КОГДА СвойАдрес.Контрагент ЕСТЬ НЕ NULL ИЛИ АдресПоИНН.ИНН ЕСТЬ НЕ NULL
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ЕстьАдресПокупателя,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Плат.Значение КАК СТРОКА(50)), """") КАК ИдПлатформы,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Стат.Значение КАК ЧИСЛО(10, 0)), 0) КАК КодСтатуса,
		|	ВЫБОР КОГДА СБИС.Объект ЕСТЬ НЕ NULL ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ЕстьСБИС,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Ид.Значение КАК СТРОКА(50)), """") КАК АдресЭДО,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Связь.Значение КАК СТРОКА(50)), """") КАК СтатусСвязи,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Текст.Значение КАК СТРОКА(50)), """") КАК ТекущийТекст,
		|	ВЫБОР КОГДА ВЫРАЗИТЬ(Пометка.Значение КАК БУЛЕВО) = ИСТИНА
		|			ИЛИ ВЫРАЗИТЬ(Пометка.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК Помечен,
		|	ВЫБОР КОГДА ВЫРАЗИТЬ(Закреп.Значение КАК БУЛЕВО) = ИСТИНА
		|			ИЛИ ВЫРАЗИТЬ(Закреп.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК АдресЗакреплен,
		|	ВЫБОР КОГДА ВЫРАЗИТЬ(Разр.Значение КАК БУЛЕВО) = ИСТИНА
		|			ИЛИ ВЫРАЗИТЬ(Разр.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ОрганизацияРазрешена,
		|	ВЫБОР КОГДА ЕСТЬNULL(ВЫРАЗИТЬ(Пауза.Значение КАК БУЛЕВО), ЛОЖЬ) = ИСТИНА
		|			ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Пауза.Значение КАК СТРОКА(50)), """") В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК НаПаузе,
		|	ВЫБОР КОГДА &ТолькоРазрешенным И НЕ (ЕСТЬNULL(ВЫРАЗИТЬ(Авто.Значение КАК БУЛЕВО), ЛОЖЬ) = ИСТИНА
		|			ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Авто.Значение КАК СТРОКА(50)), """") В (""Да"", ""Истина"", ""1""))
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ВнеСпискаАвтоотправки,
		|	РТУ.Дата КАК ДатаДокумента,
		|	РТУ.ОтражатьВБухгалтерскомУчете КАК ОтражатьВБухучете,
		|	ВЫБОР КОГДА НеГотов.Ссылка ЕСТЬ NULL ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ЗаказГотов
		|ИЗ Документ.РеализацияТоваровУслуг КАК РТУ
		|	ЛЕВОЕ СОЕДИНЕНИЕ ЗаказНеГотов КАК НеГотов ПО НеГотов.Ссылка = РТУ.Ссылка
		|	ЛЕВОЕ СОЕДИНЕНИЕ КарточкиСАдресом КАК СвойАдрес ПО СвойАдрес.Контрагент = РТУ.Контрагент
		|	ЛЕВОЕ СОЕДИНЕНИЕ ИННСАдресом КАК АдресПоИНН ПО АдресПоИНН.ИНН = РТУ.Контрагент.ИНН
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК СБИС
		|		ПО СБИС.Объект = РТУ.Ссылка И СБИС.Свойство = &СвСБИС
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Плат
		|		ПО Плат.Объект = РТУ.Ссылка И Плат.Свойство = &СвПлат
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Стат
		|		ПО Стат.Объект = РТУ.Ссылка И Стат.Свойство = &СвСтат
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Текст
		|		ПО Текст.Объект = РТУ.Ссылка И Текст.Свойство = &СвТекст
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Пометка
		|		ПО Пометка.Объект = РТУ.Ссылка И Пометка.Свойство = &СвПометка
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Ид
		|		ПО ВЫРАЗИТЬ(Ид.Объект КАК Справочник.Контрагенты) = РТУ.Контрагент И Ид.Свойство = &СвИд
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Связь
		|		ПО ВЫРАЗИТЬ(Связь.Объект КАК Справочник.Контрагенты) = РТУ.Контрагент И Связь.Свойство = &СвСвязь
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Закреп
		|		ПО ВЫРАЗИТЬ(Закреп.Объект КАК Справочник.Контрагенты) = РТУ.Контрагент И Закреп.Свойство = &СвЗакреп
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Разр
		|		ПО ВЫРАЗИТЬ(Разр.Объект КАК Справочник.Организации) = РТУ.Организация И Разр.Свойство = &СвРазр
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Пауза
		|		ПО ВЫРАЗИТЬ(Пауза.Объект КАК Справочник.Контрагенты) = РТУ.Контрагент И Пауза.Свойство = &СвПауза
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Авто
		|		ПО ВЫРАЗИТЬ(Авто.Объект КАК Справочник.Контрагенты) = РТУ.Контрагент И Авто.Свойство = &СвАвто
		|ГДЕ РТУ.Проведен И РТУ.Дата >= &Дата
		|УПОРЯДОЧИТЬ ПО РТУ.Дата УБЫВ");
	Запрос.УстановитьПараметр("ГотовыеСтатусы", ГотовыеСтатусыЗаказа());
	Запрос.УстановитьПараметр("СегодняНачалоДня", НачалоДня(ТекущаяДатаСеанса()));
	ГраницаПодсказок = РанняяДатаНачалаОтправки();
	Если НЕ ЗначениеЗаполнено(ГраницаПодсказок) Тогда
		ГраницаПодсказок = НижняяГраницаОтбора();
	КонецЕсли;
	Запрос.УстановитьПараметр("Дата", ГраницаПодсказок);
	Запрос.УстановитьПараметр("СвСБИС", ?(ЕстьСвойствоСБИС, СвСБИС,
		ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка()));
	Запрос.УстановитьПараметр("СвПлат", СвПлат);
	Запрос.УстановитьПараметр("СвСтат", СвСтат);
	Запрос.УстановитьПараметр("СвТекст", СвойствоТекст);
	Запрос.УстановитьПараметр("СвПометка", ?(СвПометка = Неопределено,
		ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка(), СвПометка));
	Запрос.УстановитьПараметр("СвИд", СвИд);
	Запрос.УстановитьПараметр("СвСвязь", СвСвязь);
	УстановитьСвязьПоОрганизации(Запрос, "РТУ.Организация");   // ЩА 20.10.2026 [yan]
	Запрос.УстановитьПараметр("СвЗакреп", ?(СвЗакреп = Неопределено,
		ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка(), СвЗакреп));
	// Свойства нет - отбор очереди не пропускает никого, и колонка обязана говорить то же.
	СвРазр = СвойствоОбъектов("ЭДО_РазрешенаОтправка");
	Запрос.УстановитьПараметр("СвРазр", ?(СвРазр = Неопределено,
		ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка(), СвРазр));
	СвПауза = СвойствоОбъектов("ЭДО_ОтправкаПриостановлена");
	Запрос.УстановитьПараметр("СвПауза", ?(СвПауза = Неопределено,
		ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка(), СвПауза));
	УстановитьПараметрыСпискаАвтоотправки(Запрос);
	УстановитьПараметрыАдресаПокупателя(Запрос);

	Таблица = Запрос.Выполнить().Выгрузить();
	Результат.Просмотрено = Таблица.Количество();

	// Те же рамки, что у отбора очереди: непомеченный документ вне скользящего окна не уйдет
	// даже по страховке, и писать ему "В очереди на отправку" нельзя.
	ГейтГотовности = Число(НастройкаЭДО("ОтправлятьТолькоПослеГотовности")) <> 0;
	ДнейСтраховки = Число(НастройкаЭДО("ДнейСтраховкиБезПометки"));
	ГраницаСтраховки = ?(ДнейСтраховки > 0, НачалоДня(ТекущаяДатаСеанса()) - ДнейСтраховки * 86400, '00010101');
	ГраницаОкна = НижняяГраницаОтбора();

	Счетчики = Новый Соответствие;
	Для Каждого Строчка Из Таблица Цикл
		Если Результат.Записано >= МаксЗаписей Тогда
			Прервать;
		КонецЕсли;
		Текущий = СокрЛП(Строчка.ТекущийТекст);
		Если НЕ ЗначениеКолонкиНаше(Текущий) Тогда
			Продолжить;
		КонецЕсли;
		Помечен = Строчка.Помечен;   // оба представления флага разобраны запросом
		СрокВышел = (ДнейСтраховки > 0 И Строчка.ДатаДокумента <= ГраницаСтраховки
			И Строчка.ДатаДокумента >= ГраницаОкна);
		НовоеЗначение = ПричинаНеотправки(Строчка.ИдПлатформы, Строчка.КодСтатуса, Строчка.ЕстьСБИС,
			Строчка.АдресЭДО, Строчка.СтатусСвязи, Строчка.ОтражатьВБухучете, Строчка.ЗаказГотов,
			Помечен ИЛИ СрокВышел ИЛИ НЕ ГейтГотовности, Строчка.АдресЗакреплен,
			Строчка.ОрганизацияРазрешена, Строчка.НаПаузе, Строчка.ЕстьАдресПокупателя,
			Строчка.ВнеСпискаАвтоотправки);
		Если НЕ ЗначениеЗаполнено(НовоеЗначение) Тогда
			Продолжить;   // документ уже у оператора - его состояние ведут сверки, не мы
		КонецЕсли;
		Если НовоеЗначение = Текущий Тогда
			Продолжить;   // не переписываем одно и то же - регистр не должен шуметь
		КонецЕсли;
		ЗаписатьЧитаемыйСтатус(Строчка.Ссылка, НовоеЗначение);
		Результат.Записано = Результат.Записано + 1;
		Счетчики.Вставить(НовоеЗначение, ?(Счетчики[НовоеЗначение] = Неопределено, 0, Счетчики[НовоеЗначение]) + 1);
	КонецЦикла;

	// Корректировки реализации ведет тот же механизм, их счетчики идут в общую сводку.
	Если Результат.Записано < МаксЗаписей Тогда
		Корректировки = ОбновитьПричиныНеотправкиКорректировок(МаксЗаписей - Результат.Записано);
		Результат.Просмотрено = Результат.Просмотрено + Корректировки.Просмотрено;
		Результат.Записано = Результат.Записано + Корректировки.Записано;
		Для Каждого Пара Из Корректировки.Счетчики Цикл
			Счетчики.Вставить("УКД " + Пара.Ключ, Пара.Значение);
		КонецЦикла;
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Пара Из Счетчики Цикл
		Части.Добавить(Пара.Ключ + ": " + Пара.Значение);
	КонецЦикла;
	Результат.Сводка = СтрСоединить(Части, ", ");

	Возврат Результат;
КонецФункции

// Причины неотправки в колонку "ЭДО" для корректировок реализации с даты начала автоотправки
// УКД. Автоотправка выключена - корректировки не трогаем: их шлют вручную, и подсказка
// "В очереди на отправку" у них врала бы.
// Возврат: Структура (Просмотрено, Записано, Счетчики - Соответствие текст -> количество).
Функция ОбновитьПричиныНеотправкиКорректировок(Знач МаксЗаписей = 5000) Экспорт

	Результат = Новый Структура("Просмотрено, Записано, Счетчики", 0, 0, Новый Соответствие);
	ДатаНачала = ДатаНачалаАвтоотправкиУКД();
	СвойствоТекст = СвойствоОбъектов("ЭДО_Состояние");
	Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ СвойствоТекст.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстТаблицАдресаПокупателя() + "
		|;
		|" + ТекстТаблицыКорректировокСИзменениями() + "
		|;
		|ВЫБРАТЬ
		|	Корр.Ссылка КАК Ссылка,
		|	Корр.ВерсияДанных КАК ВерсияДанных,
		|	ВЫБОР КОГДА Корр.ВидОперации = &ВидПоСогласованию ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ПоСогласованию,
		|	ВЫБОР КОГДА Изм.Ссылка ЕСТЬ NULL ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ КАК ЕстьИзменения,
		|	Корр.ОтражатьВБухгалтерскомУчете КАК ОтражатьВБухучете,
		|	ВЫБОР КОГДА СвойАдрес.Контрагент ЕСТЬ НЕ NULL ИЛИ АдресПоИНН.ИНН ЕСТЬ НЕ NULL
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ЕстьАдресПокупателя,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Плат.Значение КАК СТРОКА(50)), """") КАК ИдПлатформы,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Стат.Значение КАК ЧИСЛО(10, 0)), 0) КАК КодСтатуса,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Ид.Значение КАК СТРОКА(50)), """") КАК АдресЭДО,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Связь.Значение КАК СТРОКА(50)), """") КАК СтатусСвязи,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Текст.Значение КАК СТРОКА(50)), """") КАК ТекущийТекст,
		|	ВЫБОР КОГДА ВЫРАЗИТЬ(Закреп.Значение КАК БУЛЕВО) = ИСТИНА
		|			ИЛИ ВЫРАЗИТЬ(Закреп.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК АдресЗакреплен,
		|	ВЫБОР КОГДА ВЫРАЗИТЬ(Разр.Значение КАК БУЛЕВО) = ИСТИНА
		|			ИЛИ ВЫРАЗИТЬ(Разр.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ОрганизацияРазрешена,
		|	ВЫБОР КОГДА ЕСТЬNULL(ВЫРАЗИТЬ(Пауза.Значение КАК БУЛЕВО), ЛОЖЬ) = ИСТИНА
		|			ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Пауза.Значение КАК СТРОКА(50)), """") В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК НаПаузе,
		|	ВЫБОР КОГДА &ТолькоРазрешенным И НЕ (ЕСТЬNULL(ВЫРАЗИТЬ(Авто.Значение КАК БУЛЕВО), ЛОЖЬ) = ИСТИНА
		|			ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Авто.Значение КАК СТРОКА(50)), """") В (""Да"", ""Истина"", ""1""))
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ВнеСпискаАвтоотправки,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(ИсхИд.Значение КАК СТРОКА(50)), """") КАК ИдИсходника,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(ИсхСост.Значение КАК СТРОКА(50)), """") КАК СостояниеИсходника,
		|	Корр.ДокументРеализации КАК Исходник,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Ожидание.Значение КАК СТРОКА(50)), """") КАК Отметка
		|ИЗ Документ.КорректировкаРеализации КАК Корр
		|	ЛЕВОЕ СОЕДИНЕНИЕ КарточкиСАдресом КАК СвойАдрес ПО СвойАдрес.Контрагент = Корр.Контрагент
		|	ЛЕВОЕ СОЕДИНЕНИЕ ИННСАдресом КАК АдресПоИНН ПО АдресПоИНН.ИНН = Корр.Контрагент.ИНН
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Плат
		|		ПО Плат.Объект = Корр.Ссылка И Плат.Свойство = &СвПлат
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Стат
		|		ПО Стат.Объект = Корр.Ссылка И Стат.Свойство = &СвСтат
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Текст
		|		ПО Текст.Объект = Корр.Ссылка И Текст.Свойство = &СвТекст
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Ожидание
		|		ПО Ожидание.Объект = Корр.Ссылка И Ожидание.Свойство = &СвОжидание
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ИсхИд
		|		ПО ИсхИд.Объект = Корр.ДокументРеализации И ИсхИд.Свойство = &СвПлат
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ИсхСост
		|		ПО ИсхСост.Объект = Корр.ДокументРеализации И ИсхСост.Свойство = &СвТекст
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Ид
		|		ПО ВЫРАЗИТЬ(Ид.Объект КАК Справочник.Контрагенты) = Корр.Контрагент И Ид.Свойство = &СвИд
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Связь
		|		ПО ВЫРАЗИТЬ(Связь.Объект КАК Справочник.Контрагенты) = Корр.Контрагент И Связь.Свойство = &СвСвязь
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Закреп
		|		ПО ВЫРАЗИТЬ(Закреп.Объект КАК Справочник.Контрагенты) = Корр.Контрагент И Закреп.Свойство = &СвЗакреп
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Разр
		|		ПО ВЫРАЗИТЬ(Разр.Объект КАК Справочник.Организации) = Корр.Организация И Разр.Свойство = &СвРазр
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Пауза
		|		ПО ВЫРАЗИТЬ(Пауза.Объект КАК Справочник.Контрагенты) = Корр.Контрагент И Пауза.Свойство = &СвПауза
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Авто
		|		ПО ВЫРАЗИТЬ(Авто.Объект КАК Справочник.Контрагенты) = Корр.Контрагент И Авто.Свойство = &СвАвто
		|	ЛЕВОЕ СОЕДИНЕНИЕ КорректировкиСИзменениями КАК Изм
		|		ПО Изм.Ссылка = Корр.Ссылка
		|ГДЕ Корр.Проведен И Корр.Дата >= &Дата
		|УПОРЯДОЧИТЬ ПО Корр.Дата УБЫВ";
	Запрос.УстановитьПараметр("Дата", ДатаНачала);
	Запрос.УстановитьПараметр("ВидПоСогласованию", ВидКорректировкиПоСогласованию());
	Запрос.УстановитьПараметр("СвТекст", СвойствоТекст);
	Запрос.УстановитьПараметр("СвПлат", СвойствоОбъектов("ЭДО_ИдентификаторДокумента"));
	Запрос.УстановитьПараметр("СвСтат", СвойствоОбъектов("ЭДО_КодСостояния"));
	Запрос.УстановитьПараметр("СвИд", СвойствоОбъектов("ЭДО_АдресКонтрагента"));
	УстановитьСвязьПоОрганизации(Запрос, "Корр.Организация");   // ЩА 20.10.2026 [yan]: статус связи по организации УКД
	Запрос.УстановитьПараметр("СвЗакреп", СвойствоОбъектов("ЭДО_АдресЗакреплён"));
	Запрос.УстановитьПараметр("СвРазр", СвойствоОбъектов("ЭДО_РазрешенаОтправка"));
	Запрос.УстановитьПараметр("СвПауза", СвойствоОбъектов("ЭДО_ОтправкаПриостановлена"));
	УстановитьПараметрыСпискаАвтоотправки(Запрос);
	Запрос.УстановитьПараметр("СвОжидание", СвойствоОбъектов(ИмяСвойстваОжиданияУКД()));
	УстановитьПараметрыАдресаПокупателя(Запрос);

	Таблица = Запрос.Выполнить().Выгрузить();
	Результат.Просмотрено = Таблица.Количество();

	// ЩА 15.10.2026 [yan]: подпись исходника у другого оператора - одним пакетным вызовом точки профиля на прогон,
	// а не по вызову на строку; отказ профиля пишется в журнал и прогон не обрывает.
	НеПринятыеИсходники = Новый Массив;
	Для Каждого Строчка Из Таблица Цикл
		Если (НЕ ЗначениеЗаполнено(Строчка.ИдИсходника) ИЛИ НЕ ПодписанПоТекстуКолонки(Строчка.СостояниеИсходника))
			И ЗначениеЗаполнено(Строчка.Исходник) И НеПринятыеИсходники.Найти(Строчка.Исходник) = Неопределено Тогда
			НеПринятыеИсходники.Добавить(Строчка.Исходник);
		КонецЕсли;
	КонецЦикла;
	Попытка
		ПодписаныУДругого = ИсходникиПодписаныУДругогоОператора(НеПринятыеИсходники);
	Исключение
		ПодписаныУДругого = Новый Соответствие;
		ЗаписьЖурналаРегистрации("ЭДО.ПричиныКорректировок", УровеньЖурналаРегистрации.Ошибка, , ,
			"Проверка исходников у другого оператора: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Сейчас = ТекущаяДатаСеанса();
	Для Каждого Строчка Из Таблица Цикл
		Если Результат.Записано >= МаксЗаписей Тогда
			Прервать;
		КонецЕсли;
		Текущий = СокрЛП(Строчка.ТекущийТекст);
		Если НЕ ЗначениеКолонкиНаше(Текущий) Тогда
			Продолжить;
		КонецЕсли;
		НовоеЗначение = ПричинаНеотправкиКорректировки(Строчка, Сейчас, ПодписаныУДругого);
		Если НЕ ЗначениеЗаполнено(НовоеЗначение) ИЛИ НовоеЗначение = Текущий Тогда
			Продолжить;
		КонецЕсли;
		ЗаписатьЧитаемыйСтатус(Строчка.Ссылка, НовоеЗначение);
		Результат.Записано = Результат.Записано + 1;
		Сколько = Результат.Счетчики.Получить(НовоеЗначение);
		Результат.Счетчики.Вставить(НовоеЗначение, ?(Сколько = Неопределено, 0, Сколько) + 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Текст колонки для корректировки по строке запроса ОбновитьПричиныНеотправкиКорректировок.
// Сначала общие причины реализаций; когда по ним документ годен, - гейты автоотправки УКД
// в том же порядке, что в ПричинаУдержанияКорректировки. Пустая строка - документ у оператора.
// ПодписаныУДругого - см. ИсходникиПодписаныУДругогоОператора, собирается один раз на прогон.
Функция ПричинаНеотправкиКорректировки(Знач Строчка, Знач Сейчас, Знач ПодписаныУДругого)

	ТекстВОчереди = "В очереди на отправку";
	Причина = ПричинаНеотправки(Строчка.ИдПлатформы, Строчка.КодСтатуса, Ложь, Строчка.АдресЭДО,
		Строчка.СтатусСвязи, Строчка.ОтражатьВБухучете, Истина, Истина, Строчка.АдресЗакреплен,
		Строчка.ОрганизацияРазрешена, Строчка.НаПаузе, Строчка.ЕстьАдресПокупателя,
		Строчка.ВнеСпискаАвтоотправки);
	Если Причина <> ТекстВОчереди Тогда
		Возврат Причина;
	КонецЕсли;

	Если НЕ Строчка.ПоСогласованию Тогда
		Возврат ТекстКорректировкаНеУКД();
	КонецЕсли;
	Если НЕ Строчка.ЕстьИзменения Тогда
		Возврат ТекстКорректировкаБезИзменений();
	КонецЕсли;
	ПричинаИсходника = "";
	Если НЕ ЗначениеЗаполнено(Строчка.ИдИсходника) Тогда
		ПричинаИсходника = ТекстИсходникНеОтправлен();
	ИначеЕсли НЕ ПодписанПоТекстуКолонки(Строчка.СостояниеИсходника) Тогда
		ПричинаИсходника = ТекстИсходникНеПодписан();
	КонецЕсли;
	Если ЗначениеЗаполнено(ПричинаИсходника)
		И ПодписаныУДругого.Получить(Строчка.Исходник) <> Истина Тогда
		Возврат ПричинаИсходника;
	КонецЕсли;

	Ожидание = ОжиданиеКорректировки(Строчка.Отметка, Строчка.ВерсияДанных, Сейчас);
	Если Ожидание.Выдержана Тогда
		Возврат ТекстВОчереди;
	КонецЕсли;
	Возврат ТекстОжиданияПроверкиУКД(Ожидание.Окончание);

КонецФункции

#КонецОбласти

#Область Аннулирование

// Аннулирование в ЭДО двустороннее: мы шлем предложение (ПОА), контрагент подтверждает его
// у себя, и только тогда документ аннулирован. На входящее предложение отвечаем подписью
// (принять) или универсальным сообщением с отказом.

// Типовые причины, которые уходят контрагенту в тексте ПОА. Формулировки утверждены
// оператором: человек на той стороне читает только этот текст, без сопровождения.
Функция ТиповыеПричиныАннулирования() Экспорт

	Причины = Новый Массив;
	Причины.Добавить("Исправление кодов маркировки: в отправленном документе искажен код идентификации товара");
	Причины.Добавить("Уточнение количества: в отправленном документе вес или количество не совпадают с фактической приемкой, исправленный документ отправлен отдельно");
	Причины.Добавить(ПричинаАннулированияДубля());
	Возврат Причины;

КонецФункции

// Причина для лишнего экземпляра документа: ее шлет и регламент аннулирования лишних экземпляров.
Функция ПричинаАннулированияДубля() Экспорт
	Возврат "Ошибочно создан повторный экземпляр документа (дубль отправки)";
КонецФункции

// Отправить контрагенту предложение об аннулировании экземпляра документа у оператора.
// ИдКарточки - идентификатор экземпляра у оператора (строка истории отправок).
// Возврат: Структура (Успех, Текст).
// ЩА 20.10.2026 [yan]: Организация - учетная запись, чей это экземпляр (входящий без документа базы).
Функция ПредложитьАннулирование(Знач ИдКарточки, Знач Причина, Знач Документ = Неопределено, Знач ОрганизацияЭкземпляра = Неопределено) Экспорт

	Итог = Новый Структура("Успех, Текст", Ложь, "");
	ИдКарточки = СокрЛП(ИдКарточки);
	Причина = СокрЛП(Причина);
	Если НЕ ЗначениеЗаполнено(ИдКарточки) ИЛИ НЕ ЗначениеЗаполнено(Причина) Тогда
		Итог.Текст = "Не указан экземпляр документа или причина аннулирования.";
		Возврат Итог;
	КонецЕсли;

	Попытка
		Организация = ?(ЗначениеЗаполнено(ОрганизацияЭкземпляра), ОрганизацияЭкземпляра, ОрганизацияДокумента(Документ));
		Подписант = ПодписантДляОператора(Организация);
		Тело = Новый Структура("reason, signer", Причина,
			Новый Структура("person, position", Подписант.ФИО, Подписант.Должность));
		Ответ = ЗапросКОператоруЭДО("PUT", "/public/api/v3/documents/" + ИдКарточки + "/cancellation", СтрокаJSON(Тело), Организация);
		Если Ответ.Код <> 200 Тогда
			Итог.Текст = "Платформа не приняла предложение об аннулировании: HTTP " + Ответ.Код + " " + Лев(Ответ.Текст, 300);
			Возврат Итог;
		КонецЕсли;
		ИдПОА = ЭДО_Регламенты.ИдентификаторСтрокой(ПрочитатьОтветJSON(Ответ.Текст).Получить("id"));

		Подписание = ПодписатьДокументОператора(ИдПОА, Организация);
		Если НЕ Подписание.Успех Тогда
			Итог.Текст = "Предложение об аннулировании создано (ид " + ИдПОА + "), но не подписано: " + Подписание.Текст
				+ " Контрагенту оно не уйдет, пока не будет подписано.";
			Возврат Итог;
		КонецЕсли;
	Исключение
		Итог.Текст = "Аннулирование не отправлено: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Итог;
	КонецПопытки;

	// ЩА 15.10.2026 [yan]: колонка сразу показывает, что запрос ушел; точечная сверка дальше следит за ответом.
	// Только для экземпляра, который показан в колонке: аннулирование лишнего дубля сторожем
	// состояние основного документа не меняет.
	Если ЗначениеЗаполнено(Документ) И ИдентификаторЭкземпляраДокумента(Документ) = ИдКарточки Тогда
		Попытка
			ЗаписатьЧитаемыйСтатус(Документ, ТекстАннулированиеЖдемОтвета());
		Исключение
			ЗаписьЖР("ЭДО.Аннулирование", "Предупреждение", , Документ,
				"Колонка состояния не обновлена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	Итог.Успех = Истина;
	Итог.Текст = "Предложение об аннулировании отправлено контрагенту (ид " + ИдПОА + ")."
		+ " Документ будет аннулирован, когда контрагент его подтвердит.";
	Возврат Итог;

КонецФункции

// Ответить на входящие запросы аннулирования по документу базы.
// Принять = Истина - подписываем ПОА контрагента, документ аннулируется.
// Принять = Ложь - отказ универсальным сообщением, Причина обязательна.
// Возврат: Структура (Успех, Текст).
Функция ОтветитьНаЗапросАннулирования(Знач Ссылка, Знач Принять, Знач Причина = "") Экспорт

	Итог = Новый Структура("Успех, Текст", Ложь, "");
	Причина = СокрЛП(Причина);
	Если НЕ Принять И НЕ ЗначениеЗаполнено(Причина) Тогда
		Итог.Текст = "Для отказа нужна причина: ее прочитает контрагент.";
		Возврат Итог;
	КонецЕсли;

	Попытка
		Организация = ОрганизацияДокумента(Ссылка);
		Открытые = Новый Массив;
		Для Каждого Предложение Из ЭДО_Сторожа.ВходящиеПредложенияАннулирования(, Организация) Цикл
			Если Предложение.Статус = "SENT" И Предложение.Ссылка = Ссылка Тогда
				Открытые.Добавить(Предложение);
			КонецЕсли;
		КонецЦикла;
		Если Открытые.Количество() = 0 Тогда
			Итог.Текст = "Открытых запросов на аннулирование по документу у оператора нет: на них уже ответили.";
			ЗаписатьСвойствоОбъекта(Ссылка, СвойствоОбъектов("ЭДО_ЗапросАннулирования"), "");
			Возврат Итог;
		КонецЕсли;

		Подписант = ПодписантДляОператора(Организация);
		НашГид = ГидОрганизации(Организация);
		Ошибки = Новый Массив;
		Для Каждого Предложение Из Открытые Цикл
			Если Принять Тогда
				Подписание = ПодписатьДокументОператора(Предложение.ИдПОА, Организация);
				Если НЕ Подписание.Успех Тогда
					Ошибки.Добавить(Предложение.ИдПОА + ": " + Подписание.Текст);
				КонецЕсли;
			Иначе
				Тело = Новый Структура("sender, recipient, status, description, senderPerson",
					Новый Структура("id", НашГид), Новый Структура("id", Предложение.Отправитель),
					"REJECTION", Причина, Подписант.ФИО);
				Ответ = ЗапросКОператоруЭДО("POST", "/public/api/v3/documents/" + Предложение.ИдПОА + "/universal-message", СтрокаJSON(Тело), Организация);
				Если Ответ.Код <> 200 И Ответ.Код <> 201 Тогда
					Ошибки.Добавить(Предложение.ИдПОА + ": HTTP " + Ответ.Код + " " + Лев(Ответ.Текст, 200));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Итог.Текст = "Ответ не отправлен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Итог;
	КонецПопытки;

	Если Ошибки.Количество() > 0 Тогда
		Итог.Текст = "Ответ отправлен не по всем запросам: " + СтрСоединить(Ошибки, "; ");
		Возврат Итог;
	КонецЕсли;

	ЗаписатьСвойствоОбъекта(Ссылка, СвойствоОбъектов("ЭДО_ЗапросАннулирования"), "");
	Итог.Успех = Истина;
	Итог.Текст = ?(Принять, "Аннулирование принято", "Отказ в аннулировании отправлен")
		+ ?(Открытые.Количество() > 1, " по " + Открытые.Количество() + " запросам", "") + ".";
	Возврат Итог;

КонецФункции

// ФИО подписанта из сертификата, как берет их и обработка вендора; должность и МЧД -
// из учетной записи организации.
Функция ПодписантДляОператора(Знач Организация = Неопределено)

	Запись = ОбязательнаяУчетнаяЗаписьЭДО(Организация);
	Сертификат = СертификатПодписанта(Запись.Организация);
	Если Сертификат = Неопределено Тогда
		ВызватьИсключение "сертификат подписанта не найден в хранилище сервера";
	КонецЕсли;
	Субъект = Сертификат.Субъект;
	ИмяОтчество = СтрРазделить(ПолеСубъектаСертификата(Субъект, "GN"), " ", Ложь);
	ФИО = Новый Структура("first, last, middle",
		?(ИмяОтчество.Количество() > 0, ИмяОтчество[0], ""),
		ПолеСубъектаСертификата(Субъект, "SN"),
		?(ИмяОтчество.Количество() > 1, ИмяОтчество[1], ""));
	Должность = Запись.ДолжностьПодписанта;
	Если НЕ ЗначениеЗаполнено(Должность) Тогда
		Должность = ПолеСубъектаСертификата(Субъект, "T");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Должность) Тогда
		Должность = ?(Запись.ТипПодписанта = "ФЛ", "Уполномоченное физическое лицо", "Индивидуальный предприниматель");
	КонецЕсли;

	Подписант = Новый Структура("ФИО, Должность, НомерМЧД, ДатаМЧД", ФИО, Должность, "", Дата(1, 1, 1));
	// ++ ЩА 12.10.2026 [yan], УКД 5.01: подписант - работник организации-покупателя (ИНН и наименование ЮЛ).
	Подписант.Вставить("ИННОрганизации", СокрЛП(Запись.Организация.ИНН));
	Подписант.Вставить("НаименованиеОрганизации", СокрЛП(Запись.Организация.НаименованиеПолное));
	// -- ЩА 12.10.2026 [yan].
	Если Запись.ТипПодписанта = "ФЛ" Тогда
		Подписант.НомерМЧД = Запись.НомерМЧД;
		Подписант.ДатаМЧД = Запись.ДатаМЧД;
	КонецЕсли;
	Возврат Подписант;

КонецФункции

// Принять входящее предложение об аннулировании: подписать ПОА нашей КЭП.
// Возврат: Структура (Успех, Текст).
Функция ПринятьПредложениеАннулирования(Знач ИдПОА, Знач Организация = Неопределено) Экспорт

	Возврат ПодписатьДокументОператора(ИдПОА, Организация);

КонецФункции

// Подписать документ, созданный оператором (ПОА, ответ): скачать содержимое, подписать КЭП
// сервера и присоединить подпись. Возврат: Структура (Успех, Текст).
Функция ПодписатьДокументОператора(Знач ИдДокумента, Знач Организация = Неопределено)

	Итог = Новый Структура("Успех, Текст", Ложь, "");
	Содержимое = ЗапросКОператоруЭДО("GET", "/public/api/v3/documents/" + ИдДокумента + "/content", , Организация);
	Если Содержимое.Код <> 200 Тогда
		Итог.Текст = "содержимое не получено, HTTP " + Содержимое.Код;
		Возврат Итог;
	КонецЕсли;
	Подпись = ПодписатьДанные(Содержимое.Данные, Организация);
	Если Подпись = Неопределено Тогда
		Итог.Текст = "подпись КЭП на сервере не удалась";
		Возврат Итог;
	КонецЕсли;
	Тело = ТелоПодписиДокумента(Подпись, Организация);
	Ответ = ЗапросКОператоруЭДО("PUT", "/public/api/v4/documents/" + ИдДокумента + "/signature", Тело, Организация);
	Если Ответ.Код <> 200 Тогда
		Итог.Текст = "подпись не принята, HTTP " + Ответ.Код + " " + Лев(Ответ.Текст, 200);
		Возврат Итог;
	КонецЕсли;
	Итог.Успех = Истина;
	Возврат Итог;

КонецФункции

// Запрос к сервису оператора (по умолчанию сервис документов; "crpt" - раздел ГИС МТ) с одним
// перевыпуском токена на 401.
// Возврат: Структура (Код, Текст, Данные).
Функция ЗапросКОператоруЭДО(Знач Метод, Знач Путь, Знач Тело = Неопределено, Знач Организация = Неопределено,
	Знач Сервис = "document", Знач Принимать = "")

	Итог = Новый Структура("Код, Текст, Данные", 0, "", Неопределено);
	ОбязательнаяУчетнаяЗаписьЭДО(Организация);
	Если НЕ ОбеспечитьТокен(Ложь, Организация) Тогда
		ВызватьИсключение "не удалось получить токен авторизации";
	КонецЕсли;
	Для НомерПопытки = 1 По 2 Цикл
		Заголовки = Новый Соответствие;
		// ЩА 20.10.2026 [yan]: Принимать - другой тип ответа (печатная форма PDF).
		Заголовки.Вставить("accept", ?(ЗначениеЗаполнено(Принимать), Принимать, "application/json;charset=UTF-8"));
		Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));
		Если Тело <> Неопределено Тогда
			Заголовки.Вставить("Content-Type", "application/json;charset=UTF-8");
		КонецЕсли;
		Запрос = Новый HTTPЗапрос(ПутьСервиса(Сервис) + Путь, Заголовки);
		Если Тело <> Неопределено Тогда
			Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		КонецЕсли;
		Ответ = СоединениеСОператором(30).ВызватьHTTPМетод(Метод, Запрос);
		Если Ответ.КодСостояния = 401 И НомерПопытки = 1 Тогда
			ОбеспечитьТокен(Истина, Организация);
			Продолжить;
		КонецЕсли;
		Итог.Код = Ответ.КодСостояния;
		Итог.Данные = Ответ.ПолучитьТелоКакДвоичныеДанные();
		Итог.Текст = Ответ.ПолучитьТелоКакСтроку("UTF-8");
		Прервать;
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Тело PUT signature. Подписант-физлицо передает номер МЧД рядом с подписью: оператор
// отдает его получателю и при прямом обмене, и в роуминге.
Функция ТелоПодписиДокумента(Знач Подпись, Знач Организация = Неопределено)

	Тело = Новый Структура("value", ОчиститьBase64(Base64Строка(Подпись)));
	Запись = УчетнаяЗаписьЭДО(Организация);
	Если Запись <> Неопределено И Запись.ТипПодписанта = "ФЛ" И ЗначениеЗаполнено(Запись.НомерМЧД) Тогда
		Тело.Вставить("poa", Новый Структура("number", Запись.НомерМЧД));
	КонецЕсли;
	Возврат СтрокаJSON(Тело);

КонецФункции

Функция СтрокаJSON(Знач Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

Функция ПрочитатьОтветJSON(Знач Текст)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Значение = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Значение;

КонецФункции

#КонецОбласти

#Область ФиксацияГИСМТ

// Фиксация документа в ГИС МТ (Честный знак) по товарной группе "Пиво": до передачи УПД покупателю
// документ должен быть зафиксирован ("разрешение на отгрузку"). Фиксацию делает сам оператор,
// расширение ее только читает через раздел API "ЭДО - ГИС МТ" (сервис crpt) и показывает в карточке.
// Состояние хранится в свойстве ЭДО_СтатусГИСМТ, его обновляет регламент сверки статусов.

// Оператор не знает фиксации документа. Без продукции с фиксацией - окончательное «не требуется»,
// с ней - промежуточное «нет данных», чтобы следующая сверка спросила снова.
Функция ИтогФиксацииНеНайдена(Итог, Знач Ссылка)
	Если ЕстьПродукцияСФиксацией(Ссылка) Тогда
		Итог.Требуется = Истина;
		// Не "Нет данных": так помечаются сбои запроса, пять подряд обрывают прогон сверки.
		Итог.Итог = "Фиксация у оператора не найдена";
	Иначе
		Итог.Требуется = Ложь;
		Итог.Итог = ТекстСтатусаГИСМТНеТребуется();
	КонецЕсли;
	Возврат Итог;
КонецФункции

// Текст свойства: фиксация состоялась. Окончательное значение, повторно не запрашивается.
Функция ТекстСтатусаГИСМТЗафиксирован() Экспорт
	Возврат "Зафиксирован в ЧЗ";
КонецФункции

// Текст свойства: оператор ответил, что фиксации у документа нет (не пиво). Окончательное значение.
Функция ТекстСтатусаГИСМТНеТребуется() Экспорт
	Возврат "Фиксация не требуется";
КонецФункции

// ++ ЩА 15.10.2026 [yan]: состояние в Честном знаке для показа. «Фиксация» - наше внутреннее слово
// (и только про пиво), бухгалтерии понятнее «обработан» или «ошибка». Хранимые значения
// ЭДО_СтатусГИСМТ не меняются: по ним сверка решает, что спрашивать снова.
// ПолныйТекст - Ложь для колонки списка: документ, которому ЧЗ не нужен, - пустая ячейка.
Функция ТекстЧестногоЗнакаДляПоказа(Знач Значение, Знач ПолныйТекст = Ложь) Экспорт
	Текст = СокрЛП(Строка(Значение));
	Если Текст = ТекстСтатусаГИСМТЗафиксирован() Тогда
		Возврат "Обработан в ЧЗ";
	ИначеЕсли Текст = ТекстСтатусаГИСМТНеТребуется() Тогда
		Возврат ?(ПолныйТекст, "Не требуется", "");
	ИначеЕсли Текст = "Фиксация у оператора не найдена" Тогда
		Возврат "Ждем ответа ЧЗ";
	ИначеЕсли Текст = "Фиксация отменена в ЧЗ" Тогда
		Возврат "Отменен в ЧЗ";
	ИначеЕсли Текст = ТекстОшибкаФиксацииЧЗ() Тогда
		Возврат "Ошибка ЧЗ";
	КонецЕсли;
	Возврат Текст;
КонецФункции

// Состояние фиксации документа в ГИС МТ по данным оператора.
// Ссылка - документ, отправленный через оператора (идентификатор у оператора читается из свойства
// ЭДО_ИдентификаторДокумента, ИдЭкземпляра - другой экземпляр того же документа, например исправляемый).
// Возврат: Структура (Требуется, Статус, Состояние, Описание, РегНомер, Ошибка, Итог):
//   Требуется - Ложь, если у документа нет фиксации или он не отправлялся;
//   Статус - status оператора (NEW, REGISTERED, ACCEPTED, FAILED);
//   Состояние - state.state (SUCCESS, FAILED, IN_PROGRESS);
//   Описание - state.description; РегНомер - info.docId (номер в ГИС МТ);
//   Ошибка - lastError или текст ошибки запроса;
//   Итог - короткая строка не длиннее 50 символов для свойства и показа.
Функция СостояниеФиксацииГИСМТ(Знач Ссылка, Знач ИдЭкземпляра = "") Экспорт

	Итог = Новый Структура("Требуется, Статус, Состояние, Описание, РегНомер, Ошибка, Итог, ИдДокумента, Операция",
		Истина, "", "", "", "", "", "", "", "");

	ИдДокумента = "";
	СвойствоИд = СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если ЗначениеЗаполнено(Ссылка) И СвойствоИд <> Неопределено И НЕ СвойствоИд.Пустая() Тогда
		ЗначениеИд = ЗначениеСвойстваОбъекта(Ссылка, СвойствоИд);
		Если ЗначениеИд <> Неопределено Тогда
			// Неразрывные пробелы появляются, если идентификатор когда-то записали форматом числа.
			ИдДокумента = СокрЛП(СтрЗаменить(Строка(ЗначениеИд), Символы.НПП, ""));
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(ИдЭкземпляра) Тогда
		ИдДокумента = СокрЛП(Строка(ИдЭкземпляра));   // ЩА 21.10.2026 [yan]
	КонецЕсли;
	Итог.ИдДокумента = ИдДокумента;   // ЩА 15.10.2026 [yan]: для запроса причины отказа в ЧЗ
	Если НЕ ЗначениеЗаполнено(ИдДокумента) Тогда
		Итог.Требуется = Ложь;
		Итог.Итог = "Не отправлен";
		Возврат Итог;
	КонецЕсли;

	// Токен и гид берем у организации документа: у разных организаций разные учетные записи.
	Организация = ОрганизацияДокумента(Ссылка);
	Путь = "/public/api/v3/partner/documents/" + ИдДокумента
		+ "?subscriber_gid=" + КодироватьСтроку(ГидОрганизации(Организация), СпособКодированияСтроки.КодировкаURL);

	Попытка
		Ответ = ЗапросКОператоруЭДО("GET", Путь, Неопределено, Организация, "crpt");
	Исключение
		Итог.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Итог.Итог = Лев("Нет данных: " + Итог.Ошибка, 50);
		ЗаписьЖурналаРегистрации("ЭДО.ГИСМТ", УровеньЖурналаРегистрации.Ошибка, , Ссылка,
			"Запрос состояния фиксации не выполнен: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Итог;
	КонецПопытки;

	// 404 и пустой ответ - не ошибка: у документа без пива фиксации нет. Но у документа с пивом
	// 404 значит «фиксации ещё нет» (оператор не подал FIX - например, без флага N4 в имени файла),
	// и окончательным «не требуется» это записывать нельзя: значение больше не перепроверялось бы.
	Если Ответ.Код = 404 Тогда
		Возврат ИтогФиксацииНеНайдена(Итог, Ссылка);
	КонецЕсли;
	Если Ответ.Код <> 200 Тогда
		Итог.Ошибка = "HTTP " + Ответ.Код;
		Итог.Итог = "Нет данных: HTTP " + Ответ.Код;
		Возврат Итог;
	КонецЕсли;
	Если ПустаяСтрока(Ответ.Текст) Тогда
		Возврат ИтогФиксацииНеНайдена(Итог, Ссылка);
	КонецЕсли;

	Попытка
		Данные = ПрочитатьОтветJSON(Ответ.Текст);
	Исключение
		// Неизвестный путь может ответить 200 и HTML вместо данных - это не "не требуется".
		Итог.Ошибка = "ответ не разобран";
		Итог.Итог = "Нет данных: ответ не разобран";
		ЗаписьЖурналаРегистрации("ЭДО.ГИСМТ", УровеньЖурналаРегистрации.Ошибка, , Ссылка,
			"Ответ о фиксации не разобран: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Итог;
	КонецПопытки;
	Если ТипЗнч(Данные) <> Тип("Соответствие") ИЛИ Данные.Количество() = 0 Тогда
		Возврат ИтогФиксацииНеНайдена(Итог, Ссылка);
	КонецЕсли;

	Итог.Статус = ТекстПоляОтветаГИСМТ(Данные, "status");
	Итог.Ошибка = ТекстПоляОтветаГИСМТ(Данные, "lastError");
	Состояние = Данные.Получить("state");
	Если ТипЗнч(Состояние) = Тип("Соответствие") Тогда
		Итог.Состояние = ТекстПоляОтветаГИСМТ(Состояние, "state");
		Итог.Описание = ТекстПоляОтветаГИСМТ(Состояние, "description");
	КонецЕсли;
	Сведения = Данные.Получить("info");
	Если ТипЗнч(Сведения) = Тип("Соответствие") Тогда
		Итог.РегНомер = ТекстПоляОтветаГИСМТ(Сведения, "docId");
	КонецЕсли;
	ТипОперации = "";
	Спецификация = Данные.Получить("spec");
	Если ТипЗнч(Спецификация) = Тип("Соответствие") Тогда
		ТипОперации = ТекстПоляОтветаГИСМТ(Спецификация, "operationType");
	КонецЕсли;
	Итог.Операция = ВРег(ТипОперации);   // ЩА 20.10.2026 [yan]: FIXATION_CANCEL - отмена фиксации

	Если Итог.Состояние = "FAILED" ИЛИ Итог.Статус = "FAILED" Тогда
		ТекстОшибки = ?(ЗначениеЗаполнено(Итог.Ошибка), Итог.Ошибка, Итог.Описание);
		Итог.Итог = Лев("Ошибка ЧЗ: " + ТекстОшибки, 50);
	ИначеЕсли Итог.Состояние = "SUCCESS" И ТипОперации = "FIXATION_CANCEL" Тогда
		// Отмена фиксации не пропускает УПД покупателю, поэтому окончательным значением ее не делаем.
		Итог.Итог = "Фиксация отменена в ЧЗ";
	ИначеЕсли Итог.Состояние = "SUCCESS" Тогда
		Итог.Итог = ТекстСтатусаГИСМТЗафиксирован();
	Иначе
		Итог.Итог = "Обрабатывается в ЧЗ";
	КонецЕсли;
	Возврат Итог;

КонецФункции

// ++ ЩА 15.10.2026 [yan]: Честный знак напрямую (true-api) - вход и причина отказа фиксации.

// Токен ГИС МТ организации. Вход - присоединенной подписью КЭП организации (той же, что для Платформы)
// по случайным данным ЧЗ, с ИНН: ключ бухгалтера с МЧД годится нескольким организациям, и без ИНН
// ЧЗ отвечает «Невозможно однозначно определить под какой организацией выполняется авторизация».
// Токен живет около 10 часов; кешируется в общих настройках на 8 часов, чтобы не подписывать на каждый вызов.
Функция ТокенГИСМТ(Знач Организация = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Запись = УчетнаяЗаписьЭДО();
		Если Запись = Неопределено Тогда
			ВызватьИсключение "ГИС МТ: нет учетной записи ЭДО";
		КонецЕсли;
		Организация = Запись.Организация;
	КонецЕсли;
	ИНН = СокрЛП(Организация.ИНН);
	КлючКеша = "ТокенГИСМТ_" + ИНН;
	УстановитьПривилегированныйРежим(Истина);
	Кеш = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", КлючКеша, , "");
	Если ТипЗнч(Кеш) = Тип("Структура") И Кеш.Свойство("До") И Кеш.До > ТекущаяУниверсальнаяДата() Тогда
		Возврат Кеш.Токен;
	КонецЕсли;

	Соединение = Новый HTTPСоединение("markirovka.crpt.ru", 443, , , , 90, Новый ЗащищенноеСоединениеOpenSSL());
	ЗапросКлюча = Новый HTTPЗапрос("/api/v3/true-api/auth/key");
	ЗапросКлюча.Заголовки.Вставить("Accept", "application/json");
	Ключ = ПрочитатьОтветJSON(Соединение.Получить(ЗапросКлюча).ПолучитьТелоКакСтроку("UTF-8"));
	ДанныеДляПодписи = ПолучитьДвоичныеДанныеИзСтроки(Ключ.Получить("data"), "UTF-8", Ложь);
	Обработка = Обработки.ЭДО_ПлатформаЭДО.Создать();
	ОтказПодписи = Ложь;
	ОписаниеПодписи = "";
	ПодписьCMS = Обработка.ПрисоединитьПодпись(ПодписатьДанные(ДанныеДляПодписи, Организация), ДанныеДляПодписи,
		ОтказПодписи, ОписаниеПодписи);
	Если ОтказПодписи Тогда
		ВызватьИсключение "ГИС МТ: подпись для входа не создана: " + ОписаниеПодписи;
	КонецЕсли;
	Подпись64 = СтрЗаменить(СтрЗаменить(Base64Строка(ПодписьCMS), Символы.ПС, ""), Символы.ВК, "");
	ЗапросВхода = Новый HTTPЗапрос("/api/v3/true-api/auth/simpleSignIn");
	ЗапросВхода.Заголовки.Вставить("Content-Type", "application/json");
	ЗапросВхода.Заголовки.Вставить("Accept", "application/json");
	ЗапросВхода.УстановитьТелоИзСтроки(СтрокаJSON(Новый Структура("uuid, data, inn",
		Ключ.Получить("uuid"), Подпись64, ИНН)), КодировкаТекста.UTF8);
	ТекстВхода = Соединение.ОтправитьДляОбработки(ЗапросВхода).ПолучитьТелоКакСтроку("UTF-8");
	Вход = ПрочитатьОтветJSON(ТекстВхода);
	Токен = ?(ТипЗнч(Вход) = Тип("Соответствие"), Вход.Получить("token"), Неопределено);
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		ВызватьИсключение "ГИС МТ: вход не выполнен: " + Лев(ТекстВхода, 300);
	КонецЕсли;
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", КлючКеша,
		Новый Структура("Токен, До", Токен, ТекущаяУниверсальнаяДата() + 8 * 3600), , "");
	Возврат Токен;

КонецФункции

// Причина, по которой Честный знак отклонил фиксацию документа. Оператор отдает только общее
// «Document processing was failed»; настоящая причина - в ЧЗ, в commonErrors документа фиксации,
// номер которого «FIX_» + имя файла УПД у оператора.
// Возврат: Структура (Код, Текст, Кратко) - Кратко не длиннее 50 символов для ЭДО_СтатусГИСМТ;
// пустые поля - причину получить не удалось.
Функция ПричинаОтказаФиксацииЧЗ(Знач ИдДокумента, Знач Организация) Экспорт

	Итог = Новый Структура("Код, Текст, Кратко", "", "", "");
	Ответ = ЗапросКОператоруЭДО("GET", "/public/api/v3/documents?id=" + СокрЛП(ИдДокумента), , Организация);
	Карточки = ?(Ответ.Код = 200, ПрочитатьОтветJSON(Ответ.Текст), Неопределено);
	Если ТипЗнч(Карточки) <> Тип("Массив") ИЛИ Карточки.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;
	ИмяФайла = СокрЛП(Строка(Карточки[0].Получить("fileId")));
	Если НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
		Возврат Итог;
	КонецЕсли;

	Соединение = Новый HTTPСоединение("markirovka.crpt.ru", 443, , , , 60, Новый ЗащищенноеСоединениеOpenSSL());
	Запрос = Новый HTTPЗапрос("/api/v4/true-api/doc/FIX_" + ИмяФайла + "/info");
	Запрос.Заголовки.Вставить("Authorization", "Bearer " + ТокенГИСМТ(Организация));
	Запрос.Заголовки.Вставить("Accept", "application/json");
	ОтветЧЗ = Соединение.Получить(Запрос);
	Если ОтветЧЗ.КодСостояния <> 200 Тогда
		Возврат Итог;
	КонецЕсли;
	Данные = ПрочитатьОтветJSON(ОтветЧЗ.ПолучитьТелоКакСтроку("UTF-8"));
	Карточка = ?(ТипЗнч(Данные) = Тип("Массив") И Данные.Количество() > 0, Данные[0], Данные);
	Ошибки = ?(ТипЗнч(Карточка) = Тип("Соответствие"), Карточка.Получить("commonErrors"), Неопределено);
	Если ТипЗнч(Ошибки) <> Тип("Массив") ИЛИ Ошибки.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;
	Тексты = Новый Массив;
	Для Каждого Ошибка Из Ошибки Цикл
		Тексты.Добавить(СокрЛП(Строка(Ошибка.Получить("errorCode"))) + " " + СокрЛП(Строка(Ошибка.Получить("errorMessage"))));
	КонецЦикла;
	Итог.Код = СокрЛП(Строка(Ошибки[0].Получить("errorCode")));
	Итог.Текст = СтрСоединить(Тексты, "; ");
	Итог.Кратко = Лев("Ошибка ЧЗ: " + Итог.Код + " " + КраткоОшибкаЧЗ(Итог.Код,
		СокрЛП(Строка(Ошибки[0].Получить("errorMessage")))), 50);
	Возврат Итог;

КонецФункции

// Короткое описание ошибки ЧЗ для колонки: известные коды - своими словами, прочие - текстом ЧЗ
// без общих вступлений.
Функция КраткоОшибкаЧЗ(Знач Код, Знач Текст)
	// ++ ЩА 20.10.2026 [yan]: ERROR_71 у ЧЗ - общее «Содержание документа некорректно», поле
	// называется в тексте. Прежняя подпись «нет кодов пива» прятала, например, пустой ИНН получателя.
	Если ВРег(Код) = "ERROR_71" Тогда
		Поле = СокрЛП(СтрЗаменить(СтрЗаменить(Текст, "Содержание документа некорректно. ", ""),
			"Некорректные данные: ", ""));
		Если НРег(Поле) = "recipientinn" Тогда
			Возврат "нет ИНН покупателя в УПД";
		КонецЕсли;
		Возврат "некорректно: " + Поле;
	КонецЕсли;
	// -- ЩА 20.10.2026 [yan].
	Известные = Новый Соответствие;
	Известные.Вставить("ERROR_276", "КМ отгружен другим документом");
	Известные.Вставить("ERROR_146", "КМ уже отгружен или продан");
	Известные.Вставить("ERROR_60", "GTIN нет в Нацкаталоге");
	Известные.Вставить("ERROR_23", "нет полномочий на КМ");   // ЩА 20.10.2026 [yan]
	Кратко = Известные.Получить(ВРег(Код));
	Если Кратко <> Неопределено Тогда
		Возврат Кратко;
	КонецЕсли;
	Текст = СтрЗаменить(Текст, "Содержание документа некорректно. ", "");
	Текст = СтрЗаменить(Текст, "Некорректные данные: ", "");
	Возврат Текст;
КонецФункции

// -- ЩА 15.10.2026 [yan].

// ++ ЩА 20.10.2026 [yan]: обработка подписанного документа в Честном знаке. Фиксация (FIX) есть только
// у пива; УПД с другими кодами (вода, безалкогольное пиво) и УКД ЧЗ обрабатывает уже после подписи
// покупателя, и отказ (например ERROR_23 «нет полномочий» - марки не встали на баланс) раньше был
// виден только по балансу. Номер документа в ЧЗ - имя файла экземпляра у оператора (fileId):
// у УКД оно уже с «MARK» (ON_NKORSCHFDOPPRMARK_...), у УПД - как есть.

// Тексты свойства ЭДО_СтатусГИСМТ для этой проверки (отдельные от фиксации: сверка фиксации их не трогает).
Функция ТекстСтатусаЧЗОбработан() Экспорт
	Возврат "Обработан в ЧЗ";
КонецФункции

Функция ТекстСтатусаЧЗЖдемОбработки() Экспорт
	Возврат "Ждем обработки ЧЗ";
КонецФункции

Функция ПрефиксСтатусаЧЗОтклонен() Экспорт
	Возврат "Отклонен ЧЗ:";
КонецФункции

Функция ТекстСтатусаЧЗНетДокумента() Экспорт
	Возврат "Нет в ЧЗ";
КонецФункции

Функция ТекстСтатусаЧЗОшибкаОбработки() Экспорт
	Возврат "Ошибка обработки в ЧЗ";
КонецФункции

Функция ТекстСтатусаЧЗОтменен() Экспорт
	Возврат "Отменен в ЧЗ";
КонецФункции

// Неокончательные результаты проверки: документ проверяется снова в следующих прогонах.
Функция ТекстыСтатусаЧЗПовторяемые()
	Тексты = Новый Массив;
	Тексты.Добавить(ТекстСтатусаЧЗЖдемОбработки());
	Тексты.Добавить(ТекстСтатусаЧЗНетДокумента());
	Тексты.Добавить(ТекстСтатусаЧЗОшибкаОбработки());
	Тексты.Добавить(ТекстСтатусаЧЗОтменен());
	Возврат Тексты;
КонецФункции

// Момент оператора (UTC вида 2026-10-12T23:16:36.858014Z) в местном времени.
// ЩА 20.10.2026 [yan]: нужна ДокументВЧЗ и ход документа.
Функция ВремяОператора(Знач Текст) Экспорт
	Если СтрДлина(Текст) < 19 Тогда
		Возврат '00010101';
	КонецЕсли;
	Попытка
		МоментUTC = Дата(Число(Сред(Текст, 1, 4)), Число(Сред(Текст, 6, 2)), Число(Сред(Текст, 9, 2)),
			Число(Сред(Текст, 12, 2)), Число(Сред(Текст, 15, 2)), Число(Сред(Текст, 18, 2)));
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ВремяОператора: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат '00010101';
	КонецПопытки;
	Возврат МестноеВремя(МоментUTC);
КонецФункции

// Документ в Честном знаке по номеру (имя файла у оператора).
// Возврат: Структура (Найден, Статус - CHECKED_OK / CHECKED_NOT_OK / прочее, Получен - местное время,
//   Ошибки - Массив Структур (Код, Текст, КМ), Итог - не длиннее 50 для ЭДО_СтатусГИСМТ).
// 404 - документа в ЧЗ нет (Найден = Ложь). Прочие ответы - исключение с текстом ЧЗ: вызывающий пишет
// его в ЖР и в состояние, а не прячет.
Функция ДокументВЧЗ(Знач ИмяФайла, Знач Организация) Экспорт

	Итог = Новый Структура("Найден, Статус, Получен, Ошибки, Итог", Ложь, "", '00010101', Новый Массив, "");
	ИмяФайла = СокрЛП(ИмяФайла);
	Если НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
		ВызватьИсключение "ЧЗ: у экземпляра у оператора нет имени файла";
	КонецЕсли;
	Соединение = Новый HTTPСоединение("markirovka.crpt.ru", 443, , , , 60, Новый ЗащищенноеСоединениеOpenSSL());
	Для НомерПопытки = 1 По 2 Цикл
		Запрос = Новый HTTPЗапрос("/api/v4/true-api/doc/" + КодироватьСтроку(ИмяФайла, СпособКодированияСтроки.КодировкаURL) + "/info");
		Запрос.Заголовки.Вставить("Authorization", "Bearer " + ТокенГИСМТ(Организация));
		Запрос.Заголовки.Вставить("Accept", "application/json");
		Ответ = Соединение.Получить(Запрос);
		// Отозванный токен: сохраненный живет до 8 часов, без сброса все запросы до его срока падали бы.
		Если Ответ.КодСостояния = 401 И НомерПопытки = 1 Тогда
			СброситьТокенГИСМТ(Организация);
			Продолжить;
		КонецЕсли;
		Прервать;
	КонецЦикла;
	Если Ответ.КодСостояния = 404 Тогда
		Возврат Итог;
	КонецЕсли;
	Тело = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "ЧЗ ответил HTTP " + Ответ.КодСостояния + ": " + Лев(Тело, 300);
	КонецЕсли;
	Данные = ПрочитатьОтветJSON(Тело);
	Карточка = ?(ТипЗнч(Данные) = Тип("Массив") И Данные.Количество() > 0, Данные[0], Данные);
	Если ТипЗнч(Карточка) <> Тип("Соответствие") Тогда
		ВызватьИсключение "ЧЗ: ответ не разобран: " + Лев(Тело, 300);
	КонецЕсли;
	Итог.Найден = Истина;
	Итог.Статус = ВРег(ТекстПоляОтветаГИСМТ(Карточка, "status"));
	Итог.Получен = ВремяОператора(ТекстПоляОтветаГИСМТ(Карточка, "receivedAt"));
	Ошибки = Карточка.Получить("commonErrors");
	Если ТипЗнч(Ошибки) = Тип("Массив") Тогда
		Для Каждого Ошибка Из Ошибки Цикл
			Если ТипЗнч(Ошибка) = Тип("Соответствие") Тогда
				Итог.Ошибки.Добавить(Новый Структура("Код, Текст, КМ",
					СокрЛП(Строка(Ошибка.Получить("errorCode"))), СокрЛП(Строка(Ошибка.Получить("errorMessage"))),
					СокрЛП(Строка(Ошибка.Получить("errorObject")))));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Итог.Статус = "CHECKED_OK" Тогда
		Итог.Итог = ТекстСтатусаЧЗОбработан();
	ИначеЕсли Итог.Статус = "CHECKED_NOT_OK" Тогда
		Если Итог.Ошибки.Количество() > 0 Тогда
			Первая = Итог.Ошибки[0];
			Итог.Итог = Лев(ПрефиксСтатусаЧЗОтклонен() + " " + Первая.Код + " "
				+ КраткоОшибкаЧЗ(Первая.Код, Первая.Текст) + " (" + Итог.Ошибки.Количество() + " КМ)", 50);
		Иначе
			Итог.Итог = ПрефиксСтатусаЧЗОтклонен() + " причина не указана";
		КонецЕсли;
	ИначеЕсли Итог.Статус = "PROCESSING_ERROR" Тогда
		Итог.Итог = ТекстСтатусаЧЗОшибкаОбработки();
	ИначеЕсли Итог.Статус = "CANCELLED" Тогда
		Итог.Итог = ТекстСтатусаЧЗОтменен();
	Иначе
		Итог.Итог = ТекстСтатусаЧЗЖдемОбработки();
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Сохраненный токен ГИС МТ организации больше не годится (401) - следующий ТокенГИСМТ войдет заново.
Процедура СброситьТокенГИСМТ(Знач Организация)
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Запись = УчетнаяЗаписьЭДО();
		Если Запись = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Организация = Запись.Организация;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Удалить("ОФД_ЭДО_НастройкиОбработки", "ТокенГИСМТ_" + СокрЛП(Организация.ИНН), "");
КонецПроцедуры

// ЩА 20.10.2026 [yan]: снять ЭДО_СтатусГИСМТ документа (при смене экземпляра у оператора).
Процедура СброситьСтатусЧЗ(Знач Ссылка)
	СвойствоГИСМТ = СвойствоОбъектов("ЭДО_СтатусГИСМТ");
	Если СвойствоГИСМТ.Пустая() Тогда
		Возврат;
	КонецЕсли;
	Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Ссылка);
	Набор.Отбор.Свойство.Установить(СвойствоГИСМТ);
	Набор.Записать(Истина);
КонецПроцедуры

// Ошибки ЧЗ одной строкой для ЖР: «код КМ текст» по каждой марке.
Функция ОшибкиЧЗТекстом(Знач Ошибки) Экспорт
	Строки = Новый Массив;
	Для Каждого Ошибка Из Ошибки Цикл
		Строки.Добавить(Ошибка.Код + " " + Ошибка.КМ + " " + Ошибка.Текст);
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

// Обновить ЭДО_СтатусГИСМТ у подписанных покупателем документов с кодами, где ЧЗ обрабатывает сам
// документ: УПД без фиксации (свойство «Фиксация не требуется» или прежний результат этой проверки) и УКД.
// Окно - как у сверки фиксации. Окончательно только «Обработан в ЧЗ»: отказ спрашивается снова - после
// исправления документ уходит новым экземпляром с новым именем файла.
// Возврат: Строка - свод для журнала.
Функция ОбновитьОбработкуВЧЗ(Знач Организация = Неопределено, Знач Лимит = 100) Экспорт

	СвойствоГИСМТ = СвойствоОбъектов("ЭДО_СтатусГИСМТ");
	СвойствоИд = СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	СвойствоСостояние = СвойствоОбъектов("ЭДО_Состояние");
	Если СвойствоГИСМТ.Пустая() ИЛИ СвойствоИд.Пустая() ИЛИ СвойствоСостояние.Пустая() Тогда
		Возврат "ЧЗ, обработка документов: свойства ЭДО_СтатусГИСМТ/ЭДО_ИдентификаторДокумента/ЭДО_Состояние не заведены";
	КонецЕсли;
	Части = Новый Массив;
	Если Метаданные.Документы.РеализацияТоваровУслуг.ТабличныеЧасти.Найти("КИЗ") <> Неопределено Тогда
		Части.Добавить(
			"ВЫБРАТЬ Д.Ссылка КАК Ссылка, Д.Номер КАК Номер, Д.Дата КАК Дата
			|ИЗ Документ.РеализацияТоваровУслуг КАК Д
			|ГДЕ Д.Проведен И Д.Дата >= &Граница И (&ВсеОрганизации ИЛИ Д.Организация.ИНН = &ИННОрганизации)
			|	И Д.Ссылка В (ВЫБРАТЬ К.Ссылка ИЗ Документ.РеализацияТоваровУслуг.КИЗ КАК К ГДЕ К.Ссылка.Дата >= &Граница)");
	КонецЕсли;
	Корр = Метаданные.Документы.Найти("КорректировкаРеализации");
	Если Корр <> Неопределено Тогда
		Для Каждого ИмяТЧ Из СтрРазделить("КИЗДоКорректировки,КИЗПослеКорректировки", ",") Цикл
			Если Корр.ТабличныеЧасти.Найти(ИмяТЧ) <> Неопределено Тогда
				Части.Добавить(
					"ВЫБРАТЬ Д.Ссылка, Д.Номер, Д.Дата
					|ИЗ Документ.КорректировкаРеализации КАК Д
					|ГДЕ Д.Проведен И Д.Дата >= &Граница И (&ВсеОрганизации ИЛИ Д.Организация.ИНН = &ИННОрганизации)
					|	И Д.Ссылка В (ВЫБРАТЬ К.Ссылка ИЗ Документ.КорректировкаРеализации." + ИмяТЧ + " КАК К
					|		ГДЕ К.Ссылка.Дата >= &Граница)");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Части.Количество() = 0 Тогда
		Возврат "ЧЗ, обработка документов: в конфигурации нет табличных частей кодов маркировки - проверять нечего";
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ Д.Ссылка КАК Ссылка, Д.Номер КАК Номер, Д.Дата КАК Дата
		|ПОМЕСТИТЬ Кандидаты
		|ИЗ (" + СтрСоединить(Части, Символы.ПС + "ОБЪЕДИНИТЬ" + Символы.ПС) + ") КАК Д
		|;
		|ВЫБРАТЬ
		|	К.Ссылка КАК Ссылка,
		|	К.Номер КАК Номер,
		|	К.Дата КАК Дата,
		|	ВЫРАЗИТЬ(Ид.Значение КАК СТРОКА(50)) КАК Ид,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(ЧЗ.Значение КАК СТРОКА(50)), """") КАК ТекущийСтатус
		|ИЗ Кандидаты КАК К
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Ид
		|	ПО Ид.Объект = К.Ссылка И Ид.Свойство = &СвойствоИд
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Сост
		|	ПО Сост.Объект = К.Ссылка И Сост.Свойство = &СвойствоСостояние
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЧЗ
		|	ПО ЧЗ.Объект = К.Ссылка И ЧЗ.Свойство = &СвойствоГИСМТ
		|ГДЕ ВЫРАЗИТЬ(Сост.Значение КАК СТРОКА(50)) В (&Подписан)
		|	И (&СНачала ИЛИ К.Дата < &ОбходДо ИЛИ К.Дата = &ОбходДо И К.Ссылка < &ОбходСсылка)
		|	И (К.Ссылка ССЫЛКА Документ.КорректировкаРеализации
		|		ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(ЧЗ.Значение КАК СТРОКА(50)), """") = &ФиксацияНеТребуется
		|		ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(ЧЗ.Значение КАК СТРОКА(50)), """") В (&ЖдемОбработки)
		|		ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(ЧЗ.Значение КАК СТРОКА(50)), """") ПОДОБНО &Отклонен)
		|	И ЕСТЬNULL(ВЫРАЗИТЬ(ЧЗ.Значение КАК СТРОКА(50)), """") <> &Обработан
		|УПОРЯДОЧИТЬ ПО К.Дата УБЫВ, К.Ссылка УБЫВ");
	ГлубинаДней = Число(НастройкаЭДО("ГлубинаДнейСинхронизацииСтатусов"));
	// Ревью Codex 848: обход по кругу, как у сверки фиксации. Отказы и 404 остаются в выборке,
	// и без позиции прогон каждый раз брал бы одни и те же 100 новых документов.
	КлючОбхода = "ЧЗ_ОбработкаДо" + ?(Организация = Неопределено, "", "_" + СокрЛП(Организация.ИНН));
	Позиция = НастройкаЭДО(КлючОбхода);
	СНачала = ТипЗнч(Позиция) <> Тип("Структура") ИЛИ НЕ Позиция.Свойство("Дата")
		ИЛИ НЕ Позиция.Свойство("Ссылка") ИЛИ НЕ ЗначениеЗаполнено(Позиция.Дата);
	Запрос.УстановитьПараметр("СНачала", СНачала);
	Запрос.УстановитьПараметр("ОбходДо", ?(СНачала, Дата(1, 1, 1), Позиция.Дата));
	Запрос.УстановитьПараметр("ОбходСсылка", ?(СНачала, Документы.РеализацияТоваровУслуг.ПустаяСсылка(), Позиция.Ссылка));
	Запрос.УстановитьПараметр("Граница", НачалоДня(ТекущаяДатаСеанса()) - (ГлубинаДней + 3) * 86400);
	Запрос.УстановитьПараметр("ВсеОрганизации", Организация = Неопределено);
	Запрос.УстановитьПараметр("ИННОрганизации", ?(Организация = Неопределено, "", СокрЛП(Организация.ИНН)));
	Запрос.УстановитьПараметр("СвойствоИд", СвойствоИд);
	Запрос.УстановитьПараметр("СвойствоСостояние", СвойствоСостояние);
	Запрос.УстановитьПараметр("СвойствоГИСМТ", СвойствоГИСМТ);
	Запрос.УстановитьПараметр("Подписан", ТекстыПодписанного());
	Запрос.УстановитьПараметр("ФиксацияНеТребуется", ТекстСтатусаГИСМТНеТребуется());
	Запрос.УстановитьПараметр("ЖдемОбработки", ТекстыСтатусаЧЗПовторяемые());
	Запрос.УстановитьПараметр("Отклонен", ПрефиксСтатусаЧЗОтклонен() + "%");
	Запрос.УстановитьПараметр("Обработан", ТекстСтатусаЧЗОбработан());
	Выборка = Запрос.Выполнить().Выбрать();

	Проверено = 0;
	Обработано = 0;
	Отклонено = 0;
	Ждем = 0;
	НетВЧЗ = 0;
	Сбоев = 0;
	СбоевПодряд = 0;
	// Что уже записано в ЖР по отказам: документ -> хеш «экземпляр + коды + КМ». Только отклоненные.
	ПоказанныеОшибкиЧЗ = НастройкаЭДО("ЧЗ_ПоказанныеОшибки");
	Если ТипЗнч(ПоказанныеОшибкиЧЗ) <> Тип("Соответствие") Тогда
		ПоказанныеОшибкиЧЗ = Новый Соответствие;
	КонецЕсли;
	ПоказанныеИзменены = Ложь;
	Примеры = Новый Массив;
	ДатаПоследнего = Дата(1, 1, 1);
	СсылкаПоследнего = Неопределено;
	ДошлиДоЛимита = Ложь;
	Оборвано = Ложь;
	Пока Выборка.Следующий() Цикл
		Если Проверено >= Лимит Тогда
			ДошлиДоЛимита = Истина;
			Прервать;
		КонецЕсли;
		Проверено = Проверено + 1;
		ДатаПоследнего = Выборка.Дата;
		СсылкаПоследнего = Выборка.Ссылка;
		Организация_ = ОрганизацияДокумента(Выборка.Ссылка);
		// Сбой оператора или ЧЗ по одному документу пишется в ЖР и в свод; прежнее значение свойства
		// не затирается, следующий прогон спросит снова. Пять сбоев подряд - сервис лежит, прогон обрывается.
		Попытка
			Карточка = КарточкаОператораПоИд(Выборка.Ид, Организация_);
			Если НЕ Карточка.Найдена Тогда
				ВызватьИсключение "карточка оператора " + Выборка.Ид + " не получена (HTTP " + Карточка.Код + ")";
			КонецЕсли;
			ВЧЗ = ДокументВЧЗ(Карточка.ИмяФайла, Организация_);
		Исключение
			Сбоев = Сбоев + 1;
			СбоевПодряд = СбоевПодряд + 1;
			ТекстСбоя = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("ЭДО.ГИСМТ", УровеньЖурналаРегистрации.Ошибка, , Выборка.Ссылка,
				"Обработка документа в ЧЗ не проверена: " + ТекстСбоя);
			Если Примеры.Количество() < 10 Тогда
				Примеры.Добавить(СокрЛП(Выборка.Номер) + ": сбой - " + Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 120));
			КонецЕсли;
			// Пять сбоев подряд - оператор или ЧЗ лежит: иначе остаток прогона ждал бы таймаутов часами.
			Если СбоевПодряд >= 5 Тогда
				Оборвано = Истина;
				Прервать;
			КонецЕсли;
			Продолжить;
		КонецПопытки;
		СбоевПодряд = 0;
		Если НЕ ВЧЗ.Найден Тогда
			// ЧЗ документа не получал: подписанный документ с кодами без записи в ЧЗ - дефект оформления
			// (например, коды не попали в УПД). Показываем в колонке, проверка повторяется.
			НетВЧЗ = НетВЧЗ + 1;
			ВЧЗ.Итог = ТекстСтатусаЧЗНетДокумента();
		КонецЕсли;
		Если ВЧЗ.Итог = ТекстСтатусаЧЗОбработан() Тогда
			Обработано = Обработано + 1;
		ИначеЕсли СтрНачинаетсяС(ВЧЗ.Итог, ПрефиксСтатусаЧЗОтклонен()) Тогда
			Отклонено = Отклонено + 1;
			Если Примеры.Количество() < 10 Тогда
				Примеры.Добавить(СокрЛП(Выборка.Номер) + ": " + ВЧЗ.Итог);
			КонецЕсли;
		Иначе
			Ждем = Ждем + 1;
		КонецЕсли;
		// Ревью Codex 848: полный список - при смене экземпляра или набора ошибок, а не только короткого
		// текста свойства (в нем первая ошибка и число, при другом наборе КМ он может не измениться).
		Если ВЧЗ.Ошибки.Количество() > 0 Тогда
			Отпечаток = Карточка.ИмяФайла + "|" + ОшибкиЧЗТекстом(ВЧЗ.Ошибки);
			Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
			Хеш.Добавить(Отпечаток);
			ХешОшибок = НРег(СтрЗаменить(Строка(Хеш.ХешСумма), " ", ""));
			Если ПоказанныеОшибкиЧЗ.Получить(Строка(Выборка.Ссылка.УникальныйИдентификатор())) <> ХешОшибок Тогда
				ЗаписьЖурналаРегистрации("ЭДО.ГИСМТ", УровеньЖурналаРегистрации.Предупреждение, , Выборка.Ссылка,
					"Честный знак отклонил документ " + Карточка.ИмяФайла + " (" + ВЧЗ.Ошибки.Количество() + " ошибок):"
					+ Символы.ПС + ОшибкиЧЗТекстом(ВЧЗ.Ошибки));
				ПоказанныеОшибкиЧЗ.Вставить(Строка(Выборка.Ссылка.УникальныйИдентификатор()), ХешОшибок);
				ПоказанныеИзменены = Истина;
			КонецЕсли;
		ИначеЕсли ПоказанныеОшибкиЧЗ.Получить(Строка(Выборка.Ссылка.УникальныйИдентификатор())) <> Неопределено Тогда
			ПоказанныеОшибкиЧЗ.Удалить(Строка(Выборка.Ссылка.УникальныйИдентификатор()));
			ПоказанныеИзменены = Истина;
		КонецЕсли;
		Если ВЧЗ.Итог = СокрЛП(Выборка.ТекущийСтатус) Тогда
			Продолжить;
		КонецЕсли;
		ЗаписатьЗначениеСвойства(Выборка.Ссылка, СвойствоГИСМТ, ВЧЗ.Итог);
	КонецЦикла;

	Если ПоказанныеИзменены Тогда
		ЗаписатьОбщуюНастройкуЭДО("ЧЗ_ПоказанныеОшибки", ПоказанныеОшибкиЧЗ);
	КонецЕсли;
	Если ДошлиДоЛимита И ЗначениеЗаполнено(ДатаПоследнего) Тогда
		ЗаписатьОбщуюНастройкуЭДО(КлючОбхода, Новый Структура("Дата, Ссылка", ДатаПоследнего, СсылкаПоследнего));
	ИначеЕсли НЕ Оборвано И НЕ СНачала Тогда
		ЗаписатьОбщуюНастройкуЭДО(КлючОбхода, Неопределено);
	КонецЕсли;

	Свод = "ЧЗ, обработка подписанных документов: проверено " + Проверено + ", обработано " + Обработано
		+ ", отклонено " + Отклонено + ", ждут обработки " + Ждем + ", нет в ЧЗ " + НетВЧЗ
		+ ?(Сбоев > 0, ", ОШИБКА запроса " + Сбоев, "");
	Для Каждого Пример Из Примеры Цикл
		Свод = Свод + Символы.ПС + "  " + Пример;
	КонецЦикла;
	Возврат Свод;

КонецФункции
// -- ЩА 20.10.2026 [yan].

// Обновить свойство ЭДО_СтатусГИСМТ у отправленных документов, у которых оно пусто или не окончательно.
// Окно - то же, что у полной сверки статусов (глубина синхронизации плюс запас в 3 дня по дате
// документа). Окончательные значения ("Зафиксирован в ЧЗ", "Фиксация не требуется") повторно
// не запрашиваются: оператор уже сказал последнее слово.
// Организация - Неопределено: все документы окна, у каждого токен его организации.
// Лимит - сколько документов спросить за вызов, чтобы авария оператора не растянула регламент.
// Возврат: Строка - свод для журнала.
Функция ОбновитьСтатусыФиксацииГИСМТ(Знач Организация = Неопределено, Знач Лимит = 200) Экспорт

	СвойствоГИСМТ = СвойствоОбъектов("ЭДО_СтатусГИСМТ");
	СвойствоИд = СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если СвойствоГИСМТ = Неопределено ИЛИ СвойствоГИСМТ.Пустая()
		ИЛИ СвойствоИд = Неопределено ИЛИ СвойствоИд.Пустая() Тогда
		Возврат "ГИС МТ, фиксация: свойство ЭДО_СтатусГИСМТ не заведено";
	КонецЕсли;

	ГлубинаДней = Число(НастройкаЭДО("ГлубинаДнейСинхронизацииСтатусов"));
	Окончательные = Новый Массив;
	Окончательные.Добавить(ТекстСтатусаГИСМТЗафиксирован());
	Окончательные.Добавить(ТекстСтатусаГИСМТНеТребуется());
	// ЩА 20.10.2026 [yan]: результаты проверки обработки в ЧЗ (ОбновитьОбработкуВЧЗ) ведет она сама.
	Окончательные.Добавить(ТекстСтатусаЧЗОбработан());
	Для Каждого Текст Из ТекстыСтатусаЧЗПовторяемые() Цикл
		Окончательные.Добавить(Текст);
	КонецЦикла;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Реализация.Ссылка КАК Ссылка,
		|	Реализация.Номер КАК Номер,
		|	Реализация.Дата КАК Дата,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(СтатусыГИСМТ.Значение КАК СТРОКА(50)), """") КАК ТекущийСтатус
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Реализация
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Ид
		|		ПО Ид.Объект = Реализация.Ссылка
		|			И Ид.Свойство = &СвойствоИд
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК СтатусыГИСМТ
		|		ПО СтатусыГИСМТ.Объект = Реализация.Ссылка
		|			И СтатусыГИСМТ.Свойство = &СвойствоГИСМТ
		|ГДЕ
		|	Реализация.Проведен
		|	И Реализация.Дата >= &Граница
		|	И (&ВсеОрганизации ИЛИ Реализация.Организация.ИНН = &ИННОрганизации)
		|	И НЕ ЕСТЬNULL(ВЫРАЗИТЬ(СтатусыГИСМТ.Значение КАК СТРОКА(50)), """") В (&Окончательные)
		|	И НЕ ЕСТЬNULL(ВЫРАЗИТЬ(СтатусыГИСМТ.Значение КАК СТРОКА(50)), """") ПОДОБНО &ОтклоненЧЗ
		|	И (&СНачала
		|		ИЛИ Реализация.Дата < &ОбходДо
		|		ИЛИ Реализация.Дата = &ОбходДо И Реализация.Ссылка < &ОбходСсылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Реализация.Дата УБЫВ,
		|	Реализация.Ссылка УБЫВ");
	Запрос.УстановитьПараметр("СвойствоИд", СвойствоИд);
	Запрос.УстановитьПараметр("СвойствоГИСМТ", СвойствоГИСМТ);
	Запрос.УстановитьПараметр("Граница", НачалоДня(ТекущаяУниверсальнаяДата()) - (ГлубинаДней + 3) * 86400);
	Запрос.УстановитьПараметр("ВсеОрганизации", Организация = Неопределено);
	Запрос.УстановитьПараметр("ИННОрганизации", ?(Организация = Неопределено, "", СокрЛП(Организация.ИНН)));
	Запрос.УстановитьПараметр("Окончательные", Окончательные);
	Запрос.УстановитьПараметр("ОтклоненЧЗ", ПрефиксСтатусаЧЗОтклонен() + "%");
	// Обход по кругу: прогон, упёршийся в лимит, запоминает позицию последнего документа (дата и
	// ссылка - дата не уникальна, и по ней одной остаток группы документов с той же датой выпал бы),
	// и следующий продолжает с более старых. Иначе при 200+ зависших («Обрабатывается в ЧЗ», «Ошибка
	// ЧЗ») каждый прогон брал бы одни и те же новые документы, а до старых не доходил никогда.
	КлючОбхода = "ГИСМТ_ОбходДо" + ?(Организация = Неопределено, "", "_" + СокрЛП(Организация.ИНН));
	Позиция = НастройкаЭДО(КлючОбхода);
	СНачала = ТипЗнч(Позиция) <> Тип("Структура") ИЛИ НЕ Позиция.Свойство("Дата")
		ИЛИ НЕ Позиция.Свойство("Ссылка") ИЛИ НЕ ЗначениеЗаполнено(Позиция.Дата);
	Запрос.УстановитьПараметр("СНачала", СНачала);
	Если СНачала Тогда
		Запрос.УстановитьПараметр("ОбходДо", Дата(1, 1, 1));
		Запрос.УстановитьПараметр("ОбходСсылка", Документы.РеализацияТоваровУслуг.ПустаяСсылка());
	Иначе
		Запрос.УстановитьПараметр("ОбходДо", Позиция.Дата);
		Запрос.УстановитьПараметр("ОбходСсылка", Позиция.Ссылка);
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	ДатаПоследнего = Дата(1, 1, 1);
	СсылкаПоследнего = Неопределено;
	ДошлиДоЛимита = Ложь;

	Проверено = 0;
	Записано = 0;
	Зафиксировано = 0;
	НеТребуется = 0;
	ВОбработке = 0;
	ОшибокЧЗ = 0;
	НетДанных = 0;
	ПодрядНетДанных = 0;
	Прервано = Ложь;
	Примеры = Новый Массив;

	Пока Выборка.Следующий() Цикл
		Если Проверено >= Лимит Тогда
			Прервано = Истина;
			ДошлиДоЛимита = Истина;
			Прервать;
		КонецЕсли;
		// Оператор лежит или токен не годится: каждый запрос ждет таймаут, и прогон повис бы
		// на минуты. Остальное доберет следующий регламент.
		Если ПодрядНетДанных >= 5 Тогда
			Прервано = Истина;
			Прервать;
		КонецЕсли;

		Проверено = Проверено + 1;
		ДатаПоследнего = Выборка.Дата;
		СсылкаПоследнего = Выборка.Ссылка;
		Состояние = СостояниеФиксацииГИСМТ(Выборка.Ссылка);
		// ЩА 15.10.2026 [yan]: отказ фиксации - причина из Честного знака вместо общего текста оператора.
		// Спрашиваем каждый раз по текущему экземпляру (ревью Codex 694): сохраненная причина могла остаться
		// от прошлой отправки. Отказов единицы, токен ЧЗ кешируется. ЧЗ не ответил - остается общий текст
		// оператора по текущему экземпляру: сохраненную причину не переносим, она могла относиться к прошлой
		// отправке, а ид экземпляра в свойстве Строка(50) не хранится (ревью Codex 701). Следующий ответ ЧЗ
		// вернет причину.
		Если СтрНачинаетсяС(Состояние.Итог, "Ошибка ЧЗ:") Тогда
			Причина = Неопределено;
			Попытка
				Причина = ПричинаОтказаФиксацииЧЗ(Состояние.ИдДокумента, ОрганизацияДокумента(Выборка.Ссылка));
			Исключение
				ЗаписьЖурналаРегистрации("ЭДО.ГИСМТ", УровеньЖурналаРегистрации.Предупреждение, , Выборка.Ссылка,
					"Причина отказа фиксации из ЧЗ не получена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
			Если Причина <> Неопределено И ЗначениеЗаполнено(Причина.Кратко) Тогда
				Если Причина.Кратко <> Выборка.ТекущийСтатус Тогда
					ЗаписьЖурналаРегистрации("ЭДО.ГИСМТ", УровеньЖурналаРегистрации.Предупреждение, , Выборка.Ссылка,
						"Честный знак отклонил фиксацию: " + Причина.Текст);
				КонецЕсли;
				Состояние.Итог = Причина.Кратко;
			КонецЕсли;
		КонецЕсли;

		// Пустой идентификатор у оператора: спрашивать нечего, свойство не трогаем.
		Если НЕ Состояние.Требуется И Состояние.Итог = "Не отправлен" Тогда
			Продолжить;
		КонецЕсли;

		Если СтрНачинаетсяС(Состояние.Итог, "Нет данных") Тогда
			НетДанных = НетДанных + 1;
			ПодрядНетДанных = ПодрядНетДанных + 1;
			Если Примеры.Количество() < 10 Тогда
				Примеры.Добавить(СокрЛП(Выборка.Номер) + ": " + Состояние.Итог);
			КонецЕсли;
			// Сбой запроса не затирает прежнее значение свойства.
			Продолжить;
		КонецЕсли;
		ПодрядНетДанных = 0;

		Если Состояние.Итог = ТекстСтатусаГИСМТЗафиксирован() Тогда
			Зафиксировано = Зафиксировано + 1;
		ИначеЕсли Состояние.Итог = ТекстСтатусаГИСМТНеТребуется() Тогда
			НеТребуется = НеТребуется + 1;
		ИначеЕсли СтрНачинаетсяС(Состояние.Итог, "Ошибка ЧЗ") Тогда
			ОшибокЧЗ = ОшибокЧЗ + 1;
			Если Примеры.Количество() < 10 Тогда
				Примеры.Добавить(СокрЛП(Выборка.Номер) + ": " + Состояние.Итог);
			КонецЕсли;
		Иначе
			ВОбработке = ВОбработке + 1;
		КонецЕсли;

		Если Состояние.Итог = СокрЛП(Строка(Выборка.ТекущийСтатус)) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ЗаписатьЗначениеСвойства(Выборка.Ссылка, СвойствоГИСМТ, Состояние.Итог);
			Записано = Записано + 1;
		Исключение
			// Один документ не должен останавливать остальных.
			ЗаписьЖурналаРегистрации("ЭДО.ГИСМТ", УровеньЖурналаРегистрации.Ошибка, , Выборка.Ссылка,
				"Статус фиксации не записан: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	// Позиция обхода: дошли до лимита - следующий прогон продолжит с более старых; прошли окно
	// до конца - начнём снова с новых. Обрыв из-за сбоев оператора позицию не двигает.
	Если ДошлиДоЛимита И ЗначениеЗаполнено(ДатаПоследнего) Тогда
		ЗаписатьОбщуюНастройкуЭДО(КлючОбхода, Новый Структура("Дата, Ссылка", ДатаПоследнего, СсылкаПоследнего));
	ИначеЕсли НЕ Прервано И НЕ СНачала Тогда
		ЗаписатьОбщуюНастройкуЭДО(КлючОбхода, Неопределено);
	КонецЕсли;

	Свод = "ГИС МТ, фиксация: проверено " + Проверено + ", записано " + Записано
		+ ", зафиксировано " + Зафиксировано + ", не требуется " + НеТребуется
		+ ", в обработке " + ВОбработке + ", с ошибкой ЧЗ " + ОшибокЧЗ + ", нет данных " + НетДанных;
	Если Прервано Тогда
		Свод = Свод + " (прогон прерван: " + ?(ПодрядНетДанных >= 5, "оператор не отвечает", "достигнут лимит " + Лимит) + ")";
	КонецЕсли;
	Для Каждого Пример Из Примеры Цикл
		Свод = Свод + Символы.ПС + "  " + Пример;
	КонецЦикла;
	Возврат Свод;

КонецФункции

// Текст поля ответа оператора. Число (например, docId) приводится без разделителей групп:
// Строка(<число>) вставляет неразрывные пробелы. Нет поля или null - пустая строка.
Функция ТекстПоляОтветаГИСМТ(Знач Данные, Знач Имя)

	Значение = Данные.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

#КонецОбласти

#Область ИсправлениеУПД

// Исправительный УПД (ИУПД) к экземпляру, уже отправленному через оператора. Отдельного типа
// у оператора нет: это тот же титул ON_NSCHFDOPPR с узлом ИспрДок, номер и дата счета-фактуры
// исходные. Документ исправления в базе не создается: состав берется из текущей реализации,
// номер и дата исправления задаются при отправке.
// ИдИсходногоЭкземпляра - карточка у оператора, которую исправляем: по ней сверяются номер и дата
// счета-фактуры и заполняется ИмяФайлИспрПрод.
// Возврат: Структура (Ссылка, Успех, Заголовок, Текст, ИдДокумента).
Функция ОтправитьИУПД(Знач Ссылка, Знач НомерИсправления, Знач ДатаИсправления,
	Знач ИдИсходногоЭкземпляра = "") Экспорт

	Итог = Новый Структура("Ссылка, Успех, Заголовок, Текст, ИдДокумента",
		Ссылка, Ложь, "Исправление не отправлено", "", "");

	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Итог.Текст = "Исправительный УПД отправляется только по реализации товаров и услуг";
		Возврат Итог;
	КонецЕсли;

	СвойствоСтатус = СвойствоОбъектов("ЭДО_КодСостояния");
	Если СвойствоСтатус <> Неопределено И НЕ СвойствоСтатус.Пустая() Тогда
		ТекущийСтатус = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Ссылка, СвойствоСтатус)));
		Если ТекущийСтатус = "1" ИЛИ ТекущийСтатус = "10" Тогда
			Итог.Текст = "Документ сейчас в отправке, либо отправка прервана и состояние у оператора"
				+ " неизвестно: сначала дождитесь ее завершения или разберите ее";
			Возврат Итог;
		КонецЕсли;
	КонецЕсли;

	// Дата начала работы с оператором исправлению не помеха: исправляется экземпляр,
	// уже ушедший через этого оператора, и решение принимает человек.
	Разрешения = НовыеРазрешенияОператора();
	Разрешения.ОтправитьРаньшеДатыНачала = Истина;
	Готовность = ПроверитьГотовностьКОтправке(Ссылка, Разрешения);
	Если НЕ Готовность.Готов Тогда
		Итог.Текст = Готовность.Причина;
		Возврат Итог;
	КонецЕсли;

	Организация = ОрганизацияДокумента(Ссылка);
	ИдСозданного = "";
	Исправление = Неопределено;

	Попытка

		Если НЕ ОбеспечитьТокен(Ложь, Организация) Тогда
			Итог.Текст = "Не удалось получить токен авторизации (КЭП на сервере/подпись)";
			Возврат Итог;
		КонецЕсли;

		Исправление = ИсправлениеУПД(Ссылка, НомерИсправления, ДатаИсправления, ИдИсходногоЭкземпляра);
		Если ЗначениеЗаполнено(Исправление.Ошибка) Тогда
			Итог.Текст = Исправление.Ошибка;
			Возврат Итог;
		КонецЕсли;

		Контекст = НовыйКонтекстПрогона();
		Контекст.Вставить("ЗапросКОператоруУшел", Ложь);
		ОбеспечитьРеквизитыИП(Ссылка.Контрагент, Контекст);
		// ++ ЩА 20.10.2026 [yan]: ИУПД покупателю-ИП без ФИО - та же причина, что у УПД.
		ПричинаИП = ПричинаНетФИОПокупателяИП(Ссылка.Контрагент);
		Если ЗначениеЗаполнено(ПричинаИП) Тогда
			Итог.Текст = ПричинаИП;
			Возврат Итог;
		КонецЕсли;
		// -- ЩА 20.10.2026 [yan].
		Подготовка = ПодготовитьДокументИФЛК(Ссылка, Контекст, Исправление);
		Если Подготовка.Статус = "НуженТокен" И ОбеспечитьТокен(Истина, Организация) Тогда
			Подготовка = ПодготовитьДокументИФЛК(Ссылка, Контекст, Исправление);
		КонецЕсли;
		Если Подготовка.Статус <> "ОК" Тогда
			Итог.Текст = ?(Подготовка.Статус = "НуженТокен",
				"Не удалось авторизоваться (401 после перевыпуска токена)", Подготовка.Сообщение);
			Возврат Итог;
		КонецЕсли;

		// С этой строки исправление создано у оператора: id фиксируется сразу, как в ОтправитьПоЭДО.
		ИдСозданного = Подготовка.ИдДокумента;
		Итог.ИдДокумента = ИдСозданного;
		ЗаписатьСтатусЭДО(Ссылка, 20, ИдСозданного);

		ПодписьДокумента = ПодписатьДанные(Подготовка.ДвоичныеXML, Организация);
		Если ПодписьДокумента = Неопределено Тогда
			Итог.Текст = "Исправление создано у оператора (карточка " + ИдСозданного
				+ "), но не подписано КЭП: завершить или удалить вручную";
			Возврат Итог;
		КонецЕсли;

		Присоединение = ПрисоединитьПодписьИЗаписать(Ссылка, ИдСозданного, ПодписьДокумента);
		Если Присоединение.Статус = "НуженТокен" И ОбеспечитьТокен(Истина, Организация) Тогда
			Присоединение = ПрисоединитьПодписьИЗаписать(Ссылка, ИдСозданного, ПодписьДокумента);
		КонецЕсли;
		Если Присоединение.Статус <> "Отправлен" Тогда
			Итог.Текст = ?(Присоединение.Статус = "НуженТокен",
				"Не удалось авторизоваться при присоединении подписи", Присоединение.Сообщение)
				+ " (карточка " + ИдСозданного + ")";
			Возврат Итог;
		КонецЕсли;

	Исключение
		Ошибка = ИнформацияОбОшибке();
		Итог.Заголовок = "Ошибка отправки исправления";
		Итог.Текст = ТекстПричиныОшибки(Ошибка)
			+ ?(ЗначениеЗаполнено(ИдСозданного), ". Исправление уже создано у оператора (карточка "
				+ ИдСозданного + ")", "");
		ЗаписьЖурналаРегистрации("ЭДО.ИУПД", УровеньЖурналаРегистрации.Ошибка, , Ссылка,
			Итог.Текст + Символы.ПС + ПодробноеПредставлениеОшибки(Ошибка));
		Возврат Итог;
	КонецПопытки;

	ЗаписатьВЖурналОтправку(Ссылка, ИдСозданного);
	ЗаписатьЧитаемыйСтатус(Ссылка, "Отправляется");

	// ++ ЩА 21.10.2026 [yan]: ИУПД без N4 своей фиксации не получает, отгрузка зарегистрирована исходным
	// экземпляром. Без записи сверка фиксации держала бы его в «Фиксация у оператора не найдена»
	// («Ждем ответа ЧЗ») бессрочно. «Фиксация не требуется» окончательна для сверки фиксации, а после
	// подписи покупателем ОбновитьОбработкуВЧЗ проверит в ЧЗ сам ИУПД: «Обработан в ЧЗ» или отказ.
	// Попытка: документ уже отправлен, сбой записи свойства не должен выдавать отправку за неудачу.
	Если Исправление.ОтгрузкаЗарегистрирована Тогда
		Попытка
			ЗаписатьЗначениеСвойства(Ссылка, СвойствоОбъектов("ЭДО_СтатусГИСМТ"), ТекстСтатусаГИСМТНеТребуется());
		Исключение
			ЗаписьЖурналаРегистрации("ЭДО.ИУПД", УровеньЖурналаРегистрации.Ошибка, , Ссылка,
				"Статус ЧЗ исправления без фиксации не записан: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	// -- ЩА 21.10.2026 [yan].

	Итог.Успех = Истина;
	Итог.Заголовок = "Исправление отправлено";
	Итог.Текст = "Исправление N " + Формат(Исправление.НомерИсправления, "ЧГ=0") + " от "
		+ Формат(Исправление.ДатаИсправления, "ДФ=dd.MM.yyyy") + " отправлено (карточка "
		+ ИдСозданного + ")";
	ЗаписьЖурналаРегистрации("ЭДО.ИУПД", УровеньЖурналаРегистрации.Информация, , Ссылка,
		Итог.Текст + ?(ЗначениеЗаполнено(ИдИсходногоЭкземпляра),
			", исправляемый экземпляр " + СокрЛП(ИдИсходногоЭкземпляра), ""));

	Возврат Итог;

КонецФункции

// XML исправительного УПД без отправки: от оператора читается только исходный экземпляр.
// Для проверки перед отправкой. Возврат - как у СформироватьXMLДокумента.
Функция СформироватьИУПД(Знач Ссылка, Знач НомерИсправления, Знач ДатаИсправления,
	Знач ИдИсходногоЭкземпляра = "", Контекст = Неопределено) Экспорт

	Исправление = ИсправлениеУПД(Ссылка, НомерИсправления, ДатаИсправления, ИдИсходногоЭкземпляра);
	Если ЗначениеЗаполнено(Исправление.Ошибка) Тогда
		Возврат Новый Структура("Статус, ТекстXML, Сообщение", "ОшибкаФормирования", "", Исправление.Ошибка);
	КонецЕсли;

	Возврат СформироватьXMLДокумента(Ссылка, Контекст, Исправление);

КонецФункции

// Параметры исправления для XML: номер и дата исправления, а при известном исходном экземпляре
// его имя файла и реквизиты счета-фактуры. Ошибка - пустая строка, если параметры годны.
Функция ИсправлениеУПД(Знач Ссылка, Знач НомерИсправления, Знач ДатаИсправления,
	Знач ИдИсходногоЭкземпляра = "") Экспорт

	Исправление = Новый Структура("НомерИсправления, ДатаИсправления, ИмяФайлаИсходного,"
		+ " НомерДокИсходного, ДатаДокИсходного, Ошибка, ОтгрузкаЗарегистрирована",
		0, Дата(1, 1, 1), "", "", "", "", Ложь);

	Если ТипЗнч(НомерИсправления) <> Тип("Число") Тогда
		Исправление.Ошибка = "Номер исправления - целое число от 1 до 999";
		Возврат Исправление;
	КонецЕсли;
	Если НомерИсправления <> Цел(НомерИсправления) ИЛИ НомерИсправления < 1 ИЛИ НомерИсправления > 999 Тогда
		Исправление.Ошибка = "Номер исправления - целое число от 1 до 999";
		Возврат Исправление;
	КонецЕсли;
	Если ТипЗнч(ДатаИсправления) <> Тип("Дата") ИЛИ НЕ ЗначениеЗаполнено(ДатаИсправления) Тогда
		Исправление.Ошибка = "Не указана дата исправления";
		Возврат Исправление;
	КонецЕсли;
	Если НачалоДня(ДатаИсправления) < НачалоДня(Ссылка.Дата) Тогда
		Исправление.Ошибка = "Дата исправления " + Формат(ДатаИсправления, "ДФ=dd.MM.yyyy")
			+ " раньше даты документа " + Формат(Ссылка.Дата, "ДФ=dd.MM.yyyy");
		Возврат Исправление;
	КонецЕсли;
	Исправление.НомерИсправления = НомерИсправления;
	Исправление.ДатаИсправления = НачалоДня(ДатаИсправления);

	ИдИсходного = СокрЛП(Строка(ИдИсходногоЭкземпляра));
	Если НЕ ЗначениеЗаполнено(ИдИсходного) Тогда
		Возврат Исправление;
	КонецЕсли;

	Содержимое = ЗапросКОператоруЭДО("GET", "/public/api/v3/documents/" + ИдИсходного + "/content", ,
		ОрганизацияДокумента(Ссылка));
	Если Содержимое.Код <> 200 ИЛИ Содержимое.Данные = Неопределено Тогда
		Исправление.Ошибка = "Содержимое исправляемого экземпляра " + ИдИсходного
			+ " не получено от оператора, HTTP " + Формат(Содержимое.Код, "ЧГ=0");
		Возврат Исправление;
	КонецЕсли;
	ТекстИсходного = ПолучитьСтрокуИзДвоичныхДанных(Содержимое.Данные, "windows-1251");
	Если ПозицияНачалаТега(ТекстИсходного, "СвСчФакт") = 0 Тогда
		Исправление.Ошибка = "Экземпляр " + ИдИсходного + " не является УПД: в нем нет узла СвСчФакт";
		Возврат Исправление;
	КонецЕсли;

	Исправление.НомерДокИсходного = ЗначениеАтрибутаXML(ТекстИсходного, "СвСчФакт", "НомерДок");
	Исправление.ДатаДокИсходного = ЗначениеАтрибутаXML(ТекстИсходного, "СвСчФакт", "ДатаДок");
	// Исправление исправления ссылается на начальный файл, а не на предыдущее исправление.
	Если ПозицияНачалаТега(ТекстИсходного, "ИспрДок") > 0 Тогда
		Исправление.ИмяФайлаИсходного = ЗначениеАтрибутаXML(ТекстИсходного, "СвСчФакт", "ИмяФайлИспрПрод");
	Иначе
		Исправление.ИмяФайлаИсходного = ЗначениеАтрибутаXML(ТекстИсходного, "Файл", "ИдФайл");
	КонецЕсли;

	// ++ ЩА 21.10.2026 [yan]: отгрузку, уже зарегистрированную каким-либо экземпляром документа, ЧЗ второй
	// раз не принимает (ERROR_63) - такому ИУПД признак фиксации не ставится. Неизвестное состояние не
	// угадываем: ИУПД не формируется.
	Если НЕ ЕстьПродукцияСФиксацией(Ссылка) Тогда
		Возврат Исправление;
	КонецЕсли;
	Отгрузка = ОтгрузкаДокументаВЧЗ(Ссылка, ИдИсходного, Исправление.ИмяФайлаИсходного,
		ПозицияНачалаТега(ТекстИсходного, "ИспрДок") = 0);
	Если НЕ Отгрузка.Определено Тогда
		Исправление.Ошибка = "Не установлено, зарегистрирована ли отгрузка в ЧЗ (" + Отгрузка.Причина
			+ "): исправление не сформировано, повторите позже";
		ЗаписьЖурналаРегистрации("ЭДО.ИУПД", УровеньЖурналаРегистрации.Предупреждение, , Ссылка, Исправление.Ошибка);
	Иначе
		Исправление.ОтгрузкаЗарегистрирована = Отгрузка.Зарегистрирована;
	КонецЕсли;
	// -- ЩА 21.10.2026 [yan].

	Возврат Исправление;

КонецФункции

// ++ ЩА 21.10.2026 [yan]: зарегистрирована ли в ЧЗ отгрузка по документу каким-либо его экземпляром.
// Экземпляры - исправляемый, текущий из свойства и все карточки документа у оператора по номеру и дате
// (у текущего адреса покупателя), включая аннулированные: аннулирование УПД фиксацию не снимает, а у
// промежуточного ИУПД без N4 своей фиксации нет - решает фиксация начального экземпляра.
// Зарегистрирована - только подтвержденная фиксация: SUCCESS с операцией FIXATION. Не зарегистрирована
// по экземпляру - фиксации нет (404), отмена фиксации успешна или отклонена именно фиксация. Прочее
// (отказ отмены, неизвестная операция, обработка, нет ответа) - неопределенность, если ни один
// экземпляр не дал подтвержденной фиксации.
// «Не зарегистрирована» утверждается, только если среди проверенных есть начальный экземпляр (файл
// ИмяФайлаНачального, на него ссылается любое исправление): у промежуточного ИУПД без N4 своей фиксации
// нет, и без начального отсутствие фиксации ничего не доказывает (ревью Codex 897). ИсходныйНачальный -
// исправляемый экземпляр сам начальный (без ИспрДок).
// Возврат: Структура (Определено, Зарегистрирована, Причина, Карточка - ид с подтвержденной фиксацией).
Функция ОтгрузкаДокументаВЧЗ(Знач Ссылка, Знач ИдИсходного, Знач ИмяФайлаНачального, Знач ИсходныйНачальный)

	Итог = Новый Структура("Определено, Зарегистрирована, Причина, Карточка", Ложь, Ложь, "", "");

	Экземпляры = Новый Массив;
	ДобавитьЭкземпляр(Экземпляры, ИдИсходного);
	СвойствоИд = СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если СвойствоИд <> Неопределено И НЕ СвойствоИд.Пустая() Тогда
		ДобавитьЭкземпляр(Экземпляры, СтрЗаменить(Строка(ЗначениеСвойстваОбъекта(Ссылка, СвойствоИд)), Символы.НПП, ""));
	КонецЕсли;

	ГидПолучателя = ИдентификаторУчастникаЭДО(Ссылка.Контрагент);
	Если НЕ ЗначениеЗаполнено(ГидПолучателя) Тогда
		Итог.Причина = "у контрагента нет идентификатора ЭДО, карточки документа не найти";
		Возврат Итог;
	КонецЕсли;
	Организация = ОрганизацияДокумента(Ссылка);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));
	Опрос = КарточкиДокументаУОператора(СоединениеСОператором(20), Заголовки, ГидОрганизации(Организация),
		ГидПолучателя, СокрЛП(Ссылка.Номер), Ссылка.Дата);
	Если НЕ Опрос.Опрошено Тогда
		Итог.Причина = "карточки документа у оператора не получены: " + Опрос.Причина;
		Возврат Итог;
	КонецЕсли;
	Для Каждого Карточка Из Опрос.Карточки Цикл
		ДобавитьЭкземпляр(Экземпляры, Карточка.Ид);
	КонецЦикла;

	Неясно = Новый Массив;
	Для Каждого Ид Из Экземпляры Цикл
		Фиксация = СостояниеФиксацииГИСМТ(Ссылка, Ид);
		Отказ = Фиксация.Состояние = "FAILED" ИЛИ Фиксация.Статус = "FAILED";
		Если Фиксация.Состояние = "SUCCESS" И Фиксация.Операция = "FIXATION" Тогда
			Итог.Определено = Истина;
			Итог.Зарегистрирована = Истина;
			Итог.Карточка = Ид;
			Возврат Итог;
		ИначеЕсли НЕ ЗначениеЗаполнено(Фиксация.Состояние) И НЕ ЗначениеЗаполнено(Фиксация.Статус)
			И (Фиксация.Итог = "Фиксация у оператора не найдена" ИЛИ Фиксация.Итог = ТекстСтатусаГИСМТНеТребуется()) Тогда
			Продолжить;   // фиксации у экземпляра нет
		ИначеЕсли Фиксация.Состояние = "SUCCESS" И Фиксация.Операция = "FIXATION_CANCEL" Тогда
			Продолжить;   // фиксация экземпляра отменена
		ИначеЕсли Отказ И Фиксация.Операция = "FIXATION" Тогда
			Продолжить;   // ЧЗ отклонил именно фиксацию
		КонецЕсли;
		Неясно.Добавить(Ид + " - " + ?(ЗначениеЗаполнено(Фиксация.Итог), Фиксация.Итог, "состояние не распознано")
			+ ?(ЗначениеЗаполнено(Фиксация.Операция), ", операция " + Фиксация.Операция, ""));
	КонецЦикла;

	Если Неясно.Количество() > 0 Тогда
		Итог.Причина = "фиксация экземпляров " + СтрСоединить(Неясно, "; ");
		Возврат Итог;
	КонецЕсли;

	НачальныйНайден = ИсходныйНачальный;
	Если НЕ НачальныйНайден И ЗначениеЗаполнено(ИмяФайлаНачального) Тогда
		Для Каждого Ид Из Экземпляры Цикл
			Если Ид = СокрЛП(Строка(ИдИсходного)) Тогда
				Продолжить;   // исправляемый уже прочитан: это исправление
			КонецЕсли;
			Содержимое = ЗапросКОператоруЭДО("GET", "/public/api/v3/documents/" + Ид + "/content", , Организация);
			Если Содержимое.Код <> 200 ИЛИ Содержимое.Данные = Неопределено Тогда
				Итог.Причина = "содержимое экземпляра " + Ид + " не получено, HTTP " + Формат(Содержимое.Код, "ЧГ=0");
				Возврат Итог;
			КонецЕсли;
			ИдФайла = ЗначениеАтрибутаXML(ПолучитьСтрокуИзДвоичныхДанных(Содержимое.Данные, "windows-1251"), "Файл", "ИдФайл");
			Если ВРег(СокрЛП(ИдФайла)) = ВРег(СокрЛП(ИмяФайлаНачального)) Тогда
				НачальныйНайден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если НЕ НачальныйНайден Тогда
		Итог.Причина = "начальный экземпляр документа (файл " + ИмяФайлаНачального
			+ ") среди карточек у текущего адреса покупателя не найден - укажите его исправляемым экземпляром";
		Возврат Итог;
	КонецЕсли;
	Итог.Определено = Истина;
	Возврат Итог;

КонецФункции

Процедура ДобавитьЭкземпляр(Экземпляры, Знач Ид)
	Ид = СокрЛП(Строка(Ид));
	Если ЗначениеЗаполнено(Ид) И Экземпляры.Найти(Ид) = Неопределено Тогда
		Экземпляры.Добавить(Ид);
	КонецЕсли;
КонецПроцедуры
// -- ЩА 21.10.2026 [yan].

// Вставляет в титул продавца узел ИспрДок первым в СвСчФакт и атрибут ИмяФайлИспрПрод.
// Номер и дата счета-фактуры в ИУПД обязаны совпадать с исправляемым экземпляром, иначе
// Честный знак примет его за новый документ.
// Возврат: Структура (Текст, Ошибка).
Функция ДополнитьИсправлением(Знач Текст, Знач Исправление)

	Итог = Новый Структура("Текст, Ошибка", Текст, "");

	Начало = ПозицияНачалаТега(Текст, "СвСчФакт");
	Если Начало = 0 Тогда
		Итог.Ошибка = "В сформированном XML нет узла СвСчФакт";
		Возврат Итог;
	КонецЕсли;
	Если ПозицияНачалаТега(Текст, "ИспрДок") > 0 Тогда
		Итог.Ошибка = "В сформированном XML узел ИспрДок уже есть";
		Возврат Итог;
	КонецЕсли;
	ДлинаТега = СтрНайти(Сред(Текст, Начало), ">");
	Открывающий = Сред(Текст, Начало, ДлинаТега);
	Если ДлинаТега = 0 ИЛИ Прав(Открывающий, 2) = "/>" Тогда
		Итог.Ошибка = "В сформированном XML узел СвСчФакт пуст или не закрыт";
		Возврат Итог;
	КонецЕсли;

	НомерДок = ЗначениеАтрибутаXML(Текст, "СвСчФакт", "НомерДок");
	ДатаДок = ЗначениеАтрибутаXML(Текст, "СвСчФакт", "ДатаДок");
	Если ЗначениеЗаполнено(Исправление.НомерДокИсходного)
		И (СокрЛП(НомерДок) <> СокрЛП(Исправление.НомерДокИсходного)
			ИЛИ СокрЛП(ДатаДок) <> СокрЛП(Исправление.ДатаДокИсходного)) Тогда
		Итог.Ошибка = "Счет-фактура в исправлении (" + НомерДок + " от " + ДатаДок
			+ ") не совпадает с исправляемым экземпляром (" + Исправление.НомерДокИсходного + " от "
			+ Исправление.ДатаДокИсходного + "): номер и дата должны остаться прежними";
		Возврат Итог;
	КонецЕсли;

	Если ЗначениеЗаполнено(Исправление.ИмяФайлаИсходного)
		И НЕ ЗначениеЗаполнено(ЗначениеАтрибутаXML(Текст, "СвСчФакт", "ИмяФайлИспрПрод")) Тогда
		Открывающий = Лев(Открывающий, ДлинаТега - 1) + " ИмяФайлИспрПрод="""
			+ ЭкранироватьАтрибутXML(Исправление.ИмяФайлаИсходного) + """>";
	КонецЕсли;
	УзелИсправления = "<ИспрДок НомИспр=""" + Формат(Исправление.НомерИсправления, "ЧГ=0")
		+ """ ДатаИспр=""" + Формат(Исправление.ДатаИсправления, "ДФ=dd.MM.yyyy") + """/>";

	Итог.Текст = Лев(Текст, Начало - 1) + Открывающий + УзелИсправления + Сред(Текст, Начало + ДлинаТега);
	Возврат Итог;

КонецФункции

// Позиция "<ИмяТега" начала элемента, 0 - если его нет. Теги, имя которых лишь начинается так же, пропускаются.
Функция ПозицияНачалаТега(Знач Текст, Знач ИмяТега)

	Маркер = "<" + ИмяТега;
	Смещение = 0;
	Остаток = Текст;
	Пока Истина Цикл
		Позиция = СтрНайти(Остаток, Маркер);
		Если Позиция = 0 Тогда
			Возврат 0;
		КонецЕсли;
		Следующий = Сред(Остаток, Позиция + СтрДлина(Маркер), 1);
		Если Следующий = ">" ИЛИ Следующий = "/" ИЛИ ПустаяСтрока(Следующий) Тогда
			Возврат Смещение + Позиция;
		КонецЕсли;
		Смещение = Смещение + Позиция;
		Остаток = Сред(Остаток, Позиция + 1);
	КонецЦикла;

	Возврат 0;

КонецФункции

// Значение атрибута первого элемента ИмяТега; пустая строка, если элемента или атрибута нет.
Функция ЗначениеАтрибутаXML(Знач Текст, Знач ИмяТега, Знач ИмяАтрибута)

	Начало = ПозицияНачалаТега(Текст, ИмяТега);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;
	Тег = Сред(Текст, Начало, СтрНайти(Сред(Текст, Начало), ">"));
	Тег = СтрЗаменить(СтрЗаменить(СтрЗаменить(Тег, Символы.ПС, " "), Символы.Таб, " "), Символы.ВК, " ");
	Маркер = " " + ИмяАтрибута + "=""";
	Позиция = СтрНайти(Тег, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Тег, Позиция + СтрДлина(Маркер));
	Значение = Лев(Хвост, СтрНайти(Хвост, """") - 1);
	Значение = СтрЗаменить(СтрЗаменить(СтрЗаменить(Значение, "&quot;", """"), "&lt;", "<"), "&gt;", ">");
	Возврат СтрЗаменить(Значение, "&amp;", "&");

КонецФункции

Функция ЭкранироватьАтрибутXML(Знач Значение)

	Значение = СтрЗаменить(Значение, "&", "&amp;");
	Значение = СтрЗаменить(Значение, "<", "&lt;");
	Значение = СтрЗаменить(Значение, ">", "&gt;");
	Возврат СтрЗаменить(Значение, """", "&quot;");

КонецФункции

#КонецОбласти

#Область ВходящиеУПД

// Автоматическое принятие входящих УПД: титул покупателя подписывается без участия человека,
// документ в базе не создается. Принимаются только УПД продавцов, у которых есть карточка
// контрагента с флагом ЭДО_АвтоматическоеПринятиеУПД, а УКД - с флагом ЭДО_АвтоматическоеПринятиеУКД.
// Флаг ищется по ИНН: на один ИНН бывает несколько карточек. Общий выключатель - настройка
// АвтоматическоеПринятиеУПД.

// Точка входа регламента. ТолькоПроверка - посчитать, что было бы принято, ничего не подписывая.
// Возврат: Строка - свод для журнала.
Функция ВыполнитьАвтоматическоеПринятиеУПД(Знач ТолькоПроверка = Ложь) Экспорт

	Попытка
		Результат = ПринятьВходящиеУПД(ТолькоПроверка);
	Исключение
		Результат = "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Результат), "ОШИБКА") > 0,
		"ЭДО.Регламент.АвтоматическоеПринятиеУПД");
	Возврат Результат;

КонецФункции

Функция ПринятьВходящиеУПД(Знач ТолькоПроверка)

	// Сухой прогон считает и при выключенной настройке: по нему решают, включать ли ее.
	Включено = (Число(НастройкаЭДО("АвтоматическоеПринятиеУПД")) = 1);
	Если НЕ Включено И НЕ ТолькоПроверка Тогда
		Возврат "ЭДО, принятие входящих УПД: выключено настройкой";
	КонецЕсли;

	Доверенные = ИННКонтрагентовСАвтоматическимПринятием();
	// ЩА 15.10.2026 [yan]: корректировка меняет уже принятые суммы и количество - согласие на автоприемку УПД
	// на нее не распространяется, у УКД свой флаг.
	ДоверенныеУКД = ИННКонтрагентовСАвтоматическимПринятием("ЭДО_АвтоматическоеПринятиеУКД");
	Если Доверенные.Количество() = 0 И ДоверенныеУКД.Количество() = 0 И НЕ ТолькоПроверка Тогда
		Возврат "ЭДО, принятие входящих УПД: нет контрагентов с флагом ЭДО_АвтоматическоеПринятиеУПД"
			+ " или ЭДО_АвтоматическоеПринятиеУКД";
	КонецЕсли;
	// Режим "по сверке": у доверенного продавца с этим флагом перед подписью ищем поступление в базе
	// и сверяем суммы (СверитьВходящийУПД). Без базового флага автопринятия этот флаг ничего не дает.
	СоСверкой = ИННКонтрагентовСАвтоматическимПринятием("ЭДО_СверкаПередПринятиемУПД");

	Принято = Новый Массив;
	Ошибки = Новый Массив;
	НеСошлось = Новый Массив;
	// ЩА 12.10.2026 [yan], УКД: оставленные человеку намеренно - в квоту попыток не входят (ревью Codex 496).
	Человеку = Новый Массив;
	НеДоверенных = 0;
	ЖдутОтвета = 0;
	Предел = 50;
	// Один пользователь кабинета может видеть входящие нескольких наших организаций:
	// документ относится к той, чей ИНН стоит покупателем, и берется один раз.
	Просмотренные = Новый Соответствие;
	Записи = УчетныеЗаписиЭДО();

	Для Каждого Запись Из Записи Цикл
		Организация = Запись.Организация;
		ИННОрганизации = СокрЛП(Организация.ИНН);
		Попытка
			Входящие = ВходящиеУПДБезОтвета(ГлубинаДнейПринятияУПД(), Организация);
		Исключение
			Ошибки.Добавить(Строка(Организация) + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;
		Подписант = Неопределено;

		Для Каждого Входящий Из Входящие Цикл
			Если Просмотренные.Получить(Входящий.Ид) <> Неопределено
				ИЛИ (ЗначениеЗаполнено(Входящий.ИННПокупателя) И Входящий.ИННПокупателя <> ИННОрганизации) Тогда
				Продолжить;
			КонецЕсли;
			Просмотренные.Вставить(Входящий.Ид, Истина);
			ЖдутОтвета = ЖдутОтвета + 1;

			ДоверенныеВида = ?(Входящий.ЭтоУКД, ДоверенныеУКД, Доверенные);   // ЩА 15.10.2026 [yan]
			Если ДоверенныеВида.Получить(Входящий.ИННПродавца) = Неопределено Тогда
				НеДоверенных = НеДоверенных + 1;
				Продолжить;
			КонецЕсли;
			Если Принято.Количество() + Ошибки.Количество() + НеСошлось.Количество() >= Предел Тогда
				Прервать;
			КонецЕсли;

			Описание = ?(Входящий.ЭтоУКД, "УКД ", "") + Входящий.Номер + " от " + Входящий.Дата + ", " + Входящий.Продавец
				+ " -> " + Строка(Организация) + " (ид " + Входящий.Ид + ")";

			// Режим по сверке считается и в сухом прогоне: он должен показывать, что сошлось бы.
			ТребуетсяСверка = (СоСверкой.Получить(Входящий.ИННПродавца) <> Неопределено);
			СверкаРезультат = Неопределено;
			// ++ ЩА 12.10.2026 [yan], УКД: сверка ищет поступление по итогам УПД, к корректировке
			//    она не подходит - УКД продавца с флагом сверки остается человеку.
			//    ЩА 12.10.2026: покупателю-ИП тоже: проверен только подписант-работник ЮЛ (ревью Codex 496).
			Если Входящий.ЭтоУКД И СтрДлина(ИННОрганизации) = 12 Тогда
				Человеку.Добавить(Описание + ": УКД покупателю-ИП, вариант подписанта у оператора не проверен");
				Продолжить;
			КонецЕсли;
			Если ТребуетсяСверка И Входящий.ЭтоУКД Тогда
				Человеку.Добавить(Описание + ": УКД, сверка с поступлением для корректировок не выполняется");
				Продолжить;
			КонецЕсли;
			// -- ЩА 12.10.2026 [yan].
			Если ТребуетсяСверка Тогда
				Попытка
					СверкаРезультат = СверитьВходящийУПД(Входящий, Организация);
				Исключение
					СверкаРезультат = Новый Структура("Сошлось, Причина, Поступление", Ложь,
						"сверка не выполнена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Неопределено);
				КонецПопытки;
				Если НЕ СверкаРезультат.Сошлось Тогда
					НеСошлось.Добавить(Описание + ": " + СверкаРезультат.Причина);
					Продолжить;
				КонецЕсли;
			КонецЕсли;

			Если ТолькоПроверка Тогда
				Если ТребуетсяСверка Тогда
					Принято.Добавить(Описание + " (по сверке с " + Строка(СверкаРезультат.Поступление) + ")");
				Иначе
					Принято.Добавить(Описание);
				КонецЕсли;
				Продолжить;
			КонецЕсли;

			Попытка
				Если Подписант = Неопределено Тогда
					Подписант = ПодписантДляОператора(Организация);
				КонецЕсли;
				Итог = ПринятьВходящийУПД(Входящий, Подписант, Организация);
			Исключение
				Итог = Новый Структура("Успех, Текст", Ложь, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
			Если Итог.Успех Тогда
				Если ТребуетсяСверка Тогда
					Принято.Добавить(Описание + " (по сверке с " + Строка(СверкаРезультат.Поступление) + ")");
				Иначе
					Принято.Добавить(Описание);
				КонецЕсли;
			Иначе
				Ошибки.Добавить(Описание + ": " + Итог.Текст);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Текст = "ЭДО, принятие входящих УПД" + ?(ТолькоПроверка, " (сухой прогон"
		+ ?(Включено, "", ", настройка выключена") + ")", "")
		+ ": организаций " + Формат(Записи.Количество(), "ЧН=0; ЧГ=0")
		+ ", ИНН с флагом " + Формат(Доверенные.Количество(), "ЧН=0; ЧГ=0")
		+ ", ждут ответа " + Формат(ЖдутОтвета, "ЧН=0; ЧГ=0")
		+ ", " + ?(ТолькоПроверка, "к принятию ", "принято ") + Формат(Принято.Количество(), "ЧН=0; ЧГ=0")
		+ ", продавец без флага " + Формат(НеДоверенных, "ЧН=0; ЧГ=0")
		+ ", по сверке отклонено " + Формат(НеСошлось.Количество(), "ЧН=0; ЧГ=0")
		+ ?(Человеку.Количество() > 0, ", оставлено человеку " + Формат(Человеку.Количество(), "ЧН=0; ЧГ=0"), "")
		+ ?(Ошибки.Количество() > 0, ", ОШИБКА у " + Формат(Ошибки.Количество(), "ЧН=0; ЧГ=0"), "");
	Для Каждого Строчка Из Принято Цикл
		Текст = Текст + Символы.ПС + "  " + Строчка;
	КонецЦикла;
	Для Каждого Строчка Из НеСошлось Цикл
		Текст = Текст + Символы.ПС + "  НЕ СОШЛОСЬ " + Строчка;
	КонецЦикла;
	Для Каждого Строчка Из Человеку Цикл
		Текст = Текст + Символы.ПС + "  ЧЕЛОВЕКУ " + Строчка;
	КонецЦикла;
	Для Каждого Строчка Из Ошибки Цикл
		Текст = Текст + Символы.ПС + "  ОШИБКА " + Строчка;
	КонецЦикла;
	Возврат Текст;

КонецФункции

// За сколько дней назад искать входящие УПД без ответа: настройка ГлубинаДнейПринятияУПД,
// по умолчанию 14. Ноль и мусор - умолчание, потолок 90: каждый день окна - отдельный
// запрос к оператору, и год назад искать входящие незачем.
Функция ГлубинаДнейПринятияУПД()

	Глубина = НастройкаЭДО("ГлубинаДнейПринятияУПД");
	Если НЕ ЗначениеЗаполнено(Глубина) ИЛИ Глубина < 1 Тогда
		Возврат 14;
	КонецЕсли;
	Возврат Мин(Цел(Глубина), 90);

КонецФункции

// Допуск расхождения суммы УПД с суммой поступления в базе, рубли. Настройка ДопускСуммыУПД,
// по умолчанию 0.01 (копейка на округление).
Функция ДопускСуммыУПД()

	Значение = НастройкаЭДО("ДопускСуммыУПД");
	Если НЕ ЗначениеЗаполнено(Значение) ИЛИ Значение <= 0 Тогда
		Возврат 0.01;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Окно поиска поступления относительно даты УПД, месяцев назад. Настройка
// ПоискПоступленияМесяцевНазад, по умолчанию 4.
Функция ПоискПоступленияМесяцевНазад()

	Значение = НастройкаЭДО("ПоискПоступленияМесяцевНазад");
	Если НЕ ЗначениеЗаполнено(Значение) ИЛИ Значение < 0 Тогда
		Возврат 4;
	КонецЕсли;
	Возврат Цел(Значение);

КонецФункции

// Окно поиска поступления относительно даты УПД, месяцев вперёд. Настройка
// ПоискПоступленияМесяцевВперёд, по умолчанию 1.
Функция ПоискПоступленияМесяцевВперёд()

	Значение = НастройкаЭДО("ПоискПоступленияМесяцевВперёд");
	Если НЕ ЗначениеЗаполнено(Значение) ИЛИ Значение < 0 Тогда
		Возврат 1;
	КонецЕсли;
	Возврат Цел(Значение);

КонецФункции

// Возврат: Соответствие (ИНН -> Истина) контрагентов, у которых включен флаг ИмяСвойства
// (ЭДО_АвтоматическоеПринятиеУПД, ЭДО_АвтоматическоеПринятиеУКД или ЭДО_СверкаПередПринятиемУПД).
Функция ИННКонтрагентовСАвтоматическимПринятием(Знач ИмяСвойства = "ЭДО_АвтоматическоеПринятиеУПД") Экспорт

	Итог = Новый Соответствие;
	Свойство = СвойствоОбъектов(ИмяСвойства);
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат Итог;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(Значения.Объект КАК Справочник.Контрагенты).ИНН КАК ИНН,
		|	Значения.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК Значения
		|ГДЕ
		|	Значения.Свойство = &Свойство
		|	И Значения.Объект ССЫЛКА Справочник.Контрагенты");
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИНН = СокрЛП(Выборка.ИНН);
		Если ЗначениеЗаполнено(ИНН) И ФлагСвойстваВключён(Выборка.Значение) Тогда
			Итог.Вставить(ИНН, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Входящие УПД и УКД, на которые мы еще не ответили: продавец - не наша организация, статус SENT
// или DELIVERED. Счет-фактура (СЧФ) и корректировочный счет-фактура (КСЧФ) без функции ДОП/ДИС
// ответного титула не имеют и не берутся.
// Выдача отбирается по получателю (recipient_id); окно - до 30 дней (оператор принимает не больше 31),
// при 1000 карточках в окне (потолок выдачи) окно делится пополам.
// Возврат: Массив структур (Ид, Номер, Дата, ИННПродавца, Продавец, ИННПокупателя, Версия, ЭтоУКД).
Функция ВходящиеУПДБезОтвета(Знач ГлубинаДней, Знач Организация = Неопределено)

	Итог = Новый Массив;
	// Пропускаем документ, где продавец - сама организация-покупатель (документ самому себе).
	// Другие организации справочника - законные продавцы: в базах с несколькими своими юрлицами
	// (дистрибьюторы УТАП) отгрузки между ними и есть входящие, которые нужно принимать.
	// Без организации - прежнее поведение: все организации справочника.
	НашиИНН = Новый Соответствие;
	Если ЗначениеЗаполнено(Организация) Тогда
		НашиИНН.Вставить(СокрЛП(Организация.ИНН), Истина);
	Иначе
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Орг.ИНН КАК ИНН ИЗ Справочник.Организации КАК Орг");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НашиИНН.Вставить(СокрЛП(Выборка.ИНН), Истина);
		КонецЦикла;
	КонецЕсли;

	Ждущие = Новый Соответствие;
	Ждущие.Вставить("SENT", Истина);
	Ждущие.Вставить("DELIVERED", Истина);

	// ++ ЩА 12.10.2026 [yan], УКД: корректировки продавца приходят отдельным типом списка.
	ДобавитьВходящиеБезОтвета(Итог, "NEW_SELLER_TITLE", ГлубинаДней, Организация, НашиИНН, Ждущие);
	ДобавитьВходящиеБезОтвета(Итог, "NEW_COR_SELLER_TITLE", ГлубинаДней, Организация, НашиИНН, Ждущие);
	// -- ЩА 12.10.2026 [yan].

	Возврат Итог;

КонецФункции

// ++ ЩА 12.10.2026 [yan], УКД: обход выдачи оператора по одному типу списка (УПД или УКД).
// Дописывает в Итог карточки без ответа (структура - см. ВходящиеУПДБезОтвета).
Процедура ДобавитьВходящиеБезОтвета(Итог, Знач ТипСписка, Знач ГлубинаДней, Знач Организация, Знач НашиИНН, Знач Ждущие)

	ЭтоУКД = (ТипСписка = "NEW_COR_SELLER_TITLE");
	БезОтветногоТитула = Новый Соответствие;
	БезОтветногоТитула.Вставить("СЧФ", Истина);
	БезОтветногоТитула.Вставить("КСЧФ", Истина);

	// ++ ЩА 13.10.2026 [yan]: ящик оператора общий для всех организаций сети - без отбора по получателю
	//    выдача несет чужие карточки и упирается в потолок 1000 за запрос, лишнее молча срезается.
	//    С recipient_id приходят только карточки организации, окно - до 30 дней. Без идентификатора
	//    организации у оператора - прежнее окно в сутки без отбора.
	ГидПолучателя = СокрЛП(ГидОрганизации(Организация));
	ОтборПолучателя = ?(ЗначениеЗаполнено(ГидПолучателя), "&recipient_id=" + ГидПолучателя, "");
	ДлинаОкна = ?(ЗначениеЗаполнено(ОтборПолучателя), 30, 1) * 86400;
	Видимые = Новый Соответствие;   // Ид карточки -> Истина: повтор после деления окна не берется
	Граница = НачалоДня(ТекущаяУниверсальнаяДата()) + 86400;
	НижняяГраница = Граница - (ГлубинаДней + 1) * 86400;   // те же ГлубинаДней + 1 суток, что и прежде
	Пока Граница > НижняяГраница Цикл
		НачалоОкна = Макс(НижняяГраница, Граница - ДлинаОкна);
		// Десять полных страниц - окно переполнено (страница 10 при размере 100 - ответ 400):
		// делим его и читаем заново.
		Переполнено = Ложь;
		// -- ЩА 13.10.2026 [yan].
		Для Страница = 0 По 9 Цикл
			Путь = "/public/api/v3/documents?type=" + ТипСписка
				+ "&created_from=" + Формат(НачалоОкна, "ДФ=yyyy-MM-ddTHH:mm:ss.000Z")   // ЩА 13.10.2026 [yan]
				+ "&created_till=" + Формат(Граница, "ДФ=yyyy-MM-ddTHH:mm:ss.000Z")   // ЩА 13.10.2026 [yan]
				+ ОтборПолучателя   // ЩА 13.10.2026 [yan]
				+ "&page=" + Формат(Страница, "ЧН=0; ЧГ=0") + "&page_size=100";
			Ответ = ЗапросКОператоруЭДО("GET", Путь, , Организация);
			Если Ответ.Код <> 200 Тогда
				ВызватьИсключение "список документов оператора не получен, HTTP " + Ответ.Код + " " + Лев(Ответ.Текст, 200);
			КонецЕсли;
			Карточки = ПрочитатьОтветJSON(Ответ.Текст);
			Если ТипЗнч(Карточки) <> Тип("Массив") Тогда
				Прервать;
			КонецЕсли;

			Для Каждого Карточка Из Карточки Цикл
				Счет = Карточка.Получить("invoice");
				Если ТипЗнч(Счет) <> Тип("Соответствие") Тогда
					Продолжить;
				КонецЕсли;
				Продавец = Счет.Получить("seller");
				Покупатель = Счет.Получить("buyer");
				ИННПродавца = ?(ТипЗнч(Продавец) = Тип("Соответствие"), СокрЛП(Строка(Продавец.Получить("inn"))), "");
				СтатусКарточки = Карточка.Получить("newStatus");
				Если СтатусКарточки = Неопределено Тогда
					СтатусКарточки = Карточка.Получить("status");
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ИННПродавца) ИЛИ НашиИНН.Получить(ИННПродавца) <> Неопределено
					ИЛИ Ждущие.Получить(ВРег(Строка(СтатусКарточки))) = Неопределено
					ИЛИ БезОтветногоТитула.Получить(ВРег(СокрЛП(Строка(Счет.Получить("function"))))) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				// ++ ЩА 13.10.2026 [yan]
				Ид = ЭДО_Регламенты.ИдентификаторСтрокой(Карточка.Получить("id"));
				Если Видимые.Получить(Ид) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Видимые.Вставить(Ид, Истина);
				// -- ЩА 13.10.2026 [yan].
				Итог.Добавить(Новый Структура("Ид, Номер, Дата, ИННПродавца, Продавец, ИННПокупателя, Версия, ЭтоУКД",
					Ид,
					СокрЛП(Строка(Счет.Получить("num"))),
					СокрЛП(Строка(Счет.Получить("date"))),
					ИННПродавца,
					ПредставлениеСтороныСчета(Продавец),
					?(ТипЗнч(Покупатель) = Тип("Соответствие"), СокрЛП(Строка(Покупатель.Получить("inn"))), ""),
					СокрЛП(Строка(Карточка.Получить("version"))),
					ЭтоУКД));
			КонецЦикла;

			Если Карточки.Количество() < 100 Тогда
				Прервать;
			КонецЕсли;
			Переполнено = (Страница = 9);   // ЩА 13.10.2026 [yan]
		КонецЦикла;
		// ++ ЩА 13.10.2026 [yan]
		Если Переполнено Тогда
			Если Граница - НачалоОкна <= 3600 Тогда
				ВызватьИсключение "больше 1000 документов " + ТипСписка + " за час с "
					+ Формат(НачалоОкна, "ДФ='dd.MM.yyyy HH:mm'") + " - список неполный";
			КонецЕсли;
			ДлинаОкна = Макс(3600, Цел((Граница - НачалоОкна) / 2));
			Продолжить;
		КонецЕсли;
		// -- ЩА 13.10.2026 [yan].
		Граница = НачалоОкна;
	КонецЦикла;

КонецПроцедуры
// -- ЩА 12.10.2026 [yan].

// Наименование стороны из invoice: у юрлица строка, у ИП - структура из фамилии, имени, отчества.
Функция ПредставлениеСтороныСчета(Знач Сторона)

	Если ТипЗнч(Сторона) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Имя = Сторона.Получить("name");
	Если ТипЗнч(Имя) = Тип("Соответствие") Тогда
		Возврат СокрЛП(Строка(Имя.Получить("last")) + " " + Строка(Имя.Получить("first")) + " "
			+ Строка(Имя.Получить("middle")));
	КонецЕсли;
	Возврат ?(Имя = Неопределено, "ИНН " + Строка(Сторона.Получить("inn")), СокрЛП(Строка(Имя)));

КонецФункции

// Принять один входящий УПД или УКД: создать титул покупателя и подписать его.
// Титул, оставшийся неподписанным с прошлого прогона, подписывается, а второй не создается.
// Возврат: Структура (Успех, Текст).
Функция ПринятьВходящийУПД(Знач Входящий, Знач Подписант, Знач Организация = Неопределено)

	Итог = Новый Структура("Успех, Текст", Ложь, "");

	ИдТитула = "";
	ТипОтветногоТитула = ?(Входящий.ЭтоУКД, "ON_NKORSCHFDOPPOK", "ON_NSCHFDOPPOK"); // ЩА 12.10.2026 [yan], УКД
	Цепочка = ЗапросКОператоруЭДО("GET", "/public/api/v3/document-flows?id=" + Входящий.Ид + "&page=0&page_size=50", , Организация);
	// ++ ЩА 12.10.2026 [yan]: не прочитали цепочку - не создаем титул вслепую, повтор в следующем прогоне
	//    (иначе неподписанный титул прошлого прогона не переиспользуется; ревью Codex 496).
	Если Цепочка.Код <> 200 Тогда
		Итог.Текст = "цепочка документа не прочитана, HTTP " + Цепочка.Код;
		Возврат Итог;
	КонецЕсли;
	Корни = ПрочитатьОтветJSON(Цепочка.Текст);
	Если ТипЗнч(Корни) <> Тип("Массив") Тогда
		Итог.Текст = "цепочка документа: неожиданный формат ответа";
		Возврат Итог;
	КонецЕсли;
	// -- ЩА 12.10.2026 [yan].
	Для Каждого Корень Из Корни Цикл
		Подчиненные = Корень.Получить("slaves");
		Если ТипЗнч(Подчиненные) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Подчиненный Из Подчиненные Цикл
			Если ВРег(Строка(Подчиненный.Получить("type"))) <> ТипОтветногоТитула Тогда
				Продолжить;
			КонецЕсли;
			Если ВРег(Строка(Подчиненный.Получить("status"))) <> "NEW" Тогда
				Итог.Успех = Истина;
				Итог.Текст = "титул покупателя уже отправлен";
				Возврат Итог;
			КонецЕсли;
			ИдТитула = ЭДО_Регламенты.ИдентификаторСтрокой(Подчиненный.Получить("id"));
		КонецЦикла;
	КонецЦикла;

	Если НЕ ЗначениеЗаполнено(ИдТитула) Тогда
		Ответ = ЗапросКОператоруЭДО("PUT", "/public/api/v3/documents/" + Входящий.Ид + "/acceptance",
			СтрокаJSON(ТелоТитулаПокупателя(Входящий.Версия, Подписант, Входящий.ЭтоУКД)), Организация);
		Если Ответ.Код <> 200 Тогда
			Итог.Текст = "титул покупателя не создан, HTTP " + Ответ.Код + " " + Лев(Ответ.Текст, 300);
			Возврат Итог;
		КонецЕсли;
		ИдТитула = ЭДО_Регламенты.ИдентификаторСтрокой(ПрочитатьОтветJSON(Ответ.Текст).Получить("id"));
	КонецЕсли;

	Подписание = ПодписатьДокументОператора(ИдТитула, Организация);
	Если НЕ Подписание.Успех Тогда
		Итог.Текст = "титул покупателя создан (ид " + ИдТитула + "), но не подписан: " + Подписание.Текст;
		Возврат Итог;
	КонецЕсли;

	Итог.Успех = Истина;
	Итог.Текст = "принят, титул покупателя " + ИдТитула;
	Возврат Итог;

КонецФункции

// Тело запроса acceptance. Тип титула зависит от вида (УПД/УКД) и версии формата входящего.
// УКД 5.01 (UcdAcceptance) раздела details не имеет; УКД 5.02 (UcdV0502Acceptance) - как УПД.
Функция ТелоТитулаПокупателя(Знач Версия, Знач Подписант, Знач ЭтоУКД = Ложь)

	Подписывающий = Новый Структура("name, signingAuthorizationMethod", Подписант.ФИО, "ELECTRONIC_SIGNATURE");
	Если ЗначениеЗаполнено(Подписант.НомерМЧД) Тогда
		Подписывающий.Вставить("poaId", Подписант.НомерМЧД);
		Подписывающий.Вставить("poaIssueDate", Формат(Подписант.ДатаМЧД, "ДФ=yyyy-MM-dd"));
		Подписывающий.signingAuthorizationMethod = "MCHD_FROM_INFORMATION_SYSTEM_WITHOUT_INFO_IN_DOCUMENT";
	КонецЕсли;
	// ++ ЩА 12.10.2026 [yan], УКД.
	Если ЭтоУКД Тогда
		Если Версия = "5.02" Тогда
			Возврат Новый Структура("type, date, signer, details",
				"UcdV0502Acceptance",
				Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd"),
				Подписывающий,
				Новый Структура("acceptanceType", "ACCEPTED"));
		КонецЕсли;
		// УКД 5.01: оператор принимает только подписанта-работника организации-покупателя
		// (Подписант Статус=5, ЮЛ, «Должностные обязанности») - так подписывает и его веб-кабинет.
		// Физлицо по МЧД (Статус=4) титул 5.01 не проходит проверку: «Document is not valid».
		ПодписантЮЛ = Новый Структура("name, type, inn, orgName, position, status, authorityReason",
			Подписант.ФИО, "LE", Подписант.ИННОрганизации, Подписант.НаименованиеОрганизации,
			Подписант.Должность, "ORG_CUSTOMER", "Должностные обязанности");
		Возврат Новый Структура("type, date, signer",
			"UcdAcceptance",
			Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd"),
			ПодписантЮЛ);
	КонецЕсли;
	// -- ЩА 12.10.2026 [yan].
	Если Версия = "5.03" Тогда
		ТипТитула = "UtdV0503Acceptance";
	ИначеЕсли Версия = "5.02" Тогда
		ТипТитула = "UtdV0502Acceptance";
	Иначе
		ТипТитула = "UtdAcceptance";
		Подписывающий.Вставить("position", Подписант.Должность);
	КонецЕсли;

	Возврат Новый Структура("type, date, signer, details",
		ТипТитула,
		Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd"),
		Подписывающий,
		Новый Структура("acceptanceType", "ACCEPTED"));

КонецФункции

// Сверка входящего УПД с поступлением в базе (режим "по сверке"): скачивает содержимое УПД,
// ищет поступление по ИНН продавца и номеру в окне вокруг даты УПД, сравнивает суммы. Результат
// пишет в свойства единственного найденного поступления и всегда - в журнал сверки.
// Возврат: Структура (Сошлось Булево, Поступление ссылка/Неопределено, Причина Строка,
// КраткаяПричина Строка(<=50), ОтклонениеСуммы Число, СуммаУПД Число, СуммаНДСУПД Число).
Функция СверитьВходящийУПД(Знач Входящий, Знач Организация) Экспорт

	Итог = Новый Структура("Сошлось, Поступление, Причина, КраткаяПричина, ОтклонениеСуммы, СуммаУПД, СуммаНДСУПД",
		Ложь, Неопределено, "", "", 0, 0, 0);

	Содержимое = ЗапросКОператоруЭДО("GET", "/public/api/v3/documents/" + Входящий.Ид + "/content", , Организация);
	Если Содержимое.Код <> 200 Тогда
		Итог.Причина = "содержимое УПД не получено, HTTP " + Содержимое.Код;
		Итог.КраткаяПричина = Лев(Итог.Причина, 50);
		ДобавитьЗаписьЖурналаСверкиВходящих(Входящий, Организация, Итог);
		Возврат Итог;
	КонецЕсли;

	ИтогиXML = ИтогиИзXMLУПД(Содержимое.Данные);
	Если НЕ ИтогиXML.Найдено Тогда
		Итог.Причина = "в XML УПД не найден блок ВсегоОпл";
		Итог.КраткаяПричина = Лев(Итог.Причина, 50);
		ДобавитьЗаписьЖурналаСверкиВходящих(Входящий, Организация, Итог);
		Возврат Итог;
	КонецЕсли;
	Итог.СуммаУПД = ИтогиXML.СуммаСНДС;
	Итог.СуммаНДСУПД = ИтогиXML.СуммаНДС;

	// Поиск поступления: по ИНН продавца и нормализованному номеру, в окне вокруг даты УПД.
	ДатаУПД = ДатаИзСтрокиУПД(Входящий.Дата);
	ДатаС  = ДобавитьМесяц(ДатаУПД, -ПоискПоступленияМесяцевНазад());
	ДатаПо = ДобавитьМесяц(ДатаУПД, ПоискПоступленияМесяцевВперёд());
	Кандидаты = НайтиПоступленияДляУПД(Входящий.Номер, ДатаУПД, Входящий.ИННПродавца, Организация);

	Если Кандидаты.Количество() = 0 Тогда
		Итог.Причина = "поступление не найдено: №" + Входящий.Номер + " от " + Входящий.Дата
			+ ", ИНН " + Входящий.ИННПродавца
			+ ", окно " + Формат(ДатаС, "ДФ=dd.MM.yyyy") + "-" + Формат(ДатаПо, "ДФ=dd.MM.yyyy");
		Итог.КраткаяПричина = "поступление не найдено";
		ДобавитьЗаписьЖурналаСверкиВходящих(Входящий, Организация, Итог);
		Возврат Итог;
	КонецЕсли;

	Если Кандидаты.Количество() > 1 Тогда
		Список = Новый Массив;
		Для Каждого Кандидат Из Кандидаты Цикл
			Список.Добавить(Строка(Кандидат.Ссылка));
		КонецЦикла;
		Итог.Причина = "найдено несколько поступлений: " + СтрСоединить(Список, "; ");
		Итог.КраткаяПричина = "несколько поступлений: " + Формат(Кандидаты.Количество(), "ЧГ=0");
		ДобавитьЗаписьЖурналаСверкиВходящих(Входящий, Организация, Итог);
		Возврат Итог;
	КонецЕсли;

	// Ровно один кандидат - сверяем и всегда пишем результат в его свойства.
	Кандидат = Кандидаты[0];
	Итог.Поступление = Кандидат.Ссылка;
	Отклонение = Кандидат.СуммаДокумента - Итог.СуммаУПД;
	Итог.ОтклонениеСуммы = Отклонение;

	Ошибки = Новый Массив;
	Если НЕ Кандидат.Проведен Тогда
		// Непроведённое - отдельный отказ, остальные проверки для него не имеют смысла.
		Ошибки.Добавить("поступление не проведено");
	Иначе
		Допуск = ДопускСуммыУПД();
		Если Макс(Отклонение, -Отклонение) > Допуск Тогда
			Ошибки.Добавить("сумма с НДС: в базе " + Формат(Кандидат.СуммаДокумента, "ЧДЦ=2; ЧРГ=")
				+ ", в УПД " + Формат(Итог.СуммаУПД, "ЧДЦ=2; ЧРГ=")
				+ ", разница " + Формат(Отклонение, "ЧДЦ=2; ЧРГ="));
		КонецЕсли;

		ЭтоИП = Ложь;
		Попытка
			ЭтоИП = (Организация.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо);
		Исключение
			ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "СверитьВходящийУПД: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
			ЭтоИП = Ложь;   // не разобрались - считаем юрлицом, сверяем НДС строже
		КонецПопытки;

		Если НЕ ЭтоИП Тогда
			СуммаНДСДок = Кандидат.Ссылка.Товары.Итог("СуммаНДС");
			Если Метаданные.Документы.ПоступлениеТоваровУслуг.ТабличныеЧасти.Найти("Услуги") <> Неопределено Тогда
				СуммаНДСДок = СуммаНДСДок + Кандидат.Ссылка.Услуги.Итог("СуммаНДС");
			КонецЕсли;
			ОтклонениеНДС = СуммаНДСДок - Итог.СуммаНДСУПД;
			Если Макс(ОтклонениеНДС, -ОтклонениеНДС) > Допуск Тогда
				Ошибки.Добавить("сумма НДС: в базе " + Формат(СуммаНДСДок, "ЧДЦ=2; ЧРГ=")
					+ ", в УПД " + Формат(Итог.СуммаНДСУПД, "ЧДЦ=2; ЧРГ="));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Итог.Сошлось = (Ошибки.Количество() = 0);
	Если НЕ Итог.Сошлось Тогда
		Итог.Причина = СтрСоединить(Ошибки, "; ");
		Итог.КраткаяПричина = Лев(Итог.Причина, 50);
	КонецЕсли;

	ЗаписатьРезультатСверкиВПоступление(Кандидат.Ссылка, Входящий.Ид, Отклонение, Итог.КраткаяПричина);
	ДобавитьЗаписьЖурналаСверкиВходящих(Входящий, Организация, Итог);
	Возврат Итог;

КонецФункции

// Поступления, подходящие под входящий УПД: организация, все карточки контрагента с ИНН
// продавца, окно дат вокруг даты УПД (настройки ПоискПоступленияМесяцевНазад/Вперёд) и
// совпадение номера входящего документа после нормализации (см. НормализованныйНомерДокумента).
// В запросе номер не сравнить - нормализация делается в коде по выборке за окно.
// Возврат: Массив структур (Ссылка, СуммаДокумента, Проведен). Экспорт - для проверки
// подбора на данных базы без обращения к оператору.
Функция НайтиПоступленияДляУПД(Знач Номер, Знач ДатаУПД, Знач ИНН, Знач Организация) Экспорт

	ДатаС  = ДобавитьМесяц(ДатаУПД, -ПоискПоступленияМесяцевНазад());
	ДатаПо = ДобавитьМесяц(ДатаУПД, ПоискПоступленияМесяцевВперёд());

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Поступление.Ссылка КАК Ссылка,
		|	Поступление.СуммаДокумента КАК СуммаДокумента,
		|	Поступление.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
		|	Поступление.Проведен КАК Проведен
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК Поступление
		|ГДЕ
		|	Поступление.Организация = &Организация
		|	И Поступление.Контрагент.ИНН = &ИНН
		|	И НЕ Поступление.ПометкаУдаления
		|	И Поступление.Дата МЕЖДУ &ДатаС И &ДатаПо");
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИНН", СокрЛП(ИНН));
	Запрос.УстановитьПараметр("ДатаС", НачалоДня(ДатаС));
	Запрос.УстановитьПараметр("ДатаПо", КонецДня(ДатаПо));

	НомерНормализован = НормализованныйНомерДокумента(Номер);
	Кандидаты = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НормализованныйНомерДокумента(Выборка.НомерВходящегоДокумента) = НомерНормализован Тогда
			Кандидаты.Добавить(Новый Структура("Ссылка, СуммаДокумента, Проведен",
				Выборка.Ссылка, Выборка.СуммаДокумента, Выборка.Проведен));
		КонецЕсли;
	КонецЦикла;
	Возврат Кандидаты;

КонецФункции

// Итоги из XML УПД (формат ФНС 5.01/5.02/5.03): сумма с НДС всего и сумма НДС всего.
// Возврат: Структура (Найдено Булево, СуммаСНДС Число, СуммаНДС Число, БезНДС Булево).
Функция ИтогиИзXMLУПД(Знач ДвоичныеДанные) Экспорт

	Итог = Новый Структура("Найдено, СуммаСНДС, СуммаНДС, БезНДС", Ложь, 0, 0, Ложь);
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат Итог;
	КонецЕсли;

	Попытка
		Поток = ДвоичныеДанные.ОткрытьПотокДляЧтения();
		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьПоток(Поток);

		Глубина = 0;
		ВВсегоОпл = Ложь;
		ГлубинаВсегоОпл = 0;
		ВСумНалВсего = Ложь;
		ГлубинаСумНалВсего = 0;
		ОжидаетсяТекстСумНал = Ложь;

		Пока Чтение.Прочитать() Цикл
			Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				Глубина = Глубина + 1;
				Если НЕ ВВсегоОпл И Чтение.Имя = "ВсегоОпл" Тогда
					ВВсегоОпл = Истина;
					ГлубинаВсегоОпл = Глубина;
					Атрибут = Чтение.ПолучитьАтрибут("СтТовУчНалВсего");
					Если ЗначениеЗаполнено(Атрибут) Тогда
						Попытка
							Итог.СуммаСНДС = Число(СтрЗаменить(Атрибут, ",", "."));
							Итог.Найдено = Истина;
						Исключение
							ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ИтогиИзXMLУПД: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
							Итог.Найдено = Ложь; // сумма не число - итоги из УПД не берём
						КонецПопытки;
					КонецЕсли;
				ИначеЕсли ВВсегоОпл И НЕ ВСумНалВсего И Чтение.Имя = "СумНалВсего" Тогда
					ВСумНалВсего = Истина;
					ГлубинаСумНалВсего = Глубина;
				ИначеЕсли ВСумНалВсего И Чтение.Имя = "СумНал" Тогда
					ОжидаетсяТекстСумНал = Истина;
				ИначеЕсли ВСумНалВсего И Чтение.Имя = "БезНДС" Тогда
					Итог.БезНДС = Истина;
					Итог.СуммаНДС = 0;
				КонецЕсли;
			ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
				Если ОжидаетсяТекстСумНал Тогда
					Попытка
						Итог.СуммаНДС = Число(СтрЗаменить(СокрЛП(Чтение.Значение), ",", "."));
					Исключение
						ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ИтогиИзXMLУПД: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
						Итог.СуммаНДС = 0; // НДС не число - считаем нулём, как при «без НДС»
					КонецПопытки;
				КонецЕсли;
			ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
				Если ОжидаетсяТекстСумНал И Чтение.Имя = "СумНал" Тогда
					ОжидаетсяТекстСумНал = Ложь;
				КонецЕсли;
				Если ВСумНалВсего И Глубина = ГлубинаСумНалВсего Тогда
					ВСумНалВсего = Ложь;
				КонецЕсли;
				ЗакрытоВсегоОпл = ВВсегоОпл И Глубина = ГлубинаВсегоОпл;
				Глубина = Глубина - 1;
				Если ЗакрытоВсегоОпл Тогда
					Прервать;   // нужный блок дочитан целиком, дальше не смотрим
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Чтение.Закрыть();
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ИтогиИзXMLУПД: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат Итог;
	КонецПопытки;

	Возврат Итог;

КонецФункции

// Номер документа без разделителей, регистра и ведущих нулей - для сравнения "1-234" с "0001234".
Функция НормализованныйНомерДокумента(Знач Номер)

	Текст = ВРег(СокрЛП(Строка(Номер)));
	Результат = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если (Символ >= "0" И Символ <= "9") ИЛИ (Символ >= "A" И Символ <= "Z")
			ИЛИ (Символ >= "А" И Символ <= "Я") Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Пока СтрДлина(Результат) > 1 И Лев(Результат, 1) = "0" Цикл
		Результат = Сред(Результат, 2);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Дата УПД из строки вида "2026-09-15" или "15.09.2026". Не разобралась - окно ищется
// от текущей даты: лучше широкое окно, чем упавший регламент.
Функция ДатаИзСтрокиУПД(Знач Текст)

	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат ТекущаяДатаСеанса();
	КонецЕсли;

	Разобранная = ДатаИзДДММГГГГ(Текст);
	Если Разобранная <> '00010101' Тогда
		Возврат Разобранная;
	КонецЕсли;

	Разобранная = ДатаИзМеткиВремени(Текст);
	Если Разобранная <> '00010101' Тогда
		Возврат Разобранная;
	КонецЕсли;

	Возврат ТекущаяДатаСеанса();

КонецФункции

// Записать результат сверки в свойства поступления. Свойства ищутся точным именем -
// если не заведены (старая база до ОбеспечитьСвойстваОбъектов), запись просто пропускается.
Процедура ЗаписатьРезультатСверкиВПоступление(Знач Поступление, Знач ИдВходящего, Знач Отклонение, Знач КраткаяПричина)

	СвИдентификатор = СвойствоОбъектов("ЭДО_ВходящийИдентификатор");
	Если СвИдентификатор <> Неопределено И НЕ СвИдентификатор.Пустая() Тогда
		ЗаписатьЗначениеСвойства(Поступление, СвИдентификатор, Лев(ИдВходящего, 50));
	КонецЕсли;

	СвОтклонение = СвойствоОбъектов("ЭДО_ОтклонениеСуммы");
	Если СвОтклонение <> Неопределено И НЕ СвОтклонение.Пустая() Тогда
		ЗаписатьЗначениеСвойства(Поступление, СвОтклонение, Лев(Формат(Отклонение, "ЧДЦ=2; ЧРГ="), 50));
	КонецЕсли;

	СвПричина = СвойствоОбъектов("ЭДО_ПричинаНепринятия");
	Если СвПричина <> Неопределено И НЕ СвПричина.Пустая() Тогда
		ЗаписатьЗначениеСвойства(Поступление, СвПричина, Лев(КраткаяПричина, 50));
	КонецЕсли;

КонецПроцедуры

// Журнал сверки входящих УПД: ХранилищеОбщихНастроек, тот же приём, что у ЗагрузитьРеестрАдресов -
// ключ пустого пользователя, чтобы записи не зависели от того, чей сеанс выполнил регламент.
// Ключ карты - Ид входящего у оператора, значение - Структура одной сверки. Запись при каждом
// вызове СверитьВходящийУПД перезаписывает предыдущую по тому же Ид.
// Возврат: Соответствие (Ид -> Структура(Когда, Номер, Дата, ИННПродавца, Продавец,
// Организация, Поступление, Сошлось, ОтклонениеСуммы, Причина)).
Функция ЗагрузитьЖурналСверкиВходящих() Экспорт
	// Общие настройки лежат под пользователем "": для обычного пользователя это чужой слот, без привилегий - «Нарушение прав доступа».
	УстановитьПривилегированныйРежим(Истина);

	Значение = ХранилищеОбщихНастроек.Загрузить("ЭДО_ЖурналСверкиВходящих", "Записи", , "");
	Если ТипЗнч(Значение) <> Тип("Соответствие") Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	// Записи старше 90 дней при загрузке отбрасываются - журнал не должен расти без предела.
	Граница = ТекущаяДатаСеанса() - 90 * 86400;
	Очищенные = Новый Соответствие;
	Для Каждого КЗ Из Значение Цикл
		// ЩА 20.10.2026 [yan]: запись старого формата без «Когда» отбрасываем проверкой, а не перехватом.
		Когда = Неопределено;
		Если ТипЗнч(КЗ.Значение) = Тип("Структура") И КЗ.Значение.Свойство("Когда", Когда)
			И ТипЗнч(Когда) = Тип("Дата") И Когда >= Граница Тогда
			Очищенные.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Очищенные;

КонецФункции

Процедура ЗаписатьЖурналСверкиВходящих(Знач Записи)
	// Общие настройки лежат под пользователем "": для обычного пользователя это чужой слот, без привилегий - «Нарушение прав доступа».
	УстановитьПривилегированныйРежим(Истина);

	ХранилищеОбщихНастроек.Сохранить("ЭДО_ЖурналСверкиВходящих", "Записи", Записи,
		"журнал сверки входящих УПД", "");

КонецПроцедуры

// Добавить (или перезаписать по Ид) одну запись в журнал сверки. Ошибка журнала не должна
// ронять сам прогон принятия - сверка уже посчитана, журнал только для диагностики.
Процедура ДобавитьЗаписьЖурналаСверкиВходящих(Знач Входящий, Знач Организация, Знач Итог)

	Попытка
		Журнал = ЗагрузитьЖурналСверкиВходящих();
		Запись = Новый Структура(
			"Когда, Номер, Дата, ИННПродавца, Продавец, Организация, Поступление, Сошлось, ОтклонениеСуммы, Причина",
			ТекущаяДатаСеанса(), Входящий.Номер, Входящий.Дата, Входящий.ИННПродавца, Входящий.Продавец,
			Строка(Организация), ?(Итог.Поступление = Неопределено, "", Строка(Итог.Поступление)),
			Итог.Сошлось, Итог.ОтклонениеСуммы, Итог.Причина);
		Журнал.Вставить(Входящий.Ид, Запись);
		ЗаписатьЖурналСверкиВходящих(Журнал);
	Исключение
		ЗаписьЖР("ЭДО.СверкаВходящих", "Предупреждение", , , "Не записан журнал сверки: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ЗагрузкаВходящих

// Входящие УПД у оператора за период: по всем учетным записям базы или по одной организации.
// Берутся карточки титула продавца (NEW_SELLER_TITLE), где покупатель - организация учетной
// записи. Документ - созданный по входящему документ базы (свойство ЭДО_ВходящийИдентификатор).
// Выдача отбирается по получателю (recipient_id); окно - до 30 дней (оператор принимает не больше 31),
// при 1000 карточках в окне (потолок выдачи) окно делится пополам.
// Ошибка оператора по одной организации не обрывает список: текст уходит в Ошибки (Массив строк).
// Возврат: Массив Структура (Ид, Номер, Дата, ИННПродавца, Продавец, ИННПокупателя, Статус,
// Функция, Организация, Документ).
Функция ВходящиеУПДЗаПериод(Знач Начало, Знач Конец, Знач Организация = Неопределено, Ошибки = Неопределено) Экспорт

	Итог = Новый Массив;
	ОбщийЯщик = ВРег(СокрЛП(Строка(НастройкаЭДО("ОбщийЯщикВходящих")))) = "ДА";   // ЩА 13.10.2026 [yan]
	Пройдены = Новый Соответствие;
	// ++ ЩА 12.10.2026 [yan]: у организаций базы бывает общий ящик оператора - выдача по любой учетной
	//    записи содержит карточки всех. Если это подтверждено настройкой ОбщийЯщикВходящих (ревью Codex
	//    539: по встреченному ИНН общий ящик не доказать), список берется один раз и раздается по ИНН
	//    покупателя; учетная запись, чья организация не встретилась покупателем при полностью
	//    прочитанной выдаче, опрашивается отдельно. Без настройки - каждая запись сама, как прежде. Несколько карточек организаций с одним ИНН (разные КПП) по ИНН не
	//    различить - их карточки раздаются только своему запросу, как до общего прохода.
	ОрганизацииПоИНН = Новый Соответствие;   // ИНН -> Массив организаций базы
	Для Каждого Запись Из УчетныеЗаписиЭДО() Цикл
		Если ЗначениеЗаполнено(Запись.Организация) И (НЕ ЗначениеЗаполнено(Организация) ИЛИ Запись.Организация = Организация) Тогда
			ИНН = СокрЛП(Запись.Организация.ИНН);
			Кандидаты = ОрганизацииПоИНН.Получить(ИНН);
			Если Кандидаты = Неопределено Тогда
				Кандидаты = Новый Массив;
				ОрганизацииПоИНН.Вставить(ИНН, Кандидаты);
			КонецЕсли;
			Если Кандидаты.Найти(Запись.Организация) = Неопределено Тогда
				Кандидаты.Добавить(Запись.Организация);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Видимые = Новый Соответствие;   // Ид карточки и организация -> Истина: без повторов из общего ящика
	Покрытые = Новый Соответствие;   // ИНН организаций (единственных с этим ИНН), чьи карточки пришли полностью
	// -- ЩА 12.10.2026 [yan].
	Для Каждого Запись Из УчетныеЗаписиЭДО() Цикл
		Если НЕ ЗначениеЗаполнено(Запись.Организация) ИЛИ Пройдены.Получить(Запись.Организация) <> Неопределено
			ИЛИ ЗначениеЗаполнено(Организация) И Запись.Организация <> Организация
			ИЛИ Покрытые.Получить(СокрЛП(Запись.Организация.ИНН)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Пройдены.Вставить(Запись.Организация, Истина);
		Попытка
			ДобавитьВходящиеЗаПериод(Итог, Начало, Конец, Запись.Организация, ОрганизацииПоИНН, Видимые, Покрытые, ОбщийЯщик);
		Исключение
			Если Ошибки = Неопределено Тогда
				ВызватьИсключение;
			КонецЕсли;
			Ошибки.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Идентификаторы = Новый Массив;
	Для Каждого Входящий Из Итог Цикл
		Идентификаторы.Добавить(Входящий.Ид);
	КонецЦикла;
	Связи = ДокументыПоВходящим(Идентификаторы);
	Непривязанные = Новый Массив;
	Для Каждого Входящий Из Итог Цикл
		Входящий.Документ = Связи.Получить(Входящий.Ид);
		Входящий.Вставить("Кандидаты", Новый Массив);   // ЩА 20.10.2026 [yan]
		// УКД к поступлению не привязывается: иначе ид УКД займет связь исходного поступления с его УПД.
		Если Входящий.Документ = Неопределено И НЕ Входящий.ЭтоУКД Тогда
			Непривязанные.Добавить(Входящий);
		КонецЕсли;
	КонецЦикла;
	// ЩА 20.10.2026 [yan]: поступление по УПД уже завел склад (по ТТН ЕГАИС тем же номером) - список это показывает,
	// чтобы второе не создали, а входящий привязали.
	Кандидаты = ДокументыКандидатыПоВходящим(Непривязанные);
	Для Каждого Входящий Из Непривязанные Цикл
		Найденные = Кандидаты.Получить(Входящий.Ид);
		Если Найденные <> Неопределено Тогда
			Входящий.Кандидаты = Найденные;
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// ОрганизацииПоИНН - организации базы, между которыми раздаются карточки общего ящика (ИНН -> Массив);
// Видимые - уже добавленные карточки (Ид и организация); Покрытые - ИНН организаций, чьи карточки
// пришли в полностью прочитанной выдаче: дополняется только после чтения всего периода без ошибки.
// ОбщийЯщик - Ложь: карточки других организаций не берутся и Покрытые не пополняется.
Процедура ДобавитьВходящиеЗаПериод(Итог, Знач Начало, Знач Конец, Знач Организация, Знач ОрганизацииПоИНН,
	Видимые, Покрытые, Знач ОбщийЯщик)

	ПокрытыеЗдесь = Новый Соответствие;
	ИННОрганизации = СокрЛП(Организация.ИНН);
	// ++ ЩА 13.10.2026 [yan]: ящик оператора общий для всех организаций сети - без отбора по получателю
	//    выдача несет чужие карточки, упирается в потолок 1000 и срезает свои (Олимп-трейд за 8 дней:
	//    268 своих из 295). С recipient_id приходят только свои, и окно можно брать до 30 дней.
	//    Без идентификатора организации у оператора - прежнее окно в сутки без отбора.
	ГидПолучателя = СокрЛП(ГидОрганизации(Организация));
	ОтборПолучателя = ?(ЗначениеЗаполнено(ГидПолучателя), "&recipient_id=" + ГидПолучателя, "");
	ДлинаОкна = ?(ЗначениеЗаполнено(ОтборПолучателя), 30, 1) * 86400;
	// -- ЩА 13.10.2026 [yan].
	// ЩА 20.10.2026 [yan]: кроме УПД - и корректировки (УКД), у них свой тип списка.
	ДлинаОкнаТипа = ДлинаОкна;
	Для Каждого ТипСписка Из СтрРазделить("NEW_SELLER_TITLE,NEW_COR_SELLER_TITLE", ",") Цикл
	ЭтоУКД = (ТипСписка = "NEW_COR_SELLER_TITLE");
	ДлинаОкна = ДлинаОкнаТипа;
	Граница = НачалоДня(Конец) + 86400;
	Пока Граница > НачалоДня(Начало) Цикл
		НачалоОкна = Макс(НачалоДня(Начало), Граница - ДлинаОкна);   // ЩА 13.10.2026 [yan]
		// ЩА 13.10.2026 [yan]: оператор отдает не больше 1000 карточек на запрос (страница 10 при размере
		// 100 - ответ 400). Десять полных страниц - окно переполнено: делим его и читаем заново,
		// повторы отсекает Видимые.
		Переполнено = Ложь;
		Для Страница = 0 По 9 Цикл
			Путь = "/public/api/v3/documents?type=" + ТипСписка
				+ "&created_from=" + Формат(НачалоОкна, "ДФ=yyyy-MM-ddTHH:mm:ss.000Z")
				+ "&created_till=" + Формат(Граница, "ДФ=yyyy-MM-ddTHH:mm:ss.000Z")
				+ ОтборПолучателя
				+ "&page=" + Формат(Страница, "ЧН=0; ЧГ=0") + "&page_size=100";
			Ответ = ЗапросКОператоруЭДО("GET", Путь, , Организация);
			Если Ответ.Код <> 200 Тогда
				ВызватьИсключение Строка(Организация) + ": список входящих не получен, HTTP " + Ответ.Код + " "
					+ Лев(Ответ.Текст, 200);
			КонецЕсли;
			Карточки = ПрочитатьОтветJSON(Ответ.Текст);
			// ЩА 12.10.2026 [yan], ревью Codex 538: не массив - неверный ответ, а не конец выдачи: иначе
			// неполный список засчитался бы прочитанным и другие учетные записи не опросились бы.
			Если ТипЗнч(Карточки) <> Тип("Массив") Тогда
				ВызватьИсключение Строка(Организация) + ": неверный ответ оператора на список входящих - "
					+ Лев(Ответ.Текст, 200);
			КонецЕсли;
			Для Каждого Карточка Из Карточки Цикл
				Счет = Карточка.Получить("invoice");
				Если ТипЗнч(Счет) <> Тип("Соответствие") Тогда
					Продолжить;
				КонецЕсли;
				Продавец = Счет.Получить("seller");
				Покупатель = Счет.Получить("buyer");
				ИННПокупателя = ?(ТипЗнч(Покупатель) = Тип("Соответствие"), СокрЛП(Строка(Покупатель.Получить("inn"))), "");
				// ++ ЩА 12.10.2026 [yan], ревью Codex 536: карточка другой нашей организации в общем ящике - ей же,
				//    если организация с этим ИНН одна; при нескольких - только своему запросу.
				Кандидаты = ?(ЗначениеЗаполнено(ИННПокупателя), ОрганизацииПоИНН.Получить(ИННПокупателя), Неопределено);
				Если НЕ ЗначениеЗаполнено(ИННПокупателя) Тогда
					ОрганизацияКарточки = Организация;
				ИначеЕсли Кандидаты = Неопределено Тогда
					Продолжить;   // покупатель - не организация из списка
				ИначеЕсли Кандидаты.Количество() = 1 И (ОбщийЯщик ИЛИ Кандидаты[0] = Организация) Тогда
					ОрганизацияКарточки = Кандидаты[0];
					ПокрытыеЗдесь.Вставить(ИННПокупателя, Истина);
				ИначеЕсли Кандидаты.Найти(Организация) <> Неопределено Тогда
					ОрганизацияКарточки = Организация;
				Иначе
					Продолжить;
				КонецЕсли;
				Ид = ЭДО_Регламенты.ИдентификаторСтрокой(Карточка.Получить("id"));
				КлючКарточки = Ид + "|" + XMLСтрока(ОрганизацияКарточки);
				Если Видимые.Получить(КлючКарточки) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Видимые.Вставить(КлючКарточки, Истина);
				// -- ЩА 12.10.2026 [yan].
				Статус = Карточка.Получить("newStatus");
				Если Статус = Неопределено Тогда
					Статус = Карточка.Получить("status");
				КонецЕсли;
				Входящий = Новый Структура("Ид, Номер, Дата, ИННПродавца, Продавец, ИННПокупателя, Статус, Функция, Организация, Документ",
					Ид,
					СокрЛП(Строка(Счет.Получить("num"))),
					ДатаИзСтрокиУПД(СокрЛП(Строка(Счет.Получить("date")))),
					?(ТипЗнч(Продавец) = Тип("Соответствие"), СокрЛП(Строка(Продавец.Получить("inn"))), ""),
					ПредставлениеСтороныСчета(Продавец),
					ИННПокупателя,
					ВРег(СокрЛП(Строка(Статус))),
					СокрЛП(Строка(Счет.Получить("function"))),
					ОрганизацияКарточки,
					Неопределено);
				// ЩА 20.10.2026 [yan]: для карточки входящего - вид, версия формата и гид продавца (ответы ему).
				Отправитель = Карточка.Получить("sender");
				Входящий.Вставить("ЭтоУКД", ЭтоУКД);
				Входящий.Вставить("Вид", ВидВходящегоДокумента(Входящий.Функция, ЭтоУКД));
				Входящий.Вставить("Версия", СокрЛП(Строка(Карточка.Получить("version"))));
				Входящий.Вставить("ГидПродавца", ?(ТипЗнч(Отправитель) = Тип("Соответствие"), СокрЛП(Строка(Отправитель.Получить("id"))), ""));
				Итог.Добавить(Входящий);
			КонецЦикла;
			Если Карточки.Количество() < 100 Тогда
				Прервать;
			КонецЕсли;
			Переполнено = (Страница = 9);   // ЩА 13.10.2026 [yan]
		КонецЦикла;
		// ++ ЩА 13.10.2026 [yan]
		Если Переполнено Тогда
			Если Граница - НачалоОкна <= 3600 Тогда
				ВызватьИсключение Строка(Организация) + ": больше 1000 входящих за час с "
					+ Формат(НачалоОкна, "ДФ='dd.MM.yyyy HH:mm'") + " - список неполный";
			КонецЕсли;
			ДлинаОкна = Макс(3600, Цел((Граница - НачалоОкна) / 2));
			Продолжить;
		КонецЕсли;
		// -- ЩА 13.10.2026 [yan].
		Граница = НачалоОкна;
	КонецЦикла;
	КонецЦикла;   // ЩА 20.10.2026 [yan]: типы списка
	// ЩА 12.10.2026 [yan], ревью Codex 536: период прочитан целиком - организации, чьи карточки пришли,
	// второй раз не опрашиваются; своя - если она единственная с этим ИНН.
	Кандидаты = ОрганизацииПоИНН.Получить(ИННОрганизации);
	Если Кандидаты <> Неопределено И Кандидаты.Количество() = 1 Тогда
		ПокрытыеЗдесь.Вставить(ИННОрганизации, Истина);
	КонецЕсли;
	Если ОбщийЯщик Тогда
		Для Каждого Пара Из ПокрытыеЗдесь Цикл
			Покрытые.Вставить(Пара.Ключ, Истина);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// XML титула продавца входящего документа. Ошибка оператора - исключение.
Функция СодержимоеВходящегоДокумента(Знач Ид, Знач Организация) Экспорт

	Ответ = ЗапросКОператоруЭДО("GET", "/public/api/v3/documents/" + Ид + "/content", , Организация);
	Если Ответ.Код <> 200 Тогда
		ВызватьИсключение "XML входящего документа не получен, HTTP " + Ответ.Код + " " + Лев(Ответ.Текст, 200);
	КонецЕсли;
	Возврат Ответ.Данные;

КонецФункции

// Документы базы, созданные по входящим (свойство ЭДО_ВходящийИдентификатор).
// Возврат: Соответствие (Ид входящего -> ссылка на документ).
Функция ДокументыПоВходящим(Знач Идентификаторы) Экспорт

	Итог = Новый Соответствие;
	Свойство = СвойствоОбъектов("ЭДО_ВходящийИдентификатор");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() ИЛИ Идентификаторы.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Значения.Объект КАК Объект,
		|	ВЫРАЗИТЬ(Значения.Значение КАК СТРОКА(50)) КАК Ид
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК Значения
		|ГДЕ
		|	Значения.Свойство = &Свойство
		|	И ВЫРАЗИТЬ(Значения.Значение КАК СТРОКА(50)) В (&Идентификаторы)");
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Итог.Вставить(СокрЛП(Выборка.Ид), Выборка.Объект);
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Создать документ базы по входящему документу оператора: скачать XML, разобрать, заполнить
// документ (профиль или реализация по умолчанию), записать без проведения и связать с входящим.
// Уже созданный по этому входящему документ второй раз не создается.
// Возврат: Структура (Успех, Документ, Текст, Сообщения - Массив строк для пользователя).
Функция СоздатьДокументПоВходящему(Знач Ид, Знач Организация, Знач СтатусКарточки = "") Экспорт

	// ЩА 15.10.2026 [yan]: отклоненный или аннулированный УПД не действует - поступление по нему было бы лишним.
	Если ЗначениеЗаполнено(СтатусКарточки) И НЕ КарточкаЖивая(СтатусКарточки, "") Тогда
		Итог = НовыйИтогСозданияПоВходящему();
		Итог.Текст = "Документ не создан: входящий у оператора в статусе " + СтатусКарточки
			+ " (отклонен или аннулирован)";
		Возврат Итог;
	КонецЕсли;
	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить(Ид);
	Созданный = ДокументыПоВходящим(Идентификаторы).Получить(Ид);
	Если Созданный <> Неопределено Тогда
		Итог = НовыйИтогСозданияПоВходящему();
		Итог.Успех = Истина;
		Итог.Документ = Созданный;
		Итог.Текст = "По этому входящему документ уже создан: " + Строка(Созданный);
		Возврат Итог;
	КонецЕсли;
	Возврат СоздатьДокументПоXML(СодержимоеВходящегоДокумента(Ид, Организация), Организация, Ид);

КонецФункции

// То же по готовому XML (тесты, загрузка из файла). Организация пустая - по ИНН покупателя.
Функция СоздатьДокументПоXML(Знач Данные, Знач Организация = Неопределено, Знач ИдВходящего = "") Экспорт

	Итог = НовыйИтогСозданияПоВходящему();
	Созданный = ДокументПоВходящему(ИдВходящего);
	Если Созданный <> Неопределено Тогда
		Итог.Успех = Истина;
		Итог.Документ = Созданный;
		Итог.Текст = "По этому входящему документ уже создан: " + Строка(Созданный);
		Возврат Итог;
	КонецЕсли;
	Разбор = ЭДО_ВходящиеДокументы.РазобратьУПД(Данные);
	Для Каждого Предупреждение Из Разбор.Предупреждения Цикл
		Итог.Сообщения.Добавить(Предупреждение);
	КонецЦикла;
	Если НЕ ЗначениеЗаполнено(Организация) И Разбор.Покупатель <> Неопределено Тогда
		Организация = ЭДО_ВходящиеДокументы.ОрганизацияПоИНН(Разбор.Покупатель.ИНН, Разбор.Покупатель.КПП, Итог.Сообщения);
	ИначеЕсли ЗначениеЗаполнено(Организация) И Разбор.Покупатель <> Неопределено
		И ЗначениеЗаполнено(Разбор.Покупатель.ИНН) И СокрЛП(Разбор.Покупатель.ИНН) <> СокрЛП(Организация.ИНН) Тогда
		// ЩА 15.10.2026 [yan]: строка списка могла достаться не той организации общего ящика - покупатель в XML главнее.
		Итог.Текст = "Документ не создан: покупатель в УПД (ИНН " + Разбор.Покупатель.ИНН + ") - не "
			+ Строка(Организация);
		Возврат Итог;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Итог.Текст = "Не найдена организация-покупатель (ИНН " + ?(Разбор.Покупатель = Неопределено, "",
			Разбор.Покупатель.ИНН) + ")";
		Возврат Итог;
	КонецЕсли;

	// ЩА 20.10.2026 [yan]: поступление по этому УПД уже завел склад (по ТТН ЕГАИС, номер входящего = номер УПД) -
	// привязать входящий к нему, а не создавать второе (случай СЛАА000000764/768). Подходящих несколько -
	// решает человек командой «Привязать к поступлению».
	Если ЗначениеЗаполнено(ИдВходящего) И Разбор.Продавец <> Неопределено И ЗначениеЗаполнено(Разбор.Продавец.ИНН) Тогда
		Входящие = Новый Массив;
		Входящие.Добавить(Новый Структура("Ид, Организация, ИННПродавца, Номер, Дата",
			СокрЛП(ИдВходящего), Организация, Разбор.Продавец.ИНН, Разбор.Номер, Разбор.Дата));
		Имеющиеся = ДокументыКандидатыПоВходящим(Входящие).Получить(СокрЛП(ИдВходящего));
		Если Имеющиеся <> Неопределено И Имеющиеся.Количество() = 1
			И ПоступлениеСовпадаетСУПД(Имеющиеся[0], Разбор) Тогда
			Привязка = ПривязатьВходящийКДокументу(ИдВходящего, Организация, Имеющиеся[0], , Разбор);
			Для Индекс = 0 По Итог.Сообщения.ВГраница() Цикл
				Привязка.Сообщения.Вставить(Индекс, Итог.Сообщения[Индекс]);
			КонецЦикла;
			Возврат Привязка;
		ИначеЕсли Имеющиеся <> Неопределено Тогда
			Представления = Новый Массив;
			Для Каждого Имеющийся Из Имеющиеся Цикл
				Представления.Добавить(Строка(Имеющийся));
			КонецЦикла;
			Итог.Текст = "Документ не создан: с номером " + Разбор.Номер + " уже есть " + СтрСоединить(Представления, ", ")
				+ ?(Имеющиеся.Количество() = 1, " (дата входящего и сумма с УПД не совпадают)", "")
				+ " - привяжите УПД к нужному командой «Привязать к поступлению»";
			Возврат Итог;
		КонецЕсли;
	КонецЕсли;

	Параметры = Новый Структура("Разбор, Организация, ИдВходящего, ДокументОбъект, Сообщения, СтандартнаяОбработка",
		Разбор, Организация, ИдВходящего, Неопределено, Итог.Сообщения, Истина);
	ВызватьНеобязательнуюТочкуПрофиля("ПриСозданииДокументаПоВходящему", Параметры);
	Если Параметры.СтандартнаяОбработка Тогда
		ЭДО_ВходящиеДокументы.ЗаполнитьПоступлениеПоУмолчанию(Параметры);
	КонецЕсли;
	Если Параметры.ДокументОбъект = Неопределено Тогда
		Итог.Текст = "Документ не создан" + ?(Итог.Сообщения.Количество() > 0, ": " + Итог.Сообщения[Итог.Сообщения.Количество() - 1], "");
		Возврат Итог;
	КонецЕсли;
	ВызватьНеобязательнуюТочкуПрофиля("ПередЗаписьюДокументаПоВходящему", Параметры);

	// Документ и связь с входящим пишутся одной транзакцией под исключительной блокировкой
	// свойства связи: два одновременных нажатия (или повтор после сбоя записи свойства) иначе
	// создали бы два поступления по одному УПД. Под блокировкой связь проверяется еще раз.
	Свойство = СвойствоОбъектов("ЭДО_ВходящийИдентификатор");
	СвязьЕсть = ЗначениеЗаполнено(ИдВходящего) И Свойство <> Неопределено И НЕ Свойство.Пустая();
	// ++ ЩА 12.10.2026 [yan], ревью Codex 525: без свойства связи повторная загрузка не увидит документ.
	Если ЗначениеЗаполнено(ИдВходящего) И НЕ СвязьЕсть Тогда
		Итог.Текст = "Документ не создан: нет свойства объектов ЭДО_ВходящийИдентификатор - без него повторная"
			+ " загрузка создала бы дубль (заведите свойства в настройках ЭДО)";
		Возврат Итог;
	КонецЕсли;
	// -- ЩА 12.10.2026 [yan].
	Созданный = Неопределено;
	Запрет = Неопределено;
	НачатьТранзакцию();
	Попытка
		Если СвязьЕсть Тогда
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить("РегистрСведений.ЗначенияСвойствОбъектов");
			Элемент.УстановитьЗначение("Свойство", Свойство);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			Созданный = ДокументПоВходящему(ИдВходящего);
			// ЩА 15.10.2026 [yan], ревью Codex 714: по входящему идет или прошло согласие на аннулирование -
			// не записывать, даже если создание началось раньше согласия (отметку ставят под этим же замком).
			Запрет = ЗапретСозданияПоВходящему(ИдВходящего);
		КонецЕсли;
		Если Созданный = Неопределено И Запрет = Неопределено Тогда
			Параметры.ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			Если СвязьЕсть Тогда
				ЗаписатьЗначениеСвойства(Параметры.ДокументОбъект.Ссылка, Свойство, Лев(ИдВходящего, 50));
			КонецЕсли;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Если Созданный <> Неопределено Тогда
		Итог.Успех = Истина;
		Итог.Документ = Созданный;
		Итог.Текст = "По этому входящему документ уже создан: " + Строка(Созданный);
		Возврат Итог;
	КонецЕсли;
	Если Запрет <> Неопределено Тогда
		Итог.Текст = "Документ не создан: по входящему " + Запрет.Состояние + " (с "
			+ Формат(Запрет.Когда, "ДФ='dd.MM.yyyy HH:mm'") + ") - поступление по аннулируемому документу не создается";
		Возврат Итог;
	КонецЕсли;
	Итог.Документ = Параметры.ДокументОбъект.Ссылка;
	Итог.Успех = Истина;
	Итог.Текст = "Создан " + Строка(Итог.Документ) + ?(Итог.Сообщения.Количество() > 0,
		", замечаний: " + Итог.Сообщения.Количество(), "");
	Возврат Итог;

КонецФункции

// ++ ЩА 15.10.2026 [yan], ревью Codex 714: отметка «по входящему идет/прошло согласие на аннулирование».
// Ставит ее регламент согласия под исключительной блокировкой свойства ЭДО_ВходящийИдентификатор (той же,
// под которой СоздатьДокументПоXML проверяет и пишет поступление), снимает - если согласие не состоялось.
// Одна запись хранилища на входящий: замок держится только на проверку и запись, сеть - вне его.
Функция КлючЗапретаСоздания(Знач Ид)
	Возврат "ЗапретСозданияПоВходящему_" + СокрЛП(Ид);
КонецФункции

// Возврат: Неопределено или Структура (Состояние, Когда).
Функция ЗапретСозданияПоВходящему(Знач Ид) Экспорт
	Если НЕ ЗначениеЗаполнено(Ид) Тогда
		Возврат Неопределено;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Значение = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", КлючЗапретаСоздания(Ид), , "");
	Возврат ?(ТипЗнч(Значение) = Тип("Структура"), Значение, Неопределено);
КонецФункции

// Ревью Codex 716: отметка принадлежит попытке согласия (ИдПопытки - уникальный идентификатор). Захват и
// завершение - под тем же исключительным замком свойства ЭДО_ВходящийИдентификатор, что и запись
// поступления в СоздатьДокументПоXML. Правила:
// - поступление по входящему уже есть - не захватывается (решает человек);
// - «дано согласие на аннулирование» - навсегда: не перезаписывается и не снимается;
// - чужая незавершенная попытка моложе МинутПопыткиАннулирования - не захватывается (идет параллельно);
//   старше - это неизвестный исход прошлой попытки: захватывается заново, запрет при этом не исчезает ни на миг;
// - снять отметку может только ее попытка и только при достоверном «согласия нет» (наш отказ в цепочке ПОА).
// Возврат: Структура (Захвачен, ИдПопытки, Причина).
Функция ЗахватитьВходящийДляАннулирования(Знач Ид, Знач ИдПОА) Экспорт

	Итог = Новый Структура("Захвачен, ИдПопытки, Причина", Ложь, "", "");
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьСвязиВходящих();
		Созданный = ДокументПоВходящему(Ид);
		Отметка = ЗапретСозданияПоВходящему(Ид);
		Если Созданный <> Неопределено Тогда
			Итог.Причина = "по документу создано " + Строка(Созданный);
		ИначеЕсли Отметка <> Неопределено И Отметка.Свойство("Дано") И Отметка.Дано Тогда
			Итог.Причина = "согласие на аннулирование уже дано " + Формат(Отметка.Когда, "ДФ='dd.MM.yyyy HH:mm'");
		ИначеЕсли Отметка <> Неопределено И ТекущаяДатаСеанса() - Отметка.Когда < МинутПопыткиАннулирования() * 60 Тогда
			Итог.Причина = "идет другая попытка согласия с " + Формат(Отметка.Когда, "ДФ='dd.MM.yyyy HH:mm'");
		Иначе
			Итог.ИдПопытки = Строка(Новый УникальныйИдентификатор);
			ЗаписатьОтметкуАннулирования(Ид, Новый Структура("Состояние, Когда, ИдПопытки, Дано",
				"идет согласие на аннулирование (запрос " + ИдПОА + ")", ТекущаяДатаСеанса(), Итог.ИдПопытки, Ложь));
			Итог.Захвачен = Истина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Итог;

КонецФункции

// Согласие = Истина - согласие подписано: отметка «дано» навсегда. Ложь - достоверно согласия нет:
// отметка снимается, только если она все еще этой попытки.
Процедура ЗавершитьПопыткуАннулирования(Знач Ид, Знач ИдПопытки, Знач ИдПОА, Знач Согласие) Экспорт

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьСвязиВходящих();
		Отметка = ЗапретСозданияПоВходящему(Ид);
		Если Согласие Тогда
			ЗаписатьОтметкуАннулирования(Ид, Новый Структура("Состояние, Когда, ИдПопытки, Дано",
				"дано согласие на аннулирование (запрос " + ИдПОА + ")", ТекущаяДатаСеанса(), ИдПопытки, Истина));
		ИначеЕсли Отметка <> Неопределено И Отметка.Свойство("ИдПопытки") И Отметка.ИдПопытки = ИдПопытки
			И НЕ (Отметка.Свойство("Дано") И Отметка.Дано) Тогда
			УстановитьПривилегированныйРежим(Истина);
			ХранилищеОбщихНастроек.Удалить("ОФД_ЭДО_НастройкиОбработки", КлючЗапретаСоздания(Ид), "");
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция МинутПопыткиАннулирования()
	Возврат 30;
КонецФункции

Процедура ЗаписатьОтметкуАннулирования(Знач Ид, Знач Отметка)
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", КлючЗапретаСоздания(Ид), Отметка, , "");
КонецПроцедуры

// Тот же замок, что у записи поступления по входящему. Без свойства связи поступление по входящему
// не создается вовсе (СоздатьДокументПоXML отказывает) - блокировать нечего.
Процедура ЗаблокироватьСвязиВходящих()
	Свойство = СвойствоОбъектов("ЭДО_ВходящийИдентификатор");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.ЗначенияСвойствОбъектов");
	Элемент.УстановитьЗначение("Свойство", Свойство);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
КонецПроцедуры
// -- ЩА 15.10.2026 [yan].

// Документ базы по одному входящему (Неопределено - не создан или Ид пустой).
Функция ДокументПоВходящему(Знач Ид)
	Если НЕ ЗначениеЗаполнено(Ид) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить(Ид);
	Возврат ДокументыПоВходящим(Идентификаторы).Получить(Ид);
КонецФункции

Функция НовыйИтогСозданияПоВходящему()
	Возврат Новый Структура("Успех, Документ, Текст, Сообщения", Ложь, Неопределено, "", Новый Массив);
КонецФункции

// ЩА 20.10.2026 [yan]: имеющиеся документы базы, подходящие к входящим и еще не связанные ни с одним
// входящим. ПоНомеру - см. ЭДО_ВходящиеДокументы.ПоступленияПоВходящим.
// Возврат: Соответствие (Ид входящего -> Массив ссылок).
Функция ДокументыКандидатыПоВходящим(Знач Входящие, Знач ПоНомеру = Истина) Экспорт
	Свойство = СвойствоОбъектов("ЭДО_ВходящийИдентификатор");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Возврат ЭДО_ВходящиеДокументы.ПоступленияПоВходящим(Входящие, ПоНомеру, Свойство);
КонецФункции

// Номера у поставщика повторяются, поэтому кроме номера нужна дата входящего или сумма УПД.
Функция ПоступлениеСовпадаетСУПД(Знач Документ, Знач Разбор)

	Если ЕстьРеквизитДокумента(Документ, "ДатаВходящегоДокумента") И ЗначениеЗаполнено(Разбор.Дата)
		И НачалоДня(Документ.ДатаВходящегоДокумента) = НачалоДня(Разбор.Дата) Тогда
		Возврат Истина;
	КонецЕсли;
	Если ЕстьРеквизитДокумента(Документ, "СуммаДокумента") И Разбор.СуммаСНДС <> 0 Тогда
		Расхождение = Документ.СуммаДокумента - Разбор.СуммаСНДС;
		Возврат Макс(Расхождение, -Расхождение) <= 0.01;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// ЩА 20.10.2026 [yan]: привязать входящий к уже имеющемуся документу базы (поступление склад завел по ТТН
// ЕГАИС раньше, чем пришел УПД) вместо создания второго. Строки и коды документа не меняются: его заполнял
// человек. Расхождение суммы и числа строк с УПД - в Сообщения. Связь пишется под тем же замком свойства
// ЭДО_ВходящийИдентификатор, что и в СоздатьДокументПоXML, с теми же проверками дубля и запрета.
// Разбор - уже разобранный УПД; Неопределено - скачать для сверки.
// Возврат: Структура (Успех, Документ, Текст, Сообщения).
Функция ПривязатьВходящийКДокументу(Знач Ид, Знач Организация, Знач Документ, Знач СтатусКарточки = "",
	Знач Разбор = Неопределено) Экспорт

	Итог = НовыйИтогСозданияПоВходящему();
	Ид = СокрЛП(Ид);
	Если ЗначениеЗаполнено(СтатусКарточки) И НЕ КарточкаЖивая(СтатусКарточки, "") Тогда
		Итог.Текст = "Не привязан: входящий у оператора в статусе " + СтатусКарточки + " (отклонен или аннулирован)";
		Возврат Итог;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Ид) ИЛИ НЕ ЗначениеЗаполнено(Документ) Тогда
		Итог.Текст = "Не привязан: не указан входящий или документ базы";
		Возврат Итог;
	КонецЕсли;
	Если ТипЗнч(Документ) <> Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		Итог.Текст = "Не привязан: " + Строка(Документ) + " - не поступление товаров и услуг";
		Возврат Итог;
	КонецЕсли;
	Если Документ.ПометкаУдаления Тогда
		Итог.Текст = "Не привязан: " + Строка(Документ) + " помечен на удаление";
		Возврат Итог;
	КонецЕсли;
	Если Разбор = Неопределено Тогда
		// Перехват обоснован: без УПД продавца не сверить - привязку не делаем, причину показываем.
		Попытка
			Разбор = ЭДО_ВходящиеДокументы.РазобратьУПД(СодержимоеВходящегоДокумента(Ид, Организация));
		Исключение
			ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , Документ,
				"Привязка УПД " + Ид + ": УПД не получен - " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Итог.Текст = "Не привязан: УПД не получен для сверки продавца - " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Возврат Итог;
		КонецПопытки;
	КонецЕсли;
	ИННПродавца = ?(Разбор.Продавец = Неопределено, "", СокрЛП(Разбор.Продавец.ИНН));
	ИННКонтрагента = СокрЛП(Документ.Контрагент.ИНН);
	Если НЕ ЗначениеЗаполнено(ИННПродавца) ИЛИ ИННПродавца <> ИННКонтрагента Тогда
		Итог.Текст = "Не привязан: продавец в УПД (ИНН " + ИННПродавца + ") - не контрагент документа "
			+ Строка(Документ.Контрагент) + " (ИНН " + ИННКонтрагента + ")";
		Возврат Итог;
	КонецЕсли;
	Если ЗначениеЗаполнено(Организация) И ЕстьРеквизитДокумента(Документ, "Организация")
		И Документ.Организация <> Организация Тогда
		Итог.Текст = "Не привязан: " + Строка(Документ) + " другой организации (" + Строка(Документ.Организация) + ")";
		Возврат Итог;
	КонецЕсли;
	Свойство = СвойствоОбъектов("ЭДО_ВходящийИдентификатор");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Итог.Текст = "Не привязан: нет свойства объектов ЭДО_ВходящийИдентификатор (заведите свойства в настройках ЭДО)";
		Возврат Итог;
	КонецЕсли;

	Привязанный = Неопределено;
	ДругойИд = "";
	Запрет = Неопределено;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.ЗначенияСвойствОбъектов");
		Элемент.УстановитьЗначение("Свойство", Свойство);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		Привязанный = ДокументПоВходящему(Ид);
		ДругойИд = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Документ, Свойство)));
		Запрет = ЗапретСозданияПоВходящему(Ид);
		Если Привязанный = Неопределено И НЕ ЗначениеЗаполнено(ДругойИд) И Запрет = Неопределено Тогда
			ЗаписатьЗначениеСвойства(Документ, Свойство, Лев(Ид, 50));
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Если Привязанный <> Неопределено Тогда
		Итог.Успех = (Привязанный = Документ);
		Итог.Документ = Привязанный;
		Итог.Текст = ?(Итог.Успех, "Уже привязан к ", "Не привязан: по этому входящему уже есть ") + Строка(Привязанный);
		Возврат Итог;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДругойИд) Тогда
		Итог.Текст = "Не привязан: " + Строка(Документ) + " уже связан с другим входящим (ид " + ДругойИд + ")";
		Возврат Итог;
	КонецЕсли;
	Если Запрет <> Неопределено Тогда
		Итог.Текст = "Не привязан: по входящему " + Запрет.Состояние + " (с "
			+ Формат(Запрет.Когда, "ДФ='dd.MM.yyyy HH:mm'") + ")";
		Возврат Итог;
	КонецЕсли;
	ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Информация, , Документ,
		"Входящий " + Ид + " привязан к имеющемуся документу");
	Итог.Успех = Истина;
	Итог.Документ = Документ;
	Итог.Текст = "Привязан к имеющемуся " + Строка(Документ);
	СверитьДокументСУПД(Документ, Ид, Организация, Разбор, Итог.Сообщения);
	Если Итог.Сообщения.Количество() > 0 Тогда
		Итог.Текст = Итог.Текст + ", замечаний: " + Итог.Сообщения.Количество();
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Сверка привязанного документа с УПД: сумма с НДС и число строк товаров. Только сообщения - документ
// заводил человек, исправлять его или нет, решает он.
Процедура СверитьДокументСУПД(Знач Документ, Знач Ид, Знач Организация, Знач Разбор, Сообщения)

	Если Разбор = Неопределено Тогда
		// Перехват обоснован: связь уже записана, сверка - подсказка. Сбой скачивания не прячем:
		// ЖР с подробностями и строка в сообщениях пользователю.
		Попытка
			Разбор = ЭДО_ВходящиеДокументы.РазобратьУПД(СодержимоеВходящегоДокумента(Ид, Организация));
		Исключение
			ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , Документ,
				"Сверка с УПД " + Ид + " не выполнена: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Сообщения.Добавить("Сверка с УПД не выполнена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат;
		КонецПопытки;
	КонецЕсли;
	Если ЕстьРеквизитДокумента(Документ, "СуммаДокумента") И Разбор.СуммаСНДС <> 0
		И Документ.СуммаДокумента <> Разбор.СуммаСНДС Тогда
		Сообщения.Добавить("Сумма документа " + Формат(Документ.СуммаДокумента, "ЧДЦ=2; ЧН=0") + " не равна сумме УПД "
			+ Формат(Разбор.СуммаСНДС, "ЧДЦ=2; ЧН=0"));
	КонецЕсли;
	Если Документ.Метаданные().ТабличныеЧасти.Найти("Товары") <> Неопределено
		И Документ.Товары.Количество() <> Разбор.Строки.Количество() Тогда
		Сообщения.Добавить("Строк товаров в документе " + Документ.Товары.Количество() + ", в УПД " + Разбор.Строки.Количество());
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область КарточкаВходящего

// ЩА 20.10.2026 [yan]: карточка входящего документа (Центр управления -> Входящие -> двойной щелчок).
// Просмотр, печатная форма оператора и ответы человека: подписать, отказать, запросить уточнение,
// предложить аннулирование. Каждое действие - только по нажатию кнопки пользователем.

// Вид входящего для списка и заголовка карточки по функции документа и типу списка оператора.
Функция ВидВходящегоДокумента(Знач ФункцияДокумента, Знач ЭтоУКД) Экспорт
	Ф = ВРег(СокрЛП(ФункцияДокумента));
	Если ЭтоУКД Тогда
		Возврат ?(Ф = "КСЧФ", "Корр. счёт-фактура", "УКД");
	КонецЕсли;
	Если Ф = "СЧФ" Тогда
		Возврат "Счёт-фактура";
	КонецЕсли;
	Возврат "УПД";
КонецФункции

// Нужен ли на документ ответный титул покупателя: на счет-фактуру (СЧФ, КСЧФ) - нет.
Функция ВходящийЖдетПодписиПокупателя(Знач ФункцияДокумента) Экспорт
	Ф = ВРег(СокрЛП(ФункцияДокумента));
	Возврат Ф <> "СЧФ" И Ф <> "КСЧФ";
КонецФункции

// Печатная форма входящего у оператора - PDF с отметками ЭДО.
// Оператор не ответил или ответил ошибкой - Успех = Ложь и текст для пользователя
// «Загрузка печатной формы не удалась: ...»; подробности - в ЖР «ЭДО.Входящие».
// Возврат: Структура (Успех, Данные - ДвоичныеДанные, Текст).
Функция ПечатнаяФормаВходящего(Знач Ид, Знач Организация) Экспорт
	Итог = Новый Структура("Успех, Данные, Текст", Ложь, Неопределено, "");
	// Перехват обоснован: оператор не отвечает (таймаут, сбой сервиса) - для пользователя это штатное
	// сообщение в карточке, а не ошибка программы; полный текст - в ЖР.
	Попытка
		Ответ = ЗапросКОператоруЭДО("GET", "/public/api/v4/documents/" + СокрЛП(Ид) + "/watermarked-content", ,
			Организация, , "*/*");
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Печатная форма входящего " + Ид + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Итог.Текст = "Загрузка печатной формы не удалась: оператор не ответил ("
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + "). Попробуйте позже.";
		Возврат Итог;
	КонецПопытки;
	Если Ответ.Код <> 200 ИЛИ Ответ.Данные = Неопределено ИЛИ Ответ.Данные.Размер() = 0 Тогда
		ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Печатная форма входящего " + Ид + ": HTTP " + Ответ.Код + " " + Лев(Ответ.Текст, 500));
		Итог.Текст = "Загрузка печатной формы не удалась: оператор ответил HTTP " + Ответ.Код
			+ ?(ЗначениеЗаполнено(Ответ.Текст), " " + Лев(Ответ.Текст, 200), "") + ".";
		Возврат Итог;
	КонецЕсли;
	Итог.Успех = Истина;
	Итог.Данные = Ответ.Данные;
	Возврат Итог;
КонецФункции

// Просмотр входящего в карточке: HTML из XML документа (шапка, стороны, товары, итоги).
// XML не получен или не разобран - HTML с причиной и подсказкой открыть печатную форму.
// Возврат: Структура (Успех, HTML, Текст).
Функция ПросмотрВходящегоHTML(Знач Ид, Знач Организация) Экспорт
	Итог = Новый Структура("Успех, HTML, Текст", Ложь, "", "");
	// Перехват обоснован: как у печатной формы - недоступность оператора показывается в карточке, в ЖР - подробно.
	Попытка
		Данные = СодержимоеВходящегоДокумента(Ид, Организация);
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Просмотр входящего " + Ид + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Итог.Текст = "Загрузка документа не удалась: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Итог.HTML = HTMLСообщения(Итог.Текст, "Попробуйте «Обновить» позже.");
		Возврат Итог;
	КонецПопытки;
	// Перехват обоснован: файл не УПД (УКД, иной формат) - просмотра нет, но печатная форма и действия доступны.
	Попытка
		Разбор = ЭДО_ВходящиеДокументы.РазобратьУПД(Данные);
	Исключение
		Итог.Текст = "Просмотр для этого вида документа пока не поддерживается: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Итог.HTML = HTMLСообщения(Итог.Текст, "Откройте «Печатную форму» - её формирует оператор.");
		Возврат Итог;
	КонецПопытки;
	Итог.Успех = Истина;
	Итог.HTML = HTMLУПД(Разбор);
	Возврат Итог;
КонецФункции

Функция HTMLТекст(Знач Текст)
	Возврат СтрЗаменить(СтрЗаменить(СтрЗаменить(Строка(Текст), "&", "&amp;"), "<", "&lt;"), ">", "&gt;");
КонецФункции

Функция HTMLСтиль()
	Возврат "<style>body{font-family:Arial,sans-serif;font-size:10pt;margin:8px}
	|h3{margin:4px 0 8px}table{border-collapse:collapse;width:100%}
	|td,th{border:1px solid #bbb;padding:2px 4px;vertical-align:top}th{background:#eee}
	|td.n{text-align:right;white-space:nowrap}.s td{border:none;padding:1px 6px 1px 0}
	|.w{color:#a00}.m{color:#555;padding:20px}</style>";
КонецФункции

Функция HTMLСообщения(Знач Текст, Знач Подсказка)
	Возврат "<html><head><meta charset=""utf-8"">" + HTMLСтиль() + "</head><body><div class=""m""><b>"
		+ HTMLТекст(Текст) + "</b><br><br>" + HTMLТекст(Подсказка) + "</div></body></html>";
КонецФункции

Функция HTMLСтороны(Знач Подпись, Знач Участник)
	Если Участник = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат "<tr><td>" + Подпись + ":</td><td><b>" + HTMLТекст(Участник.Наименование) + "</b> ИНН "
		+ HTMLТекст(Участник.ИНН) + ?(ЗначениеЗаполнено(Участник.КПП), " КПП " + HTMLТекст(Участник.КПП), "") + "</td></tr>";
КонецФункции

Функция HTMLЧисло(Знач Число, Знач Дробь = 2)
	Возврат Формат(Число, "ЧДЦ=" + Дробь + "; ЧН=0");
КонецФункции

Функция HTMLУПД(Знач Разбор)
	Ч = Новый Массив;
	Ч.Добавить("<html><head><meta charset=""utf-8"">" + HTMLСтиль() + "</head><body>");
	Ч.Добавить("<h3>" + HTMLТекст(ВидВходящегоДокумента(Разбор.Функция, Ложь)) + " № " + HTMLТекст(Разбор.Номер)
		+ " от " + Формат(Разбор.Дата, "ДФ=dd.MM.yyyy")
		+ ?(ЗначениеЗаполнено(Разбор.НомерИсправления), ", исправление № " + HTMLТекст(Разбор.НомерИсправления)
			+ " от " + Формат(Разбор.ДатаИсправления, "ДФ=dd.MM.yyyy"), "") + "</h3>");
	Ч.Добавить("<table class=""s"">");
	Ч.Добавить(HTMLСтороны("Продавец", Разбор.Продавец));
	Ч.Добавить(HTMLСтороны("Покупатель", Разбор.Покупатель));
	Если Разбор.ГрузоотправительОнЖе Тогда
		Ч.Добавить("<tr><td>Грузоотправитель:</td><td>он же</td></tr>");
	Иначе
		Ч.Добавить(HTMLСтороны("Грузоотправитель", Разбор.Грузоотправитель));
	КонецЕсли;
	Ч.Добавить(HTMLСтороны("Грузополучатель", Разбор.Грузополучатель));
	Для Каждого Отгрузка Из Разбор.ДокументыОтгрузки Цикл
		Ч.Добавить("<tr><td>Документ отгрузки:</td><td>" + HTMLТекст(Отгрузка.Наименование) + " № "
			+ HTMLТекст(Отгрузка.Номер) + " от " + Формат(Отгрузка.Дата, "ДФ=dd.MM.yyyy") + "</td></tr>");
	КонецЦикла;
	Для Каждого Основание Из Разбор.Основания Цикл
		Ч.Добавить("<tr><td>Основание:</td><td>" + HTMLТекст(Основание.Наименование) + " № "
			+ HTMLТекст(Основание.Номер) + " от " + Формат(Основание.Дата, "ДФ=dd.MM.yyyy") + "</td></tr>");
	КонецЦикла;
	Если ЗначениеЗаполнено(Разбор.СодержаниеОперации) Тогда
		Ч.Добавить("<tr><td>Содержание операции:</td><td>" + HTMLТекст(Разбор.СодержаниеОперации) + "</td></tr>");
	КонецЕсли;
	Ч.Добавить("</table><br>");
	Ч.Добавить("<table><tr><th>№</th><th>Товар</th><th>Ед.</th><th>Кол-во</th><th>Цена</th><th>Без НДС</th>"
		+ "<th>НДС, %</th><th>НДС</th><th>С НДС</th><th>Кодов маркировки</th></tr>");
	Для Каждого Товар Из Разбор.Строки Цикл
		Кодов = Товар.КИЗ.Количество() + Товар.Упаковки.Количество() + Товар.ТранспортныеУпаковки.Количество();
		Ч.Добавить("<tr><td class=""n"">" + Товар.НомерСтроки + "</td><td>" + HTMLТекст(Товар.Наименование)
			+ ?(ЗначениеЗаполнено(Товар.КодТовара), " <span style=""color:#777"">[" + HTMLТекст(Товар.КодТовара) + "]</span>", "")
			+ "</td><td>" + HTMLТекст(Товар.ЕдиницаИзмерения) + "</td><td class=""n"">" + HTMLЧисло(Товар.Количество, 3)
			+ "</td><td class=""n"">" + HTMLЧисло(Товар.Цена) + "</td><td class=""n"">" + HTMLЧисло(Товар.СуммаБезНДС)
			+ "</td><td>" + HTMLТекст(Товар.СтавкаНДС) + "</td><td class=""n"">" + HTMLЧисло(Товар.СуммаНДС)
			+ "</td><td class=""n"">" + HTMLЧисло(Товар.СуммаСНДС) + "</td><td class=""n"">"
			+ ?(Кодов > 0, Формат(Кодов, "ЧГ=0"), "") + "</td></tr>");
	КонецЦикла;
	Ч.Добавить("<tr><th colspan=""5"" style=""text-align:right"">Всего к оплате</th><th class=""n"">"
		+ HTMLЧисло(Разбор.СуммаБезНДС) + "</th><th></th><th class=""n"">" + HTMLЧисло(Разбор.СуммаНДС)
		+ "</th><th class=""n"">" + HTMLЧисло(Разбор.СуммаСНДС) + "</th><th></th></tr></table>");
	Для Каждого Предупреждение Из Разбор.Предупреждения Цикл
		Ч.Добавить("<p class=""w"">" + HTMLТекст(Предупреждение) + "</p>");
	КонецЦикла;
	Ч.Добавить("</body></html>");
	Возврат СтрСоединить(Ч, Символы.ПС);
КонецФункции

// Статус входящего у оператора сейчас (для карточки после действия). Неопределено - не прочитан.
Функция СтатусВходящегоУОператора(Знач Ид, Знач Организация) Экспорт
	Карточка = КарточкаОператораПоИд(Ид, Организация);
	Возврат ?(Карточка.Найдена, Карточка.Статус, Неопределено);
КонецФункции

// «Подписать»: титул покупателя на входящий УПД/УКД и подпись КЭП сервера - как у автоприемки,
// но по нажатию человека и без списка доверенных продавцов. Версия - версия формата карточки оператора.
// Возврат: Структура (Успех, Текст).
Функция ПодписатьВходящийВручную(Знач Ид, Знач Организация, Знач Версия, Знач ЭтоУКД, Знач ФункцияДокумента) Экспорт
	Итог = Новый Структура("Успех, Текст", Ложь, "");
	Если НЕ ВходящийЖдетПодписиПокупателя(ФункцияДокумента) Тогда
		Итог.Текст = "На счёт-фактуру подпись покупателя не ставится - подписывать нечего.";
		Возврат Итог;
	КонецЕсли;
	Входящий = Новый Структура("Ид, Версия, ЭтоУКД", СокрЛП(Ид), СокрЛП(Версия), ЭтоУКД);
	Результат = ПринятьВходящийУПД(Входящий, ПодписантДляОператора(Организация), Организация);
	ЗаписьЖурналаРегистрации("ЭДО.Входящие", ?(Результат.Успех, УровеньЖурналаРегистрации.Информация,
		УровеньЖурналаРегистрации.Ошибка), , , "Подписание входящего " + Ид + " вручную: " + Результат.Текст);
	Итог.Успех = Результат.Успех;
	Итог.Текст = ?(Результат.Успех, "Документ подписан: ", "Документ не подписан: ") + Результат.Текст;
	Возврат Итог;
КонецФункции

// «Отказать в подписи»: документ отказа на титул продавца с причиной и подпись его КЭП сервера.
// Возврат: Структура (Успех, Текст).
Функция ОтказатьВПодписиВходящего(Знач Ид, Знач Организация, Знач Причина) Экспорт
	Итог = Новый Структура("Успех, Текст", Ложь, "");
	Причина = СокрЛП(Причина);
	Если НЕ ЗначениеЗаполнено(Причина) Тогда
		Итог.Текст = "Для отказа нужна причина: её прочитает продавец.";
		Возврат Итог;
	КонецЕсли;
	Подписант = ПодписантДляОператора(Организация);
	Тело = Новый Структура("signer, reason", Новый Структура("person, position", Подписант.ФИО, Подписант.Должность), Причина);
	Ответ = ЗапросКОператоруЭДО("PUT", "/public/api/v3/documents/" + СокрЛП(Ид) + "/rejection", СтрокаJSON(Тело), Организация);
	Если Ответ.Код <> 200 И Ответ.Код <> 201 Тогда
		Итог.Текст = "Отказ не создан: HTTP " + Ответ.Код + " " + Лев(Ответ.Текст, 300);
		ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Ошибка, , , "Отказ по входящему " + Ид + ": " + Итог.Текст);
		Возврат Итог;
	КонецЕсли;
	Итог = ПодписатьОтветОператора(Ответ.Текст, Организация, "Отказ в подписи", Ид);
	Возврат Итог;
КонецФункции

// «Запросить уточнение»: уведомление об уточнении (универсальное сообщение CORRECTION) продавцу.
// Возврат: Структура (Успех, Текст).
Функция ЗапроситьУточнениеВходящего(Знач Ид, Знач Организация, Знач ТекстУточнения, Знач ГидПродавца) Экспорт
	Итог = Новый Структура("Успех, Текст", Ложь, "");
	ТекстУточнения = СокрЛП(ТекстУточнения);
	Если НЕ ЗначениеЗаполнено(ТекстУточнения) Тогда
		Итог.Текст = "Напишите, что нужно уточнить: текст прочитает продавец.";
		Возврат Итог;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ГидПродавца) Тогда
		Итог.Текст = "Не известен идентификатор продавца у оператора - обновите список входящих.";
		Возврат Итог;
	КонецЕсли;
	Подписант = ПодписантДляОператора(Организация);
	Тело = Новый Структура("sender, recipient, status, description, senderPerson",
		Новый Структура("id", ГидОрганизации(Организация)), Новый Структура("id", СокрЛП(ГидПродавца)),
		"CORRECTION", ТекстУточнения, Подписант.ФИО);
	Ответ = ЗапросКОператоруЭДО("POST", "/public/api/v3/documents/" + СокрЛП(Ид) + "/universal-message", СтрокаJSON(Тело), Организация);
	Если Ответ.Код <> 200 И Ответ.Код <> 201 Тогда
		Итог.Текст = "Запрос уточнения не создан: HTTP " + Ответ.Код + " " + Лев(Ответ.Текст, 300);
		ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Ошибка, , , "Уточнение по входящему " + Ид + ": " + Итог.Текст);
		Возврат Итог;
	КонецЕсли;
	Итог = ПодписатьОтветОператора(Ответ.Текст, Организация, "Запрос уточнения", Ид);
	Возврат Итог;
КонецФункции

// Ответ оператора на создание служебного документа (отказ, уточнение): если документ ждет подписи
// (статус NEW) - подписать КЭП сервера. Без идентификатора в ответе - оператор отправил сам.
Функция ПодписатьОтветОператора(Знач ТекстОтвета, Знач Организация, Знач Что, Знач ИдВходящего)
	Итог = Новый Структура("Успех, Текст", Ложь, "");
	Данные = Неопределено;
	Если ЗначениеЗаполнено(ТекстОтвета) Тогда
		// Перехват обоснован: ответ без JSON - оператор принял запрос без тела, это успех без подписи.
		Попытка
			Данные = ПрочитатьОтветJSON(ТекстОтвета);
		Исключение
			ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , ,
				Что + " по " + ИдВходящего + ": ответ не JSON - " + Лев(ТекстОтвета, 300));
		КонецПопытки;
	КонецЕсли;
	ИдОтвета = ?(ТипЗнч(Данные) = Тип("Соответствие"), ЭДО_Регламенты.ИдентификаторСтрокой(Данные.Получить("id")), "");
	СтатусОтвета = ?(ТипЗнч(Данные) = Тип("Соответствие"), ВРег(СокрЛП(Строка(Данные.Получить("status")))), "");
	Если ЗначениеЗаполнено(ИдОтвета) И (СтатусОтвета = "NEW" ИЛИ НЕ ЗначениеЗаполнено(СтатусОтвета)) Тогда
		Подписание = ПодписатьДокументОператора(ИдОтвета, Организация);
		Если НЕ Подписание.Успех Тогда
			Итог.Текст = Что + " создан (ид " + ИдОтвета + "), но не подписан: " + Подписание.Текст;
			ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Ошибка, , , Итог.Текст + " (входящий " + ИдВходящего + ")");
			Возврат Итог;
		КонецЕсли;
	КонецЕсли;
	ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Информация, , ,
		Что + " по входящему " + ИдВходящего + " отправлен" + ?(ЗначениеЗаполнено(ИдОтвета), " (ид " + ИдОтвета + ")", ""));
	Итог.Успех = Истина;
	Итог.Текст = Что + " отправлен продавцу.";
	Возврат Итог;
КонецФункции

#КонецОбласти

#Область ОтменаФиксацииЧЗ

// ЩА 20.10.2026 [yan]: отмена фиксации (сведений об отгрузке) в Честном знаке через оператора.
// Аннулирование УПД фиксацию не снимает: FIX прежнего экземпляра часами остается CHECKED_OK, и любая
// переотправка получает ERROR_276 «КМ отгружен другим документом» - своей же фиксацией (КУД, АНК-0009720
// и АНК-0009736, 20.10). Рецепт - веб-кабинет Платформы, кнопка «Снять фиксацию» (банк lion,
// platforma-edo-api-status-and-chz, «Отмена фиксации…»):
// 1) заявка POST /edm-crpt/public/api/v3/partner/documents/{id}/cancellation, тело {"inn": ИНН отправителя}
//    (уже поданная - GET того же пути, 404 - заявки нет);
// 2) присоединенная подпись CAdES-BES компактного JSON {"inn":…,"fixation_document_id":…};
// 3) POST …/cancellation/signature, тело - голая строка base64 (не JSON-строка: в кавычках - HTTP 400).
// Не экспортная: вызывается только из гейта отправки, где экземпляр проверен по документу;
// произвольный идентификатор с клиента не принимается.
// Возврат: Структура (Успех, Текст, Статус - статус заявки у оператора).
Функция ОтменитьФиксациюЧЗ(Знач ИдЭкземпляра, Знач Организация, Знач Ссылка)

	// Перехват обоснован (ревью Codex 880): сбой связи, разбора ответа или подписи - неуспех с текстом для
	// колонки и ЖР, а не исключение поверх уже выполненного ПОА. Повтор начинается с чтения заявки (GET).
	Попытка
		Возврат ВыполнитьОтменуФиксацииЧЗ(ИдЭкземпляра, Организация, Ссылка);
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.ГИСМТ", УровеньЖурналаРегистрации.Ошибка, , Ссылка,
			"Отмена фиксации экземпляра " + ИдЭкземпляра + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый Структура("Успех, Текст, Статус", Ложь,
			"отмена фиксации прервалась: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), "");
	КонецПопытки;

КонецФункции

Функция ВыполнитьОтменуФиксацииЧЗ(Знач ИдЭкземпляра, Знач Организация, Знач Ссылка)

	Итог = Новый Структура("Успех, Текст, Статус", Ложь, "", "");
	ИдЭкземпляра = СокрЛП(ИдЭкземпляра);
	ИНН = СокрЛП(Организация.ИНН);
	Путь = "/public/api/v3/partner/documents/" + ИдЭкземпляра + "/cancellation?subscriber_gid="
		+ КодироватьСтроку(ГидОрганизации(Организация), СпособКодированияСтроки.КодировкаURL);

	Ответ = ЗапросКОператоруЭДО("GET", Путь, , Организация, "crpt");
	Если Ответ.Код = 404 Тогда
		Ответ = ЗапросКОператоруЭДО("POST", Путь, СтрокаJSON(Новый Структура("inn", ИНН)), Организация, "crpt");
	КонецЕсли;
	Если Ответ.Код <> 200 И Ответ.Код <> 201 Тогда
		Итог.Текст = "заявка на отмену фиксации не создана, HTTP " + Ответ.Код + " " + Лев(Ответ.Текст, 300);
		ЗаписьЖурналаРегистрации("ЭДО.ГИСМТ", УровеньЖурналаРегистрации.Ошибка, , Ссылка,
			"Отмена фиксации экземпляра " + ИдЭкземпляра + ": " + Итог.Текст);
		Возврат Итог;
	КонецЕсли;
	Заявка = ПрочитатьОтветJSON(Ответ.Текст);
	Если ТипЗнч(Заявка) <> Тип("Соответствие") Тогда
		Итог.Текст = "неожиданный ответ на заявку отмены фиксации: " + Лев(Ответ.Текст, 300);
		ЗаписьЖурналаРегистрации("ЭДО.ГИСМТ", УровеньЖурналаРегистрации.Ошибка, , Ссылка,
			"Отмена фиксации экземпляра " + ИдЭкземпляра + ": " + Итог.Текст);
		Возврат Итог;
	КонецЕсли;
	Итог.Статус = ВРег(ТекстПоляОтветаГИСМТ(Заявка, "status"));
	Если СтатусЗаявкиОтменыПодан(Итог.Статус) Тогда
		Итог.Успех = Истина;
		Итог.Текст = "заявка на отмену фиксации уже подана (" + Итог.Статус + ")";
		Возврат Итог;
	ИначеЕсли Итог.Статус <> "NEW" Тогда
		Итог.Текст = "заявка на отмену фиксации у оператора в статусе " + Итог.Статус
			+ " - нужен разбор (кабинет Платформы); отправить документ можно вручную, сняв проверку";
		ЗаписьЖурналаРегистрации("ЭДО.ГИСМТ", УровеньЖурналаРегистрации.Ошибка, , Ссылка,
			"Отмена фиксации экземпляра " + ИдЭкземпляра + ": " + Итог.Текст);
		Возврат Итог;
	КонецЕсли;

	ИдФиксации = ТекстПоляОтветаГИСМТ(Заявка, "fixationDocumentId");
	ТекстПодписи = "{""inn"":""" + ИНН + """,""fixation_document_id"":""" + ИдФиксации + """}";
	Данные = ПолучитьДвоичныеДанныеИзСтроки(ТекстПодписи, КодировкаТекста.UTF8, Ложь);   // без BOM: подписывается ровно JSON
	Подпись = ПодписатьДанные(Данные, Организация);
	Если Подпись = Неопределено Тогда
		Итог.Текст = "заявка на отмену фиксации создана, но не подписана: подпись КЭП на сервере не удалась";
		ЗаписьЖурналаРегистрации("ЭДО.ГИСМТ", УровеньЖурналаРегистрации.Ошибка, , Ссылка,
			"Отмена фиксации экземпляра " + ИдЭкземпляра + ": " + Итог.Текст);
		Возврат Итог;
	КонецЕсли;
	Отказ = Ложь;
	ОписаниеОшибки = "";
	Присоединенная = ПодключитьОбработкуЭДО().ПрисоединитьПодпись(Подпись, Данные, Отказ, ОписаниеОшибки);
	Если Отказ Тогда
		Итог.Текст = "заявка на отмену фиксации создана, но подпись не присоединена: " + ОписаниеОшибки;
		ЗаписьЖурналаРегистрации("ЭДО.ГИСМТ", УровеньЖурналаРегистрации.Ошибка, , Ссылка,
			"Отмена фиксации экземпляра " + ИдЭкземпляра + ": " + Итог.Текст);
		Возврат Итог;
	КонецЕсли;
	ПутьПодписи = СтрЗаменить(Путь, "/cancellation?", "/cancellation/signature?");
	Ответ = ЗапросКОператоруЭДО("POST", ПутьПодписи, ОчиститьBase64(Base64Строка(Присоединенная)), Организация, "crpt");
	Если Ответ.Код <> 200 И Ответ.Код <> 201 Тогда
		Итог.Текст = "подпись заявки на отмену фиксации не принята, HTTP " + Ответ.Код + " " + Лев(Ответ.Текст, 300);
		ЗаписьЖурналаРегистрации("ЭДО.ГИСМТ", УровеньЖурналаРегистрации.Ошибка, , Ссылка,
			"Отмена фиксации экземпляра " + ИдЭкземпляра + ": " + Итог.Текст);
		Возврат Итог;
	КонецЕсли;
	// Перехват обоснован: подпись уже принята (200); тело ответа - только для показа статуса заявки.
	Попытка
		Ответная = ПрочитатьОтветJSON(Ответ.Текст);
		Если ТипЗнч(Ответная) = Тип("Соответствие") Тогда
			Итог.Статус = ВРег(ТекстПоляОтветаГИСМТ(Ответная, "status"));
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.ГИСМТ", УровеньЖурналаРегистрации.Предупреждение, , Ссылка,
			"Отмена фиксации экземпляра " + ИдЭкземпляра + ": ответ на подпись не JSON - " + Лев(Ответ.Текст, 200));
	КонецПопытки;
	Итог.Успех = Истина;
	Итог.Текст = "заявка на отмену фиксации подписана и отправлена" + ?(ЗначениеЗаполнено(Итог.Статус), " (" + Итог.Статус + ")", "");
	ЗаписьЖурналаРегистрации("ЭДО.ГИСМТ", УровеньЖурналаРегистрации.Информация, , Ссылка,
		"Отмена фиксации экземпляра " + ИдЭкземпляра + ": " + Итог.Текст);
	Возврат Итог;

КонецФункции

// Заявка на отмену фиксации принята оператором и ушла в ЧЗ. Известны NEW (ждет подписи) и REGISTERED;
// прочие статусы успехом не считаются: упавшая заявка иначе выглядела бы поданной навсегда.
Функция СтатусЗаявкиОтменыПодан(Знач Статус)
	Возврат Статус = "REGISTERED" ИЛИ Статус = "ACCEPTED" ИЛИ Статус = "DONE" ИЛИ Статус = "COMPLETED";
КонецФункции

// Фиксация экземпляра в ЧЗ отменена (FIX_<fileId> в статусе CANCELLED). Сбой запроса - Ложь: марки считаем занятыми.
Функция ФиксацияОтмененаВЧЗ(Знач ИмяФайла, Знач Организация, Знач Ссылка)

	ИмяФайла = СокрЛП(ИмяФайла);
	Если НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
		Возврат Ложь;
	КонецЕсли;
	// Перехват обоснован: сбой связи или токена ЧЗ не должен ронять гейт - документ держим, причина в ЖР.
	Попытка
		Соединение = Новый HTTPСоединение("markirovka.crpt.ru", 443, , , , 60, Новый ЗащищенноеСоединениеOpenSSL());
		ЗапросЧЗ = Новый HTTPЗапрос("/api/v4/true-api/doc/FIX_" + ИмяФайла + "/info");
		ЗапросЧЗ.Заголовки.Вставить("Authorization", "Bearer " + ТокенГИСМТ(Организация));
		ЗапросЧЗ.Заголовки.Вставить("Accept", "application/json");
		ОтветЧЗ = Соединение.Получить(ЗапросЧЗ);
		Если ОтветЧЗ.КодСостояния <> 200 Тогда
			ЗаписьЖурналаРегистрации("ЭДО.ГИСМТ", УровеньЖурналаРегистрации.Предупреждение, , Ссылка,
				"Состояние FIX_" + ИмяФайла + " в ЧЗ не прочитано: HTTP " + Формат(ОтветЧЗ.КодСостояния, "ЧГ=0"));
			Возврат Ложь;
		КонецЕсли;
		Данные = ПрочитатьОтветJSON(ОтветЧЗ.ПолучитьТелоКакСтроку("UTF-8"));
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.ГИСМТ", УровеньЖурналаРегистрации.Предупреждение, , Ссылка,
			"Состояние FIX_" + ИмяФайла + " в ЧЗ не прочитано: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	КарточкаЧЗ = ?(ТипЗнч(Данные) = Тип("Массив") И Данные.Количество() > 0, Данные[0], Данные);
	Если ТипЗнч(КарточкаЧЗ) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ВРег(СокрЛП(Строка(КарточкаЧЗ.Получить("status")))) = "CANCELLED";

КонецФункции

// Препятствие переотправке: прежний экземпляр документа аннулирован или отклонен, а его фиксация в ЧЗ
// еще действует - новый экземпляр получил бы ERROR_276. Подает отмену фиксации и держит документ, пока ЧЗ
// ее не выполнит; документ, помеченный к отправке, уходит сам следующим прогоном.
// Возврат: Строка - причина удержания для колонки; "" - можно отправлять.
Функция ПрепятствиеФиксациейПрежнегоЭкземпляра(Знач Ссылка)

	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Возврат "";
	КонецЕсли;
	Фиксация = СостояниеФиксацииГИСМТ(Ссылка);
	Если НЕ Фиксация.Требуется ИЛИ НЕ ЗначениеЗаполнено(Фиксация.ИдДокумента) Тогда
		Возврат "";
	КонецЕсли;
	// Марки свободны: фиксации нет, она не прошла (FIX отклонен) или отменена. Ревью Codex 880: разрешаем
	// только по подтвержденному освобождению, а не по отсутствию надписи в списке.
	Если Фиксация.Итог = ТекстСтатусаГИСМТНеТребуется() ИЛИ Фиксация.Итог = "Фиксация у оператора не найдена"
		ИЛИ Фиксация.Итог = "Фиксация отменена в ЧЗ"
		ИЛИ (СтрНачинаетсяС(Фиксация.Итог, "Ошибка ЧЗ") И ЗначениеЗаполнено(Фиксация.Операция)
			И Фиксация.Операция <> "FIXATION_CANCEL") Тогда
		Возврат "";
	КонецЕсли;
	Организация = ОрганизацияДокумента(Ссылка);
	Карточка = КарточкаОператораПоИд(Фиксация.ИдДокумента, Организация);   // сбой связи - исключение, его ловит ОтправитьПоЭДО
	Если НЕ Карточка.Опрошено Тогда
		Возврат "Не прочитан у оператора прежний экземпляр " + Фиксация.ИдДокумента + " (HTTP " + Карточка.Код
			+ ") - отправка отложена, пока не ясно, свободны ли марки в ЧЗ";
	КонецЕсли;
	Если НЕ Карточка.Найдена Тогда
		Возврат "";
	КонецЕсли;
	ТекстПовтора = " Документ из очереди уйдёт сам; отправленный вручную - отправьте ещё раз после отмены.";
	// Фиксацию снимаем только после подтвержденного аннулирования: если покупатель от аннулирования откажется,
	// документ останется действующим, и фиксация ему нужна. Пока ждем ответа - марки заняты, держим.
	Если Карточка.Статус = "CANCELLATION_REQUESTED" Тогда
		Возврат "Прежний экземпляр " + Фиксация.ИдДокумента + " ждёт подтверждения аннулирования покупателем;"
			+ " после подтверждения фиксация в ЧЗ будет снята." + ТекстПовтора;
	КонецЕсли;
	Если Карточка.Статус <> "CANCELLED" И Карточка.Статус <> "REJECTED" Тогда
		Возврат "";   // прежний экземпляр жив - это решают гейты дубля
	КонецЕсли;
	Если СтрНачинаетсяС(Фиксация.Итог, "Нет данных") Тогда
		Возврат "Не прочитано состояние фиксации в ЧЗ прежнего экземпляра " + Фиксация.ИдДокумента + " ("
			+ Фиксация.Итог + ") - отправка отложена: марки могут быть заняты.";
	ИначеЕсли СтрНачинаетсяС(Фиксация.Итог, "Ошибка ЧЗ") Тогда
		Возврат "Честный знак отклонил отмену фиксации прежнего экземпляра " + Фиксация.ИдДокумента + ": "
			+ Фиксация.Итог + " - марки заняты, нужен разбор.";
	ИначеЕсли Фиксация.Итог = "Обрабатывается в ЧЗ" Тогда
		Возврат "Честный знак обрабатывает фиксацию или её отмену у прежнего экземпляра " + Фиксация.ИдДокумента + "."
			+ ТекстПовтора;
	ИначеЕсли Фиксация.Итог <> ТекстСтатусаГИСМТЗафиксирован() Тогда
		Возврат "Неизвестное состояние фиксации прежнего экземпляра " + Фиксация.ИдДокумента + ": " + Фиксация.Итог
			+ " - отправка отложена.";
	КонецЕсли;
	Отмена = ОтменитьФиксациюЧЗ(Фиксация.ИдДокумента, Организация, Ссылка);
	// Заявка уже прошла подпись, а список оператора освобождение марок может не показать - спрашиваем сам ЧЗ.
	Если ЗначениеЗаполнено(Отмена.Статус) И Отмена.Статус <> "NEW"
		И ФиксацияОтмененаВЧЗ(Карточка.ИмяФайла, Организация, Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	Если НЕ Отмена.Успех Тогда
		Возврат "Фиксация в ЧЗ прежнего экземпляра " + Фиксация.ИдДокумента + " не снята: " + Отмена.Текст;
	КонецЕсли;
	Возврат "Подана отмена фиксации в ЧЗ прежнего экземпляра " + Фиксация.ИдДокумента + " (" + Отмена.Текст + ")."
		+ ТекстПовтора;

КонецФункции

#КонецОбласти
