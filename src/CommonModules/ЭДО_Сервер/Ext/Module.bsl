Функция ИмяОбработкиПомощника()
	Возврат "ЭДО_Помощник";
КонецФункции

// Наименование вида контактной информации, фактически используемого В ЭТОЙ базе.
// Мотив: в разных базах виды называются по-разному ("Юридический адрес организации" против
// "Юридический адрес"), а маппинг соединяется с регистром ПО НАИМЕНОВАНИЮ вида - при чужом
// имени адреса выбираются пустыми, узел <Адрес> не выгружается, и принимающий оператор
// молча бракует документ. Берём тот вид, которым реально заполнены объекты нужного типа.
Функция НаименованиеВидаКИ(Знач НачалоИмени, Знач ПоОрганизациям) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	КИ.Вид.Наименование КАК Наим,
	               |	КОЛИЧЕСТВО(*) КАК Кол
	               |ИЗ
	               |	РегистрСведений.КонтактнаяИнформация КАК КИ
	               |ГДЕ
	               |	КИ.Вид.Наименование ПОДОБНО &Маска
	               |	И ВЫБОР КОГДА &ПоОрганизациям
	               |			ТОГДА ВЫРАЗИТЬ(КИ.Объект КАК Справочник.Организации) ЕСТЬ НЕ NULL
	               |		ИНАЧЕ ВЫРАЗИТЬ(КИ.Объект КАК Справочник.Контрагенты) ЕСТЬ НЕ NULL
	               |	КОНЕЦ
	               |СГРУППИРОВАТЬ ПО
	               |	КИ.Вид.Наименование
	               |УПОРЯДОЧИТЬ ПО
	               |	Кол УБЫВ";
	Запрос.УстановитьПараметр("Маска", НачалоИмени + "%");
	Запрос.УстановитьПараметр("ПоОрганизациям", ПоОрганизациям);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Наим;
	КонецЕсли;
	Возврат "";
КонецФункции

// Текст настройки маппинга реализации, подогнанный под ЭТУ базу.
Функция ТекстНастройкиРеализации() Экспорт

	Текст = МакетТекст("НастройкаРеализация");

	// 1. признак маркируемого товара: в части конфигураций реквизита нет вовсе
	// (фактическая маркировка определяется кодами в ТЧ ШтрихкодыУпаковок, а не флагом)
	Если Метаданные.Документы.РеализацияТоваровУслуг.Реквизиты.Найти("СодержитМаркируемыйТовар") = Неопределено Тогда
		Текст = СтрЗаменить(Текст,
			"РТУ.СодержитМаркируемыйТовар      КАК СодержитМаркируемыйТовар",
			"ЛОЖЬ                              КАК СодержитМаркируемыйТовар");
	КонецЕсли;

	// 2. фактические наименования видов контактной информации
	Текст = ПодставитьВидыКонтактнойИнформации(Текст);

	// 3. контактная информация ДОГОВОРОВ: в части конфигураций тип ДоговорыКонтрагентов не входит
	// в измерение Объект регистра КонтактнаяИнформация (проверено: в одной боевой базе входит,
	// в другой - нет, там состав измерения Организации/Пользователи/Контрагенты/Контактные лица/
	// Склады/Физические лица/Личные контакты). ВЫРАЗИТЬ по типу, которого в измерении нет,
	// не компилируется - "Несовместимые типы "ВЫРАЗИТЬ"" - и роняет ВЕСЬ запрос маппинга,
	// то есть каждый документ, а не только ветку адреса. Поэтому соединение глушим условием
	// 1 = 0: псевдоним остаётся, поля приходят NULL, ЕСТЬNULL уводит цепочку адреса на
	// фактический адрес контрагента, как было до появления источника-договора.
	ТипДоговора = Тип("СправочникСсылка.ДоговорыКонтрагентов");
	ИзмерениеОбъект = Метаданные.РегистрыСведений.КонтактнаяИнформация.Измерения.Найти("Объект");
	Если ИзмерениеОбъект = Неопределено ИЛИ НЕ ИзмерениеОбъект.Тип.СодержитТип(ТипДоговора) Тогда
		Текст = СтрЗаменить(Текст,
			"ВЫРАЗИТЬ(АдрФактДог.Объект КАК Справочник.ДоговорыКонтрагентов) = РТУ.ДоговорКонтрагента",
			"1 = 0");
	КонецЕсли;

	// 4. ставки НДС, которых в этой конфигурации ещё нет (5 %, 7 %, 22 % и расчётные к ним
	// появились не во всех релизах УТ 10.3). ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС22)
	// на отсутствующее значение не компилируется и роняет ВЕСЬ запрос маппинга - то есть
	// отправку любого документа, а не только строку с этой ставкой. Ветку ВЫБОР целиком
	// убирать нельзя (нужны существующие ставки), поэтому вырезаем ровно строки-КОГДА
	// отсутствующих значений: остальные ставки продолжают работать.
	МетаСтавки = Метаданные.Перечисления.Найти("СтавкиНДС");
	Если МетаСтавки <> Неопределено Тогда
		МассивСтрок = СтрРазделить(Текст, Символы.ПС);
		Оставшиеся = Новый Массив;
		Для Каждого СтрокаТекста Из МассивСтрок Цикл
			Пропустить = Ложь;
			ПозицияЗначения = Найти(СтрокаТекста, "Перечисление.СтавкиНДС.");
			Если ПозицияЗначения > 0 Тогда
				Хвост = Сред(СтрокаТекста, ПозицияЗначения + СтрДлина("Перечисление.СтавкиНДС."));
				ИмяЗначения = "";
				Для НомерСимвола = 1 По СтрДлина(Хвост) Цикл
					ТекущийСимвол = Сред(Хвост, НомерСимвола, 1);
					Если ТекущийСимвол = ")" Тогда
						Прервать;
					КонецЕсли;
					ИмяЗначения = ИмяЗначения + ТекущийСимвол;
				КонецЦикла;
				Если ЗначениеЗаполнено(ИмяЗначения)
					И МетаСтавки.ЗначенияПеречисления.Найти(ИмяЗначения) = Неопределено Тогда
					Пропустить = Истина;
				КонецЕсли;
			КонецЕсли;
			Если НЕ Пропустить Тогда
				Оставшиеся.Добавить(СтрокаТекста);
			КонецЕсли;
		КонецЦикла;
		Текст = СтрСоединить(Оставшиеся, Символы.ПС);
	КонецЕсли;

	// 3. коды маркировки: ТЧ РеализацияТоваровУслуг.ШтрихкодыУпаковок нетиповая, и на базе
	// без неё падает не одна ветка, а весь маппинг - временная таблица ВТМарк строится
	// в основном запросе, то есть на КАЖДОЙ отправке. Блоки размечены в макете маркерами
	// и здесь гасятся целиком: ВТМарк становится пустой заглушкой с теми же колонками,
	// а гейт неразобранных кодов - константой "Ложь".
	// Узел НомСредИдентТов трогать не нужно: он выполняется только при КодовВСтроке > 0,
	// а с пустой ВТМарк такого не бывает.
	Если Метаданные.Документы.РеализацияТоваровУслуг.ТабличныеЧасти.Найти("ШтрихкодыУпаковок") = Неопределено Тогда
		Текст = ЗаменитьМеждуМаркерами(Текст, "// ПЭДО:ВТМАРК:НАЧАЛО", "// ПЭДО:ВТМАРК:КОНЕЦ",
			"ВЫБРАТЬ ПЕРВЫЕ 0
			|	ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка) КАК Ссылка,
			|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)         КАК Номенклатура,
			|	"""" КАК ГТИН,
			|	0 КАК КодовВСтроке
			|ПОМЕСТИТЬ ВТМарк
			|;");
		Текст = ЗаменитьМеждуМаркерами(Текст, "// ПЭДО:ГЕЙТМАРК:НАЧАЛО", "// ПЭДО:ГЕЙТМАРК:КОНЕЦ",
			"РезультатВыполненияКода = Ложь;");
	КонецЕсли;

	// точка расширения 3: правки маппинга под конкретную базу - ПОСЛЕ автоопределения выше
	Если ПрофильБазыПодключен() Тогда
		Парам = Новый Структура("Текст", Текст);
		ВызватьТочкуПрофиля("ПриФормированииНастройкиРеализации", Парам);
		Текст = Парам.Текст;
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Текст настройки конфигурации, подогнанный под ЭТУ базу.
// Та же беда, что и в настройке реализации: запрос списка документов на отправку тянет
// РеализацияТоваровУслуг.СодержитМаркируемыйТовар, а в части конфигураций реквизита нет
// форма движка падает на открытии ("Поле не найдено"), ещё до всякой отправки.
// Формат выгрузки, соответствующий типу документа.
// Расширение шлет ДВА формата ФНС, и они разных редакций:
// РеализацияТоваровУслуг -> ON_NSCHFDOPPR (УПД, версия 5.03)
// КорректировкаРеализации -> ON_NKORSCHFDOPPR (УКД, версия 5.01)
// Версия УКД именно 5.01 - это действующая редакция формата, проверено XSD поставки
// и живыми документами, принятыми оператором.
Функция ФорматВыгрузкиДокумента(Знач Ссылка) Экспорт
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		Возврат "ON_NKORSCHFDOPPR";
	КонецЕсли;
	Возврат "ON_NSCHFDOPPR";
КонецФункции

// Текст настройки маппинга корректировки реализации (УКД), подогнанный под эту базу.
Функция ТекстНастройкиКорректировки() Экспорт

	Возврат ПодставитьВидыКонтактнойИнформации(МакетТекст("НастройкаКорректировка"));

КонецФункции

// Заменяет в тексте настройки наименования видов адресов на те, что заполнены в этой базе.
Функция ПодставитьВидыКонтактнойИнформации(Знач Текст)

	Замены = Новый Соответствие;
	Замены.Вставить("Юридический адрес организации", НаименованиеВидаКИ("Юридический адрес", Истина));
	Замены.Вставить("Фактический адрес организации", НаименованиеВидаКИ("Фактический адрес", Истина));
	Замены.Вставить("Юридический адрес контрагента", НаименованиеВидаКИ("Юридический адрес", Ложь));
	Замены.Вставить("Фактический адрес контрагента", НаименованиеВидаКИ("Фактический адрес", Ложь));
	Для Каждого КлючЗначение Из Замены Цикл
		Если ЗначениеЗаполнено(КлючЗначение.Значение) И КлючЗначение.Значение <> КлючЗначение.Ключ Тогда
			Текст = СтрЗаменить(Текст, """" + КлючЗначение.Ключ + """", """" + КлючЗначение.Значение + """");
		КонецЕсли;
	КонецЦикла;

	Возврат Текст;

КонецФункции

Функция ТекстНастройкиКонфигурации() Экспорт

	Текст = МакетТекст("НастройкаКонфигурация");

	Если Метаданные.Документы.РеализацияТоваровУслуг.Реквизиты.Найти("СодержитМаркируемыйТовар") = Неопределено Тогда
		Текст = СтрЗаменить(Текст,
			"РеализацияТоваровУслуг.СодержитМаркируемыйТовар КАК ДокументСодержитМаркируемыйТовар",
			"ЛОЖЬ КАК ДокументСодержитМаркируемыйТовар");
	КонецЕсли;

	// точка расширения 2: правки запроса списка документов под конкретную базу
	Если ПрофильБазыПодключен() Тогда
		Парам = Новый Структура("Текст", Текст);
		ВызватьТочкуПрофиля("ПриФормированииНастройкиКонфигурации", Парам);
		Текст = Парам.Текст;
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Программная отправка ОДНОГО документа по ЭДО - ПОЛНЫЙ цикл на сервере.
// Годится для вызова из фона/регламента/ОбработкиПроведения (клиент не нужен).
// Контекст - результат НовыйКонтекстПрогона(); при Неопределено собирается свой.
// Возврат: Структура (Ссылка, Статус, ИдДокумента, Сообщение),
// Статус из "Отправлен" | "ТребуетВнимания" | "Отсеян" | "Ошибка".
Функция ОтправитьПоЭДО(Ссылка, Контекст = Неопределено, Знач Разрешения = Неопределено) Экспорт
	Результат = Новый Структура("Ссылка, Статус, ИдДокумента, Сообщение, КодПричины",
		Ссылка, "", "", "", "");

	// 1) Готовность (проведён + идентификатор ЭДО контрагента) - до любого обращения к API
	Готовность = ПроверитьГотовностьКОтправке(Ссылка, Разрешения);
	Если НЕ Готовность.Готов Тогда
 // "Отправлять не надо" != "что-то пошло не так". Розничная продажа (контрагент
 // заведён на нашу же организацию) в ЭДО не поедет никогда, и держать её в очереди
 // бессмысленно: 22.08.2026 семнадцать таких накладных давали 17 ошибок КАЖДЫЙ час
 // и маскировали настоящие. Помечаем документ и снимаем с очереди насовсем.
		Если Готовность.ОтправкаНеТребуется Тогда
			ЗаписатьЧитаемыйСтатус(Ссылка, ТекстСтатусаОтправкаНеТребуется());
			Результат.Статус = "Отсеян";
		Иначе
			Результат.Статус = "ТребуетВнимания";
		КонецЕсли;
		Результат.Сообщение = Готовность.Причина;
		Результат.КодПричины = Готовность.КодПричины;
		Возврат Результат;
	КонецЕсли;

	// 1) Прерванная отправка разбирается сама: код 10 иначе выводит документ из потока
	// навсегда. Ручное снятие остаётся аварийным ходом, см. РазобратьПрерваннуюОтправку.
	Прерванная = РазобратьПрерваннуюОтправку(Ссылка);
	Если Прерванная.Решено И ЗначениеЗаполнено(Прерванная.Ид) Тогда
		Результат.Статус = "Пропущен";
		Результат.ИдДокумента = Прерванная.Ид;
		Результат.Сообщение = Прерванная.Сообщение;
		Возврат Результат;
	ИначеЕсли НЕ Прерванная.Решено И ЗначениеЗаполнено(Прерванная.Сообщение) Тогда
		Результат.Статус = "ТребуетВнимания";
		Результат.Сообщение = Прерванная.Сообщение;
		Возврат Результат;
	КонецЕсли;

	// 1a) Занимаем документ ДО любого обращения к API.
	// 17.08 массовая отправка шла двумя параллельными прогонами: отметка об отправке
	// писалась ПОСЛЕ успеха, поэтому оба процесса видели документ неотправленным и
	// отправляли каждый свой экземпляр - 593 накладные ушли контрагентам дважды.
	Занятие = ЗанятьДокументКОтправке(Ссылка);
	Если НЕ Занятие.Занят Тогда
		Результат.Статус = "Пропущен";
		Результат.Сообщение = Занятие.Причина;
		Возврат Результат;
	КонецЕсли;

	// С этой точки документ ЗАНЯТ (статус 1) и начинаются обращения к API.
	// Таймаут прилетает ИСКЛЮЧЕНИЕМ и раньше улетал мимо всех веток с ОсвободитьДокумент:
	// документ навсегда оставался в статусе 1, штатная отправка отвечала "уже взят другим
	// сеансом", а СнятьБрошенныеЗанятия потом снимала отметку и разрешала повтор - при том
	// что POST мог успеть создать документ у оператора. То есть уборка брошенных отметок
	// сама была источником дублей. Поймано 21.08.2026 на аварии Платформы.
	// Правило: если состояние у оператора неизвестно, документ НЕ освобождаем, а помечаем
	// статусом 10 - его уборка не трогает, и повтор не создаст второй экземпляр.
	ИдСозданного = "";
	Попытка

	Организация = ОрганизацияДокумента(Ссылка);

	// 2) Токен авторизации (0a+0b целиком на сервере: подпись и POST идут подряд - ts живёт секунды)
	Если НЕ ОбеспечитьТокен(Ложь, Организация) Тогда
		ОсвободитьДокумент(Ссылка);
		Результат.Статус = "Ошибка";
		Результат.Сообщение = "Не удалось получить токен авторизации (КЭП на сервере/подпись)";
		Возврат Результат;
	КонецЕсли;

	// 2a) Нет ли у оператора живого экземпляра этого документа для ЭТОГО же получателя.
	// Занятие документа (1a) защищает от параллельных прогонов, но НЕ от переотправки:
	// она начинается со снятия нашей же отметки, и после этого база не помнит ничего.
	// Замер 06.09.2026: с 18.08 контрагенты получили 113 точных дублей, 75 из них -
	// одна партия переотправок 20.08, где адрес даже не менялся. Единственный источник
	// правды здесь - карточки у оператора, а не наши свойства.
	// Дубль != исправленная редакция: сверяем номер, дату и ПОЛУЧАТЕЛЯ; на другой адрес
	// тот же документ слать законно (так чинят "ушло не в тот ящик").
	Дубль = ЖивойЭкземплярУОператора(Ссылка);
	// Экземпляр в SENT получателю не доставлен. Повтор разрешает только человек при ручной отправке:
	// автоматика дубль не шлет никогда, а у абонентов 2VO и 2LT статус SENT бывает окончательным.
	Недоставлен = Дубль.Найден И ТипЗнч(Разрешения) = Тип("Структура")
		И ВРег(СокрЛП(Дубль.Статус)) = "SENT";
	Если Недоставлен И РазрешеноОператором(Разрешения, "ОтправитьПриНедоставленномЭкземпляре") Тогда
		ЗаписьЖР("ЭДО.ОтправкаПриНедоставленном", "Предупреждение", Ссылка.Метаданные(), Ссылка,
			"Документ отправлен повторно при недоставленном экземпляре " + Дубль.Ид + " по решению пользователя");
	ИначеЕсли Недоставлен Тогда
		ОсвободитьДокумент(Ссылка);
		Результат.Статус = "ТребуетВнимания";
		Результат.КодПричины = "НедоставленныйЭкземпляр";
		Результат.ИдДокумента = Дубль.Ид;
		Результат.Сообщение = "У оператора уже есть экземпляр этого документа (ид " + Дубль.Ид
			+ "), но получателю он не доставлен: статус SENT";
		Возврат Результат;
	ИначеЕсли Дубль.Найден Тогда
 // Экземпляр уже есть - приводим базу в соответствие с оператором и снимаем с очереди.
		ЗаписатьСтатусЭДО(Ссылка, 40, Дубль.Ид);
		ЗаписатьЧитаемыйСтатус(Ссылка, "Уже отправлен этому получателю");
		Результат.Статус = "Пропущен";
		Результат.ИдДокумента = Дубль.Ид;
		Если Дубль.Адрес = ВРег(СокрЛП(ИдентификаторУчастникаЭДО(Ссылка.Контрагент))) Тогда
			Результат.Сообщение = "У оператора уже есть экземпляр этого документа для того же"
				+ " получателя (ид " + Дубль.Ид + ", " + Дубль.Статус + ") — повтор дал бы дубль";
		Иначе
			Результат.Сообщение = "Контрагент уже подписал экземпляр этого документа на прежнем адресе "
				+ Дубль.Адрес + " (ид " + Дубль.Ид + ") - повтор на новый адрес дал бы дубль";
		КонецЕсли;
		Возврат Результат;
	ИначеЕсли НЕ Дубль.Опрошено Тогда
 // Молчание оператора - НЕ разрешение слать. Документ остаётся занятым и вернётся
 // в очередь следующим прогоном, когда оператор ответит.
		ОсвободитьДокумент(Ссылка);
		Результат.Статус = "ТребуетВнимания";
		Результат.Сообщение = "Не удалось проверить у оператора, не отправлялся ли документ ранее"
			+ ?(ЗначениеЗаполнено(Дубль.Причина), " (" + Дубль.Причина + ")", "")
			+ " — отправка отложена";
		Возврат Результат;
	КонецЕсли;

	Если Дубль.НаПрежнемАдресе <> Неопределено Тогда
		ЗаписьЖР("ЭДО.ОтправкаПриЭкземпляреНаПрежнемАдресе", "Информация", Ссылка.Метаданные(), Ссылка,
			"На прежнем адресе " + Дубль.НаПрежнемАдресе.Адрес + " есть неподписанный экземпляр "
			+ Дубль.НаПрежнемАдресе.Ид + " (" + Дубль.НаПрежнемАдресе.Статус + "), отправляем на текущий адрес");
	КонецЕсли;

	// 3) Подготовка XML + ФЛК, один перевыпуск токена по 401
	// Контекст собирается ЗДЕСЬ, а не в начале функции: на документе, отсеянном проверкой
	// готовности или занятием, движок не нужен вовсе. Повторный вызов по 401 переиспользует
	// уже собранный - прежде он собирал движок заново.
	Если Контекст = Неопределено Тогда
		Контекст = НовыйКонтекстПрогона();
	КонецЕсли;
	// Контекст общий на пакет - метку сбрасываем на каждый документ.
	Контекст.Вставить("ЗапросКОператоруУшел", Ложь);
	// ФИО покупателя-ИП нужно маппингу до сборки XML: без него документ уходит без имени покупателя.
	ОбеспечитьФИОИП(Ссылка.Контрагент, Контекст);
	Подготовка = ПодготовитьДокументИФЛК(Ссылка, Контекст);
	Если Подготовка.Статус = "НуженТокен" И ОбеспечитьТокен(Истина, Организация) Тогда
		Подготовка = ПодготовитьДокументИФЛК(Ссылка, Контекст);
	КонецЕсли;
	Если Подготовка.Статус = "Отсеян" Тогда
		ОсвободитьДокумент(Ссылка);
		Результат.Статус = "Отсеян";
		Результат.Сообщение = Подготовка.Сообщение;
		Возврат Результат;
	ИначеЕсли Подготовка.Статус <> "ОК" Тогда
		ОсвободитьДокумент(Ссылка);
		Результат.Статус = "Ошибка";
		Результат.Сообщение = ?(Подготовка.Статус = "НуженТокен",
			"Не удалось авторизоваться (401 после перевыпуска токена)", Подготовка.Сообщение);

		// Адрес получателя больше не существует у оператора: снимаем его, чтобы регламент
		// связей подобрал живой, иначе документ повторяет тот же отказ каждый прогон.
		Если ОтветГоворитЧтоАдресаНет(Подготовка.Сообщение) Тогда
			Снятие = СнятьПротухшийАдресКонтрагента(Ссылка.Контрагент);
			Результат.Статус = "ТребуетВнимания";
			Результат.Сообщение = Снятие;
		КонецЕсли;

		Возврат Результат;
	КонецЕсли;
	Результат.ИдДокумента = Подготовка.ИдДокумента;

	// ПАТЧ-ИД-СРАЗУ: с этой строки документ УЖЕ СОЗДАН у оператора (POST /documents вернул id).
	// Фиксируем id в базе НЕМЕДЛЕННО, до подписи и до присоединения.
	// Мотив: ниже два HTTP-вызова, и таймаут прилетает ИСКЛЮЧЕНИЕМ, а не статусом -
	// оно улетает мимо всех веток с ЗаписатьСтатусЭДО. Документ остаётся созданным у оператора
	// и неизвестным базе, а следующий прогон отправляет его заново - ДУБЛЬ у контрагента.
	// Поймано 21.08.2026 на аварии Платформы (около 40 % запросов уходили в таймаут):
	// два документа из четырёх зависших оказались у оператора без id в базе.
	// Тот же класс, что инцидент 17.08.2026 с 593 задвоенными накладными.
	// Статус 20 = "создан у оператора, не отправлен"; при успехе ниже он перезапишется на 40.
	ЗаписатьСтатусЭДО(Ссылка, 20, Подготовка.ИдДокумента);
	ИдСозданного = Подготовка.ИдДокумента;

	// 4) Подпись титула (отсоединённая CMS) - на сервере
	ПодписьДокумента = ПодписатьДанные(Подготовка.ДвоичныеXML, Организация);
	Если ПодписьДокумента = Неопределено Тогда
 // документ у оператора УЖЕ создан - фиксируем его id и НЕ освобождаем:
 // повторная отправка создала бы второй экземпляр
		ЗаписатьСтатусЭДО(Ссылка, 20, Подготовка.ИдДокумента);
		Результат.Статус = "ТребуетВнимания";
		Результат.Сообщение = "Документ создан у оператора (id " + Подготовка.ИдДокумента
			+ "), но не подписан КЭП — завершить/удалить вручную";
		Возврат Результат;
	КонецЕсли;

	// 5) Присоединение подписи (отправка стартует) + write-back, один перевыпуск по 401
	Присоединение = ПрисоединитьПодписьИЗаписать(Ссылка, Подготовка.ИдДокумента, ПодписьДокумента);
	Если Присоединение.Статус = "НуженТокен" И ОбеспечитьТокен(Истина, Организация) Тогда
		Присоединение = ПрисоединитьПодписьИЗаписать(Ссылка, Подготовка.ИдДокумента, ПодписьДокумента);
	КонецЕсли;

	Если Присоединение.Статус = "Отправлен" Тогда
		Результат.Статус = "Отправлен";
		ЗаписатьВЖурналОтправку(Ссылка, Подготовка.ИдДокумента);
 // Свой статус пишет тот, кто знает факт: отправка стартовала здесь и сейчас. Без этой
 // строки в колонке до первого прогона сверки оставалась прежняя подсказка ("Ждет печати",
 // "В очереди на отправку"), и её приходилось затирать ядру, лезущему в чужую зону.
		ЗаписатьЧитаемыйСтатус(Ссылка, "Отправляется");
	Иначе
		ЗаписатьСтатусЭДО(Ссылка, 20, Подготовка.ИдДокумента);
		Результат.Статус = "Ошибка";
		Результат.Сообщение = ?(Присоединение.Статус = "НуженТокен",
			"Не удалось авторизоваться при присоединении подписи", Присоединение.Сообщение);
	КонецЕсли;

	Исключение
		Ошибка = ИнформацияОбОшибке();
		ЗапросУшел = ТипЗнч(Контекст) = Тип("Структура") И Контекст.Свойство("ЗапросКОператоруУшел")
			И Контекст.ЗапросКОператоруУшел = Истина;
		Если ЗначениеЗаполнено(ИдСозданного) Тогда
 // документ у оператора создан - фиксируем id, освобождать НЕЛЬЗЯ
			ЗаписатьСтатусЭДО(Ссылка, 20, ИдСозданного);
			Результат.ИдДокумента = ИдСозданного;
			Результат.Сообщение = "Связь оборвалась после создания документа у оператора (id "
				+ ИдСозданного + "): " + КраткоеПредставлениеОшибки(Ошибка);
		ИначеЕсли НЕ ЗапросУшел Тогда
 // Упали на сборке, до запроса к оператору: у него ничего не создано, повтор дубля не даст.
 // Раньше этот случай тоже получал статус 10 "состояние неизвестно" - и документ,
 // отказанный контрагентом, больше не переотправлялся (moroz 23.09.2026, ТБ-00044393).
			ОсвободитьДокумент(Ссылка);
			ЗаписьЖурналаРегистрации("ЭДО.Отправка", УровеньЖурналаРегистрации.Ошибка,
				, Ссылка, "Ошибка до обращения к оператору: " + ПодробноеПредставлениеОшибки(Ошибка));
			Результат.Статус = "Ошибка";
			Результат.Сообщение = "Документ не отправлен, у оператора ничего не создано: "
				+ ТекстПричиныОшибки(Ошибка);
			Возврат Результат;
		Иначе
 // POST мог пройти и не вернуть ответ - состояние у оператора НЕИЗВЕСТНО.
 // Статус 10 уборка брошенных отметок не снимает: повтор не создаст второй
 // экземпляр, пока состояние не проверят у оператора по номеру накладной.
			ЗаписатьСтатусЭДО(Ссылка, 10, "");
			Результат.Сообщение = "Отправка прервана связью, состояние у оператора неизвестно —"
				+ " проверить по номеру: " + ТекстПричиныОшибки(Ошибка);
		КонецЕсли;
		Результат.Статус = "ТребуетВнимания";
		ЗаписьЖурналаРегистрации("ЭДО.Отправка", УровеньЖурналаРегистрации.Ошибка,
			, Ссылка, Результат.Сообщение + Символы.ПС + ПодробноеПредставлениеОшибки(Ошибка));
	КонецПопытки;

	Возврат Результат;
КонецФункции

// Текст ошибки вместе с ее первопричиной. Краткое представление отдает только верхний
// уровень ("Ошибка при вызове метода контекста (Создать)"), а что именно не создалось,
// лежит во вложенной причине.
Функция ТекстПричиныОшибки(Знач Ошибка) Экспорт

	Текст = КраткоеПредставлениеОшибки(Ошибка);
	Причина = Ошибка.Причина;
	Пока Причина <> Неопределено Цикл
		Если ЗначениеЗаполнено(Причина.Описание) И СтрНайти(Текст, Причина.Описание) = 0 Тогда
			Текст = Текст + ": " + Причина.Описание;
		КонецЕсли;
		Причина = Причина.Причина;
	КонецЦикла;
	Возврат Текст;

КонецФункции

// Факт отправки в журнал регистрации: ЧТО ушло, КОМУ, КОГДА и ПОД КЕМ.
//
// Предложение оператора 07.09.2026, и повод у него измеренный: разбирая 4 накладные ЕНВД,
// ушедшие мимо очереди, установить ПУТЬ отправки не удалось вовсе - в логах прогонов их нет,
// а других следов не остаётся. Свойство ЭДО_КодСостояния говорит "отправлен", но не говорит
// ни кем, ни откуда. - пишем след, по которому такой разбор возможен.
//
// Пользователь сеанса фиксируется журналом сам, но этого мало: регламент идёт под служебным
// пользователем, и по одному имени "отправил человек" от "отправил регламент" не отличить.
// Поэтому источник пишем явно.
// Отправку ронять НЕЛЬЗЯ: документ у оператора уже создан и подписан, и падение на записи
// лога означало бы "ушёл, но база считает иначе". Отсюда Попытка вокруг всего.
Процедура ЗаписатьВЖурналОтправку(Знач Ссылка, Знач ИдДокумента) Экспорт

	Попытка
 // Источник считается ОТДЕЛЬНОЙ Попыткой, а не вместе с записью. 07.09.2026 здесь
 // стоял вымышленный `ФоновыеЗадания.ТекущееФоновоеЗадание()` - такого метода нет,
 // вызов падал на первой строке, и общая Попытка глушила его молча: за прогон ушло
 // 47 документов и НИ ОДНОЙ строки в журнале. Ровно та болезнь, ради которой журнал
 // и заводился. - неизвестный источник не должен отменять саму запись.
 // Фоновое задание отличаем по имени приложения сеанса: "BackgroundJob" у регламента,
 // "1CV8"/"WebClient" у человека.
		Источник = "источник не определён";
		Попытка
			Приложение = ПолучитьТекущийСеансИнформационнойБазы().ИмяПриложения;
			Источник = ?(Приложение = "BackgroundJob", "регламент",
				"ручная отправка (" + Приложение + ")");
		Исключение
			Источник = "источник не определён";
		КонецПопытки;

		Контрагент = "";
		Попытка
			Контрагент = Строка(Ссылка.Контрагент);
		Исключение
			Контрагент = "";
		КонецПопытки;

		Текст = "Отправлен по ЭДО: " + Строка(Ссылка)
			+ ?(ЗначениеЗаполнено(Контрагент), "; контрагент " + Контрагент, "")
			+ "; id у оператора " + Строка(ИдДокумента)
			+ "; источник — " + Источник
			+ "; пользователь ИБ " + ИмяПользователя();

		ЗаписьЖурналаРегистрации("ЭДО.Отправка", УровеньЖурналаРегистрации.Информация,
			Ссылка.Метаданные(), Ссылка, Лев(Текст, 5000));
	Исключение
 // молча: документ уже ушёл, и отсутствие строки в журнале - меньшее из зол
	КонецПопытки;

КонецПроцедуры

// Сверка: расходятся ли ОТБОР очереди и ПРОВЕРКА перед отправкой.
//
// Страховка от главной болезни этого механизма - гейт, заведённый в одном месте из двух.
// Она уже стоила дважды: лишнее ушло мимо очереди (4 накладные ЕНВД), нужное встало
// в очереди (07.09.2026, отправка не шла двадцать прогонов). Оба раза отказ был ТИХИМ.
// Сверка идёт в одну сторону - берём то, что отобрала очередь, и спрашиваем проверку.
// Обратную сторону (документ прошёл бы проверку, но отбор его не видит) так не поймать:
// кандидатов на неё - вся база. Её ловит сама очередь: растущий остаток при нулевой отправке.
// Только ЧИТАЕТ. Ничего не отправляет и не помечает - годится для боевой базы.
//
// Возврат: Структура (Проверено, Расхождений, Строки) - Строки для лога регламента.
Функция СверитьГейтыОтбораИПроверки(Знач Лимит = 20) Экспорт

	Результат = Новый Структура("Проверено, Расхождений, Строки", 0, 0, Новый Массив);
	Т = ДокументыКОтправке();
	Сколько = Мин(Лимит, Т.Количество());

	Для Инд = 0 По Сколько - 1 Цикл
		Стр = Т[Инд];
		Результат.Проверено = Результат.Проверено + 1;
		Готовность = ПроверитьГотовностьКОтправке(Стр.Ссылка);
		Если Готовность.Готов Тогда
			Продолжить;
		КонецЕсли;
 // Причины, снимаемые ВРЕМЕНЕМ, расхождением не считаются: коды маркировки появятся
 // после сканирования, роуминг - после принятия приглашения. Документ обязан стоять
 // в очереди и ждать. Расхождение - это причина ПОСТОЯННАЯ, то есть та, по которой
 // документ не уйдёт никогда, а место в лимите занимает каждый прогон.
		Если СтрНайти(Готовность.Причина, "Нет кодов маркировки") > 0
			ИЛИ СтрНайти(Готовность.Причина, "роуминг по нему не подтверждён") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Результат.Расхождений = Результат.Расхождений + 1;
		Результат.Строки.Добавить("РАСХОЖДЕНИЕ ГЕЙТОВ " + СокрЛП(Стр.Номер)
			+ ": отбор взял, проверка держит — " + Лев(Готовность.Причина, 160));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Программная отправка МАССИВА документов (сервер). Токен берётся один раз на пакет,
// перевыпуск по 401 - внутри Доп_ОтправитьПоЭДО. "Чистые" уходят, исключения помечаются.
// Возврат: Массив структур-результатов (как у Доп_ОтправитьПоЭДО).
Функция ОтправитьМассивПоЭДО(МассивСсылок) Экспорт
	// Замок на прогон: 17.08 две параллельные отправки задвоили 593 накладные.
	// Замок держится 30 минут и продлевается по ходу; снимается в конце прогона.
	Если НЕ ЗанятьПрогонОтправки() Тогда
		Отказ = Новый Массив;
		Отказ.Добавить(Новый Структура("Ссылка, Статус, ИдДокумента, Сообщение",
			Неопределено, "Пропущен", "",
			"Массовая отправка уже выполняется другим сеансом — повторный запуск отклонён"));
		Возврат Отказ;
	КонецЕсли;

	// Прерванный прогон (обрыв HTTP, перезапуск сервера) оставляет документы в статусе
	// "взят в отправку" - без уборки они не отправятся уже никогда. Замок мы держим,
	// значит других прогонов нет и все такие отметки заведомо брошенные.
	Брошенных = СнятьБрошенныеЗанятия();
	Если Брошенных > 0 Тогда
		ЗаписьЖурналаРегистрации("ЭДО.Отправка", УровеньЖурналаРегистрации.Информация, , ,
			"снято брошенных отметок «взят в отправку»: " + Брошенных);
	КонецЕсли;

	Результаты = Новый Массив;
	Попытка
 // Движок и настройки собираются ОДИН раз на весь пакет, а не на каждый документ:
 // замер 28.08.2026 на боевой - 125 мс на документ (запись клиентских настроек 78 мс,
 // ШтатныйЗапуск 46 мс) - на 500 накладных лишняя минута и 500 записей
 // в ХранилищеОбщихНастроек впустую.
		Контекст = ?(МассивСсылок.Количество() > 0, НовыйКонтекстПрогона(), Неопределено);
		Обработано = 0;
		Для Каждого Ссылка Из МассивСсылок Цикл
			Результаты.Добавить(ОтправитьПоЭДО(Ссылка, Контекст));
			Обработано = Обработано + 1;
			Если Обработано % 50 = 0 Тогда
				ЗанятьПрогонОтправки();   // продлеваем замок на длинном пакете
			КонецЕсли;
		КонецЦикла;
	Исключение
		ОсвободитьПрогонОтправки();
		ВызватьИсключение;
	КонецПопытки;
	ОсвободитьПрогонОтправки();
	Возврат Результаты;
КонецФункции

// Отправка одного документа по решению человека: карточка документа и разбор Центра
// управления. Отличие от очереди - документ, уже получивший отметку отправки, уходит
// повторно (человек видел, что он отправлен, и все равно нажал), а гейт, который
// оператор вправе снять, снимается только переданным кодом причины.
// Возврат: Структура (Ссылка, Успех, Заголовок, Текст, КодПричины, ГейтПреодолим).
// ГейтПреодолим = Истина - документ уперся в гейт, который человек вправе снять повторным
// вызовом с этим кодом причины; спросить его об этом - дело формы.
Функция ОтправитьВручную(Знач Ссылка, Знач ПреодолеваемыйГейт = "") Экспорт

	Итог = Новый Структура("Ссылка, Успех, Заголовок, Текст, КодПричины, ГейтПреодолим",
		Ссылка, Ложь, "Документ не отправлен", "", "", Ложь);

	СвойствоСтатус = СвойствоОбъектов("ЭДО_КодСостояния");
	ЕстьСвойство = СвойствоСтатус <> Неопределено И НЕ СвойствоСтатус.Пустая();
	ПрежнийСтатус = ?(ЕстьСвойство, ЗначениеСвойстваОбъекта(Ссылка, СвойствоСтатус), Неопределено);

	ОтметкуСнялиЗдесь = Ложь;
	Если ЗначениеЗаполнено(ПрежнийСтатус) Тогда
		КодСтатуса = 0;
		Попытка
			КодСтатуса = Число(ПрежнийСтатус);
		Исключение
			КодСтатуса = 0;
		КонецПопытки;
		Если КодСтатуса = 1 Тогда
			Итог.Текст = "Документ прямо сейчас взят в отправку другим сеансом (регламент или соседний"
				+ " пользователь). Подождите и повторите.";
			Возврат Итог;
		КонецЕсли;
		// Статус 10 (состояние у оператора неизвестно) не снимаем: ОтправитьПоЭДО сама спросит
		// оператора через РазобратьПрерваннуюОтправку и отправит, только если живого экземпляра нет.
		// Прежде здесь стоял запрет с отсылкой в личный кабинет - он остался от времени, когда
		// автоматического разбора не было, и блокировал переотправку насовсем.
		Если КодСтатуса <> 10 Тогда
			// Без снятия отметки ОтправитьПоЭДО отвечает "Документ уже отправлялся (статус ЭДО 40)"
			// и ничего не делает. ОсвободитьДокумент для этого не годится: она снимает только
			// свою отметку "взят" (статус 1).
			Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
			Набор.Отбор.Объект.Установить(Ссылка);
			Набор.Отбор.Свойство.Установить(СвойствоСтатус);
			Набор.Записать();
			ОтметкуСнялиЗдесь = Истина;
		КонецЕсли;
	КонецЕсли;

	// "Не отправлен по решению механизма" - это НЕ поломка: удержание до выяснения канала,
	// отсев и занятость документа другим сеансом. Ошибкой считаем только сбой отправки,
	// иначе пользователь идет чинить то, что работает как задумано.
	Успех = Ложь;
	ЭтоОшибка = Истина;
	Попытка
		Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.АктСверкиВзаиморасчетов") Тогда
			// У акта сверки другой формат ФНС и свой сборщик XML.
			Результат = ОтправитьАктСверкиПоЭДО(Ссылка);
		Иначе
			Разрешения = НовыеРазрешенияОператора();
			Разрешения.ОтправитьРаньшеДатыНачала = (ПреодолеваемыйГейт = "ДатаНачалаОтправки");
			Разрешения.ОтправитьПовторноПослеСБИС = (ПреодолеваемыйГейт = "ОтправлялсяЧерезСБИС");
			Разрешения.ОтправитьПриНедоставленномЭкземпляре = (ПреодолеваемыйГейт = "НедоставленныйЭкземпляр");
			Результат = ОтправитьПоЭДО(Ссылка, , Разрешения);
		КонецЕсли;
		// Код причины есть не у всех точек входа (у акта сверки своя) - читаем через Свойство.
		КодОтказа = "";
		Результат.Свойство("КодПричины", КодОтказа);
		Итог.КодПричины = КодОтказа;
		Успех = (Результат.Статус = "Отправлен");
		ЭтоОшибка = НЕ Успех
			И Результат.Статус <> "ТребуетВнимания"
			И Результат.Статус <> "Отсеян"
			И Результат.Статус <> "Пропущен";
		// Пользователю нужна ПРИЧИНА, а не внутренний статус механизма (замечание оператора 07.09).
		Итог.Текст = ?(ЗначениеЗаполнено(Результат.Сообщение), Результат.Сообщение,
			?(Успех, "Отправлен", "Механизм отправки документ не пропустил"))
			+ ?(ЗначениеЗаполнено(Результат.ИдДокумента),
				" (карточка " + Строка(Результат.ИдДокумента) + ")", "");
	Исключение
		Итог.Текст = "Ошибка отправки: " + ТекстПричиныОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Отметку сняли ДО отправки, и если отправка не удалась, документ остается "никогда не
	// отправлявшимся" - ближайший прогон очереди отправит его сам, хотя экземпляр у оператора
	// уже есть. Возвращаем прежний статус на место.
	Если НЕ Успех И ОтметкуСнялиЗдесь Тогда
		Если НЕ ЗначениеЗаполнено(ЗначениеСвойстваОбъекта(Ссылка, СвойствоСтатус)) Тогда
			ЗаписатьЗначениеСвойства(Ссылка, СвойствоСтатус, ПрежнийСтатус);
			Итог.Текст = Итог.Текст + " Прежняя отметка отправки возвращена на место.";
		КонецЕсли;
	КонецЕсли;

	Итог.Успех = Успех;
	Итог.ГейтПреодолим = НЕ Успех И ГейтПреодолимОператором(Итог.КодПричины);
	Если Успех Тогда
		Итог.Заголовок = "Отправлен в ЭДО";
	ИначеЕсли ЭтоОшибка Тогда
		Итог.Заголовок = "Ошибка отправки";
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Гейты, которые человек вправе снять сам: документ старше даты начала работы с оператором,
// документ, уходивший через СБИС, и экземпляр у оператора, не доставленный получателю.
// Во всех трех случаях знает не механизм, а человек, у которого на руках переписка с контрагентом.
Функция ГейтПреодолимОператором(Знач КодПричины) Экспорт

	Возврат КодПричины = "ДатаНачалаОтправки" ИЛИ КодПричины = "ОтправлялсяЧерезСБИС"
		ИЛИ КодПричины = "НедоставленныйЭкземпляр";

КонецФункции

// Текст причины из карточки оператора (квитанции или уведомления в цепочке документа).
// У SENDING_FAILURE_ACK причина лежит в reason ВЕРХНЕГО уровня, а у прочих - в extra.reason.
// Читая только extra.reason, получаешь пустоту ровно там, где причина и нужна.
Функция ПричинаКарточкиОператора(Знач Карточка) Экспорт

	Если ТипЗнч(Карточка) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Если Карточка.Свойство("extra") И ТипЗнч(Карточка.extra) = Тип("Структура")
		И Карточка.extra.Свойство("reason") И Карточка.extra.reason <> Неопределено Тогда
		Значение = СокрЛП(Строка(Карточка.extra.reason));
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Лев(Значение, 500);
		КонецЕсли;
	КонецЕсли;
	Если Карточка.Свойство("reason") И Карточка.reason <> Неопределено Тогда
		Возврат Лев(СокрЛП(Строка(Карточка.reason)), 500);
	КонецЕсли;
	Возврат "";

КонецФункции

// Причины отказа по идентификаторам карточек у оператора.
//
// Причины в самой карточке документа НЕТ вовсе: она лежит в ЦЕПОЧКЕ (document-flows),
// в подчиненных - уведомлении об уточнении от контрагента или квитанции об ошибке ФЛК.
// Возврат: Соответствие (идентификатор строкой -> текст причины). Документ, по которому
// цепочка пришла, но текста в ней нет, попадает с пустой строкой: контрагент отказал
// без объяснений, и это тоже ответ. Неотвеченных в соответствии нет.
Функция ПричиныОтказаПоИдентификаторам(Знач Идентификаторы, Знач Организация = Неопределено) Экспорт

	Итог = Новый Соответствие;
	Если Идентификаторы.Количество() = 0 ИЛИ НЕ ОбеспечитьТокен(Ложь, Организация) Тогда
		Возврат Итог;
	КонецЕсли;

	Соед = СоединениеСОператором();
	// page_size у document-flows не больше 50, иначе HTTP 400.
	РазмерПачки = 50;
	Индекс = 0;
	Пока Индекс < Идентификаторы.Количество() Цикл
		Пачка = Новый Массив;
		Пока Индекс < Идентификаторы.Количество() И Пачка.Количество() < РазмерПачки Цикл
			Пачка.Добавить(СокрЛП(Строка(Идентификаторы[Индекс])));
			Индекс = Индекс + 1;
		КонецЦикла;

		// Две попытки: токен живет 15 минут, и 401 на втором заходе - штатное дело.
		Ответ = Неопределено;
		Для НомерПопытки = 1 По 2 Цикл
			Запрос = Новый HTTPЗапрос(ПутьСервиса("document") + "/public/api/v3/document-flows?id="
				+ СтрСоединить(Пачка, ",") + "&page=0&page_size=" + РазмерПачки);
			Запрос.Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));
			Запрос.Заголовки.Вставить("accept", "application/json;charset=UTF-8");
			Попытка
				Ответ = Соед.Получить(Запрос);
			Исключение
				Ответ = Неопределено;
				Прервать;
			КонецПопытки;
			Если Ответ.КодСостояния = 401 И НомерПопытки = 1 Тогда
				ОбеспечитьТокен(Истина, Организация);
				Продолжить;
			КонецЕсли;
			Прервать;
		КонецЦикла;
		// Причина - подсказка к списку, а не сам список: не ответила пачка - остаемся без нее.
		Если Ответ = Неопределено ИЛИ Ответ.КодСостояния <> 200 Тогда
			Продолжить;
		КонецЕсли;

		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
		Цепочки = ПрочитатьJSON(Чтение, Ложь);
		Чтение.Закрыть();
		Если ТипЗнч(Цепочки) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Цепочка Из Цепочки Цикл
			Если ТипЗнч(Цепочка) <> Тип("Структура") ИЛИ НЕ Цепочка.Свойство("id") Тогда
				Продолжить;
			КонецЕсли;
			// Идентификатор из JSON приходит числом, а Строка() дала бы "172 751 616".
			Ид = ?(ТипЗнч(Цепочка.id) = Тип("Число"), Формат(Цепочка.id, "ЧГ=0"), СокрЛП(Строка(Цепочка.id)));
			ТекстПричины = "";
			Если Цепочка.Свойство("slaves") И ТипЗнч(Цепочка.slaves) = Тип("Массив") Тогда
				Для Каждого Подчиненный Из Цепочка.slaves Цикл
					Найденная = ПричинаКарточкиОператора(Подчиненный);
					Если ЗначениеЗаполнено(Найденная) Тогда
						ТекстПричины = Найденная;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Итог.Вставить(Ид, ТекстПричины);
		КонецЦикла;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Причины отказа по документам базы - через сохраненный идентификатор карточки.
// Возврат: Соответствие (Ссылка -> текст причины); документы без карточки не попадают.
Функция ПричиныОтказаДокументов(Знач МассивСсылок) Экспорт

	Итог = Новый Соответствие;
	СвойствоИд = СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если МассивСсылок.Количество() = 0 ИЛИ СвойствоИд = Неопределено ИЛИ СвойствоИд.Пустая() Тогда
		Возврат Итог;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Ид.Объект КАК Ссылка,
		|	ВЫРАЗИТЬ(Ид.Значение КАК СТРОКА(50)) КАК ИдЭДО
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК Ид
		|ГДЕ
		|	Ид.Свойство = &СвойствоИд
		|	И Ид.Объект В (&Ссылки)");
	Запрос.УстановитьПараметр("СвойствоИд", СвойствоИд);
	Запрос.УстановитьПараметр("Ссылки", МассивСсылок);
	ДокументПоИд = Новый Соответствие;
	Идентификаторы = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ид = СокрЛП(Строка(Выборка.ИдЭДО));
		Если ЗначениеЗаполнено(Ид) И ДокументПоИд.Получить(Ид) = Неопределено Тогда
			ДокументПоИд.Вставить(Ид, Выборка.Ссылка);
			Идентификаторы.Добавить(Ид);
		КонецЕсли;
	КонецЦикла;

	// Спрашивать оператора надо токеном организации документа.
	Если НЕ НесколькоУчетныхЗаписейЭДО() Тогда
		Причины = ПричиныОтказаПоИдентификаторам(Идентификаторы);
	Иначе
		ПоОрганизациям = Новый Соответствие;
		Для Каждого Ид Из Идентификаторы Цикл
			Организация = ОрганизацияДокумента(ДокументПоИд.Получить(Ид));
			Ключ = ?(Организация = Неопределено, "", Организация);
			Группа = ПоОрганизациям.Получить(Ключ);
			Если Группа = Неопределено Тогда
				Группа = Новый Массив;
				ПоОрганизациям.Вставить(Ключ, Группа);
			КонецЕсли;
			Группа.Добавить(Ид);
		КонецЦикла;
		Причины = Новый Соответствие;
		Для Каждого Группа Из ПоОрганизациям Цикл
			Если НЕ ЗначениеЗаполнено(Группа.Ключ) Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Причина Из ПричиныОтказаПоИдентификаторам(Группа.Значение, Группа.Ключ) Цикл
				Причины.Вставить(Причина.Ключ, Причина.Значение);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Для Каждого КлючИЗначение Из Причины Цикл
		Ссылка = ДокументПоИд.Получить(КлючИЗначение.Ключ);
		Если Ссылка <> Неопределено Тогда
			Итог.Вставить(Ссылка, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Доступна ли подпись в СЕРВЕРНОМ контексте (сертификат подписанта виден рабочему процессу).
// Используется клиентским фасадом для выбора "сервер или клиентский фолбэк"
// и как быстрый чек при настройке нового сервера/учётки службы.
// Без организации отвечает по ВСЕМ учетным записям: доступна, когда сертификат найден
// у каждой. Спрашивают об этом формы и сводка контура, и падать им незачем - в отличие от
// подписания, где организация обязательна.
Функция ПодписьНаСервереДоступна(Знач Организация = Неопределено) Экспорт

	Если ЗначениеЗаполнено(Организация) Тогда
		Возврат СертификатПодписанта(Организация) <> Неопределено;
	КонецЕсли;

	Записи = УчетныеЗаписиЭДО();
	Если Записи.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Запись Из Записи Цикл
		Если СертификатПодписанта(Запись.Организация) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Проверка готовности документа к отправке - ДО любого обращения к API.
// Возврат: Структура (Готов Булево, Причина Строка, ОтправкаНеТребуется Булево).
// ОтправкаНеТребуется = Истина означает "этот документ по ЭДО не поедет никогда" -
// не ошибка и не повод для внимания; вызывающий помечает документ и снимает его с очереди.
// Причина, по которой организация документа не вправе отправлять по ЭДО ("" - вправе).
// Текст причины человеческий и НАЗЫВАЕТ организацию: в базе с двумя похожими организациями
// ("Дворников" и "Дворников***") сообщение без имени не даёт понять, что именно не так.
Функция ПричинаЗапретаПоОрганизации(Ссылка) Экспорт

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	Организация = Неопределено;
	Попытка
		Организация = Ссылка.Организация;
	Исключение
		Возврат "";   // у документа нет реквизита «Организация» — проверять нечего
	КонецПопытки;
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат "В документе не заполнена организация";
	КонецЕсли;

	Свойство = СвойствоОбъектов("ЭДО_РазрешенаОтправка");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
 // Свойства нет - механизм не настроен. Молча разрешать нельзя (ровно так ушли
 // 440 дублей), но и отказ обязан быть диагностируемым, а не "документ не готов".
		Возврат "Свойство «ЭДО_РазрешенаОтправка» не заведено в базе. Открой обработку «Помощник»"
			+ " — обеспечение свойств заведёт его, затем поставь флаг рабочей организации.";
	КонецЕсли;

	Значение = ЗначениеСвойстваОбъекта(Организация, Свойство);
	Разрешено = Ложь;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Разрешено = Значение;
	ИначеЕсли Значение <> Неопределено Тогда
		Текст = ВРег(СокрЛП(Строка(Значение)));
		Разрешено = (Текст = "ДА" ИЛИ Текст = "ИСТИНА" ИЛИ Текст = "TRUE" ИЛИ Текст = "1");
	КонецЕсли;

	Если Разрешено Тогда
		Возврат "";
	КонецЕсли;
	Возврат "Организация «" + Строка(Организация) + "» не разрешена для отправки по ЭДО."
		+ " Поставь ей флаг «ЭДО_РазрешенаОтправка», если документы этой организации"
		+ " действительно должны уходить контрагентам.";

КонецФункции

// Условия, которые есть в ОТБОРЕ очереди, проверенные поштучно.
//
// ЗАЧЕМ ДУБЛИРОВАНИЕ. У отправки два входа: очередь (регламент) и ручной - кнопка
// в карточке, вызов ядра из другого кода, отправка из формы списка. Отбор видит только
// первый. Пока гейт стоял в одном месте, каждый вход пропускал свою беду:
// - бухучёт и статус заказа жили ТОЛЬКО в отборе - мимо очереди уходило лишнее
// (4 накладные ЕНВД, 85 896,60 руб);
// - пауза и канал вне автовыбора - ТОЛЬКО в проверке - удержанные забивали лимит
// прогона и отправка вставала целиком (07.09.2026, 290 документов на 3,27 млн руб).
// каждый гейт обязан стоять В ОБОИХ местах. Расхождение ловит СверитьГейтыОтбораИПроверки().
//
// ПОМЕТКА К ОТПРАВКЕ СЮДА НЕ ВХОДИТ намеренно. В отборе она отвечает на вопрос "пора ли
// слать сам", а человек, нажавший "Отправить", уже ответил на него руками. Продублировать
// её здесь значило бы сломать ручную отправку непечатанного документа - а это штатный путь
// (см. историю окна страховки: 05.09.2026 кнопка молчала на документах старше 30 дней).
//
// Разрешения, которые оператор даёт РУЧНОЙ отправке, ответив на вопрос в карточке.
// Автоматика их не выдаёт никогда: очередь и регламенты зовут проверку без разрешений.
Функция НовыеРазрешенияОператора() Экспорт

	Возврат Новый Структура("ОтправитьРаньшеДатыНачала, ОтправитьПовторноПослеСБИС, ОтправитьПриНедоставленномЭкземпляре",
		Ложь, Ложь, Ложь);

КонецФункции

// Дал ли оператор конкретное послабление. Разрешения могут быть не переданы вовсе -
// это штатный случай (весь автоматический путь), а не ошибка вызова.
Функция РазрешеноОператором(Знач Разрешения, Знач Имя)

	Если ТипЗнч(Разрешения) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Значение = Ложь;
	Возврат Разрешения.Свойство(Имя, Значение) И Значение = Истина;

КонецФункции

// Возврат: Строка - причина отказа, "" если условия отбора пройдены.
Функция ПричинаОтказаПоУсловиямОтбора(Ссылка, Знач Разрешения = Неопределено,
	КодПричины = "") Экспорт

	КодПричины = "";

	// Гейты ниже относятся к реализации: у акта сверки нет ни бухучёта, ни заказа.
	// У корректировки реализации проверяются бухучёт и дата начала отправки, прочее - заказное.
	// Пустая ссылка отсеивается ЗДЕСЬ, а не только у вызывающего: у пустой ссылки все
	// реквизиты пусты, и функция отвечала бы "не отражается в бухгалтерском учёте" -
	// формально верно, по смыслу вводит в заблуждение (поймано на приёмке 07.09.2026).
	ЭтоКорректировка = ТипЗнч(Ссылка) = Тип("ДокументСсылка.КорректировкаРеализации");
	Если НЕ ЗначениеЗаполнено(Ссылка)
		ИЛИ (ТипЗнч(Ссылка) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") И НЕ ЭтоКорректировка) Тогда
		Возврат "";
	КонецЕсли;

	// 1. Отражение в бухгалтерском учёте - тот самый гейт ЕНВД.
	Отражать = Истина;
	Попытка
		Отражать = Ссылка.ОтражатьВБухгалтерскомУчете;
	Исключение
		Отражать = Истина;   // реквизита нет в этой конфигурации — судить не по чему
	КонецПопытки;
	Если НЕ Отражать Тогда
		КодПричины = "БухгалтерскийУчет";
		Возврат "Документ не отражается в бухгалтерском учёте — по ЭДО такие не отправляем";
	КонецЕсли;

	// 2. Абсолютная отсечка: до неё документы ушли ПРЕЖНИМ оператором, повтор дал бы дубль.
	// Отсечка ПРЕОДОЛИМА оператором вручную (решение оператора 10.09.2026): контрагент
	// просит переотправить старый документ, а прежний канал у него уже не читается.
	// Разрешение приходит только из карточки, где человек ответил на вопрос про дубль;
	// очередь и регламенты зовут проверку без разрешений, и для них это по-прежнему запрет.
	// Дата начала - своя у каждой организации, из ее учетной записи.
	ОрганизацияДок = ОрганизацияДокумента(Ссылка);
	УчЗаписьОрганизации = УчетнаяЗаписьЭДО(ОрганизацияДок);
	Если УчЗаписьОрганизации = Неопределено Тогда
		КодПричины = "НетУчетнойЗаписи";
		Возврат "У организации «" + Строка(ОрганизацияДок) + "» не настроена учетная запись ЭДО"
			+ " — заполните её в настройках расширения";
	КонецЕсли;
	ГраницаАбсолютная = УчЗаписьОрганизации.ДатаНачалаОтправки;
	Если ЗначениеЗаполнено(ГраницаАбсолютная) И Ссылка.Дата < ГраницаАбсолютная Тогда
		Если РазрешеноОператором(Разрешения, "ОтправитьРаньшеДатыНачала") Тогда
			ЗаписьЖР("ЭДО.ОтправкаРаньшеДатыНачала", "Предупреждение", Ссылка.Метаданные(), Ссылка,
				"Документ от " + Формат(Ссылка.Дата, "ДФ=dd.MM.yyyy") + " отправлен раньше даты"
				+ " начала работы с оператором (" + Формат(ГраницаАбсолютная, "ДФ=dd.MM.yyyy")
				+ ") по решению пользователя: он предупреждён о возможном дубле у контрагента");
		Иначе
			КодПричины = "ДатаНачалаОтправки";
			Возврат "Документ от " + Формат(Ссылка.Дата, "ДФ=dd.MM.yyyy") + " старше даты начала"
				+ " отправки через этого оператора (" + Формат(ГраницаАбсолютная, "ДФ=dd.MM.yyyy")
				+ ") — он уходил прежним каналом, повтор дал бы контрагенту дубль";
		КонецЕсли;
	КонецЕсли;

	Если ЭтоКорректировка Тогда
		Возврат "";
	КонецЕсли;

	// 3. Уже ушёл через СБИС. Занятие документа этого не ловит: там свой код состояния,
	// а отметка СБИС осталась от прежнего оператора.
	// Отказ преодолим оператором на тех же условиях, что и отсечка по дате: причина одна
	// и та же - документ уходил прежним каналом.
	СвСБИС = СвойствоОбъектов("ДокументСБИС_Ид");
	Если СвСБИС <> Неопределено И НЕ СвСБИС.Пустая()
		И ЗначениеЗаполнено(ЗначениеСвойстваОбъекта(Ссылка, СвСБИС)) Тогда
		Если РазрешеноОператором(Разрешения, "ОтправитьПовторноПослеСБИС") Тогда
			ЗаписьЖР("ЭДО.ОтправкаПослеСБИС", "Предупреждение", Ссылка.Метаданные(), Ссылка,
				"Документ отправлен повторно, хотя уходил через СБИС, по решению пользователя:"
				+ " он предупреждён о возможном дубле у контрагента");
		Иначе
			КодПричины = "ОтправлялсяЧерезСБИС";
			Возврат "Документ уже отправлялся через СБИС — повтор дал бы контрагенту дубль";
		КонецЕсли;
	КонецЕсли;

	// 4. Заказ покупателя ещё не в готовом статусе. Гейта нет в конфигурации без заказа
	// или без перечисления статусов - см. ГейтСтатусаЗаказаПрименим().
	Если ГейтСтатусаЗаказаПрименим() Тогда
		Готовые = ГотовыеСтатусыЗаказа();
		Если Готовые.Количество() > 0 Тогда
			З = Новый Запрос;
			З.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1 Тов.ЗаказПокупателя КАК Заказ
				|ИЗ Документ.РеализацияТоваровУслуг.Товары КАК Тов
				|ГДЕ Тов.Ссылка = &Ссылка
				|	И Тов.ЗаказПокупателя <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
				|	И НЕ Тов.ЗаказПокупателя.Статус В (&ГотовыеСтатусы)";
			З.УстановитьПараметр("Ссылка", Ссылка);
			З.УстановитьПараметр("ГотовыеСтатусы", Готовые);
			В = З.Выполнить().Выбрать();
			Если В.Следующий() Тогда
				КодПричины = "СтатусЗаказа";
				Возврат "Заказ покупателя «" + Строка(В.Заказ) + "» ещё не в готовом статусе"
					+ " — отгрузка не завершена";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// 5. Дата отгрузки заказа ещё не наступила: документ уходит не раньше её.
	// Сегодняшняя отгрузка уходит сегодня - сравниваем начала дней, не моменты.
	Если ГейтДатыОтгрузкиПрименим() Тогда
		ЗД = Новый Запрос;
		ЗД.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Тов.ЗаказПокупателя КАК Заказ,
			|	Тов.ЗаказПокупателя.ДатаОтгрузки КАК ДатаОтгрузки
			|ИЗ Документ.РеализацияТоваровУслуг.Товары КАК Тов
			|ГДЕ Тов.Ссылка = &Ссылка
			|	И Тов.ЗаказПокупателя <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
			|	И НАЧАЛОПЕРИОДА(Тов.ЗаказПокупателя.ДатаОтгрузки, ДЕНЬ) > &СегодняНачалоДня
			|УПОРЯДОЧИТЬ ПО ДатаОтгрузки УБЫВ";
		ЗД.УстановитьПараметр("Ссылка", Ссылка);
		ЗД.УстановитьПараметр("СегодняНачалоДня", НачалоДня(ТекущаяДата()));
		ВД = ЗД.Выполнить().Выбрать();
		Если ВД.Следующий() Тогда
			КодПричины = "ДатаОтгрузки";
			Возврат "Заказ покупателя «" + Строка(ВД.Заказ) + "» отгружается "
				+ Формат(ВД.ДатаОтгрузки, "ДФ=dd.MM.yyyy") + " — раньше этой даты не отправляем";
		КонецЕсли;
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ПроверитьГотовностьКОтправке(Ссылка, Знач Разрешения = Неопределено) Экспорт
	// КодПричины нужен вызывающему, чтобы отличить преодолимый отказ от окончательного,
	// не разбирая текст сообщения. Пусто - причина без кода либо документ готов.
	Результат = Новый Структура("Готов, Причина, ОтправкаНеТребуется, КодПричины", Ложь, "", Ложь, "");
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Результат.Причина = "Пустая ссылка на документ";
		Возврат Результат;
	КонецЕсли;

	// Расширение не должно работать в ненастроенной базе. До 22.08.2026 такая база
	// падала в ошибку платформы ("не найден сертификат", "поле объекта не обнаружено"),
	// по которой невозможно понять, что именно не задано, - и настройку искали наугад.
	Недостающее = НедостающиеНастройкиЭДО();
	Если Недостающее.Количество() > 0 Тогда
		Результат.Причина = "Расширение не настроено — " + СтрСоединить(Недостающее, "; ")
			+ ". Открой настройки ЭДО в обработке «Помощник».";
		Возврат Результат;
	КонецЕсли;
	Если НЕ Ссылка.Проведен Тогда
		Результат.Причина = "Документ не проведён";
		Возврат Результат;
	КонецЕсли;

	// УСЛОВИЯ ОТБОРА ПРОВЕРЯЮТСЯ ЗДЕСЬ ПОВТОРНО (решение оператора 07.09.2026:
	// "пусть лучше дважды проверяется, чем лишнее уйдёт").
	// Повод: 4 накладные ТЧ БЕЗ флажка "Отражать в бухгалтерском учёте" ушли контрагентам
	// (85 896,60 руб, 10.08-01.09, организация на ЕНВД). Условие стояло только в отборе
	// очереди, а эти документы ушли МИМО неё - кнопкой из карточки или прямым вызовом ядра.
	// В логах прогонов их нет ни одного.
	КодОтбора = "";
	ПричинаОтбора = ПричинаОтказаПоУсловиямОтбора(Ссылка, Разрешения, КодОтбора);
	Если ЗначениеЗаполнено(ПричинаОтбора) Тогда
		Результат.Причина = ПричинаОтбора;
		Результат.КодПричины = КодОтбора;
		Возврат Результат;
	КонецЕсли;

	// Запрет по организации - страховка на случай отправки МИМО очереди: кнопкой из
	// карточки, прямым вызовом ядра, из другой базы. Отбор очереди такие пути не видит,
	// а дубль контрагенту уходит одинаково.
	ПричинаОрганизации = ПричинаЗапретаПоОрганизации(Ссылка);
	Если ЗначениеЗаполнено(ПричинаОрганизации) Тогда
		Результат.Причина = ПричинаОрганизации;
		Возврат Результат;
	КонецЕсли;
	ИдКонтрагента = ИдентификаторУчастникаЭДО(Ссылка.Контрагент);
	Если НЕ ЗначениеЗаполнено(ИдКонтрагента) Тогда
		Результат.Причина = "У контрагента """ + Строка(Ссылка.Контрагент)
			+ """ не заполнен идентификатор ЭДО";
		Возврат Результат;
	КонецЕсли;

	// Отправитель и получатель не должны совпадать. Оператор такой документ всё равно
	// забракует ("Отправитель и получатель совпадают"), но узнаём мы об этом только из
	// входящей квитанции - то есть уже после того, как документ отмечен отправленным.
	// Прецедент 20.08.2026: массовая правка адресов записала 90 контрагентам НАШ ящик
	// в Тензоре, и 51 документ ушёл в никуда. Проверяем ДО формирования XML.
	НеТребуется = Ложь;
	Совпадение = ПроверитьСовпадениеСторон(Ссылка, ИдКонтрагента, НеТребуется);
	Если ЗначениеЗаполнено(Совпадение) Тогда
		Результат.Причина = Совпадение;
		Результат.ОтправкаНеТребуется = НеТребуется;
		Возврат Результат;
	КонецЕсли;

	// Пауза по контрагенту: правило оператора от 02.09.2026 - за месяц ни одной подписи
	// И есть документ, висящий дольше 14 дней - отгрузки прекращаем до ручного снятия.
	// Мотив: это не "он так работает", а нарушение правил обмена; слать дальше значит
	// копить документы, которых у контрагента юридически нет.
	// Снимается ТОЛЬКО руками (ВозобновитьОтправкуКонтрагенту), автоматика не возвращает:
	// иначе одна подпись задним числом снова открыла бы поток без разбора причины.
	Пауза = ПричинаПаузыКонтрагента(Ссылка.Контрагент);
	Если ЗначениеЗаполнено(Пауза) Тогда
		Результат.Причина = "Отправка контрагенту приостановлена: " + Пауза;
		Возврат Результат;
	КонецЕсли;

	// Адрес закреплён, а роуминг по нему не подтверждён - ДЕРЖИМ документ.
	// Решение оператора 21.08.2026. Обе альтернативы хуже:
	// отправить на другой адрес, где связь есть, значит молча положить документ в чужой
	// ящик; для оператора он SENT, для всех сторожей благополучен, а контрагент его не
	// видит (прецедент: Импульс ООО, ТБ-00060625 ушла в ЭДО Лайт, читают в Контуре);
	// отправить на сам закреплённый адрес без роуминга: оператор ЗАВЕДЁТ документ и
	// повесит его в AWAIT_CONTACT, а база будет считать отправленным.
	// Удержание снимается само: ОбновитьСвязиЭДО обновляет статус связи и у закреплённых
	// карточек тоже, так что в ночь после принятия приглашения документ уйдёт штатно.
	//
	// Незакреплённый адрес с нерабочей связью (NO_CONTACT, AWAIT_APPROVAL, BROKEN) держим тоже:
	// отбор очереди берёт только ESTABLISHED и DIRECT, и без этого гейта проверка отвечала
	// "Готов" документу, который в очередь не попадёт никогда (11.09.2026, Лунегов С.И.:
	// три накладные висели с вердиктом "Готов"). Пустой статус - "связь ещё не проверяли",
	// а не "связи нет": его не держим, иначе ручная отправка новому контрагенту встала бы
	// до первого прогона ОбновитьСвязиЭДО.
	СтатусСвязи = СтатусСвязиЭДО(Ссылка.Контрагент);
	Если ЗначениеЗаполнено(СтатусСвязи)
		И ВРег(СтатусСвязи) <> "ESTABLISHED" И ВРег(СтатусСвязи) <> "DIRECT" Тогда
		Если АдресЭДОЗакреплён(Ссылка.Контрагент) Тогда
			Результат.Причина = "Адрес ЭДО закреплён, но роуминг по нему не подтверждён (связь "
				+ СтатусСвязи + ") — ждём, пока контрагент примет приглашение";
		Иначе
			Результат.Причина = "Связь с контрагентом по адресу " + ИдКонтрагента
				+ " не установлена (связь " + СтатусСвязи + ") — в очередь документ не попадёт,"
				+ " пока связь не появится или адрес не сменится";
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	// "ЭДО Лайт" без ручного закрепления - не отправляем (решение оператора 31.08.2026).
	// Канал формально исправен и потому проходит все прочие проверки: связь ESTABLISHED,
	// оператор документ примет, квитанции о получении придут подписанными. Но читателя
	// за ящиком, как правило, нет - документ считается доставленным и теряется.
	// Гейт стоит ЗДЕСЬ, а не только в выборе адреса, чтобы удержать и те карточки,
	// где 2LT уже записан прежними прогонами.
	Если АдресЭДОВнеАвтовыбора(ИдКонтрагента) И НЕ АдресЭДОЗакреплён(Ссылка.Контрагент) Тогда
		Результат.Причина = "Адрес ЭДО ведет в «" + ИмяКаналаЭДО(ИдКонтрагента) + "» (" + ИдКонтрагента
			+ "), а он не закреплен вручную — отправка удержана до выяснения рабочего канала";
		Возврат Результат;
	КонецЕсли;

	// Без адреса покупателя ФЛК бракует документ: узел СвПокуп/Адрес обязателен при
	// Функция = СЧФДОП. Проверяем ту же цепочку, что и маппинг (карточка -> карточка-тёзка
	// по ИНН), иначе документ уходит в отправку и заворачивается уже у оператора, а причина
	// видна только во входящей квитанции SENDING_FAILURE_ACK.
	Если НЕ ЕстьАдресДляЭДО(Ссылка.Контрагент) Тогда
		Результат.Причина = "У контрагента """ + Строка(Ссылка.Контрагент)
			+ """ не заполнен адрес — ни в его карточке, ни в других карточках этого ИНН";
		Возврат Результат;
	КонецЕсли;

	// Маркируемый товар без кодов: УПД уйдёт с ПУСТЫМИ узлами НомСредИдентТов,
	// и оператор, и ГИС МТ его примут (CHECKED_OK), а переход прав по кодам в Честном ЗНАКе
	// не зарегистрируется - у покупателя товар останется числиться за нами. Тихий исход:
	// ни отказа, ни квитанции, узнаём только от клиента при сканировании.
	// Вскрыто 27.08.2026 по ТБ-00062432 (Губахинский кокс): клиент пикает воду, ЧЗ
	// показывает владельцем нашего ИП. За 14-27.08 так ушли 28 документов.
	// Дело не в маппинге, а в МОМЕНТЕ: регламент отправляет через ~45 минут после
	// проведения, а коды пикают на складе позже. Ни статус заказа "Отгружена", ни "Дата
	// последней печати" гейтом служить не могут - первый уже стоит в отборе очереди и все 28
	// через него прошли, вторая у 31 % документов проставляется в первые две минуты после
	// создания (замер 26.08: 148 из 478).
	// Удержание снимается само: коды появятся - следующий часовой прогон отправит.
	БезКодов = ПозицииБезКодовМаркировки(Ссылка);
	Если ЗначениеЗаполнено(БезКодов) Тогда
		Результат.Причина = "Нет кодов маркировки (" + БезКодов + ") — ждём сканирования на складе";
		Возврат Результат;
	КонецЕсли;

	// Корректировка без строк с изменением дала бы УКД с пустой ТаблКСчФ, а строку "до = после"
	// получатель отклоняет. Гейт для любого пути отправки, ручного и регламентного.
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.КорректировкаРеализации")
		И НЕ ЕстьИзмененныеСтрокиКорректировки(Ссылка) Тогда
		Результат.Причина = "В корректировке нет строк, где изменились количество, цена, сумма или НДС,"
			+ " - УКД отправлять нечего";
		Возврат Результат;
	КонецЕсли;

	// Корректировка, отправляемая регламентом: те же гейты, что в отборе корректировок
	// (КандидатыКорректировокКОтправке), включая паузу перед отправкой.
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.КорректировкаРеализации")
		И ТипЗнч(Разрешения) <> Тип("Структура") И ЭтоРегламентныйСеанс() Тогда
		ПричинаКорректировки = ПричинаУдержанияКорректировки(Ссылка);
		Если ЗначениеЗаполнено(ПричинаКорректировки) Тогда
			Результат.Причина = ПричинаКорректировки;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Результат.Готов = Истина;

	// точка расширения 1: дополнительные условия конкретной базы
	Если ПрофильБазыПодключен() Тогда
		Парам = Новый Структура("Ссылка, Готов, Причина, ОтправкаНеТребуется",
			Ссылка, Результат.Готов, Результат.Причина, Результат.ОтправкаНеТребуется);
		ВызватьТочкуПрофиля("ПриПроверкеГотовности", Парам);
		Результат.Готов = Парам.Готов;
		Результат.Причина = Парам.Причина;
		Результат.ОтправкаНеТребуется = Парам.ОтправкаНеТребуется;
	КонецЕсли;

	Возврат Результат;
КонецФункции

// Есть ли адрес, который маппинг сможет выгрузить в СвПокуп/Адрес.
//
// Цепочка ровно та же, что в настройке выгрузки: юридический адрес карточки -> фактический
// адрес карточки -> любой из них у НЕПОМЕЧЕННОЙ карточки-тёзки по ИНН. Тёзка нужна потому,
// что дубли карточек на один ИНН у нас массовые, а адрес заполнен обычно в одной из них.
//
// Представление контактной информации - поле НЕОГРАНИЧЕННОЙ длины: его нельзя сравнивать
// напрямую, только через ПОДСТРОКА.
// Та же цепочка повторена в ТекстТаблицАдресаПокупателя - менять вместе.
Функция ЕстьАдресДляЭДО(Знач Контрагент)
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Ложь;
	КонецЕсли;
	ВидЮр = НаименованиеВидаКИ("Юридический адрес", Ложь);
	ВидФакт = НаименованиеВидаКИ("Фактический адрес", Ложь);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК Признак
	|ИЗ РегистрСведений.КонтактнаяИнформация КАК КИ
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК К
	|	ПО ВЫРАЗИТЬ(КИ.Объект КАК Справочник.Контрагенты) = К.Ссылка
	|ГДЕ КИ.Вид.Наименование В (&ВидЮр, &ВидФакт)
	|	И НЕ ПОДСТРОКА(КИ.Представление, 1, 1) = """"
	|	И (К.Ссылка = &Контрагент
	|		ИЛИ НЕ К.ПометкаУдаления И НЕ К.ИНН = """" И К.ИНН = &ИНН)";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ИНН", Контрагент.ИНН);
	Запрос.УстановитьПараметр("ВидЮр", ВидЮр);
	Запрос.УстановитьПараметр("ВидФакт", ВидФакт);
	Возврат НЕ Запрос.Выполнить().Пустой();
КонецФункции

// Временные таблицы с цепочкой ЕстьАдресДляЭДО для пакетных запросов: КарточкиСАдресом
// (Контрагент) и ИННСАдресом (ИНН). Адрес есть, если контрагент найден в первой либо его ИНН
// во второй. Параметры запроса ставит УстановитьПараметрыАдресаПокупателя.
Функция ТекстТаблицАдресаПокупателя() Экспорт

	Возврат
	"ВЫБРАТЬ РАЗЛИЧНЫЕ К.Ссылка КАК Контрагент, К.ИНН КАК ИНН, К.ПометкаУдаления КАК Помечен
	|ПОМЕСТИТЬ КарточкиСАдресом
	|ИЗ РегистрСведений.КонтактнаяИнформация КАК КИ
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК К
	|	ПО ВЫРАЗИТЬ(КИ.Объект КАК Справочник.Контрагенты) = К.Ссылка
	|ГДЕ КИ.Вид.Наименование В (&ВидЮр, &ВидФакт)
	|	И НЕ ПОДСТРОКА(КИ.Представление, 1, 1) = """"
	|ИНДЕКСИРОВАТЬ ПО Контрагент
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ Карт.ИНН КАК ИНН
	|ПОМЕСТИТЬ ИННСАдресом
	|ИЗ КарточкиСАдресом КАК Карт
	|ГДЕ НЕ Карт.Помечен И НЕ Карт.ИНН = """"
	|ИНДЕКСИРОВАТЬ ПО ИНН";

КонецФункции

Процедура УстановитьПараметрыАдресаПокупателя(Запрос) Экспорт
	Запрос.УстановитьПараметр("ВидЮр", НаименованиеВидаКИ("Юридический адрес", Ложь));
	Запрос.УстановитьПараметр("ВидФакт", НаименованиеВидаКИ("Фактический адрес", Ложь));
КонецПроцедуры

// Текст колонки для документа, покупателю которого нечего выгрузить в СвПокуп/Адрес.
// Отбор очереди такие документы не берет, и без своего текста колонка обещала бы отправку.
Функция ТекстНетАдресаПокупателя() Экспорт
	Возврат "Нет адреса покупателя в карточке контрагента";
КонецФункции

// Позиции документа, которым нужны коды маркировки, но кодов у них нет.
// Возврат: строка с перечислением позиций; пустая строка = всё обеспечено.
//
// Маркируемость берём у НОМЕНКЛАТУРЫ (ВидПродукцииИС), а не по шапке документа:
// реквизит шапки СодержитМаркируемыйТовар отвечает "в документе есть маркировка", но не
// говорит, ВСЕ ли позиции обеспечены кодами. Прецедент ТБ-00062727 от 25.08.2026 -
// в базе 10 кодов, в отправленном XML доехало 3: часть позиций отсканировали позже.
// ВидыПродукцииИС - ПЕРЕЧИСЛЕНИЕ, не справочник (в запросе легко ошибиться).
Функция ПозицииБезКодовМаркировки(Знач Ссылка)

	// Гейт нетиповой ЦЕЛИКОМ: и `ВидПродукцииИС` у номенклатуры, и ТЧ `ШтрихкодыУпаковок`
	// у реализации есть не в каждой конфигурации. Нет их - проверять нечего, и это не отказ:
	// база без учёта кодов маркировки отправляет документы как обычно.
	Если Метаданные.Перечисления.Найти("ВидыПродукцииИС") = Неопределено
		ИЛИ Метаданные.Справочники.Номенклатура.Реквизиты.Найти("ВидПродукцииИС") = Неопределено
		ИЛИ Метаданные.Документы.РеализацияТоваровУслуг.ТабличныеЧасти.Найти("ШтрихкодыУпаковок") = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Тов.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ Маркируемые
	|ИЗ Документ.РеализацияТоваровУслуг.Товары КАК Тов
	|ГДЕ Тов.Ссылка = &Ссылка
	|	И Тов.Номенклатура.ВидПродукцииИС <> ЗНАЧЕНИЕ(Перечисление.ВидыПродукцииИС.ПустаяСсылка)
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ш.ШтрихкодУпаковки.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ СКодами
	|ИЗ Документ.РеализацияТоваровУслуг.ШтрихкодыУпаковок КАК Ш
	|ГДЕ Ш.Ссылка = &Ссылка
	|;
	|ВЫБРАТЬ
	|	М.Номенклатура КАК Номенклатура
	|ИЗ Маркируемые КАК М
	|	ЛЕВОЕ СОЕДИНЕНИЕ СКодами КАК К ПО К.Номенклатура = М.Номенклатура
	|ГДЕ К.Номенклатура ЕСТЬ NULL";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Имена = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если Имена.Количество() >= 3 Тогда
			Имена.Добавить("…");
			Прервать;
		КонецЕсли;
		Имена.Добавить(Лев(СокрЛП(Строка(Выборка.Номенклатура)), 40));
	КонецЦикла;

	Возврат СтрСоединить(Имена, ", ");

КонецФункции

// Проверка "отправитель = получатель" - набор проверок, потому что наши собственные адреса
// выглядят по-разному. Пустая строка - всё в порядке, иначе текст причины.
//
// Сработавшая проверка отвечает на ДВА разных вопроса, и путать их нельзя:
// "отправлять не надо" - равенство ИНН сторон: контрагент заведён на нас же (розничная
// продажа, "Физическое лицо КЭШ" и подобные). Это норма, документа для ЭДО тут просто нет;
// "данные испорчены" - все остальные: контрагенту ОШИБОЧНО записан наш адрес ЭДО
// (прецедент 20.08.2026: массовая правка адресов записала 90 карточкам наш ящик).
// Их надо ЧИНИТЬ, а не гасить статусом "отправка не требуется", иначе живой контрагент
// молча выпадет из обмена.
//
// Проверок со временем станет больше. Каждая новая по умолчанию попадает во второй разряд
// (ошибка данных); флаг ОтправкаНеТребуется взводит только та, что доказывает "получателя
// не существует как стороны обмена".
// Наш ли это адрес ЭДО. Нужен не только отправке: без него КАЖДЫЙ отчёт и сторож заново
// натыкается на собственные карточки ("Пермяк К.Ю.", "Физическое лицо КЭШ" - тот же ИНН, наш
// ящик в Тензоре) и показывает их как проблемных контрагентов. Фильтровать надо в источнике.
Функция АдресЭДОНаш(Знач Адрес) Экспорт
	Проверяемый = ВРег(СокрЛП(Адрес));
	Если НЕ ЗначениеЗаполнено(Проверяемый) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Свой Из НашиИдентификаторыЭДО() Цикл
		Если ВРег(СокрЛП(Свой)) = Проверяемый Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Причина паузы по контрагенту ("" - паузы нет).
Функция ПричинаПаузыКонтрагента(Знач Контрагент) Экспорт
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат "";
	КонецЕсли;
	СвПауза = СвойствоОбъектов("ЭДО_ОтправкаПриостановлена");
	Если СвПауза = Неопределено ИЛИ СвПауза.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	Значение = ЗначениеСвойстваОбъекта(Контрагент, СвПауза);
	Если НЕ ФлагСвойстваВключён(Значение) Тогда
		Возврат "";
	КонецЕсли;
	СвПричина = СвойствоОбъектов("ЭДО_ПричинаПаузы");
	Причина = "";
	Если СвПричина <> Неопределено И НЕ СвПричина.Пустая() Тогда
		Причина = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Контрагент, СвПричина)));
	КонецЕсли;
	Возврат ?(ЗначениеЗаполнено(Причина), Причина, "причина не указана");
КонецФункции

// Поставить контрагента на паузу. Причина пишется человеческим текстом - её увидит бухгалтерия
// в колонке ЭДО, и по ней же принимается решение о возобновлении.
Процедура ПриостановитьОтправкуКонтрагенту(Знач Контрагент, Знач Причина) Экспорт
	СвПауза = СвойствоОбъектов("ЭДО_ОтправкаПриостановлена");
	СвПричина = СвойствоОбъектов("ЭДО_ПричинаПаузы");
	Если СвПауза = Неопределено ИЛИ СвПауза.Пустая() Тогда
		Возврат;
	КонецЕсли;
	ЗаписатьФлагСвойства(Контрагент, СвПауза, Истина);
	Если СвПричина <> Неопределено И НЕ СвПричина.Пустая() Тогда
		// Дата паузы важнее хвоста причины: при длинном тексте режется причина, а не дата.
		ДатаПаузы = " (" + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") + ")";
		ДлинаЗначения = СвПричина.ТипЗначения.КвалификаторыСтроки.Длина;
		ДлинаПричины = ?(ДлинаЗначения = 0, 200, ДлинаЗначения) - СтрДлина(ДатаПаузы);
		ЗаписатьЗначениеСвойства(Контрагент, СвПричина, Лев(СокрЛП(Причина), ДлинаПричины) + ДатаПаузы);
	КонецЕсли;
	ЗаписьЖурналаРегистрации("ЭДО.ПаузаОтправки", УровеньЖурналаРегистрации.Предупреждение, , Контрагент,
		Лев("Отправка приостановлена: " + Причина, 5000));
КонецПроцедуры

// Снять паузу. Только руками - автоматика этого не делает (см. ПроверитьГотовностьКОтправке).
Процедура ВозобновитьОтправкуКонтрагенту(Знач Контрагент) Экспорт
	Для Каждого Имя Из СтрРазделить("ЭДО_ОтправкаПриостановлена,ЭДО_ПричинаПаузы", ",") Цикл
		Свойство = СвойствоОбъектов(СокрЛП(Имя));
		Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
		Набор.Отбор.Объект.Установить(Контрагент);
		Набор.Отбор.Свойство.Установить(Свойство);
		Набор.Записать(Истина);
	КонецЦикла;
	ЗаписьЖурналаРегистрации("ЭДО.ПаузаОтправки", УровеньЖурналаРегистрации.Информация, , Контрагент,
		"Отправка возобновлена вручную");
КонецПроцедуры

Функция ПроверитьСовпадениеСторон(Ссылка, Знач ИдКонтрагента, ОтправкаНеТребуется = Ложь) Экспорт
	ОтправкаНеТребуется = Ложь;
	ИдКонтрагента = СокрЛП(ИдКонтрагента);
	ИННОрганизации = "";
	Попытка
		ИННОрганизации = СокрЛП(Строка(Ссылка.Организация.ИНН));
	Исключение
		ИННОрганизации = "";
	КонецПопытки;
	ИННКонтрагента = "";
	Попытка
		ИННКонтрагента = СокрЛП(Строка(Ссылка.Контрагент.ИНН));
	Исключение
		ИННКонтрагента = "";
	КонецПопытки;

	// равенство ИНН сторон - контрагент заведён на нас же: розничная продажа,
	// отправлять по ЭДО нечего и некому. Это норма, а не дефект.
	Если ЗначениеЗаполнено(ИННОрганизации) И ИННКонтрагента = ИННОрганизации Тогда
		ОтправкаНеТребуется = Истина;
		Возврат "Отправитель и получатель совпадают: у контрагента " + Строка(Ссылка.Контрагент)
			+ " тот же ИНН, что у организации (" + ИННОрганизации + ")";
	КонецЕсли;

	// адрес контрагента - один из наших (ошибка данных)
	Для Каждого Наш Из НашиИдентификаторыЭДО() Цикл
		Если ВРег(СокрЛП(Наш)) = ВРег(ИдКонтрагента) Тогда
			Возврат "Отправитель и получатель совпадают: контрагенту " + Строка(Ссылка.Контрагент)
				+ " записан НАШ адрес ЭДО " + ИдКонтрагента;
		КонецЕсли;
	КонецЦикла;

	// наш ИНН внутри идентификатора контрагента (ошибка данных)
	Если ЗначениеЗаполнено(ИННОрганизации) И СтрНайти(ИдКонтрагента, ИННОрганизации) > 0 Тогда
		Возврат "Отправитель и получатель совпадают: в адресе контрагента " + Строка(Ссылка.Контрагент)
			+ " (" + ИдКонтрагента + ") зашит ИНН нашей организации";
	КонецЕсли;

	Возврат "";
КонецФункции

// Все известные собственные адреса ЭДО: синтетический адрес у Платформы, адреса, записанные
// организациям, и дополнительные из настройки (наши ящики у других операторов - например
// в Тензоре, откуда шёл роуминг; в базе они больше нигде не хранятся).
Функция НашиИдентификаторыЭДО() Экспорт
	Список = Новый Массив;
	Для Каждого Запись Из УчетныеЗаписиЭДО() Цикл
		Если ЗначениеЗаполнено(Запись.ИдентификаторУчастника) Тогда
			Список.Добавить(Запись.ИдентификаторУчастника);
		КонецЕсли;
	КонецЦикла;
	Свойство = СвойствоОбъектов("ЭДО_АдресКонтрагента");
	Если Свойство <> Неопределено И НЕ Свойство.Пустая() Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ВЫРАЗИТЬ(Р.Значение КАК СТРОКА(150)) КАК Значение
			|ИЗ РегистрСведений.ЗначенияСвойствОбъектов КАК Р
			|ГДЕ Р.Свойство = &Свойство
			|	И ВЫРАЗИТЬ(Р.Объект КАК Справочник.Организации) <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)");
		Запрос.УстановитьПараметр("Свойство", Свойство);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.Значение) Тогда
				Список.Добавить(СокрЛП(Строка(Выборка.Значение)));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого Доп Из СтрРазделить(ПрочиеНашиАдресаЭДО(), ",", Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Доп)) Тогда
			Список.Добавить(СокрЛП(Доп));
		КонецЕсли;
	КонецЦикла;
	Возврат Список;
КонецФункции

// ИНН организаций с учетной записью ЭДО. Соответствие ИНН -> Истина.
// Нужна регламенту связей: карточка контрагента с нашим же ИНН - это розничная продажа,
// абонент по такому ИНН находится НАШ, и записывать карточке наш адрес нельзя.
Функция ИННСвоихОрганизаций() Экспорт
	Результат = Новый Соответствие;
	Для Каждого Запись Из УчетныеЗаписиЭДО() Цикл
		Попытка
			ИННОрганизации = СокрЛП(Строка(Запись.Организация.ИНН));
		Исключение
			ИННОрганизации = "";
		КонецПопытки;
		Если ЗначениеЗаполнено(ИННОрганизации) Тогда
			Результат.Вставить(ИННОрганизации, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Дополнительные собственные адреса ЭДО, через запятую. Хранятся в общих настройках,
// потому что наши ящики у чужих операторов в самой базе не записаны нигде.
Функция ПрочиеНашиАдресаЭДО() Экспорт
	Возврат НастройкаЭДО("ПрочиеНашиАдресаЭДО");
КонецФункции

// Идентификатор участника ЭДО для объекта (контрагента/организации) из
// РегистрСведений.ЗначенияСвойствОбъектов по свойству ЭДО_АдресКонтрагента.
Функция ИдентификаторУчастникаЭДО(Объект) Экспорт
	Свойство = СвойствоОбъектов("ЭДО_АдресКонтрагента");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Значение КАК Значение
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Объект = &Объект И Свойство = &Свойство");
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Строка(Выборка.Значение));
	КонецЕсли;
	Возврат "";
КонецФункции

// Фаза 0a+0b: обеспечить действующий токен авторизации (подпись {ts,nonce} + attach + POST oauth).
// Принудительный = Истина перевыпуск даже если токен в хранилище есть (реакция на 401).
// Срок токена (15 мин) не проверяем - истёкший всплывёт как 401 перевыпуск.
// Подпись и POST идут в ОДНОМ серверном вызове: ts живёт секунды (Nonce expired).
Функция ОбеспечитьТокен(Принудительный, Знач Организация = Неопределено) Экспорт
	Если НЕ Принудительный И ЗначениеЗаполнено(ТекущийТокен(Организация)) Тогда
		Возврат Истина;
	КонецЕсли;
	ДанныеJSON = ДанныеАвторизацииJSON();
	ПодписьJSON = ПодписатьДанные(ДанныеJSON, Организация);
	Если ПодписьJSON = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Ответ = ПолучитьТокенПоПодписиАвторизации(ДанныеJSON, ПодписьJSON, Организация);
	Возврат Ответ.Успех;
КонецФункции

// Подпись двоичных данных КЭП подписанта (отсоединённая CMS) в СЕРВЕРНОМ контексте.
// Требует контейнер в реестре учётки службы кластера + сертификат в её личном хранилище.
// Возврат: ДвоичныеДанные подписи либо Неопределено (нет сертификата/ошибка крипто).
Функция ПодписатьДанные(Данные, Знач Организация = Неопределено) Экспорт
	Попытка
		Сертификат = СертификатПодписанта(Организация);
		Если Сертификат = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		МенеджерКриптографии = Новый МенеджерКриптографии("", "", 80); // ГОСТ-2012-256, как в обработке провайдера
		МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = "";
		Возврат МенеджерКриптографии.Подписать(Данные, Сертификат);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Отпечаток сертификата подписанта (Base64).
// Отпечаток - данные конкретной организации, в коде его нет. Читать из настроек обработки
// (ХранилищеОбщихНастроек "ОФД_ЭДО_НастройкиОбработки"/"Интеграция".ПараметрыАвторизацииИПодписания)
// или из справочника сертификатов; при переходе на МЧД - отдельный подписант.
Функция ОтпечатокПодписанта(Знач Организация = Неопределено) Экспорт
	// Меняется при каждом перевыпуске КЭП: прежний сертификат УЦ ФНС при перевыпуске
	// ОТЗЫВАЕТСЯ (проверено 13.08.2026).
	Запись = УчетнаяЗаписьЭДО(Организация);
	Возврат ?(Запись = Неопределено, "", Запись.Отпечаток);
КонецФункции

// Фаза 0b: получить токен авторизации по присоединённой подписи служебного JSON.
// ДанныеJSON, ПодписьJSON - ДвоичныеДанные (JSON {ts,nonce} и его отсоединённая CMS).
// Возврат: Структура (Успех Булево, КодСостояния Число, Ошибка Строка).
Функция ПолучитьТокенПоПодписиАвторизации(ДанныеJSON, ПодписьJSON, Знач Организация = Неопределено) Экспорт
	Результат = Новый Структура("Успех, КодСостояния, Ошибка", Ложь, 0, "");
	Обр = ПодключитьОбработкуЭДО();

	Отказ = Ложь;
	ОписаниеОшибки = "";
	Присоединённая = Обр.ПрисоединитьПодпись(ПодписьJSON, ДанныеJSON, Отказ, ОписаниеОшибки);
	Если Отказ Тогда
		Результат.Ошибка = "Присоединение подписи авторизации: " + ОписаниеОшибки;
		Возврат Результат;
	КонецЕсли;

	B64 = ОчиститьBase64(Base64Строка(Присоединённая));
	СИ = Новый СистемнаяИнформация;
	ПарЗапроса = Обр.ПолучитьШаблонПараметровЗапроса("");
	ПарЗапроса.Параметры.Вставить("<Тело>", "grant_type=signature&signature="
		+ КодироватьСтроку(B64, СпособКодированияСтроки.КодировкаURL));
	ПарЗапроса.Параметры.Вставить("ИдентификаторКлиента", СИ.ИдентификаторКлиента);

	Ответ = Обр.API_ПолучитьТокенАвторизацииПоСертификату(ПарЗапроса);
	Результат.КодСостояния = Ответ.КодСостояния;
	Если Ответ.Ошибка Тогда
		Результат.Ошибка = Лев(Строка(Ответ.Описание), 600);
		Возврат Результат;
	КонецЕсли;

	СохранитьТокен(Ответ.Результат.access_token, Организация);
	Результат.Успех = Истина;
	Возврат Результат;
КонецФункции

// Фазы 1 + 2: сборка XML УПД 5.03 через движок обработки + ФЛК (POST /documents).
// Версия настроек, которую обработка вендора держит в реквизите формы ГлавноеОкно
// (`ВерсияНастроекОбработки`). Нужна, чтобы создаваемая нами запись настроек интеграции была
// той же формы, что создаёт сама форма.
// Если вендор поднимет версию, расхождение не опасно: форма при открытии увидит несовпадение
// и перезапишет настройку сама (её `ОбновитьНастройки`).
Функция ВерсияНастроекОбработкиВендора() Экспорт
	Возврат "1.0.5.3.4.1";
КонецФункции

// УЧЕТНЫЕ ЗАПИСИ ОРГАНИЗАЦИЙ У ОПЕРАТОРА.
// У каждой нашей организации свой сертификат, свой идентификатор участника ЭДО и свой токен,
// у подписанта-физлица - своя МЧД. Список хранится в общем хранилище настроек: это настройки,
// а не данные учета, и их правка не требует реструктуризации.
// Это единственное место, где живут отпечаток, дата начала отправки и хост: прежние общие
// настройки на всю базу сняты. Нет записи организации - операции по ней отказывают с прямым
// сообщением, а не работают на чужих значениях.

Функция НоваяУчетнаяЗаписьЭДО() Экспорт
	Возврат Новый Структура(
		"Организация, Отпечаток, ИдентификаторУчастника, ТипПодписанта, НомерМЧД, ДатаМЧД, ДолжностьПодписанта,
		|Оператор, ДатаНачалаОтправки, Хост",
		Неопределено, "", "", "", "", Дата(1, 1, 1), "",
		"Платформа", Дата(1, 1, 1), "");
КонецФункции

// Учетные записи ровно в том виде, в каком они сохранены: без умолчаний, профиля и
// подстановки общих настроек. Этот список правят формы - записывать обратно дополненный
// нельзя, иначе вычисленные значения становятся заданными.
// Возврат: Массив из структур НоваяУчетнаяЗаписьЭДО().
Функция СохраненныеУчетныеЗаписиЭДО() Экспорт

	Записи = Новый Массив;
	УстановитьПривилегированныйРежим(Истина);
	Сохраненные = ПрочитатьНастройкуХранилища("ЭДО_УчетныеЗаписи", "Организации", "");
	Если ТипЗнч(Сохраненные) <> Тип("Массив") Тогда
		Возврат Записи;
	КонецЕсли;

	Для Каждого Сохраненная Из Сохраненные Цикл
		Запись = НоваяУчетнаяЗаписьЭДО();
		ЗаполнитьЗначенияСвойств(Запись, Сохраненная);
		Если ЗначениеЗаполнено(Запись.Организация) Тогда
			Записи.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;

	Возврат Записи;

КонецФункции

// Учетные записи всех подключенных организаций, уже дополненные значениями по умолчанию
// и профилем базы. Возврат: Массив из структур НоваяУчетнаяЗаписьЭДО().
Функция УчетныеЗаписиЭДО() Экспорт

	Записи = СохраненныеУчетныеЗаписиЭДО();

	Для Каждого Запись Из Записи Цикл
		ДополнитьУчетнуюЗаписьЭДО(Запись);
		Параметры = Новый Структура("УчетнаяЗапись", Запись);
		ВызватьНеобязательнуюТочкуПрофиля("ПриОпределенииУчетнойЗаписи", Параметры);
	КонецЦикла;
	Возврат Записи;

КонецФункции

// Учетная запись организации. Организация не указана - единственная учетная запись базы;
// если их несколько, вызывающий обязан указать организацию.
// Возврат: Структура НоваяУчетнаяЗаписьЭДО() либо Неопределено.
Функция УчетнаяЗаписьЭДО(Знач Организация = Неопределено) Экспорт

	Записи = УчетныеЗаписиЭДО();
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Если Записи.Количество() = 0 Тогда
			Возврат Неопределено;
		ИначеЕсли Записи.Количество() = 1 Тогда
			Возврат Записи[0];
		КонецЕсли;
		ВызватьИсключение "У нескольких организаций есть учетная запись ЭДО, а организация для операции не указана";
	КонецЕсли;

	Для Каждого Запись Из Записи Цикл
		Если Запись.Организация = Организация Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Записать список учетных записей целиком. Хранятся только заданные поля: значения по
// умолчанию вычисляются при чтении, чтобы смена реквизитов организации подхватывалась сама.
Процедура ЗаписатьУчетныеЗаписиЭДО(Записи) Экспорт

	Сохраняемые = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Если НЕ ЗначениеЗаполнено(Запись.Организация) Тогда
			Продолжить;
		КонецЕсли;
		Сохраняемая = НоваяУчетнаяЗаписьЭДО();
		ЗаполнитьЗначенияСвойств(Сохраняемая, Запись);
		Сохраняемая.Отпечаток = СокрЛП(Сохраняемая.Отпечаток);
		Сохраняемая.ИдентификаторУчастника = СокрЛП(Сохраняемая.ИдентификаторУчастника);
		Сохраняемая.Оператор = СокрЛП(Сохраняемая.Оператор);
		Сохраняемая.Хост = СокрЛП(Сохраняемая.Хост);
		Сохраняемые.Добавить(Сохраняемая);
	КонецЦикла;

	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить("ЭДО_УчетныеЗаписи", "Организации", Сохраняемые, , "");

КонецПроцедуры

// Разовый перенос прежней схемы в учетные записи: отпечаток, дата начала и хост из общих
// настроек становятся заданными полями записи каждой организации с разрешенной отправкой.
// Уже сохраненные записи не трогаются. Возврат: Строка - свод для человека и журнала.
Функция ПеренестиОбщиеНастройкиВУчетныеЗаписи() Экспорт

	Записи = СохраненныеУчетныеЗаписиЭДО();
	Было = Записи.Количество();

	Отпечаток = НастройкаЭДО("ОтпечатокПодписанта");
	Если НЕ ЗначениеЗаполнено(Отпечаток) Тогда
		Возврат "Переносить нечего: общий отпечаток подписанта не задан.";
	КонецЕсли;

	Организации = ОрганизацииСРазрешеннойОтправкой();
	Если Организации.Количество() = 0 Тогда
		Возврат "Переносить некому: нет организаций с разрешенной отправкой.";
	КонецЕсли;

	Добавленные = Новый Массив;
	Для Каждого Организация Из Организации Цикл
		Существующая = Неопределено;
		Для Каждого Запись Из Записи Цикл
			Если Запись.Организация = Организация Тогда
				Существующая = Запись;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Существующая <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Запись = НоваяУчетнаяЗаписьЭДО();
		Запись.Организация = Организация;
		Запись.Отпечаток = Отпечаток;
		Запись.ДатаНачалаОтправки = НастройкаЭДО("ДатаНачалаОтправки");
		Запись.Хост = НастройкаЭДО("Хост");
		ДополнитьУчетнуюЗаписьЭДО(Запись);
		Записи.Добавить(Запись);
		Добавленные.Добавить(Строка(Организация));
	КонецЦикла;

	Если Добавленные.Количество() = 0 Тогда
		Возврат "Все организации с разрешенной отправкой уже имеют учетные записи, перенос не потребовался.";
	КонецЕсли;

	ЗаписатьУчетныеЗаписиЭДО(Записи);

	Свод = "Перенесено записей: " + Добавленные.Количество() + " (было " + Было + ")."
		+ Символы.ПС + "Организации: " + СтрСоединить(Добавленные, ", ");
	ЗаписьЖР("ЭДО.ПереносНастроекВУчетныеЗаписи", "Информация", , , Свод);
	Возврат Свод;

КонецФункции

// Что мешает работать учетной записи. Возврат: Массив строк, пустой - все в порядке.
Функция НедостаткиУчетнойЗаписиЭДО(Запись) Экспорт

	Претензии = Новый Массив;
	Префикс = "организация «" + Строка(Запись.Организация) + "»: ";

	Сертификат = СостояниеСертификатаПоОтпечатку(Запись.Отпечаток, Ложь);
	Если НЕ Сертификат.Задан Тогда
		Претензии.Добавить(Префикс + "не задан отпечаток сертификата подписанта");
	ИначеЕсли НЕ Сертификат.Найден Тогда
		Претензии.Добавить(Префикс + "сертификат подписанта не установлен у учётки сервера 1С");
	ИначеЕсли Сертификат.Просрочен Тогда
		Претензии.Добавить(Префикс + "сертификат подписанта просрочен "
			+ Формат(Сертификат.ДействителенПо, "ДФ=dd.MM.yyyy"));
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Запись.ИдентификаторУчастника) Тогда
		Претензии.Добавить(Префикс + "не определен идентификатор участника ЭДО");
	КонецЕсли;

	Если Запись.ТипПодписанта = "ФЛ"
		И (НЕ ЗначениеЗаполнено(Запись.НомерМЧД) ИЛИ НЕ ЗначениеЗаполнено(Запись.ДатаМЧД)) Тогда
		Претензии.Добавить(Префикс + "подписант - физлицо, не заданы номер и дата МЧД");
	КонецЕсли;

	// Дата уже прошла через ДополнитьУчетнуюЗаписьЭДО (фолбэк на общую настройку) - если и
	// после него пусто, значит пусто ОБА места: и учетная запись, и общая ДатаНачалаОтправки.
	Если НЕ ЗначениеЗаполнено(Запись.ДатаНачалаОтправки) Тогда
		Претензии.Добавить(Префикс + "не задана дата начала отправки");
	КонецЕсли;

	Возврат Претензии;

КонецФункции

Функция НесколькоУчетныхЗаписейЭДО() Экспорт
	Возврат УчетныеЗаписиЭДО().Количество() > 1;
КонецФункции

// Организация по ее идентификатору участника ЭДО; Неопределено, если такой учетной записи нет.
Функция ОрганизацияПоИдентификаторуЭДО(Знач Идентификатор) Экспорт
	Для Каждого Запись Из УчетныеЗаписиЭДО() Цикл
		Если ВРег(Запись.ИдентификаторУчастника) = ВРег(СокрЛП(Идентификатор)) Тогда
			Возврат Запись.Организация;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Организация документа; Неопределено, если документа нет или у него нет такого реквизита.
Функция ОрганизацияДокумента(Знач Документ) Экспорт
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Документ.Организация;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Учетная запись, без которой операция с оператором невозможна: отказ называет организацию.
Функция ОбязательнаяУчетнаяЗаписьЭДО(Знач Организация = Неопределено) Экспорт
	Запись = УчетнаяЗаписьЭДО(Организация);
	Если Запись = Неопределено Тогда
		ВызватьИсключение ?(ЗначениеЗаполнено(Организация),
			"У организации «" + Строка(Организация) + "» нет учетной записи ЭДО",
			"В базе не задана учетная запись ЭДО ни для одной организации");
	КонецЕсли;
	Возврат Запись;
КонецФункции

Функция ОрганизацииСРазрешеннойОтправкой() Экспорт

	Результат = Новый Массив;
	Свойство = СвойствоОбъектов("ЭДО_РазрешенаОтправка");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Организации.Ссылка КАК Ссылка
		|ИЗ Справочник.Организации КАК Организации
		|ГДЕ НЕ Организации.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО Организации.Наименование");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Значение = ЗначениеСвойстваОбъекта(Выборка.Ссылка, Свойство);
		Если ТипЗнч(Значение) = Тип("Булево") Тогда
			Разрешено = Значение;
		Иначе
			Текст = ВРег(СокрЛП(Строка(Значение)));
			Разрешено = (Текст = "ДА" ИЛИ Текст = "ИСТИНА" ИЛИ Текст = "TRUE" ИЛИ Текст = "1");
		КонецЕсли;
		Если Разрешено Тогда
			Результат.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Незаданные поля берутся из организации: идентификатор - из ее свойства ЭДО_АдресКонтрагента
// (его же ставит в файл УПД обработка вендора), иначе по формуле оператора; тип подписанта -
// по длине ИНН.
Процедура ДополнитьУчетнуюЗаписьЭДО(Запись)

	ИНН = СокрЛП(Запись.Организация.ИНН);

	Если НЕ ЗначениеЗаполнено(Запись.ИдентификаторУчастника) Тогда
		Запись.ИдентификаторУчастника = ИдентификаторУчастникаЭДО(Запись.Организация);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Запись.ИдентификаторУчастника) И ЗначениеЗаполнено(ИНН) Тогда
		Если СтрДлина(ИНН) = 10 Тогда
			Запись.ИдентификаторУчастника = "2VO-" + ИНН + "-" + СокрЛП(Запись.Организация.КПП)
				+ "0000000000000000000000";
		Иначе
			Запись.ИдентификаторУчастника = "2VO-" + ИНН + "-00000000000000000000000000000";
		КонецЕсли;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Запись.ТипПодписанта) Тогда
		Запись.ТипПодписанта = ?(СтрДлина(ИНН) = 10, "ЮЛ", "ИП");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Запись.Хост) Тогда
		Запись.Хост = "api.platformaofd.ru";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Запись.Оператор) Тогда
		Запись.Оператор = "Платформа";
	КонецЕсли;

КонецПроцедуры

// КОНТРАКТ ПРОФИЛЯ БАЗЫ, версия 1.
// Логика КОНКРЕТНОЙ базы живёт не в ядре, а в общем модуле "ЭДО_ПрофильБазы" - своём
// у каждой установки. Ядро зовёт его в четырёх точках; профиля нет - работаем как раньше.
//
// Граница: профиль пишется только для того, чего в типовой конфигурации НЕТ ВОВСЕ
// (чужая ТЧ с кодами маркировки, нетиповой реквизит отбора). Вариации самой типовой ядро
// определяет само - см. ТекстНастройкиРеализации: нет реквизита подстановка, имена видов
// контактной информации запросом. Иначе каждая база будет руками переписывать определимое.
//
// Методы профиля принимают ОДНУ структуру "Параметры" и меняют её поля на месте:
// ПриПроверкеГотовности(Параметры) Ссылка, Готов, Причина, ОтправкаНеТребуется
// ПриФормированииНастройкиКонфигурации(Параметры) Текст
// ПриФормированииНастройкиРеализации(Параметры) Текст
// ПриФормированииXML(Параметры) Ссылка, Текст
// ПриОтбореДокументовКОтправке(Параметры) фильтрует или собирает очередь отправки
// ПриОпределенииУчетнойЗаписи(Параметры) УчетнаяЗапись - дополняет учетную запись организации
//   (отпечаток, тип подписанта, МЧД) из мест, где их хранит конкретная база. Необязательная:
//   профилю без этого метода ничего менять не нужно.
// ВерсияКонтракта() число, сверяется с ВерсияКонтрактаПрофиля()
Функция ВерсияКонтрактаПрофиля() Экспорт
	Возврат 1;
КонецФункции

// Имя модуля профиля базы ("" - профиля нет).
//
// ИМЁН ДВА, И ЭТО НАМЕРЕННО. Переименование ЭДО_ (07.09.2026) идёт по двум расширениям,
// и выкатить их одной секундой нельзя. Если бы ядро знало только новое имя, то в промежутке
// между выкатками оно НЕ НАШЛО БЫ профиль и пошло дальше молча - с виду исправная отправка
// без нетиповых условий базы, то есть без гейта готовности. Тихий отказ ценой в реальные
// документы. - ищем новое имя, затем старое.
// Старое имя убрать, когда профили обеих баз переедут на ЭДО_ (prodline и moroz).
Функция ИмяМодуляПрофиляБазы() Экспорт
	Если Метаданные.ОбщиеМодули.Найти("ЭДО_ПрофильБазы") <> Неопределено Тогда
		Возврат "ЭДО_ПрофильБазы";
	КонецЕсли;
	Если Метаданные.ОбщиеМодули.Найти("ПЭДО_ПрофильБазы") <> Неопределено Тогда
		Возврат "ПЭДО_ПрофильБазы";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ПрофильБазыПодключен() Экспорт
	Возврат ЗначениеЗаполнено(ИмяМодуляПрофиляБазы());
КонецФункции

// Вызов точки расширения. Профиля нет - тихо выходим (это НОРМА, а не отказ).
// Ошибка ВНУТРИ профиля наружу пробрасывается, а не глушится умолчанием: молча
// отправленный не тот XML не откатывается, а прецедент 25.08.2026 показал, что
// собственный "Попытка" съедает ошибку до журнала регистрации и стоит часов разбора.
// профиля нет - тихий фолбэк; профиль сломан - громкий отказ.
Процедура ВызватьТочкуПрофиля(Знач Метод, Параметры) Экспорт
	Если НЕ ПрофильБазыПодключен() Тогда
		Возврат;
	КонецЕсли;
	// Именно Выполнить, а не Вычислить: точки профиля - ПРОЦЕДУРЫ, а Вычислить -
	// встроенная функция, и оператором её ставить нельзя. Ошибка чисто синтаксическая,
	// но ловит её ТОЛЬКО компилятор 1С при первом обращении к модулю: сборка .cfe,
	// build/checks.py и /CheckConfig -Extension проходят молча, а в базе ядро целиком
	// отвечает "Ошибка инициализации модуля" - так релиз 1.1.4.0 оказался нерабочим везде.
	Попытка
		Выполнить(ИмяМодуляПрофиляБазы() + "." + Метод + "(Параметры)");
	Исключение
		ВызватьИсключение "Профиль базы, метод " + Метод + ": " + ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

// Вызов точки, появившейся в контракте позже: профиль, написанный до нее, метода не содержит,
// и это не ошибка. Любая другая ошибка профиля пробрасывается, как у обязательных точек.
Процедура ВызватьНеобязательнуюТочкуПрофиля(Знач Метод, Параметры) Экспорт
	Если НЕ ПрофильБазыПодключен() Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Выполнить(ИмяМодуляПрофиляБазы() + "." + Метод + "(Параметры)");
	Исключение
		Описание = ОписаниеОшибки();
		Если СтрНайти(Описание, "(" + Метод + ")") > 0 И СтрНайти(Описание, "не обнаружен") > 0 Тогда
			Возврат;
		КонецЕсли;
		ВызватьИсключение "Профиль базы, метод " + Метод + ": " + Описание;
	КонецПопытки;
КонецПроцедуры

// Сверка версии контракта - один раз на прогон, из НовыйКонтекстПрогона.
// Профиль под другую редакцию точек молча не подключаем: он либо не будет вызван вовсе,
// либо получит структуру не того состава.
Процедура ПроверитьВерсиюПрофиля()
	Если НЕ ПрофильБазыПодключен() Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ВерсияПрофиля = Вычислить(ИмяМодуляПрофиляБазы() + ".ВерсияКонтракта()");
	Исключение
		ВызватьИсключение "Профиль базы не отвечает на ВерсияКонтракта(): " + ОписаниеОшибки();
	КонецПопытки;
	Если ВерсияПрофиля <> ВерсияКонтрактаПрофиля() Тогда
		ВызватьИсключение "Профиль базы написан под версию контракта " + ВерсияПрофиля
			+ ", ядро ожидает " + ВерсияКонтрактаПрофиля();
	КонецЕсли;
КонецПроцедуры

// Контекст прогона отправки: движок вендора и кэш настроек маппинга, собранные ОДИН раз.
// Мотив - замер 28.08.2026 на боевой базе: подключение движка, запись клиентских настроек
// и ШтатныйЗапуск стоят ~125 мс (78 + 46), и раньше это делалось НА КАЖДЫЙ документ -
// на пакете в 500 накладных лишняя минута и 500 записей в ХранилищеОбщихНастроек впустую.
// Переиспользование движка между документами проверено фактом: тела XML пяти документов
// совпали с поштучной сборкой байт в байт. Различается только ИдФайл - там свежий GUID
// на каждую выгрузку, поэтому сравнивать выгрузки целиком нельзя, XML недетерминирован.
Функция НовыйКонтекстПрогона() Экспорт
	ПроверитьВерсиюПрофиля();
	Контекст = Новый Структура("Обработка, Кэш");
	Контекст.Обработка = ПодключитьОбработкуЭДО();
	ЗагрузитьКлиентскиеНастройки();
	ОбеспечитьИнтеграциюОбработки(Контекст.Обработка);
	Контекст.Кэш = Контекст.Обработка.ШтатныйЗапуск();
	Контекст.Кэш.Форматы.Вставить("ON_NSCHFDOPPR", МакетТекст("СхемаУПД"));
	// Схему УКД тоже подкладываем сами, хотя версия у нас та же, что у вендора (5.01):
	// собственный механизм движка достает XSD из zip-макета "Форматы" и на нем ПАДАЕТ -
	// "Ошибка разбора XML: Extra content at the end of the document". С готовым текстом
	// схемы в кэше фабрика XDTO строится штатно (проверено на боевых документах 06.09).
	Контекст.Кэш.Форматы.Вставить("ON_NKORSCHFDOPPR", МакетТекст("СхемаУКД"));
	Возврат Контекст;
КонецФункции

// Настройки интеграции движка вендора: заводятся один раз, если их ещё нет.
Процедура ОбеспечитьИнтеграциюОбработки(Обр)
	Если Обр.ПолучитьИнтеграциюНаСервере() = Неопределено Тогда
 // Писать сюда "СпособИнтеграции" одним полем НЕЛЬЗЯ, хотя движку хватает именно его.
 // Настройка ОБЩАЯ для всех пользователей: `ПолучитьТекущегоПользователя()` обработки
 // вендора первой строкой возвращает Неопределено (остальное тело мёртвое), поэтому
 // комментарий "хранятся относительно текущего пользователя" не соответствует коду.
 // Форма ГлавноеОкно читает ту же запись и обращается к `Интеграция.ВерсияНастроек`
 // урезанная структура роняет ОТКРЫТИЕ ФОРМЫ у всех: "Поле объекта не обнаружено
 // (ВерсияНастроек)". Прецедент 25.08.2026, обе боевые базы.
 // Состав ниже повторяет ветку "первый запуск" формы (её функция
 // ПолучитьИнтеграциюНаСервере), отличаясь только способом интеграции.
		Интеграция = Новый Структура;
		Интеграция.Вставить("СпособИнтеграции", 2);
		Интеграция.Вставить("КаталогОбмена");
		Интеграция.Вставить("ИспользоватьКриптографию", Ложь);
		Интеграция.Вставить("ИнтерактивноОбновлятьСтатусыДО", Ложь);
		Интеграция.Вставить("ПараметрыАвторизацииИПодписания", Новый Соответствие);
		Интеграция.Вставить("ВерсияНастроек", ВерсияНастроекОбработкиВендора());
		Интеграция.Вставить("МассоваяВыгрузка", Новый Структура);
		Интеграция.Вставить("ЭтоПервыйЗапуск", Ложь);
		Обр.СохранитьИнтеграциюНаСервере(Интеграция);
	КонецЕсли;
КонецПроцедуры

// Фаза 1 без обращения к оператору: XML титула продавца в том виде, в каком он уйдет на ФЛК.
// Исправление - Структура из ИсправлениеУПД (для ИУПД) или Неопределено.
// Возврат: Структура (Статус "ОК" | "Отсеян" | "ОшибкаФормирования", ТекстXML, Сообщение).
Функция СформироватьXMLДокумента(Ссылка, Контекст = Неопределено, Знач Исправление = Неопределено) Экспорт

	Результат = Новый Структура("Статус, ТекстXML, Сообщение", "", "", "");

	// Контекст прогона переиспользуется на весь пакет; при одиночном вызове собирается свой.
	Если Контекст = Неопределено Тогда
		Контекст = НовыйКонтекстПрогона();
	КонецЕсли;
	Обр = Контекст.Обработка;
	Кэш = Контекст.Кэш;

	МассивДокументов = Новый Массив;
	МассивДокументов.Добавить(Ссылка);
	ФорматДокумента = ФорматВыгрузкиДокумента(Ссылка);
	РезВыгрузки = Обр.ВыгрузитьМассивДокументов(МассивДокументов, Ссылка.Организация, "", ФорматДокумента, Кэш, Истина, "");
	Если РезВыгрузки = Неопределено Тогда
		Результат.Статус = "Отсеян";
		Результат.Сообщение = "Документ отсеян условиями отмены выгрузки (ИНН покупателя/ставка НДС 18%/…)";
		Возврат Результат;
	КонецЕсли;
	СтрокаВыгрузки = РезВыгрузки.ВыгрузкаДокументов[0];
	Если СтрокаВыгрузки.ОшибкиФормирования Тогда
		Результат.Статус = "ОшибкаФормирования";
		Результат.Сообщение = Лев(Строка(СтрокаВыгрузки.ОписанияОшибокФормирования), 1000);
		Возврат Результат;
	КонецЕсли;
	// Schematron ФНС требует КрНаимСтрПр рядом с СвДТ/@КодПроисх, а декларативный движок
	// простой unbounded-элемент внутри ДопСведТов не выгружает (проверено: Параметр/Текст/Элемент
	// дают либо молчаливый пропуск, либо ошибку XDTO). Дописываем его постобработкой XML -
	// до подписи, поэтому на КЭП это не влияет.
	ТекстXML = ДополнитьКрНаимСтрПр(Строка(СтрокаВыгрузки.Выгрузка));

	// точка расширения 4: то, что декларативный движок не выгружает вовсе
	// (у нас выше - КрНаимСтрПр; у базы с маркировкой здесь дописывается НомСредИдентТов)
	Если ПрофильБазыПодключен() Тогда
		Парам = Новый Структура("Ссылка, Текст", Ссылка, ТекстXML);
		ВызватьТочкуПрофиля("ПриФормированииXML", Парам);
		ТекстXML = Парам.Текст;
	КонецЕсли;

	Если Исправление <> Неопределено Тогда
		Дополнение = ДополнитьИсправлением(ТекстXML, Исправление);
		Если ЗначениеЗаполнено(Дополнение.Ошибка) Тогда
			Результат.Статус = "ОшибкаФормирования";
			Результат.Сообщение = Дополнение.Ошибка;
			Возврат Результат;
		КонецЕсли;
		ТекстXML = Дополнение.Текст;
	КонецЕсли;

	Результат.Статус = "ОК";
	Результат.ТекстXML = ТекстXML;
	Возврат Результат;

КонецФункции

// Фаза 1 и ФЛК оператора (POST создает документ у оператора; до подписи он никуда не уходит).
// Исправление - для ИУПД, см. ИсправлениеУПД.
// Возврат: Структура
// Статус - "ОК" | "Отсеян" | "ОшибкаФормирования" | "НуженТокен" | "ОшибкаHTTP"
// ИдДокумента - id, присвоенный оператором (при "ОК")
// ДвоичныеXML - ДвоичныеДанные титула (windows-1251), для подписи
// Сообщение - текст ошибки/причины
// КодHTTP - код ответа ФЛК
Функция ПодготовитьДокументИФЛК(Ссылка, Контекст = Неопределено, Знач Исправление = Неопределено) Экспорт
	Результат = Новый Структура("Статус, ИдДокумента, ДвоичныеXML, Сообщение, КодHTTP", "", "", Неопределено, "", 0);

	// -- Фаза 1: сборка XML движком обработки ---
	Сборка = СформироватьXMLДокумента(Ссылка, Контекст, Исправление);
	Если Сборка.Статус <> "ОК" Тогда
		Результат.Статус = Сборка.Статус;
		Результат.Сообщение = Сборка.Сообщение;
		Возврат Результат;
	КонецЕсли;
	ТекстXML = Сборка.ТекстXML;

	ДвоичныеXML = ПолучитьДвоичныеДанныеИзСтроки(ТекстXML, "windows-1251", Ложь);
	Результат.ДвоичныеXML = ДвоичныеXML;

	// -- Фаза 2: ФЛК (POST /documents) ---
	Токен = ТекущийТокен(ОрганизацияДокумента(Ссылка));
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		Результат.Статус = "НуженТокен";
		Возврат Результат;
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/xml");
	Заголовки.Вставить("accept", "application/json;charset=UTF-8");
	Заголовки.Вставить("Authorization", "Bearer " + Токен);

	Соединение = HTTPСоединениеЭДО();
	Запрос = Новый HTTPЗапрос(ПутьСервиса("document") + "/public/api/v3/documents", Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(ДвоичныеXML);
	// С этой строки документ мог появиться у оператора. Исключение до нее - ошибка сборки,
	// а не обрыв связи, и повтор дубля не даст (см. ОтправитьПоЭДО, ветка Исключение).
	Контекст.Вставить("ЗапросКОператоруУшел", Истина);
	Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);

	Результат.КодHTTP = Ответ.КодСостояния;
	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	Если Ответ.КодСостояния = 401 Тогда
		Результат.Статус = "НуженТокен";
		Возврат Результат;
	КонецЕсли;
	Если Ответ.КодСостояния <> 200 Тогда
		Результат.Статус = "ОшибкаHTTP";
		Результат.Сообщение = "ФЛК HTTP " + Ответ.КодСостояния + ": " + Лев(ТелоОтвета, 800);
		Возврат Результат;
	КонецЕсли;

	ИдДокумента = ИзвлечьИдентификатор(ТелоОтвета);
	Если НЕ ЗначениеЗаполнено(ИдДокумента) Тогда
		Результат.Статус = "ОшибкаHTTP";
		Результат.Сообщение = "ФЛК вернул 200, но id документа не найден: " + Лев(ТелоОтвета, 800);
		Возврат Результат;
	КонецЕсли;

	Результат.Статус = "ОК";
	Результат.ИдДокумента = ИдДокумента;
	Возврат Результат;
КонецФункции

// Фаза 4: присоединение подписи (PUT /signature - отправка стартует сама) + write-back статуса.
// ПодписьДокумента - ДвоичныеДанные (отсоединённая CMS титула).
// Возврат: Структура (Статус "Отправлен"|"НуженТокен"|"ОшибкаHTTP", КодHTTP, Сообщение).
Функция ПрисоединитьПодписьИЗаписать(Ссылка, ИдДокумента, ПодписьДокумента) Экспорт
	Результат = Новый Структура("Статус, КодHTTP, Сообщение", "", 0, "");
	Организация = ОрганизацияДокумента(Ссылка);
	Токен = ТекущийТокен(Организация);
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		Результат.Статус = "НуженТокен";
		Возврат Результат;
	КонецЕсли;

	Тело = ТелоПодписиДокумента(ПодписьДокумента, Организация);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json;charset=UTF-8");
	Заголовки.Вставить("accept", "application/json;charset=UTF-8");
	Заголовки.Вставить("Authorization", "Bearer " + Токен);

	Соединение = HTTPСоединениеЭДО();
	Запрос = Новый HTTPЗапрос(ПутьСервиса("document") + "/public/api/v4/documents/" + ИдДокумента + "/signature", Заголовки);
	Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Ответ = Соединение.ВызватьHTTPМетод("PUT", Запрос);

	Результат.КодHTTP = Ответ.КодСостояния;
	Если Ответ.КодСостояния = 401 Тогда
		Результат.Статус = "НуженТокен";
		Возврат Результат;
	КонецЕсли;
	Если Ответ.КодСостояния <> 200 Тогда
		Результат.Статус = "ОшибкаHTTP";
		Результат.Сообщение = "Присоединение подписи HTTP " + Ответ.КодСостояния + ": "
			+ Лев(Ответ.ПолучитьТелоКакСтроку("UTF-8"), 800);
		Возврат Результат;
	КонецЕсли;

	// отправка стартовала - фиксируем локальный статус 40 (Отправлен) + идентификатор
	ЗаписатьСтатусЭДО(Ссылка, 40, ИдДокумента);
	Результат.Статус = "Отправлен";
	Возврат Результат;
КонецФункции

// Текущий токен из хранилища (пустая строка, если нет).
// Токен выдается пользователю кабинета по сертификату, поэтому хранится по отпечатку и общим
// для всех пользователей базы: регламент и бухгалтер пользуются одним и тем же.
Функция ТекущийТокен(Знач Организация = Неопределено) Экспорт
	Отпечаток = ОтпечатокПодписанта(Организация);
	Если НЕ ЗначениеЗаполнено(Отпечаток) Тогда
		Возврат "";
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Возврат Строка(ПрочитатьНастройкуХранилища("ЭДО_Токены", Отпечаток, ""));
КонецФункции

// Write-back статуса ЭДО и идентификатора документа в РегистрСведений.ЗначенияСвойствОбъектов.
// Статус - Число (карта обработки: 40 Отправлен, 60 Отклонён, 13 Аннулирован, 90 Удалён, 11 Ожидает оплаты).
Процедура ЗаписатьСтатусЭДО(Ссылка, Статус, ИдДокумента) Экспорт
	СвойствоСтатус = СвойствоОбъектов("ЭДО_КодСостояния");
	СвойствоИд     = СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если СвойствоСтатус <> Неопределено И НЕ СвойствоСтатус.Пустая() Тогда
		ЗаписатьЗначениеСвойства(Ссылка, СвойствоСтатус, Статус);
	КонецЕсли;
	Если ЗначениеЗаполнено(ИдДокумента) И СвойствоИд <> Неопределено И НЕ СвойствоИд.Пустая() Тогда
		ЗаписатьЗначениеСвойства(Ссылка, СвойствоИд, Строка(ИдДокумента));
		ЗапомнитьОтпечатокОтправки(Ссылка);
	КонецЕсли;
КонецПроцедуры

// Запомнить, с какой суммой и какому покупателю (ИНН) документ ушёл контрагенту.
//
// Это единственная точка, где отпечаток появляется: рядом с идентификатором и в тот же
// момент. Позже сумму отправки уже не восстановить - документ правят, и "что ушло"
// остаётся только у оператора, за HTTP-запросом на каждый документ.
//
// Отпечаток ПЕРЕЗАПИСЫВАЕТСЯ при каждой отправке: переотправили исправленный - расхождение
// исчезает само. Иначе свойство повторило бы судьбу ЭДО_ПометкаКОтправке, которую снимают
// не всегда, и по ней уже ничего нельзя судить.
Процедура ЗапомнитьОтпечатокОтправки(Ссылка) Экспорт

	Свойство = СвойствоОбъектов("ЭДО_ОтпечатокОтправки");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ЗаписатьЗначениеСвойства(Ссылка, Свойство, ОтпечатокДокумента(Ссылка));
	Исключение
 // Отпечаток - средство наблюдения, и его отказ не должен рушить саму отправку:
 // документ уже ушёл, откатывать нечего.
		ЗаписьЖР("Отпечаток отправки не записан: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			"Предупреждение", , Ссылка);
	КонецПопытки;

КонецПроцедуры

// Сумма и ИНН покупателя на момент отправки - то, в каком виде и кому документ ушёл.
// Формат "сумма|ИНН"; ИНН нужен, чтобы сторож видел смену контрагента при той же сумме.
//
// Хеша состава здесь намеренно НЕТ (решение оператора 12.09.2026): замер за 05-11.09
// показал 89 правок после отправки, из них 82 меняют сумму, а оставшиеся 7 оказались
// не пересортом, а переименованием карточки номенклатуры - в наименования зашиты даты
// партий, и товаровед их обновляет. То есть хеш ловил бы ложные срабатывания, а реального
// пересорта за неделю не случилось ни разу. Поработаем на сумме и посмотрим, нужен ли он.
Функция ОтпечатокДокумента(Знач Ссылка) Экспорт

	Ссылки = Новый Массив;
	Ссылки.Добавить(Ссылка);
	Отпечатки = ОтпечаткиДокументов(Ссылки);
	Значение = Отпечатки.Получить(Ссылка);
	Возврат ?(Значение = Неопределено, "", Значение);

КонецФункции

// Суммы пачкой: одним запросом на все документы сразу.
// Нужно сторожу - поштучное чтение на тысячах документов упирается в число запросов.
// Возврат: Соответствие (ссылка документа -> строка "сумма|ИНН").
Функция ОтпечаткиДокументов(Знач МассивСсылок) Экспорт

	Отпечатки = Новый Соответствие;
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат Отпечатки;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", МассивСсылок);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РТУ.Ссылка КАК Ссылка,
	|	РТУ.СуммаДокумента КАК Сумма,
	|	ЕСТЬNULL(РТУ.Контрагент.ИНН, """") КАК ИНН
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РТУ
	|ГДЕ
	|	РТУ.Ссылка В (&Ссылки)";
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Отпечатки.Вставить(Выборка.Ссылка,
			Формат(Выборка.Сумма, "ЧДЦ=2; ЧГ=0; ЧРД=.") + "|" + СокрЛП(Выборка.ИНН));
	КонецЦикла;

	Возврат Отпечатки;

КонецФункции

// Разобрать отпечаток. Возврат: Структура (Сумма, ИНН, ЕстьИНН, Разобран).
// Отпечатки до 1.5.6.0 хранят только сумму: у них ЕстьИНН = Ложь, и покупатель не сверяется.
Функция РазобратьОтпечаток(Знач Отпечаток) Экспорт

	Результат = Новый Структура("Сумма, ИНН, ЕстьИНН, Разобран", 0, "", Ложь, Ложь);
	Текст = СокрЛП(Строка(Отпечаток));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	Позиция = СтрНайти(Текст, "|");
	Если Позиция > 0 Тогда
		Результат.ИНН = СокрЛП(Сред(Текст, Позиция + 1));
		Результат.ЕстьИНН = Истина;
		Текст = СокрЛП(Лев(Текст, Позиция - 1));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Результат.Сумма = Число(Текст);
	Исключение
		Возврат Результат;
	КонецПопытки;
	Результат.Разобран = Истина;

	Возврат Результат;

КонецФункции

// Операторы, которые в роуминге не принимают формализованный акт сверки: получатель отвечает отказом
// "не поддерживает обмен АктСверкиВзаимныхРасчетовОтправитель". Таким получателям акт уходит
// печатной формой в PDF неформализованным документом. Список пополняется по факту такого отказа.
Функция ОператорБезФорматаАктаСверки(Знач ИдПолучателя) Экспорт

	Префиксы = СтрРазделить("2AE", ",");
	Возврат Префиксы.Найти(ВРег(Лев(СокрЛП(ИдПолучателя), 3))) <> Неопределено;

КонецФункции

// Создать у оператора неформализованный документ с печатной формой акта в PDF и загрузить файл.
// Без подписи документ никуда не уходит, поэтому при сбое загрузки черновик удаляется.
// Возврат: Структура (ИдДокумента, Данные, Ошибка).
Функция СоздатьАктСверкиФайлом(Ссылка, Организация, Знач ИдПолучателя)

	Итог = Новый Структура("ИдДокумента, Данные, Ошибка", "", Неопределено, "");
	Итог.Данные = ЭДО_АктСверкиДанные.ПечатнаяФормаPDF(Ссылка);

	Метки = Новый Массив;
	Метки.Добавить("Акт сверки");
	Описание = Новый Структура("senderGid, recipientGid, type, topic, labels, docDate, docNum",
		ГидОрганизации(Организация), ИдПолучателя, "UNFORMALIZED",
		"Акт сверки взаиморасчетов № " + СокрЛП(Ссылка.Номер) + " от " + Формат(Ссылка.Дата, "ДФ=dd.MM.yyyy"),
		Метки, Формат(Ссылка.Дата, "ДФ=dd.MM.yyyy"), СокрЛП(Ссылка.Номер));

	Ответ = ЗапросКОператоруЭДО("POST", "/public/api/v3/documents", СтрокаJSON(Описание), Организация);
	Если Ответ.Код <> 200 Тогда
		Итог.Ошибка = "Создание документа с актом в PDF HTTP " + Ответ.Код + ": " + Лев(Ответ.Текст, 800);
		Возврат Итог;
	КонецЕсли;
	ИдДокумента = ИзвлечьИдентификатор(Ответ.Текст);
	Если НЕ ЗначениеЗаполнено(ИдДокумента) Тогда
		Итог.Ошибка = "Оператор создал документ с актом в PDF, но не вернул id: " + Лев(Ответ.Текст, 800);
		Возврат Итог;
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/pdf");
	Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));
	Запрос = Новый HTTPЗапрос(ПутьСервиса("document") + "/public/api/v3/documents/" + ИдДокумента + "/content", Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(Итог.Данные);
	Загрузка = СоединениеСОператором(60).ВызватьHTTPМетод("POST", Запрос);
	Если Загрузка.КодСостояния <> 200 И Загрузка.КодСостояния <> 204 Тогда
		ЗапросКОператоруЭДО("DELETE", "/public/api/v3/documents/" + ИдДокумента, , Организация);
		Итог.Ошибка = "Файл акта не загружен (HTTP " + Загрузка.КодСостояния + "), черновик у оператора удален: "
			+ Лев(Загрузка.ПолучитьТелоКакСтроку("UTF-8"), 500);
		Возврат Итог;
	КонецЕсли;

	Итог.ИдДокумента = ИдДокумента;
	Возврат Итог;

КонецФункции

// Отправка АКТА СВЕРКИ по ЭДО (формализованный ON_AKTSVEROTP 5.01, приказ ФНС ЕД-7-26/405@).
// Путь ОТДЕЛЬНЫЙ от УПД/УКД и намеренно не трогает движок вендора: XML собирают наши
// модули ЭДО_АктСверкиДанные + ЭДО_ФорматАктСверки, настроек маппинга у акта нет вовсе.
// Стороны Платформа берёт ИЗ САМОГО XML (идентификаторы стоят в ИдФайл), поэтому
// senderGid/recipientGid в запросе не передаются.
// Возврат: Структура (Ссылка, Статус, ИдДокумента, Сообщение),
// Статус из "Отправлен" | "ТребуетВнимания" | "Отсеян" | "Пропущен" | "Ошибка".
Функция ОтправитьАктСверкиПоЭДО(Ссылка) Экспорт
	Результат = Новый Структура("Ссылка, Статус, ИдДокумента, Сообщение", Ссылка, "", "", "");

	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.АктСверкиВзаиморасчетов") Тогда
		Результат.Статус = "Ошибка";
		Результат.Сообщение = "Ожидался акт сверки взаиморасчетов";
		Возврат Результат;
	КонецЕсли;
	Организация = ОрганизацияДокумента(Ссылка);

	// У акта сверки в УТ 10.3 проведение ЗАПРЕЩЕНО метаданными: реквизит "Проведен"
	// у всех актов Ложь всегда (проверено на 3 189 актах 2026 года). Проверка проведённости,
	// скопированная из отправки накладной, блокировала отправку ЛЮБОГО акта - поймано
	// оператором 07.09.2026. - судим по виду документа, а не по общей привычке:
	// у непроводимых признак готовности - отсутствие пометки удаления.
	МетаАкт = Метаданные.Документы.АктСверкиВзаиморасчетов;
	ПроведениеРазрешено = (МетаАкт.Проведение <> Метаданные.СвойстваОбъектов.Проведение.Запретить);
	Если ПроведениеРазрешено И НЕ Ссылка.Проведен Тогда
		Результат.Статус = "ТребуетВнимания";
		Результат.Сообщение = "Акт не проведен — отправлять нечего";
		Возврат Результат;
	КонецЕсли;
	Если Ссылка.ПометкаУдаления Тогда
		Результат.Статус = "ТребуетВнимания";
		Результат.Сообщение = "Акт помечен на удаление — отправлять нечего";
		Возврат Результат;
	КонецЕсли;

	// Гейт организации - тот же, что у УПД: умолчание ЗАПРЕТ (решение оператора 06.09.2026)
	ПричинаОрганизации = ПричинаЗапретаПоОрганизации(Ссылка);
	Если ЗначениеЗаполнено(ПричинаОрганизации) Тогда
		Результат.Статус = "Отсеян";
		Результат.Сообщение = ПричинаОрганизации;
		Возврат Результат;
	КонецЕсли;

	ИдПолучателя = ИдентификаторУчастникаЭДО(Ссылка.Контрагент);
	Если НЕ ЗначениеЗаполнено(ИдПолучателя) Тогда
		Результат.Статус = "ТребуетВнимания";
		Результат.Сообщение = "У контрагента не заполнен адрес ЭДО — акт слать некуда";
		Возврат Результат;
	КонецЕсли;

	// Наш же адрес у контрагента = отправка самому себе (розничные и служебные карточки)
	Если АдресЭДОНаш(ИдПолучателя) Тогда
		ЗаписатьЧитаемыйСтатус(Ссылка, ТекстСтатусаОтправкаНеТребуется());
		Результат.Статус = "Отсеян";
		Результат.Сообщение = "Адрес получателя — наш собственный, отправка не требуется";
		Возврат Результат;
	КонецЕсли;

	// Занимаем документ ДО обращения к API - та же защита от дублей, что у УПД
	// (17.08.2026: параллельные прогоны задвоили 593 накладные).
	Занятие = ЗанятьДокументКОтправке(Ссылка);
	Если НЕ Занятие.Занят Тогда
		Результат.Статус = "Пропущен";
		Результат.Сообщение = Занятие.Причина;
		Возврат Результат;
	КонецЕсли;

	ИдСозданного = "";
	Попытка

		Если НЕ ОбеспечитьТокен(Ложь, Организация) Тогда
			ОсвободитьДокумент(Ссылка);
			Результат.Статус = "Ошибка";
			Результат.Сообщение = "Не удалось получить токен авторизации (КЭП на сервере/подпись)";
			Возврат Результат;
		КонецЕсли;

 // -- Сборка XML нашим генератором ---
		Если ОператорБезФорматаАктаСверки(ИдПолучателя) Тогда
			Создание = СоздатьАктСверкиФайлом(Ссылка, Организация, ИдПолучателя);
			Если НЕ ЗначениеЗаполнено(Создание.ИдДокумента) Тогда
				ОсвободитьДокумент(Ссылка);
				Результат.Статус = "Ошибка";
				Результат.Сообщение = Создание.Ошибка;
				Возврат Результат;
			КонецЕсли;
			ИдДокумента = Создание.ИдДокумента;
			ДанныеДокумента = Создание.Данные;
		Иначе
			Сборка = ЭДО_АктСверкиДанные.XMLПоДокументу(Ссылка, ГидОрганизации(Организация), ИдПолучателя);
			Если Сборка.Ошибки.Количество() > 0 Тогда
				ОсвободитьДокумент(Ссылка);
				ТекстОшибок = "";
				Для Каждого СтрокаОшибки Из Сборка.Ошибки Цикл
					ТекстОшибок = ТекстОшибок + ?(ЗначениеЗаполнено(ТекстОшибок), "; ", "") + СтрокаОшибки;
				КонецЦикла;
				Результат.Статус = "ТребуетВнимания";
				Результат.Сообщение = "Акт не собран: " + Лев(ТекстОшибок, 800);
				Возврат Результат;
			КонецЕсли;

			ДвоичныеXML = ПолучитьДвоичныеДанныеИзСтроки(Сборка.ТекстXML, "windows-1251", Ложь);

	 // -- Создание документа у оператора (POST /documents, он же ФЛК) ---
			Заголовки = Новый Соответствие;
			Заголовки.Вставить("Content-Type", "application/xml");
			Заголовки.Вставить("accept", "application/json;charset=UTF-8");
			Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));

			Соединение = HTTPСоединениеЭДО();
			Запрос = Новый HTTPЗапрос(ПутьСервиса("document") + "/public/api/v3/documents", Заголовки);
			Запрос.УстановитьТелоИзДвоичныхДанных(ДвоичныеXML);
			Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
			ТелоОтвета = Ответ.ПолучитьТелоКакСтроку("UTF-8");

	 // один перевыпуск токена по 401 - как в отправке УПД
			Если Ответ.КодСостояния = 401 И ОбеспечитьТокен(Истина, Организация) Тогда
				Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));
				Запрос = Новый HTTPЗапрос(ПутьСервиса("document") + "/public/api/v3/documents", Заголовки);
				Запрос.УстановитьТелоИзДвоичныхДанных(ДвоичныеXML);
				Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
				ТелоОтвета = Ответ.ПолучитьТелоКакСтроку("UTF-8");
			КонецЕсли;

			Если Ответ.КодСостояния <> 200 Тогда
				ОсвободитьДокумент(Ссылка);
				Результат.Статус = "Ошибка";
				Результат.Сообщение = "ФЛК HTTP " + Ответ.КодСостояния + ": " + Лев(ТелоОтвета, 800);
				Возврат Результат;
			КонецЕсли;

			ИдДокумента = ИзвлечьИдентификатор(ТелоОтвета);
			Если НЕ ЗначениеЗаполнено(ИдДокумента) Тогда
				ОсвободитьДокумент(Ссылка);
				Результат.Статус = "Ошибка";
				Результат.Сообщение = "ФЛК вернул 200, но id документа не найден: " + Лев(ТелоОтвета, 800);
				Возврат Результат;
			КонецЕсли;
			ДанныеДокумента = ДвоичныеXML;
		КонецЕсли;

 // ПАТЧ-ИД-СРАЗУ: документ уже создан у оператора - фиксируем id ДО подписи.
 // Мотив тот же, что у УПД: таймаут прилетает исключением и уносит нас мимо write-back,
 // а следующий прогон без id создал бы второй экземпляр у контрагента.
		ЗаписатьСтатусЭДО(Ссылка, 20, ИдДокумента);
		ИдСозданного = ИдДокумента;
		Результат.ИдДокумента = ИдДокумента;

		ПодписьДокумента = ПодписатьДанные(ДанныеДокумента, Организация);
		Если ПодписьДокумента = Неопределено Тогда
			Результат.Статус = "ТребуетВнимания";
			ЗаписатьЧитаемыйСтатус(Ссылка, "Отправляется");
			Результат.Сообщение = "Акт создан у оператора (id " + ИдДокумента
				+ "), но не подписан КЭП — завершить или удалить вручную";
			Возврат Результат;
		КонецЕсли;

		Присоединение = ПрисоединитьПодписьИЗаписать(Ссылка, ИдДокумента, ПодписьДокумента);
		Если Присоединение.Статус = "НуженТокен" И ОбеспечитьТокен(Истина, Организация) Тогда
			Присоединение = ПрисоединитьПодписьИЗаписать(Ссылка, ИдДокумента, ПодписьДокумента);
		КонецЕсли;

		Если Присоединение.Статус = "Отправлен" Тогда
			Результат.Статус = "Отправлен";
 // Читаемый статус пишем ЗДЕСЬ, а не ждём регламента: PEDO-StatusSync обходит
 // только реализации, и колонка "Состояние ЭДО" у акта осталась бы пустой -
 // отправленный документ выглядел бы неотправленным (поймано 07.09.2026).
			ЗаписатьЧитаемыйСтатус(Ссылка, "Отправлен");
		Иначе
			ЗаписатьСтатусЭДО(Ссылка, 20, ИдДокумента);
			ЗаписатьЧитаемыйСтатус(Ссылка, "Отправляется");
			Результат.Статус = "Ошибка";
			Результат.Сообщение = ?(Присоединение.Статус = "НуженТокен",
				"Не удалось авторизоваться при присоединении подписи", Присоединение.Сообщение);
		КонецЕсли;

	Исключение
		Если ЗначениеЗаполнено(ИдСозданного) Тогда
			ЗаписатьСтатусЭДО(Ссылка, 20, ИдСозданного);
			ЗаписатьЧитаемыйСтатус(Ссылка, "Отправляется");
			Результат.ИдДокумента = ИдСозданного;
			Результат.Сообщение = "Связь оборвалась после создания акта у оператора (id "
				+ ИдСозданного + "): " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Иначе
			ЗаписатьСтатусЭДО(Ссылка, 10, "");
			Результат.Сообщение = "Отправка прервана связью, состояние у оператора неизвестно —"
				+ " проверить по номеру акта: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецЕсли;
		Результат.Статус = "ТребуетВнимания";
		ЗаписьЖурналаРегистрации("ЭДО.ОтправкаАктаСверки", УровеньЖурналаРегистрации.Ошибка,
			, Ссылка, Результат.Сообщение);
	КонецПопытки;

	Возврат Результат;
КонецФункции


// Состояния ЭДО пачкой: Соответствие(ДокументСсылка текст состояния).
// Тот же источник, что у колонки "ЭДО" в обработке заявок и у карточки "Состояние ЭДО" -
// свойство ЭДО_Состояние, которое пишет регламент PEDO-StatusSync. Одна правда на все места.
// Нужна колонке "Состояние ЭДО" в обычных формах списков: там строк на экране два десятка,
// и поштучное чтение свойства дало бы столько же запросов на каждую прокрутку.
Функция СостоянияЭДОПоДокументам(Знач МассивСсылок) Экспорт
	Результат = Новый Соответствие;
	Если МассивСсылок = Неопределено ИЛИ МассивСсылок.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Свойство = СвойствоОбъектов("ЭДО_Состояние");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Объект КАК Объект, Значение КАК Значение
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Объект В (&Объекты) И Свойство = &Свойство");
	Запрос.УстановитьПараметр("Объекты", МассивСсылок);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Объект, СокрЛП(Строка(Выборка.Значение)));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Обслуживает ли наш контур этот документ. Серверная копия ЭДО_Клиент.НашКонтурЭДО.
Функция ДокументКонтураЭДО(Знач Ссылка) Экспорт
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	ТипДокумента = ТипЗнч(Ссылка);
	Возврат ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.АктСверкиВзаиморасчетов");
КонецФункции

// Текст гиперссылки "Состояние ЭДО" в форме документа: то же, что колонка "ЭДО",
// плюс входящий запрос на аннулирование, если он есть.
Функция ТекстСостоянияДляФормыДокумента(Знач Ссылка) Экспорт

	Ссылки = Новый Массив;
	Ссылки.Добавить(Ссылка);
	Состояние = СостоянияЭДОПоДокументам(Ссылки).Получить(Ссылка);
	Текст = "ЭДО: " + ?(ЗначениеЗаполнено(Состояние), Состояние, "не отправлялся");

	СвойствоЗапрос = СвойствоОбъектов("ЭДО_ЗапросАннулирования");
	Если СвойствоЗапрос <> Неопределено И НЕ СвойствоЗапрос.Пустая() Тогда
		Запрос = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Ссылка, СвойствоЗапрос)));
		Если ЗначениеЗаполнено(Запрос) Тогда
			// Пока запрос открыт, колонка сама пишет ТекстЗапросаАннулирования вместо статуса -
			// тогда статус не повторяем, а дописываем к нему причину.
			Если СокрЛП(Состояние) = ТекстЗапросаАннулирования() Тогда
				Текст = "ЭДО: " + ТекстЗапросаАннулирования() + ": " + Запрос;
			Иначе
				Текст = Текст + ". " + ТекстЗапросаАннулирования() + ": " + Запрос;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Состояние документа человеческим текстом - запасной путь, если карточку открыть не удалось.
//
// Управляемые формы открываются из обычных без всяких оговорок, и наоборот: проверено
// оператором многократно, в том числе на этой самой карточке. Прежний комментарий утверждал
// обратное и был неверен - снято 08.09.2026.
//
// Поэтому здесь именно запасной путь на случай реальной ошибки открытия, а не обход
// мнимого ограничения платформы: то же содержание по данным базы, без похода в API оператора.
Функция СводкаСостоянияЭДО(Знач Ссылка) Экспорт
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "Состояние ЭДО: документ не выбран.";
	КонецЕсли;
	Строки = Новый Массив;
	Строки.Добавить(Строка(Ссылка));

	Состояние = "";
	СвойствоСостояния = СвойствоОбъектов("ЭДО_Состояние");
	Если СвойствоСостояния <> Неопределено И НЕ СвойствоСостояния.Пустая() Тогда
		Состояние = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Ссылка, СвойствоСостояния)));
	КонецЕсли;
	Идентификатор = "";
	СвойствоИд = СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если СвойствоИд <> Неопределено И НЕ СвойствоИд.Пустая() Тогда
		Идентификатор = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Ссылка, СвойствоИд)));
	КонецЕсли;

	// Пустое состояние ЕЩЁ НЕ значит "не отправлялся": у документа может стоять
	// идентификатор Платформы, а ход отправки просто не дошёл до колонки. Врать
	// "не отправлялся" на отправленном документе нельзя - это провоцирует дубль.
	Если НЕ ПустаяСтрока(Состояние) Тогда
		Строки.Добавить("Состояние: " + Состояние);
	ИначеЕсли НЕ ПустаяСтрока(Идентификатор) Тогда
		Строки.Добавить("Состояние: отправлен, ход отправки ещё не получен");
	Иначе
		Строки.Добавить("Состояние: по ЭДО не отправлялся");
	КонецЕсли;
	Если НЕ ПустаяСтрока(Идентификатор) Тогда
		Строки.Добавить("Документ в Платформе: " + Идентификатор);
	КонецЕсли;

	Контрагент = Неопределено;
	Попытка
		Контрагент = Ссылка.Контрагент;
	Исключение
		Контрагент = Неопределено;
	КонецПопытки;
	Если ЗначениеЗаполнено(Контрагент) Тогда
		Адрес = "";
		СвойствоАдреса = СвойствоОбъектов("ЭДО_АдресКонтрагента");
		Если СвойствоАдреса <> Неопределено И НЕ СвойствоАдреса.Пустая() Тогда
			Адрес = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Контрагент, СвойствоАдреса)));
		КонецЕсли;
		Строки.Добавить("Контрагент: " + Строка(Контрагент));
		Строки.Добавить("Адрес ЭДО: " + ?(ПустаяСтрока(Адрес), "не заполнен — слать некуда", Адрес));
	КонецЕсли;

	Строки.Добавить("");
	Строки.Добавить("Подробности и история отправок — в обработке «Обработка заявок»,");
	Строки.Добавить("карточка «Состояние ЭДО» (открывается в тонком клиенте).");

	Текст = "";
	Для Каждого СтрокаТекста Из Строки Цикл
		Текст = Текст + ?(ПустаяСтрока(Текст) И ПустаяСтрока(СтрокаТекста), "", Символы.ПС) + СтрокаТекста;
	КонецЦикла;
	Возврат СокрЛП(Текст);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сертификат подписанта из личного хранилища учётки, под которой идёт код
// (на сервере - учётка службы кластера). Неопределено, если не найден/крипто недоступно.
Функция СертификатПодписанта(Знач Организация = Неопределено)
	Отпечаток = ОтпечатокПодписанта(Организация);
	Если НЕ ЗначениеЗаполнено(Отпечаток) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		МенеджерКриптографии = Новый МенеджерКриптографии("", "", 80);
		Хранилище = МенеджерКриптографии.ПолучитьХранилищеСертификатов(
			ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
		Возврат Хранилище.НайтиПоОтпечатку(Base64Значение(Отпечаток));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Служебный JSON авторизации {"ts":<unix>,"nonce":<uuid>} как ДвоичныеДанные (UTF-8).
Функция ДанныеАвторизацииJSON()
	JSON = "{""ts"":" + Формат(УниверсальноеВремя(ТекущаяДата()) - Дата(1970, 1, 1), "ЧГ=0")
		+ ",""nonce"":""" + Строка(Новый УникальныйИдентификатор()) + """}";
	Поток = Новый ПотокВПамяти;
	ЗаписьТекста = Новый ЗаписьТекста(Поток, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(JSON);
	ЗаписьТекста.Закрыть();
	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();
КонецФункции

Функция ПодключитьОбработкуЭДО()
	// Движок живёт в расширении ОБЪЕКТОМ (Обработка.ЭДО_ПлатформаЭДО), а не файлом в макете:
	// одна копия обслуживает и серверную отправку, и пользовательский интерфейс, поэтому
	// версии движка не могут разъехаться. Управляемые формы объекта расширения открываются
	// даже в базе на обычных формах - внешняя обработка так не умеет.
	Возврат Обработки.ЭДО_ПлатформаЭДО.Создать();
КонецФункции

// Загрузка комплекта настроек маппинга УТ 10.3 как "клиентских настроек" обработки
// (перекрывают штатные при сборке кэша - не зависит от разворота ПервыйЗапуск по пользователю).
// Движок читает клиентские настройки ДЛЯ ТЕКУЩЕГО пользователя
// (ПолучитьСохраненныеКлиентскиеНастройки ПолучитьТекущегоПользователя) - настройки нужны
// каждому, кто открывает обработку. Параметр позволяет разложить их администратором.
Процедура ЗагрузитьКлиентскиеНастройки(Знач ПользовательНастроек = "") Экспорт
	Массив = Новый Массив;
	Массив.Добавить(Новый Структура(
		"Применять, ИмяНастройки, ИмяФайлаНастройки, ОбъектНастройки, ФорматВыгрузки, ТекстНастройки",
		Истина, "УТ_10_3_Конфигурация", "УТ_10_3_Конфигурация", "Конфигурация", "",
		ТекстНастройкиКонфигурации()));
	Массив.Добавить(Новый Структура(
		"Применять, ИмяНастройки, ИмяФайлаНастройки, ОбъектНастройки, ФорматВыгрузки, ТекстНастройки",
		Истина, "УТ_10_3_РеализацияТоваровУслуг_ON_NSCHFDOPPR", "УТ_10_3_РеализацияТоваровУслуг_ON_NSCHFDOPPR",
		"РеализацияТоваровУслуг", "ON_NSCHFDOPPR",
		ТекстНастройкиРеализации()));
	Массив.Добавить(Новый Структура(
		"Применять, ИмяНастройки, ИмяФайлаНастройки, ОбъектНастройки, ФорматВыгрузки, ТекстНастройки",
		Истина, "УТ_10_3_КорректировкаРеализации_ON_NKORSCHFDOPPR", "УТ_10_3_КорректировкаРеализации_ON_NKORSCHFDOPPR",
		"КорректировкаРеализации", "ON_NKORSCHFDOPPR",
		ТекстНастройкиКорректировки()));
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", "КлиентскиеНастройки", Массив, "клиентские настройки",
		?(ЗначениеЗаполнено(ПользовательНастроек), ПользовательНастроек, ИмяПользователя()));
КонецПроцедуры

Процедура СохранитьТокен(Токен, Знач Организация = Неопределено)
	Отпечаток = ОтпечатокПодписанта(Организация);
	Если НЕ ЗначениеЗаполнено(Отпечаток) Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить("ЭДО_Токены", Отпечаток, Токен, , "");
КонецПроцедуры

// Текст статуса "отправка не требуется" для колонки "ЭДО" в обработке "Обработка заявок".
// Формулировка держится в одном месте: её же ищет отбор очереди в регламенте отправки,
// и расхождение в одну букву вернёт документы в очередь.
Функция ТекстСтатусаОтправкаНеТребуется() Экспорт
	Возврат "Отправка не требуется";
КонецФункции

// Человекочитаемый статус ЭДО (свойство ЭДО_Состояние) - то, что видит бухгалтерия в колонке.
// Не путать с ЭДО_КодСостояния: там числовой код хода отправки.
// Свойства может не быть (заводится не в каждой базе) - тогда молча ничего не пишем.
Процедура ЗаписатьЧитаемыйСтатус(Ссылка, Текст) Экспорт
	Свойство = СвойствоОбъектов("ЭДО_Состояние");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат;
	КонецЕсли;
	ЗаписатьЗначениеСвойства(Ссылка, Свойство, Лев(Текст, 50));
КонецПроцедуры

// Записать значение свойства объекта. Обёртка для вызова снаружи модуля.
Процедура ЗаписатьСвойствоОбъекта(Объект, Свойство, Знач Значение) Экспорт
	ЗаписатьЗначениеСвойства(Объект, Свойство, Значение);
КонецПроцедуры

// Пустая ссылка свойства - это "свойства нет", а не "свойство без значения": отбор по ней
// находит ноль строк, запись проходит без ошибки, и вызывающий получает "нечего снимать"
// вместо "такого свойства нет".
Процедура ПроверитьСсылкуСвойства(Знач Свойство, Знач Действие)
	Если Свойство = Неопределено Тогда
		ВызватьИсключение "ЭДО: " + Действие + " свойства объекта - свойство не передано (Неопределено)";
	КонецЕсли;
	Если ТипЗнч(Свойство) = Тип("ПланВидовХарактеристикСсылка.СвойстваОбъектов") И Свойство.Пустая() Тогда
		ВызватьИсключение "ЭДО: " + Действие + " свойства объекта по ПУСТОЙ ссылке свойства -"
			+ " такого свойства нет в плане видов характеристик СвойстваОбъектов";
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьЗначениеСвойства(Объект, Свойство, Значение)
	ПроверитьСсылкуСвойства(Свойство, "запись");
	Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Объект);
	Набор.Отбор.Свойство.Установить(Свойство);
	Запись = Набор.Добавить();
	Запись.Объект = Объект;
	Запись.Свойство = Свойство;
	Запись.Значение = Значение;
	Набор.Записать();
КонецПроцедуры

// Дописывает КрНаимСтрПр (краткое наименование страны происхождения) первым дочерним элементом
// ДопСведТов для каждой строки, где движок выгрузил СвДТ/@КодПроисх.
// Требование schematron ФНС: "присутствие КрНаимСтрПр при присутствии КодПроисх".
Функция ДополнитьКрНаимСтрПр(Знач Текст)
	Маркер = "<СвДТ КодПроисх=""";
	КэшСтран = Новый Соответствие;
	Результат = "";
	Остаток = Текст;

	Пока Истина Цикл
		Поз = СтрНайти(Остаток, Маркер);
		Если Поз = 0 Тогда
			Результат = Результат + Остаток;
			Прервать;
		КонецЕсли;

		Голова = Лев(Остаток, Поз - 1) + Маркер;
		Хвост = Сред(Остаток, Поз + СтрДлина(Маркер));

		ПозКавычки = СтрНайти(Хвост, """");
		КодСтраны = ?(ПозКавычки > 1, Лев(Хвост, ПозКавычки - 1), "");
		Наим = КэшСтран[КодСтраны];
		Если Наим = Неопределено Тогда
			СтранаСсылка = Справочники.КлассификаторСтранМира.НайтиПоКоду(КодСтраны);
			Наим = ?(ЗначениеЗаполнено(СтранаСсылка), СокрЛП(СтранаСсылка.Наименование), "");
			КэшСтран.Вставить(КодСтраны, Наим);
		КонецЕсли;

		ПозДоп = СтрНайти(Хвост, "<ДопСведТов");
		Если ЗначениеЗаполнено(Наим) И ПозДоп > 0 Тогда
			ЧастьДо = Лев(Хвост, ПозДоп - 1);
			ОстХвост = Сред(Хвост, ПозДоп);
			КонецТега = СтрНайти(ОстХвост, ">");
			Если КонецТега = 0 Тогда
				Результат = Результат + Голова;
				Остаток = Хвост;
				Продолжить;
			КонецЕсли;
			Открывающий = Лев(ОстХвост, КонецТега);
			ПослеТега = Сред(ОстХвост, КонецТега + 1);
			Элемент = "<КрНаимСтрПр>" + Наим + "</КрНаимСтрПр>";
			Если Прав(Открывающий, 2) = "/>" Тогда
				Открывающий = Лев(Открывающий, СтрДлина(Открывающий) - 2) + ">";
				Элемент = Элемент + "</ДопСведТов>";
			КонецЕсли;
			Результат = Результат + Голова + ЧастьДо + Открывающий + Элемент;
			Остаток = ПослеТега;
		Иначе
			Результат = Результат + Голова;
			Остаток = Хвост;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция HTTPСоединениеЭДО()
	ЗащищённоеСоединение = Новый ЗащищенноеСоединениеOpenSSL(Новый СертификатКлиентаWindows(), Неопределено);
	// Хост - только через ХостAPI(): он согласован с префиксами путей по текущему контуру.
	Возврат Новый HTTPСоединение(ХостAPI(), 443, , , ,
		НастройкаЭДО("ТаймаутHTTPСек"), ЗащищённоеСоединение);
КонецФункции

// Человекочитаемое имя владельца сертификата.
// Субъект сертификата - СТРУКТУРА, а не Соответствие: `Получить("CN")` падает
// "Метод объекта не обнаружен". Поймано 01.09.2026 живым вызовом - синтаксический
// контроль и /CheckConfig такое не видят, потому что тип известен только в работе.
Функция ПредставлениеСубъектаСертификата(Сертификат)
	Попытка
		Субъект = Сертификат.Субъект;
	Исключение
		Возврат "";
	КонецПопытки;

	Значение = ПолеСубъектаСертификата(Субъект, "CN");
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Значение = ПолеСубъектаСертификата(Субъект, "O");
	КонецЕсли;

	// У сертификатов УЦ ФНС поля зовутся не "ИНН", а по OID: ИНН физлица -
	// OID1_2_643_3_131_1_1, ИНН организации - OID1_2_643_100_4. Замерено на живом
	// сертификате 01.09.2026: состав полей - C, CN, SN, GN, OID1_2_643_100_5 (ОГРНИП),
	// OID1_2_643_100_3 (СНИЛС), OID1_2_643_3_131_1_1 (ИНН) и дубли по OID2_5_4_*.
	ИменаИНН = Новый Массив;
	ИменаИНН.Добавить("ИНН");
	ИменаИНН.Добавить("INN");
	ИменаИНН.Добавить("OID1_2_643_3_131_1_1");
	ИменаИНН.Добавить("OID1_2_643_100_4");
	ИНН = "";
	Для Каждого Имя Из ИменаИНН Цикл
		ИНН = ПолеСубъектаСертификата(Субъект, Имя);
		Если ЗначениеЗаполнено(ИНН) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(ИНН) Тогда
		Значение = Значение + ", ИНН " + ИНН;
	КонецЕсли;

	Возврат Значение;
КонецФункции

// Поле субъекта по имени, без учёта регистра.
// Тип контейнера не угадывать: `Субъект` бывает Структурой, ФиксированнойСтруктурой
// и Соответствием в зависимости от версии платформы - у первых нет `Получить`, у второй
// ещё и `Свойство` ведёт себя иначе. Обход циклом работает у всех трёх, и это
// единственный способ, проверенный на живом сертификате УЦ ФНС.
Функция ПолеСубъектаСертификата(Субъект, Имя) Экспорт
	Попытка
		Для Каждого Элемент Из Субъект Цикл
			Если ВРег(Строка(Элемент.Ключ)) = ВРег(Имя) Тогда
				Возврат Строка(Элемент.Значение);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат "";
	КонецПопытки;
	Возврат "";
КонецФункции

// Все поля субъекта строкой - для диагностики: у разных УЦ состав разный, и когда
// представление вышло пустым, надо видеть, что там вообще есть.
Функция ПоляСубъектаСертификата(Сертификат) Экспорт
	Имена = Новый Массив;
	Попытка
		Для Каждого Элемент Из Сертификат.Субъект Цикл
			Имена.Добавить(Строка(Элемент.Ключ));
		КонецЦикла;
	Исключение
		Возврат "субъект не читается: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат СтрСоединить(Имена, ", ");
КонецФункции

// Говорит ли текст ошибки проверки именно об ОТЗЫВЕ, а не о недоступности УЦ.
// Коды: 0x800B010C - CERT_E_REVOKED (отозван), 0x80092013 - CRYPT_E_REVOCATION_OFFLINE
// (список отзыва недоступен), 0x80092012 - статус отзыва определить не удалось.
// Последние два означают "не знаем", и путать их с отзывом нельзя.
Функция ПризнакОтзываСертификата(Текст)
	Нижний = НРег(Текст);
	Возврат СтрНайти(Нижний, "отозв") > 0
		ИЛИ СтрНайти(Нижний, "revok") > 0
		ИЛИ СтрНайти(Нижний, "800b010c") > 0;
КонецФункции

Функция ОчиститьBase64(Строка)
	Возврат СтрЗаменить(СтрЗаменить(Строка, Символы.ПС, ""), Символы.ВК, "");
КонецФункции

Функция ПрочитатьФайлТекст(Путь)
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат ТекстовыйДокумент.ПолучитьТекст();
КонецФункции

Функция ИзвлечьИдентификатор(ТелоJSON)
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТелоJSON);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
			Значение = Данные.Получить("id");
			Если ТипЗнч(Значение) = Тип("Число") Тогда
 // Строка(Число) вставляет разделители групп ("165 051 528") - для URL/хранения
 // нужен "ЧГ=0" (без разделителей): "165051528".
				Возврат Формат(Значение, "ЧГ=0");
			ИначеЕсли Значение <> Неопределено Тогда
				Возврат СокрЛП(Строка(Значение));
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат "";
КонецФункции

// Запись в журнал регистрации с уровнем, заданным строкой.
//
// Нужна клиентскому коду: на клиенте нет ни ЗаписьЖурналаРегистрации, ни перечисления
// УровеньЖурналаРегистрации, поэтому уровень передаётся именем: "Ошибка", "Предупреждение",
// "Информация", "Примечание".
//
// Неизвестное имя уровня не должно ронять вызывающего: сама запись в журнал почти всегда
// идёт из блока обработки ошибки, и падение здесь потеряло бы исходную ошибку.
Процедура ЗаписьЖР(ИмяСобытия, УровеньЖР = "Информация", ОбъектМД = Неопределено,
	Данные = Неопределено, Комментарий = "", РежимТранзакции = Неопределено) Экспорт

	Попытка
		Уровень = УровеньЖурналаРегистрации[УровеньЖР];
	Исключение
		Уровень = УровеньЖурналаРегистрации.Информация;
	КонецПопытки;

	Если РежимТранзакции = Неопределено Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, Уровень, ОбъектМД, Данные, Комментарий);
	Иначе
		ЗаписьЖурналаРегистрации(ИмяСобытия, Уровень, ОбъектМД, Данные, Комментарий, РежимТранзакции);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбновлениеСвязейЭДО

// Регламент обновления рабочего идентификатора ЭДО по принятому приглашению.
//
// Зачем: принятое контрагентом приглашение САМО ничего не переключает - отправка продолжает
// идти на адрес из свойства ЭДО_АдресКонтрагента. Регламент сверяет связи
// с оператором и переписывает рабочий адрес на тот, откуда пришло подтверждение.
//
// Правила (решения оператора 18.08.2026):
// рабочий адрес уже ESTABLISHED -> не трогаем (идемпотентность);
// рабочий пуст либо ведёт туда, где связи нет, а среди адресов есть ESTABLISHED
// > переписываем на подтверждённый;
// несколько подтверждений -> тот, где связь установлена РАНЬШЕ (state.lastUpdated),
// при равенстве: прежний адрес -> 2BE -> прочие -> 2VO;
// рабочий адрес BROKEN, замены нет -> снимаем идентификатор, чтобы документы не уходили в никуда.
//
// Кандидаты (все адреса контрагента из реестра ФНС) кэшируются в ХранилищеОбщихНастроек,
// а НЕ в свойствах: ресурс "Значение" регистра ЗначенияСвойствОбъектов - Строка(50),
// список адресов туда не влезает. Своя таблица не заводится намеренно - она потребовала бы
// реструктуризации и выгона пользователей при обновлении прода.
//
// Параметры:
// МаксКонтрагентов - Число - ограничение прогона (0 = без ограничения), для обкатки;
// ОбновлятьРеестрДней - Число - как часто перечитывать адреса контрагента из реестра ФНС.
// Возврат: Строка - отчёт о прогоне (он же уходит в журнал регистрации).
Функция ОбновитьСвязиЭДО(Знач МаксКонтрагентов = 0, Знач ОбновлятьРеестрДней = 7) Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Лог = Новый Массив;
	Счёт = Новый Структура("Проверено, Переписано, Снято, БезИзменений, НовыхАдресов, Ошибок, УстарелКПП", 0, 0, 0, 0, 0, 0, 0);

	СвИд    = СвойствоОбъектов("ЭДО_АдресКонтрагента");
	СвСвязь = СвойствоОбъектов("ЭДО_СтатусСвязи");
	СвПров  = СвойствоОбъектов("ЭДО_СвязьПроверена");
	Если СвИд = Неопределено ИЛИ СвИд.Пустая() Тогда
		Возврат "ОБНОВЛЕНИЕ СВЯЗЕЙ: не найдено свойство ЭДО_АдресКонтрагента";
	КонецЕсли;

	// Связь, адрес и пауза пока хранятся у контрагента, а не у пары «организация - контрагент».
	// При нескольких учетных записях связи сверяются по первой из них.
	ОрганизацияСвязей = Неопределено;
	Если НесколькоУчетныхЗаписейЭДО() Тогда
		ОрганизацияСвязей = УчетныеЗаписиЭДО()[0].Организация;
		Лог.Добавить("связи сверяются по учетной записи организации «" + Строка(ОрганизацияСвязей) + "»");
	КонецЕсли;
	НашГид = ГидОрганизации(ОрганизацияСвязей);
	Если НЕ ЗначениеЗаполнено(НашГид) Тогда
		Возврат "ОБНОВЛЕНИЕ СВЯЗЕЙ: не определён идентификатор своей организации";
	КонецЕсли;

	Контрагенты = КонтрагентыДляСверкиСвязей(СвИд, МаксКонтрагентов);

	// Карточки с ИНН нашей же организации (розничные "Физическое лицо КЭШ" и подобные) из обхода
	// убираем: по нашему ИНН реестр находит НАС, и карточке записывался наш собственный адрес
	// со статусом ESTABLISHED. Случай "чужой ИНН, а адрес наш" это не затрагивает - он ошибка данных.
	СвоиИНН = ИННСвоихОрганизаций();
	ПропущеноСвоих = 0;
	Индекс = Контрагенты.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если СвоиИНН[СокрЛП(Контрагенты[Индекс].ИНН)] <> Неопределено Тогда
			Контрагенты.Удалить(Индекс);
			ПропущеноСвоих = ПропущеноСвоих + 1;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	Лог.Добавить("контрагентов в обходе: " + Контрагенты.Количество()
		+ ?(ПропущеноСвоих > 0, ", пропущено карточек с ИНН наших организаций: " + ПропущеноСвоих, ""));

	Реестр = ЗагрузитьРеестрАдресов();
	Маршруты = ЗагрузитьФактическиеМаршруты();
	Соединение = HTTPСоединениеЭДО();
	Если НЕ ОбеспечитьТокен(Истина, ОрганизацияСвязей) Тогда
		Возврат "ОБНОВЛЕНИЕ СВЯЗЕЙ: не удалось получить токен авторизации";
	КонецЕсли;
	Заголовки = ЗаголовкиАвторизацииЭДО(ОрганизацияСвязей);
	Запросов = 0;
	СверкаЕГРЮЛ = НоваяСверкаЕГРЮЛ(30);

	// -- 1. добираем адреса-кандидаты тем, у кого их нет или кэш протух
	Для Каждого Стр Из Контрагенты Цикл
		ИНН = СокрЛП(Стр.ИНН);
		Если НЕ ЗначениеЗаполнено(ИНН) Тогда
			Продолжить;
		КонецЕсли;
		Запись = Реестр[ИНН];
		Если Запись <> Неопределено
			И (ТекущаяУниверсальнаяДата() - Запись.Обновлён) < ОбновлятьРеестрДней * 86400 Тогда
			Продолжить;
		КонецЕсли;

		Запросов = ПеревыпуститьТокенЭДО(Запросов, Заголовки, ОрганизацияСвязей);
		Найденные = АдресаИзРеестраФНС(Соединение, Заголовки, ИНН, СокрЛП(Стр.КПП), СверкаЕГРЮЛ);
		Запросов = Запросов + Найденные.Запросов;
		Если ЗначениеЗаполнено(Найденные.КППЕГРЮЛ) И Найденные.КППЕГРЮЛ <> ОчиститьКПП(Стр.КПП) Тогда
			Счёт.УстарелКПП = Счёт.УстарелКПП + 1;
			Лог.Добавить("  КПП " + Лев(СокрЛП(Строка(Стр.Контрагент)) + "                              ", 32)
				+ " в карточке " + СокрЛП(Стр.КПП) + ", в ЕГРЮЛ " + Найденные.КППЕГРЮЛ
				+ ", адресов по нему: " + Найденные.Адреса.Количество());
		КонецЕсли;
		Если Найденные.Ошибка Тогда
			Счёт.Ошибок = Счёт.Ошибок + 1;
			Продолжить;
		КонецЕсли;

		НоваяЗапись = Новый Структура("Адреса, Обновлён, Первый",
			Найденные.Адреса, ТекущаяУниверсальнаяДата(), Новый Соответствие);
		Если Запись <> Неопределено Тогда
			НоваяЗапись.Первый = Запись.Первый;
		КонецЕсли;
		Реестр.Вставить(ИНН, НоваяЗапись);
		Счёт.НовыхАдресов = Счёт.НовыхАдресов + Найденные.Адреса.Количество();
	КонецЦикла;

	// -- 2. собираем все интересующие адреса и спрашиваем связи пачками (см. РазмерПачкиСвязей)
	// contacts без gids отдаёт максимум 1000 записей и молча усекает картину.
	ВсеАдреса = Новый Массив;
	Для Каждого Стр Из Контрагенты Цикл
		Запись = Реестр[СокрЛП(Стр.ИНН)];
		Если Запись <> Неопределено Тогда
			Для Каждого Адрес Из Запись.Адреса Цикл
				Если ВсеАдреса.Найти(Адрес) = Неопределено Тогда
					ВсеАдреса.Добавить(Адрес);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ТекАдрес = СокрЛП(Строка(Стр.ТекИд));
		Если ЗначениеЗаполнено(ТекАдрес) И ВсеАдреса.Найти(ТекАдрес) = Неопределено Тогда
			ВсеАдреса.Добавить(ТекАдрес);
		КонецЕсли;
 // фактический маршрут тоже проверяем - у него приоритет при выборе
		ФактАдресСтр = Маршруты[СокрЛП(Стр.ИНН)];
		Если ФактАдресСтр <> Неопределено И ВсеАдреса.Найти(ФактАдресСтр) = Неопределено Тогда
			ВсеАдреса.Добавить(ФактАдресСтр);
		КонецЕсли;
	КонецЦикла;

	Запросов = ПеревыпуститьТокенЭДО(Запросов, Заголовки, ОрганизацияСвязей);
	Обход = СтатусыСвязейПолно(Соединение, Заголовки, НашГид, ВсеАдреса);
	Связи = Обход.Связи;
	Лог.Добавить("адресов проверено: " + Обход.Проверено + " из " + ВсеАдреса.Количество()
		+ ", связей получено: " + Связи.Количество()
		+ ?(Обход.Неудач > 0, ", НЕ ОПРОШЕНО: " + Обход.Неудач, ""));
	Если Обход.Неудач > 0 Тогда
 // решение по неполным данным опаснее бездействия: контрагента уведёт с рабочего адреса
		Итог = "ЭДО, обновление связей: ПРОГОН ОТМЕНЁН — не удалось опросить "
			+ Обход.Неудач + " адресов из " + ВсеАдреса.Количество() + ", адреса не менялись"
			+ ОтказыОбходаСтрокой(Обход);
		ЗаписьЖурналаРегистрации("ЭДО.ОбновлениеСвязей", УровеньЖурналаРегистрации.Предупреждение, , , Итог);
		Возврат Итог;
	КонецЕсли;

	// -- 3. решение по каждому контрагенту
	Для Каждого Стр Из Контрагенты Цикл
		Счёт.Проверено = Счёт.Проверено + 1;
		ИНН = СокрЛП(Стр.ИНН);
		Запись = Реестр[ИНН];
		Кандидаты = ?(Запись = Неопределено, Новый Массив, Запись.Адреса);
		ПервыйУвиден = ?(Запись = Неопределено, Новый Соответствие, Запись.Первый);
		ТекАдрес = СокрЛП(Строка(Стр.ТекИд));

 // ПАТЧ-ЗАКРЕПЛЁННЫЙ-АДРЕС: у контрагента с закреплённым адресом регламент не выбирает
 // ничего - ни по реестру ФНС, ни по contacts, ни по очерёдности подтверждений.
 // Мотив: эвристика нужна там, где выбор ЕЩЁ НЕ СДЕЛАН. Где он сделан и подтверждён
 // приёмкой документа, любая эвристика способна только испортить: 21.08.2026 регламент
 // вернул контрагента с Астрала (где его документ приняли) на ЭДО Лайт - там связь тоже
 // ESTABLISHED, а по приоритету 2LT и 2AE неразличимы, и победила очерёдность.
		Если ЗначениеЗаполнено(ТекАдрес) И АдресЭДОЗакреплён(Стр.Контрагент) Тогда
			СостЗакр = СостояниеСвязи(Связи, ТекАдрес);
			Решение = Новый Структура("Действие, Адрес, Статус, Закрепить, Основание", "оставить", ТекАдрес,
				?(СостЗакр = Неопределено, "", СостЗакр.Статус), Ложь, "");
		Иначе
			Решение = ВыбратьРабочийАдресЭДО(ТекАдрес, Кандидаты, Связи, ПервыйУвиден, Маршруты[ИНН]);
		КонецЕсли;

		Если Решение.Действие = "переписать" Тогда
			ЗаписатьЗначениеСвойства(Стр.Контрагент, СвИд, Решение.Адрес);
			Счёт.Переписано = Счёт.Переписано + 1;
			Лог.Добавить("  -> " + Лев(СокрЛП(Строка(Стр.Контрагент)) + "                              ", 32)
				+ " " + ?(ЗначениеЗаполнено(ТекАдрес), ТекАдрес, "(пусто)") + " => " + Решение.Адрес);
		ИначеЕсли Решение.Действие = "снять" Тогда
			НаборИд = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
			НаборИд.Отбор.Объект.Установить(Стр.Контрагент);
			НаборИд.Отбор.Свойство.Установить(СвИд);
			НаборИд.Записать(Истина);
			Счёт.Снято = Счёт.Снято + 1;
			Лог.Добавить("  X  " + Лев(СокрЛП(Строка(Стр.Контрагент)) + "                              ", 32)
				+ " связь BROKEN, идентификатор снят (" + ТекАдрес + ")");
		Иначе
			Счёт.БезИзменений = Счёт.БезИзменений + 1;
		КонецЕсли;

 // Закрепление фактического маршрута с неподтверждённым роумингом (правило 21.08).
 // Дальше карточка выходит из-под эвристики: выбор сделан, ждём подтверждения.
		Если Решение.Закрепить И НЕ АдресЭДОЗакреплён(Стр.Контрагент) Тогда
			Попытка
				ЗакрепитьАдресЭДО(Стр.Контрагент, Решение.Адрес, Решение.Основание);
				Лог.Добавить("  ЗАКР " + Лев(СокрЛП(Строка(Стр.Контрагент)) + "                              ", 32)
					+ " " + Решение.Адрес + " (" + Решение.Основание + ")");
			Исключение
				Счёт.Ошибок = Счёт.Ошибок + 1;
				Лог.Добавить("  ERR закрепление " + СокрЛП(Строка(Стр.Контрагент)) + ": "
					+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;

		Если СвСвязь <> Неопределено И НЕ СвСвязь.Пустая() И ЗначениеЗаполнено(Решение.Статус) Тогда
			ЗаписатьЗначениеСвойства(Стр.Контрагент, СвСвязь, Лев(Решение.Статус, 50));
		КонецЕсли;
		Если СвПров <> Неопределено И НЕ СвПров.Пустая() Тогда
			ЗаписатьЗначениеСвойства(Стр.Контрагент, СвПров, ТекущаяДата());
		КонецЕсли;

 // запоминаем момент первого подтверждения - страховка на случай, если оператор
 // перестанет отдавать lastUpdated (поля нет в документации, оно может исчезнуть)
		Если Запись <> Неопределено И ЗначениеЗаполнено(Решение.Адрес)
			И Запись.Первый[Решение.Адрес] = Неопределено Тогда
			Запись.Первый.Вставить(Решение.Адрес, ТекущаяУниверсальнаяДата());
		КонецЕсли;
	КонецЦикла;

	СохранитьРеестрАдресов(Реестр);
	Лог.Добавить("фактических маршрутов в справочнике: " + Маршруты.Количество());

	Секунд = Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000, 1);
	Итог = "ЭДО, обновление связей: проверено " + Счёт.Проверено
		+ ", переписан адрес у " + Счёт.Переписано
		+ ", снято (BROKEN) " + Счёт.Снято
		+ ", без изменений " + Счёт.БезИзменений
		+ ", ошибок реестра " + Счёт.Ошибок
		+ ?(Счёт.УстарелКПП > 0, ", КПП в карточке устарел у " + Счёт.УстарелКПП, "")
		+ ?(СверкаЕГРЮЛ.Капча, ", ЕГРЮЛ потребовал капчу", "")
		+ "; " + Секунд + " c";
	Лог.Вставить(0, Итог);
	Текст = СтрСоединить(Лог, Символы.ПС);

	ЗаписьЖурналаРегистрации("ЭДО.ОбновлениеСвязей",
		?(Счёт.Ошибок > 0, УровеньЖурналаРегистрации.Предупреждение, УровеньЖурналаРегистрации.Информация),
		, , Лев(Текст, 5000));

	Возврат Текст;
КонецФункции

// Выбор рабочего адреса по правилам оператора.
// Возврат: Структура (Действие "оставить"/"переписать"/"снять", Адрес, Статус).
Функция ВыбратьРабочийАдресЭДО(Знач ТекАдрес, Знач Кандидаты, Знач Связи, Знач ПервыйУвиден,
	Знач ФактАдрес = "") Экспорт

	Результат = Новый Структура("Действие, Адрес, Статус, Закрепить, Основание",
		"оставить", ТекАдрес, "", Ложь, "");

	// Фактический маршрут важнее "просто живого" адреса и важнее очерёдности подтверждений.
	// Контрагент читает тот ящик, куда мы слали годами; связь может быть установлена
	// и с другим его адресом, но документы там никто не смотрит (проверено 18.08 на
	// двух жалобах подряд - АТ-Ритейл и Постика).
	Если ЗначениеЗаполнено(ФактАдрес) И НЕ АдресЭДОВнеАвтовыбора(ФактАдрес) Тогда
		СостФакт = СостояниеСвязи(Связи, ФактАдрес);
		ФактЖивой = (СостФакт <> Неопределено И СостФакт.Статус = "ESTABLISHED");
		Если НЕ ФактЖивой И СостФакт = Неопределено И Лев(ФактАдрес, 3) = "2VO" Тогда
 // Пустой ответ contacts для 2VO - это лишь ПРЕДПОЛОЖЕНИЕ прямой связи внутри
 // Платформы, а не подтверждение: синтетический адрес "2VO-<ИНН>-<нули>" есть
 // у многих, кто там не работает. Поэтому уступаем адресу, который контрагент
 // подтвердил явно (18.08 такое правило увело Калашникова с подтверждённого
 // ночью 2LT обратно на 2VO, где его документ уже завис без ответа).
			СостТек = СостояниеСвязи(Связи, ТекАдрес);
			ФактЖивой = НЕ (СостТек <> Неопределено И СостТек.Статус = "ESTABLISHED");
		КонецЕсли;
		Если ФактЖивой Тогда
			Результат.Статус = ?(СостФакт = Неопределено, "DIRECT", "ESTABLISHED");
			Результат.Адрес = ФактАдрес;
			Результат.Действие = ?(НРег(ТекАдрес) = НРег(ФактАдрес), "оставить", "переписать");
			Возврат Результат;
		КонецЕсли;

 // ПРАВИЛО ОПЕРАТОРА 21.08: маршрут известен, а роуминг по нему НЕ подтверждён -
 // закрепляем маршрут и ДЕРЖИМ документы, пока контрагент не примет приглашение.
 // Отправлять их тем временем на другой живой адрес нельзя.
 // Мотив: молчаливый уход в чужой ящик хуже задержки - документ "SENT" для всех
 // сторожей, а контрагент его не видит, и жалоба приходит неделей позже.
 // Прецедент 04.09.2026 (Омнибус ООО): титул покупателя в архиве стоит на Диадоке,
 // приглашение туда висит AWAIT_APPROVAL - а карточка уезжала на 2VO, где отправок
 // не было ни одной.
 // Берём только AWAIT_APPROVAL: приглашение уже в пути, ждать есть чего. При
 // NO_CONTACT (приглашения не было вовсе) поведение прежнее - иначе документы
 // встанут навсегда и молча; рассылку туда решает отдельный сценарий приглашений.
		Если СостФакт <> Неопределено И СостФакт.Статус = "AWAIT_APPROVAL" Тогда
			Результат.Статус = "AWAIT_APPROVAL";
			Результат.Адрес = ФактАдрес;
			Результат.Действие = ?(НРег(ТекАдрес) = НРег(ФактАдрес), "оставить", "переписать");
			Результат.Закрепить = Истина;
			Результат.Основание = "фактический маршрут, ждём роуминг";
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	ТекСостояние = СостояниеСвязи(Связи, ТекАдрес);

	// пустой ответ contacts для пары абонентов ОДНОГО оператора (2VO2VO) - это НЕ "связи нет":
	// в ЛК такая пара показана как "настройка не требуется" - считаем адрес рабочим.
	// "настройка не требуется" удерживает карточку, только пока замены нет: с 02.09.2026
	// 2VO выведен из автовыбора, и при подтверждённом адресе у нормального оператора
	// контрагент переезжает туда - решение принимается ниже, по Подтверждённым.
	Если ЗначениеЗаполнено(ТекАдрес) И ТекСостояние = Неопределено И Лев(ТекАдрес, 3) = "2VO"
		И НЕ ЕстьПодтверждённаяЗамена(Кандидаты, Связи) Тогда
		Результат.Статус = "DIRECT";
		Возврат Результат;
	КонецЕсли;
	// адрес вне автовыбора (2LT) не "удерживает" карточку самим фактом живой связи:
	// ищем замену ниже, а если её нет - идентификатор снимается
	Если ТекСостояние <> Неопределено И ТекСостояние.Статус = "ESTABLISHED"
		И НЕ АдресЭДОВнеАвтовыбора(ТекАдрес) Тогда
		Результат.Статус = "ESTABLISHED";
		Возврат Результат;
	КонецЕсли;

	Подтверждённые = Новый Массив;
	Для Каждого Адрес Из Кандидаты Цикл
		Если АдресЭДОВнеАвтовыбора(Адрес) Тогда
			Продолжить;
		КонецЕсли;
		Состояние = СостояниеСвязи(Связи, Адрес);
		Если Состояние <> Неопределено И Состояние.Статус = "ESTABLISHED" Тогда
			Подтверждённые.Добавить(Адрес);
		КонецЕсли;
	КонецЦикла;

	Если Подтверждённые.Количество() = 0 Тогда
		Если ЗначениеЗаполнено(ТекАдрес) И АдресЭДОСнимаетсяБезЗамены(ТекАдрес) Тогда
 // "пустая запись": отправлять некуда - документы копятся в очереди и видны в разборе
			Результат.Действие = "снять";
			Результат.Адрес = "";
			Результат.Статус = ?(ТекСостояние = Неопределено, "NO_CONTACT", ТекСостояние.Статус);
			Возврат Результат;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекАдрес) И Лев(ТекАдрес, 3) = "2VO" И ТекСостояние = Неопределено Тогда
 // замены нет - ящик Платформы остаётся: доставка там работает, читают её плохо,
 // но пустая карточка остановила бы поток совсем (см. АдресЭДОСнимаетсяБезЗамены)
			Результат.Статус = "DIRECT";
			Возврат Результат;
		КонецЕсли;
		Если ТекСостояние <> Неопределено И ТекСостояние.Статус = "BROKEN" Тогда
			Результат.Действие = "снять";
			Результат.Адрес = "";
			Результат.Статус = "BROKEN";
		ИначеЕсли ТекСостояние <> Неопределено Тогда
			Результат.Статус = ТекСостояние.Статус;
		Иначе
			Результат.Статус = ?(ЗначениеЗаполнено(ТекАдрес), "NO_CONTACT", "");
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Лучший = "";
	ЛучшееВремя = Дата(3999, 12, 31);
	Для Каждого Адрес Из Подтверждённые Цикл
		Состояние = СостояниеСвязи(Связи, Адрес);
		Время = Состояние.Обновлён;
		Если НЕ ЗначениеЗаполнено(Время) Тогда
			Время = ?(ПервыйУвиден[Адрес] = Неопределено, ТекущаяУниверсальнаяДата(), ПервыйУвиден[Адрес]);
		КонецЕсли;
		Заменить = Ложь;
		Если Лучший = "" Тогда
			Заменить = Истина;
		ИначеЕсли Время < ЛучшееВремя Тогда
			Заменить = Истина;
		ИначеЕсли Время = ЛучшееВремя
			И ПриоритетАдресаЭДО(Адрес, ТекАдрес) < ПриоритетАдресаЭДО(Лучший, ТекАдрес) Тогда
			Заменить = Истина;
		КонецЕсли;
		Если Заменить Тогда
			Лучший = Адрес;
			ЛучшееВремя = Время;
		КонецЕсли;
	КонецЦикла;

	Результат.Адрес = Лучший;
	Результат.Статус = "ESTABLISHED";
	// адрес тот же - это не смена маршрута, а подтверждение; в журнал такое писать не за что
	Результат.Действие = ?(ВРег(Лучший) = ВРег(ТекАдрес), "оставить", "переписать");
	Возврат Результат;
КонецФункции

// Приоритет адреса при равном времени подтверждения: меньше - лучше.
// Прежний рабочий адрес важнее всего (маршрут не должен "переезжать" без причины), затем
// оператор, которым контрагент реально пользуется. 2VO последний: у 515 контрагентов ящик
// у самой Платформы заведён автоматически под кассы Эвотор, и там их никто не читает.
// Адрес, который автоматика выбирать НЕ имеет права - только человек, закреплением.
//
// Сейчас это "ЭДО Лайт" (2LT, ЦРПТ). Мотив (решение оператора 31.08.2026): канал
// доставляет ФОРМАЛЬНО и потому неотличим от рабочего ни одним нашим признаком - связь
// ESTABLISHED, документ SENT, квитанции DP_PDOTPR и DP_PDPOL подписаны, отказов нет.
// А человека за ящиком нет: титул покупателя не приходит, клиент документов не видит,
// и вскрывается это только его жалобой недели спустя (31.08, Трошева М. Н.: пять накладных
// с подтверждённым получением, которых она не видела; её рабочий адрес - 2BM, где она
// подписывала через СБИС ещё в июле).
// Автовыбор здесь особенно опасен тем, что 2LT часто ЕДИНСТВЕННАЯ живая связь:
// приглашения в рабочие каналы висят неподтверждёнными, и эвристика честно берёт то,
// что подтверждено. - пусть лучше документ не уйдёт вовсе и попадёт в разбор, чем уйдёт
// туда, откуда его никто не заберёт.
// Контрагентам, которые в ЭДО Лайт РЕАЛЬНО работают, адрес закрепляется вручную -
// закрепление сильнее этого правила (см. ПроверитьГотовностьКОтправке и ОбновитьСвязиЭДО).
// Есть ли среди кандидатов подтверждённый адрес, годный для автовыбора.
Функция ЕстьПодтверждённаяЗамена(Знач Кандидаты, Знач Связи)
	Для Каждого Адрес Из Кандидаты Цикл
		Если АдресЭДОВнеАвтовыбора(Адрес) Тогда
			Продолжить;
		КонецЕсли;
		Состояние = СостояниеСвязи(Связи, Адрес);
		Если Состояние <> Неопределено И Состояние.Статус = "ESTABLISHED" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция АдресЭДОВнеАвтовыбора(Знач Адрес) Экспорт
	Префикс = Лев(СокрЛП(Адрес), 3);
	Возврат Префикс = "2LT" ИЛИ Префикс = "2VO" ИЛИ Префикс = "2IM";
КонецФункции

// Как канал называется для человека. Гейт удержания один на все адреса вне автовыбора,
// а каналы за ним разные: 2LT - "ЭДО Лайт" (ЦРПТ), 2VO - ящик у самой
// "Платформы ЭДО", заведенный под кассы Эвотор, 2IM - ЕЭТП (решение оператора 23.09.2026). Общий текст называл любой из них
// "ЭДО Лайт", и бухгалтер шел разбираться не с тем оператором (обращение 04.09.2026,
// ТБ-00065585: удержан адрес 2VO, в тексте значилось "ЭДО Лайт").
Функция ИмяКаналаЭДО(Знач Адрес) Экспорт
	Префикс = ВРег(Лев(СокрЛП(Адрес), 3));
	Если Префикс = "2LT" Тогда
		Возврат "ЭДО Лайт";
	ИначеЕсли Префикс = "2VO" Тогда
		Возврат "ящик у Платформы ЭДО";
	ИначеЕсли Префикс = "2IM" Тогда
		Возврат "ЕЭТП";
	КонецЕсли;
	Возврат "резервный канал";
КонецФункции

// Имена операторов ЭДО по коду адреса: соответствие "2BM" - "Диадок" и т.д.
// Имени оператора в ответе API нет, таблица кодов лежит в макете "СлужебныеДанные" обработки вендора.
// Макет читать один раз на весь список: чтение на каждую строку стоит секунды.
Функция ОператорыЭДО() Экспорт

	Операторы = Новый Соответствие;
	Попытка
		Макет = Обработки.ЭДО_ПлатформаЭДО.ПолучитьМакет("СлужебныеДанные");
	Исключение
		Возврат Операторы;
	КонецПопытки;

	Для НомерСтроки = 1 По Макет.ВысотаТаблицы Цикл
		Код = ВРег(СокрЛП(Макет.Область(НомерСтроки, 1, НомерСтроки, 1).Текст));
		Представление = СокрЛП(Макет.Область(НомерСтроки, 2, НомерСтроки, 2).Текст);
		Если СтрДлина(Код) = 3 И ЗначениеЗаполнено(Представление) Тогда
			Операторы.Вставить(Код, Представление);
		КонецЕсли;
	КонецЦикла;

	// В макете вендора ЕЭТП нет, а адреса 2IM у контрагентов встречаются.
	Если Операторы.Получить("2IM") = Неопределено Тогда
		Операторы.Вставить("2IM", "ЕЭТП");
	КонецЕсли;

	Возврат Операторы;

КонецФункции

// Имя оператора по адресу ЭДО. Операторы - результат ОператорыЭДО(); не передан - макет читается здесь.
Функция ИмяОператораЭДО(Знач Адрес, Знач Операторы = Неопределено) Экспорт

	// Дефиса после кода может не быть: у СБИС адрес выглядит как "2BE140397E1B...",
	// поэтому режем ровно три символа, а не до разделителя.
	Адрес = СокрЛП(Адрес);
	Если СтрДлина(Адрес) < 3 Тогда
		Возврат "";
	КонецЕсли;
	Код = ВРег(Лев(Адрес, 3));

	Если Операторы = Неопределено Тогда
		Операторы = ОператорыЭДО();
	КонецЕсли;
	Если Операторы.Количество() = 0 Тогда
		Возврат Код;
	КонецЕсли;

	Представление = Операторы.Получить(Код);
	Возврат ?(Представление = Неопределено, Код + " (оператор не опознан)", Представление);

КонецФункции

// Из адресов вне автовыбора карточка ОБНУЛЯЕТСЯ только там, откуда документ заведомо не доходит.
// Разница между двумя каналами измерена 02.09.2026, и она принципиальна:
// "ЭДО Лайт" (2LT) в moroz закрыт требованием ГИС МТ - документ туда не уходит вовсе,
// поэтому пустая карточка честнее живой связи: работа попадает в разбор.
// А 2VO (ящик у самой Платформы, заведённый под кассы Эвотор) доставляет - его не читают.
// Снять его так же означало бы остановить поток: из 293 карточек prodline на 2VO
// живая альтернатива есть лишь у 10, у 227 адрес есть без связи, у 56 нет вовсе
// 283 контрагента остались бы без адреса, а это 654 документа в месяц в никуда.
// 2VO выводится из ВЫБОРА (регламент на него не уводит и переселяет, как только у контрагента
// появляется подтверждённая связь), но карточку не обнуляет.
Функция АдресЭДОСнимаетсяБезЗамены(Знач Адрес) Экспорт
	Возврат Лев(СокрЛП(Адрес), 3) = "2LT";
КонецФункции

Функция ПриоритетАдресаЭДО(Знач Адрес, Знач ПрежнийАдрес) Экспорт
	Если ЗначениеЗаполнено(ПрежнийАдрес) И Адрес = ПрежнийАдрес Тогда
		Возврат 0;
	КонецЕсли;
	Префикс = Лев(Адрес, 3);
	Если Префикс = "2BE" Тогда
		Возврат 1;
	ИначеЕсли Префикс = "2VO" ИЛИ Префикс = "2IM" Тогда
		Возврат 9;
	КонецЕсли;
	Возврат 5;
КонецФункции

// Контрагенты, которых имеет смысл сверять: те, кому уходили приглашения (у них есть отметка
// любого из свойств ЭДО), плюс те, по кому за последние 120 дней были отгрузки.
Функция КонтрагентыДляСверкиСвязей(Знач СвИд, Знач МаксКонтрагентов) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЭДОКонтрагент.Ссылка КАК Контрагент,
	|	ЭДОКонтрагент.ИНН КАК ИНН,
	|	ЭДОКонтрагент.КПП КАК КПП,
	|	МАКСИМУМ(ВЫРАЗИТЬ(ЭДОИд.Значение КАК СТРОКА(50))) КАК ТекИд
	|ИЗ
	|	Справочник.Контрагенты КАК ЭДОКонтрагент
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЭДОИд
	|		ПО ВЫРАЗИТЬ(ЭДОИд.Объект КАК Справочник.Контрагенты) = ЭДОКонтрагент.Ссылка
	|			И ЭДОИд.Свойство = &СвИд
	|ГДЕ
	|	НЕ ЭДОКонтрагент.ПометкаУдаления
	|	И НЕ ЭДОКонтрагент.ЭтоГруппа
	|	И НЕ ПОДСТРОКА(ЭДОКонтрагент.ИНН, 1, 1) = """"
	|	И (ЭДОИд.Значение ЕСТЬ НЕ NULL
	|		ИЛИ ЭДОКонтрагент.Ссылка В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ ЭДОРеализация.Контрагент
	|			 ИЗ Документ.РеализацияТоваровУслуг КАК ЭДОРеализация
	|			 ГДЕ ЭДОРеализация.Проведен
	|				И ЭДОРеализация.ОтражатьВБухгалтерскомУчете
	|				И ЭДОРеализация.Дата >= &ДатаС))
	|СГРУППИРОВАТЬ ПО
	|	ЭДОКонтрагент.Ссылка, ЭДОКонтрагент.ИНН, ЭДОКонтрагент.КПП
	|УПОРЯДОЧИТЬ ПО
	|	ИНН";
	Запрос.УстановитьПараметр("СвИд", СвИд);
	Запрос.УстановитьПараметр("ДатаС", НачалоДня(ТекущаяДата() - 120 * 86400));
	Таблица = Запрос.Выполнить().Выгрузить();

	Если МаксКонтрагентов > 0 И Таблица.Количество() > МаксКонтрагентов Тогда
		Урезанная = Таблица.СкопироватьКолонки();
		Для Инд = 0 По МаксКонтрагентов - 1 Цикл
			ЗаполнитьЗначенияСвойств(Урезанная.Добавить(), Таблица[Инд]);
		КонецЦикла;
		Возврат Урезанная;
	КонецЕсли;
	Возврат Таблица;
КонецФункции

// Все адреса контрагента в реестре ФНС.
// Для ЮЛ КПП обязателен (без него 400). КПП филиала может дать 404 - тогда пробуем
// основной КПП (первые 4 цифры ИНН + 01001): проверено на ПНППК, 404 -> 200 и 6 адресов.
// Если 404 на оба, а КПП в карточке устарел (ЮЛ сменило инспекцию), адреса ищутся по КПП из ЕГРЮЛ;
// СверкаЕГРЮЛ - структура из НоваяСверкаЕГРЮЛ, Неопределено - в ЕГРЮЛ не ходить.
// Возврат: Структура (Адреса Массив, Ошибка Булево, Запросов Число, КППЕГРЮЛ Строка).
Функция АдресаИзРеестраФНС(Соединение, Заголовки, Знач ИНН, Знач КПП, СверкаЕГРЮЛ = Неопределено) Экспорт

	Результат = Новый Структура("Адреса, Ошибка, Запросов, КППЕГРЮЛ", Новый Массив, Ложь, 0, "");
	ЮрЛицо = (СтрДлина(ИНН) = 10);
	БылСбой = Ложь;

	Варианты = Новый Массив;
	Если ЮрЛицо Тогда
		ЧистыйКПП = ОчиститьКПП(КПП);
		Если ЗначениеЗаполнено(ЧистыйКПП) Тогда
			Варианты.Добавить(ЧистыйКПП);
		КонецЕсли;
		ОсновнойКПП = Лев(ИНН, 4) + "01001";
		Если Варианты.Найти(ОсновнойКПП) = Неопределено Тогда
			Варианты.Добавить(ОсновнойКПП);
		КонецЕсли;
	Иначе
		Варианты.Добавить("");
	КонецЕсли;

	Для Каждого Вариант Из Варианты Цикл
		КодОтвета = ДобавитьАдресаИзРеестраФНС(Соединение, Заголовки, ИНН, Вариант, Результат);
		Если КодОтвета = 0 Тогда
			Результат.Ошибка = Истина;
			Возврат Результат;
		КонецЕсли;
		// 404 - абонента под этим КПП нет; любой другой код - запрос не выполнен, и пустой список не ответ.
		БылСбой = БылСбой ИЛИ (КодОтвета <> 200 И КодОтвета <> 404);
		Если Результат.Адреса.Количество() > 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ЮрЛицо И НЕ БылСбой И Результат.Адреса.Количество() = 0 И ТипЗнч(СверкаЕГРЮЛ) = Тип("Структура") Тогда
		Результат.КППЕГРЮЛ = ДействующийКППИзЕГРЮЛ(ИНН, СверкаЕГРЮЛ);
		Если ЗначениеЗаполнено(Результат.КППЕГРЮЛ) И Варианты.Найти(Результат.КППЕГРЮЛ) = Неопределено Тогда
			КодОтвета = ДобавитьАдресаИзРеестраФНС(Соединение, Заголовки, ИНН, Результат.КППЕГРЮЛ, Результат);
			БылСбой = (КодОтвета <> 200 И КодОтвета <> 404);
		КонецЕсли;
	КонецЕсли;

	Результат.Ошибка = БылСбой И Результат.Адреса.Количество() = 0;
	Возврат Результат;

КонецФункции

// Один запрос к реестру ФНС по паре ИНН и КПП; найденные адреса дописываются в Результат.Адреса.
// Возврат: код ответа HTTP, 0 - запрос не выполнен.
Функция ДобавитьАдресаИзРеестраФНС(Соединение, Заголовки, Знач ИНН, Знач КПП, Результат)

	Путь = ПутьСервиса("subscriber") + "/public/api/v3/shared-subscribers?inn=" + ИНН
		+ ?(ЗначениеЗаполнено(КПП), "&kpp=" + КПП, "");
	Попытка
		Ответ = Соединение.Получить(Новый HTTPЗапрос(Путь, Заголовки));
	Исключение
		Возврат 0;
	КонецПопытки;
	Результат.Запросов = Результат.Запросов + 1;
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат Ответ.КодСостояния;
	КонецЕсли;

	Тело = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	// смещение ровно 7 - длина ""gid":""; при 8 срезается первый символ идентификатора
	Позиция = СтрНайти(Тело, """gid"":""");
	Пока Позиция > 0 Цикл
		Хвост = Сред(Тело, Позиция + 7);
		Гид = Лев(Хвост, СтрНайти(Хвост, """") - 1);
		Если ЗначениеЗаполнено(Гид) И Результат.Адреса.Найти(Гид) = Неопределено Тогда
			Результат.Адреса.Добавить(Гид);
		КонецЕсли;
		Тело = Хвост;
		Позиция = СтрНайти(Тело, """gid"":""");
	КонецЦикла;
	Возврат Ответ.КодСостояния;

КонецФункции

// Лимит обращений к ЕГРЮЛ на один прогон и пауза между ними: ограничение у ФНС по адресу,
// частые запросы переводят его на капчу.
Функция НоваяСверкаЕГРЮЛ(Знач Лимит = 1) Экспорт

	Возврат Новый Структура("Осталось, Последний, Капча", Лимит, 0, Ложь);

КонецФункции

// Действующий КПП юрлица по ИНН из открытого поиска egrul.nalog.ru.
// Пустая строка - не узнали: лимит прогона исчерпан, сервис потребовал капчу, не ответил или ЮЛ прекращено.
Функция ДействующийКППИзЕГРЮЛ(Знач ИНН, СверкаЕГРЮЛ) Экспорт

	ИНН = СокрЛП(ИНН);
	Если СтрДлина(ИНН) <> 10 Тогда
		Возврат "";
	КонецЕсли;
	Строки = СтрокиЕГРЮЛ(ИНН, СверкаЕГРЮЛ);
	Если Строки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	// Прекращенные ЮЛ и прежние записи приходят с датой прекращения в поле "e".
	Для Каждого Запись Из Строки Цикл
		Если СокрЛП(Строка(Запись.Получить("i"))) = ИНН
			И Строка(Запись.Получить("k")) = "ul" И НЕ ЗначениеЗаполнено(Запись.Получить("e")) Тогда
			Возврат ОчиститьКПП(Строка(Запись.Получить("p")));
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// ФИО индивидуального предпринимателя по ИНН из того же поиска ФНС.
// Опрошено = Ложь - ответа нет (лимит, капча, сбой), и "не найден" отсюда выводить нельзя.
// Несколько записей на один ИНН - норма (повторная регистрация, смена фамилии), берется самая
// свежая по дате регистрации. Регистр ФИО в реестре разный: свежие записи заглавными.
// Возврат: Структура (Опрошено, Найден Булево, Фамилия, Имя, Отчество Строка).
Функция ФИОИПИзЕГРИП(Знач ИНН, СверкаЕГРЮЛ) Экспорт

	Результат = Новый Структура("Опрошено, Найден, Фамилия, Имя, Отчество", Ложь, Ложь, "", "", "");
	ИНН = СокрЛП(ИНН);
	Если СтрДлина(ИНН) <> 12 Тогда
		Возврат Результат;
	КонецЕсли;
	Строки = СтрокиЕГРЮЛ(ИНН, СверкаЕГРЮЛ);
	Если Строки = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Опрошено = Истина;

	Свежая = Неопределено;
	ДатаСвежей = Дата(1, 1, 1);
	Для Каждого Запись Из Строки Цикл
		Если СокрЛП(Строка(Запись.Получить("i"))) <> ИНН ИЛИ Строка(Запись.Получить("k")) <> "fl" Тогда
			Продолжить;
		КонецЕсли;
		ДатаЗаписи = ДатаИзДДММГГГГ(Строка(Запись.Получить("r")));
		Если Свежая = Неопределено ИЛИ ДатаЗаписи > ДатаСвежей Тогда
			Свежая = Запись;
			ДатаСвежей = ДатаЗаписи;
		КонецЕсли;
	КонецЦикла;
	Если Свежая = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Части = СтрРазделить(ФИОСЗаглавной(Строка(Свежая.Получить("n"))), " ", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Найден = Истина;
	Результат.Фамилия = Части[0];
	Результат.Имя = Части[1];
	Части.Удалить(1);
	Части.Удалить(0);
	Результат.Отчество = СтрСоединить(Части, " ");
	Возврат Результат;

КонецФункции

// "ИВАНОВ-ПЕТРОВ ИВАН" -> "Иванов-Петров Иван": каждая часть, и через дефис тоже.
Функция ФИОСЗаглавной(Знач Текст)

	Слова = Новый Массив;
	Для Каждого Слово Из СтрРазделить(СокрЛП(Текст), " " + Символы.Таб, Ложь) Цикл
		Части = Новый Массив;
		Для Каждого Часть Из СтрРазделить(Слово, "-") Цикл
			Части.Добавить(ВРег(Лев(Часть, 1)) + НРег(Сред(Часть, 2)));
		КонецЦикла;
		Слова.Добавить(СтрСоединить(Части, "-"));
	КонецЦикла;
	Возврат СтрСоединить(Слова, " ");

КонецФункции

// Записи поиска egrul.nalog.ru по ИНН: Массив соответствий (поля i, k, n, p, r, e).
// Неопределено - не спросили или не получили ответа: лимит прогона исчерпан, капча, сбой.
Функция СтрокиЕГРЮЛ(Знач ИНН, СверкаЕГРЮЛ)

	Если СверкаЕГРЮЛ.Капча ИЛИ СверкаЕГРЮЛ.Осталось <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	СверкаЕГРЮЛ.Осталось = СверкаЕГРЮЛ.Осталось - 1;

	ОбозревательДляЕГРЮЛ = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0 Safari/537.36";
	Попытка
		ПодождатьДо(СверкаЕГРЮЛ.Последний + 1500);
		СоединениеЕГРЮЛ = Новый HTTPСоединение("egrul.nalog.ru", 443, , , , 20, Новый ЗащищенноеСоединениеOpenSSL);

		ЗаголовкиПоиска = Новый Соответствие;
		ЗаголовкиПоиска.Вставить("User-Agent", ОбозревательДляЕГРЮЛ);
		ЗаголовкиПоиска.Вставить("X-Requested-With", "XMLHttpRequest");
		ЗаголовкиПоиска.Вставить("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");
		ЗапросПоиска = Новый HTTPЗапрос("/", ЗаголовкиПоиска);
		ЗапросПоиска.УстановитьТелоИзСтроки("vyp3CaptchaToken=&page=&query=" + ИНН + "&region=&PreventChromeAutocomplete=",
			"UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		Ответ = СоединениеЕГРЮЛ.ОтправитьДляОбработки(ЗапросПоиска);
		СверкаЕГРЮЛ.Последний = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Если Ответ.КодСостояния <> 200 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Поиск = ПрочитатьОтветЕГРЮЛ(Ответ);
		Если Поиск.Получить("captchaRequired") = Истина Тогда
			СверкаЕГРЮЛ.Капча = Истина;
			Возврат Неопределено;
		КонецЕсли;
		ТокенПоиска = Строка(Поиск.Получить("t"));
		Если НЕ ЗначениеЗаполнено(ТокенПоиска) Тогда
			Возврат Неопределено;
		КонецЕсли;

		ЗаголовкиРезультата = Новый Соответствие;
		ЗаголовкиРезультата.Вставить("User-Agent", ОбозревательДляЕГРЮЛ);
		ЗаголовкиРезультата.Вставить("X-Requested-With", "XMLHttpRequest");
		Для НомерПопытки = 1 По 3 Цикл
			Если НомерПопытки > 1 Тогда
				ПодождатьДо(ТекущаяУниверсальнаяДатаВМиллисекундах() + 1000);
			КонецЕсли;
			Ответ = СоединениеЕГРЮЛ.Получить(Новый HTTPЗапрос("/search-result/" + ТокенПоиска, ЗаголовкиРезультата));
			СверкаЕГРЮЛ.Последний = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Если Ответ.КодСостояния <> 200 Тогда
				Продолжить;
			КонецЕсли;
			Строки = ПрочитатьОтветЕГРЮЛ(Ответ).Получить("rows");
			Если ТипЗнч(Строки) <> Тип("Массив") Тогда
				Продолжить;
			КонецЕсли;
			Записи = Новый Массив;
			Для Каждого Запись Из Строки Цикл
				Если ТипЗнч(Запись) = Тип("Соответствие") Тогда
					Записи.Добавить(Запись);
				КонецЕсли;
			КонецЦикла;
			Возврат Записи;
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.ЕГРЮЛ", УровеньЖурналаРегистрации.Предупреждение, , ,
			"ИНН " + ИНН + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Неопределено;

КонецФункции

// ФИО покупателя-ИП для УПД и УКД. Без него маппинг уходит запасной веткой СвФЛУч без имени,
// и получатель отклоняет документ ("необходимо ввести наименование контрагента", 23.09.2026).
// ФИО заливались из ЕГРИП разово в июле 2026, новым контрагентам их не заполнял никто.
// Ненайденный в реестре (физлицо не ИП) помечается датой проверки и 30 дней не переспрашивается.
// Контекст - контекст прогона: общий лимит и пауза к ЕГРЮЛ на пакет (ключ СверкаЕГРЮЛ).
// Возврат: Строка - что сделано ("" - ничего не понадобилось или ответа нет).
Функция ОбеспечитьФИОИП(Знач Контрагент, Контекст = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат "";
	КонецЕсли;
	ИНН = СокрЛП(Строка(Контрагент.ИНН));
	Если СтрДлина(ИНН) <> 12 Тогда
		Возврат "";
	КонецЕсли;
	СвФам = СвойствоОбъектов("ЭДО_КонтрагентФамилия");
	СвИмя = СвойствоОбъектов("ЭДО_КонтрагентИмя");
	СвОтч = СвойствоОбъектов("ЭДО_КонтрагентОтчество");
	Если СвФам.Пустая() ИЛИ СвИмя.Пустая() ИЛИ СвОтч.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗначениеСвойстваОбъекта(Контрагент, СвФам))
		И ЗначениеЗаполнено(ЗначениеСвойстваОбъекта(Контрагент, СвИмя)) Тогда
		Возврат "";
	КонецЕсли;
	СвПроверка = СвойствоОбъектов("ЭДО_ЕГРИППроверен");
	Если НЕ СвПроверка.Пустая() Тогда
		Проверен = ДатаИзДДММГГГГ(Строка(ЗначениеСвойстваОбъекта(Контрагент, СвПроверка)));
		Если ЗначениеЗаполнено(Проверен) И ТекущаяДата() - Проверен < 30 * 86400 Тогда
			Возврат "";
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		Если НЕ Контекст.Свойство("СверкаЕГРЮЛ") Тогда
			Контекст.Вставить("СверкаЕГРЮЛ", НоваяСверкаЕГРЮЛ(20));
		КонецЕсли;
		Сверка = Контекст.СверкаЕГРЮЛ;
	Иначе
		Сверка = НоваяСверкаЕГРЮЛ(1);
	КонецЕсли;

	ФИО = ФИОИПИзЕГРИП(ИНН, Сверка);
	Если НЕ ФИО.Опрошено Тогда
		Возврат "";
	КонецЕсли;
	Если НЕ ФИО.Найден Тогда
		Если НЕ СвПроверка.Пустая() Тогда
			ЗаписатьЗначениеСвойства(Контрагент, СвПроверка, Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		Возврат "в ЕГРИП не найден";
	КонецЕсли;

	ЗаписатьЗначениеСвойства(Контрагент, СвФам, ФИО.Фамилия);
	ЗаписатьЗначениеСвойства(Контрагент, СвИмя, ФИО.Имя);
	ЗаписатьЗначениеСвойства(Контрагент, СвОтч, ФИО.Отчество);
	Итог = "ФИО из ЕГРИП: " + СокрЛП(ФИО.Фамилия + " " + ФИО.Имя + " " + ФИО.Отчество);
	ЗаписьЖурналаРегистрации("ЭДО.ЕГРИП", УровеньЖурналаРегистрации.Информация, , Контрагент, Итог);
	Возврат Итог;

КонецФункции

// Разовое дозаполнение ФИО покупателей-ИП с отгрузками за последние ДнейНазад дней.
// Возврат: Строка - итог прогона.
Функция ДозаполнитьФИОИП(Знач Лимит = 50, Знач ДнейНазад = 90) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Р.Контрагент КАК Контрагент
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Р
		|ГДЕ
		|	Р.Дата >= &Дата
		|	И Р.Проведен
		|	И ДЛИНАСТРОКИ(Р.Контрагент.ИНН) = 12");
	Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДата()) - ДнейНазад * 86400);
	Контекст = Новый Структура("СверкаЕГРЮЛ", НоваяСверкаЕГРЮЛ(Лимит));
	Заполнено = 0;
	НеНайдено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Итог = ОбеспечитьФИОИП(Выборка.Контрагент, Контекст);
		Если СтрНачинаетсяС(Итог, "ФИО") Тогда
			Заполнено = Заполнено + 1;
		ИначеЕсли ЗначениеЗаполнено(Итог) Тогда
			НеНайдено = НеНайдено + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат "ФИО заполнено: " + Заполнено + ", в ЕГРИП не найдено: " + НеНайдено
		+ ", запросов осталось: " + Контекст.СверкаЕГРЮЛ.Осталось
		+ ?(Контекст.СверкаЕГРЮЛ.Капча, ", ЕГРЮЛ потребовал капчу", "");

КонецФункции

Функция ПрочитатьОтветЕГРЮЛ(Ответ)

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Данные = Неопределено;
	КонецПопытки;
	Возврат ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные, Новый Соответствие);

КонецФункции

// Ожидание на сервере без внешних средств; годится для пауз в секунды.
Процедура ПодождатьДо(Знач МоментВМиллисекундах)

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < МоментВМиллисекундах Цикл
	КонецЦикла;

КонецПроцедуры

// Статусы связей по списку адресов. Обход пачками по РазмерПачкиСвязей (см. ниже).
// Возврат: Соответствие (адрес -> Структура(Статус, Обновлён, ЖдёмОт)).
Функция СтатусыСвязейЭДО(Соединение, Заголовки, Знач НашГид, Знач Адреса) Экспорт
	Возврат СтатусыСвязейПолно(Соединение, Заголовки, НашГид, Адреса).Связи;
КонецФункции

// То же, но честно сообщает о неполноте обхода.
// Раньше сбойная пачка молча пропускалась, и "данных нет" читалось как "связи нет" -
// регламент уводил контрагента с реально подтверждённого адреса. На 4 000+ адресов
// (85 запросов) токен Keycloak успевает протухнуть в середине обхода, так что это
// не редкий случай, а штатный.
// Возврат: Структура (Связи Соответствие, Неудач Число, Проверено Число).
// Сколько адресов спрашивать у оператора за один запрос contacts.
// Потолок ответа - 40 пар, и усечение МОЛЧАЛИВОЕ: HTTP 200, тело валидное, просто части
// запрошенных gids в нём нет. Замер 02.09.2026 на боевой moroz: запрос 45 и 50 адресов,
// у КАЖДОГО из которых связь заведомо есть (проверено пачками по 10), возвращает ровно 40.
// прежние пачки по 50 теряли до 10 связей на запрос, и потеря читалась как "связи нет":
// регламент писал контрагенту NO_CONTACT и не проставлял ему адрес, документы не уходили.
// Замер по всему реестру moroz (2 145 адресов): пачками по 50 - 1 686 связей, пачками по 25 -
// 1 756, то есть боевой обход терял 70 связей, из них 52 ESTABLISHED.
// 25 взято с запасом к потолку 40: оператор его не документирует и может снизить.
Функция РазмерПачкиСвязей()
	Возврат 25;
КонецФункции

Функция СтатусыСвязейПолно(Соединение, Заголовки, Знач НашГид, Знач Адреса) Экспорт

	// Диагностика обязательна: 07.09.2026 обход отменился трижды подряд с "не удалось
	// опросить 4 232 адресов из 4 232", и по журналу нельзя было сказать НИЧЕГО о причине -
	// ни кода ответа, ни тела. Разбор свёлся к гаданию, а через час механизм починился сам
	// (окно отказа 7 минут), и вопрос "что это было" остался без ответа навсегда.
	// при неудаче пачки код ответа и первое тело собираются здесь и печатаются вызывающим.
	Результат = Новый Структура("Связи, Неудач, Проверено, Коды, ПервыйОтказ",
		Новый Соответствие, 0, 0, Новый Соответствие, "");
	Пачка = Новый Массив;
	Запросов = 0;
	// Организацию определяет наш идентификатор: токен перевыпускается ее учетной записи.
	Организация = ОрганизацияПоИдентификаторуЭДО(НашГид);


	Для Индекс = 0 По Адреса.Количество() - 1 Цикл
		Пачка.Добавить(Адреса[Индекс]);
		Если Пачка.Количество() < РазмерПачкиСвязей() И Индекс < Адреса.Количество() - 1 Тогда
			Продолжить;
		КонецЕсли;

		Запросов = ПеревыпуститьТокенЭДО(Запросов, Заголовки, Организация);
		Путь = ПутьСервиса("roaming") + "/public/api/v3/subscribers/" + НашГид + "/contacts?gids=" + СтрСоединить(Пачка, ",");
		Удалось = Ложь;
		Для Попытка_ = 1 По 3 Цикл
			Попытка
				Ответ = Соединение.Получить(Новый HTTPЗапрос(Путь, Заголовки));
			Исключение
				ОтметитьКодОбхода(Результат, "исключение", ОписаниеОшибки());
				Продолжить;   // сеть моргнула — пробуем ещё раз
			КонецПопытки;
			Запросов = Запросов + 1;
			Если Ответ.КодСостояния = 200 Тогда
				РазобратьСвязи(Ответ.ПолучитьТелоКакСтроку("UTF-8"), НашГид, Результат.Связи);
				Удалось = Истина;
				Прервать;
			ИначеЕсли Ответ.КодСостояния = 401 Тогда
				ОтметитьКодОбхода(Результат, "401", "");
				ОбеспечитьТокен(Истина, Организация);
				Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));
			Иначе
				ОтметитьКодОбхода(Результат, Строка(Ответ.КодСостояния),
					Лев(Ответ.ПолучитьТелоКакСтроку("UTF-8"), 300));
			КонецЕсли;
		КонецЦикла;

		Если Удалось Тогда
			Результат.Проверено = Результат.Проверено + Пачка.Количество();
		Иначе
			Результат.Неудач = Результат.Неудач + Пачка.Количество();
		КонецЕсли;
		Пачка.Очистить();
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Копит статистику отказов обхода: сколько каких кодов и текст ПЕРВОГО тела.
// Первое тело, а не последнее: при массовом отказе интересна причина, с которой всё началось.
Процедура ОтметитьКодОбхода(Обход, Знач Ключ, Знач Тело)

	Обход.Коды.Вставить(Ключ, ?(Обход.Коды[Ключ] = Неопределено, 0, Обход.Коды[Ключ]) + 1);
	Если НЕ ЗначениеЗаполнено(Обход.ПервыйОтказ) Тогда
		Обход.ПервыйОтказ = Ключ + ?(ЗначениеЗаполнено(Тело), ": " + Тело, "");
	КонецЕсли;

КонецПроцедуры

// Читаемая сводка отказов обхода - для журнала регистрации.
Функция ОтказыОбходаСтрокой(Знач Обход) Экспорт

	Если Обход.Свойство("Коды") = Ложь ИЛИ Обход.Коды.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Части = Новый Массив;
	Для Каждого КЗ Из Обход.Коды Цикл
		Части.Добавить(КЗ.Ключ + " × " + КЗ.Значение);
	КонецЦикла;
	Возврат "; отказы: " + СтрСоединить(Части, ", ")
		+ ?(ЗначениеЗаполнено(Обход.ПервыйОтказ), "; первый — " + Обход.ПервыйОтказ, "");

КонецФункции

// Разбор ответа contacts.
// Оператор отдаёт state.lastUpdated - время смены статуса связи. В документации этого поля НЕТ
// (описаны только parties/status/fromParty), но именно оно позволяет выбрать адрес, который
// контрагент подтвердил ПЕРВЫМ, а не тот, который мы первым заметили.
Процедура РазобратьСвязи(Знач Тело, Знач НашГид, Связи)

	Позиция = СтрНайти(Тело, """parties"":[");
	Пока Позиция > 0 Цикл
		Хвост = Сред(Тело, Позиция + 11);
		КонецБлока = СтрНайти(Хвост, "}");
		Блок = ?(КонецБлока > 0, Лев(Хвост, КонецБлока), Хвост);

 // второй участник пары - не мы
		Адрес = "";
		ПозГид = СтрНайти(Блок, """");
		Остаток = Блок;
		Пока ПозГид > 0 Цикл
			Значение = Сред(Остаток, ПозГид + 1);
			КонецЗначения = СтрНайти(Значение, """");
			Если КонецЗначения = 0 Тогда
				Прервать;
			КонецЕсли;
			Кандидат = Лев(Значение, КонецЗначения - 1);
			Если ЗначениеЗаполнено(Кандидат) И Кандидат <> НашГид И СтрНайти(Кандидат, "-") + СтрДлина(Кандидат) > 5
				И НЕ Кандидат = "status" И НЕ Кандидат = "lastUpdated" И НЕ Кандидат = "fromParty" И НЕ Кандидат = "state" Тогда
				Адрес = Кандидат;
				Прервать;
			КонецЕсли;
			Остаток = Сред(Значение, КонецЗначения + 1);
			ПозГид = СтрНайти(Остаток, """");
		КонецЦикла;

		Статус = ЗначениеПоляJSON(Хвост, "status");
		ВремяСтр = ЗначениеПоляJSON(Хвост, "lastUpdated");
		ЖдёмОт = ЗначениеПоляJSON(Хвост, "fromParty");

		Если ЗначениеЗаполнено(Адрес) И ЗначениеЗаполнено(Статус) Тогда
 // Ключ - ВСЕГДА в верхнем регистре, читать только через СостояниеСвязи().
 // Платформа отдаёт адрес в ВЕРХНЕМ регистре, а в базе он лежит так, как его
 // когда-то записали: у СБИС и Тензора хвост шестнадцатеричный и обычно строчный
 // (2BE520dc6d70... против 2BE520DC6D70...). Соответствие в 1С регистрозависимо,
 // поэтому поиск по строке из базы давал Неопределено, это читалось как "связи нет",
 // и регламент писал контрагенту NO_CONTACT. Замер 27.08.2026 на боевой prodline:
 // из 189 адресов со статусом NO_CONTACT Платформа отвечала ESTABLISHED по 102,
 // а поиск по строке из базы находил 0 из 189. Документы этим клиентам не уходили.
			Связи.Вставить(ВРег(Адрес), Новый Структура("Статус, Обновлён, ЖдёмОт",
				Статус, ДатаИзISO(ВремяСтр), ЖдёмОт));
		КонецЕсли;

		Тело = Хвост;
		Позиция = СтрНайти(Тело, """parties"":[");
	КонецЦикла;

КонецПроцедуры

// Состояние связи по адресу. Неопределено, если связи нет.
// Единственный законный способ читать соответствие связей: ключи в нём нормализованы к ВРег,
// а адреса приходят из базы и из реестра ФНС в произвольном регистре.
Функция СостояниеСвязи(Знач Связи, Знач Адрес) Экспорт

	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Связи[ВРег(СокрЛП(Адрес))];

КонецФункции

// Значение строкового поля JSON, начиная от текущей позиции. "" если не найдено.
Функция ЗначениеПоляJSON(Знач Текст, Знач Имя)
	Ключ = """" + Имя + """:""";
	Позиция = СтрНайти(Текст, Ключ);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Текст, Позиция + СтрДлина(Ключ));
	Конец = СтрНайти(Хвост, """");
	Возврат ?(Конец > 0, Лев(Хвост, Конец - 1), "");
КонецФункции

// "2026-08-18T03:13:11.911282Z" -> Дата. Пустая дата, если разобрать не удалось.
Функция ДатаИзISO(Знач Строка)
	Если СтрДлина(Строка) < 19 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Возврат Дата(Число(Сред(Строка, 1, 4)), Число(Сред(Строка, 6, 2)), Число(Сред(Строка, 9, 2)),
			Число(Сред(Строка, 12, 2)), Число(Сред(Строка, 15, 2)), Число(Сред(Строка, 18, 2)));
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;
КонецФункции

// КПП из справочника встречается с мусором вида "/59020100" - оставляем только 9 цифр.
Функция ОчиститьКПП(Знач КПП)
	Только = "";
	Для Индекс = 1 По СтрДлина(КПП) Цикл
		Символ = Сред(КПП, Индекс, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Только = Только + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(СтрДлина(Только) = 9, Только, "");
КонецФункции

// Идентификатор своей организации у Платформы - из ее учетной записи ЭДО.
Функция ГидОрганизации(Знач Организация = Неопределено) Экспорт
	Запись = УчетнаяЗаписьЭДО(Организация);
	Возврат ?(Запись = Неопределено, "", Запись.ИдентификаторУчастника);
КонецФункции

Функция ЗаголовкиАвторизацииЭДО(Знач Организация = Неопределено)
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));
	Заголовки.Вставить("accept", "application/json;charset=UTF-8");
	Возврат Заголовки;
КонецФункции

// Токен Keycloak живёт 15 минут - в длинном прогоне перевыпускаем превентивно.
Функция ПеревыпуститьТокенЭДО(Знач Запросов, Заголовки, Знач Организация = Неопределено)
	Если Запросов > 0 И Запросов % 150 = 0 Тогда
		ОбеспечитьТокен(Истина, Организация);
		Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));
	КонецЕсли;
	Возврат Запросов;
КонецФункции

// Кэш адресов-кандидатов: ИНН -> Структура(Адреса Массив, Обновлён Дата, Первый Соответствие).
Функция ЗагрузитьРеестрАдресов() Экспорт
	// читать ОБЯЗАТЕЛЬНО с тем же пользователем, с каким писали: сохранение идёт под пустым
	// именем (чтобы кэш не зависел от учётки запуска), а Загрузить без параметра берёт ТЕКУЩЕГО
	// пользователя и молча возвращает Неопределено - кэш выглядит пустым, хотя данные есть.
	Значение = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", "РеестрАдресов", , "");
	Возврат ?(ТипЗнч(Значение) = Тип("Соответствие"), Значение, Новый Соответствие);
КонецФункции

Процедура СохранитьРеестрАдресов(Знач Реестр) Экспорт
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", "РеестрАдресов", Реестр,
		"кандидаты адресов ЭДО", "");
КонецПроцедуры

#КонецОбласти

#Область КарточкиУОператора

// Живые статусы карточки: экземпляр действует у контрагента и второй такой же будет дублем.
// Мёртвыми считаем только те, где документ у контрагента заведомо не действует.
// Аннулирование учитываем ПО ЗАПРОСУ ТОЖЕ (CANCELLATION_REQUESTED): пока контрагент его
// не подтвердил, экземпляр у него действует, и повторная отправка добавит второй.
Функция КарточкаЖивая(Знач Статус, Знач Состояние) Экспорт

	Мёртвые = "SENDING_FAILED,REJECTED,DELETED,CANCELLED,CANCELLATION_REQUESTED";
	Если ЗначениеЗаполнено(Состояние) И ВРег(СокрЛП(Состояние)) <> "ACTIVE" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти("," + Мёртвые + ",", "," + ВРег(СокрЛП(Статус)) + ",") = 0;

КонецФункции

// Карточки документа у оператора по паре "мы получатель" за период от даты документа.
//
// Единственный способ узнать, ушёл ли документ на самом деле: база знает только то, что
// записала сама, а переотправка начинается со снятия её отметки. Замер 06.09.2026: с 18.08
// контрагенты получили 113 точных дублей (75 из них - партия переотправок 20.08), при том
// что защита от гонки работала исправно - она про параллельные прогоны, а не про повтор.
//
// Спрашивать ОБЯЗАТЕЛЬНО парой sender_id + recipient_id: запрос по одному sender_id
// за сутки у оператора не укладывается и в 30 с, а пара отвечает за 90-260 мс
// (замер 08.09.2026).
// Даты - ISO с временем и "Z" (java.time.Instant); "2026-09-07" отвергается с 400.
// Номер в карточке (invoice.num) совпадает с номером базы (проверено на пяти документах).
// Номер уникален только внутри года - поэтому сверяем ПАРУ "номер + дата".
//
// Возврат: Структура (Опрошено Булево, Причина Строка, Карточки Массив
// из Структура(Ид, Статус, Состояние, Живая, Создана - дата UTC)).
Функция КарточкиДокументаУОператора(Соединение, Заголовки, Знач НашГид, Знач ГидПолучателя,
	Знач Номер, Знач ДатаДокумента) Экспорт

	Результат = Новый Структура("Опрошено, Причина, Карточки", Ложь, "", Новый Массив);
	// Организацию определяет наш идентификатор: токен перевыпускается ее учетной записи.
	Организация = ОрганизацияПоИдентификаторуЭДО(НашГид);

	Если НЕ ЗначениеЗаполнено(ГидПолучателя) ИЛИ НЕ ЗначениеЗаполнено(Номер) Тогда
		Результат.Причина = "не задан получатель или номер документа";
		Возврат Результат;
	КонецЕсли;

	// Оператор не принимает интервал длиннее 31 дня ("Time interval must be less than or
	// equals to 31 days", HTTP 400) - период от даты документа до сегодня обходим ОКНАМИ.
	// Поймано приёмкой 08.09.2026 на накладной от 01.04: одним запросом она не проверялась
	// вовсе, а отказ выглядел как недоступность оператора.
	// Даты - Instant в UTC. Запас в сутки в обе стороны: дата документа локальная, карточка
	// создаётся позже, и разница поясов не должна срезать край.
	Окно = 30 * 86400;
	НачалоПериода = НачалоДня(ДатаДокумента) - 86400;
	КонецПериода = ТекущаяУниверсальнаяДата() + 86400;
	// Ограничение сверху: у документа многолетней давности иначе вышли бы десятки запросов.
	// Год перекрывает любой разумный срок между документом и его отправкой.
	Если КонецПериода - НачалоПериода > 365 * 86400 Тогда
		НачалоПериода = КонецПериода - 365 * 86400;
	КонецЕсли;

	ИскомыйНомер = ВРег(СокрЛП(Номер));
	ИскомаяДата = НачалоДня(ДатаДокумента);
	Результат.Опрошено = Истина;

	Курсор = НачалоПериода;
	Пока Курсор < КонецПериода Цикл
		ГраницаОкна = Мин(Курсор + Окно, КонецПериода);
		Путь = ПутьСервиса("document") + "/public/api/v3/documents"
			+ "?created_from=" + Формат(Курсор, "ДФ=yyyy-MM-dd") + "T00:00:00Z"
			+ "&created_till=" + Формат(ГраницаОкна, "ДФ=yyyy-MM-dd") + "T23:59:59Z"
			+ "&sender_id=" + НашГид + "&recipient_id=" + СокрЛП(ГидПолучателя)
			+ "&page=0&page_size=100";

		Тело = "";
		ОкноВзято = Ложь;
		Для НомерПопытки = 1 По 3 Цикл
			Попытка
				Ответ = Соединение.Получить(Новый HTTPЗапрос(Путь, Заголовки));
			Исключение
 // Пауза обязательна: у оператора бывают эпизоды, когда метод не отвечает
 // больше 10 с, а следующий запрос проходит за 70 мс (замер 08.09.2026 -
 // /documents дал таймаут 12 с и тут же 72 мс). Три попытки вплотную попадают
 // в один и тот же эпизод и дают ложное "оператор недоступен".
				Результат.Причина = "нет ответа: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				ЖдатьПередПовтором(НомерПопытки);
				Продолжить;
			КонецПопытки;
			Если Ответ.КодСостояния = 200 Тогда
				Тело = Ответ.ПолучитьТелоКакСтроку("UTF-8");
				ОкноВзято = Истина;
				Прервать;
			ИначеЕсли Ответ.КодСостояния = 401 Тогда
				ОбеспечитьТокен(Истина, Организация);
				Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));
			Иначе
				Результат.Причина = "HTTP " + Ответ.КодСостояния + " "
					+ Лев(Ответ.ПолучитьТелоКакСтроку("UTF-8"), 200);
 // 4xx (кроме 401) - отказ по существу запроса, а не сбой связи: повтор
 // вернёт ровно то же и только съест время.
				Если Ответ.КодСостояния >= 400 И Ответ.КодСостояния < 500
					И Ответ.КодСостояния <> 429 Тогда
					Прервать;
				КонецЕсли;
				ЖдатьПередПовтором(НомерПопытки);
			КонецЕсли;
		КонецЦикла;

		Если НЕ ОкноВзято Тогда
			Результат.Опрошено = Ложь;
			Возврат Результат;
		КонецЕсли;

		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Тело);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Если ТипЗнч(Данные) = Тип("Массив") Тогда
			НакопитьКарточки(Данные, ИскомыйНомер, ИскомаяДата, Результат.Карточки);
		КонецЕсли;

		Курсор = ГраницаОкна + 86400;
	КонецЦикла;

	Результат.Причина = "";
	Возврат Результат;

КонецФункции

// Отобрать из ответа карточки нужного документа и сложить в накопитель.
Процедура НакопитьКарточки(Знач Данные, Знач ИскомыйНомер, Знач ИскомаяДата, Карточки)

	Для Каждого Карточка Из Данные Цикл
		Счёт = Карточка["invoice"];
		Если ТипЗнч(Счёт) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Если ВРег(СокрЛП(Строка(Счёт["num"]))) <> ИскомыйНомер Тогда
			Продолжить;
		КонецЕсли;
 // Дата в карточке сверяется С ДОПУСКОМ В СУТКИ, а не точным равенством.
 // Замер 08.09.2026: у ТБ-00064190 от 01.09 в карточке стоит date=31.08 - XML
 // собирается по UTC, и документ, оформленный ночью, уезжает на сутки назад.
 // Точное сравнение давало "карточки нет" у заведомо доставленного документа,
 // то есть защита от дубля молча не работала бы ровно там, где нужна.
 // Номер сверяем точно: внутри окна поиска (не больше года) он однозначен.
		ДатаКарточки = ДатаИзДДММГГГГ(Строка(Счёт["date"]));
		Если ЗначениеЗаполнено(ДатаКарточки)
			И Макс(ДатаКарточки, ИскомаяДата) - Мин(ДатаКарточки, ИскомаяДата) > 86400 Тогда
			Продолжить;
		КонецЕсли;
		Состояние = "";
		Если ТипЗнч(Карточка["documentState"]) = Тип("Соответствие") Тогда
			Состояние = Строка(Карточка["documentState"]["state"]);
		КонецЕсли;
		Статус = Строка(?(Карточка["newStatus"] = Неопределено, Карточка["status"], Карточка["newStatus"]));
 // Ид приходит ЧИСЛОМ: Строка() форматирует его с разделителями разрядов
 // ("170 579 850") - в базу такой ид писать нельзя, дальше по нему не найти карточку.
		Карточки.Добавить(Новый Структура("Ид, Статус, Состояние, Живая, Создана",
			Формат(Карточка["id"], "ЧГ=0"), Статус, Состояние, КарточкаЖивая(Статус, Состояние),
			ДатаИзМеткиВремени(Строка(Карточка["created"]))));
	КонецЦикла;

КонецПроцедуры

// Дата UTC из строки вида "2026-09-15T13:00:39.063804Z". Пустая дата, если разобрать не удалось.
Функция ДатаИзМеткиВремени(Знач Текст)

	Цифры = СтрЗаменить(СтрЗаменить(СтрЗаменить(Лев(СокрЛП(Текст), 19), "-", ""), ":", ""), "T", "");
	Попытка
		Возврат Дата(Цифры);
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

// Дата из строки вида "01.04.2026". Пустая дата, если разобрать не удалось.
Функция ДатаИзДДММГГГГ(Знач Текст)

	Части = СтрРазделить(СокрЛП(Текст), ".", Ложь);
	Если Части.Количество() <> 3 Тогда
		Возврат '00010101';
	КонецЕсли;
	Попытка
		Возврат Дата(Число(Части[2]), Число(Части[1]), Число(Части[0]));
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

// Есть ли у оператора живой экземпляр ЭТОГО документа с ТЕМ ЖЕ получателем.
// Обёртка над КарточкиДокументаУОператора: сама поднимает соединение, токен и адрес получателя.
//
// "Не опрошено" != "дубля нет". При недоступности оператора возвращаем Опрошено = Ложь,
// и вызывающий обязан решать сам; молча считать это разрешением на отправку нельзя -
// ровно так рождались дубли (неудача читалась как "ничего нет").
// Прочие известные адреса контрагента проверяются тоже - см. ЭкземплярНаПрежнемАдресе.
// Возврат: Структура (Опрошено, Причина, Найден Булево, Ид, Статус, Адрес,
// НаПрежнемАдресе - Структура(Ид, Статус, Адрес) или Неопределено).
Функция ЖивойЭкземплярУОператора(Ссылка) Экспорт

	Результат = Новый Структура("Опрошено, Причина, Найден, Ид, Статус, Адрес, НаПрежнемАдресе",
		Ложь, "", Ложь, "", "", "", Неопределено);

	ГидПолучателя = ИдентификаторУчастникаЭДО(Ссылка.Контрагент);
	Если НЕ ЗначениеЗаполнено(ГидПолучателя) Тогда
		Результат.Причина = "у контрагента нет идентификатора ЭДО";
		Возврат Результат;
	КонецЕсли;

	Организация = ОрганизацияДокумента(Ссылка);
	Если НЕ ОбеспечитьТокен(Ложь, Организация) Тогда
		Результат.Причина = "не удалось получить токен";
		Возврат Результат;
	КонецЕсли;
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));

	// Таймаут КОРОТКИЙ и это принципиально. Замер 08.09.2026: удачный ответ приходит
	// за 95-205 мс, а неудачный не приходит вовсе - при таймауте 15 с запрос висит все 15 с
	// и обрывается. - ждать долго бессмысленно, лечит только повтор (следующая попытка
	// после зависшей отвечала за 72 мс). Штатные 30 с здесь дали бы до полутора минут
	// на документ и повесили бы массовую отправку.
	Соединение = СоединениеСОператором(5);
	НашГид = ГидОрганизации(Организация);
	Опрос = КарточкиДокументаУОператора(Соединение, Заголовки, НашГид,
		ГидПолучателя, СокрЛП(Ссылка.Номер), Ссылка.Дата);
	Результат.Опрошено = Опрос.Опрошено;
	Результат.Причина = Опрос.Причина;
	Результат.Адрес = ВРег(СокрЛП(ГидПолучателя));

	// Неподписанный черновик NEW контрагенту не уходил: дублем он не бывает, а его идентификатор
	// в базе выдал бы документ за отправленный. Свежий черновик может быть отправкой, которая
	// еще идет, поэтому с ним решение откладывается до следующего прогона.
	СвежийЧерновик = "";
	Для Каждого Карточка Из Опрос.Карточки Цикл
		Если НЕ Карточка.Живая Тогда
			Продолжить;
		КонецЕсли;
		Если ВРег(СокрЛП(Карточка.Статус)) = "NEW" Тогда
			Если ЗначениеЗаполнено(Карточка.Создана)
				И ТекущаяУниверсальнаяДата() - Карточка.Создана < ВозрастБрошенногоЧерновика() Тогда
				СвежийЧерновик = Карточка.Ид;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Результат.Найден = Истина;
		Результат.Ид = Карточка.Ид;
		Результат.Статус = Карточка.Статус;
		Прервать;
	КонецЦикла;

	Если НЕ Результат.Найден И ЗначениеЗаполнено(СвежийЧерновик) Тогда
		Результат.Опрошено = Ложь;
		Результат.Причина = "у оператора неподписанный черновик " + СвежийЧерновик + " моложе часа";
	КонецЕсли;

	Если Результат.Опрошено И НЕ Результат.Найден Тогда
		Прежний = ЭкземплярНаПрежнемАдресе(Ссылка, Соединение, Заголовки, НашГид, Результат.Адрес);
		Если Прежний <> Неопределено И ВРег(Прежний.Статус) = "ACCEPTED" Тогда
			Результат.Найден = Истина;
			Результат.Ид = Прежний.Ид;
			Результат.Статус = Прежний.Статус;
			Результат.Адрес = Прежний.Адрес;
		КонецЕсли;
		Результат.НаПрежнемАдресе = Прежний;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Живой экземпляр документа на ДРУГОМ адресе контрагента: из реестра ФНС или фактического маршрута.
// Подписанный (ACCEPTED) экземпляр важнее неподписанного: он у контрагента действует,
// и повтор на новый адрес дал бы дубль. Неподписанный на брошенном ящике дублем не считается -
// переотправка на новый адрес как раз и чинит "ушло не в тот ящик".
// Сбой опроса прежнего адреса отправку не держит: текущий адрес уже проверен.
// Возврат: Структура(Ид, Статус, Адрес) или Неопределено.
Функция ЭкземплярНаПрежнемАдресе(Ссылка, Соединение, Заголовки, Знач НашГид, Знач ТекущийАдрес)

	Найденный = Неопределено;
	Для Каждого Адрес Из ПрочиеАдресаКонтрагента(Ссылка.Контрагент, ТекущийАдрес) Цикл
		Опрос = КарточкиДокументаУОператора(Соединение, Заголовки, НашГид, Адрес,
			СокрЛП(Ссылка.Номер), Ссылка.Дата);
		Если НЕ Опрос.Опрошено Тогда
			ЗаписьЖР("ЭДО.ПроверкаДубля", "Предупреждение", Ссылка.Метаданные(), Ссылка,
				"Не удалось проверить экземпляр на прежнем адресе " + Адрес + ": " + Опрос.Причина);
			Продолжить;
		КонецЕсли;
		Для Каждого Карточка Из Опрос.Карточки Цикл
			Статус = ВРег(СокрЛП(Карточка.Статус));
			Если НЕ Карточка.Живая ИЛИ Статус = "NEW" Тогда
				Продолжить;
			КонецЕсли;
			Если Найденный = Неопределено ИЛИ Статус = "ACCEPTED" Тогда
				Найденный = Новый Структура("Ид, Статус, Адрес", Карточка.Ид, Статус, Адрес);
			КонецЕсли;
			Если Статус = "ACCEPTED" Тогда
				Возврат Найденный;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Найденный;

КонецФункции

// Адреса контрагента, кроме текущего и наших собственных, в верхнем регистре без повторов.
Функция ПрочиеАдресаКонтрагента(Знач Контрагент, Знач ТекущийАдрес)

	Адреса = Новый Массив;
	ИНН = СокрЛП(Строка(Контрагент.ИНН));
	Если НЕ ЗначениеЗаполнено(ИНН) Тогда
		Возврат Адреса;
	КонецЕсли;

	Кандидаты = Новый Массив;
	Реестр = ЗагрузитьРеестрАдресов();
	ЗаписьРеестра = Реестр[ИНН];
	Если ТипЗнч(ЗаписьРеестра) = Тип("Структура") И ЗаписьРеестра.Свойство("Адреса") Тогда
		Для Каждого Адрес Из ЗаписьРеестра.Адреса Цикл
			Кандидаты.Добавить(Адрес);
		КонецЦикла;
	КонецЕсли;
	Кандидаты.Добавить(ФактическийМаршрут(ИНН));

	Для Каждого Кандидат Из Кандидаты Цикл
		Адрес = ВРег(СокрЛП(Кандидат));
		Если НЕ ЗначениеЗаполнено(Адрес) ИЛИ Адрес = ВРег(СокрЛП(ТекущийАдрес))
			ИЛИ Адреса.Найти(Адрес) <> Неопределено ИЛИ АдресЭДОНаш(Адрес) Тогда
			Продолжить;
		КонецЕсли;
		Адреса.Добавить(Адрес);
	КонецЦикла;

	Возврат Адреса;

КонецФункции

// Сколько секунд черновик NEW может быть отправкой в работе. Дольше - брошен.
Функция ВозрастБрошенногоЧерновика()
	Возврат 3600;
КонецФункции

// Пауза перед повторной попыткой: 2 с после первой, 5 с после второй.
// Активным циклом: штатного ПриостановитьВыполнение в этой платформе нет (проверено 08.09).
// Путь редкий - только при отказе оператора, - поэтому цена приемлема.
Процедура ЖдатьПередПовтором(Знач НомерПопытки)

	Если НомерПопытки >= 3 Тогда
		Возврат;
	КонецЕсли;
	Ждать = ?(НомерПопытки = 1, 2, 5);
	Конец = ТекущаяУниверсальнаяДатаВМиллисекундах() + Ждать * 1000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Конец Цикл
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПриглашенияЭДО

// Рассылка приглашений по списку адресов - единственный законный путь звать контрагентов.
//
// Почему это в ядре, а не в скрипте прогона. Разовый скрипт рассылки 05.09.2026 порвал
// 11 живых связей: он спрашивал contacts сам и делал это тремя неверными способами разом -
// (1) неудачу запроса связей читал как "связей нет" (тело пустое - зовём всех),
// (2) искал связь подстрокой в сыром теле, а Платформа отдаёт адрес в ВЕРХНЕМ регистре,
// (3) считал приглашение успешным по коду 204, хотя отказ приходит асинхронно.
// Каждый из трёх даёт один и тот же итог: приглашение уходит туда, где связь ЕСТЬ, а у
// оператора КОРУС (2BK) это переводит связь в BROKEN - необратимо, повтор не чинит.
// проверка обязана жить там же, где живёт опрос связей, и обходиться не должна.
//
// Прогон отменяется целиком, если опрошены не все адреса - тот же принцип, что у
// регламента связей: рассылка по неполным данным опаснее несостоявшейся рассылки.
//
// Параметры:
// Адреса - Массив строк (gid контрагентов), кого предполагается позвать.
// ТолькоПроверка - Булево: не слать ничего, вернуть список тех, кого позвали бы.
// Возврат: Структура (Отменено, Причина, Приглашено, Пропущено, Ошибок, Цели Массив, Отказы Массив).
Функция ПригласитьПоАдресам(Соединение, Заголовки, Знач НашГид, Знач Адреса,
	Знач ТолькоПроверка = Ложь) Экспорт

	Свод = Новый Структура("Отменено, Причина, Приглашено, Пропущено, Ошибок, Цели, Отказы",
		Ложь, "", 0, 0, 0, Новый Массив, Новый Массив);

	Если Адреса.Количество() = 0 Тогда
		Возврат Свод;
	КонецЕсли;

	Обход = СтатусыСвязейПолно(Соединение, Заголовки, НашГид, Адреса);
	Если Обход.Неудач > 0 Тогда
		Свод.Отменено = Истина;
		Свод.Причина = "не удалось опросить связи по " + Обход.Неудач + " адресам из "
			+ Адреса.Количество() + ", не приглашён никто" + ОтказыОбходаСтрокой(Обход);
		Возврат Свод;
	КонецЕсли;

	Для Каждого Адрес Из Адреса Цикл
		Если НЕ ЗначениеЗаполнено(Адрес) Тогда
			Продолжить;
		КонецЕсли;

 // Звать можно только туда, где связи нет вовсе или она снята оператором (NO_CONTACT).
 // Всё остальное - ESTABLISHED, DIRECT, AWAIT_APPROVAL, BROKEN - оставляем в покое:
 // у живой связи повтор её рвёт, у ждущей не двигает статус, у порванной только
 // переставляет метку разрыва (проверено 06.09.2026 управляемой пробой).
		Состояние = СостояниеСвязи(Обход.Связи, Адрес);
		Если Состояние <> Неопределено И ВРег(СокрЛП(Состояние.Статус)) <> "NO_CONTACT" Тогда
			Свод.Пропущено = Свод.Пропущено + 1;
			Продолжить;
		КонецЕсли;

		Свод.Цели.Добавить(Адрес);
		Если ТолькоПроверка Тогда
			Продолжить;
		КонецЕсли;

		Запрос = Новый HTTPЗапрос(ПутьСервиса("subscriber") + "/public/api/v3/subscribers/" + НашГид
			+ "/invitations/" + Адрес + "?type=REQUEST", Заголовки);
		Запрос.УстановитьТелоИзСтроки("{}");
		Попытка
			Ответ = Соединение.ВызватьHTTPМетод("PUT", Запрос);
		Исключение
			Свод.Ошибок = Свод.Ошибок + 1;
			Свод.Отказы.Добавить(Адрес + ": исключение " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		Если Ответ.КодСостояния = 204 ИЛИ Ответ.КодСостояния = 200 Тогда
			Свод.Приглашено = Свод.Приглашено + 1;
		Иначе
			Свод.Ошибок = Свод.Ошибок + 1;
			Свод.Отказы.Добавить(Адрес + ": HTTP " + Ответ.КодСостояния + " "
				+ Лев(Ответ.ПолучитьТелоКакСтроку("UTF-8"), 200));
		КонецЕсли;
	КонецЦикла;

	Возврат Свод;

КонецФункции

// Приглашения новым контрагентам: тем, кому есть что отправлять, а адреса ЭДО нет
// и документы им раньше не уходили. Зовем на все адреса из реестра ФНС, кроме каналов
// вне автовыбора; рабочим станет тот, где примут первым, - его запишет регламент связей.
// Адрес, куда приглашение уже уходило, повторно не зовется.
//
// Параметры:
// ТолькоПроверка - Булево: не слать ничего, показать, кого позвали бы.
// МаксКонтрагентов - Число: сколько контрагентов звать за прогон, 0 - без ограничения.
// Возврат: Строка - свод прогона.
Функция ПригласитьНовыхКонтрагентов(Знач ТолькоПроверка = Ложь, Знач МаксКонтрагентов = 50) Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Лог = Новый Массив;
	Счет = Новый Структура("Кандидатов, СИсторией, Свои, БезАдресов, ЗвалиРанее, Контрагентов",
		0, 0, 0, 0, 0, 0);
	Заголовок = "ЭДО, приглашения новым контрагентам" + ?(ТолькоПроверка, " (проверка)", "");

	СвойствоАдреса = СвойствоОбъектов("ЭДО_АдресКонтрагента");
	Если СвойствоАдреса = Неопределено ИЛИ СвойствоАдреса.Пустая() Тогда
		Возврат Заголовок + ": ОШИБКА - не найдено свойство ЭДО_АдресКонтрагента";
	КонецЕсли;
	СвойствоСостояния = СвойствоОбъектов("ЭДО_Состояние");
	Если СвойствоСостояния = Неопределено Тогда
		СвойствоСостояния = ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка();
	КонецЕсли;

	Организации = ОрганизацииСРазрешеннойОтправкой();
	Если Организации.Количество() = 0 Тогда
		Возврат Заголовок + ": нет организаций с разрешенной отправкой";
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	РТУ.Контрагент КАК Контрагент,
		|	РТУ.Контрагент.ИНН КАК ИНН,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РТУ.Ссылка) КАК Документов
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РТУ
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Адрес
		|		ПО ВЫРАЗИТЬ(Адрес.Объект КАК Справочник.Контрагенты) = РТУ.Контрагент
		|			И Адрес.Свойство = &СвойствоАдреса
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК НеТребуется
		|		ПО ВЫРАЗИТЬ(НеТребуется.Объект КАК Документ.РеализацияТоваровУслуг) = РТУ.Ссылка
		|			И НеТребуется.Свойство = &СвойствоСостояния
		|			И ВЫРАЗИТЬ(НеТребуется.Значение КАК СТРОКА(50)) = &ТекстНеТребуется
		|ГДЕ
		|	РТУ.Проведен
		|	И РТУ.ОтражатьВБухгалтерскомУчете
		|	И РТУ.Дата >= &Дата
		|	И РТУ.Организация В (&Организации)
		|	И НЕ РТУ.Контрагент.ПометкаУдаления
		|	И НЕ ПОДСТРОКА(РТУ.Контрагент.ИНН, 1, 1) = """"
		|	И (Адрес.Значение ЕСТЬ NULL
		|		ИЛИ ВЫРАЗИТЬ(Адрес.Значение КАК СТРОКА(50)) = """")
		|	И НеТребуется.Объект ЕСТЬ NULL
		|СГРУППИРОВАТЬ ПО
		|	РТУ.Контрагент,
		|	РТУ.Контрагент.ИНН
		|УПОРЯДОЧИТЬ ПО
		|	Документов УБЫВ");
	Запрос.УстановитьПараметр("СвойствоАдреса", СвойствоАдреса);
	Запрос.УстановитьПараметр("СвойствоСостояния", СвойствоСостояния);
	Запрос.УстановитьПараметр("ТекстНеТребуется", "Отправка не требуется");
	Запрос.УстановитьПараметр("Дата", НижняяГраницаОтбора());
	Запрос.УстановитьПараметр("Организации", Организации);
	Кандидаты = Запрос.Выполнить().Выгрузить();
	Счет.Кандидатов = Кандидаты.Количество();

	СвоиИНН = Новый Соответствие;
	Для Каждого Запись Из УчетныеЗаписиЭДО() Цикл
		СвоиИНН.Вставить(СокрЛП(Запись.Организация.ИНН), Истина);
	КонецЦикла;
	Реестр = ЗагрузитьРеестрАдресов();
	Маршруты = ЗагрузитьФактическиеМаршруты();

	// Адрес -> контрагент, чтобы в своде было видно, кого позвали.
	КонтрагентАдреса = Новый Соответствие;
	Адреса = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		ИНН = СокрЛП(Кандидат.ИНН);
		Если СвоиИНН[ИНН] <> Неопределено Тогда
			Счет.Свои = Счет.Свои + 1;
			Продолжить;
		КонецЕсли;
		Если Маршруты[ИНН] <> Неопределено Тогда
			Счет.СИсторией = Счет.СИсторией + 1;
			Продолжить;
		КонецЕсли;

		ЗаписьРеестра = Реестр[ИНН];
		АдресовКонтрагента = 0;
		Если ЗаписьРеестра <> Неопределено Тогда
			Для Каждого АдресРеестра Из ЗаписьРеестра.Адреса Цикл
				АдресСтрокой = СокрЛП(АдресРеестра);
				Если АдресЭДОВнеАвтовыбора(АдресСтрокой) ИЛИ АдресЭДОНаш(АдресСтрокой)
					ИЛИ КонтрагентАдреса[ВРег(АдресСтрокой)] <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				КонтрагентАдреса.Вставить(ВРег(АдресСтрокой), Кандидат.Контрагент);
				Адреса.Добавить(АдресСтрокой);
				АдресовКонтрагента = АдресовКонтрагента + 1;
			КонецЦикла;
		КонецЕсли;
		Если АдресовКонтрагента = 0 Тогда
			Счет.БезАдресов = Счет.БезАдресов + 1;
		КонецЕсли;
	КонецЦикла;

	Если Адреса.Количество() = 0 Тогда
		Возврат СводПриглашенийНовым(Заголовок, Счет, Новый Структура("Приглашено, Ошибок", 0, 0), Начало, Лог);
	КонецЕсли;

	// Связь, адрес и пауза хранятся у контрагента, поэтому зовем от первой учетной записи,
	// как и регламент связей.
	ОрганизацияСвязей = Неопределено;
	Если НесколькоУчетныхЗаписейЭДО() Тогда
		ОрганизацияСвязей = УчетныеЗаписиЭДО()[0].Организация;
	КонецЕсли;
	НашГид = ГидОрганизации(ОрганизацияСвязей);
	Если НЕ ЗначениеЗаполнено(НашГид) Тогда
		Возврат Заголовок + ": ОШИБКА - не определен идентификатор своей организации";
	КонецЕсли;
	Если НЕ ОбеспечитьТокен(Истина, ОрганизацияСвязей) Тогда
		Возврат Заголовок + ": ОШИБКА - не удалось получить токен авторизации";
	КонецЕсли;
	Соединение = HTTPСоединениеЭДО();
	Заголовки = ЗаголовкиАвторизацииЭДО(ОрганизацияСвязей);

	// Звали ли раньше. Без ответа оператора адрес пропускаем: лишнее приглашение
	// хуже пропущенного часа.
	Истории = СтатусыПриглашений(Соединение, Заголовки, НашГид, Адреса);
	Новые = Новый Массив;
	Приглашаемые = Новый Соответствие;
	Для Каждого АдресСтрокой Из Адреса Цикл
		История = Истории[ВРег(АдресСтрокой)];
		Если История = Неопределено ИЛИ ЗначениеЗаполнено(История.Ошибка)
			ИЛИ ЗначениеЗаполнено(История.Статус) Тогда
			Счет.ЗвалиРанее = Счет.ЗвалиРанее + 1;
			Продолжить;
		КонецЕсли;
		Контрагент = КонтрагентАдреса[ВРег(АдресСтрокой)];
		Если Приглашаемые[Контрагент] = Неопределено Тогда
			Если МаксКонтрагентов > 0 И Приглашаемые.Количество() >= МаксКонтрагентов Тогда
				Продолжить;
			КонецЕсли;
			Приглашаемые.Вставить(Контрагент, Истина);
		КонецЕсли;
		Новые.Добавить(АдресСтрокой);
	КонецЦикла;
	Счет.Контрагентов = Приглашаемые.Количество();

	Свод = ПригласитьПоАдресам(Соединение, Заголовки, НашГид, Новые, ТолькоПроверка);
	Если Свод.Отменено Тогда
		Возврат Заголовок + ": ПРОГОН ОТМЕНЕН - " + Свод.Причина;
	КонецЕсли;

	Для Каждого АдресСтрокой Из Свод.Цели Цикл
		Лог.Добавить("  " + СокрЛП(Строка(КонтрагентАдреса[ВРег(АдресСтрокой)])) + " -> "
			+ АдресСтрокой);
	КонецЦикла;
	Для Каждого Отказ Из Свод.Отказы Цикл
		Лог.Добавить("  ОТКАЗ " + Отказ);
	КонецЦикла;

	Возврат СводПриглашенийНовым(Заголовок, Счет, Свод, Начало, Лог);

КонецФункции

Функция СводПриглашенийНовым(Знач Заголовок, Знач Счет, Знач Свод, Знач Начало, Знач Лог)

	Секунд = Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000, 1);
	Итог = Заголовок + ": контрагентов без адреса " + Счет.Кандидатов
		+ ", с историей отправок " + Счет.СИсторией
		+ ", свои " + Счет.Свои
		+ ", нет адресов в реестре " + Счет.БезАдресов
		+ ", адресов звали ранее " + Счет.ЗвалиРанее
		+ ", зовем контрагентов " + Счет.Контрагентов
		+ ", приглашений " + Свод.Приглашено
		+ ", ошибок " + Свод.Ошибок
		+ "; " + Секунд + " c";
	Лог.Вставить(0, Итог);
	Возврат СтрСоединить(Лог, Символы.ПС);

КонецФункции

// Статусы приглашений по списку адресов - контроль ПОСЛЕ рассылки.
//
// Код ответа на само приглашение ничего не доказывает: PUT отдаёт 204 сразу, приглашение
// уходит в SENDING, а отказ (например "ER20146: контрагенту было отправлено приглашение
// ранее") приходит асинхронно примерно через минуту. - узнать судьбу приглашения можно
// только отдельным опросом, и делать его надо не раньше чем через минуту после рассылки.
// Возврат: Соответствие (адрес в ВРег -> Структура(Статус, Ошибка)).
Функция СтатусыПриглашений(Соединение, Заголовки, Знач НашГид, Знач Адреса) Экспорт

	Результат = Новый Соответствие;
	Запросов = 0;
	// Организацию определяет наш идентификатор: токен перевыпускается ее учетной записи.
	Организация = ОрганизацияПоИдентификаторуЭДО(НашГид);

	Для Каждого Адрес Из Адреса Цикл
		Если НЕ ЗначениеЗаполнено(Адрес) Тогда
			Продолжить;
		КонецЕсли;
		Запросов = ПеревыпуститьТокенЭДО(Запросов, Заголовки, Организация);
		Путь = ПутьСервиса("subscriber") + "/public/api/v3/subscribers/" + НашГид + "/invitations/" + Адрес;
		Попытка
			Ответ = Соединение.Получить(Новый HTTPЗапрос(Путь, Заголовки));
		Исключение
			Результат.Вставить(ВРег(СокрЛП(Адрес)),
				Новый Структура("Статус, Ошибка", "", ОписаниеОшибки()));
			Продолжить;
		КонецПопытки;
		Запросов = Запросов + 1;
		Если Ответ.КодСостояния <> 200 Тогда
			Результат.Вставить(ВРег(СокрЛП(Адрес)),
				Новый Структура("Статус, Ошибка", "", "HTTP " + Ответ.КодСостояния));
			Продолжить;
		КонецЕсли;
 // Оператор отдаёт МАССИВ приглашений (вся история по этому адресу), свежее - первым,
 // а текст отказа лежит в error.originalMessage; поля code и message у него null.
 // Проверено 08.09.2026 на живом FAILED. - разбор первого вхождения и есть разбор
 // последнего приглашения, отдельная сортировка не нужна.
		Тело = Ответ.ПолучитьТелоКакСтроку("UTF-8");
		Результат.Вставить(ВРег(СокрЛП(Адрес)), Новый Структура("Статус, Ошибка",
			ЗначениеПоляJSON(Тело, "status"), ЗначениеПоляJSON(Тело, "originalMessage")));
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ЗащитаОтПовторнойОтправки

// Признак того, что оператор не знает адреса получателя: контрагент ушёл от своего
// оператора, и записанный у нас gid больше не существует.
// Судим по паре "404 + Subscriber ... not found": просто 404 бывает и по другим поводам.
Функция ОтветГоворитЧтоАдресаНет(Знач Сообщение) Экспорт
	Текст = ВРег(Строка(Сообщение));
	Возврат СтрНайти(Текст, "404") > 0
		И СтрНайти(Текст, "SUBSCRIBER") > 0
		И СтрНайти(Текст, "NOT FOUND") > 0;
КонецФункции

// Снять у контрагента адрес ЭДО, который перестал существовать у оператора.
//
// Снимается и ЗАКРЕПЛЕНИЕ адреса, если оно стояло: закреплённую карточку регламент связей
// намеренно не трогает, и без этого шага контрагент остался бы с мёртвым адресом навсегда.
// Новый адрес подбирает регламент связей - он спрашивает реестр ФНС по ИНН, то есть видит
// переезд контрагента, чего опрос по записанному адресу не умеет.
// Возврат: Строка - что сделано, для сообщения в результате отправки.
Функция СнятьПротухшийАдресКонтрагента(Контрагент) Экспорт

	СвИд = СвойствоОбъектов("ЭДО_АдресКонтрагента");
	Если СвИд = Неопределено ИЛИ СвИд.Пустая() Тогда
		Возврат "Адрес получателя не найден у оператора, но снять его нечем:"
			+ " свойство ЭДО_АдресКонтрагента не заведено";
	КонецЕсли;

	Прежний = Строка(ЗначениеСвойстваОбъекта(Контрагент, СвИд));
	БылоЗакрепление = АдресЭДОЗакреплён(Контрагент);

	Если БылоЗакрепление Тогда
		СнятьЗакреплениеАдресаЭДО(Контрагент);
	КонецЕсли;

	НаборИд = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	НаборИд.Отбор.Объект.Установить(Контрагент);
	НаборИд.Отбор.Свойство.Установить(СвИд);
	НаборИд.Записать(Истина);

	СвСвязь = СвойствоОбъектов("ЭДО_СтатусСвязи");
	Если СвСвязь <> Неопределено И НЕ СвСвязь.Пустая() Тогда
 // статус относился к снятому адресу и без него означал бы здоровье несуществующей связи
		НаборСвязь = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
		НаборСвязь.Отбор.Объект.Установить(Контрагент);
		НаборСвязь.Отбор.Свойство.Установить(СвСвязь);
		НаборСвязь.Записать(Истина);
	КонецЕсли;

	// Кэш кандидатов держится неделю, и в нём лежит тот же мёртвый адрес: без сброса
	// регламент переспросит реестр ФНС нескоро и подобрать будет не из чего.
	ИНН = СокрЛП(Строка(Контрагент.ИНН));
	Если ЗначениеЗаполнено(ИНН) Тогда
		Реестр = ЗагрузитьРеестрАдресов();
		Если Реестр[ИНН] <> Неопределено Тогда
			Реестр.Удалить(ИНН);
			СохранитьРеестрАдресов(Реестр);
		КонецЕсли;
	КонецЕсли;

	Сообщение = "Адреса " + Прежний + " у оператора больше нет - контрагент сменил оператора."
		+ " Адрес снят" + ?(БылоЗакрепление, " вместе с закреплением", "")
		+ ", живой подберёт обновление связей";

	ЗаписьЖурналаРегистрации("ЭДО.Отправка", УровеньЖурналаРегистрации.Предупреждение, , Контрагент,
		Сообщение);

	Возврат Сообщение;

КонецФункции

// Разобрать документ, у которого прошлая отправка оборвалась до получения идентификатора
// (ЭДО_КодСостояния = 10). Сверяем с оператором ровно то, что раньше сверял человек:
// есть ли живой экземпляр этого документа для того же получателя.
//
// Найден - закрепляем идентификатор и снимаем с очереди; не найден - снимаем код, документ
// уходит обычным ходом; оператор молчит - оставляем код и ждём следующего прогона.
// Возврат: Структура (Решено Булево, Ид Строка, Сообщение Строка).
Функция РазобратьПрерваннуюОтправку(Ссылка) Экспорт

	Результат = Новый Структура("Решено, Ид, Сообщение", Ложь, "", "");

	СвойствоКода = СвойствоОбъектов("ЭДО_КодСостояния");
	Если СвойствоКода = Неопределено ИЛИ СвойствоКода.Пустая() Тогда
		Результат.Решено = Истина;
		Возврат Результат;
	КонецЕсли;

	Текущий = ЗначениеСвойстваОбъекта(Ссылка, СвойствоКода);
	Если НЕ ЗначениеЗаполнено(Текущий) ИЛИ Число(Текущий) <> 10 Тогда
		Результат.Решено = Истина;
		Возврат Результат;
	КонецЕсли;

	Дубль = ЖивойЭкземплярУОператора(Ссылка);

	Если НЕ Дубль.Опрошено Тогда
		Результат.Сообщение = "Отправка прерывалась, у оператора не спросить"
			+ ?(ЗначениеЗаполнено(Дубль.Причина), " (" + Дубль.Причина + ")", "")
			+ ", разбор отложен до следующего прогона";
		Возврат Результат;
	КонецЕсли;

	Если Дубль.Найден Тогда
		ЗаписатьСтатусЭДО(Ссылка, 40, Дубль.Ид);
		ЗаписатьЧитаемыйСтатус(Ссылка, "Уже отправлен этому получателю");
		Результат.Решено = Истина;
		Результат.Ид = Дубль.Ид;
		Результат.Сообщение = "Прерванная отправка разобрана: экземпляр у оператора есть"
			+ " (ид " + Дубль.Ид + ", " + Дубль.Статус + ")";
		Возврат Результат;
	КонецЕсли;

	Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Ссылка);
	Набор.Отбор.Свойство.Установить(СвойствоКода);
	Набор.Записать(Истина);

	ЗаписьЖурналаРегистрации("ЭДО.Отправка", УровеньЖурналаРегистрации.Информация, , Ссылка,
		"Прерванная отправка разобрана: экземпляра у оператора нет, документ возвращён в поток");

	Результат.Решено = Истина;
	Возврат Результат;

КонецФункции

// Занять документ под отправку. Пишет статус 1 "взят в отправку" ДО обращения к API,
// под исключительной блокировкой - второй параллельный прогон этот документ уже не возьмёт.
//
// Мотив: 17.08 массовая отправка шла двумя прогонами одновременно. Отметка об отправке
// писалась ПОСЛЕ успеха, между стартом и записью документ выглядел неотправленным для
// соседнего процесса - 593 накладные ушли контрагентам дважды (обе в DELIVERED).
//
// Возврат: Структура (Занят Булево, Причина Строка).
Функция ЗанятьДокументКОтправке(Ссылка) Экспорт

	Результат = Новый Структура("Занят, Причина", Ложь, "");
	СвойствоСтатус = СвойствоОбъектов("ЭДО_КодСостояния");
	Если СвойствоСтатус = Неопределено ИЛИ СвойствоСтатус.Пустая() Тогда
		Результат.Занят = Истина;   // хранить статус негде — работаем как раньше
		Возврат Результат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.ЗначенияСвойствОбъектов");
		Элемент.УстановитьЗначение("Объект", Ссылка);
		Элемент.УстановитьЗначение("Свойство", СвойствоСтатус);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		Запрос = Новый Запрос(
			"ВЫБРАТЬ Значение КАК Значение
			|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
			|ГДЕ Объект = &Объект И Свойство = &Свойство");
		Запрос.УстановитьПараметр("Объект", Ссылка);
		Запрос.УстановитьПараметр("Свойство", СвойствоСтатус);
		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Значение) Тогда
			ТекСтатус = Число(Выборка.Значение);
			ОтменитьТранзакцию();
			Если ТекСтатус = 1 Тогда
				Результат.Причина = "Документ уже взят в отправку другим сеансом";
			ИначеЕсли ТекСтатус = 10 Тогда
 // статус 10 ставится, когда связь оборвалась ДО получения id: POST мог
 // пройти и не вернуть ответ. Автоматически повторять нельзя - сначала
 // человек сверяет по номеру накладной, есть ли экземпляр у оператора.
				Результат.Причина = "Отправка прерывалась, состояние у оператора неизвестно —"
					+ " проверить по номеру накладной и снять статус вручную";
			Иначе
 // Внутренний код состояния пользователю не показываем - он ему ничего не говорит
 // (замечание оператора 07.09). Код остаётся в свойстве и в журнале.
				Результат.Причина = "Документ уже отправлялся ранее";
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;

		ЗаписатьЗначениеСвойства(Ссылка, СвойствоСтатус, 1);
		ЗафиксироватьТранзакцию();
		Результат.Занят = Истина;
	Исключение
		ОтменитьТранзакцию();
		Результат.Причина = "Не удалось занять документ: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;
КонецФункции

// Освободить документ, если до создания документа у оператора дело не дошло:
// снимаем отметку "взят в отправку", чтобы он вернулся в очередь.
// Вызывать ТОЛЬКО когда у оператора ничего не создано - иначе повтор даст дубль.
Процедура ОсвободитьДокумент(Ссылка) Экспорт

	СвойствоСтатус = СвойствоОбъектов("ЭДО_КодСостояния");
	Если СвойствоСтатус = Неопределено ИЛИ СвойствоСтатус.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Значение КАК Значение
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Объект = &Объект И Свойство = &Свойство");
	Запрос.УстановитьПараметр("Объект", Ссылка);
	Запрос.УстановитьПараметр("Свойство", СвойствоСтатус);
	Выборка = Запрос.Выполнить().Выбрать();
	// снимаем только СВОЮ отметку "взят", чужие статусы не трогаем
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Значение) И Число(Выборка.Значение) <> 1 Тогда
		Возврат;
	КонецЕсли;

	Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Ссылка);
	Набор.Отбор.Свойство.Установить(СвойствоСтатус);
	Набор.Записать(Истина);

КонецПроцедуры

// Замок на массовый прогон. Живёт 30 минут, продлевается по ходу пакета.
// Возврат: Истина - прогон наш, можно работать.
Функция ЗанятьПрогонОтправки() Экспорт

	Метка = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", "ЗамокОтправки", , "");
	Если ТипЗнч(Метка) = Тип("Структура") И Метка.Свойство("До") Тогда
		Чужой = (Метка.Сеанс <> НомерСеансаИнформационнойБазы());
		Если Чужой И Метка.До > ТекущаяУниверсальнаяДата() Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	Новая = Новый Структура("Сеанс, До, Начат",
		НомерСеансаИнформационнойБазы(), ТекущаяУниверсальнаяДата() + 1800, ТекущаяДата());
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", "ЗамокОтправки", Новая, , "");
	Возврат Истина;
КонецФункции

// Снять отметки "взят в отправку" (статус 1), оставшиеся от прерванных прогонов.
// Вызывать только когда замок прогона наш - иначе снимем отметку у живого процесса.
Функция СнятьБрошенныеЗанятия() Экспорт

	СвойствоСтатус = СвойствоОбъектов("ЭДО_КодСостояния");
	Если СвойствоСтатус = Неопределено ИЛИ СвойствоСтатус.Пустая() Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Объект КАК Объект
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Свойство = &Свойство И Значение = &Значение");
	Запрос.УстановитьПараметр("Свойство", СвойствоСтатус);
	Запрос.УстановитьПараметр("Значение", 1);
	Выборка = Запрос.Выполнить().Выбрать();

	Снято = 0;
	Пока Выборка.Следующий() Цикл
		Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
		Набор.Отбор.Объект.Установить(Выборка.Объект);
		Набор.Отбор.Свойство.Установить(СвойствоСтатус);
		Набор.Записать(Истина);
		Снято = Снято + 1;
	КонецЦикла;

	Возврат Снято;
КонецФункции

Процедура ОсвободитьПрогонОтправки() Экспорт
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", "ЗамокОтправки", Неопределено, , "");
КонецПроцедуры

#КонецОбласти

#Область ЗакреплённыйАдрес

// Закреплённый адрес ЭДО - выбранный ЯВНО и потому не подлежащий пересмотру регламентом.
//
// Зачем: у контрагента бывает несколько живых адресов у разных операторов, и "связь есть"
// верно сразу для нескольких. Выбрать из них правильный алгоритмически нельзя - документы
// читает человек, а не протокол. Единственное надёжное доказательство "он читает этот
// ящик" - ПРИНЯТЫЙ им документ (ACCEPTED). Такой адрес закрепляем и больше не трогаем.
// Справочник фактических маршрутов остаётся подсказкой для ПЕРВИЧНОГО заполнения:
// он говорит, куда слали раньше, а не куда решено слать.
// Статус роуминга по адресу, который сейчас стоит в карточке. Кэш, который поддерживает
// ОбновитьСвязиЭДО: значения ESTABLISHED / AWAIT_APPROVAL / BROKEN / NO_CONTACT, а для пары
// абонентов одного оператора - DIRECT (роуминг не нужен). Пустая строка = ещё не проверяли.
Функция СтатусСвязиЭДО(Контрагент) Экспорт
	Свойство = СвойствоОбъектов("ЭДО_СтатусСвязи");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Значение КАК Значение
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Объект = &Объект И Свойство = &Свойство");
	Запрос.УстановитьПараметр("Объект", Контрагент);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Строка(Выборка.Значение));
	КонецЕсли;
	Возврат "";
КонецФункции

Функция АдресЭДОЗакреплён(Контрагент) Экспорт
	Свойство = СвойствоОбъектов("ЭДО_АдресЗакреплён");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Значение КАК Значение
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Объект = &Объект И Свойство = &Свойство");
	Запрос.УстановитьПараметр("Объект", Контрагент);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение = Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

// Закрепить за контрагентом адрес ЭДО. Пустой Адрес = закрепить тот, что стоит сейчас.
// Основание пишется рядом, чтобы в карточке было видно, откуда взялось решение.
// 50 символов - потолок строкового типа самого ПВХ СвойстваОбъектов, не наш выбор.
Процедура ЗакрепитьАдресЭДО(Контрагент, Знач Адрес = "", Знач Основание = "") Экспорт
	СвФлаг = СвойствоОбъектов("ЭДО_АдресЗакреплён");
	СвОсн  = СвойствоОбъектов("ЭДО_ЗакреплениеОснование");
	СвАдр  = СвойствоОбъектов("ЭДО_АдресКонтрагента");
	Если СвФлаг = Неопределено ИЛИ СвФлаг.Пустая() Тогда
		ВызватьИсключение "Свойство ЭДО_АдресЗакреплён не заведено в базе";
	КонецЕсли;
	Если ЗначениеЗаполнено(Адрес) И СвАдр <> Неопределено И НЕ СвАдр.Пустая() Тогда
		ЗаписатьЗначениеСвойства(Контрагент, СвАдр, ВРег(СокрЛП(Адрес)));
	КонецЕсли;
	ЗаписатьЗначениеСвойства(Контрагент, СвФлаг, Истина);
	Если ЗначениеЗаполнено(Основание) И СвОсн <> Неопределено И НЕ СвОсн.Пустая() Тогда
		ЗаписатьЗначениеСвойства(Контрагент, СвОсн, Лев(Основание, 50));
	КонецЕсли;
КонецПроцедуры

// Снять закрепление - вернуть контрагента под управление регламента.
Процедура СнятьЗакреплениеАдресаЭДО(Контрагент) Экспорт
	СвФлаг = СвойствоОбъектов("ЭДО_АдресЗакреплён");
	Если СвФлаг <> Неопределено И НЕ СвФлаг.Пустая() Тогда
		ЗаписатьЗначениеСвойства(Контрагент, СвФлаг, Ложь);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ФактическиеМаршруты

// Фактический маршрут контрагента - адрес, на который мы реально отправляли через прежнего
// оператора (взят из локального архива ЭДО по именам титулов продавца).
//
// Зачем: реестр ФНС отдаёт у контрагента по нескольку адресов, и "живая связь" есть не с тем,
// который он читает. 18.08 из-за этого 602 карточки отправляли не туда, а два клиента
// пожаловались, что не видят документов. Фактический маршрут - самый достоверный источник.
Функция ФактическийМаршрут(Знач ИНН) Экспорт
	Маршруты = ЗагрузитьФактическиеМаршруты();
	Значение = Маршруты[СокрЛП(ИНН)];
	Возврат ?(Значение = Неопределено, "", Строка(Значение));
КонецФункции

Функция ЗагрузитьФактическиеМаршруты() Экспорт
	Значение = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", "ФактическиеМаршруты", , "");
	Возврат ?(ТипЗнч(Значение) = Тип("Соответствие"), Значение, Новый Соответствие);
КонецФункции

// Загрузка справочника маршрутов (ИНН;адрес построчно). Возвращает число принятых строк.
Функция ЗагрузитьМаршрутыИзТекста(Знач Текст) Экспорт
	Маршруты = Новый Соответствие;
	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС) Цикл
		Части = СтрРазделить(СокрЛП(Строка), ";");
		Если Части.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		ИНН = СокрЛП(Части[0]);
		Адрес = СокрЛП(Части[1]);
		Если ЗначениеЗаполнено(ИНН) И ЗначениеЗаполнено(Адрес) Тогда
			Маршруты.Вставить(ИНН, Адрес);
		КонецЕсли;
	КонецЦикла;
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", "ФактическиеМаршруты", Маршруты, , "");
	Возврат Маршруты.Количество();
КонецФункции

#КонецОбласти

#Область ПричиныНеотправки

// Тексты, которые ЭТОТ механизм ведет в колонке "ЭДО" (свойство ЭДО_Состояние).
// Набор нужен, чтобы отличать свою строку от чужой: ту же колонку пишет PEDO-StatusSync
// (ход отправки по данным Платформы) и сама отправка ("Отправка не требуется").
// Свое значение перезаписываем свободно, чужое не трогаем никогда - иначе механизм,
// задуманный как подсказка, начнет стирать реальный статус документа.
Функция ТекстыПричинНеотправки() Экспорт
	Тексты = Новый Массив;
	Тексты.Добавить("Отправляется");
	Тексты.Добавить("В очереди на отправку");
	Тексты.Добавить("Отправлен через СБИС");
	Тексты.Добавить("Нет адреса ЭДО у контрагента");
	Тексты.Добавить("Нет связи с контрагентом");
	Тексты.Добавить("Ждем, пока контрагент примет приглашение");
	Тексты.Добавить("Связь с контрагентом разорвана");
	Тексты.Добавить("Связь с контрагентом не установлена");
	Тексты.Добавить("Взят в отправку, прогон не завершен");
	Тексты.Добавить("Состояние у оператора неизвестно");
	Тексты.Добавить("Не отражается в бухучете");
	Тексты.Добавить("Заказ еще не отгружен");
	Тексты.Добавить("Ждет печати или пометки");
	Тексты.Добавить(ТекстЗапретаПоОрганизации());
	Тексты.Добавить(ТекстПаузыКонтрагента());
	Тексты.Добавить(ТекстНетАдресаПокупателя());
	Для Каждого Канал Из ИменаКаналовВнеАвтовыбора() Цикл
		Тексты.Добавить(ТекстУдержанияКанала(Канал));
	КонецЦикла;
	// корректировки реализации (УКД), см. ОбновитьПричиныНеотправкиКорректировок
	Тексты.Добавить(ТекстИсходникНеОтправлен());
	Тексты.Добавить(ТекстИсходникНеПодписан());
	Тексты.Добавить(ТекстКорректировкаНеУКД());
	Тексты.Добавить(ТекстКорректировкаБезИзменений());
	Тексты.Добавить(ПрефиксОжиданияПроверкиУКД());
	Возврат Тексты;
КонецФункции

// Тексты колонки для корректировки, удержанной гейтами автоотправки УКД. Длиннее 50 символов
// нельзя: колонка - свойство Строка(50). Развернутая причина - в ПричинаУдержанияКорректировки.
Функция ТекстИсходникНеОтправлен() Экспорт
	Возврат "Исходник не отправлен по ЭДО";
КонецФункции

Функция ТекстИсходникНеПодписан() Экспорт
	Возврат "Исходник не подписан покупателем";
КонецФункции

Функция ТекстКорректировкаНеУКД() Экспорт
	Возврат "Исправление ошибки: отправка вручную";
КонецФункции

Функция ТекстКорректировкаБезИзменений() Экспорт
	Возврат "Нет измененных строк: УКД не нужен";
КонецФункции

// Начало текста колонки у корректировки, выжидающей паузу перед автоотправкой. Время окончания
// входит в текст, поэтому свою строку механизм узнает по началу, а не по точному совпадению.
Функция ПрефиксОжиданияПроверкиУКД() Экспорт
	Возврат "Ждет проверки";
КонецФункции

Функция ТекстОжиданияПроверкиУКД(Знач Окончание) Экспорт
	Если НЕ ЗначениеЗаполнено(Окончание) Тогда
		Возврат ПрефиксОжиданияПроверкиУКД();
	КонецЕсли;
	Возврат ПрефиксОжиданияПроверкиУКД() + " до " + Формат(Окончание, "ДФ=HH:mm");
КонецФункции

// Названия каналов вне автовыбора для набора текстов колонки. Текст удержания зависит от
// канала, а набор обязан знать все его варианты: неизвестную строку механизм считает чужой
// и больше не обновляет.
Функция ИменаКаналовВнеАвтовыбора() Экспорт
	Имена = Новый Массив;
	Имена.Добавить(ИмяКаналаЭДО("2LT"));
	Имена.Добавить(ИмяКаналаЭДО("2VO"));
	Имена.Добавить(ИмяКаналаЭДО("2IM"));
	Имена.Добавить(ИмяКаналаЭДО(""));
	Возврат Имена;
КонецФункции

// Текст колонки для документа, удержанного каналом вне автовыбора.
// Свойство ЭДО_Состояние имеет тип Строка(50), поэтому формулировка короткая; развернутая
// причина с адресом остается за ПроверитьГотовностьКОтправке и видна в карточке.
Функция ТекстУдержанияКанала(Знач ИмяКанала) Экспорт
	Возврат Лев("Удержан: " + ИмяКанала + " без закрепления", 50);
КонецФункции

// Префикс для незнакомого статуса связи: показываем как есть, а не прячем.
// Проверка "свое ли значение" обязана учитывать и его, иначе на следующем прогоне
// механизм сочтет собственную строку чужой и перестанет ее обновлять.
// Тексты, которые механизм писал РАНЬШЕ. Нужны ровно для одного: узнать собственную старую
// строку и перезаписать ее актуальной. Без этого списка смена формулировки означает, что
// прежние значения навсегда остаются в колонке: проверка "наше ли значение" сочтет их чужими
// и обойдет стороной. Повод правки - решение оператора 24.08.2026 о едином написании без
// точек над е.
Функция УстаревшиеТекстыПричин() Экспорт
	Тексты = Новый Массив;
	Тексты.Добавить("Ждём, пока контрагент примет приглашение");
	Тексты.Добавить("Заказ ещё не отгружен");
	Тексты.Добавить("Не отражается в бухучёте");
	Тексты.Добавить("Взят в отправку, прогон не завершён");
	Возврат Тексты;
КонецФункции

Функция ПрефиксПричиныСвязи() Экспорт
	Возврат "Связь с контрагентом: ";
КонецФункции

// Текст колонки для документа организации, которой отправка по ЭДО запрещена
// (флаг ЭДО_РазрешенаОтправка снят или свойство не заведено). Отдельный текст нужен, чтобы
// такой документ не выглядел ждущим печати: в moroz 207 из 208 "висящих" были документами
// организации-дубля, отправка по которой не предусмотрена вовсе (замер 10.09.2026).
Функция ТекстЗапретаПоОрганизации() Экспорт
	Возврат "Отправка запрещена по организации";
КонецФункции

// Текст колонки для документа контрагента на паузе (ЭДО_ОтправкаПриостановлена). Отбор очереди
// такие документы не берёт, а без своего текста колонка показывала "В очереди на отправку"
// (13.09.2026, ТБ-00062889). Причина паузы в текст не входит: колонка - Строка(50), а причина
// видна в карточке и в Центре управления.
Функция ТекстПаузыКонтрагента() Экспорт
	Возврат "Отправка контрагенту приостановлена";
КонецФункции

// Текст колонки для документа, по которому контрагент прислал запрос на аннулирование (ПОА).
// Статус карточки при этом не меняется (остается "Принят" или "Доставлен"), и без подмены
// бухгалтер узнает о запросе только из личного кабинета оператора. Сам запрос с причиной
// ставит на документ сторож (свойство ЭДО_ЗапросАннулирования, закрытый снимает).
Функция ТекстЗапросаАннулирования() Экспорт
	Возврат "Контрагент просит аннулировать";
КонецФункции

// Документы с открытым запросом на аннулирование: Соответствие ссылка -> Истина.
// Одним запросом на прогон - сверка статусов обходит тысячи документов.
Функция ДокументыСЗапросомАннулирования() Экспорт
	Результат = Новый Соответствие;
	Свойство = СвойствоОбъектов("ЭДО_ЗапросАннулирования");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Объект КАК Объект
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Свойство = &Свойство И ВЫРАЗИТЬ(Значение КАК СТРОКА(50)) <> """"");
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Для Каждого Строчка Из Запрос.Выполнить().Выгрузить() Цикл
		Результат.Вставить(Строчка.Объект, Истина);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Текст колонки с учетом открытого запроса на аннулирование. Подменяет статус Платформы,
// кроме уже аннулированного документа: там запрос исполнен, и статус важнее.
// ЗапросыДокументов - результат ДокументыСЗапросомАннулирования(); не передан - спросим сами.
Функция ТекстКолонкиСУчетомЗапросаАннулирования(Знач Ссылка, Знач ТекстСтатуса,
	Знач ЗапросыДокументов = Неопределено) Экспорт
	Если ТекстСтатуса = "Аннулирован" Тогда
		Возврат ТекстСтатуса;
	КонецЕсли;
	Если ЗапросыДокументов = Неопределено Тогда
		ЗапросыДокументов = ДокументыСЗапросомАннулирования();
	КонецЕсли;
	Если ЗапросыДокументов.Получить(Ссылка) = Неопределено Тогда
		Возврат ТекстСтатуса;
	КонецЕсли;
	Возврат ТекстЗапросаАннулирования();
КонецФункции

// Текст колонки для статуса Платформы DELETED - карточка документа удалена у оператора.
// Держится здесь, а не только в карте статусов регламента: ядро обязано узнавать его своим
// (см. ЗначениеКолонкиНаше), а витрина - относить к группе.
Функция ТекстКарточкаУдалена() Экспорт
	Возврат "Удален у оператора";
КонецФункции

// Наше ли это значение колонки, то есть можно ли его перезаписывать.
Функция ЗначениеКолонкиНаше(Знач Текст) Экспорт
	Значение = СокрЛП(Текст);
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Истина;   // пусто — писать можно
	КонецЕсли;
	Если Значение = ТекстСтатусаОтправкаНеТребуется() Тогда
		Возврат Ложь;     // ⚠️ его же ищет отбор очереди — не трогать ни при каких условиях
	КонецЕсли;
	Если ТекстыПричинНеотправки().Найти(Значение) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если УстаревшиеТекстыПричин().Найти(Значение) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	// Карточка у оператора удалена: статус записала сверка, пока идентификатор был. Когда его
	// сняли, сверка документ больше не видит, а без этой ветки и ядро не видело бы -
	// колонка навсегда застывала на удалённой карточке (09.09.2026: три документа prodline
	// с сырым DELETED, все три - служебные черновики ФЛК, удалённые 26.08).
	// Документ, у которого идентификатор ещё есть, отсюда не перезапишется:
	// ПричинаНеотправки для него возвращает пустую строку.
	Если Значение = ТекстКарточкаУдалена() ИЛИ ВРег(Значение) = "DELETED" Тогда
		Возврат Истина;
	КонецЕсли;
	Если Найти(Значение, ПрефиксОжиданияПроверкиУКД()) = 1 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Найти(Значение, ПрефиксПричиныСвязи()) = 1;
КонецФункции

// Почему документ не уходит - текстом для колонки "ЭДО".
// Порядок веток повторяет порядок отсева самой отправки: сначала "уже в работе",
// потом "ушел другим каналом", потом причины, по которым документ не берется в очередь.
Функция ПричинаНеотправки(Знач ИдПлатформы, Знач КодСтатуса, Знач ЕстьСБИС,
	Знач АдресЭДО, Знач СтатусСвязи, Знач ОтражатьВБухучете = Истина, Знач ЗаказГотов = Истина,
	Знач ГотовКОтправке = Истина, Знач АдресЗакреплен = Истина, Знач ОрганизацияРазрешена = Истина,
	Знач НаПаузе = Ложь, Знач ЕстьАдресПокупателя = Истина) Экспорт

	Если ЗначениеЗаполнено(ИдПлатформы) Тогда
 // Карточка у оператора создана - документ вышел из зоны этого механизма. Его состояние
 // ведут те, кто знает факт: сама отправка пишет "Отправляется" в момент создания карточки,
 // дальше статус ведут сверки по данным Платформы.
 // Раньше здесь возвращалось "Отправляется" - заплатка на то, что отправка своего статуса
 // не писала вовсе, и до первого прогона сверки в колонке оставалась прежняя подсказка.
 // Пустая строка означает "не мой документ, не трогать": вызывающий такую запись пропускает.
		Возврат "";
	КонецЕсли;
	Если КодСтатуса = 1 Тогда
		Возврат "Взят в отправку, прогон не завершен";
	КонецЕсли;
	Если КодСтатуса = 10 Тогда
		Возврат "Состояние у оператора неизвестно";
	КонецЕсли;
	Если ЕстьСБИС Тогда
		Возврат "Отправлен через СБИС";
	КонецЕсли;

	// Запрет по организации - раньше прочих признаков документа: он не снимается ни печатью,
	// ни отгрузкой, ни связью, и "Ждет печати или пометки" у такого документа врёт.
	Если НЕ ОрганизацияРазрешена Тогда
		Возврат ТекстЗапретаПоОрганизации();
	КонецЕсли;

	// Здесь НЕ пишем "Отправка не требуется", хотя по смыслу похоже: этот текст -
	// ФИЛЬТР отбора очереди, документ с ним исключается навсегда. Галку бухучета ставят
	// и задним числом, и тогда документ обязан уйти; с текстом-фильтром он молча не ушел бы.
	// причина здесь описывает СОСТОЯНИЕ документа и снимается сама, когда состояние
	// изменилось: следующий прогон перечитает флаги и поставит актуальное значение.
	Если НЕ ОтражатьВБухучете Тогда
		Возврат "Не отражается в бухучете";
	КонецЕсли;
	Если НЕ ЗаказГотов Тогда
		Возврат "Заказ еще не отгружен";
	КонецЕсли;
	// Пауза - после признаков самого документа (они не уйдут и без паузы), но до адреса и связи:
	// снять её может только человек, и это первое, что ему надо увидеть.
	Если НаПаузе Тогда
		Возврат ТекстПаузыКонтрагента();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(АдресЭДО) Тогда
		Возврат "Нет адреса ЭДО у контрагента";
	КонецЕсли;

	// Удержание каналом вне автовыбора идет ДО разбора связи, потому что связь там как раз
	// исправна: 2VO дает DIRECT, 2LT дает ESTABLISHED. Без этой ветки удержанный документ
	// показывался как "В очереди на отправку", то есть неотличимо от того, что вот-вот уйдет,
	// хотя без ручного закрепления он не уйдет никогда. Прецедент 09.09.2026: ТБ-00065873
	// висел с 07.09 с текстом очереди при удержании ядром.
	Если АдресЭДОВнеАвтовыбора(АдресЭДО) И НЕ АдресЗакреплен Тогда
		Возврат ТекстУдержанияКанала(ИмяКаналаЭДО(АдресЭДО));
	КонецЕсли;
	Если НЕ ЕстьАдресПокупателя Тогда
		Возврат ТекстНетАдресаПокупателя();
	КонецЕсли;

	Связь = ВРег(СокрЛП(СтатусСвязи));
	Если НЕ ЗначениеЗаполнено(Связь) Тогда
		Возврат "Связь с контрагентом не установлена";
	ИначеЕсли Связь = "ESTABLISHED" ИЛИ Связь = "DIRECT" Тогда
 // Документ годен по всем признакам, но состав ещё не подтверждён: его не печатали
 // и не помечали. Бухгалтеру важно отличать это от "сейчас уйдёт" - иначе документ,
 // ждущий печати, выглядит так же, как стоящий в очереди.
		Возврат ?(ГотовКОтправке, "В очереди на отправку", "Ждет печати или пометки");
	ИначеЕсли Связь = "NO_CONTACT" Тогда
		Возврат "Нет связи с контрагентом";
	ИначеЕсли Связь = "AWAIT_APPROVAL" Тогда
		Возврат "Ждем, пока контрагент примет приглашение";
	ИначеЕсли Связь = "BROKEN" Тогда
		Возврат "Связь с контрагентом разорвана";
	КонецЕсли;
	Возврат Лев(ПрефиксПричиныСвязи() + СокрЛП(СтатусСвязи), 50);
КонецФункции

// Проставить причину неотправки всем проведенным документам окна отбора.
// Отбор ШИРЕ, чем у очереди отправки, и намеренно: очередь берет только годные документы,
// а колонка обязана объяснять и негодные - иначе "не отражается в бухучете" и "заказ еще
// не отгружен" выглядят так же, как "сломалось" (просьба оператора 24.08.2026).
// Мотив: документ, не прошедший отбор очереди, не получал в колонку НИЧЕГО, и оператор
// не отличал "еще не ушло" от "не уйдет никогда" - на 23.08.2026 в боевой базе так молчали
// 474 документа. Причина перечитывается каждый прогон и снимается сама: как только
// появился идентификатор Платформы, вместо нее встает ход отправки.
// Чужие значения колонки не перезаписываются - см. ЗначениеКолонкиНаше.
// Возврат: Структура (Просмотрено, Записано, Сводка).
Функция ОбновитьПричиныНеотправки(Знач МаксЗаписей = 5000) Экспорт

	Результат = Новый Структура("Просмотрено, Записано, Сводка", 0, 0, "");

	СвойствоТекст = СвойствоОбъектов("ЭДО_Состояние");
	Если СвойствоТекст = Неопределено ИЛИ СвойствоТекст.Пустая() Тогда
		Результат.Сводка = "свойство ЭДО_Состояние не заведено";
		Возврат Результат;
	КонецЕсли;

	СвСБИС  = СвойствоОбъектов("ДокументСБИС_Ид");
	СвПлат  = СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	СвСтат  = СвойствоОбъектов("ЭДО_КодСостояния");
	СвИд    = СвойствоОбъектов("ЭДО_АдресКонтрагента");
	СвСвязь = СвойствоОбъектов("ЭДО_СтатусСвязи");
	СвПометка = СвойствоОбъектов("ЭДО_ПометкаКОтправке");
	СвЗакреп = СвойствоОбъектов("ЭДО_АдресЗакреплён");
	// НайтиПоНаименованию возвращает ПУСТУЮ ССЫЛКУ, а не Неопределено - проверки
	// "<> Неопределено" мало: в moroz свойства ДокументСБИС_Ид нет вовсе, и запрос
	// соединялся с регистром по ПУСТОМУ свойству - документ мог получить чужую
	// причину "уже ушёл через СБИС".
	ЕстьСвойствоСБИС = (СвСБИС <> Неопределено И НЕ СвСБИС.Пустая());

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаСГейтомЗаказа(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ Тов.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ЗаказНеГотов
		|ИЗ Документ.РеализацияТоваровУслуг.Товары КАК Тов
		|ГДЕ Тов.ЗаказПокупателя <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
		|	И (НЕ Тов.ЗаказПокупателя.Статус В (&ГотовыеСтатусы)
		|		ИЛИ НАЧАЛОПЕРИОДА(Тов.ЗаказПокупателя.ДатаОтгрузки, ДЕНЬ) > &СегодняНачалоДня)
		|	И Тов.Ссылка.Дата >= &Дата
		|;
		|" + ТекстТаблицАдресаПокупателя() + "
		|;
		|ВЫБРАТЬ
		|	РТУ.Ссылка КАК Ссылка,
		|	ВЫБОР КОГДА СвойАдрес.Контрагент ЕСТЬ НЕ NULL ИЛИ АдресПоИНН.ИНН ЕСТЬ НЕ NULL
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ЕстьАдресПокупателя,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Плат.Значение КАК СТРОКА(50)), """") КАК ИдПлатформы,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Стат.Значение КАК ЧИСЛО(10, 0)), 0) КАК КодСтатуса,
		|	ВЫБОР КОГДА СБИС.Объект ЕСТЬ НЕ NULL ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ЕстьСБИС,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Ид.Значение КАК СТРОКА(50)), """") КАК АдресЭДО,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Связь.Значение КАК СТРОКА(50)), """") КАК СтатусСвязи,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Текст.Значение КАК СТРОКА(50)), """") КАК ТекущийТекст,
		|	ВЫБОР КОГДА ВЫРАЗИТЬ(Пометка.Значение КАК БУЛЕВО) = ИСТИНА
		|			ИЛИ ВЫРАЗИТЬ(Пометка.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК Помечен,
		|	ВЫБОР КОГДА ВЫРАЗИТЬ(Закреп.Значение КАК БУЛЕВО) = ИСТИНА
		|			ИЛИ ВЫРАЗИТЬ(Закреп.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК АдресЗакреплен,
		|	ВЫБОР КОГДА ВЫРАЗИТЬ(Разр.Значение КАК БУЛЕВО) = ИСТИНА
		|			ИЛИ ВЫРАЗИТЬ(Разр.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ОрганизацияРазрешена,
		|	ВЫБОР КОГДА ЕСТЬNULL(ВЫРАЗИТЬ(Пауза.Значение КАК БУЛЕВО), ЛОЖЬ) = ИСТИНА
		|			ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Пауза.Значение КАК СТРОКА(50)), """") В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК НаПаузе,
		|	РТУ.Дата КАК ДатаДокумента,
		|	РТУ.ОтражатьВБухгалтерскомУчете КАК ОтражатьВБухучете,
		|	ВЫБОР КОГДА НеГотов.Ссылка ЕСТЬ NULL ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ЗаказГотов
		|ИЗ Документ.РеализацияТоваровУслуг КАК РТУ
		|	ЛЕВОЕ СОЕДИНЕНИЕ ЗаказНеГотов КАК НеГотов ПО НеГотов.Ссылка = РТУ.Ссылка
		|	ЛЕВОЕ СОЕДИНЕНИЕ КарточкиСАдресом КАК СвойАдрес ПО СвойАдрес.Контрагент = РТУ.Контрагент
		|	ЛЕВОЕ СОЕДИНЕНИЕ ИННСАдресом КАК АдресПоИНН ПО АдресПоИНН.ИНН = РТУ.Контрагент.ИНН
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК СБИС
		|		ПО СБИС.Объект = РТУ.Ссылка И СБИС.Свойство = &СвСБИС
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Плат
		|		ПО Плат.Объект = РТУ.Ссылка И Плат.Свойство = &СвПлат
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Стат
		|		ПО Стат.Объект = РТУ.Ссылка И Стат.Свойство = &СвСтат
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Текст
		|		ПО Текст.Объект = РТУ.Ссылка И Текст.Свойство = &СвТекст
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Пометка
		|		ПО Пометка.Объект = РТУ.Ссылка И Пометка.Свойство = &СвПометка
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Ид
		|		ПО ВЫРАЗИТЬ(Ид.Объект КАК Справочник.Контрагенты) = РТУ.Контрагент И Ид.Свойство = &СвИд
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Связь
		|		ПО ВЫРАЗИТЬ(Связь.Объект КАК Справочник.Контрагенты) = РТУ.Контрагент И Связь.Свойство = &СвСвязь
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Закреп
		|		ПО ВЫРАЗИТЬ(Закреп.Объект КАК Справочник.Контрагенты) = РТУ.Контрагент И Закреп.Свойство = &СвЗакреп
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Разр
		|		ПО ВЫРАЗИТЬ(Разр.Объект КАК Справочник.Организации) = РТУ.Организация И Разр.Свойство = &СвРазр
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Пауза
		|		ПО ВЫРАЗИТЬ(Пауза.Объект КАК Справочник.Контрагенты) = РТУ.Контрагент И Пауза.Свойство = &СвПауза
		|ГДЕ РТУ.Проведен И РТУ.Дата >= &Дата
		|УПОРЯДОЧИТЬ ПО РТУ.Дата УБЫВ");
	Запрос.УстановитьПараметр("ГотовыеСтатусы", ГотовыеСтатусыЗаказа());
	Запрос.УстановитьПараметр("СегодняНачалоДня", НачалоДня(ТекущаяДата()));
	ГраницаПодсказок = РанняяДатаНачалаОтправки();
	Если НЕ ЗначениеЗаполнено(ГраницаПодсказок) Тогда
		ГраницаПодсказок = НижняяГраницаОтбора();
	КонецЕсли;
	Запрос.УстановитьПараметр("Дата", ГраницаПодсказок);
	Запрос.УстановитьПараметр("СвСБИС", ?(ЕстьСвойствоСБИС, СвСБИС,
		ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка()));
	Запрос.УстановитьПараметр("СвПлат", СвПлат);
	Запрос.УстановитьПараметр("СвСтат", СвСтат);
	Запрос.УстановитьПараметр("СвТекст", СвойствоТекст);
	Запрос.УстановитьПараметр("СвПометка", ?(СвПометка = Неопределено,
		ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка(), СвПометка));
	Запрос.УстановитьПараметр("СвИд", СвИд);
	Запрос.УстановитьПараметр("СвСвязь", СвСвязь);
	Запрос.УстановитьПараметр("СвЗакреп", ?(СвЗакреп = Неопределено,
		ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка(), СвЗакреп));
	// Свойства нет - отбор очереди не пропускает никого, и колонка обязана говорить то же.
	СвРазр = СвойствоОбъектов("ЭДО_РазрешенаОтправка");
	Запрос.УстановитьПараметр("СвРазр", ?(СвРазр = Неопределено,
		ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка(), СвРазр));
	СвПауза = СвойствоОбъектов("ЭДО_ОтправкаПриостановлена");
	Запрос.УстановитьПараметр("СвПауза", ?(СвПауза = Неопределено,
		ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка(), СвПауза));
	УстановитьПараметрыАдресаПокупателя(Запрос);

	Таблица = Запрос.Выполнить().Выгрузить();
	Результат.Просмотрено = Таблица.Количество();

	// Те же рамки, что у отбора очереди: колонка обязана объяснять ровно то, что делает отбор.
	// Непомеченный документ вне скользящего окна не уйдёт даже по страховке - значит и
	// писать ему "В очереди на отправку" нельзя.
	ГейтГотовности = Число(НастройкаЭДО("ОтправлятьТолькоПослеГотовности")) <> 0;
	ДнейСтраховки = Число(НастройкаЭДО("ДнейСтраховкиБезПометки"));
	ГраницаСтраховки = ?(ДнейСтраховки > 0, НачалоДня(ТекущаяДата()) - ДнейСтраховки * 86400, '00010101');
	ГраницаОкна = НижняяГраницаОтбора();

	Счетчики = Новый Соответствие;
	Для Каждого Строчка Из Таблица Цикл
		Если Результат.Записано >= МаксЗаписей Тогда
			Прервать;
		КонецЕсли;
		Текущий = СокрЛП(Строчка.ТекущийТекст);
		Если НЕ ЗначениеКолонкиНаше(Текущий) Тогда
			Продолжить;
		КонецЕсли;
		Помечен = Строчка.Помечен;   // оба представления флага разобраны запросом
		СрокВышел = (ДнейСтраховки > 0 И Строчка.ДатаДокумента <= ГраницаСтраховки
			И Строчка.ДатаДокумента >= ГраницаОкна);
		НовоеЗначение = ПричинаНеотправки(Строчка.ИдПлатформы, Строчка.КодСтатуса, Строчка.ЕстьСБИС,
			Строчка.АдресЭДО, Строчка.СтатусСвязи, Строчка.ОтражатьВБухучете, Строчка.ЗаказГотов,
			Помечен ИЛИ СрокВышел ИЛИ НЕ ГейтГотовности, Строчка.АдресЗакреплен,
			Строчка.ОрганизацияРазрешена, Строчка.НаПаузе, Строчка.ЕстьАдресПокупателя);
		Если НЕ ЗначениеЗаполнено(НовоеЗначение) Тогда
			Продолжить;   // документ уже у оператора - его состояние ведут сверки, не мы
		КонецЕсли;
		Если НовоеЗначение = Текущий Тогда
			Продолжить;   // не переписываем одно и то же — регистр не должен шуметь
		КонецЕсли;
		ЗаписатьЧитаемыйСтатус(Строчка.Ссылка, НовоеЗначение);
		Результат.Записано = Результат.Записано + 1;
		Счетчики.Вставить(НовоеЗначение, ?(Счетчики[НовоеЗначение] = Неопределено, 0, Счетчики[НовоеЗначение]) + 1);
	КонецЦикла;

	// Корректировки реализации ведет тот же механизм, их счетчики идут в общую сводку.
	Если Результат.Записано < МаксЗаписей Тогда
		Корректировки = ОбновитьПричиныНеотправкиКорректировок(МаксЗаписей - Результат.Записано);
		Результат.Просмотрено = Результат.Просмотрено + Корректировки.Просмотрено;
		Результат.Записано = Результат.Записано + Корректировки.Записано;
		Для Каждого Пара Из Корректировки.Счетчики Цикл
			Счетчики.Вставить("УКД " + Пара.Ключ, Пара.Значение);
		КонецЦикла;
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Пара Из Счетчики Цикл
		Части.Добавить(Пара.Ключ + ": " + Пара.Значение);
	КонецЦикла;
	Результат.Сводка = СтрСоединить(Части, ", ");

	Возврат Результат;
КонецФункции

// Причины неотправки в колонку "ЭДО" для корректировок реализации с даты начала автоотправки
// УКД. Автоотправка выключена - корректировки не трогаем: их шлют вручную, и подсказка
// "В очереди на отправку" у них врала бы.
// Возврат: Структура (Просмотрено, Записано, Счетчики - Соответствие текст -> количество).
Функция ОбновитьПричиныНеотправкиКорректировок(Знач МаксЗаписей = 5000) Экспорт

	Результат = Новый Структура("Просмотрено, Записано, Счетчики", 0, 0, Новый Соответствие);
	ДатаНачала = ДатаНачалаАвтоотправкиУКД();
	СвойствоТекст = СвойствоОбъектов("ЭДО_Состояние");
	Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ СвойствоТекст.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстТаблицАдресаПокупателя() + "
		|;
		|" + ТекстТаблицыКорректировокСИзменениями() + "
		|;
		|ВЫБРАТЬ
		|	Корр.Ссылка КАК Ссылка,
		|	Корр.ВерсияДанных КАК ВерсияДанных,
		|	ВЫБОР КОГДА Корр.ВидОперации = &ВидПоСогласованию ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ПоСогласованию,
		|	ВЫБОР КОГДА Изм.Ссылка ЕСТЬ NULL ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ КАК ЕстьИзменения,
		|	Корр.ОтражатьВБухгалтерскомУчете КАК ОтражатьВБухучете,
		|	ВЫБОР КОГДА СвойАдрес.Контрагент ЕСТЬ НЕ NULL ИЛИ АдресПоИНН.ИНН ЕСТЬ НЕ NULL
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ЕстьАдресПокупателя,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Плат.Значение КАК СТРОКА(50)), """") КАК ИдПлатформы,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Стат.Значение КАК ЧИСЛО(10, 0)), 0) КАК КодСтатуса,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Ид.Значение КАК СТРОКА(50)), """") КАК АдресЭДО,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Связь.Значение КАК СТРОКА(50)), """") КАК СтатусСвязи,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Текст.Значение КАК СТРОКА(50)), """") КАК ТекущийТекст,
		|	ВЫБОР КОГДА ВЫРАЗИТЬ(Закреп.Значение КАК БУЛЕВО) = ИСТИНА
		|			ИЛИ ВЫРАЗИТЬ(Закреп.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК АдресЗакреплен,
		|	ВЫБОР КОГДА ВЫРАЗИТЬ(Разр.Значение КАК БУЛЕВО) = ИСТИНА
		|			ИЛИ ВЫРАЗИТЬ(Разр.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ОрганизацияРазрешена,
		|	ВЫБОР КОГДА ЕСТЬNULL(ВЫРАЗИТЬ(Пауза.Значение КАК БУЛЕВО), ЛОЖЬ) = ИСТИНА
		|			ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Пауза.Значение КАК СТРОКА(50)), """") В (""Да"", ""Истина"", ""1"")
		|		ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК НаПаузе,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(ИсхИд.Значение КАК СТРОКА(50)), """") КАК ИдИсходника,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(ИсхСост.Значение КАК СТРОКА(50)), """") КАК СостояниеИсходника,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Ожидание.Значение КАК СТРОКА(50)), """") КАК Отметка
		|ИЗ Документ.КорректировкаРеализации КАК Корр
		|	ЛЕВОЕ СОЕДИНЕНИЕ КарточкиСАдресом КАК СвойАдрес ПО СвойАдрес.Контрагент = Корр.Контрагент
		|	ЛЕВОЕ СОЕДИНЕНИЕ ИННСАдресом КАК АдресПоИНН ПО АдресПоИНН.ИНН = Корр.Контрагент.ИНН
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Плат
		|		ПО Плат.Объект = Корр.Ссылка И Плат.Свойство = &СвПлат
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Стат
		|		ПО Стат.Объект = Корр.Ссылка И Стат.Свойство = &СвСтат
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Текст
		|		ПО Текст.Объект = Корр.Ссылка И Текст.Свойство = &СвТекст
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Ожидание
		|		ПО Ожидание.Объект = Корр.Ссылка И Ожидание.Свойство = &СвОжидание
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ИсхИд
		|		ПО ИсхИд.Объект = Корр.ДокументРеализации И ИсхИд.Свойство = &СвПлат
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ИсхСост
		|		ПО ИсхСост.Объект = Корр.ДокументРеализации И ИсхСост.Свойство = &СвТекст
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Ид
		|		ПО ВЫРАЗИТЬ(Ид.Объект КАК Справочник.Контрагенты) = Корр.Контрагент И Ид.Свойство = &СвИд
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Связь
		|		ПО ВЫРАЗИТЬ(Связь.Объект КАК Справочник.Контрагенты) = Корр.Контрагент И Связь.Свойство = &СвСвязь
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Закреп
		|		ПО ВЫРАЗИТЬ(Закреп.Объект КАК Справочник.Контрагенты) = Корр.Контрагент И Закреп.Свойство = &СвЗакреп
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Разр
		|		ПО ВЫРАЗИТЬ(Разр.Объект КАК Справочник.Организации) = Корр.Организация И Разр.Свойство = &СвРазр
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Пауза
		|		ПО ВЫРАЗИТЬ(Пауза.Объект КАК Справочник.Контрагенты) = Корр.Контрагент И Пауза.Свойство = &СвПауза
		|	ЛЕВОЕ СОЕДИНЕНИЕ КорректировкиСИзменениями КАК Изм
		|		ПО Изм.Ссылка = Корр.Ссылка
		|ГДЕ Корр.Проведен И Корр.Дата >= &Дата
		|УПОРЯДОЧИТЬ ПО Корр.Дата УБЫВ";
	Запрос.УстановитьПараметр("Дата", ДатаНачала);
	Запрос.УстановитьПараметр("ВидПоСогласованию", ВидКорректировкиПоСогласованию());
	Запрос.УстановитьПараметр("СвТекст", СвойствоТекст);
	Запрос.УстановитьПараметр("СвПлат", СвойствоОбъектов("ЭДО_ИдентификаторДокумента"));
	Запрос.УстановитьПараметр("СвСтат", СвойствоОбъектов("ЭДО_КодСостояния"));
	Запрос.УстановитьПараметр("СвИд", СвойствоОбъектов("ЭДО_АдресКонтрагента"));
	Запрос.УстановитьПараметр("СвСвязь", СвойствоОбъектов("ЭДО_СтатусСвязи"));
	Запрос.УстановитьПараметр("СвЗакреп", СвойствоОбъектов("ЭДО_АдресЗакреплён"));
	Запрос.УстановитьПараметр("СвРазр", СвойствоОбъектов("ЭДО_РазрешенаОтправка"));
	Запрос.УстановитьПараметр("СвПауза", СвойствоОбъектов("ЭДО_ОтправкаПриостановлена"));
	Запрос.УстановитьПараметр("СвОжидание", СвойствоОбъектов(ИмяСвойстваОжиданияУКД()));
	УстановитьПараметрыАдресаПокупателя(Запрос);

	Таблица = Запрос.Выполнить().Выгрузить();
	Результат.Просмотрено = Таблица.Количество();

	Сейчас = ТекущаяДата();
	Для Каждого Строчка Из Таблица Цикл
		Если Результат.Записано >= МаксЗаписей Тогда
			Прервать;
		КонецЕсли;
		Текущий = СокрЛП(Строчка.ТекущийТекст);
		Если НЕ ЗначениеКолонкиНаше(Текущий) Тогда
			Продолжить;
		КонецЕсли;
		НовоеЗначение = ПричинаНеотправкиКорректировки(Строчка, Сейчас);
		Если НЕ ЗначениеЗаполнено(НовоеЗначение) ИЛИ НовоеЗначение = Текущий Тогда
			Продолжить;
		КонецЕсли;
		ЗаписатьЧитаемыйСтатус(Строчка.Ссылка, НовоеЗначение);
		Результат.Записано = Результат.Записано + 1;
		Сколько = Результат.Счетчики.Получить(НовоеЗначение);
		Результат.Счетчики.Вставить(НовоеЗначение, ?(Сколько = Неопределено, 0, Сколько) + 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Текст колонки для корректировки по строке запроса ОбновитьПричиныНеотправкиКорректировок.
// Сначала общие причины реализаций; когда по ним документ годен, - гейты автоотправки УКД
// в том же порядке, что в ПричинаУдержанияКорректировки. Пустая строка - документ у оператора.
Функция ПричинаНеотправкиКорректировки(Знач Строчка, Знач Сейчас)

	ТекстВОчереди = "В очереди на отправку";
	Причина = ПричинаНеотправки(Строчка.ИдПлатформы, Строчка.КодСтатуса, Ложь, Строчка.АдресЭДО,
		Строчка.СтатусСвязи, Строчка.ОтражатьВБухучете, Истина, Истина, Строчка.АдресЗакреплен,
		Строчка.ОрганизацияРазрешена, Строчка.НаПаузе, Строчка.ЕстьАдресПокупателя);
	Если Причина <> ТекстВОчереди Тогда
		Возврат Причина;
	КонецЕсли;

	Если НЕ Строчка.ПоСогласованию Тогда
		Возврат ТекстКорректировкаНеУКД();
	КонецЕсли;
	Если НЕ Строчка.ЕстьИзменения Тогда
		Возврат ТекстКорректировкаБезИзменений();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Строчка.ИдИсходника) Тогда
		Возврат ТекстИсходникНеОтправлен();
	КонецЕсли;
	Если СокрЛП(Строчка.СостояниеИсходника) <> ТекстИсходникПринят() Тогда
		Возврат ТекстИсходникНеПодписан();
	КонецЕсли;

	Ожидание = ОжиданиеКорректировки(Строчка.Отметка, Строчка.ВерсияДанных, Сейчас);
	Если Ожидание.Выдержана Тогда
		Возврат ТекстВОчереди;
	КонецЕсли;
	Возврат ТекстОжиданияПроверкиУКД(Ожидание.Окончание);

КонецФункции

#КонецОбласти

#Область Аннулирование

// Аннулирование в ЭДО двустороннее. Мы шлем предложение (ПОА), контрагент подтверждает его
// у себя, и только тогда документ становится аннулированным. На входящее предложение
// отвечаем мы: подписью (принять) или универсальным сообщением с отказом.
// Механика проверена вызовами API 28.08 и 02.09.2026, разбор - топик edo-platformaofd-api.

// Типовые причины, которые уходят контрагенту в тексте ПОА. Формулировки утверждены
// оператором (коды маркировки 02.09.2026, вес 13.09.2026): человек на той стороне читает
// только этот текст, без сопровождения.
Функция ТиповыеПричиныАннулирования() Экспорт

	Причины = Новый Массив;
	Причины.Добавить("Исправление кодов маркировки: в отправленном документе искажен код идентификации товара");
	Причины.Добавить("Уточнение количества: в отправленном документе вес или количество не совпадают с фактической приемкой, исправленный документ отправлен отдельно");
	Причины.Добавить(ПричинаАннулированияДубля());
	Возврат Причины;

КонецФункции

// Причина для лишнего экземпляра документа: ее шлет и регламент аннулирования лишних экземпляров.
Функция ПричинаАннулированияДубля() Экспорт
	Возврат "Ошибочно создан повторный экземпляр документа (дубль отправки)";
КонецФункции

// Отправить контрагенту предложение об аннулировании экземпляра документа у оператора.
// ИдКарточки - идентификатор экземпляра у оператора (строка истории отправок).
// Возврат: Структура (Успех, Текст).
Функция ПредложитьАннулирование(Знач ИдКарточки, Знач Причина, Знач Документ = Неопределено) Экспорт

	Итог = Новый Структура("Успех, Текст", Ложь, "");
	ИдКарточки = СокрЛП(ИдКарточки);
	Причина = СокрЛП(Причина);
	Если НЕ ЗначениеЗаполнено(ИдКарточки) ИЛИ НЕ ЗначениеЗаполнено(Причина) Тогда
		Итог.Текст = "Не указан экземпляр документа или причина аннулирования.";
		Возврат Итог;
	КонецЕсли;

	Попытка
		Организация = ОрганизацияДокумента(Документ);
		Подписант = ПодписантДляОператора(Организация);
		Тело = Новый Структура("reason, signer", Причина,
			Новый Структура("person, position", Подписант.ФИО, Подписант.Должность));
		Ответ = ЗапросКОператоруЭДО("PUT", "/public/api/v3/documents/" + ИдКарточки + "/cancellation", СтрокаJSON(Тело), Организация);
		Если Ответ.Код <> 200 Тогда
			Итог.Текст = "Платформа не приняла предложение об аннулировании: HTTP " + Ответ.Код + " " + Лев(Ответ.Текст, 300);
			Возврат Итог;
		КонецЕсли;
		ИдПОА = ЭДО_Регламенты.ИдентификаторСтрокой(ПрочитатьОтветJSON(Ответ.Текст).Получить("id"));

		Подписание = ПодписатьДокументОператора(ИдПОА, Организация);
		Если НЕ Подписание.Успех Тогда
			Итог.Текст = "Предложение об аннулировании создано (ид " + ИдПОА + "), но не подписано: " + Подписание.Текст
				+ " Контрагенту оно не уйдет, пока не будет подписано.";
			Возврат Итог;
		КонецЕсли;
	Исключение
		Итог.Текст = "Аннулирование не отправлено: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Итог;
	КонецПопытки;

	Итог.Успех = Истина;
	Итог.Текст = "Предложение об аннулировании отправлено контрагенту (ид " + ИдПОА + ")."
		+ " Документ будет аннулирован, когда контрагент его подтвердит.";
	Возврат Итог;

КонецФункции

// Ответить на входящие запросы аннулирования по документу базы.
// Принять = Истина - подписываем ПОА контрагента, документ аннулируется.
// Принять = Ложь - отказ универсальным сообщением, Причина обязательна.
// Возврат: Структура (Успех, Текст).
Функция ОтветитьНаЗапросАннулирования(Знач Ссылка, Знач Принять, Знач Причина = "") Экспорт

	Итог = Новый Структура("Успех, Текст", Ложь, "");
	Причина = СокрЛП(Причина);
	Если НЕ Принять И НЕ ЗначениеЗаполнено(Причина) Тогда
		Итог.Текст = "Для отказа нужна причина: ее прочитает контрагент.";
		Возврат Итог;
	КонецЕсли;

	Попытка
		Организация = ОрганизацияДокумента(Ссылка);
		Открытые = Новый Массив;
		Для Каждого Предложение Из ЭДО_Сторожа.ВходящиеПредложенияАннулирования(, Организация) Цикл
			Если Предложение.Статус = "SENT" И Предложение.Ссылка = Ссылка Тогда
				Открытые.Добавить(Предложение);
			КонецЕсли;
		КонецЦикла;
		Если Открытые.Количество() = 0 Тогда
			Итог.Текст = "Открытых запросов на аннулирование по документу у оператора нет: на них уже ответили.";
			ЗаписатьСвойствоОбъекта(Ссылка, СвойствоОбъектов("ЭДО_ЗапросАннулирования"), "");
			Возврат Итог;
		КонецЕсли;

		Подписант = ПодписантДляОператора(Организация);
		НашГид = ГидОрганизации(Организация);
		Ошибки = Новый Массив;
		Для Каждого Предложение Из Открытые Цикл
			Если Принять Тогда
				Подписание = ПодписатьДокументОператора(Предложение.ИдПОА, Организация);
				Если НЕ Подписание.Успех Тогда
					Ошибки.Добавить(Предложение.ИдПОА + ": " + Подписание.Текст);
				КонецЕсли;
			Иначе
				Тело = Новый Структура("sender, recipient, status, description, senderPerson",
					Новый Структура("id", НашГид), Новый Структура("id", Предложение.Отправитель),
					"REJECTION", Причина, Подписант.ФИО);
				Ответ = ЗапросКОператоруЭДО("POST", "/public/api/v3/documents/" + Предложение.ИдПОА + "/universal-message", СтрокаJSON(Тело), Организация);
				Если Ответ.Код <> 200 И Ответ.Код <> 201 Тогда
					Ошибки.Добавить(Предложение.ИдПОА + ": HTTP " + Ответ.Код + " " + Лев(Ответ.Текст, 200));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Итог.Текст = "Ответ не отправлен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Итог;
	КонецПопытки;

	Если Ошибки.Количество() > 0 Тогда
		Итог.Текст = "Ответ отправлен не по всем запросам: " + СтрСоединить(Ошибки, "; ");
		Возврат Итог;
	КонецЕсли;

	ЗаписатьСвойствоОбъекта(Ссылка, СвойствоОбъектов("ЭДО_ЗапросАннулирования"), "");
	Итог.Успех = Истина;
	Итог.Текст = ?(Принять, "Аннулирование принято", "Отказ в аннулировании отправлен")
		+ ?(Открытые.Количество() > 1, " по " + Открытые.Количество() + " запросам", "") + ".";
	Возврат Итог;

КонецФункции

// ФИО подписанта из сертификата, как берет их и обработка вендора; должность и МЧД -
// из учетной записи организации.
Функция ПодписантДляОператора(Знач Организация = Неопределено)

	Запись = ОбязательнаяУчетнаяЗаписьЭДО(Организация);
	Сертификат = СертификатПодписанта(Запись.Организация);
	Если Сертификат = Неопределено Тогда
		ВызватьИсключение "сертификат подписанта не найден в хранилище сервера";
	КонецЕсли;
	Субъект = Сертификат.Субъект;
	ИмяОтчество = СтрРазделить(ПолеСубъектаСертификата(Субъект, "GN"), " ", Ложь);
	ФИО = Новый Структура("first, last, middle",
		?(ИмяОтчество.Количество() > 0, ИмяОтчество[0], ""),
		ПолеСубъектаСертификата(Субъект, "SN"),
		?(ИмяОтчество.Количество() > 1, ИмяОтчество[1], ""));
	Должность = Запись.ДолжностьПодписанта;
	Если НЕ ЗначениеЗаполнено(Должность) Тогда
		Должность = ПолеСубъектаСертификата(Субъект, "T");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Должность) Тогда
		Должность = ?(Запись.ТипПодписанта = "ФЛ", "Уполномоченное физическое лицо", "Индивидуальный предприниматель");
	КонецЕсли;

	Подписант = Новый Структура("ФИО, Должность, НомерМЧД, ДатаМЧД", ФИО, Должность, "", Дата(1, 1, 1));
	Если Запись.ТипПодписанта = "ФЛ" Тогда
		Подписант.НомерМЧД = Запись.НомерМЧД;
		Подписант.ДатаМЧД = Запись.ДатаМЧД;
	КонецЕсли;
	Возврат Подписант;

КонецФункции

// Подписать документ, созданный оператором (ПОА, ответ): скачать содержимое, подписать КЭП
// сервера и присоединить подпись. Возврат: Структура (Успех, Текст).
// Принять входящее предложение об аннулировании: подписать ПОА нашей КЭП.
// Возврат: Структура (Успех, Текст).
Функция ПринятьПредложениеАннулирования(Знач ИдПОА, Знач Организация = Неопределено) Экспорт

	Возврат ПодписатьДокументОператора(ИдПОА, Организация);

КонецФункции

Функция ПодписатьДокументОператора(Знач ИдДокумента, Знач Организация = Неопределено)

	Итог = Новый Структура("Успех, Текст", Ложь, "");
	Содержимое = ЗапросКОператоруЭДО("GET", "/public/api/v3/documents/" + ИдДокумента + "/content", , Организация);
	Если Содержимое.Код <> 200 Тогда
		Итог.Текст = "содержимое не получено, HTTP " + Содержимое.Код;
		Возврат Итог;
	КонецЕсли;
	Подпись = ПодписатьДанные(Содержимое.Данные, Организация);
	Если Подпись = Неопределено Тогда
		Итог.Текст = "подпись КЭП на сервере не удалась";
		Возврат Итог;
	КонецЕсли;
	Тело = ТелоПодписиДокумента(Подпись, Организация);
	Ответ = ЗапросКОператоруЭДО("PUT", "/public/api/v4/documents/" + ИдДокумента + "/signature", Тело, Организация);
	Если Ответ.Код <> 200 Тогда
		Итог.Текст = "подпись не принята, HTTP " + Ответ.Код + " " + Лев(Ответ.Текст, 200);
		Возврат Итог;
	КонецЕсли;
	Итог.Успех = Истина;
	Возврат Итог;

КонецФункции

// Запрос к сервису документов оператора с одним перевыпуском токена на 401.
// Возврат: Структура (Код, Текст, Данные).
Функция ЗапросКОператоруЭДО(Знач Метод, Знач Путь, Знач Тело = Неопределено, Знач Организация = Неопределено)

	Итог = Новый Структура("Код, Текст, Данные", 0, "", Неопределено);
	ОбязательнаяУчетнаяЗаписьЭДО(Организация);
	Если НЕ ОбеспечитьТокен(Ложь, Организация) Тогда
		ВызватьИсключение "не удалось получить токен авторизации";
	КонецЕсли;
	Для НомерПопытки = 1 По 2 Цикл
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("accept", "application/json;charset=UTF-8");
		Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));
		Если Тело <> Неопределено Тогда
			Заголовки.Вставить("Content-Type", "application/json;charset=UTF-8");
		КонецЕсли;
		Запрос = Новый HTTPЗапрос(ПутьСервиса("document") + Путь, Заголовки);
		Если Тело <> Неопределено Тогда
			Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		КонецЕсли;
		Ответ = СоединениеСОператором(30).ВызватьHTTPМетод(Метод, Запрос);
		Если Ответ.КодСостояния = 401 И НомерПопытки = 1 Тогда
			ОбеспечитьТокен(Истина, Организация);
			Продолжить;
		КонецЕсли;
		Итог.Код = Ответ.КодСостояния;
		Итог.Данные = Ответ.ПолучитьТелоКакДвоичныеДанные();
		Итог.Текст = Ответ.ПолучитьТелоКакСтроку("UTF-8");
		Прервать;
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Тело PUT signature. Подписант-физлицо передает номер МЧД рядом с подписью: оператор
// отдает его получателю и при прямом обмене, и в роуминге.
Функция ТелоПодписиДокумента(Знач Подпись, Знач Организация = Неопределено)

	Тело = Новый Структура("value", ОчиститьBase64(Base64Строка(Подпись)));
	Запись = УчетнаяЗаписьЭДО(Организация);
	Если Запись <> Неопределено И Запись.ТипПодписанта = "ФЛ" И ЗначениеЗаполнено(Запись.НомерМЧД) Тогда
		Тело.Вставить("poa", Новый Структура("number", Запись.НомерМЧД));
	КонецЕсли;
	Возврат СтрокаJSON(Тело);

КонецФункции

Функция СтрокаJSON(Знач Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

Функция ПрочитатьОтветJSON(Знач Текст)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Значение = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Значение;

КонецФункции

#КонецОбласти

#Область ИсправлениеУПД

// Исправительный УПД (ИУПД) к экземпляру, уже отправленному через оператора. Отдельного типа
// у оператора нет: это тот же титул ON_NSCHFDOPPR с узлом ИспрДок, номер и дата счета-фактуры
// исходные. Документ исправления в базе не создается: состав берется из текущей реализации,
// номер и дата исправления задаются при отправке.
// ИдИсходногоЭкземпляра - карточка у оператора, которую исправляем: по ней сверяются номер и дата
// счета-фактуры и заполняется ИмяФайлИспрПрод.
// Возврат: Структура (Ссылка, Успех, Заголовок, Текст, ИдДокумента).
Функция ОтправитьИУПД(Знач Ссылка, Знач НомерИсправления, Знач ДатаИсправления,
	Знач ИдИсходногоЭкземпляра = "") Экспорт

	Итог = Новый Структура("Ссылка, Успех, Заголовок, Текст, ИдДокумента",
		Ссылка, Ложь, "Исправление не отправлено", "", "");

	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Итог.Текст = "Исправительный УПД отправляется только по реализации товаров и услуг";
		Возврат Итог;
	КонецЕсли;

	СвойствоСтатус = СвойствоОбъектов("ЭДО_КодСостояния");
	Если СвойствоСтатус <> Неопределено И НЕ СвойствоСтатус.Пустая() Тогда
		ТекущийСтатус = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Ссылка, СвойствоСтатус)));
		Если ТекущийСтатус = "1" ИЛИ ТекущийСтатус = "10" Тогда
			Итог.Текст = "Документ сейчас в отправке, либо отправка прервана и состояние у оператора"
				+ " неизвестно: сначала дождитесь ее завершения или разберите ее";
			Возврат Итог;
		КонецЕсли;
	КонецЕсли;

	// Дата начала работы с оператором исправлению не помеха: исправляется экземпляр,
	// уже ушедший через этого оператора, и решение принимает человек.
	Разрешения = НовыеРазрешенияОператора();
	Разрешения.ОтправитьРаньшеДатыНачала = Истина;
	Готовность = ПроверитьГотовностьКОтправке(Ссылка, Разрешения);
	Если НЕ Готовность.Готов Тогда
		Итог.Текст = Готовность.Причина;
		Возврат Итог;
	КонецЕсли;

	Организация = ОрганизацияДокумента(Ссылка);
	ИдСозданного = "";
	Исправление = Неопределено;

	Попытка

		Если НЕ ОбеспечитьТокен(Ложь, Организация) Тогда
			Итог.Текст = "Не удалось получить токен авторизации (КЭП на сервере/подпись)";
			Возврат Итог;
		КонецЕсли;

		Исправление = ИсправлениеУПД(Ссылка, НомерИсправления, ДатаИсправления, ИдИсходногоЭкземпляра);
		Если ЗначениеЗаполнено(Исправление.Ошибка) Тогда
			Итог.Текст = Исправление.Ошибка;
			Возврат Итог;
		КонецЕсли;

		Контекст = НовыйКонтекстПрогона();
		Контекст.Вставить("ЗапросКОператоруУшел", Ложь);
		ОбеспечитьФИОИП(Ссылка.Контрагент, Контекст);
		Подготовка = ПодготовитьДокументИФЛК(Ссылка, Контекст, Исправление);
		Если Подготовка.Статус = "НуженТокен" И ОбеспечитьТокен(Истина, Организация) Тогда
			Подготовка = ПодготовитьДокументИФЛК(Ссылка, Контекст, Исправление);
		КонецЕсли;
		Если Подготовка.Статус <> "ОК" Тогда
			Итог.Текст = ?(Подготовка.Статус = "НуженТокен",
				"Не удалось авторизоваться (401 после перевыпуска токена)", Подготовка.Сообщение);
			Возврат Итог;
		КонецЕсли;

		// С этой строки исправление создано у оператора: id фиксируется сразу, как в ОтправитьПоЭДО.
		ИдСозданного = Подготовка.ИдДокумента;
		Итог.ИдДокумента = ИдСозданного;
		ЗаписатьСтатусЭДО(Ссылка, 20, ИдСозданного);

		ПодписьДокумента = ПодписатьДанные(Подготовка.ДвоичныеXML, Организация);
		Если ПодписьДокумента = Неопределено Тогда
			Итог.Текст = "Исправление создано у оператора (карточка " + ИдСозданного
				+ "), но не подписано КЭП: завершить или удалить вручную";
			Возврат Итог;
		КонецЕсли;

		Присоединение = ПрисоединитьПодписьИЗаписать(Ссылка, ИдСозданного, ПодписьДокумента);
		Если Присоединение.Статус = "НуженТокен" И ОбеспечитьТокен(Истина, Организация) Тогда
			Присоединение = ПрисоединитьПодписьИЗаписать(Ссылка, ИдСозданного, ПодписьДокумента);
		КонецЕсли;
		Если Присоединение.Статус <> "Отправлен" Тогда
			Итог.Текст = ?(Присоединение.Статус = "НуженТокен",
				"Не удалось авторизоваться при присоединении подписи", Присоединение.Сообщение)
				+ " (карточка " + ИдСозданного + ")";
			Возврат Итог;
		КонецЕсли;

	Исключение
		Ошибка = ИнформацияОбОшибке();
		Итог.Заголовок = "Ошибка отправки исправления";
		Итог.Текст = ТекстПричиныОшибки(Ошибка)
			+ ?(ЗначениеЗаполнено(ИдСозданного), ". Исправление уже создано у оператора (карточка "
				+ ИдСозданного + ")", "");
		ЗаписьЖурналаРегистрации("ЭДО.ИУПД", УровеньЖурналаРегистрации.Ошибка, , Ссылка,
			Итог.Текст + Символы.ПС + ПодробноеПредставлениеОшибки(Ошибка));
		Возврат Итог;
	КонецПопытки;

	ЗаписатьВЖурналОтправку(Ссылка, ИдСозданного);
	ЗаписатьЧитаемыйСтатус(Ссылка, "Отправляется");

	Итог.Успех = Истина;
	Итог.Заголовок = "Исправление отправлено";
	Итог.Текст = "Исправление N " + Формат(Исправление.НомерИсправления, "ЧГ=0") + " от "
		+ Формат(Исправление.ДатаИсправления, "ДФ=dd.MM.yyyy") + " отправлено (карточка "
		+ ИдСозданного + ")";
	ЗаписьЖурналаРегистрации("ЭДО.ИУПД", УровеньЖурналаРегистрации.Информация, , Ссылка,
		Итог.Текст + ?(ЗначениеЗаполнено(ИдИсходногоЭкземпляра),
			", исправляемый экземпляр " + СокрЛП(ИдИсходногоЭкземпляра), ""));

	Возврат Итог;

КонецФункции

// XML исправительного УПД без отправки: от оператора читается только исходный экземпляр.
// Для проверки перед отправкой. Возврат - как у СформироватьXMLДокумента.
Функция СформироватьИУПД(Знач Ссылка, Знач НомерИсправления, Знач ДатаИсправления,
	Знач ИдИсходногоЭкземпляра = "", Контекст = Неопределено) Экспорт

	Исправление = ИсправлениеУПД(Ссылка, НомерИсправления, ДатаИсправления, ИдИсходногоЭкземпляра);
	Если ЗначениеЗаполнено(Исправление.Ошибка) Тогда
		Возврат Новый Структура("Статус, ТекстXML, Сообщение", "ОшибкаФормирования", "", Исправление.Ошибка);
	КонецЕсли;

	Возврат СформироватьXMLДокумента(Ссылка, Контекст, Исправление);

КонецФункции

// Параметры исправления для XML: номер и дата исправления, а при известном исходном экземпляре
// его имя файла и реквизиты счета-фактуры. Ошибка - пустая строка, если параметры годны.
Функция ИсправлениеУПД(Знач Ссылка, Знач НомерИсправления, Знач ДатаИсправления,
	Знач ИдИсходногоЭкземпляра = "") Экспорт

	Исправление = Новый Структура("НомерИсправления, ДатаИсправления, ИмяФайлаИсходного,"
		+ " НомерДокИсходного, ДатаДокИсходного, Ошибка", 0, Дата(1, 1, 1), "", "", "", "");

	Если ТипЗнч(НомерИсправления) <> Тип("Число") Тогда
		Исправление.Ошибка = "Номер исправления - целое число от 1 до 999";
		Возврат Исправление;
	КонецЕсли;
	Если НомерИсправления <> Цел(НомерИсправления) ИЛИ НомерИсправления < 1 ИЛИ НомерИсправления > 999 Тогда
		Исправление.Ошибка = "Номер исправления - целое число от 1 до 999";
		Возврат Исправление;
	КонецЕсли;
	Если ТипЗнч(ДатаИсправления) <> Тип("Дата") ИЛИ НЕ ЗначениеЗаполнено(ДатаИсправления) Тогда
		Исправление.Ошибка = "Не указана дата исправления";
		Возврат Исправление;
	КонецЕсли;
	Если НачалоДня(ДатаИсправления) < НачалоДня(Ссылка.Дата) Тогда
		Исправление.Ошибка = "Дата исправления " + Формат(ДатаИсправления, "ДФ=dd.MM.yyyy")
			+ " раньше даты документа " + Формат(Ссылка.Дата, "ДФ=dd.MM.yyyy");
		Возврат Исправление;
	КонецЕсли;
	Исправление.НомерИсправления = НомерИсправления;
	Исправление.ДатаИсправления = НачалоДня(ДатаИсправления);

	ИдИсходного = СокрЛП(Строка(ИдИсходногоЭкземпляра));
	Если НЕ ЗначениеЗаполнено(ИдИсходного) Тогда
		Возврат Исправление;
	КонецЕсли;

	Содержимое = ЗапросКОператоруЭДО("GET", "/public/api/v3/documents/" + ИдИсходного + "/content", ,
		ОрганизацияДокумента(Ссылка));
	Если Содержимое.Код <> 200 ИЛИ Содержимое.Данные = Неопределено Тогда
		Исправление.Ошибка = "Содержимое исправляемого экземпляра " + ИдИсходного
			+ " не получено от оператора, HTTP " + Формат(Содержимое.Код, "ЧГ=0");
		Возврат Исправление;
	КонецЕсли;
	ТекстИсходного = ПолучитьСтрокуИзДвоичныхДанных(Содержимое.Данные, "windows-1251");
	Если ПозицияНачалаТега(ТекстИсходного, "СвСчФакт") = 0 Тогда
		Исправление.Ошибка = "Экземпляр " + ИдИсходного + " не является УПД: в нем нет узла СвСчФакт";
		Возврат Исправление;
	КонецЕсли;

	Исправление.НомерДокИсходного = ЗначениеАтрибутаXML(ТекстИсходного, "СвСчФакт", "НомерДок");
	Исправление.ДатаДокИсходного = ЗначениеАтрибутаXML(ТекстИсходного, "СвСчФакт", "ДатаДок");
	// Исправление исправления ссылается на начальный файл, а не на предыдущее исправление.
	Если ПозицияНачалаТега(ТекстИсходного, "ИспрДок") > 0 Тогда
		Исправление.ИмяФайлаИсходного = ЗначениеАтрибутаXML(ТекстИсходного, "СвСчФакт", "ИмяФайлИспрПрод");
	Иначе
		Исправление.ИмяФайлаИсходного = ЗначениеАтрибутаXML(ТекстИсходного, "Файл", "ИдФайл");
	КонецЕсли;

	Возврат Исправление;

КонецФункции

// Вставляет в титул продавца узел ИспрДок первым в СвСчФакт и атрибут ИмяФайлИспрПрод.
// Номер и дата счета-фактуры в ИУПД обязаны совпадать с исправляемым экземпляром, иначе
// Честный знак примет его за новый документ.
// Возврат: Структура (Текст, Ошибка).
Функция ДополнитьИсправлением(Знач Текст, Знач Исправление)

	Итог = Новый Структура("Текст, Ошибка", Текст, "");

	Начало = ПозицияНачалаТега(Текст, "СвСчФакт");
	Если Начало = 0 Тогда
		Итог.Ошибка = "В сформированном XML нет узла СвСчФакт";
		Возврат Итог;
	КонецЕсли;
	Если ПозицияНачалаТега(Текст, "ИспрДок") > 0 Тогда
		Итог.Ошибка = "В сформированном XML узел ИспрДок уже есть";
		Возврат Итог;
	КонецЕсли;
	ДлинаТега = СтрНайти(Сред(Текст, Начало), ">");
	Открывающий = Сред(Текст, Начало, ДлинаТега);
	Если ДлинаТега = 0 ИЛИ Прав(Открывающий, 2) = "/>" Тогда
		Итог.Ошибка = "В сформированном XML узел СвСчФакт пуст или не закрыт";
		Возврат Итог;
	КонецЕсли;

	НомерДок = ЗначениеАтрибутаXML(Текст, "СвСчФакт", "НомерДок");
	ДатаДок = ЗначениеАтрибутаXML(Текст, "СвСчФакт", "ДатаДок");
	Если ЗначениеЗаполнено(Исправление.НомерДокИсходного)
		И (СокрЛП(НомерДок) <> СокрЛП(Исправление.НомерДокИсходного)
			ИЛИ СокрЛП(ДатаДок) <> СокрЛП(Исправление.ДатаДокИсходного)) Тогда
		Итог.Ошибка = "Счет-фактура в исправлении (" + НомерДок + " от " + ДатаДок
			+ ") не совпадает с исправляемым экземпляром (" + Исправление.НомерДокИсходного + " от "
			+ Исправление.ДатаДокИсходного + "): номер и дата должны остаться прежними";
		Возврат Итог;
	КонецЕсли;

	Если ЗначениеЗаполнено(Исправление.ИмяФайлаИсходного)
		И НЕ ЗначениеЗаполнено(ЗначениеАтрибутаXML(Текст, "СвСчФакт", "ИмяФайлИспрПрод")) Тогда
		Открывающий = Лев(Открывающий, ДлинаТега - 1) + " ИмяФайлИспрПрод="""
			+ ЭкранироватьАтрибутXML(Исправление.ИмяФайлаИсходного) + """>";
	КонецЕсли;
	УзелИсправления = "<ИспрДок НомИспр=""" + Формат(Исправление.НомерИсправления, "ЧГ=0")
		+ """ ДатаИспр=""" + Формат(Исправление.ДатаИсправления, "ДФ=dd.MM.yyyy") + """/>";

	Итог.Текст = Лев(Текст, Начало - 1) + Открывающий + УзелИсправления + Сред(Текст, Начало + ДлинаТега);
	Возврат Итог;

КонецФункции

// Позиция "<ИмяТега" начала элемента, 0 - если его нет. Теги, имя которых лишь начинается так же, пропускаются.
Функция ПозицияНачалаТега(Знач Текст, Знач ИмяТега)

	Маркер = "<" + ИмяТега;
	Смещение = 0;
	Остаток = Текст;
	Пока Истина Цикл
		Позиция = СтрНайти(Остаток, Маркер);
		Если Позиция = 0 Тогда
			Возврат 0;
		КонецЕсли;
		Следующий = Сред(Остаток, Позиция + СтрДлина(Маркер), 1);
		Если Следующий = ">" ИЛИ Следующий = "/" ИЛИ ПустаяСтрока(Следующий) Тогда
			Возврат Смещение + Позиция;
		КонецЕсли;
		Смещение = Смещение + Позиция;
		Остаток = Сред(Остаток, Позиция + 1);
	КонецЦикла;

	Возврат 0;

КонецФункции

// Значение атрибута первого элемента ИмяТега; пустая строка, если элемента или атрибута нет.
Функция ЗначениеАтрибутаXML(Знач Текст, Знач ИмяТега, Знач ИмяАтрибута)

	Начало = ПозицияНачалаТега(Текст, ИмяТега);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;
	Тег = Сред(Текст, Начало, СтрНайти(Сред(Текст, Начало), ">"));
	Тег = СтрЗаменить(СтрЗаменить(СтрЗаменить(Тег, Символы.ПС, " "), Символы.Таб, " "), Символы.ВК, " ");
	Маркер = " " + ИмяАтрибута + "=""";
	Позиция = СтрНайти(Тег, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Тег, Позиция + СтрДлина(Маркер));
	Значение = Лев(Хвост, СтрНайти(Хвост, """") - 1);
	Значение = СтрЗаменить(СтрЗаменить(СтрЗаменить(Значение, "&quot;", """"), "&lt;", "<"), "&gt;", ">");
	Возврат СтрЗаменить(Значение, "&amp;", "&");

КонецФункции

Функция ЭкранироватьАтрибутXML(Знач Значение)

	Значение = СтрЗаменить(Значение, "&", "&amp;");
	Значение = СтрЗаменить(Значение, "<", "&lt;");
	Значение = СтрЗаменить(Значение, ">", "&gt;");
	Возврат СтрЗаменить(Значение, """", "&quot;");

КонецФункции

#КонецОбласти

#Область ВходящиеУПД

// Автоматическое принятие входящих УПД: титул покупателя подписывается без участия человека,
// документ в базе не создается. Принимаются только УПД продавцов, у которых есть карточка
// контрагента с флагом ЭДО_АвтоматическоеПринятиеУПД. Флаг ищется по ИНН: на один ИНН
// бывает несколько карточек. Общий выключатель - настройка АвтоматическоеПринятиеУПД.

// Точка входа регламента. ТолькоПроверка - посчитать, что было бы принято, ничего не подписывая.
// Возврат: Строка - свод для журнала.
Функция ВыполнитьАвтоматическоеПринятиеУПД(Знач ТолькоПроверка = Ложь) Экспорт

	Попытка
		Результат = ПринятьВходящиеУПД(ТолькоПроверка);
	Исключение
		Результат = "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Результат), "ОШИБКА") > 0,
		"ЭДО.Регламент.АвтоматическоеПринятиеУПД");
	Возврат Результат;

КонецФункции

Функция ПринятьВходящиеУПД(Знач ТолькоПроверка)

	// Сухой прогон считает и при выключенной настройке: по нему решают, включать ли ее.
	Включено = (Число(НастройкаЭДО("АвтоматическоеПринятиеУПД")) = 1);
	Если НЕ Включено И НЕ ТолькоПроверка Тогда
		Возврат "ЭДО, принятие входящих УПД: выключено настройкой";
	КонецЕсли;

	Доверенные = ИННКонтрагентовСАвтоматическимПринятием();
	Если Доверенные.Количество() = 0 И НЕ ТолькоПроверка Тогда
		Возврат "ЭДО, принятие входящих УПД: нет контрагентов с флагом ЭДО_АвтоматическоеПринятиеУПД";
	КонецЕсли;
	// Режим «по сверке» (issue #20): у доверенного продавца, у которого включён ЕЩЁ и этот
	// флаг, принятие не «слепое» - перед подписью ищем поступление в базе и сверяем суммы,
	// см. СверитьВходящийУПД. Без базового флага АвтоматическоеПринятиеУПД этот флаг сам
	// по себе ничего не даёт - документ и так не дойдёт до сверки.
	СоСверкой = ИННКонтрагентовСАвтоматическимПринятием("ЭДО_СверкаПередПринятиемУПД");

	Принято = Новый Массив;
	Ошибки = Новый Массив;
	НеСошлось = Новый Массив;
	НеДоверенных = 0;
	ЖдутОтвета = 0;
	Предел = 50;
	// Один пользователь кабинета может видеть входящие нескольких наших организаций:
	// документ относится к той, чей ИНН стоит покупателем, и берется один раз.
	Просмотренные = Новый Соответствие;
	Записи = УчетныеЗаписиЭДО();

	Для Каждого Запись Из Записи Цикл
		Организация = Запись.Организация;
		ИННОрганизации = СокрЛП(Организация.ИНН);
		Попытка
			Входящие = ВходящиеУПДБезОтвета(ГлубинаДнейПринятияУПД(), Организация);
		Исключение
			Ошибки.Добавить(Строка(Организация) + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;
		Подписант = Неопределено;

		Для Каждого Входящий Из Входящие Цикл
			Если Просмотренные.Получить(Входящий.Ид) <> Неопределено
				ИЛИ (ЗначениеЗаполнено(Входящий.ИННПокупателя) И Входящий.ИННПокупателя <> ИННОрганизации) Тогда
				Продолжить;
			КонецЕсли;
			Просмотренные.Вставить(Входящий.Ид, Истина);
			ЖдутОтвета = ЖдутОтвета + 1;

			Если Доверенные.Получить(Входящий.ИННПродавца) = Неопределено Тогда
				НеДоверенных = НеДоверенных + 1;
				Продолжить;
			КонецЕсли;
			Если Принято.Количество() + Ошибки.Количество() + НеСошлось.Количество() >= Предел Тогда
				Прервать;
			КонецЕсли;

			Описание = Входящий.Номер + " от " + Входящий.Дата + ", " + Входящий.Продавец
				+ " -> " + Строка(Организация) + " (ид " + Входящий.Ид + ")";

			// Режим по сверке считается и в сухом прогоне: он должен показывать, что сошлось бы.
			ТребуетсяСверка = (СоСверкой.Получить(Входящий.ИННПродавца) <> Неопределено);
			СверкаРезультат = Неопределено;
			Если ТребуетсяСверка Тогда
				Попытка
					СверкаРезультат = СверитьВходящийУПД(Входящий, Организация);
				Исключение
					СверкаРезультат = Новый Структура("Сошлось, Причина, Поступление", Ложь,
						"сверка не выполнена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Неопределено);
				КонецПопытки;
				Если НЕ СверкаРезультат.Сошлось Тогда
					НеСошлось.Добавить(Описание + ": " + СверкаРезультат.Причина);
					Продолжить;
				КонецЕсли;
			КонецЕсли;

			Если ТолькоПроверка Тогда
				Если ТребуетсяСверка Тогда
					Принято.Добавить(Описание + " (по сверке с " + Строка(СверкаРезультат.Поступление) + ")");
				Иначе
					Принято.Добавить(Описание);
				КонецЕсли;
				Продолжить;
			КонецЕсли;

			Попытка
				Если Подписант = Неопределено Тогда
					Подписант = ПодписантДляОператора(Организация);
				КонецЕсли;
				Итог = ПринятьВходящийУПД(Входящий, Подписант, Организация);
			Исключение
				Итог = Новый Структура("Успех, Текст", Ложь, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
			Если Итог.Успех Тогда
				Если ТребуетсяСверка Тогда
					Принято.Добавить(Описание + " (по сверке с " + Строка(СверкаРезультат.Поступление) + ")");
				Иначе
					Принято.Добавить(Описание);
				КонецЕсли;
			Иначе
				Ошибки.Добавить(Описание + ": " + Итог.Текст);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Текст = "ЭДО, принятие входящих УПД" + ?(ТолькоПроверка, " (сухой прогон"
		+ ?(Включено, "", ", настройка выключена") + ")", "")
		+ ": организаций " + Формат(Записи.Количество(), "ЧН=0; ЧГ=0")
		+ ", ИНН с флагом " + Формат(Доверенные.Количество(), "ЧН=0; ЧГ=0")
		+ ", ждут ответа " + Формат(ЖдутОтвета, "ЧН=0; ЧГ=0")
		+ ", " + ?(ТолькоПроверка, "к принятию ", "принято ") + Формат(Принято.Количество(), "ЧН=0; ЧГ=0")
		+ ", продавец без флага " + Формат(НеДоверенных, "ЧН=0; ЧГ=0")
		+ ", по сверке отклонено " + Формат(НеСошлось.Количество(), "ЧН=0; ЧГ=0")
		+ ?(Ошибки.Количество() > 0, ", ОШИБКА у " + Формат(Ошибки.Количество(), "ЧН=0; ЧГ=0"), "");
	Для Каждого Строчка Из Принято Цикл
		Текст = Текст + Символы.ПС + "  " + Строчка;
	КонецЦикла;
	Для Каждого Строчка Из НеСошлось Цикл
		Текст = Текст + Символы.ПС + "  НЕ СОШЛОСЬ " + Строчка;
	КонецЦикла;
	Для Каждого Строчка Из Ошибки Цикл
		Текст = Текст + Символы.ПС + "  ОШИБКА " + Строчка;
	КонецЦикла;
	Возврат Текст;

КонецФункции

// За сколько дней назад искать входящие УПД без ответа: настройка ГлубинаДнейПринятияУПД,
// по умолчанию 14. Ноль и мусор - умолчание, потолок 90: каждый день окна - отдельный
// запрос к оператору, и год назад искать входящие незачем.
Функция ГлубинаДнейПринятияУПД()

	Глубина = НастройкаЭДО("ГлубинаДнейПринятияУПД");
	Если НЕ ЗначениеЗаполнено(Глубина) ИЛИ Глубина < 1 Тогда
		Возврат 14;
	КонецЕсли;
	Возврат Мин(Цел(Глубина), 90);

КонецФункции

// Допуск расхождения суммы УПД с суммой поступления в базе, рубли. Настройка ДопускСуммыУПД,
// по умолчанию 0.01 (копейка на округление).
Функция ДопускСуммыУПД()

	Значение = НастройкаЭДО("ДопускСуммыУПД");
	Если НЕ ЗначениеЗаполнено(Значение) ИЛИ Значение <= 0 Тогда
		Возврат 0.01;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Окно поиска поступления относительно даты УПД, месяцев назад. Настройка
// ПоискПоступленияМесяцевНазад, по умолчанию 4.
Функция ПоискПоступленияМесяцевНазад()

	Значение = НастройкаЭДО("ПоискПоступленияМесяцевНазад");
	Если НЕ ЗначениеЗаполнено(Значение) ИЛИ Значение < 0 Тогда
		Возврат 4;
	КонецЕсли;
	Возврат Цел(Значение);

КонецФункции

// Окно поиска поступления относительно даты УПД, месяцев вперёд. Настройка
// ПоискПоступленияМесяцевВперёд, по умолчанию 1.
Функция ПоискПоступленияМесяцевВперёд()

	Значение = НастройкаЭДО("ПоискПоступленияМесяцевВперёд");
	Если НЕ ЗначениеЗаполнено(Значение) ИЛИ Значение < 0 Тогда
		Возврат 1;
	КонецЕсли;
	Возврат Цел(Значение);

КонецФункции

// Возврат: Соответствие (ИНН -> Истина) контрагентов, у которых включен флаг.
// Обобщена 21.09.2026 (issue #20): параметр - имя булева свойства контрагента, чтобы тем же
// кодом собирать и ЭДО_АвтоматическоеПринятиеУПД, и ЭДО_СверкаПередПринятиемУПД.
Функция ИННКонтрагентовСАвтоматическимПринятием(Знач ИмяСвойства = "ЭДО_АвтоматическоеПринятиеУПД")

	Итог = Новый Соответствие;
	Свойство = СвойствоОбъектов(ИмяСвойства);
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат Итог;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(Значения.Объект КАК Справочник.Контрагенты).ИНН КАК ИНН,
		|	Значения.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК Значения
		|ГДЕ
		|	Значения.Свойство = &Свойство
		|	И Значения.Объект ССЫЛКА Справочник.Контрагенты");
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИНН = СокрЛП(Выборка.ИНН);
		Если ЗначениеЗаполнено(ИНН) И ФлагСвойстваВключён(Выборка.Значение) Тогда
			Итог.Вставить(ИНН, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Входящие УПД, на которые мы еще не ответили: продавец - не наша организация, статус SENT
// или DELIVERED. Счет-фактура без функции ДОП ответного титула не имеет и не берется.
// Окно режется по суткам: у выдачи оператора потолок 1000 карточек на интервал.
// Возврат: Массив структур (Ид, Номер, Дата, ИННПродавца, Продавец, ИННПокупателя, Версия).
Функция ВходящиеУПДБезОтвета(Знач ГлубинаДней, Знач Организация = Неопределено)

	Итог = Новый Массив;
	НашиИНН = Новый Соответствие;
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Орг.ИНН КАК ИНН ИЗ Справочник.Организации КАК Орг");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НашиИНН.Вставить(СокрЛП(Выборка.ИНН), Истина);
	КонецЦикла;

	Ждущие = Новый Соответствие;
	Ждущие.Вставить("SENT", Истина);
	Ждущие.Вставить("DELIVERED", Истина);

	Граница = НачалоДня(ТекущаяУниверсальнаяДата()) + 86400;
	Для НомерДня = 1 По ГлубинаДней + 1 Цикл
		НачалоОкна = Граница - 86400;
		Для Страница = 0 По 9 Цикл
			Путь = "/public/api/v3/documents?type=NEW_SELLER_TITLE"
				+ "&created_from=" + Формат(НачалоОкна, "ДФ=yyyy-MM-ddT00:00:00.000Z")
				+ "&created_till=" + Формат(Граница, "ДФ=yyyy-MM-ddT00:00:00.000Z")
				+ "&page=" + Формат(Страница, "ЧН=0; ЧГ=0") + "&page_size=100";
			Ответ = ЗапросКОператоруЭДО("GET", Путь, , Организация);
			Если Ответ.Код <> 200 Тогда
				ВызватьИсключение "список документов оператора не получен, HTTP " + Ответ.Код + " " + Лев(Ответ.Текст, 200);
			КонецЕсли;
			Карточки = ПрочитатьОтветJSON(Ответ.Текст);
			Если ТипЗнч(Карточки) <> Тип("Массив") Тогда
				Прервать;
			КонецЕсли;

			Для Каждого Карточка Из Карточки Цикл
				Счет = Карточка.Получить("invoice");
				Если ТипЗнч(Счет) <> Тип("Соответствие") Тогда
					Продолжить;
				КонецЕсли;
				Продавец = Счет.Получить("seller");
				Покупатель = Счет.Получить("buyer");
				ИННПродавца = ?(ТипЗнч(Продавец) = Тип("Соответствие"), СокрЛП(Строка(Продавец.Получить("inn"))), "");
				СтатусКарточки = Карточка.Получить("newStatus");
				Если СтатусКарточки = Неопределено Тогда
					СтатусКарточки = Карточка.Получить("status");
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ИННПродавца) ИЛИ НашиИНН.Получить(ИННПродавца) <> Неопределено
					ИЛИ Ждущие.Получить(ВРег(Строка(СтатусКарточки))) = Неопределено
					ИЛИ ВРег(Строка(Счет.Получить("function"))) = "СЧФ" Тогда
					Продолжить;
				КонецЕсли;
				Итог.Добавить(Новый Структура("Ид, Номер, Дата, ИННПродавца, Продавец, ИННПокупателя, Версия",
					ЭДО_Регламенты.ИдентификаторСтрокой(Карточка.Получить("id")),
					СокрЛП(Строка(Счет.Получить("num"))),
					СокрЛП(Строка(Счет.Получить("date"))),
					ИННПродавца,
					ПредставлениеСтороныСчета(Продавец),
					?(ТипЗнч(Покупатель) = Тип("Соответствие"), СокрЛП(Строка(Покупатель.Получить("inn"))), ""),
					СокрЛП(Строка(Карточка.Получить("version")))));
			КонецЦикла;

			Если Карточки.Количество() < 100 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Граница = НачалоОкна;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Наименование стороны из invoice: у юрлица строка, у ИП - структура из фамилии, имени, отчества.
Функция ПредставлениеСтороныСчета(Знач Сторона)

	Если ТипЗнч(Сторона) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Имя = Сторона.Получить("name");
	Если ТипЗнч(Имя) = Тип("Соответствие") Тогда
		Возврат СокрЛП(Строка(Имя.Получить("last")) + " " + Строка(Имя.Получить("first")) + " "
			+ Строка(Имя.Получить("middle")));
	КонецЕсли;
	Возврат ?(Имя = Неопределено, "ИНН " + Строка(Сторона.Получить("inn")), СокрЛП(Строка(Имя)));

КонецФункции

// Принять один входящий УПД: создать титул покупателя и подписать его.
// Титул, оставшийся неподписанным с прошлого прогона, подписывается, а второй не создается.
// Возврат: Структура (Успех, Текст).
Функция ПринятьВходящийУПД(Знач Входящий, Знач Подписант, Знач Организация = Неопределено)

	Итог = Новый Структура("Успех, Текст", Ложь, "");

	ИдТитула = "";
	Цепочка = ЗапросКОператоруЭДО("GET", "/public/api/v3/document-flows?id=" + Входящий.Ид + "&page=0&page_size=50", , Организация);
	Если Цепочка.Код = 200 Тогда
		Корни = ПрочитатьОтветJSON(Цепочка.Текст);
		Если ТипЗнч(Корни) = Тип("Массив") Тогда
			Для Каждого Корень Из Корни Цикл
				Подчиненные = Корень.Получить("slaves");
				Если ТипЗнч(Подчиненные) <> Тип("Массив") Тогда
					Продолжить;
				КонецЕсли;
				Для Каждого Подчиненный Из Подчиненные Цикл
					Если ВРег(Строка(Подчиненный.Получить("type"))) <> "ON_NSCHFDOPPOK" Тогда
						Продолжить;
					КонецЕсли;
					Если ВРег(Строка(Подчиненный.Получить("status"))) <> "NEW" Тогда
						Итог.Успех = Истина;
						Итог.Текст = "титул покупателя уже отправлен";
						Возврат Итог;
					КонецЕсли;
					ИдТитула = ЭДО_Регламенты.ИдентификаторСтрокой(Подчиненный.Получить("id"));
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ИдТитула) Тогда
		Ответ = ЗапросКОператоруЭДО("PUT", "/public/api/v3/documents/" + Входящий.Ид + "/acceptance",
			СтрокаJSON(ТелоТитулаПокупателя(Входящий.Версия, Подписант)), Организация);
		Если Ответ.Код <> 200 Тогда
			Итог.Текст = "титул покупателя не создан, HTTP " + Ответ.Код + " " + Лев(Ответ.Текст, 300);
			Возврат Итог;
		КонецЕсли;
		ИдТитула = ЭДО_Регламенты.ИдентификаторСтрокой(ПрочитатьОтветJSON(Ответ.Текст).Получить("id"));
	КонецЕсли;

	Подписание = ПодписатьДокументОператора(ИдТитула, Организация);
	Если НЕ Подписание.Успех Тогда
		Итог.Текст = "титул покупателя создан (ид " + ИдТитула + "), но не подписан: " + Подписание.Текст;
		Возврат Итог;
	КонецЕсли;

	Итог.Успех = Истина;
	Итог.Текст = "принят, титул покупателя " + ИдТитула;
	Возврат Итог;

КонецФункции

// Тело запроса acceptance. Тип титула зависит от версии формата входящего УПД.
Функция ТелоТитулаПокупателя(Знач Версия, Знач Подписант)

	Подписывающий = Новый Структура("name, signingAuthorizationMethod", Подписант.ФИО, "ELECTRONIC_SIGNATURE");
	Если ЗначениеЗаполнено(Подписант.НомерМЧД) Тогда
		Подписывающий.Вставить("poaId", Подписант.НомерМЧД);
		Подписывающий.Вставить("poaIssueDate", Формат(Подписант.ДатаМЧД, "ДФ=yyyy-MM-dd"));
		Подписывающий.signingAuthorizationMethod = "MCHD_FROM_INFORMATION_SYSTEM_WITHOUT_INFO_IN_DOCUMENT";
	КонецЕсли;
	Если Версия = "5.03" Тогда
		ТипТитула = "UtdV0503Acceptance";
	ИначеЕсли Версия = "5.02" Тогда
		ТипТитула = "UtdV0502Acceptance";
	Иначе
		ТипТитула = "UtdAcceptance";
		Подписывающий.Вставить("position", Подписант.Должность);
	КонецЕсли;

	Возврат Новый Структура("type, date, signer, details",
		ТипТитула,
		Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd"),
		Подписывающий,
		Новый Структура("acceptanceType", "ACCEPTED"));

КонецФункции

// Сверка входящего УПД с поступлением в базе (issue #20, режим «по сверке»).
// Не «слепое» принятие: скачивает содержимое УПД у оператора, ищет поступление по ИНН
// продавца и номеру документа в окне вокруг даты УПД, сравнивает суммы. Пишет результат
// в свойства найденного (единственного) поступления и всегда - в журнал сверки, независимо
// от исхода, чтобы причину отказа можно было посмотреть без повторного запроса к оператору.
// Возврат: Структура (Сошлось Булево, Поступление ссылка/Неопределено, Причина Строка,
// КраткаяПричина Строка(<=50), ОтклонениеСуммы Число, СуммаУПД Число, СуммаНДСУПД Число).
Функция СверитьВходящийУПД(Знач Входящий, Знач Организация) Экспорт

	Итог = Новый Структура("Сошлось, Поступление, Причина, КраткаяПричина, ОтклонениеСуммы, СуммаУПД, СуммаНДСУПД",
		Ложь, Неопределено, "", "", 0, 0, 0);

	Содержимое = ЗапросКОператоруЭДО("GET", "/public/api/v3/documents/" + Входящий.Ид + "/content", , Организация);
	Если Содержимое.Код <> 200 Тогда
		Итог.Причина = "содержимое УПД не получено, HTTP " + Содержимое.Код;
		Итог.КраткаяПричина = Лев(Итог.Причина, 50);
		ДобавитьЗаписьЖурналаСверкиВходящих(Входящий, Организация, Итог);
		Возврат Итог;
	КонецЕсли;

	ИтогиXML = ИтогиИзXMLУПД(Содержимое.Данные);
	Если НЕ ИтогиXML.Найдено Тогда
		Итог.Причина = "в XML УПД не найден блок ВсегоОпл";
		Итог.КраткаяПричина = Лев(Итог.Причина, 50);
		ДобавитьЗаписьЖурналаСверкиВходящих(Входящий, Организация, Итог);
		Возврат Итог;
	КонецЕсли;
	Итог.СуммаУПД = ИтогиXML.СуммаСНДС;
	Итог.СуммаНДСУПД = ИтогиXML.СуммаНДС;

	// Поиск поступления: по ИНН продавца и нормализованному номеру, в окне вокруг даты УПД.
	ДатаУПД = ДатаИзСтрокиУПД(Входящий.Дата);
	ДатаС  = ДобавитьМесяц(ДатаУПД, -ПоискПоступленияМесяцевНазад());
	ДатаПо = ДобавитьМесяц(ДатаУПД, ПоискПоступленияМесяцевВперёд());
	Кандидаты = НайтиПоступленияДляУПД(Входящий.Номер, ДатаУПД, Входящий.ИННПродавца, Организация);

	Если Кандидаты.Количество() = 0 Тогда
		Итог.Причина = "поступление не найдено: №" + Входящий.Номер + " от " + Входящий.Дата
			+ ", ИНН " + Входящий.ИННПродавца
			+ ", окно " + Формат(ДатаС, "ДФ=dd.MM.yyyy") + "–" + Формат(ДатаПо, "ДФ=dd.MM.yyyy");
		Итог.КраткаяПричина = "поступление не найдено";
		ДобавитьЗаписьЖурналаСверкиВходящих(Входящий, Организация, Итог);
		Возврат Итог;
	КонецЕсли;

	Если Кандидаты.Количество() > 1 Тогда
		Список = Новый Массив;
		Для Каждого Кандидат Из Кандидаты Цикл
			Список.Добавить(Строка(Кандидат.Ссылка));
		КонецЦикла;
		Итог.Причина = "найдено несколько поступлений: " + СтрСоединить(Список, "; ");
		Итог.КраткаяПричина = "несколько поступлений: " + Формат(Кандидаты.Количество(), "ЧГ=0");
		ДобавитьЗаписьЖурналаСверкиВходящих(Входящий, Организация, Итог);
		Возврат Итог;
	КонецЕсли;

	// Ровно один кандидат - сверяем и всегда пишем результат в его свойства.
	Кандидат = Кандидаты[0];
	Итог.Поступление = Кандидат.Ссылка;
	Отклонение = Кандидат.СуммаДокумента - Итог.СуммаУПД;
	Итог.ОтклонениеСуммы = Отклонение;

	Ошибки = Новый Массив;
	Если НЕ Кандидат.Проведен Тогда
		// Непроведённое - отдельный отказ, остальные проверки для него не имеют смысла.
		Ошибки.Добавить("поступление не проведено");
	Иначе
		Допуск = ДопускСуммыУПД();
		Если Макс(Отклонение, -Отклонение) > Допуск Тогда
			Ошибки.Добавить("сумма с НДС: в базе " + Формат(Кандидат.СуммаДокумента, "ЧДЦ=2; ЧРГ=")
				+ ", в УПД " + Формат(Итог.СуммаУПД, "ЧДЦ=2; ЧРГ=")
				+ ", разница " + Формат(Отклонение, "ЧДЦ=2; ЧРГ="));
		КонецЕсли;

		ЭтоИП = Ложь;
		Попытка
			ЭтоИП = (Организация.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо);
		Исключение
			ЭтоИП = Ложь;   // не разобрались - считаем юрлицом, сверяем НДС строже
		КонецПопытки;

		Если НЕ ЭтоИП Тогда
			СуммаНДСДок = Кандидат.Ссылка.Товары.Итог("СуммаНДС");
			Если Метаданные.Документы.ПоступлениеТоваровУслуг.ТабличныеЧасти.Найти("Услуги") <> Неопределено Тогда
				СуммаНДСДок = СуммаНДСДок + Кандидат.Ссылка.Услуги.Итог("СуммаНДС");
			КонецЕсли;
			ОтклонениеНДС = СуммаНДСДок - Итог.СуммаНДСУПД;
			Если Макс(ОтклонениеНДС, -ОтклонениеНДС) > Допуск Тогда
				Ошибки.Добавить("сумма НДС: в базе " + Формат(СуммаНДСДок, "ЧДЦ=2; ЧРГ=")
					+ ", в УПД " + Формат(Итог.СуммаНДСУПД, "ЧДЦ=2; ЧРГ="));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Итог.Сошлось = (Ошибки.Количество() = 0);
	Если НЕ Итог.Сошлось Тогда
		Итог.Причина = СтрСоединить(Ошибки, "; ");
		Итог.КраткаяПричина = Лев(Итог.Причина, 50);
	КонецЕсли;

	ЗаписатьРезультатСверкиВПоступление(Кандидат.Ссылка, Входящий.Ид, Отклонение, Итог.КраткаяПричина);
	ДобавитьЗаписьЖурналаСверкиВходящих(Входящий, Организация, Итог);
	Возврат Итог;

КонецФункции

// Поступления, подходящие под входящий УПД: организация, все карточки контрагента с ИНН
// продавца, окно дат вокруг даты УПД (настройки ПоискПоступленияМесяцевНазад/Вперёд) и
// совпадение номера входящего документа после нормализации (см. НормализованныйНомерДокумента).
// В запросе номер не сравнить - нормализация делается в коде по выборке за окно.
// Возврат: Массив структур (Ссылка, СуммаДокумента, Проведен). Экспорт - для проверки
// подбора на данных базы без обращения к оператору.
Функция НайтиПоступленияДляУПД(Знач Номер, Знач ДатаУПД, Знач ИНН, Знач Организация) Экспорт

	ДатаС  = ДобавитьМесяц(ДатаУПД, -ПоискПоступленияМесяцевНазад());
	ДатаПо = ДобавитьМесяц(ДатаУПД, ПоискПоступленияМесяцевВперёд());

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Поступление.Ссылка КАК Ссылка,
		|	Поступление.СуммаДокумента КАК СуммаДокумента,
		|	Поступление.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
		|	Поступление.Проведен КАК Проведен
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК Поступление
		|ГДЕ
		|	Поступление.Организация = &Организация
		|	И Поступление.Контрагент.ИНН = &ИНН
		|	И НЕ Поступление.ПометкаУдаления
		|	И Поступление.Дата МЕЖДУ &ДатаС И &ДатаПо");
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИНН", СокрЛП(ИНН));
	Запрос.УстановитьПараметр("ДатаС", НачалоДня(ДатаС));
	Запрос.УстановитьПараметр("ДатаПо", КонецДня(ДатаПо));

	НомерНормализован = НормализованныйНомерДокумента(Номер);
	Кандидаты = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НормализованныйНомерДокумента(Выборка.НомерВходящегоДокумента) = НомерНормализован Тогда
			Кандидаты.Добавить(Новый Структура("Ссылка, СуммаДокумента, Проведен",
				Выборка.Ссылка, Выборка.СуммаДокумента, Выборка.Проведен));
		КонецЕсли;
	КонецЦикла;
	Возврат Кандидаты;

КонецФункции

// Итоги из XML УПД (формат ФНС 5.01/5.02/5.03): сумма с НДС всего и сумма НДС всего.
// Возврат: Структура (Найдено Булево, СуммаСНДС Число, СуммаНДС Число, БезНДС Булево).
Функция ИтогиИзXMLУПД(Знач ДвоичныеДанные) Экспорт

	Итог = Новый Структура("Найдено, СуммаСНДС, СуммаНДС, БезНДС", Ложь, 0, 0, Ложь);
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат Итог;
	КонецЕсли;

	Попытка
		Поток = ДвоичныеДанные.ОткрытьПотокДляЧтения();
		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьПоток(Поток);

		Глубина = 0;
		ВВсегоОпл = Ложь;
		ГлубинаВсегоОпл = 0;
		ВСумНалВсего = Ложь;
		ГлубинаСумНалВсего = 0;
		ОжидаетсяТекстСумНал = Ложь;

		Пока Чтение.Прочитать() Цикл
			Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				Глубина = Глубина + 1;
				Если НЕ ВВсегоОпл И Чтение.Имя = "ВсегоОпл" Тогда
					ВВсегоОпл = Истина;
					ГлубинаВсегоОпл = Глубина;
					Атрибут = Чтение.ПолучитьАтрибут("СтТовУчНалВсего");
					Если ЗначениеЗаполнено(Атрибут) Тогда
						Попытка
							Итог.СуммаСНДС = Число(СтрЗаменить(Атрибут, ",", "."));
							Итог.Найдено = Истина;
						Исключение
						КонецПопытки;
					КонецЕсли;
				ИначеЕсли ВВсегоОпл И НЕ ВСумНалВсего И Чтение.Имя = "СумНалВсего" Тогда
					ВСумНалВсего = Истина;
					ГлубинаСумНалВсего = Глубина;
				ИначеЕсли ВСумНалВсего И Чтение.Имя = "СумНал" Тогда
					ОжидаетсяТекстСумНал = Истина;
				ИначеЕсли ВСумНалВсего И Чтение.Имя = "БезНДС" Тогда
					Итог.БезНДС = Истина;
					Итог.СуммаНДС = 0;
				КонецЕсли;
			ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
				Если ОжидаетсяТекстСумНал Тогда
					Попытка
						Итог.СуммаНДС = Число(СтрЗаменить(СокрЛП(Чтение.Значение), ",", "."));
					Исключение
					КонецПопытки;
				КонецЕсли;
			ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
				Если ОжидаетсяТекстСумНал И Чтение.Имя = "СумНал" Тогда
					ОжидаетсяТекстСумНал = Ложь;
				КонецЕсли;
				Если ВСумНалВсего И Глубина = ГлубинаСумНалВсего Тогда
					ВСумНалВсего = Ложь;
				КонецЕсли;
				ЗакрытоВсегоОпл = ВВсегоОпл И Глубина = ГлубинаВсегоОпл;
				Глубина = Глубина - 1;
				Если ЗакрытоВсегоОпл Тогда
					Прервать;   // нужный блок дочитан целиком, дальше не смотрим
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Чтение.Закрыть();
	Исключение
		Возврат Итог;
	КонецПопытки;

	Возврат Итог;

КонецФункции

// Номер документа без разделителей, регистра и ведущих нулей - для сравнения "1-234" с "0001234".
Функция НормализованныйНомерДокумента(Знач Номер)

	Текст = ВРег(СокрЛП(Строка(Номер)));
	Результат = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если (Символ >= "0" И Символ <= "9") ИЛИ (Символ >= "A" И Символ <= "Z")
			ИЛИ (Символ >= "А" И Символ <= "Я") Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Пока СтрДлина(Результат) > 1 И Лев(Результат, 1) = "0" Цикл
		Результат = Сред(Результат, 2);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Дата УПД из строки вида "2026-09-15" или "15.09.2026". Не разобралась - окно ищется
// от текущей даты, лучше широкое окно, чем упавший регламент.
// Переиспользует готовые разборщики модуля: ДатаИзДДММГГГГ и ДатаИзМеткиВремени (у неё дефисы
// вырезаются, поэтому "2026-09-15" без времени она понимает так же, как метку с "T").
Функция ДатаИзСтрокиУПД(Знач Текст)

	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат ТекущаяДата();
	КонецЕсли;

	Разобранная = ДатаИзДДММГГГГ(Текст);
	Если Разобранная <> '00010101' Тогда
		Возврат Разобранная;
	КонецЕсли;

	Разобранная = ДатаИзМеткиВремени(Текст);
	Если Разобранная <> '00010101' Тогда
		Возврат Разобранная;
	КонецЕсли;

	Возврат ТекущаяДата();

КонецФункции

// Записать результат сверки в свойства поступления. Свойства ищутся точным именем -
// если не заведены (старая база до ОбеспечитьСвойстваОбъектов), запись просто пропускается.
Процедура ЗаписатьРезультатСверкиВПоступление(Знач Поступление, Знач ИдВходящего, Знач Отклонение, Знач КраткаяПричина)

	СвИдентификатор = СвойствоОбъектов("ЭДО_ВходящийИдентификатор");
	Если СвИдентификатор <> Неопределено И НЕ СвИдентификатор.Пустая() Тогда
		ЗаписатьЗначениеСвойства(Поступление, СвИдентификатор, Лев(ИдВходящего, 50));
	КонецЕсли;

	СвОтклонение = СвойствоОбъектов("ЭДО_ОтклонениеСуммы");
	Если СвОтклонение <> Неопределено И НЕ СвОтклонение.Пустая() Тогда
		ЗаписатьЗначениеСвойства(Поступление, СвОтклонение, Лев(Формат(Отклонение, "ЧДЦ=2; ЧРГ="), 50));
	КонецЕсли;

	СвПричина = СвойствоОбъектов("ЭДО_ПричинаНепринятия");
	Если СвПричина <> Неопределено И НЕ СвПричина.Пустая() Тогда
		ЗаписатьЗначениеСвойства(Поступление, СвПричина, Лев(КраткаяПричина, 50));
	КонецЕсли;

КонецПроцедуры

// Журнал сверки входящих УПД: ХранилищеОбщихНастроек, тот же приём, что у ЗагрузитьРеестрАдресов -
// ключ пустого пользователя, чтобы записи не зависели от того, чей сеанс выполнил регламент.
// Ключ карты - Ид входящего у оператора, значение - Структура одной сверки. Запись при каждом
// вызове СверитьВходящийУПД перезаписывает предыдущую по тому же Ид.
// Возврат: Соответствие (Ид -> Структура(Когда, Номер, Дата, ИННПродавца, Продавец,
// Организация, Поступление, Сошлось, ОтклонениеСуммы, Причина)).
Функция ЗагрузитьЖурналСверкиВходящих() Экспорт

	Значение = ХранилищеОбщихНастроек.Загрузить("ЭДО_ЖурналСверкиВходящих", "Записи", , "");
	Если ТипЗнч(Значение) <> Тип("Соответствие") Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	// Записи старше 90 дней при загрузке отбрасываются - журнал не должен расти без предела.
	Граница = ТекущаяДата() - 90 * 86400;
	Очищенные = Новый Соответствие;
	Для Каждого КЗ Из Значение Цикл
		Попытка
			Если КЗ.Значение.Когда >= Граница Тогда
				Очищенные.Вставить(КЗ.Ключ, КЗ.Значение);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	Возврат Очищенные;

КонецФункции

Процедура ЗаписатьЖурналСверкиВходящих(Знач Записи)

	ХранилищеОбщихНастроек.Сохранить("ЭДО_ЖурналСверкиВходящих", "Записи", Записи,
		"журнал сверки входящих УПД", "");

КонецПроцедуры

// Добавить (или перезаписать по Ид) одну запись в журнал сверки. Ошибка журнала не должна
// ронять сам прогон принятия - сверка уже посчитана, журнал только для диагностики.
Процедура ДобавитьЗаписьЖурналаСверкиВходящих(Знач Входящий, Знач Организация, Знач Итог)

	Попытка
		Журнал = ЗагрузитьЖурналСверкиВходящих();
		Запись = Новый Структура(
			"Когда, Номер, Дата, ИННПродавца, Продавец, Организация, Поступление, Сошлось, ОтклонениеСуммы, Причина",
			ТекущаяДата(), Входящий.Номер, Входящий.Дата, Входящий.ИННПродавца, Входящий.Продавец,
			Строка(Организация), ?(Итог.Поступление = Неопределено, "", Строка(Итог.Поступление)),
			Итог.Сошлось, Итог.ОтклонениеСуммы, Итог.Причина);
		Журнал.Вставить(Входящий.Ид, Запись);
		ЗаписатьЖурналСверкиВходящих(Журнал);
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
