// ++ ЩА 22.10.2026 [yan], ревью Codex 940: закрепить черновик, подпись которого дошла (код 20 -> 40), только
// если документ все еще связан с этим же экземпляром. Между выборкой сторожа и записью - HTTP-запрос к оператору,
// за это время пользователь мог переотправить документ из карточки (ОтправитьВручную замок сторожа не берет)
// и получить экземпляр B; безусловная запись вернула бы A и потеряла связь с B. Проверка и запись - под той же
// исключительной блокировкой, что в ОсвободитьНеподписанныйЧерновик. Идентификатор не меняется, поэтому статус
// ЧЗ не сбрасывается; профилю - то же извещение «Отправлен», что дала бы ЗаписатьСтатусЭДО при смене кода.
// Возврат: Истина - закреплено; Ложь - код или идентификатор уже другие, строку пропустить.
Функция ЗакрепитьНеподписанныйЧерновик(Ссылка, Знач ИдДокумента) Экспорт
	СвойствоСтатус = СвойствоОбъектов("ЭДО_КодСостояния");
	СвойствоИд = СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если СвойствоСтатус = Неопределено ИЛИ СвойствоСтатус.Пустая()
		ИЛИ СвойствоИд = Неопределено ИЛИ СвойствоИд.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	Закреплено = Ложь;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.ЗначенияСвойствОбъектов");
		Элемент.УстановитьЗначение("Объект", Ссылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		Код = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Ссылка, СвойствоСтатус)));
		Ид = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Ссылка, СвойствоИд)));
		Если Код = "20" И Ид = СокрЛП(ИдДокумента) Тогда
			ЗаписатьЗначениеСвойства(Ссылка, СвойствоСтатус, 40);
			ЗапомнитьОтпечатокОтправки(Ссылка);
			Закреплено = Истина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Если Закреплено Тогда
		СообщитьПрофилюОСостоянии(Ссылка, "40", "Отправлен");
	КонецЕсли;
	Возврат Закреплено;
КонецФункции
