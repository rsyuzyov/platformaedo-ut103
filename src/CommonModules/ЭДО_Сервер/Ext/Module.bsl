////////////////////////////////////////////////////////////////////////////////
// ЭДО_Сервер - серверный слой обмена УПД через оператора "Платформа ЭДО" для УТ 10.3.
// Держит весь цикл: токен по подписи, сборку XML титула, создание документа у оператора,
// подпись и отправку, запись статуса обратно в базу.
//
// Подпись выполняется на сервере: контейнер КЭП лежит под учетной записью службы кластера,
// поэтому отправка возможна из фона и регламента. ЭДО_Клиент - фасад и запасной путь.
//
// Модуль не привилегированный: в расширении привилегированный общий модуль запрещен,
// запись идет правами пользователя.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область НастройкиРасширения

// Реестр всех настраиваемых параметров расширения: по нему строятся форма настроек
// и проверка готовности базы.
// Хранение общее (пользователь ""), иначе настройку видит только тот, кто ее задал.
Функция ОписаниеНастроекЭДО() Экспорт

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Имя");
	Т.Колонки.Добавить("Представление");
	Т.Колонки.Добавить("Тип");             // Строка | Число | Дата
	Т.Колонки.Добавить("ПоУмолчанию");
	Т.Колонки.Добавить("Обязательная");    // без неё отправка не работает
	Т.Колонки.Добавить("Подсказка");

	С = Т.Добавить();
	С.Имя = "ГлубинаДнейОтправки"; С.Тип = "Число"; С.ПоУмолчанию = 30; С.Обязательная = Ложь;
	С.Представление = "Глубина отбора, дней";
	С.Подсказка = "Второе ограничение окна. Нижняя граница = что ПОЗЖЕ: дата начала или сегодня минус эти дни.";

	С = Т.Добавить();
	С.Имя = "ЛимитДокументовЗаПрогон"; С.Тип = "Число"; С.ПоУмолчанию = 100; С.Обязательная = Ложь;
	С.Представление = "Документов за один прогон";
	С.Подсказка = "Остаток уходит следующим прогоном. Ограничивает длительность одного захода.";

	С = Т.Добавить();
	С.Имя = "ГотовыеСтатусыЗаказа"; С.Тип = "Строка";
	С.ПоУмолчанию = "Отгружена,ПереданаНаОтгрузку"; С.Обязательная = Ложь;
	С.Представление = "Статусы заказа, готовые к отправке";
	С.Подсказка = "Через запятую. ⚠️ Состав перечисления в базах РАЗНЫЙ - несуществующие имена игнорируются.";

	С = Т.Добавить();
	С.Имя = "ГлубинаДнейСинхронизацииСтатусов"; С.Тип = "Число"; С.ПоУмолчанию = 14; С.Обязательная = Ложь;
	С.Представление = "Окно синхронизации статусов, дней";
	С.Подсказка = "На сколько дней назад PEDO-StatusSync опрашивает карточки оператора.";

	С = Т.Добавить();
	С.Имя = "ТаймаутHTTPСек"; С.Тип = "Число"; С.ПоУмолчанию = 30; С.Обязательная = Ложь;
	С.Представление = "Таймаут HTTP, секунд";
	С.Подсказка = "Здоровый ответ приходит за 0,2-0,3 с. Большой таймаут в аварию множится на ретраи и вешает прогон.";

	С = Т.Добавить();
	С.Имя = "НерабочиеПрефиксыЭДО"; С.Тип = "Строка"; С.ПоУмолчанию = ""; С.Обязательная = Ложь;
	С.Представление = "Префиксы операторов, куда отправка не проходит";
	С.Подсказка = "Через запятую, например 2LT. Документы этим получателям синхронизация НЕ возвращает в очередь после отказа: причина внешняя и повтором не лечится.";

	// Отправка по готовности документа, а не по таймеру. Признак готовности добавляет профиль базы
	// точкой ПриОтбореДокументовКОтправке (у нас - отметка печати УПД), ядро проверяет только типовое.
	С = Т.Добавить();
	С.Имя = "ОтправлятьТолькоПослеГотовности"; С.Тип = "Число"; С.ПоУмолчанию = 1; С.Обязательная = Ложь;
	С.Представление = "Отправлять только готовые документы (1 - да, 0 - по таймеру)";
	С.Подсказка = "Готовым считается напечатанный документ либо помеченный вручную. 0 возвращает прежнее поведение «через N минут после проведения».";

	// Поэтапный запуск: автоматически документы уходят только отмеченным контрагентам, остальным -
	// по кнопке. По умолчанию выключено: выкатка версии поведение отправки не меняет.
	С = Т.Добавить();
	С.Имя = "АвтоотправкаТолькоРазрешенным"; С.Тип = "Число"; С.ПоУмолчанию = 0; С.Обязательная = Ложь;
	С.Представление = "Автоотправка только отмеченным контрагентам (1 - да, 0 - всем)";
	С.Подсказка = "1 - очередь берет документы только контрагентов с флагом ЭДО_АвтоотправкаРазрешена. Остальным документ уходит только по кнопке, в колонке ЭДО - «Автоотправка контрагенту не включена».";

	// Страховка для документа, который провели, но не напечатали и не пометили.
	// 0 отключает ее, и такой документ не уйдет никогда.
	С = Т.Добавить();
	С.Имя = "ДнейСтраховкиБезПометки"; С.Тип = "Число"; С.ПоУмолчанию = 3; С.Обязательная = Ложь;
	С.Представление = "Через сколько дней отправлять непомеченный документ";
	С.Подсказка = "Документ, который провели, но не напечатали и не пометили, уходит по истечении этого срока. 0 - не отправлять такие вовсе.";

	// Глубина сверки расхождений: 45 дней перекрывают срок, за который документ еще могут
	// поправить и переотправить.
	С = Т.Добавить();
	С.Имя = "ОкноСверкиРасхожденийДней"; С.Тип = "Число"; С.ПоУмолчанию = 45; С.Обязательная = Ложь;
	С.Представление = "За сколько дней сверять суммы отправленного";
	С.Подсказка = "Сторож расхождений сверяет сумму отправки с текущей суммой документа за этот период.";

	С = Т.Добавить();
	С.Имя = "АвтоматическоеПринятиеУПД"; С.Тип = "Число"; С.ПоУмолчанию = 0; С.Обязательная = Ложь;
	С.Представление = "Автоматическое принятие входящих УПД (1 - да, 0 - нет)";
	С.Подсказка = "Входящие УПД от контрагентов с флагом ЭДО_АвтоматическоеПринятиеУПД принимаются регламентом без участия человека."
		+ " Входящие УКД - только от контрагентов с флагом ЭДО_АвтоматическоеПринятиеУКД.";

	// Окно поиска входящих без ответа. После простоя нужно больше 14 дней. Оператор не отдает
	// интервал длиннее 31 дня, но окно режется по суткам, так что предел - только длительность прогона.
	С = Т.Добавить();
	С.Имя = "ГлубинаДнейПринятияУПД"; С.Тип = "Число"; С.ПоУмолчанию = 14; С.Обязательная = Ложь;
	С.Представление = "Окно принятия входящих УПД, дней";
	С.Подсказка = "На сколько дней назад регламент ищет входящие УПД без ответа. Не больше 90.";

	С = Т.Добавить();
	С.Имя = "ПрочиеНашиАдресаЭДО"; С.Тип = "Строка"; С.ПоУмолчанию = ""; С.Обязательная = Ложь;
	С.Представление = "Наши прочие адреса ЭДО";
	С.Подсказка = "Через запятую. Наши ящики у других операторов - по ним ловится «отправитель = получатель».";

	// Режим "по сверке": для продавцов с флагом ЭДО_СверкаПередПринятиемУПД перед принятием УПД
	// ищем поступление в базе и сверяем суммы. Три настройки ниже управляют этой сверкой.
	С = Т.Добавить();
	С.Имя = "ДопускСуммыУПД"; С.Тип = "Число"; С.ПоУмолчанию = 0.01; С.Обязательная = Ложь;
	С.Представление = "Допуск расхождения суммы УПД, руб.";
	С.Подсказка = "Допустимая разница между суммой в базе и суммой в УПД (с НДС и отдельно по НДС), рубли.";

	С = Т.Добавить();
	С.Имя = "ПоискПоступленияМесяцевНазад"; С.Тип = "Число"; С.ПоУмолчанию = 4; С.Обязательная = Ложь;
	С.Представление = "Поиск поступления, месяцев назад";
	С.Подсказка = "Нижняя граница окна поиска поступления относительно даты УПД.";

	С = Т.Добавить();
	С.Имя = "ПоискПоступленияМесяцевВперёд"; С.Тип = "Число"; С.ПоУмолчанию = 1; С.Обязательная = Ложь;
	С.Представление = "Поиск поступления, месяцев вперёд";
	С.Подсказка = "Верхняя граница окна поиска поступления относительно даты УПД.";

	// Корректировки реализации (УКД) регламент шлет только новые: старые уже разобраны руками,
	// и массовая досылка задним числом дала бы контрагентам поток неожиданных УКД.
	С = Т.Добавить();
	С.Имя = "ДатаНачалаАвтоотправкиУКД"; С.Тип = "Дата"; С.ПоУмолчанию = Дата(1, 1, 1); С.Обязательная = Ложь;
	С.Представление = "Автоотправка УКД с даты";
	С.Подсказка = "Регламент отправляет корректировки реализации с датой не раньше этой. Пусто - автоотправка УКД выключена, корректировки уходят только вручную.";

	С = Т.Добавить();
	С.Имя = "ПаузаПередОтправкойУКДМинут"; С.Тип = "Число"; С.ПоУмолчанию = 60; С.Обязательная = Ложь;
	С.Представление = "Пауза перед автоотправкой УКД, минут";
	С.Подсказка = "Корректировка уходит регламентом не раньше, чем через это время после того, как стала готовой, и только если ее с тех пор не меняли. Ручная отправка идет сразу.";

	С = Т.Добавить();
	С.Имя = "ДнейБезПодтвержденияПОА"; С.Тип = "Число"; С.ПоУмолчанию = 3; С.Обязательная = Ложь;
	С.Представление = "Наш запрос на аннулирование без ответа, дней";
	С.Подсказка = "Центр управления показывает наши запросы на аннулирование, которые контрагент не подтвердил дольше этого срока.";

	// ЩА 13.10.2026 [yan]
	С = Т.Добавить();
	С.Имя = "ОбщийЯщикВходящих"; С.Тип = "Строка"; С.ПоУмолчанию = ""; С.Обязательная = Ложь;
	С.Представление = "Общий ящик входящих у всех организаций (Да/пусто)";
	С.Подсказка = "Да - у всех учетных записей базы один ящик оператора с одинаковой выдачей: список входящих скачивается"
		+ " один раз и раздается организациям по ИНН покупателя. Пусто - каждая учетная запись опрашивается отдельно.";

	Возврат Т;
КонецФункции

// Значение настройки. Порядок поиска: общая настройка, персональная (старое хранение),
// старый ключ объекта, значение по умолчанию.
Функция НастройкаЭДО(Имя) Экспорт

	Описание = ОписаниеНастроекЭДО().Найти(Имя, "Имя");
	ПоУмолчанию = ?(Описание = Неопределено, Неопределено, Описание.ПоУмолчанию);

	Значение = ПрочитатьНастройкуХранилища("ОФД_ЭДО_НастройкиОбработки", Имя, "");
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
 // старое хранение - в настройках того, кто задавал
		Значение = ПрочитатьНастройкуХранилища("ОФД_ЭДО_НастройкиОбработки", Имя, Неопределено);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Значение) И Имя = "ПрочиеНашиАдресаЭДО" Тогда
 // историческое место хранения этого параметра
		Значение = ПрочитатьНастройкуХранилища("ЭДО_Настройки", Имя, "");
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			Значение = ПрочитатьНастройкуХранилища("ЭДО_Настройки", Имя, Неопределено);
		КонецЕсли;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	// приведение к типу: в хранилище значение могло лечь строкой
	Если Описание <> Неопределено И Описание.Тип = "Число" Тогда
		Попытка
			Возврат Число(Значение);
		Исключение
			ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "НастройкаЭДО: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
			Возврат ПоУмолчанию;
		КонецПопытки;
	ИначеЕсли Описание <> Неопределено И Описание.Тип = "Дата" Тогда
		Возврат ?(ТипЗнч(Значение) = Тип("Дата"), Значение, ПоУмолчанию);
	ИначеЕсли Описание <> Неопределено И Описание.Тип = "Строка" Тогда
		Возврат СокрЛП(Строка(Значение));
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Записать настройку. ВСЕГДА в общие (пользователь ""), иначе её увидит только автор.
// ЩА 19.10.2026 [yan]: модуль вызывается с клиента, а запись идет в привилегированном
// режиме - поэтому снаружи только настройки из ОписаниеНастроекЭДО и только тому, кто вправе их менять.
// Служебные ключи того же раздела (замок и шаг отправки, курсор обхода, запреты создания) этим
// методом не пишутся: у них свои процедуры с проверками.
Процедура УстановитьНастройкуЭДО(Имя, Значение) Экспорт
	ПроверитьПравоМенятьНастройкиЭДО();
	Если ОписаниеНастроекЭДО().Найти(Имя, "Имя") = Неопределено Тогда
		ВызватьИсключение "Неизвестная настройка ЭДО: " + Имя;
	КонецЕсли;
	ЗаписатьОбщуюНастройкуЭДО(Имя, Значение);
КонецПроцедуры

// ЩА 19.10.2026 [yan]: запись в общий раздел без проверок - только для кода ядра, с клиента недоступна.
Процедура ЗаписатьОбщуюНастройкуЭДО(Знач Имя, Знач Значение)
	// Общие настройки лежат под пользователем "": для обычного пользователя это чужой слот, без привилегий - «Нарушение прав доступа».
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", Имя, Значение, , "");
КонецПроцедуры

// ЩА 19.10.2026 [yan]: менять общие настройки - право «Администрирование» или типовая роль НастройкаПараметровЭД.
Функция МожноМенятьНастройкиЭДО()
	Если ПравоДоступа("Администрирование", Метаданные) Тогда
		Возврат Истина;
	КонецЕсли;
	Роль = Метаданные.Роли.Найти("НастройкаПараметровЭД");
	Возврат Роль <> Неопределено И РольДоступна(Роль);
КонецФункции

Процедура ПроверитьПравоМенятьНастройкиЭДО()
	Если НЕ МожноМенятьНастройкиЭДО() Тогда
		ВызватьИсключение "Недостаточно прав для изменения настроек ЭДО: нужно право «Администрирование» или роль «НастройкаПараметровЭД»";
	КонецЕсли;
КонецПроцедуры

// Настройки операторов ЭДО по префиксу ящика получателя: название и способ отправки акта сверки.
// Общий раздел ОФД_ЭДО_НастройкиОбработки, ключ НастройкиОператоровЭДО, пользователь "".
// Значение - Массив структур (Префикс, Название, АктСверки), АктСверки: xml | pdf | запрещено.
// Пока таблица не записана, действует НастройкиОператоровЭДОПоУмолчанию; записанная заменяет ее целиком.
// Оператор, которого нет в таблице, получает акт в xml.
Функция НастройкиОператоровЭДО() Экспорт

	Сохраненные = ПрочитатьНастройкуХранилища("ОФД_ЭДО_НастройкиОбработки", КлючНастроекОператоровЭДО(), "");
	Если ТипЗнч(Сохраненные) <> Тип("Массив") Тогда
		Возврат НастройкиОператоровЭДОПоУмолчанию();
	КонецЕсли;

	Итог = Новый Массив;
	Для Каждого Сохраненная Из Сохраненные Цикл
		Если ТипЗнч(Сохраненная) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Префикс = "";
		Название = "";
		АктСверки = "";
		Сохраненная.Свойство("Префикс", Префикс);
		Сохраненная.Свойство("Название", Название);
		Сохраненная.Свойство("АктСверки", АктСверки);
		Префикс = ВРег(СокрЛП(Строка(Префикс)));
		Если НЕ ЗначениеЗаполнено(Префикс) Тогда
			Продолжить;
		КонецЕсли;
		Политика = НРег(СокрЛП(Строка(АктСверки)));
		Если ДопустимыеПолитикиАктаСверки().Найти(Политика) = Неопределено Тогда
			Политика = ПолитикаАктаСверкиXML();
		КонецЕсли;
		Итог.Добавить(Новый Структура("Префикс, Название, АктСверки", Префикс,
			СокрЛП(Строка(Название)), Политика));
	КонецЦикла;
	Возврат Итог;

КонецФункции

Функция НастройкиОператоровЭДОПоУмолчанию() Экспорт

	Итог = Новый Массив;
	Итог.Добавить(Новый Структура("Префикс, Название, АктСверки", "2LT", "ЭДО Лайт", ПолитикаАктаСверкиЗапрещено()));
	Итог.Добавить(Новый Структура("Префикс, Название, АктСверки", "2BE", "СБИС (Тензор)", ПолитикаАктаСверкиXML()));
	Итог.Добавить(Новый Структура("Префикс, Название, АктСверки", "2BM", "Контур.Диадок", ПолитикаАктаСверкиXML()));
	Итог.Добавить(Новый Структура("Префикс, Название, АктСверки", "2AE", "Калуга Астрал", ПолитикаАктаСверкиXML()));
	Итог.Добавить(Новый Структура("Префикс, Название, АктСверки", "2AL", "Такском", ПолитикаАктаСверкиXML()));
	Итог.Добавить(Новый Структура("Префикс, Название, АктСверки", "2VO", "Платформа ЭДО", ПолитикаАктаСверкиXML()));
	Возврат Итог;

КонецФункции

// Записать таблицу операторов. Строки - Массив структур (Префикс, Название, АктСверки).
// Пустой массив не записывается: без таблицы действуют умолчания, а не "все в xml".
Процедура УстановитьНастройкиОператоровЭДО(Знач Строки) Экспорт

	ПроверитьПравоМенятьНастройкиЭДО();
	Итог = Новый Массив;
	Префиксы = Новый Соответствие;
	Для Каждого СтрокаОператора Из Строки Цикл
		Префикс = ВРег(СокрЛП(СтрокаОператора.Префикс));
		Если СтрДлина(Префикс) <> 3 Тогда
			ВызватьИсключение "Префикс оператора ЭДО - три символа ящика (например 2LT), получено: " + Префикс;
		КонецЕсли;
		Если Префиксы.Получить(Префикс) <> Неопределено Тогда
			ВызватьИсключение "Префикс оператора ЭДО указан дважды: " + Префикс;
		КонецЕсли;
		Политика = НРег(СокрЛП(СтрокаОператора.АктСверки));
		Если НЕ ЗначениеЗаполнено(Политика) Тогда
			Политика = ПолитикаАктаСверкиXML();
		КонецЕсли;
		Если ДопустимыеПолитикиАктаСверки().Найти(Политика) = Неопределено Тогда
			ВызватьИсключение "Акт сверки для " + Префикс + ": допустимо " + СтрСоединить(ДопустимыеПолитикиАктаСверки(), ", ")
				+ ", получено: " + Политика;
		КонецЕсли;
		Префиксы.Вставить(Префикс, Истина);
		Итог.Добавить(Новый Структура("Префикс, Название, АктСверки", Префикс,
			СокрЛП(СтрокаОператора.Название), Политика));
	КонецЦикла;
	Если Итог.Количество() = 0 Тогда
		ВызватьИсключение "Таблица операторов ЭДО пуста - не записана";
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", КлючНастроекОператоровЭДО(), Итог,
		"настройки операторов ЭДО", "");

КонецПроцедуры

// Общие настройки, которые кнопка "Восстановить настройки по умолчанию" возвращает к ПоУмолчанию
// из ОписаниеНастроекЭДО. Учетные записи, сертификаты, адреса и даты начала сюда не входят: у них нет умолчания.
// Кроме этих имен сбрасывается таблица операторов ЭДО.
Функция ИменаНастроекСбросаПоУмолчанию() Экспорт

	Имена = Новый Массив;
	Имена.Добавить("ГлубинаДнейОтправки");
	Имена.Добавить("ЛимитДокументовЗаПрогон");
	Имена.Добавить("ГотовыеСтатусыЗаказа");
	Имена.Добавить("ГлубинаДнейСинхронизацииСтатусов");
	Имена.Добавить("ТаймаутHTTPСек");
	Имена.Добавить("ПаузаПередОтправкойУКДМинут");
	Возврат Имена;

КонецФункции

// Что изменит сброс к умолчаниям: строка на настройку "Представление: текущее -> умолчание".
// Записанное значение, равное умолчанию, тоже попадает в список: сброс его удалит.
// Возврат: Массив строк, пустой - сбрасывать нечего.
Функция ИзмененияПриСбросеНастроекЭДО() Экспорт

	Изменения = Новый Массив;
	Описания = ОписаниеНастроекЭДО();

	Для Каждого Имя Из ИменаНастроекСбросаПоУмолчанию() Цикл
		Описание = Описания.Найти(Имя, "Имя");
		Записанное = ПрочитатьНастройкуХранилища("ОФД_ЭДО_НастройкиОбработки", Имя, "");
		Текущее = НастройкаЭДО(Имя);
		Если Текущее = Описание.ПоУмолчанию И Записанное = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Текущее = Описание.ПоУмолчанию Тогда
			Изменения.Добавить(Описание.Представление + ": " + ПредставлениеЗначенияНастройки(Текущее)
				+ " (записано, совпадает с умолчанием)");
		Иначе
			Изменения.Добавить(Описание.Представление + ": " + ПредставлениеЗначенияНастройки(Текущее)
				+ " -> " + ПредставлениеЗначенияНастройки(Описание.ПоУмолчанию));
		КонецЕсли;
	КонецЦикла;

	Если ПрочитатьНастройкуХранилища("ОФД_ЭДО_НастройкиОбработки", КлючНастроекОператоровЭДО(), "") <> Неопределено Тогда
		ЗаписаннаяТаблица = НастройкиОператоровЭДО();
		ТаблицаПоУмолчанию = НастройкиОператоровЭДОПоУмолчанию();
		Если НастройкиОператоровЭДОТекстом() = ТекстТаблицыОператоровЭДО(ТаблицаПоУмолчанию) Тогда
			Изменения.Добавить("Операторы ЭДО: акты сверки: записанная таблица (совпадает с умолчанием)");
		Иначе
			Изменения.Добавить("Операторы ЭДО: акты сверки: записанная таблица, операторов "
				+ Формат(ЗаписаннаяТаблица.Количество(), "ЧН=0; ЧГ=0") + " -> таблица по умолчанию, операторов "
				+ Формат(ТаблицаПоУмолчанию.Количество(), "ЧН=0; ЧГ=0"));
		КонецЕсли;
	КонецЕсли;

	Возврат Изменения;

КонецФункции

// Вернуть настройки из ИменаНастроекСбросаПоУмолчанию и таблицу операторов к умолчаниям из кода.
// Записанные значения удаляются, а не заменяются копиями умолчаний: дальше действуют умолчания текущей версии.
// Прежние значения пишутся в журнал регистрации одной записью.
// Возврат: Массив строк - что сброшено и что не удалось сбросить; пустой - сбрасывать было нечего.
Функция СброситьНастройкиЭДОПоУмолчанию() Экспорт

	ПроверитьПравоМенятьНастройкиЭДО();

	Изменения = ИзмененияПриСбросеНастроекЭДО();
	Если Изменения.Количество() = 0 Тогда
		Возврат Изменения;
	КонецЕсли;
	ПрежняяТаблица = НастройкиОператоровЭДОТекстом();

	УстановитьПривилегированныйРежим(Истина);
	Для Каждого Имя Из ИменаНастроекСбросаПоУмолчанию() Цикл
		ХранилищеОбщихНастроек.Удалить("ОФД_ЭДО_НастройкиОбработки", Имя, "");
	КонецЦикла;
	ХранилищеОбщихНастроек.Удалить("ОФД_ЭДО_НастройкиОбработки", КлючНастроекОператоровЭДО(), "");

	// Без общего значения НастройкаЭДО берет старое персональное (хранение до 22.08.2026), если оно есть.
	Описания = ОписаниеНастроекЭДО();
	Для Каждого Имя Из ИменаНастроекСбросаПоУмолчанию() Цикл
		Описание = Описания.Найти(Имя, "Имя");
		Действующее = НастройкаЭДО(Имя);
		Если Действующее <> Описание.ПоУмолчанию Тогда
			Изменения.Добавить("Не сброшено: " + Описание.Представление + " - действует персональное значение "
				+ ПредставлениеЗначенияНастройки(Действующее) + " из старого хранения");
		КонецЕсли;
	КонецЦикла;

	ЗаписьЖР("ЭДО.НастройкиПоУмолчанию", "Информация", , ,
		"Настройки ЭДО возвращены к значениям по умолчанию:" + Символы.ПС + СтрСоединить(Изменения, Символы.ПС)
		+ Символы.ПС + "Таблица операторов ЭДО до сброса:" + Символы.ПС + ПрежняяТаблица);

	Возврат Изменения;

КонецФункции

Функция ПредставлениеЗначенияНастройки(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧН=0; ЧГ=0");
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат ?(ЗначениеЗаполнено(Значение), Формат(Значение, "ДФ=dd.MM.yyyy"), "(пусто)");
	ИначеЕсли НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "(пусто)";
	КонецЕсли;
	Возврат "«" + Строка(Значение) + "»";

КонецФункции

// Таблица операторов текстом для формы настроек: строка на оператора "префикс; название; акт сверки".
Функция НастройкиОператоровЭДОТекстом() Экспорт
	Возврат ТекстТаблицыОператоровЭДО(НастройкиОператоровЭДО());
КонецФункции

Функция ТекстТаблицыОператоровЭДО(Знач ТаблицаОператоров)

	Строки = Новый Массив;
	Для Каждого Настройка Из ТаблицаОператоров Цикл
		Строки.Добавить(Настройка.Префикс + "; " + Настройка.Название + "; " + Настройка.АктСверки);
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Разобрать текст формы настроек ("префикс; название; акт сверки" построчно) и записать таблицу.
// Возврат: число записанных операторов.
Функция ЗаписатьНастройкиОператоровЭДОИзТекста(Знач Текст) Экспорт

	Строки = Новый Массив;
	Для Каждого СтрокаТекста Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Если НЕ ЗначениеЗаполнено(СокрЛП(СтрокаТекста)) Тогда
			Продолжить;
		КонецЕсли;
		Части = СтрРазделить(СтрокаТекста, ";");
		Строки.Добавить(Новый Структура("Префикс, Название, АктСверки", СокрЛП(Части[0]),
			?(Части.Количество() > 1, СокрЛП(Части[1]), ""),
			?(Части.Количество() > 2, СокрЛП(Части[2]), "")));
	КонецЦикла;
	УстановитьНастройкиОператоровЭДО(Строки);
	Возврат Строки.Количество();

КонецФункции

// Настройка оператора по адресу получателя. Оператора нет в таблице - xml, название из макета вендора.
// Возврат: Структура (Префикс, Название, АктСверки).
Функция НастройкаОператораЭДО(Знач Адрес) Экспорт

	Префикс = ВРег(Лев(СокрЛП(Адрес), 3));
	Для Каждого Настройка Из НастройкиОператоровЭДО() Цикл
		Если Настройка.Префикс = Префикс Тогда
			Итог = Новый Структура("Префикс, Название, АктСверки", Префикс, Настройка.Название, Настройка.АктСверки);
			Если НЕ ЗначениеЗаполнено(Итог.Название) Тогда
				Итог.Название = НазваниеОператораИзМакета(Префикс);
			КонецЕсли;
			Возврат Итог;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Префикс, Название, АктСверки", Префикс, НазваниеОператораИзМакета(Префикс),
		ПолитикаАктаСверкиXML());

КонецФункции

Функция НазваниеОператораИзМакета(Знач Префикс)

	Название = ОператорыЭДО().Получить(Префикс);
	Возврат ?(ЗначениеЗаполнено(Название), Название, Префикс);

КонецФункции

Функция КлючНастроекОператоровЭДО()
	Возврат "НастройкиОператоровЭДО";
КонецФункции

Функция ПолитикаАктаСверкиXML() Экспорт
	Возврат "xml";
КонецФункции

Функция ПолитикаАктаСверкиPDF() Экспорт
	Возврат "pdf";
КонецФункции

Функция ПолитикаАктаСверкиЗапрещено() Экспорт
	Возврат "запрещено";
КонецФункции

Функция ДопустимыеПолитикиАктаСверки()
	Политики = Новый Массив;
	Политики.Добавить(ПолитикаАктаСверкиXML());
	Политики.Добавить(ПолитикаАктаСверкиPDF());
	Политики.Добавить(ПолитикаАктаСверкиЗапрещено());
	Возврат Политики;
КонецФункции

Функция ПрочитатьНастройкуХранилища(КлючОбъекта, КлючНастроек, Пользователь)
	// Общие настройки лежат под пользователем "": для обычного пользователя это чужой слот, без привилегий - «Нарушение прав доступа».
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Если Пользователь = Неопределено Тогда
			Возврат ХранилищеОбщихНастроек.Загрузить(КлючОбъекта, КлючНастроек);
		КонецЕсли;
		Возврат ХранилищеОбщихНастроек.Загрузить(КлючОбъекта, КлючНастроек, , Пользователь);
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ПрочитатьНастройкуХранилища: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Статусы заказа покупателя, при которых документ считается готовым к отправке.
// Состав перечисления СтатусыЗаявок в базах разный, поэтому несуществующие имена из настройки
// пропускаются: обращение к отсутствующему значению перечисления роняет весь фрагмент.
Функция ГотовыеСтатусыЗаказа() Экспорт
	Результат = Новый Массив;
	// Только позднее связывание: прямое обращение к Метаданные.Перечисления.СтатусыЗаявок
	// падает при выполнении на базе без этого перечисления (в типовой УТ 10.3 его нет).
	МетаСтатусы = Метаданные.Перечисления.Найти("СтатусыЗаявок");
	Если МетаСтатусы = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить(НастройкаЭДО("ГотовыеСтатусыЗаказа"), ",") Цикл
		ИмяСтатуса = СокрЛП(Имя);
		Если НЕ ЗначениеЗаполнено(ИмяСтатуса) Тогда
			Продолжить;
		КонецЕсли;
		Если МетаСтатусы.ЗначенияПеречисления.Найти(ИмяСтатуса) <> Неопределено Тогда
			Результат.Добавить(Перечисления["СтатусыЗаявок"][ИмяСтатуса]);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Документы, которые регламент должен отправить: типовой отбор ядра, который профиль базы
// может отфильтровать или собрать заново (точка ПриОтбореДокументовКОтправке).
// Ядро проверяет только типовое, признак окончательности состава документа добавляет профиль.
//
// Профиль получает структуру:
// НижняяГраница, Лимит - рамки отбора, посчитанные ядром;
// Документы - таблица (Ссылка, Номер, Дата) типового отбора, реализации и корректировки вместе;
// Перехвачено - поставить Истина, если профиль собрал список сам.
Функция ДокументыКОтправке(Знач Лимит = 0) Экспорт

	Нижняя = НижняяГраницаОтбора();
	Параметры = Новый Структура;
	Параметры.Вставить("НижняяГраница", Нижняя);
	Параметры.Вставить("Лимит", ?(Лимит > 0, Лимит, Число(НастройкаЭДО("ЛимитДокументовЗаПрогон"))));
	Параметры.Вставить("Документы", ТиповойОтборКОтправке(Нижняя));
	Параметры.Вставить("Перехвачено", Ложь);

	// Корректировки встают в ту же очередь по дате, иначе лимит прогона до них не дойдет.
	// Сбой их отбора не останавливает отправку реализаций.
	Попытка
		Корректировки = ОтборКорректировокКОтправке();
	Исключение
		Корректировки = Новый Массив;
		ЗаписьЖурналаРегистрации("ЭДО.Отправка", УровеньЖурналаРегистрации.Ошибка, , ,
			"Отбор корректировок к отправке не выполнен: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Если Корректировки.Количество() > 0 Тогда
		Параметры.Документы = ОбъединеннаяОчередь(Параметры.Документы, Корректировки);
	КонецЕсли;

	// Профиля нет - работает типовой отбор: расширение обязано работать на типовой УТ 10.3.
	Если Число(НастройкаЭДО("ОтправлятьТолькоПослеГотовности")) <> 0 Тогда
		ВызватьТочкуПрофиля("ПриОтбореДокументовКОтправке", Параметры);
	КонецЕсли;

	Возврат Параметры.Документы;

КонецФункции

// Типовой отбор: только то, что есть в любой УТ 10.3.
// Гейт статуса заказа применяется, лишь когда в базе есть и документ заказа, и нужные
// значения перечисления - см. ГейтСтатусаЗаказаПрименим().
Функция ТиповойОтборКОтправке(Знач НижняяГраница) Экспорт

	СвСБИС     = СвойствоОбъектов("ДокументСБИС_Ид");
	СвПлат     = СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	СвИд       = СвойствоОбъектов("ЭДО_АдресКонтрагента");
	СвСвязь    = СвойствоСтатусаСвязиОрганизации();   // ЩА 20.10.2026 [yan]: в запросе - по организации документа
	СвЧитаемый = СвойствоОбъектов("ЭДО_Состояние");
	СвПометка  = СвойствоОбъектов("ЭДО_ПометкаКОтправке");
	Пустое = ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка();

	// Запрет по организации. Условие принимает оба представления флага: Булево Истина и строку "Да"
	// (свойство могли завести руками строковым). Нет свойства в базе - отправка удерживается.
	СвРазр = СвойствоОбъектов("ЭДО_РазрешенаОтправка");
	УсловиеРазрешения = УсловиеОтбораРазрешенияОрганизации();

	// Удержанные (пауза по контрагенту, канал вне автовыбора) не должны попадать в выборку, иначе
	// они занимают лимит прогона и отправка стоит. Гейт нужен в обоих местах - здесь и в проверке
	// готовности, расхождение ловит СверитьГейтыОтбораИПроверки().
	// ЕСТЬNULL обязателен: без записи свойства условие "не на паузе" дает NULL и теряет строку.
	СвПауза  = СвойствоОбъектов("ЭДО_ОтправкаПриостановлена");
	СвЗакреп = СвойствоОбъектов("ЭДО_АдресЗакреплён");
	УсловиеПаузы = УсловиеОтбораПаузы();
	// Канал вне автовыбора (2LT, 2VO, 2IM) - только с ручным закреплением. Префиксы повторяют
	// АдресЭДОВнеАвтовыбора() намеренно: запрос не вызовет функцию, расхождение ловит сверка гейтов.
	УсловиеКанала = УсловиеОтбораКанала();

	// Гейт готовности: документ уходит, когда напечатан (печатный пакет ставит пометку) или помечен
	// вручную; страховка по возрасту добирает забытые. Настройка выключена - условие не ограничивает.
	// Пометку принимать в обоих видах (Булево Истина и строка "Да"): ее пишут и внешние печатные
	// пакеты, а строковое значение ВЫРАЗИТЬ(... КАК БУЛЕВО) молча не находит.
	ГейтГотовности = Число(НастройкаЭДО("ОтправлятьТолькоПослеГотовности")) <> 0;
	ДнейСтраховки = Число(НастройкаЭДО("ДнейСтраховкиБезПометки"));

	// Границ две. Абсолютную ДатаНачалаОтправки не переступаем: раньше документы уходили прежним
	// оператором, повтор дал бы дубль. Скользящее окно ГлубинаДнейОтправки ограничивает только
	// страховку: помеченный документ уходит независимо от возраста.
	ГраницаАбсолютная = РанняяДатаНачалаОтправки();
	ГраницаОкна = НижняяГраница;
	Если НЕ ЗначениеЗаполнено(ГраницаАбсолютная) Тогда
		ГраницаАбсолютная = ГраницаОкна;   // отсечка не задана - работаем прежним окном
	КонецЕсли;

	Если ГейтГотовности Тогда
		УсловиеГотовности = "И (ВЫРАЗИТЬ(Пометка.Значение КАК БУЛЕВО) = ИСТИНА
			|		ИЛИ ВЫРАЗИТЬ(Пометка.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1"")
			|		ИЛИ (РТУ.Дата >= &ГраницаОкна И РТУ.Дата <= &ГраницаСтраховки))";
	Иначе
		УсловиеГотовности = "И РТУ.Дата >= &ГраницаОкна";
	КонецЕсли;

	// Дата начала по конкретной организации (своя учетная запись); общая ГраницаАбсолютная -
	// запасная для тех, у кого своя не задана. Таблица идет отдельным набором: запрос отбирает
	// документы разных организаций сразу.
	ДатыНачалаОрганизаций = ТаблицаДатНачалаОрганизаций();

	З = Новый Запрос;
	З.Текст = ТекстЗапросаСГейтомЗаказа(
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ДатыОрг.Организация КАК Справочник.Организации) КАК Организация,
		|	ДатыОрг.ДатаНачала КАК ДатаНачала
		|ПОМЕСТИТЬ ДатыНачалаОрганизаций
		|ИЗ &ДатыНачалаОрганизаций КАК ДатыОрг
		|;
		|ВЫБРАТЬ РАЗЛИЧНЫЕ Тов.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ЗаказНеГотов
		|ИЗ Документ.РеализацияТоваровУслуг.Товары КАК Тов
		|ГДЕ Тов.ЗаказПокупателя <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
		|	И (НЕ Тов.ЗаказПокупателя.Статус В (&ГотовыеСтатусы)
		|		ИЛИ НАЧАЛОПЕРИОДА(Тов.ЗаказПокупателя.ДатаОтгрузки, ДЕНЬ) > &СегодняНачалоДня)
		|	И Тов.Ссылка.Дата >= &Дата
		|;
		|" + ТекстТаблицАдресаПокупателя() + "
		|;
		|ВЫБРАТЬ ПЕРВЫЕ 500
		|	РТУ.Ссылка КАК Ссылка, РТУ.Номер КАК Номер, РТУ.Дата КАК Дата
		|ИЗ Документ.РеализацияТоваровУслуг КАК РТУ
		|	ЛЕВОЕ СОЕДИНЕНИЕ ЗаказНеГотов КАК НеГотов ПО НеГотов.Ссылка = РТУ.Ссылка
		|	ЛЕВОЕ СОЕДИНЕНИЕ КарточкиСАдресом КАК СвойАдрес ПО СвойАдрес.Контрагент = РТУ.Контрагент
		|	ЛЕВОЕ СОЕДИНЕНИЕ ИННСАдресом КАК АдресПоИНН ПО АдресПоИНН.ИНН = РТУ.Контрагент.ИНН
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК СБИС
		|		ПО СБИС.Объект = РТУ.Ссылка И СБИС.Свойство = &СвСБИС
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Плат
		|		ПО Плат.Объект = РТУ.Ссылка И Плат.Свойство = &СвПлат
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Ид
		|		ПО ВЫРАЗИТЬ(Ид.Объект КАК Справочник.Контрагенты) = РТУ.Контрагент И Ид.Свойство = &СвИд
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Связь
		|		ПО ВЫРАЗИТЬ(Связь.Объект КАК Справочник.Контрагенты) = РТУ.Контрагент И Связь.Свойство = &СвСвязь
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Читаемый
		|		ПО Читаемый.Объект = РТУ.Ссылка И Читаемый.Свойство = &СвЧитаемый
		|			И ВЫРАЗИТЬ(Читаемый.Значение КАК СТРОКА(50)) = &ТекстНеТребуется
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Пометка
		|		ПО Пометка.Объект = РТУ.Ссылка И Пометка.Свойство = &СвПометка
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Разр
		|		ПО ВЫРАЗИТЬ(Разр.Объект КАК Справочник.Организации) = РТУ.Организация И Разр.Свойство = &СвРазр
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Пауза
		|		ПО ВЫРАЗИТЬ(Пауза.Объект КАК Справочник.Контрагенты) = РТУ.Контрагент И Пауза.Свойство = &СвПауза
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Авто
		|		ПО ВЫРАЗИТЬ(Авто.Объект КАК Справочник.Контрагенты) = РТУ.Контрагент И Авто.Свойство = &СвАвто
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Закреп
		|		ПО ВЫРАЗИТЬ(Закреп.Объект КАК Справочник.Контрагенты) = РТУ.Контрагент И Закреп.Свойство = &СвЗакреп
		|	ЛЕВОЕ СОЕДИНЕНИЕ ДатыНачалаОрганизаций КАК ДатыОрг
		|		ПО ДатыОрг.Организация = РТУ.Организация
		|ГДЕ РТУ.Проведен И РТУ.Дата >= ЕСТЬNULL(ДатыОрг.ДатаНачала, &Дата)
		|	И Читаемый.Объект ЕСТЬ NULL
		|	И РТУ.ОтражатьВБухгалтерскомУчете
		|	И НеГотов.Ссылка ЕСТЬ NULL
		|	И СБИС.Объект ЕСТЬ NULL
		|	И Плат.Объект ЕСТЬ NULL
		|	И Ид.Значение ЕСТЬ НЕ NULL
		|	И (СвойАдрес.Контрагент ЕСТЬ НЕ NULL ИЛИ АдресПоИНН.ИНН ЕСТЬ НЕ NULL)
		|	И (Связь.Значение = ""ESTABLISHED"" ИЛИ Связь.Значение = ""DIRECT"")
		|	" + УсловиеРазрешения + "
		|	" + УсловиеПаузы + "
		|	И (НЕ &ТолькоРазрешенным ИЛИ (ЕСТЬNULL(ВЫРАЗИТЬ(Авто.Значение КАК БУЛЕВО), ЛОЖЬ) = ИСТИНА
		|			ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Авто.Значение КАК СТРОКА(50)), """") В (""Да"", ""Истина"", ""1"")))
		|	" + УсловиеКанала + "
		|	" + УсловиеГотовности + "
		|УПОРЯДОЧИТЬ ПО РТУ.Дата");
	З.УстановитьПараметр("ДатыНачалаОрганизаций", ДатыНачалаОрганизаций);
	З.УстановитьПараметр("ГотовыеСтатусы", ГотовыеСтатусыЗаказа());
	З.УстановитьПараметр("СегодняНачалоДня", НачалоДня(ТекущаяДатаСеанса()));
	З.УстановитьПараметр("СвСБИС", ?(СвСБИС = Неопределено, Пустое, СвСБИС));
	З.УстановитьПараметр("СвПлат", ?(СвПлат = Неопределено, Пустое, СвПлат));
	З.УстановитьПараметр("СвИд", ?(СвИд = Неопределено, Пустое, СвИд));
	З.УстановитьПараметр("СвСвязь", ?(СвСвязь = Неопределено, Пустое, СвСвязь));
	УстановитьСвязьПоОрганизации(З, "РТУ.Организация");   // ЩА 20.10.2026 [yan]
	З.УстановитьПараметр("СвЧитаемый", ?(СвЧитаемый = Неопределено, Пустое, СвЧитаемый));
	З.УстановитьПараметр("ТекстНеТребуется", "Отправка не требуется");
	З.УстановитьПараметр("СвПометка", ?(СвПометка = Неопределено, Пустое, СвПометка));
	З.УстановитьПараметр("СвРазр", ?(СвРазр = Неопределено, Пустое, СвРазр));
	З.УстановитьПараметр("СвПауза", ?(СвПауза = Неопределено, Пустое, СвПауза));
	УстановитьПараметрыСпискаАвтоотправки(З);
	З.УстановитьПараметр("СвЗакреп", ?(СвЗакреп = Неопределено, Пустое, СвЗакреп));
	// Без адреса покупателя проверка держит документ навсегда.
	УстановитьПараметрыАдресаПокупателя(З);
	// Страховка выключена (0) - граница уводится в прошлое, и по возрасту не пройдёт никто.
	З.УстановитьПараметр("ГраницаСтраховки",
		?(ДнейСтраховки > 0, НачалоДня(ТекущаяДатаСеанса()) - ДнейСтраховки * 86400, '00010101'));
	З.УстановитьПараметр("ГраницаОкна", ГраницаОкна);
	З.УстановитьПараметр("Дата", ГраницаАбсолютная);

	Возврат З.Выполнить().Выгрузить();

КонецФункции

// Таблица (Организация, ДатаНачала) для отбора по дате начала отправки своей организации.
// Колонки типизированы: таблицу без типов колонок запрос не принимает, ошибка видна только при выполнении.
Функция ТаблицаДатНачалаОрганизаций()

	ДатыНачалаОрганизаций = Новый ТаблицаЗначений;
	ДатыНачалаОрганизаций.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ДатыНачалаОрганизаций.Колонки.Добавить("ДатаНачала", Новый ОписаниеТипов("Дата"));
	Для Каждого УчЗапись Из УчетныеЗаписиЭДО() Цикл
		Если ЗначениеЗаполнено(УчЗапись.ДатаНачалаОтправки) Тогда
			СтрокаДаты = ДатыНачалаОрганизаций.Добавить();
			СтрокаДаты.Организация = УчЗапись.Организация;
			СтрокаДаты.ДатаНачала = УчЗапись.ДатаНачалаОтправки;
		КонецЕсли;
	КонецЦикла;
	Возврат ДатыНачалаОрганизаций;

КонецФункции

// Условия отбора очереди, общие для реализаций и корректировок. Псевдонимы соединений
// (Разр, Пауза, Ид, Закреп) в обоих запросах одинаковые: условие, поправленное в одном
// отборе и забытое в другом, молча перестало бы удерживать один из видов документов.
Функция УсловиеОтбораРазрешенияОрганизации()
	Возврат "И (ВЫРАЗИТЬ(Разр.Значение КАК БУЛЕВО) = ИСТИНА
		|		ИЛИ ВЫРАЗИТЬ(Разр.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1""))";
КонецФункции

// Параметры списка автоотправки (соединение Авто и признак режима) - для всех запросов, где
// есть соединение Авто. Свойства нет - пустая ссылка: при включенном режиме не пройдет никто,
// и это честно: список пуст.
Процедура УстановитьПараметрыСпискаАвтоотправки(Запрос) Экспорт
	СвАвто = СвойствоОбъектов("ЭДО_АвтоотправкаРазрешена");
	Запрос.УстановитьПараметр("СвАвто", ?(СвАвто = Неопределено,
		ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка(), СвАвто));
	Запрос.УстановитьПараметр("ТолькоРазрешенным", Число(НастройкаЭДО("АвтоотправкаТолькоРазрешенным")) <> 0);
КонецПроцедуры

Функция УсловиеОтбораПаузы()
	Возврат "И НЕ (ЕСТЬNULL(ВЫРАЗИТЬ(Пауза.Значение КАК БУЛЕВО), ЛОЖЬ) = ИСТИНА
		|		ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Пауза.Значение КАК СТРОКА(50)), """") В (""Да"", ""Истина"", ""1""))";
КонецФункции

Функция УсловиеОтбораКанала()
	Возврат "И (НЕ (ЕСТЬNULL(ВЫРАЗИТЬ(Ид.Значение КАК СТРОКА(150)), """") ПОДОБНО ""2VO%""
		|			ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Ид.Значение КАК СТРОКА(150)), """") ПОДОБНО ""2LT%""
		|			ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Ид.Значение КАК СТРОКА(150)), """") ПОДОБНО ""2IM%"")
		|		ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Закреп.Значение КАК БУЛЕВО), ЛОЖЬ) = ИСТИНА
		|		ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Закреп.Значение КАК СТРОКА(50)), """") В (""Да"", ""Истина"", ""1""))";
КонецФункции

// Очередь из двух отборов, упорядоченная по дате. Колонка Ссылка без типа: в ней лежат
// документы разных видов.
Функция ОбъединеннаяОчередь(Знач Реализации, Знач Корректировки)

	Очередь = Новый ТаблицаЗначений;
	Очередь.Колонки.Добавить("Ссылка");
	Очередь.Колонки.Добавить("Номер");
	Очередь.Колонки.Добавить("Дата");
	Для Каждого СтрокаОчереди Из Реализации Цикл
		ЗаполнитьЗначенияСвойств(Очередь.Добавить(), СтрокаОчереди);
	КонецЦикла;
	Для Каждого СтрокаОчереди Из Корректировки Цикл
		ЗаполнитьЗначенияСвойств(Очередь.Добавить(), СтрокаОчереди);
	КонецЦикла;
	Очередь.Сортировать("Дата");
	Возврат Очередь;

КонецФункции

// Дата, с которой регламент отправляет корректировки реализации (УКД). Пустая - автоотправка
// УКД выключена: корректировки уходят только вручную.
Функция ДатаНачалаАвтоотправкиУКД() Экспорт
	Значение = НастройкаЭДО("ДатаНачалаАвтоотправкиУКД");
	Возврат ?(ТипЗнч(Значение) = Тип("Дата"), Значение, Дата(1, 1, 1));
КонецФункции

// Пауза перед автоотправкой УКД в секундах: корректировку успевают ввести, провести и проверить.
Функция ПаузаПередОтправкойУКДСек() Экспорт
	Минут = 60;
	Попытка
		Минут = Число(НастройкаЭДО("ПаузаПередОтправкойУКДМинут"));
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ПаузаПередОтправкойУКДСек: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Минут = 60;
	КонецПопытки;
	Возврат Макс(Минут, 0) * 60;
КонецФункции

// Вид операции корректировки, которая уходит как УКД, - изменение по согласованию сторон.
// Исправление ошибки уходит исправленным документом, а не УКД, и регламент его не шлет.
// Позднее связывание: в чужой редакции конфигурации перечисления может не быть.
// Возврат: ПеречислениеСсылка или Неопределено.
Функция ВидКорректировкиПоСогласованию() Экспорт

	МетаВиды = Метаданные.Перечисления.Найти("ВидыОперацийИсправленияПоступленияРеализации");
	Если МетаВиды = Неопределено
		ИЛИ МетаВиды.ЗначенияПеречисления.Найти("СогласованноеИзменение") = Неопределено
		ИЛИ Метаданные.Документы.КорректировкаРеализации.Реквизиты.Найти("ВидОперации") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Перечисления["ВидыОперацийИсправленияПоступленияРеализации"]["СогласованноеИзменение"];

КонецФункции

// Имя свойства с отметкой ожидания перед автоотправкой УКД.
Функция ИмяСвойстваОжиданияУКД() Экспорт
	Возврат "ЭДО_ОжиданиеПроверкиУКД";
КонецФункции

// Отметка ожидания: момент, когда корректировка впервые стала готовой, и версия данных
// документа в этот момент. Одной строкой, потому что свойство - Строка(50).
Функция ТекстОтметкиОжиданияУКД(Знач Момент, Знач ВерсияДанных)
	Возврат Формат(Момент, "ДФ=yyyyMMddHHmmss") + "|" + СокрЛП(ВерсияДанных);
КонецФункции

// Разбор отметки ожидания. Возврат: Структура (Момент, ВерсияДанных) или Неопределено,
// если отметки нет или она не нашего формата.
Функция РазобратьОтметкуОжиданияУКД(Знач Текст)

	Отметка = СокрЛП(Строка(Текст));
	Если СтрНайти(Отметка, "|") <> 15 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Момент = Дата(Лев(Отметка, 14));
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "РазобратьОтметкуОжиданияУКД: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат Неопределено;
	КонецПопытки;
	Возврат Новый Структура("Момент, ВерсияДанных", Момент, Сред(Отметка, 16));

КонецФункции

// Выдержала ли корректировка паузу перед автоотправкой.
// Отсчет идет от отметки ожидания и действует, пока версия данных документа та же: документ
// изменили - отметка недействительна, и отсчет начинается заново.
// Возврат: Структура (Выдержана Булево, Окончание Дата) - Окончание Неопределено, когда
// действующей отметки нет.
Функция ОжиданиеКорректировки(Знач ТекстОтметки, Знач ВерсияДанных, Знач Сейчас = Неопределено) Экспорт

	Результат = Новый Структура("Выдержана, Окончание", Ложь, Неопределено);
	Отметка = РазобратьОтметкуОжиданияУКД(ТекстОтметки);
	Если Отметка = Неопределено ИЛИ Отметка.ВерсияДанных <> СокрЛП(ВерсияДанных) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Окончание = Отметка.Момент + ПаузаПередОтправкойУКДСек();
	Результат.Выдержана = ?(Сейчас = Неопределено, ТекущаяДатаСеанса(), Сейчас) >= Результат.Окончание;
	Возврат Результат;

КонецФункции

// Корректировки, прошедшие все гейты автоотправки, кроме паузы перед отправкой.
// Гейты те же, что у реализаций, плюс свои: дата не раньше начала автоотправки УКД, вид
// "по согласованию сторон", исходник, подписанный покупателем, и хотя бы одна строка
// с изменением - без нее УКД пуст.
// Возврат: ТаблицаЗначений (Ссылка, Номер, Дата, ВерсияДанных, Отметка); автоотправка
// выключена - пустая.
Функция КандидатыКорректировокКОтправке() Экспорт

	ДатаНачала = ДатаНачалаАвтоотправкиУКД();
	ВидПоСогласованию = ВидКорректировкиПоСогласованию();
	Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ ВидПоСогласованию = Неопределено Тогда
		Пустая = Новый ТаблицаЗначений;
		Пустая.Колонки.Добавить("Ссылка");
		Пустая.Колонки.Добавить("Номер");
		Пустая.Колонки.Добавить("Дата");
		Пустая.Колонки.Добавить("ВерсияДанных");
		Пустая.Колонки.Добавить("Отметка");
		Возврат Пустая;
	КонецЕсли;

	З = Новый Запрос;
	З.Текст =
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ДатыОрг.Организация КАК Справочник.Организации) КАК Организация,
		|	ДатыОрг.ДатаНачала КАК ДатаНачала
		|ПОМЕСТИТЬ ДатыНачалаОрганизаций
		|ИЗ &ДатыНачалаОрганизаций КАК ДатыОрг
		|;
		|" + ТекстТаблицАдресаПокупателя() + "
		|;
		|" + ТекстТаблицыКорректировокСИзменениями() + "
		|;
		|ВЫБРАТЬ
		|	Корр.Ссылка КАК Ссылка,
		|	Корр.Номер КАК Номер,
		|	Корр.Дата КАК Дата,
		|	Корр.ВерсияДанных КАК ВерсияДанных,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Ожидание.Значение КАК СТРОКА(50)), """") КАК Отметка,
		|	Корр.ДокументРеализации КАК Исходник,
		|	ВЫБОР КОГДА ИсхСост.Объект ЕСТЬ NULL
		|			ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(ИсхИд.Значение КАК СТРОКА(50)), """") = """"
		|		ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ КАК ИсходникПринят
		|ИЗ Документ.КорректировкаРеализации КАК Корр
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ИсхИд
		|		ПО ИсхИд.Объект = Корр.ДокументРеализации И ИсхИд.Свойство = &СвПлат
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ИсхСост
		|		ПО ИсхСост.Объект = Корр.ДокументРеализации И ИсхСост.Свойство = &СвЧитаемый
		|			И ВЫРАЗИТЬ(ИсхСост.Значение КАК СТРОКА(50)) В (&ТекстПринят)
		|	ЛЕВОЕ СОЕДИНЕНИЕ КарточкиСАдресом КАК СвойАдрес ПО СвойАдрес.Контрагент = Корр.Контрагент
		|	ЛЕВОЕ СОЕДИНЕНИЕ ИННСАдресом КАК АдресПоИНН ПО АдресПоИНН.ИНН = Корр.Контрагент.ИНН
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Плат
		|		ПО Плат.Объект = Корр.Ссылка И Плат.Свойство = &СвПлат
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Ид
		|		ПО ВЫРАЗИТЬ(Ид.Объект КАК Справочник.Контрагенты) = Корр.Контрагент И Ид.Свойство = &СвИд
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Связь
		|		ПО ВЫРАЗИТЬ(Связь.Объект КАК Справочник.Контрагенты) = Корр.Контрагент И Связь.Свойство = &СвСвязь
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Читаемый
		|		ПО Читаемый.Объект = Корр.Ссылка И Читаемый.Свойство = &СвЧитаемый
		|			И ВЫРАЗИТЬ(Читаемый.Значение КАК СТРОКА(50)) = &ТекстНеТребуется
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Разр
		|		ПО ВЫРАЗИТЬ(Разр.Объект КАК Справочник.Организации) = Корр.Организация И Разр.Свойство = &СвРазр
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Пауза
		|		ПО ВЫРАЗИТЬ(Пауза.Объект КАК Справочник.Контрагенты) = Корр.Контрагент И Пауза.Свойство = &СвПауза
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Авто
		|		ПО ВЫРАЗИТЬ(Авто.Объект КАК Справочник.Контрагенты) = Корр.Контрагент И Авто.Свойство = &СвАвто
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Закреп
		|		ПО ВЫРАЗИТЬ(Закреп.Объект КАК Справочник.Контрагенты) = Корр.Контрагент И Закреп.Свойство = &СвЗакреп
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Ожидание
		|		ПО Ожидание.Объект = Корр.Ссылка И Ожидание.Свойство = &СвОжидание
		|	ЛЕВОЕ СОЕДИНЕНИЕ ДатыНачалаОрганизаций КАК ДатыОрг
		|		ПО ДатыОрг.Организация = Корр.Организация
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ КорректировкиСИзменениями КАК Изм
		|		ПО Изм.Ссылка = Корр.Ссылка
		|ГДЕ Корр.Проведен
		|	И Корр.Дата >= &ДатаНачалаУКД
		|	И Корр.Дата >= ЕСТЬNULL(ДатыОрг.ДатаНачала, &ДатаНачалаУКД)
		|	И Корр.ВидОперации = &ВидПоСогласованию
		|	И Корр.ОтражатьВБухгалтерскомУчете
		|	И Читаемый.Объект ЕСТЬ NULL
		|	И Плат.Объект ЕСТЬ NULL
		|	И Ид.Значение ЕСТЬ НЕ NULL
		|	И (СвойАдрес.Контрагент ЕСТЬ НЕ NULL ИЛИ АдресПоИНН.ИНН ЕСТЬ НЕ NULL)
		|	И (Связь.Значение = ""ESTABLISHED"" ИЛИ Связь.Значение = ""DIRECT"")
		|	" + УсловиеОтбораРазрешенияОрганизации() + "
		|	" + УсловиеОтбораПаузы() + "
		|	И (НЕ &ТолькоРазрешенным ИЛИ (ЕСТЬNULL(ВЫРАЗИТЬ(Авто.Значение КАК БУЛЕВО), ЛОЖЬ) = ИСТИНА
		|			ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Авто.Значение КАК СТРОКА(50)), """") В (""Да"", ""Истина"", ""1"")))
		|	" + УсловиеОтбораКанала() + "
		|УПОРЯДОЧИТЬ ПО Корр.Дата";

	З.УстановитьПараметр("ДатыНачалаОрганизаций", ТаблицаДатНачалаОрганизаций());
	З.УстановитьПараметр("ДатаНачалаУКД", ДатаНачала);
	З.УстановитьПараметр("ВидПоСогласованию", ВидПоСогласованию);
	З.УстановитьПараметр("ТекстПринят", ТекстыПодписанного());
	З.УстановитьПараметр("ТекстНеТребуется", ТекстСтатусаОтправкаНеТребуется());
	З.УстановитьПараметр("СвПлат", СвойствоОбъектов("ЭДО_ИдентификаторДокумента"));
	З.УстановитьПараметр("СвЧитаемый", СвойствоОбъектов("ЭДО_Состояние"));
	З.УстановитьПараметр("СвИд", СвойствоОбъектов("ЭДО_АдресКонтрагента"));
	УстановитьСвязьПоОрганизации(З, "Корр.Организация");   // ЩА 20.10.2026 [yan]: статус связи по организации УКД
	З.УстановитьПараметр("СвРазр", СвойствоОбъектов("ЭДО_РазрешенаОтправка"));
	З.УстановитьПараметр("СвПауза", СвойствоОбъектов("ЭДО_ОтправкаПриостановлена"));
	УстановитьПараметрыСпискаАвтоотправки(З);
	З.УстановитьПараметр("СвЗакреп", СвойствоОбъектов("ЭДО_АдресЗакреплён"));
	З.УстановитьПараметр("СвОжидание", СвойствоОбъектов(ИмяСвойстваОжиданияУКД()));
	УстановитьПараметрыАдресаПокупателя(З);

	Кандидаты = З.Выполнить().Выгрузить();

	// Исходник, не принятый в Платформе, годится, если покупатель подписал его у другого оператора
	// (документы до перехода на Платформу). Это знает только профиль базы; без него такие
	// корректировки, как и раньше, регламент не отправляет.
	НеПринятые = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если НЕ Кандидат.ИсходникПринят И НеПринятые.Найти(Кандидат.Исходник) = Неопределено Тогда
			НеПринятые.Добавить(Кандидат.Исходник);
		КонецЕсли;
	КонецЦикла;
	Если НеПринятые.Количество() > 0 Тогда
		ПодписаныУДругого = ИсходникиПодписаныУДругогоОператора(НеПринятые);
		Индекс = Кандидаты.Количество() - 1;
		Пока Индекс >= 0 Цикл
			Кандидат = Кандидаты[Индекс];
			Если НЕ Кандидат.ИсходникПринят И ПодписаныУДругого.Получить(Кандидат.Исходник) <> Истина Тогда
				Кандидаты.Удалить(Индекс);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
	КонецЕсли;

	// Лимит прогона - ПОСЛЕ проверки исходников: в запросе он отдавал бы места корректировкам
	// к неподходящим исходникам (они копятся и не уходят никогда), и допустимая корректировка
	// за их пределами не попадала бы в очередь ни в одном прогоне. Порядок по дате сохраняется.
	МаксКандидатов = 500;
	Пока Кандидаты.Количество() > МаксКандидатов Цикл
		Кандидаты.Удалить(Кандидаты.Количество() - 1);
	КонецЦикла;

	Возврат Кандидаты;

КонецФункции

// Исходники корректировок, которые покупатель подписал у другого оператора ЭДО (например,
// документы, отправленные до перехода на Платформу). Знает только база: необязательная точка
// профиля ПриПроверкеИсходниковУДругогоОператора. Нет точки - пустое соответствие, и УКД
// уходит только к исходникам, принятым в Платформе.
// Исходники - Массив ссылок на реализации. Возврат: Соответствие (ссылка -> Истина).
Функция ИсходникиПодписаныУДругогоОператора(Знач Исходники) Экспорт
	Парам = Новый Структура("Исходники, Подписаны", Исходники, Новый Соответствие);
	Если Исходники.Количество() > 0 Тогда
		ВызватьНеобязательнуюТочкуПрофиля("ПриПроверкеИсходниковУДругогоОператора", Парам);
	КонецЕсли;
	Возврат Парам.Подписаны;
КонецФункции

// Корректировки, которые регламент отправляет сейчас: кандидаты, выдержавшие паузу без
// изменений документа. Только ЧИТАЕТ - отбор зовет и сверка гейтов; отсчет паузы ставит
// ОтметитьКорректировкиНаПроверке.
// Возврат: ТаблицаЗначений (Ссылка, Номер, Дата).
Функция ОтборКорректировокКОтправке() Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Ссылка");
	Результат.Колонки.Добавить("Номер");
	Результат.Колонки.Добавить("Дата");

	Сейчас = ТекущаяДатаСеанса();
	Для Каждого Кандидат Из КандидатыКорректировокКОтправке() Цикл
		Если ОжиданиеКорректировки(Кандидат.Отметка, Кандидат.ВерсияДанных, Сейчас).Выдержана Тогда
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), Кандидат);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Начать отсчет паузы у готовых корректировок без действующей отметки: готовы впервые или
// изменены после прежней отметки. Пишет в базу, поэтому зовется из прогона отправки под
// замком, а не из отбора.
// Возврат: Число - сколько отметок поставлено.
Функция ОтметитьКорректировкиНаПроверке() Экспорт

	Свойство = СвойствоОбъектов(ИмяСвойстваОжиданияУКД());
	Если Свойство.Пустая() Тогда
		Возврат 0;
	КонецЕсли;

	Отмечено = 0;
	Сейчас = ТекущаяДатаСеанса();
	Для Каждого Кандидат Из КандидатыКорректировокКОтправке() Цикл
		Если ОжиданиеКорректировки(Кандидат.Отметка, Кандидат.ВерсияДанных, Сейчас).Окончание <> Неопределено Тогда
			Продолжить;   // отметка действует - отсчет уже идет
		КонецЕсли;
		ЗаписатьЗначениеСвойства(Кандидат.Ссылка, Свойство, ТекстОтметкиОжиданияУКД(Сейчас, Кандидат.ВерсияДанных));
		Отмечено = Отмечено + 1;
	КонецЦикла;
	Возврат Отмечено;

КонецФункции

// Почему исходный документ корректировки не годится для УКД ("" - годится).
// УКД правит принятый документ: при неотправленном, неподписанном или отклоненном исходнике
// покупателю корректировать нечего. Исходник регламент НЕ переотправляет - это решение человека.
Функция ПричинаНеготовностиИсходникаУКД(Знач Исходник) Экспорт

	Если НЕ ЗначениеЗаполнено(Исходник) Тогда
		Возврат "В корректировке не указан исходный документ реализации";
	КонецЕсли;
	Причина = "";
	Ид = ЗначениеСвойстваОбъекта(Исходник, СвойствоОбъектов("ЭДО_ИдентификаторДокумента", Истина));
	Состояние = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Исходник, СвойствоОбъектов("ЭДО_Состояние", Истина))));
	Если НЕ ЗначениеЗаполнено(Ид) Тогда
		Причина = "Исходный документ «" + Строка(Исходник) + "» не отправлялся по ЭДО -"
			+ " УКД к нему регламент не отправит";
	ИначеЕсли НЕ ПодписанПоТекстуКолонки(Состояние) Тогда
		Причина = "Исходный документ «" + Строка(Исходник) + "» не подписан покупателем ("
			+ ?(ЗначениеЗаполнено(Состояние), Состояние, "состояние неизвестно") + ")";
	КонецЕсли;
	Если ЗначениеЗаполнено(Причина) Тогда
		Исходники = Новый Массив;
		Исходники.Добавить(Исходник);
		Если ИсходникиПодписаныУДругогоОператора(Исходники).Получить(Исходник) = Истина Тогда
			Возврат "";
		КонецЕсли;
	КонецЕсли;
	Возврат Причина;

КонецФункции

// Временная таблица КорректировкиСИзменениями (Ссылка): корректировки, где хотя бы в одной
// строке изменились количество, сумма, НДС или ставка. УКД выгружает только такие строки,
// поэтому корректировка без них в УКД не превращается. Условие то же, что в макете
// НастройкаКорректировка, - менять вместе.
Функция ТекстТаблицыКорректировокСИзменениями() Экспорт

	Возврат
	"ВЫБРАТЬ
	|	Тов.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ КорректировкиСИзменениямиСтроки
	|ИЗ Документ.КорректировкаРеализации.Товары КАК Тов
	|ГДЕ Тов.Количество <> Тов.КоличествоДоИзменения
	|	ИЛИ Тов.Сумма <> Тов.СуммаДоИзменения
	|	ИЛИ Тов.СуммаНДС <> Тов.СуммаНДСДоИзменения
	|	ИЛИ Тов.СтавкаНДС <> Тов.СтавкаНДСДоИзменения
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Усл.Ссылка
	|ИЗ Документ.КорректировкаРеализации.Услуги КАК Усл
	|ГДЕ Усл.Количество <> Усл.КоличествоДоИзменения
	|	ИЛИ Усл.Сумма <> Усл.СуммаДоИзменения
	|	ИЛИ Усл.СуммаНДС <> Усл.СуммаНДСДоИзменения
	|	ИЛИ Усл.СтавкаНДС <> Усл.СтавкаНДСДоИзменения
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Стр.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ КорректировкиСИзменениями
	|ИЗ КорректировкиСИзменениямиСтроки КАК Стр
	|ИНДЕКСИРОВАТЬ ПО Ссылка";

КонецФункции

// Есть ли в корректировке строка, которая попадет в УКД.
Функция ЕстьИзмененныеСтрокиКорректировки(Знач Ссылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Тов.Ссылка КАК Ссылка
	|ИЗ Документ.КорректировкаРеализации.Товары КАК Тов
	|ГДЕ Тов.Ссылка = &Ссылка
	|	И (Тов.Количество <> Тов.КоличествоДоИзменения
	|		ИЛИ Тов.Сумма <> Тов.СуммаДоИзменения
	|		ИЛИ Тов.СуммаНДС <> Тов.СуммаНДСДоИзменения
	|		ИЛИ Тов.СтавкаНДС <> Тов.СтавкаНДСДоИзменения)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Усл.Ссылка
	|ИЗ Документ.КорректировкаРеализации.Услуги КАК Усл
	|ГДЕ Усл.Ссылка = &Ссылка
	|	И (Усл.Количество <> Усл.КоличествоДоИзменения
	|		ИЛИ Усл.Сумма <> Усл.СуммаДоИзменения
	|		ИЛИ Усл.СуммаНДС <> Усл.СуммаНДСДоИзменения
	|		ИЛИ Усл.СтавкаНДС <> Усл.СтавкаНДСДоИзменения)";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// Гейты корректировки, которые действуют только при автоотправке: дата начала автоотправки УКД,
// вид операции, подписанный исходник и пауза. Ручная отправка их не проходит - решает человек.
// Возврат: Строка - причина удержания, "" - гейты пройдены.
Функция ПричинаУдержанияКорректировки(Знач Ссылка) Экспорт

	ДатаНачала = ДатаНачалаАвтоотправкиУКД();
	Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
		Возврат "Автоотправка УКД выключена (не задана дата начала) - корректировка уходит только вручную";
	КонецЕсли;
	Если Ссылка.Дата < ДатаНачала Тогда
		Возврат "Корректировка от " + Формат(Ссылка.Дата, "ДФ=dd.MM.yyyy") + " старше даты начала"
			+ " автоотправки УКД (" + Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + ") - только вручную";
	КонецЕсли;

	ВидПоСогласованию = ВидКорректировкиПоСогласованию();
	Если ВидПоСогласованию = Неопределено ИЛИ Ссылка.ВидОперации <> ВидПоСогласованию Тогда
		Возврат "Корректировка вида «" + Строка(Ссылка.ВидОперации) + "» уходит не как УКД -"
			+ " регламент ее не отправляет, только вручную";
	КонецЕсли;

	ПричинаИсходника = ПричинаНеготовностиИсходникаУКД(Ссылка.ДокументРеализации);
	Если ЗначениеЗаполнено(ПричинаИсходника) Тогда
		Возврат ПричинаИсходника;
	КонецЕсли;

	СвОжидание = СвойствоОбъектов(ИмяСвойстваОжиданияУКД());
	ТекстОтметки = ?(СвОжидание.Пустая(), "", ЗначениеСвойстваОбъекта(Ссылка, СвОжидание));
	Ожидание = ОжиданиеКорректировки(ТекстОтметки, Ссылка.ВерсияДанных);
	Если Ожидание.Окончание = Неопределено Тогда
		Возврат "Корректировка новая или изменена - пауза перед автоотправкой начнется"
			+ " со следующего прогона";
	ИначеЕсли НЕ Ожидание.Выдержана Тогда
		Возврат ТекстОжиданияПроверкиУКД(Ожидание.Окончание)
			+ " - пауза, чтобы корректировку успели проверить";
	КонецЕсли;
	Возврат "";

КонецФункции

// Идет ли вызов из регламентного задания. Гейты автоотправки УКД проходит только регламент:
// ручная отправка из карточки и из списка документов идет сразу.
Функция ЭтоРегламентныйСеанс() Экспорт
	Попытка
		Возврат ПолучитьТекущийСеансИнформационнойБазы().ИмяПриложения = "BackgroundJob";
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ЭтоРегламентныйСеанс: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Свойство объектов по имени. ТочноеСоответствие обязательно: без него НайтиПоНаименованию
// находит свойство, имя которого только НАЧИНАЕТСЯ с искомого, и ядро молча работает с чужим.
// Обязательное = Истина - нет свойства значит ошибка, а не пустая ссылка дальше по коду.
Функция СвойствоОбъектов(Знач Имя, Знач Обязательное = Ложь) Экспорт
	// ЩА 20.10.2026 [yan]: наименование длиннее предела плана видов характеристик (50) хранится
	// обрезанным, и поиск по полному имени его не находил. Так свойство статуса связи второй
	// организации (ЭДО_СтатусСвязи_<гид>, 62 символа) в ГХ было заведено, но для ядра «не существовало»:
	// статус связи ТД ЛИОН не писался и не читался, документы стояли «связь ещё не проверена».
	Имя = Лев(СокрЛП(Имя), Метаданные.ПланыВидовХарактеристик.СвойстваОбъектов.ДлинаНаименования);
	Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(Имя, Истина);
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Если Обязательное Тогда
			ВызватьИсключение "ЭДО: свойство объектов """ + Имя + """ не найдено";
		КонецЕсли;
		Возврат ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка();
	КонецЕсли;
	Возврат Свойство;
КонецФункции

// Значение свойства объекта из регистра ЗначенияСвойствОбъектов (Неопределено, если записи нет).
// Нужна профилям: они отбирают по свойствам, которых в типовой конфигурации нет.
Функция ЗначениеСвойстваОбъекта(Объект, Свойство) Экспорт
	ПроверитьСсылкуСвойства(Свойство, "чтение значения");
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Значение КАК Значение
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Объект = &Объект И Свойство = &Свойство");
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Применим ли гейт "заказ покупателя еще не в готовом статусе": реквизит ЗаказПокупателя.Статус
// и перечисление СтатусыЗаявок нетиповые, без них гейта нет.
Функция ГейтСтатусаЗаказаПрименим() Экспорт
	Возврат Метаданные.Перечисления.Найти("СтатусыЗаявок") <> Неопределено
		И Метаданные.Документы.ЗаказПокупателя.Реквизиты.Найти("Статус") <> Неопределено;
КонецФункции

// Заменить кусок текста между маркерами, маркеры остаются на месте. Маркера нет - текст
// возвращается как есть: молча испортить маппинг хуже, чем не сработать.
Функция ЗаменитьМеждуМаркерами(Знач Текст, Знач МаркерНачала, Знач МаркерКонца, Знач Замена) Экспорт
	Поз1 = СтрНайти(Текст, МаркерНачала);
	Поз2 = СтрНайти(Текст, МаркерКонца);
	Если Поз1 = 0 ИЛИ Поз2 = 0 ИЛИ Поз2 < Поз1 Тогда
		Возврат Текст;
	КонецЕсли;
	Начало = Лев(Текст, Поз1 + СтрДлина(МаркерНачала) - 1);
	Хвост = Сред(Текст, Поз2);
	Возврат Начало + Символы.ПС + Замена + Символы.ПС + Хвост;
КонецФункции

// Текст запроса без нетиповых гейтов заказа: их условия заменяются на ЛОЖЬ дословно, поэтому
// менять вместе с текстом запроса. Такую ошибку ловит только выполнение, не сборка и не /CheckConfig.
Функция ТекстЗапросаСГейтомЗаказа(Знач Текст) Экспорт
	Результат = Текст;

	Если НЕ ГейтСтатусаЗаказаПрименим() Тогда
		Результат = СтрЗаменить(Результат,
			"НЕ Тов.ЗаказПокупателя.Статус В (&ГотовыеСтатусы)", "ЛОЖЬ");
	КонецЕсли;

	Если НЕ ГейтДатыОтгрузкиПрименим() Тогда
		Результат = СтрЗаменить(Результат,
			"НАЧАЛОПЕРИОДА(Тов.ЗаказПокупателя.ДатаОтгрузки, ДЕНЬ) > &СегодняНачалоДня", "ЛОЖЬ");
	КонецЕсли;

	Возврат Результат;
КонецФункции

// Применим ли гейт "дата отгрузки заказа ещё не наступила".
// Реквизит нетиповой ровно так же, как Статус: в конфигурации без него гейта просто нет.
Функция ГейтДатыОтгрузкиПрименим() Экспорт
	Возврат Метаданные.Документы.ЗаказПокупателя.Реквизиты.Найти("ДатаОтгрузки") <> Неопределено;
КонецФункции

// Хост API оператора из учетной записи организации.
// Брать ТОЛЬКО отсюда: хост и префиксы путей обязаны быть из одной пары.
// Организация не указана - хост берется из учетных записей, когда он у всех один;
// разошлись - вызывающий обязан назвать организацию.
Функция ХостAPI(Знач Организация = Неопределено) Экспорт

	Если ЗначениеЗаполнено(Организация) Тогда
		Запись = УчетнаяЗаписьЭДО(Организация);
		Если Запись = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Запись.Хост) Тогда
			ВызватьИсключение "Не настроена учетная запись ЭДО организации «" + Строка(Организация)
				+ "»: не задан хост оператора";
		КонецЕсли;
		Возврат Запись.Хост;
	КонецЕсли;

	Хосты = Новый Соответствие;
	Для Каждого Запись Из УчетныеЗаписиЭДО() Цикл
		Если ЗначениеЗаполнено(Запись.Хост) Тогда
			Хосты.Вставить(Запись.Хост, Истина);
		КонецЕсли;
	КонецЦикла;

	Если Хосты.Количество() = 0 Тогда
		ВызватьИсключение "Не настроена ни одна учетная запись ЭДО: неизвестен хост оператора";
	ИначеЕсли Хосты.Количество() > 1 Тогда
		ВызватьИсключение "У организаций разные хосты оператора - операцию нужно выполнять"
			+ " с указанием организации";
	КонецЕсли;

	Для Каждого Хост Из Хосты Цикл
		Возврат Хост.Ключ;
	КонецЦикла;

КонецФункции

// Самая ранняя дата начала отправки среди учетных записей: нижняя граница для отборов,
// которые идут сразу по всем организациям. Пустая дата - записей нет.
Функция РанняяДатаНачалаОтправки() Экспорт

	Ранняя = Дата(1, 1, 1);
	Для Каждого Запись Из УчетныеЗаписиЭДО() Цикл
		Если НЕ ЗначениеЗаполнено(Запись.ДатаНачалаОтправки) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Ранняя) ИЛИ Запись.ДатаНачалаОтправки < Ранняя Тогда
			Ранняя = Запись.ДатаНачалаОтправки;
		КонецЕсли;
	КонецЦикла;
	Возврат Ранняя;

КонецФункции

// Префикс пути сервиса оператора: "document" -> "/edm-document". Старые пути не поддерживаются:
// смешанная пара старого хоста и путей /edm-* отвечает 200 и HTML вместо данных.
Функция ПутьСервиса(Знач Сервис) Экспорт
	Возврат "/edm-" + Сервис;
КонецФункции

// Проверка, что текущий контур отвечает данными, а не страницей. Проверять по телу, а не по коду:
// неизвестный путь может вернуть 200 и HTML личного кабинета. Проверяются все три сервиса ядра.
// Возврат: Структура (Годен Булево, Описание Строка).
Функция ПроверитьКонтурAPI(Знач Организация = Неопределено) Экспорт

	Результат = Новый Структура("Годен, Описание", Ложь, "");
	Описание = "хост " + ХостAPI();

	Если НЕ ОбеспечитьТокен(Истина, Организация) Тогда
		Результат.Описание = Описание + ": не удалось получить токен";
		Возврат Результат;
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));
	Гид = ГидОрганизации(Организация);

	Пробы = Новый Массив;
	Пробы.Добавить(Новый Структура("Сервис, Путь, ТребуетсяКод200",
		"roaming",
		ПутьСервиса("roaming") + "/public/api/v3/subscribers/" + Гид + "/contacts",
		Истина));
	Пробы.Добавить(Новый Структура("Сервис, Путь, ТребуетсяКод200",
		"subscriber",
		ПутьСервиса("subscriber") + "/public/api/v3/subscribers/" + Гид,
		Ложь));
	Пробы.Добавить(Новый Структура("Сервис, Путь, ТребуетсяКод200",
		"document",
		ПутьСервиса("document") + "/public/api/v3/documents?sender_id=" + Гид,
		Ложь));

	Соединение = СоединениеСОператором(15);
	Отчет = Новый Массив;

	Для Каждого Проба Из Пробы Цикл

		Попытка
			Ответ = Соединение.Получить(Новый HTTPЗапрос(Проба.Путь, Заголовки));
		Исключение
			Результат.Описание = Описание + ": " + Проба.Сервис + " не ответил - "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Возврат Результат;
		КонецПопытки;

		Тело = СокрЛП(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
		ПерваяБуква = Лев(Тело, 1);

		Если ПерваяБуква <> "[" И ПерваяБуква <> "{" Тогда
			Результат.Описание = Описание + ": " + Проба.Сервис + " ответил HTTP "
				+ Ответ.КодСостояния + ", но тело НЕ JSON (" + СтрДлина(Тело)
				+ " б, начинается с " + Лев(Тело, 20) + ")."
				+ " Хост и префикс пути не из одной пары";
			Возврат Результат;
		КонецЕсли;

		Если Проба.ТребуетсяКод200 И Ответ.КодСостояния <> 200 Тогда
			Результат.Описание = Описание + ": " + Проба.Сервис + " ответил HTTP "
				+ Ответ.КодСостояния + " вместо 200";
			Возврат Результат;
		КонецЕсли;

		Отчет.Добавить(Проба.Сервис + " " + Ответ.КодСостояния);

	КонецЦикла;

	Результат.Годен = Истина;
	Результат.Описание = Описание + ": JSON от всех сервисов (" + СтрСоединить(Отчет, ", ") + ")";

	Возврат Результат;

КонецФункции

// Соединение с API оператора: хост и таймаут - из настроек. Длинный таймаут в аварию оператора
// множится на число повторов и вешает прогон целиком.
Функция СоединениеСОператором(ТаймаутСек = 0) Экспорт
	Таймаут = ?(ТаймаутСек > 0, ТаймаутСек, НастройкаЭДО("ТаймаутHTTPСек"));
	Защита = Новый ЗащищенноеСоединениеOpenSSL(Новый СертификатКлиентаWindows(), Неопределено);
	Возврат Новый HTTPСоединение(ХостAPI(), 443, , , , Таймаут, Защита);
КонецФункции

// Нижняя граница отбора документов к отправке - что позже из двух: дата начала (документ,
// ставший годным задним числом, не выпадет из окна) и глубина в днях (выборка не растет вечно).
Функция НижняяГраницаОтбора(Знач Организация = Неопределено) Экспорт
	Если ЗначениеЗаполнено(Организация) Тогда
		Запись = УчетнаяЗаписьЭДО(Организация);
		ДатаНачала = ?(Запись = Неопределено, Дата(1, 1, 1), Запись.ДатаНачалаОтправки);
	Иначе
		ДатаНачала = РанняяДатаНачалаОтправки();
	КонецЕсли;
	Глубина = НастройкаЭДО("ГлубинаДнейОтправки");
	СкользящаяГраница = НачалоДня(ТекущаяДатаСеанса()) - Глубина * 86400;
	Возврат ?(ЗначениеЗаполнено(ДатаНачала), Макс(ДатаНачала, СкользящаяГраница), СкользящаяГраница);
КонецФункции

// Чего не хватает для работы: массив претензий, пустой - все настроено.
// Нужен и форме настроек, и самой отправке.
Функция НедостающиеНастройкиЭДО() Экспорт

	Претензии = Новый Массив;

	Для Каждого С Из ОписаниеНастроекЭДО() Цикл
		Если НЕ С.Обязательная Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НастройкаЭДО(С.Имя)) Тогда
			Претензии.Добавить("не задано: " + С.Представление);
		КонецЕсли;
	КонецЦикла;

	// Заполненного отпечатка мало: он может указывать на отозванный сертификат. Здесь только локальные
	// проверки (наличие и срок), проверка отзыва - отдельно по кнопке, чтобы очередь не зависела от УЦ.
	Записи = УчетныеЗаписиЭДО();
	Если Записи.Количество() = 0 Тогда
		Претензии.Добавить("не задана учетная запись ЭДО ни для одной организации");
	КонецЕсли;
	Для Каждого Запись Из Записи Цикл
		Для Каждого Претензия Из НедостаткиУчетнойЗаписиЭДО(Запись) Цикл
			Претензии.Добавить(Претензия);
		КонецЦикла;
	КонецЦикла;

	Для Каждого ИмяСвойства Из НедостающиеСвойстваОбъектов() Цикл
		Претензии.Добавить("нет свойства объектов: " + ИмяСвойства);
	КонецЦикла;

	Возврат Претензии;
КонецФункции

// Имена обязательных свойств объектов, которых в базе нет.
Функция НедостающиеСвойстваОбъектов() Экспорт

	Имена = Новый Массив;
	Для Каждого ИмяСвойства Из ОбязательныеСвойстваОбъектов() Цикл
		Свойство = СвойствоОбъектов(ИмяСвойства);
		Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
			Имена.Добавить(ИмяСвойства);
		КонецЕсли;
	КонецЦикла;
	Возврат Имена;

КонецФункции

// Заводит недостающие обязательные свойства, чтобы выкатка версии с новым свойством
// не останавливала очередь до ручного вызова ОбеспечитьСвойстваОбъектов.
// Звать только под замком прогона отправки: параллельный вызов заведет свойство дважды.
// Возврат: Строка для свода прогона; пустая - все свойства были на месте.
Функция ЗавестиНедостающиеСвойстваОбъектов() Экспорт

	Недостающие = НедостающиеСвойстваДляПрогона();
	Если Недостающие.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Итог = ОбеспечитьСвойстваОбъектов();
	Остались = НедостающиеСвойстваДляПрогона();
	Если Остались.Количество() = 0 Тогда
		Текст = "заведены свойства объектов: " + СтрСоединить(Недостающие, ", ");
		ЗаписьЖР("ЭДО.СвойстваОбъектов", "Предупреждение", , , Текст + Символы.ПС + СтрСоединить(Итог, Символы.ПС));
	Иначе
		Текст = "ОШИБКА: не удалось завести свойства объектов " + СтрСоединить(Остались, ", ")
			+ " (" + СтрСоединить(Итог, "; ") + ")";
		ЗаписьЖР("ЭДО.СвойстваОбъектов", "Ошибка", , , Текст);
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Недостающие свойства, без которых не работает прогон отправки: обязательные и, когда
// включена автоотправка УКД, отметка ожидания - иначе корректировки ждали бы паузу вечно.
Функция НедостающиеСвойстваДляПрогона()

	Имена = НедостающиеСвойстваОбъектов();
	Если ЗначениеЗаполнено(ДатаНачалаАвтоотправкиУКД())
		И СвойствоОбъектов(ИмяСвойстваОжиданияУКД()).Пустая() Тогда
		Имена.Добавить(ИмяСвойстваОжиданияУКД());
	КонецЕсли;
	// ЩА 15.10.2026 [yan]: необязательное для отправки, но заводится само при обновлении расширения,
	// иначе сумма в ЭДО молча не появится, пока свойства не заведут руками.
	Если СвойствоОбъектов(ИмяСвойстваСуммыВЭДО()).Пустая() Тогда
		Имена.Добавить(ИмяСвойстваСуммыВЭДО());
	КонецЕсли;
	Возврат Имена;

КонецФункции

// Свойства объектов, без которых расширение работать не может.
Функция ОбязательныеСвойстваОбъектов() Экспорт
	Имена = Новый Массив;
	Имена.Добавить("ЭДО_КодСостояния");
	Имена.Добавить("ЭДО_ИдентификаторДокумента");
	Имена.Добавить("ЭДО_АдресКонтрагента");
	Имена.Добавить("ЭДО_СтатусСвязи");
	Имена.Добавить("ЭДО_Состояние");
	// ручная пометка "отправить", вторая точка входа рядом с печатью
	Имена.Добавить("ЭДО_ПометкаКОтправке");
	// отпечаток отправленного экземпляра и результат сверки с ним
	Имена.Добавить("ЭДО_ОтпечатокОтправки");
	Имена.Добавить("ЭДО_РасхождениеСОтправленным");
	// входящий запрос контрагента на аннулирование: дата и причина
	Имена.Добавить("ЭДО_ЗапросАннулирования");
	Для Каждого ИмяОрг Из СвойстваОрганизации() Цикл
		Имена.Добавить(ИмяОрг);
	КонецЦикла;
	Для Каждого ИмяКА Из СвойстваКонтрагента() Цикл
		Имена.Добавить(ИмяКА);
	КонецЦикла;
	Возврат Имена;
КонецФункции

// Свойства, которые заводятся вместе с обязательными, но без которых отправка работает.
// В обязательные их класть нельзя: проверка настроек остановит очередь до их заведения.
Функция НеобязательныеСвойстваОбъектов() Экспорт
	Имена = Новый Массив;
	Для Каждого Имя Из НеобязательныеСвойстваКонтрагента() Цикл
		Имена.Добавить(Имя);
	КонецЦикла;
	// Режим "по сверке": три поля результата на поступлении, их пишет только СверитьВходящийУПД.
	// Флаг контрагента - в НеобязательныеСвойстваКонтрагента.
	Имена.Добавить("ЭДО_ВходящийИдентификатор");
	Имена.Добавить("ЭДО_ОтклонениеСуммы");
	Имена.Добавить("ЭДО_ПричинаНепринятия");
	// отметка ожидания перед автоотправкой УКД, см. ОтметитьКорректировкиНаПроверке
	Имена.Добавить(ИмяСвойстваОжиданияУКД());
	// состояние фиксации документа в ГИС МТ (пиво), его ведет ОбновитьСтатусыФиксацииГИСМТ
	Имена.Добавить("ЭДО_СтатусГИСМТ");
	// ЩА 15.10.2026 [yan]: сумма экземпляра у оператора, ее ведут точечная сверка и Центр управления
	Имена.Добавить(ИмяСвойстваСуммыВЭДО());
	Возврат Имена;
КонецФункции

// Необязательные свойства, назначаемые контрагенту.
// ФИО покупателя-ИП и дата его последней проверки в ЕГРИП ведет ОбеспечитьРеквизитыИП.
Функция НеобязательныеСвойстваКонтрагента()
	Имена = Новый Массив;
	Имена.Добавить("ЭДО_АвтоматическоеПринятиеУПД");
	Имена.Добавить("ЭДО_КонтрагентФамилия");
	Имена.Добавить("ЭДО_КонтрагентИмя");
	Имена.Добавить("ЭДО_КонтрагентОтчество");
	Имена.Добавить("ЭДО_ЕГРИППроверен");
	Имена.Добавить("ЭДО_СверкаПередПринятиемУПД");
	// ЩА 15.10.2026 [yan]: список автоотправки действует, только когда включена настройка АвтоотправкаТолькоРазрешенным, -
	// в обязательных он останавливал любую отправку в базе, где свойство еще не заведено.
	Имена.Добавить("ЭДО_АвтоотправкаРазрешена");
	Имена.Добавить("ЭДО_АвтоматическоеПринятиеУКД");   // ЩА 15.10.2026 [yan]: УКД - своим флагом, не флагом УПД
	// контрагент не принимает формализованный акт сверки - акт ему уходит печатной формой в PDF
	Имена.Добавить(ИмяСвойстваАктыСверкиВPDF());
	Возврат Имена;
КонецФункции

// Свойства-флаги: тип Булево, но значения старых версий могут лежать строкой "Да".
// Читать только через ФлагСвойстваВключён, писать только через ЗаписатьФлагСвойства: они понимают
// оба представления, и порядок "код, потом миграция типа" безопасен в обе стороны.
Функция БулевыСвойстваОбъектов() Экспорт
	Имена = Новый Массив;
	Имена.Добавить("ЭДО_ОтправкаПриостановлена");
	Имена.Добавить("ЭДО_АдресЗакреплён");
	Имена.Добавить("ЭДО_ПометкаКОтправке");
	Имена.Добавить("ЭДО_АвтоматическоеПринятиеУПД");
	Имена.Добавить("ЭДО_СверкаПередПринятиемУПД");
	Имена.Добавить("ЭДО_АвтоотправкаРазрешена");
	Имена.Добавить("ЭДО_АвтоматическоеПринятиеУКД");   // ЩА 15.10.2026 [yan]
	Имена.Добавить(ИмяСвойстваАктыСверкиВPDF());
	Возврат Имена;
КонецФункции

Функция ИмяСвойстваАктыСверкиВPDF() Экспорт
	Возврат "ЭДО_АктыСверкиВPDF";
КонецФункции

// Включён ли флаг. Понимает Булево и строку ("Да" и любое непустое, кроме "Нет"/"Ложь" -
// их даёт Строка(Ложь) при случайном приведении).
Функция ФлагСвойстваВключён(Знач Значение) Экспорт
	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Текст = ВРег(СокрЛП(Строка(Значение)));
	Если ПустаяСтрока(Текст) ИЛИ Текст = "НЕТ" ИЛИ Текст = "ЛОЖЬ" ИЛИ Текст = "FALSE" ИЛИ Текст = "0" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Записать флаг в представлении, которое допускает тип самого свойства: запись Булево в свойство
// типа Строка (и наоборот) дает ошибку приведения.
Процедура ЗаписатьФлагСвойства(Объект, Свойство, Знач Включён) Экспорт
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат;
	КонецЕсли;
	ЭтоБулево = Ложь;
	Попытка
		ЭтоБулево = Свойство.ТипЗначения.СодержитТип(Тип("Булево"));
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ЗаписатьФлагСвойства: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		ЭтоБулево = Ложь;
	КонецПопытки;
	Если ЭтоБулево Тогда
		ЗаписатьЗначениеСвойства(Объект, Свойство, Включён = Истина);
	Иначе
		ЗаписатьЗначениеСвойства(Объект, Свойство, ?(Включён = Истина, "Да", ""));
	КонецЕсли;
КонецПроцедуры

// Пометить документ к отправке по ЭДО. Единственная точка входа для печатных пакетов (внешних
// обработок в базах): логика здесь, в пакете - одна строка вызова. Прямую запись строки "Да"
// в пакетах не оставлять: в свойство типа Булево она молча ложится строкой, и отбор ее не найдет.
// Ничего не делает, когда свойства нет или пометка уже стоит: печать повторяется много раз.
// Возврат: Булево - поставили ли пометку этим вызовом.
Функция ПометитьКОтправке(Знач Документ) Экспорт

	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		Возврат Ложь;
	КонецЕсли;

	Свойство = СвойствоОбъектов("ЭДО_ПометкаКОтправке");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат Ложь;   // свойство заводит ОбеспечитьСвойстваОбъектов, до тех пор просто молчим
	КонецЕсли;

	Если ФлагСвойстваВключён(ЗначениеСвойстваОбъекта(Документ, Свойство)) Тогда
		Возврат Ложь;
	КонецЕсли;

	ЗаписатьФлагСвойства(Документ, Свойство, Истина);
	Возврат Истина;

КонецФункции

// Свойства, которые назначаются организации. Отправляются документы только организаций, которым
// это разрешено явно; умолчание - запрет, иначе новая организация в базе начнет слать молча.
// Заводя свойство в новой базе, сразу проставь его рабочей организации, иначе отправка встанет.
Функция СвойстваОрганизации() Экспорт
	Имена = Новый Массив;
	Имена.Добавить("ЭДО_РазрешенаОтправка");
	Возврат Имена;
КонецФункции

// Свойства, которые назначаются контрагенту, а не документу: от назначения зависит, увидит ли их
// человек на вкладке "Свойства" карточки. Назначение нужно именно "Справочник "Контрагенты""
// (образец - ЭДО_СтатусСвязи), "Справочники" не годится.
Функция СвойстваКонтрагента() Экспорт
	Имена = Новый Массив;
	Имена.Добавить("ЭДО_ОтправкаПриостановлена");
	Имена.Добавить("ЭДО_ПричинаПаузы");
	// Закрепление адреса и отметка сверки связи. Без ЭДО_АдресЗакреплён адреса 2VO молча
	// не попадают в очередь (УсловиеОтбораКанала), а ЗакрепитьАдресЭДО падает.
	Имена.Добавить("ЭДО_АдресЗакреплён");
	Имена.Добавить("ЭДО_ЗакреплениеОснование");
	Имена.Добавить("ЭДО_СвязьПроверена");
	Возврат Имена;
КонецФункции

// Каким типом заводить свойство: флаги - Булево, остальное - Строка(50): ресурс "Значение"
// регистра ЗначенияСвойствОбъектов длиннее не принимает и режет молча.
Функция ТипСвойстваПоИмени(Знач Имя)
	Для Каждого ИмяФлага Из БулевыСвойстваОбъектов() Цикл
		Если ВРег(СокрЛП(ИмяФлага)) = ВРег(СокрЛП(Имя)) Тогда
			Возврат Новый ОписаниеТипов("Булево");
		КонецЕсли;
	КонецЦикла;
	Возврат Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50, ДопустимаяДлина.Переменная));
КонецФункции

// Привести типы свойств-флагов к Булево вместе с накопленными значениями.
// Вызывается руками, а не при каждом обеспечении: операция меняет данные, и делать её
// незаметным побочным эффектом нельзя.
// Возврат: Массив строк - что сделано.
Функция ПривестиТипыФлагов(Знач ТолькоПроверка = Ложь) Экспорт
	Итог = Новый Массив;
	// Значения всех свойств к переводу - одним запросом, а не запросом на каждое свойство.
	КПереводу = Новый Массив;
	Для Каждого Имя Из БулевыСвойстваОбъектов() Цикл
		Свойство = СвойствоОбъектов(Имя);
		Если Свойство <> Неопределено И НЕ Свойство.Пустая()
			И НЕ Свойство.ТипЗначения.СодержитТип(Тип("Булево")) Тогда
			КПереводу.Добавить(Свойство);
		КонецЕсли;
	КонецЦикла;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Свойство КАК Свойство, Объект КАК Объект, Значение КАК Значение
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Свойство В (&Свойства)");
	Запрос.УстановитьПараметр("Свойства", КПереводу);
	ВсеЗначения = Запрос.Выполнить().Выгрузить();

	Для Каждого Имя Из БулевыСвойстваОбъектов() Цикл
		Свойство = СвойствоОбъектов(Имя);
		Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
			Итог.Добавить(Имя + ": свойства нет");
			Продолжить;
		КонецЕсли;
		Если Свойство.ТипЗначения.СодержитТип(Тип("Булево")) Тогда
			Итог.Добавить(Имя + ": уже Булево");
			Продолжить;
		КонецЕсли;

		Значения = ВсеЗначения.НайтиСтроки(Новый Структура("Свойство", Свойство));
		Если ТолькоПроверка Тогда
			Итог.Добавить(Имя + ": к переводу, значений " + Формат(Значения.Количество(), "ЧГ=0"));
			Продолжить;
		КонецЕсли;

 // Порядок: сначала снять старые значения, потом сменить тип, потом записать булевы.
 // Смена типа при существующих строковых значениях оставляет их нечитаемыми.
		Включённые = Новый Массив;
		Для Каждого Стр Из Значения Цикл
			Если ФлагСвойстваВключён(Стр.Значение) Тогда
				Включённые.Добавить(Стр.Объект);
			КонецЕсли;
			Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
			Набор.Отбор.Объект.Установить(Стр.Объект);
			Набор.Отбор.Свойство.Установить(Свойство);
			Набор.Записать(Истина);
		КонецЦикла;

		ОбъектСвойства = Свойство.ПолучитьОбъект();
		ОбъектСвойства.ТипЗначения = Новый ОписаниеТипов("Булево");
		ОбъектСвойства.Записать();

		Для Каждого Объект Из Включённые Цикл
			ЗаписатьЗначениеСвойства(Объект, Свойство, Истина);
		КонецЦикла;
		Итог.Добавить(Имя + ": переведено в Булево, значений было " + Формат(Значения.Количество(), "ЧГ=0")
			+ ", включённых перенесено " + Формат(Включённые.Количество(), "ЧГ=0"));
	КонецЦикла;
	Возврат Итог;
КонецФункции

// Назначение свойства по первому найденному образцу из списка имён (через запятую).
Функция НазначениеПоОбразцу(Знач ИменаОбразцов)
	Для Каждого Имя Из СтрРазделить(ИменаОбразцов, ",") Цикл
		Образец = СвойствоОбъектов(СокрЛП(Имя));
		Если Образец <> Неопределено И НЕ Образец.Пустая() И ЗначениеЗаполнено(Образец.НазначениеСвойства) Тогда
			Возврат Образец.НазначениеСвойства;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Старые имена свойств -> новые: префиксы вендора (ОФД_ЭДО_, ОФД_КА_, ОФД_ОРГ_) и ПЭДО_ сведены
// к единому ЭДО_. Значения при переименовании не теряются: регистр ссылается на элемент ПВХ.
Функция КартаПереименованияСвойств() Экспорт
	Карта = Новый Соответствие;
	Карта.Вставить("ОФД_ЭДО_ИдентификаторУчастникаЭДО", "ЭДО_АдресКонтрагента");
	Карта.Вставить("ОФД_ЭДО_ИдентификаторДокумента",    "ЭДО_ИдентификаторДокумента");
	Карта.Вставить("ОФД_ЭДО_СтатусДокумента",           "ЭДО_КодСостояния");
	Карта.Вставить("ОФД_ЭДО_СтатусСвязи",               "ЭДО_СтатусСвязи");
	Карта.Вставить("ОФД_ЭДО_СвязьПроверена",            "ЭДО_СвязьПроверена");
	Карта.Вставить("ОФД_ЭДО_АдресЗакреплён",            "ЭДО_АдресЗакреплён");
	Карта.Вставить("ОФД_ЭДО_ЗакреплениеОснование",      "ЭДО_ЗакреплениеОснование");
	Карта.Вставить("ОФД_ЭДО_Фамилия",                   "ЭДО_ПодписантФамилия");
	Карта.Вставить("ОФД_ЭДО_Имя",                       "ЭДО_ПодписантИмя");
	Карта.Вставить("ОФД_ЭДО_Отчество",                  "ЭДО_ПодписантОтчество");
	Карта.Вставить("ОФД_ОРГ_Фамилия",                   "ЭДО_ОргФамилия");
	Карта.Вставить("ОФД_ОРГ_Имя",                       "ЭДО_ОргИмя");
	Карта.Вставить("ОФД_ОРГ_Отчество",                  "ЭДО_ОргОтчество");
	Карта.Вставить("ОФД_ОРГ_Должность",                 "ЭДО_ОргДолжность");
	Карта.Вставить("ОФД_КА_Фамилия",                    "ЭДО_КонтрагентФамилия");
	Карта.Вставить("ОФД_КА_Имя",                        "ЭДО_КонтрагентИмя");
	Карта.Вставить("ОФД_КА_Отчество",                   "ЭДО_КонтрагентОтчество");
	Карта.Вставить("ПЭДО_ПометкаКОтправке",            "ЭДО_ПометкаКОтправке");
	Карта.Вставить("ПЭДО_ОтправкаПриостановлена",      "ЭДО_ОтправкаПриостановлена");
	Карта.Вставить("ПЭДО_ПричинаПаузы",                "ЭДО_ПричинаПаузы");
	Карта.Вставить("ПЭДО_Статус",                      "ЭДО_Состояние");
	Возврат Карта;
КонецФункции

// Переименовать свойства, оставшиеся со старыми именами. Идемпотентно.
// Звать первым делом в ОбеспечитьСвойстваОбъектов: иначе свойства заведутся заново пустыми,
// а история значений останется в старых элементах ПВХ.
Функция ПереименоватьСвойстваПодНовуюСхему() Экспорт
	Итог = Новый Массив;
	Для Каждого КЗ Из КартаПереименованияСвойств() Цикл
		Старое = СвойствоОбъектов(КЗ.Ключ);
		Если Старое = Неопределено ИЛИ Старое.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		Новое = СвойствоОбъектов(КЗ.Значение);
		Если Новое <> Неопределено И НЕ Новое.Пустая() Тогда
 // новое уже есть - старое переименовывать некуда, разбирать руками
			Итог.Добавить("КОНФЛИКТ: есть и " + КЗ.Ключ + ", и " + КЗ.Значение);
			Продолжить;
		КонецЕсли;
		Попытка
			Объект = Старое.ПолучитьОбъект();
			Объект.Наименование = КЗ.Значение;
			Объект.ОбменДанными.Загрузка = Истина;   // иначе "Не удалось записать" без объяснений
			Объект.Записать();
			Итог.Добавить(КЗ.Ключ + " -> " + КЗ.Значение);
		Исключение
			Итог.Добавить("НЕ УДАЛОСЬ переименовать " + КЗ.Ключ + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Возврат Итог;
КонецФункции

// Завести недостающие свойства объектов. Идемпотентно: существующие не трогает.
// Возврат: Массив строк - что сделано.
Функция ОбеспечитьСвойстваОбъектов() Экспорт

	Итог = ПереименоватьСвойстваПодНовуюСхему();

	// Назначение свойства берем у существующего свойства ЭДО, а не ищем по имени объекта метаданных:
	// в разных базах справочник назначений называется по-разному. Образец обязан быть из той же
	// группы (документ или контрагент), иначе свойство не видно в карточке.
	НазначениеДок = НазначениеПоОбразцу("ЭДО_Состояние,ЭДО_КодСостояния,ЭДО_ИдентификаторДокумента");
	НазначениеКА  = НазначениеПоОбразцу("ЭДО_СтатусСвязи,ЭДО_СвязьПроверена,ЭДО_АдресКонтрагента");
	СвойстваКА = Новый Соответствие;
	Для Каждого ИмяКА Из СвойстваКонтрагента() Цикл
		СвойстваКА.Вставить(ИмяКА, Истина);
	КонецЦикла;
	Для Каждого ИмяКА Из НеобязательныеСвойстваКонтрагента() Цикл
		СвойстваКА.Вставить(ИмяКА, Истина);
	КонецЦикла;

	Заводимые = ОбязательныеСвойстваОбъектов();
	Для Каждого Имя Из НеобязательныеСвойстваОбъектов() Цикл
		Заводимые.Добавить(Имя);
	КонецЦикла;
	// Реквизита Категория нет в части редакций, и запись в него роняет заведение всех свойств.
	ЕстьКатегория = Метаданные.ПланыВидовХарактеристик.СвойстваОбъектов.Реквизиты.Найти("Категория") <> Неопределено;

	Для Каждого Имя Из Заводимые Цикл
		Свойство = СвойствоОбъектов(Имя);
		Если Свойство <> Неопределено И НЕ Свойство.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Объект = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
			Объект.Наименование = Имя;
			Назначение = ?(СвойстваКА.Получить(Имя) = Неопределено, НазначениеДок, НазначениеКА);
			Если Назначение <> Неопределено Тогда
				Объект.НазначениеСвойства = Назначение;
			КонецЕсли;
			Если ЕстьКатегория Тогда
				Объект.Категория = Ложь;
			КонецЕсли;
			Объект.ТипЗначения = ТипСвойстваПоИмени(Имя);
			Объект.Записать();
			Итог.Добавить("заведено: " + Имя);
		Исключение
			Итог.Добавить("НЕ УДАЛОСЬ завести " + Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Для Каждого СтрокаИтога Из ОбеспечитьСвойстваСвязиОрганизаций() Цикл
		Итог.Добавить(СтрокаИтога);
	КонецЦикла;

	Если Итог.Количество() = 0 Тогда
		Итог.Добавить("все обязательные свойства уже есть");
	КонецЕсли;
	Возврат Итог;
КонецФункции

// Перенести настройки из персонального хранения в общее для баз, настроенных по старой схеме.
// Идемпотентна.
Функция ПеренестиНастройкиВОбщие() Экспорт
	ПроверитьПравоМенятьНастройкиЭДО();   // ЩА 19.10.2026 [yan]: пишет в общий раздел
	// Общие настройки лежат под пользователем "": для обычного пользователя это чужой слот, без привилегий - «Нарушение прав доступа».
	УстановитьПривилегированныйРежим(Истина);

	Итог = Новый Массив;

	Для Каждого С Из ОписаниеНастроекЭДО() Цикл
		Общее = ПрочитатьНастройкуХранилища("ОФД_ЭДО_НастройкиОбработки", С.Имя, "");
		Если ЗначениеЗаполнено(Общее) Тогда
			Продолжить;
		КонецЕсли;
		Значение = НастройкаЭДО(С.Имя);
		Если НЕ ЗначениеЗаполнено(Значение) ИЛИ Значение = С.ПоУмолчанию Тогда
			Продолжить;
		КонецЕсли;
		ЗаписатьОбщуюНастройкуЭДО(С.Имя, Значение);
		Итог.Добавить("перенесено в общие: " + С.Имя);
	КонецЦикла;

	// клиентские настройки движка вендора живут своим ключом и в реестр не входят
	Если НЕ ЗначениеЗаполнено(ПрочитатьНастройкуХранилища("ОФД_ЭДО_НастройкиОбработки", "КлиентскиеНастройки", "")) Тогда
		Значение = ПрочитатьНастройкуХранилища("ОФД_ЭДО_НастройкиОбработки", "КлиентскиеНастройки", Неопределено);
		Если ЗначениеЗаполнено(Значение) Тогда
			ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", "КлиентскиеНастройки", Значение, , "");
			Итог.Добавить("перенесено в общие: КлиентскиеНастройки");
		КонецЕсли;
	КонецЕсли;

	Если Итог.Количество() = 0 Тогда
		Итог.Добавить("переносить нечего - всё уже в общих");
	КонецЕсли;
	Возврат Итог;
КонецФункции

// Установленные сертификаты подписи, видимые серверному контексту (учетной записи службы
// кластера): подписывает рабочий процесс, сертификат на клиенте отправке не поможет.
// Возврат: ТаблицаЗначений (Отпечаток Строка base64, Представление, Субъект,
// ДействителенС Дата, ДействителенПо Дата).
Функция УстановленныеСертификатыПодписи() Экспорт

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Отпечаток");
	Т.Колонки.Добавить("Представление");
	Т.Колонки.Добавить("Субъект");
	Т.Колонки.Добавить("ДействителенС");
	Т.Колонки.Добавить("ДействителенПо");

	Попытка
		МенеджерКриптографии = Новый МенеджерКриптографии("", "", 80);
		Хранилище = МенеджерКриптографии.ПолучитьХранилищеСертификатов(
			ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
		Сертификаты = Хранилище.ПолучитьВсе();
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "УстановленныеСертификатыПодписи: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
 // крипто на сервере не поднято - пустой список честнее исключения в форме
		Возврат Т;
	КонецПопытки;

	Для Каждого Сертификат Из Сертификаты Цикл
		Строка = Т.Добавить();
		Строка.Отпечаток      = ОчиститьBase64(Base64Строка(Сертификат.Отпечаток));
		Строка.Субъект        = ПредставлениеСубъектаСертификата(Сертификат);
		Строка.ДействителенС  = Сертификат.ДатаНачала;
		Строка.ДействителенПо = Сертификат.ДатаОкончания;
		Строка.Представление  = Строка.Субъект + " - до "
			+ Формат(Строка.ДействителенПо, "ДФ=dd.MM.yyyy")
			+ ?(Строка.ДействителенПо < ТекущаяДатаСеанса(), " (ПРОСРОЧЕН)", "");
	КонецЦикла;

	Т.Сортировать("ДействителенПо Убыв");
	Возврат Т;
КонецФункции

// Диагностика подписи одной строкой: что сервер видит и чем готов подписывать. Возвращает текст,
// а не коллекции: мост COMPowerShell на таблицах значений спотыкается.
// ПроверятьОтзыв - сетевая проверка по CRL/OCSP, по умолчанию выключена.
Функция ДиагностикаПодписи(Знач ПроверятьОтзыв = Ложь) Экспорт

	Строки = Новый Массив;
	Таблица = УстановленныеСертификатыПодписи();
	Строки.Добавить("сертификатов у учётки сервера: " + Таблица.Количество());
	Для Каждого С Из Таблица Цикл
		Строки.Добавить("  " + С.Отпечаток + "  " + С.Представление);
	КонецЦикла;

	Если Таблица.Количество() > 0 Тогда
		Попытка
			МК = Новый МенеджерКриптографии("", "", 80);
			Хр = МК.ПолучитьХранилищеСертификатов(
				ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
			Образец = Хр.НайтиПоОтпечатку(Base64Значение(Таблица[0].Отпечаток));
			Если Образец <> Неопределено Тогда
				Строки.Добавить("поля субъекта: " + ПоляСубъектаСертификата(Образец));
			КонецЕсли;
		Исключение
			ЗаписьЖР("ЭДО.ДиагностикаПодписи", "Предупреждение", , , "Не прочитаны поля субъекта: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	Состояние = СостояниеСертификатаПодписанта(ПроверятьОтзыв);
	Строки.Добавить("подписант: задан=" + Состояние.Задан + " найден=" + Состояние.Найден
		+ " просрочен=" + Состояние.Просрочен + " отозван=" + Состояние.Отозван);
	Строки.Добавить("  " + Состояние.Субъект);
	Строки.Добавить("  " + Состояние.Описание);

	Недостающее = НедостающиеНастройкиЭДО();
	Строки.Добавить("недостающих настроек: " + Недостающее.Количество());
	Для Каждого Н Из Недостающее Цикл
		Строки.Добавить("  • " + Н);
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

// Состояние сертификата подписанта: найден ли, срок, отзыв.
// ПроверятьОтзыв ходит к УЦ (CRL/OCSP), поэтому вынесен в параметр: НедостающиеНастройкиЭДО
// зовется на каждый документ очереди, и зависеть от доступности УЦ отправка не должна.
// Возврат: Структура (Задан, Найден, Субъект, ДействителенПо, ДнейОсталось, Просрочен,
// ОтзывПроверялся, Отозван, Описание).
Функция СостояниеСертификатаПодписанта(Знач ПроверятьОтзыв = Ложь, Знач Организация = Неопределено) Экспорт
	Возврат СостояниеСертификатаПоОтпечатку(ОтпечатокПодписанта(Организация), ПроверятьОтзыв);
КонецФункции

// То же для произвольного отпечатка: форме настроек нужно показать сертификат, который еще
// не записан. Подменять ради этого общую настройку нельзя - подмену видят все сеансы.
Функция СостояниеСертификатаПоОтпечатку(Знач Отпечаток, Знач ПроверятьОтзыв = Ложь) Экспорт

	Состояние = Новый Структура(
		"Задан, Найден, Субъект, ДействителенПо, ДнейОсталось, Просрочен, ОтзывПроверялся, Отозван, Описание",
		Ложь, Ложь, "", '00010101', 0, Ложь, Ложь, Ложь, "");

	Отпечаток = СокрЛП(Отпечаток);
	Если НЕ ЗначениеЗаполнено(Отпечаток) Тогда
		Состояние.Описание = "отпечаток подписанта не задан";
		Возврат Состояние;
	КонецЕсли;
	Состояние.Задан = Истина;

	Попытка
		МенеджерКриптографии = Новый МенеджерКриптографии("", "", 80);
		Хранилище = МенеджерКриптографии.ПолучитьХранилищеСертификатов(
			ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
		Сертификат = Хранилище.НайтиПоОтпечатку(Base64Значение(Отпечаток));
	Исключение
		Состояние.Описание = "не удалось обратиться к хранилищу сертификатов: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Состояние;
	КонецПопытки;

	Если Сертификат = Неопределено Тогда
		Состояние.Описание = "сертификат с таким отпечатком не установлен у учётки сервера 1С";
		Возврат Состояние;
	КонецЕсли;

	Состояние.Найден         = Истина;
	Состояние.Субъект        = ПредставлениеСубъектаСертификата(Сертификат);
	Состояние.ДействителенПо = Сертификат.ДатаОкончания;
	Состояние.ДнейОсталось   = Цел((НачалоДня(Сертификат.ДатаОкончания) - НачалоДня(ТекущаяДатаСеанса())) / 86400);
	Состояние.Просрочен      = Сертификат.ДатаОкончания < ТекущаяДатаСеанса();

	Если Состояние.Просрочен Тогда
		Состояние.Описание = "сертификат ПРОСРОЧЕН " + Формат(Сертификат.ДатаОкончания, "ДФ=dd.MM.yyyy");
	Иначе
		Состояние.Описание = "действует до " + Формат(Сертификат.ДатаОкончания, "ДФ=dd.MM.yyyy")
			+ " (" + Состояние.ДнейОсталось + " дн.)";
	КонецЕсли;

	Если НЕ ПроверятьОтзыв Тогда
		Возврат Состояние;
	КонецЕсли;

	Состояние.ОтзывПроверялся = Истина;
	Попытка
		МенеджерКриптографии.ПроверитьСертификат(Сертификат);
		Состояние.Описание = Состояние.Описание + "; отзыв проверен - сертификат действителен";
	Исключение
		Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
 // Отличать "отозван" от "не смогли проверить" обязательно: второе - про сеть
 // и доступность УЦ, и объявлять по нему ключ негодным нельзя.
		Если ПризнакОтзываСертификата(Текст) Тогда
			Состояние.Отозван = Истина;
			Состояние.Описание = Состояние.Описание + "; 🔴 СЕРТИФИКАТ ОТОЗВАН - " + Текст;
		Иначе
			Состояние.ОтзывПроверялся = Ложь;
			Состояние.Описание = Состояние.Описание
				+ "; отзыв проверить не удалось (это НЕ значит «отозван»): " + Текст;
		КонецЕсли;
	КонецПопытки;

	Возврат Состояние;
КонецФункции

#КонецОбласти


// Параметры интеграции: хост оператора.
Функция ПараметрыИнтеграции() Экспорт
	П = Новый Структура;
	// Хост можно переопределить настройкой, не пересобирая расширение.
	П.Вставить("Хост", ХостAPI());
	// Движок и настройки маппинга лежат макетами расширения (обработка ЭДО_Помощник), а не файлами
	// на сервере: иначе на другом сервере 1С отправка падает на "файл не найден".
	Возврат П;
КонецФункции

// Двоичный макет расширения (движок формирования XML).
Функция МакетДвоичный(Имя)
	Возврат Обработки[ИмяОбработкиПомощника()].ПолучитьМакет(Имя);
КонецФункции

// Текстовый макет расширения (настройки маппинга, XSD).
Функция МакетТекст(Имя)
	Возврат Обработки[ИмяОбработкиПомощника()].ПолучитьМакет(Имя).ПолучитьТекст();
КонецФункции

Функция ИмяОбработкиПомощника()
	Возврат "ЭДО_Помощник";
КонецФункции

// Наименование вида контактной информации, фактически используемого в этой базе. Маппинг
// соединяется с регистром по наименованию вида, и при чужом имени адрес выгружается пустым,
// а оператор получателя бракует документ.
Функция НаименованиеВидаКИ(Знач НачалоИмени, Знач ПоОрганизациям) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	КИ.Вид.Наименование КАК Наим,
	               |	КОЛИЧЕСТВО(*) КАК Кол
	               |ИЗ
	               |	РегистрСведений.КонтактнаяИнформация КАК КИ
	               |ГДЕ
	               |	КИ.Вид.Наименование ПОДОБНО &Маска
	               |	И ВЫБОР КОГДА &ПоОрганизациям
	               |			ТОГДА ВЫРАЗИТЬ(КИ.Объект КАК Справочник.Организации) ЕСТЬ НЕ NULL
	               |		ИНАЧЕ ВЫРАЗИТЬ(КИ.Объект КАК Справочник.Контрагенты) ЕСТЬ НЕ NULL
	               |	КОНЕЦ
	               |СГРУППИРОВАТЬ ПО
	               |	КИ.Вид.Наименование
	               |УПОРЯДОЧИТЬ ПО
	               |	Кол УБЫВ";
	Запрос.УстановитьПараметр("Маска", НачалоИмени + "%");
	Запрос.УстановитьПараметр("ПоОрганизациям", ПоОрганизациям);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Наим;
	КонецЕсли;
	Возврат "";
КонецФункции

// Текст настройки маппинга реализации, подогнанный под ЭТУ базу.
Функция ТекстНастройкиРеализации() Экспорт

	Текст = МакетТекст("НастройкаРеализация");

	// 1. признак маркируемого товара: в части конфигураций реквизита нет вовсе
	// (фактическая маркировка определяется кодами в ТЧ ШтрихкодыУпаковок, а не флагом)
	Если Метаданные.Документы.РеализацияТоваровУслуг.Реквизиты.Найти("СодержитМаркируемыйТовар") = Неопределено Тогда
		Текст = СтрЗаменить(Текст,
			"РТУ.СодержитМаркируемыйТовар      КАК СодержитМаркируемыйТовар",
			"ЛОЖЬ                              КАК СодержитМаркируемыйТовар");
	КонецЕсли;

	// 2. фактические наименования видов контактной информации
	Текст = ПодставитьВидыКонтактнойИнформации(Текст);

	// 3. контактная информация договоров: в части конфигураций тип ДоговорыКонтрагентов не входит
	// в измерение Объект регистра КонтактнаяИнформация, и ВЫРАЗИТЬ к нему роняет весь запрос маппинга.
	// Соединение гасим условием 1 = 0: псевдоним остается, поля приходят NULL, и адрес берется
	// из фактического адреса контрагента.
	ТипДоговора = Тип("СправочникСсылка.ДоговорыКонтрагентов");
	ИзмерениеОбъект = Метаданные.РегистрыСведений.КонтактнаяИнформация.Измерения.Найти("Объект");
	Если ИзмерениеОбъект = Неопределено ИЛИ НЕ ИзмерениеОбъект.Тип.СодержитТип(ТипДоговора) Тогда
		Текст = СтрЗаменить(Текст,
			"ВЫРАЗИТЬ(АдрФактДог.Объект КАК Справочник.ДоговорыКонтрагентов) = РТУ.ДоговорКонтрагента",
			"1 = 0");
	КонецЕсли;

	// 4. ставки НДС, которых в этой конфигурации нет (5, 7, 22 процента и расчетные): ЗНАЧЕНИЕ()
	// отсутствующего значения роняет весь запрос маппинга. Вырезаем только строки КОГДА с такими ставками.
	МетаСтавки = Метаданные.Перечисления.Найти("СтавкиНДС");
	Если МетаСтавки <> Неопределено Тогда
		МассивСтрок = СтрРазделить(Текст, Символы.ПС);
		Оставшиеся = Новый Массив;
		Для Каждого СтрокаТекста Из МассивСтрок Цикл
			Пропустить = Ложь;
			ПозицияЗначения = Найти(СтрокаТекста, "Перечисление.СтавкиНДС.");
			Если ПозицияЗначения > 0 Тогда
				Хвост = Сред(СтрокаТекста, ПозицияЗначения + СтрДлина("Перечисление.СтавкиНДС."));
				ИмяЗначения = "";
				Для НомерСимвола = 1 По СтрДлина(Хвост) Цикл
					ТекущийСимвол = Сред(Хвост, НомерСимвола, 1);
					Если ТекущийСимвол = ")" Тогда
						Прервать;
					КонецЕсли;
					ИмяЗначения = ИмяЗначения + ТекущийСимвол;
				КонецЦикла;
				Если ЗначениеЗаполнено(ИмяЗначения)
					И МетаСтавки.ЗначенияПеречисления.Найти(ИмяЗначения) = Неопределено Тогда
					Пропустить = Истина;
				КонецЕсли;
			КонецЕсли;
			Если НЕ Пропустить Тогда
				Оставшиеся.Добавить(СтрокаТекста);
			КонецЕсли;
		КонецЦикла;
		Текст = СтрСоединить(Оставшиеся, Символы.ПС);
	КонецЕсли;

	// 5. коды маркировки: ТЧ ШтрихкодыУпаковок нетиповая, и без нее падает весь маппинг (ВТМарк
	// строится на каждой отправке). Блоки размечены в макете маркерами и гасятся целиком: ВТМарк -
	// пустая заглушка с теми же колонками, гейт неразобранных кодов - Ложь.
	Если Метаданные.Документы.РеализацияТоваровУслуг.ТабличныеЧасти.Найти("ШтрихкодыУпаковок") = Неопределено Тогда
		Текст = ЗаменитьМеждуМаркерами(Текст, "// ПЭДО:ВТМАРК:НАЧАЛО", "// ПЭДО:ВТМАРК:КОНЕЦ",
			"ВЫБРАТЬ ПЕРВЫЕ 0
			|	ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка) КАК Ссылка,
			|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)         КАК Номенклатура,
			|	"""" КАК ГТИН,
			|	0 КАК КодовВСтроке
			|ПОМЕСТИТЬ ВТМарк
			|;");
		Текст = ЗаменитьМеждуМаркерами(Текст, "// ПЭДО:ГЕЙТМАРК:НАЧАЛО", "// ПЭДО:ГЕЙТМАРК:КОНЕЦ",
			"РезультатВыполненияКода = Ложь;");
	КонецЕсли;

	// точка расширения 3: правки маппинга под конкретную базу - ПОСЛЕ автоопределения выше
	Если ПрофильБазыПодключен() Тогда
		Парам = Новый Структура("Текст", Текст);
		ВызватьТочкуПрофиля("ПриФормированииНастройкиРеализации", Парам);
		Текст = Парам.Текст;
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Формат выгрузки по типу документа: реализация - ON_NSCHFDOPPR (УПД 5.03), корректировка -
// ON_NKORSCHFDOPPR (УКД 5.01, действующая редакция: проверено XSD поставки и оператором).
Функция ФорматВыгрузкиДокумента(Знач Ссылка) Экспорт
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		Возврат "ON_NKORSCHFDOPPR";
	КонецЕсли;
	Возврат "ON_NSCHFDOPPR";
КонецФункции

// Текст настройки маппинга корректировки реализации (УКД), подогнанный под эту базу.
Функция ТекстНастройкиКорректировки() Экспорт

	Возврат ПодставитьВидыКонтактнойИнформации(МакетТекст("НастройкаКорректировка"));

КонецФункции

// Заменяет в тексте настройки наименования видов адресов на те, что заполнены в этой базе.
Функция ПодставитьВидыКонтактнойИнформации(Знач Текст)

	Замены = Новый Соответствие;
	Замены.Вставить("Юридический адрес организации", НаименованиеВидаКИ("Юридический адрес", Истина));
	Замены.Вставить("Фактический адрес организации", НаименованиеВидаКИ("Фактический адрес", Истина));
	Замены.Вставить("Юридический адрес контрагента", НаименованиеВидаКИ("Юридический адрес", Ложь));
	Замены.Вставить("Фактический адрес контрагента", НаименованиеВидаКИ("Фактический адрес", Ложь));
	Для Каждого КлючЗначение Из Замены Цикл
		Если ЗначениеЗаполнено(КлючЗначение.Значение) И КлючЗначение.Значение <> КлючЗначение.Ключ Тогда
			Текст = СтрЗаменить(Текст, """" + КлючЗначение.Ключ + """", """" + КлючЗначение.Значение + """");
		КонецЕсли;
	КонецЦикла;

	Возврат Текст;

КонецФункции

// Текст настройки конфигурации, подогнанный под эту базу: без реквизита СодержитМаркируемыйТовар
// форма движка падает на открытии ("Поле не найдено").
Функция ТекстНастройкиКонфигурации() Экспорт

	Текст = МакетТекст("НастройкаКонфигурация");

	Если Метаданные.Документы.РеализацияТоваровУслуг.Реквизиты.Найти("СодержитМаркируемыйТовар") = Неопределено Тогда
		Текст = СтрЗаменить(Текст,
			"РеализацияТоваровУслуг.СодержитМаркируемыйТовар КАК ДокументСодержитМаркируемыйТовар",
			"ЛОЖЬ КАК ДокументСодержитМаркируемыйТовар");
	КонецЕсли;

	// точка расширения 2: правки запроса списка документов под конкретную базу
	Если ПрофильБазыПодключен() Тогда
		Парам = Новый Структура("Текст", Текст);
		ВызватьТочкуПрофиля("ПриФормированииНастройкиКонфигурации", Парам);
		Текст = Парам.Текст;
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Программная отправка ОДНОГО документа по ЭДО - ПОЛНЫЙ цикл на сервере.
// Годится для вызова из фона/регламента/ОбработкиПроведения (клиент не нужен).
// Контекст - результат НовыйКонтекстПрогона(); при Неопределено собирается свой.
// Возврат: Структура (Ссылка, Статус, ИдДокумента, Сообщение),
// Статус из "Отправлен" | "ТребуетВнимания" | "Отсеян" | "Ошибка".
Функция ОтправитьПоЭДО(Ссылка, Контекст = Неопределено, Знач Разрешения = Неопределено) Экспорт
	Результат = Новый Структура("Ссылка, Статус, ИдДокумента, Сообщение, КодПричины",
		Ссылка, "", "", "", "");

	// 1) Готовность (проведён + идентификатор ЭДО контрагента) - до любого обращения к API
	Готовность = ПроверитьГотовностьКОтправке(Ссылка, Разрешения);
	Если НЕ Готовность.Готов Тогда
 // "Отправлять не надо" - не ошибка: розничная продажа (контрагент - наша же организация) в ЭДО
 // не поедет никогда. Помечаем документ и снимаем с очереди, чтобы он не маскировал настоящие ошибки.
		Если Готовность.ОтправкаНеТребуется Тогда
			ЗаписатьЧитаемыйСтатус(Ссылка, ТекстСтатусаОтправкаНеТребуется());
			Результат.Статус = "Отсеян";
		Иначе
			Результат.Статус = "ТребуетВнимания";
		КонецЕсли;
		Результат.Сообщение = Готовность.Причина;
		Результат.КодПричины = Готовность.КодПричины;
		Возврат Результат;
	КонецЕсли;

	// 1) Прерванная отправка разбирается сама: код 10 иначе выводит документ из потока
	// навсегда. Ручное снятие остаётся аварийным ходом, см. РазобратьПрерваннуюОтправку.
	Прерванная = РазобратьПрерваннуюОтправку(Ссылка);
	Если Прерванная.Решено И ЗначениеЗаполнено(Прерванная.Ид) Тогда
		Результат.Статус = "Пропущен";
		Результат.ИдДокумента = Прерванная.Ид;
		Результат.Сообщение = Прерванная.Сообщение;
		Возврат Результат;
	ИначеЕсли НЕ Прерванная.Решено И ЗначениеЗаполнено(Прерванная.Сообщение) Тогда
		Результат.Статус = "ТребуетВнимания";
		Результат.Сообщение = Прерванная.Сообщение;
		Возврат Результат;
	КонецЕсли;

	// 1б) ЩА 20.10.2026 [yan]: прежний экземпляр аннулирован или отклонен, а его фиксация в ЧЗ действует -
	// новый получил бы ERROR_276 своей же фиксацией. Отмену подаем сами, документ держим до ее выполнения.
	// Человек вправе отправить и так (ГейтПреодолимОператором): у него может быть подтверждение, что марки свободны.
	Если НЕ РазрешеноОператором(Разрешения, "ОтправитьПриФиксацииПрежнегоЭкземпляра") Тогда
		// Перехват обоснован: сбой связи с оператором в гейте не должен обрывать весь пакет отправки -
		// документ откладывается с причиной, подробности в ЖР.
		Попытка
			ПрепятствиеФиксацией = ПрепятствиеФиксациейПрежнегоЭкземпляра(Ссылка);
		Исключение
			ЗаписьЖурналаРегистрации("ЭДО.ГИСМТ", УровеньЖурналаРегистрации.Ошибка, , Ссылка,
				"Проверка фиксации прежнего экземпляра не выполнена: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ПрепятствиеФиксацией = "Не проверена фиксация в ЧЗ прежнего экземпляра ("
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ") - отправка отложена";
		КонецПопытки;
		Если ЗначениеЗаполнено(ПрепятствиеФиксацией) Тогда
			Результат.Статус = "ТребуетВнимания";
			Результат.Сообщение = ПрепятствиеФиксацией;
			Результат.КодПричины = "ФиксацияПрежнегоЭкземпляра";
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	// 1a) Занимаем документ до любого обращения к API: отметка после успеха не защищает
	// от параллельного прогона, и оба отправили бы свой экземпляр.
	Занятие = ЗанятьДокументКОтправке(Ссылка);
	Если НЕ Занятие.Занят Тогда
		Результат.Статус = "Пропущен";
		Результат.Сообщение = Занятие.Причина;
		Возврат Результат;
	КонецЕсли;

	// С этой точки документ занят (статус 1) и начинаются обращения к API. Таймаут прилетает
	// исключением, а POST мог успеть создать документ у оператора. Правило: если состояние
	// у оператора неизвестно, документ не освобождаем, а ставим статус 10: сторож брошенных
	// отметок снимает его только после сверки с оператором, и повтор не создаст второй экземпляр.
	ИдСозданного = "";
	Попытка

	Организация = ОрганизацияДокумента(Ссылка);

	// 2) Токен авторизации (0a+0b целиком на сервере: подпись и POST идут подряд - ts живёт секунды)
	ОтметитьШагОтправки("токен авторизации", Ссылка);   // ЩА 14.10.2026 [yan]
	Если НЕ ОбеспечитьТокен(Ложь, Организация) Тогда
		ОсвободитьДокумент(Ссылка);
		Результат.Статус = "Ошибка";
		Результат.Сообщение = "Не удалось получить токен авторизации (КЭП на сервере/подпись)";
		Возврат Результат;
	КонецЕсли;

	// 2a) Нет ли у оператора живого экземпляра для этого же получателя. Занятие защищает от
	// параллельных прогонов, но не от переотправки, поэтому источник правды - карточки оператора.
	// Дубль - тот же номер, дата и получатель; на другой адрес тот же документ слать законно.
	ОтметитьШагОтправки("проверка экземпляра у оператора", Ссылка);   // ЩА 14.10.2026 [yan]
	Дубль = ЖивойЭкземплярУОператора(Ссылка);
	// Экземпляр в SENT получателю не доставлен. Повтор разрешает только человек при ручной отправке:
	// автоматика дубль не шлет никогда, а у абонентов 2VO и 2LT статус SENT бывает окончательным.
	Недоставлен = Дубль.Найден И ТипЗнч(Разрешения) = Тип("Структура")
		И ВРег(СокрЛП(Дубль.Статус)) = "SENT";
	Если Недоставлен И РазрешеноОператором(Разрешения, "ОтправитьПриНедоставленномЭкземпляре") Тогда
		ЗаписьЖР("ЭДО.ОтправкаПриНедоставленном", "Предупреждение", Ссылка.Метаданные(), Ссылка,
			"Документ отправлен повторно при недоставленном экземпляре " + Дубль.Ид + " по решению пользователя");
	ИначеЕсли Недоставлен Тогда
		ОсвободитьДокумент(Ссылка);
		Результат.Статус = "ТребуетВнимания";
		Результат.КодПричины = "НедоставленныйЭкземпляр";
		Результат.ИдДокумента = Дубль.Ид;
		Результат.Сообщение = "У оператора уже есть экземпляр этого документа (ид " + Дубль.Ид
			+ "), но получателю он не доставлен: статус SENT";
		Возврат Результат;
	ИначеЕсли Дубль.Найден Тогда
 // Экземпляр уже есть - приводим базу в соответствие с оператором и снимаем с очереди.
		ЗаписатьСтатусЭДО(Ссылка, 40, Дубль.Ид);
		ЗаписатьЧитаемыйСтатус(Ссылка, "Уже отправлен этому получателю");
		Результат.Статус = "Пропущен";
		Результат.ИдДокумента = Дубль.Ид;
		Если Дубль.Адрес = ВРег(СокрЛП(ИдентификаторУчастникаЭДО(Ссылка.Контрагент))) Тогда
			Результат.Сообщение = "У оператора уже есть экземпляр этого документа для того же"
				+ " получателя (ид " + Дубль.Ид + ", " + Дубль.Статус + ") - повтор дал бы дубль";
		Иначе
			Результат.Сообщение = "Контрагент уже подписал экземпляр этого документа на прежнем адресе "
				+ Дубль.Адрес + " (ид " + Дубль.Ид + ") - повтор на новый адрес дал бы дубль";
		КонецЕсли;
		Возврат Результат;
	ИначеЕсли НЕ Дубль.Опрошено Тогда
 // Молчание оператора - не разрешение слать: документ освобождается и вернется в очередь
 // следующим прогоном.
		ОсвободитьДокумент(Ссылка);
		Результат.Статус = "ТребуетВнимания";
		Результат.Сообщение = "Не удалось проверить у оператора, не отправлялся ли документ ранее"
			+ ?(ЗначениеЗаполнено(Дубль.Причина), " (" + Дубль.Причина + ")", "")
			+ " - отправка отложена";
		Возврат Результат;
	КонецЕсли;

	Если Дубль.НаПрежнемАдресе <> Неопределено Тогда
		ЗаписьЖР("ЭДО.ОтправкаПриЭкземпляреНаПрежнемАдресе", "Информация", Ссылка.Метаданные(), Ссылка,
			"На прежнем адресе " + Дубль.НаПрежнемАдресе.Адрес + " есть неподписанный экземпляр "
			+ Дубль.НаПрежнемАдресе.Ид + " (" + Дубль.НаПрежнемАдресе.Статус + "), отправляем на текущий адрес");
	КонецЕсли;

	// 3) Подготовка XML + ФЛК, один перевыпуск токена по 401. Контекст собирается здесь, а не
	// в начале: документу, отсеянному проверкой готовности или занятием, движок не нужен.
	Если Контекст = Неопределено Тогда
		Контекст = НовыйКонтекстПрогона();
	КонецЕсли;
	// Контекст общий на пакет - метку сбрасываем на каждый документ.
	Контекст.Вставить("ЗапросКОператоруУшел", Ложь);
	// ФИО покупателя-ИП нужно маппингу до сборки XML: без него документ уходит без имени покупателя.
	ОбеспечитьРеквизитыИП(Ссылка.Контрагент, Контекст);
	// ++ ЩА 20.10.2026 [yan]: покупатель-ИП без ФИО уходит запасной веткой СвФЛУч (как физлицо) -
	// Честный знак не находит ИНН получателя и отклоняет фиксацию (ERROR_71 recipientInn), а
	// получатель такой УПД отклоняет. ФИО не пришло - документ ждет следующего прогона.
	ПричинаИП = ПричинаНетФИОПокупателяИП(Ссылка.Контрагент);
	Если ЗначениеЗаполнено(ПричинаИП) Тогда
		ОсвободитьДокумент(Ссылка);
		Результат.Статус = "ТребуетВнимания";
		Результат.Сообщение = ПричинаИП;
		Возврат Результат;
	КонецЕсли;
	// -- ЩА 20.10.2026 [yan].
	ОтметитьШагОтправки("подготовка XML и ФЛК (движок, фиксация ЧЗ)", Ссылка);   // ЩА 14.10.2026 [yan]
	Подготовка = ПодготовитьДокументИФЛК(Ссылка, Контекст);
	Если Подготовка.Статус = "НуженТокен" И ОбеспечитьТокен(Истина, Организация) Тогда
		Подготовка = ПодготовитьДокументИФЛК(Ссылка, Контекст);
	КонецЕсли;
	Если Подготовка.Статус = "Отсеян" Тогда
		ОсвободитьДокумент(Ссылка);
		Результат.Статус = "Отсеян";
		Результат.Сообщение = Подготовка.Сообщение;
		Возврат Результат;
	ИначеЕсли Подготовка.Статус <> "ОК" Тогда
		ОсвободитьДокумент(Ссылка);
		Результат.Статус = "Ошибка";
		Результат.Сообщение = ?(Подготовка.Статус = "НуженТокен",
			"Не удалось авторизоваться (401 после перевыпуска токена)", Подготовка.Сообщение);

		// Адрес получателя больше не существует у оператора: снимаем его, чтобы регламент
		// связей подобрал живой, иначе документ повторяет тот же отказ каждый прогон.
		Если ОтветГоворитЧтоАдресаНет(Подготовка.Сообщение) Тогда
			Снятие = СнятьПротухшийАдресКонтрагента(Ссылка.Контрагент);
			Результат.Статус = "ТребуетВнимания";
			Результат.Сообщение = Снятие;
		ИначеЕсли СтрНачинаетсяС(Подготовка.Сообщение, "ФЛК HTTP 400") Тогда
			ЗафиксироватьОшибкуФЛК(Ссылка, Подготовка.Сообщение);
		КонецЕсли;

		Возврат Результат;
	КонецЕсли;
	Результат.ИдДокумента = Подготовка.ИдДокумента;

	// С этой строки документ уже создан у оператора (POST /documents вернул id). Фиксируем id
	// в базе немедленно, до подписи: таймаут ниже прилетит исключением мимо ЗаписатьСтатусЭДО,
	// и следующий прогон отправил бы дубль. Статус 20 - "создан у оператора, не отправлен".
	ЗаписатьСтатусЭДО(Ссылка, 20, Подготовка.ИдДокумента);
	ИдСозданного = Подготовка.ИдДокумента;

	// 4) Подпись титула (отсоединённая CMS) - на сервере
	ОтметитьШагОтправки("подпись титула", Ссылка);   // ЩА 14.10.2026 [yan]
	ПодписьДокумента = ПодписатьДанные(Подготовка.ДвоичныеXML, Организация);
	Если ПодписьДокумента = Неопределено Тогда
 // документ у оператора УЖЕ создан - фиксируем его id и НЕ освобождаем:
 // повторная отправка создала бы второй экземпляр
		ЗаписатьСтатусЭДО(Ссылка, 20, Подготовка.ИдДокумента);
		Результат.Статус = "ТребуетВнимания";
		Результат.Сообщение = "Документ создан у оператора (id " + Подготовка.ИдДокумента
			+ "), но не подписан КЭП - завершить/удалить вручную";
		// ЩА 20.10.2026 [yan]: текст видел только пользователь в форме. Черновик старше часа
		// сторож брошенных отметок снимет и отправит заново.
		ЗаписьЖурналаРегистрации("ЭДО.Отправка", УровеньЖурналаРегистрации.Ошибка, , Ссылка, Результат.Сообщение);
		ЗаписатьЧитаемыйСтатус(Ссылка, ТекстНеПодписан());
		Возврат Результат;
	КонецЕсли;

	// 5) Присоединение подписи (отправка стартует) + write-back, один перевыпуск по 401
	ОтметитьШагОтправки("передача подписи оператору", Ссылка);   // ЩА 14.10.2026 [yan]
	Присоединение = ПрисоединитьПодписьИЗаписать(Ссылка, Подготовка.ИдДокумента, ПодписьДокумента);
	Если Присоединение.Статус = "НуженТокен" И ОбеспечитьТокен(Истина, Организация) Тогда
		Присоединение = ПрисоединитьПодписьИЗаписать(Ссылка, Подготовка.ИдДокумента, ПодписьДокумента);
	КонецЕсли;

	Если Присоединение.Статус = "Отправлен" Тогда
		Результат.Статус = "Отправлен";
		ЗаписатьВЖурналОтправку(Ссылка, Подготовка.ИдДокумента);
 // Свой статус пишет тот, кто знает факт: отправка стартовала здесь, иначе до первой сверки
 // в колонке оставалась бы прежняя подсказка.
		ЗаписатьЧитаемыйСтатус(Ссылка, "Отправляется");
	Иначе
		ЗаписатьСтатусЭДО(Ссылка, 20, Подготовка.ИдДокумента);
		Результат.Статус = "Ошибка";
		Результат.Сообщение = ?(Присоединение.Статус = "НуженТокен",
			"Не удалось авторизоваться при присоединении подписи", Присоединение.Сообщение);
		// ЩА 20.10.2026 [yan]: ответ оператора на присоединение подписи - в ЖР.
		ЗаписьЖурналаРегистрации("ЭДО.Отправка", УровеньЖурналаРегистрации.Ошибка, , Ссылка,
			"Подпись не присоединена (id " + Подготовка.ИдДокумента + "): " + Результат.Сообщение);
		ЗаписатьЧитаемыйСтатус(Ссылка, ТекстНеПодписан());
	КонецЕсли;

	Исключение
		Ошибка = ИнформацияОбОшибке();
		ЗапросУшел = ТипЗнч(Контекст) = Тип("Структура") И Контекст.Свойство("ЗапросКОператоруУшел")
			И Контекст.ЗапросКОператоруУшел = Истина;
		Если ЗначениеЗаполнено(ИдСозданного) Тогда
 // документ у оператора создан - фиксируем id, освобождать НЕЛЬЗЯ
			ЗаписатьСтатусЭДО(Ссылка, 20, ИдСозданного);
			Результат.ИдДокумента = ИдСозданного;
			Результат.Сообщение = "Связь оборвалась после создания документа у оператора (id "
				+ ИдСозданного + "): " + КраткоеПредставлениеОшибки(Ошибка);
		ИначеЕсли НЕ ЗапросУшел Тогда
 // Упали на сборке, до запроса к оператору: у него ничего не создано, повтор дубля не даст.
 // Статус 10 здесь неверен: отказанный контрагентом документ потом не переотправлялся бы.
			ОсвободитьДокумент(Ссылка);
			ЗаписьЖурналаРегистрации("ЭДО.Отправка", УровеньЖурналаРегистрации.Ошибка,
				, Ссылка, "Ошибка до обращения к оператору: " + ПодробноеПредставлениеОшибки(Ошибка));
			Результат.Статус = "Ошибка";
			Результат.Сообщение = "Документ не отправлен, у оператора ничего не создано: "
				+ ТекстПричиныОшибки(Ошибка);
			Возврат Результат;
		Иначе
 // POST мог пройти и не вернуть ответ - состояние у оператора НЕИЗВЕСТНО.
 // Статус 10 сторож брошенных отметок снимает только после сверки с оператором по номеру
 // накладной: повтор не создаст второй экземпляр.
			ЗаписатьСтатусЭДО(Ссылка, 10, "");
			Результат.Сообщение = "Отправка прервана связью, состояние у оператора неизвестно -"
				+ " проверить по номеру: " + ТекстПричиныОшибки(Ошибка);
		КонецЕсли;
		Результат.Статус = "ТребуетВнимания";
		ЗаписьЖурналаРегистрации("ЭДО.Отправка", УровеньЖурналаРегистрации.Ошибка,
			, Ссылка, Результат.Сообщение + Символы.ПС + ПодробноеПредставлениеОшибки(Ошибка));
	КонецПопытки;

	Возврат Результат;
КонецФункции

// Текст ошибки вместе с ее первопричиной. Краткое представление отдает только верхний
// уровень ("Ошибка при вызове метода контекста (Создать)"), а что именно не создалось,
// лежит во вложенной причине.
Функция ТекстПричиныОшибки(Знач Ошибка) Экспорт

	Текст = КраткоеПредставлениеОшибки(Ошибка);
	Причина = Ошибка.Причина;
	Пока Причина <> Неопределено Цикл
		Если ЗначениеЗаполнено(Причина.Описание) И СтрНайти(Текст, Причина.Описание) = 0 Тогда
			Текст = Текст + ": " + Причина.Описание;
		КонецЕсли;
		Причина = Причина.Причина;
	КонецЦикла;
	Возврат Текст;

КонецФункции

// Факт отправки в журнал регистрации: что ушло, кому, когда и под кем. Источник (регламент или
// человек) пишем явно: регламент идет под служебным пользователем, по имени их не отличить.
// Отправку ронять нельзя: документ у оператора уже создан и подписан, отсюда Попытка вокруг всего.
Процедура ЗаписатьВЖурналОтправку(Знач Ссылка, Знач ИдДокумента) Экспорт

	Попытка
 // Источник считается отдельной Попыткой: неизвестный источник не должен отменять саму запись.
 // Регламент отличаем по имени приложения сеанса: "BackgroundJob", у человека "1CV8"/"WebClient".
		Источник = "источник не определён";
		Попытка
			Приложение = ПолучитьТекущийСеансИнформационнойБазы().ИмяПриложения;
			Источник = ?(Приложение = "BackgroundJob", "регламент",
				"ручная отправка (" + Приложение + ")");
		Исключение
			ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ЗаписатьВЖурналОтправку: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
			Источник = "источник не определён";
		КонецПопытки;

		Контрагент = "";
		Попытка
			Контрагент = Строка(Ссылка.Контрагент);
		Исключение
			ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ЗаписатьВЖурналОтправку: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
			Контрагент = "";
		КонецПопытки;

		Текст = "Отправлен по ЭДО: " + Строка(Ссылка)
			+ ?(ЗначениеЗаполнено(Контрагент), "; контрагент " + Контрагент, "")
			+ "; id у оператора " + Строка(ИдДокумента)
			+ "; источник - " + Источник
			+ "; пользователь ИБ " + ИмяПользователя();

		ЗаписьЖурналаРегистрации("ЭДО.Отправка", УровеньЖурналаРегистрации.Информация,
			Ссылка.Метаданные(), Ссылка, Лев(Текст, 5000));
	Исключение
		// Документ уже ушёл: отсутствие строки в журнале - меньшее из зол, отправку не прерываем.
		// Повторная запись может упасть по той же причине - её ошибку тоже не выпускаем наружу.
		// Перехват обоснован: это запись об отказе записи в журнал; если журнал недоступен совсем,
		// сообщить больше некуда, а документ уже ушел оператору.
		Попытка
			ЗаписьЖР("ЭДО.Отправка", "Ошибка", , , "Не записан след отправки: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Исключение
			Возврат;   // ПредставлениеОшибки здесь писать некуда (см. выше)
		КонецПопытки;
	КонецПопытки;

КонецПроцедуры

// Сверка: расходятся ли отбор очереди и проверка перед отправкой. Страховка от гейта, заведенного
// в одном месте из двух: такой отказ тихий.
// Сверка в одну сторону - берем отобранное очередью и спрашиваем проверку. Обратную сторону
// ловит сама очередь: остаток растет при нулевой отправке. Только читает, годится для боевой базы.
//
// Возврат: Структура (Проверено, Расхождений, Строки) - Строки для лога регламента.
Функция СверитьГейтыОтбораИПроверки(Знач Лимит = 20) Экспорт

	Результат = Новый Структура("Проверено, Расхождений, Строки", 0, 0, Новый Массив);
	Т = ДокументыКОтправке();
	Сколько = Мин(Лимит, Т.Количество());

	Для Инд = 0 По Сколько - 1 Цикл
		Стр = Т[Инд];
		Результат.Проверено = Результат.Проверено + 1;
		Готовность = ПроверитьГотовностьКОтправке(Стр.Ссылка);
		Если Готовность.Готов Тогда
			Продолжить;
		КонецЕсли;
 // Причины, снимаемые временем (коды маркировки, приглашение в роуминг), расхождением не считаются.
 // Расхождение - постоянная причина: документ не уйдет никогда, а место в лимите занимает.
		Если СтрНайти(Готовность.Причина, "Нет кодов маркировки") > 0
			ИЛИ СтрНайти(Готовность.Причина, "роуминг по нему не подтверждён") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Результат.Расхождений = Результат.Расхождений + 1;
		Результат.Строки.Добавить("РАСХОЖДЕНИЕ ГЕЙТОВ " + СокрЛП(Стр.Номер)
			+ ": отбор взял, проверка держит - " + Лев(Готовность.Причина, 160));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Программная отправка массива документов (сервер) под замком прогона. Токен берется один раз
// на пакет, перевыпуск по 401 - внутри ОтправитьПоЭДО.
// Возврат: Массив структур-результатов (как у ОтправитьПоЭДО).
Функция ОтправитьМассивПоЭДО(МассивСсылок) Экспорт
	// Замок от параллельных прогонов: держится 30 минут, продлевается по ходу, снимается в конце.
	// ЩА 15.10.2026 [yan]: при конкуренции блокировка ключа замка может не дождаться и выбросить исключение -
	// это тот же занятый замок, вызывающему - "Пропущен", а не ошибка. Прочие отказы (доступ, запись
	// хранилища) - ошибка как есть: "Пропущен" отправил бы человека ждать освобождения замка.
	Попытка
		ЗамокНаш = ЗанятьПрогонОтправки();
	Исключение
		Подробно = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Если НЕ ЭтоКонфликтБлокировки(Подробно) Тогда
			ВызватьИсключение;
		КонецЕсли;
		ЗаписьЖурналаРегистрации("ЭДО.ЗамокОтправки", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Замок прогона отправки не получен - блокировку держит другой сеанс: " + Подробно);
		ЗамокНаш = Ложь;
	КонецПопытки;
	Если НЕ ЗамокНаш Тогда
		Отказ = Новый Массив;
		Отказ.Добавить(Новый Структура("Ссылка, Статус, ИдДокумента, Сообщение",
			Неопределено, "Пропущен", "",
			"Массовая отправка уже выполняется другим сеансом - повторный запуск отклонён"));
		Возврат Отказ;
	КонецЕсли;

	// Брошенные отметки "взят в отправку" здесь НЕ снимаем: отметка ставится до POST, и если
	// процесс упал после POST, но до записи идентификатора, карточка у оператора уже есть -
	// снятие вслепую отправит второй экземпляр. Их разбирает сторож брошенных отметок со сверкой.

	Результаты = Новый Массив;
	Попытка
 // Движок и настройки собираются один раз на пакет: на каждом документе это лишние ~125 мс
 // и запись в ХранилищеОбщихНастроек.
		Контекст = ?(МассивСсылок.Количество() > 0, НовыйКонтекстПрогона(), Неопределено);
		Обработано = 0;
		Для Каждого Ссылка Из МассивСсылок Цикл
			Результаты.Добавить(ОтправитьПоЭДО(Ссылка, Контекст));
			Обработано = Обработано + 1;
			// Продлеваем замок на длинном пакете; не продлился - замок уже не наш, дальше не шлем.
			Если Обработано % 50 = 0 И НЕ ЗанятьПрогонОтправки() Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Исключение
		ОсвободитьПрогонОтправки();
		ВызватьИсключение;
	КонецПопытки;
	ОсвободитьПрогонОтправки();
	Возврат Результаты;
КонецФункции

// Отправка одного документа по решению человека: карточка документа и разбор Центра
// управления. Отличие от очереди - документ, уже получивший отметку отправки, уходит
// повторно (человек видел, что он отправлен, и все равно нажал), а гейт, который
// оператор вправе снять, снимается только переданным кодом причины.
// Возврат: Структура (Ссылка, Успех, Заголовок, Текст, КодПричины, ГейтПреодолим).
// ГейтПреодолим = Истина - документ уперся в гейт, который человек вправе снять повторным
// вызовом с этим кодом причины; спросить его об этом - дело формы.
// ПреодолеваемыйГейт - код причины или несколько через запятую: документ может упереться в два гейта
// сразу (старше даты начала и аннулирование в Диадоке), и снятие по одному за вызов ходит по кругу.
Функция ОтправитьВручную(Знач Ссылка, Знач ПреодолеваемыйГейт = "") Экспорт

	Итог = Новый Структура("Ссылка, Успех, Заголовок, Текст, КодПричины, ГейтПреодолим",
		Ссылка, Ложь, "Документ не отправлен", "", "", Ложь);

	// ЩА 21.10.2026 [yan]: коды снимаемых гейтов через запятую.
	Снимаемые = Новый Массив;
	Для Каждого Код Из СтрРазделить(ПреодолеваемыйГейт, ",", Ложь) Цикл
		Снимаемые.Добавить(СокрЛП(Код));
	КонецЦикла;

	СвойствоСтатус = СвойствоОбъектов("ЭДО_КодСостояния");
	ЕстьСвойство = СвойствоСтатус <> Неопределено И НЕ СвойствоСтатус.Пустая();
	ПрежнийСтатус = ?(ЕстьСвойство, ЗначениеСвойстваОбъекта(Ссылка, СвойствоСтатус), Неопределено);

	ОтметкуСнялиЗдесь = Ложь;
	Если ЗначениеЗаполнено(ПрежнийСтатус) Тогда
		КодСтатуса = 0;
		Попытка
			КодСтатуса = Число(ПрежнийСтатус);
		Исключение
			ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ОтправитьВручную: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
			КодСтатуса = 0;
		КонецПопытки;
		Если КодСтатуса = 1 Тогда
			Итог.Текст = "Документ прямо сейчас взят в отправку другим сеансом (регламент или соседний"
				+ " пользователь). Подождите и повторите.";
			Возврат Итог;
		КонецЕсли;
		// Статус 10 (состояние у оператора неизвестно) не снимаем: ОтправитьПоЭДО сама спросит
		// оператора через РазобратьПрерваннуюОтправку и отправит, только если живого экземпляра нет.
		Если КодСтатуса <> 10 Тогда
			// Без снятия отметки ОтправитьПоЭДО отвечает "Документ уже отправлялся (статус ЭДО 40)"
			// и ничего не делает. ОсвободитьДокумент для этого не годится: она снимает только
			// свою отметку "взят" (статус 1).
			Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
			Набор.Отбор.Объект.Установить(Ссылка);
			Набор.Отбор.Свойство.Установить(СвойствоСтатус);
			Набор.Записать();
			ОтметкуСнялиЗдесь = Истина;
		КонецЕсли;
	КонецЕсли;

	// "Не отправлен по решению механизма" - это НЕ поломка: удержание до выяснения канала,
	// отсев и занятость документа другим сеансом. Ошибкой считаем только сбой отправки,
	// иначе пользователь идет чинить то, что работает как задумано.
	Успех = Ложь;
	ЭтоОшибка = Истина;
	Попытка
		Разрешения = НовыеРазрешенияОператора();
		Разрешения.ОтправитьРаньшеДатыНачала = Снимаемые.Найти("ДатаНачалаОтправки") <> Неопределено;
		Разрешения.ОтправитьПовторноПослеСБИС = Снимаемые.Найти("ОтправлялсяЧерезСБИС") <> Неопределено;
		Разрешения.ОтправитьПриНедоставленномЭкземпляре = Снимаемые.Найти("НедоставленныйЭкземпляр") <> Неопределено;
		Разрешения.ОтправитьПриФиксацииПрежнегоЭкземпляра = Снимаемые.Найти("ФиксацияПрежнегоЭкземпляра") <> Неопределено;
		Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.АктСверкиВзаиморасчетов") Тогда
			// У акта сверки другой формат ФНС и свой сборщик XML.
			Результат = ОтправитьАктСверкиПоЭДО(Ссылка, Разрешения);
		Иначе
			Результат = ОтправитьПоЭДО(Ссылка, , Разрешения);
		КонецЕсли;
		// Код причины есть не у всех точек входа (у акта сверки своя) - читаем через Свойство.
		КодОтказа = "";
		Результат.Свойство("КодПричины", КодОтказа);
		Итог.КодПричины = КодОтказа;
		Успех = (Результат.Статус = "Отправлен");
		ЭтоОшибка = НЕ Успех
			И Результат.Статус <> "ТребуетВнимания"
			И Результат.Статус <> "Отсеян"
			И Результат.Статус <> "Пропущен";
		// Пользователю нужна причина, а не внутренний статус механизма.
		Итог.Текст = ?(ЗначениеЗаполнено(Результат.Сообщение), Результат.Сообщение,
			?(Успех, "Отправлен", "Механизм отправки документ не пропустил"))
			+ ?(ЗначениеЗаполнено(Результат.ИдДокумента),
				" (карточка " + Строка(Результат.ИдДокумента) + ")", "");
	Исключение
		Итог.Текст = "Ошибка отправки: " + ТекстПричиныОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Отметку сняли ДО отправки, и если отправка не удалась, документ остается "никогда не
	// отправлявшимся" - ближайший прогон очереди отправит его сам, хотя экземпляр у оператора
	// уже есть. Возвращаем прежний статус на место.
	Если НЕ Успех И ОтметкуСнялиЗдесь Тогда
		Если НЕ ЗначениеЗаполнено(ЗначениеСвойстваОбъекта(Ссылка, СвойствоСтатус)) Тогда
			ЗаписатьЗначениеСвойства(Ссылка, СвойствоСтатус, ПрежнийСтатус);
			Итог.Текст = Итог.Текст + " Прежняя отметка отправки возвращена на место.";
		КонецЕсли;
	КонецЕсли;

	Итог.Успех = Успех;
	// Гейт, уже снятый этим вызовом, второй раз не предлагаем: документ уперся в него вопреки разрешению.
	Итог.ГейтПреодолим = НЕ Успех И ГейтПреодолимОператором(Итог.КодПричины)
		И Снимаемые.Найти(Итог.КодПричины) = Неопределено;
	Если Успех Тогда
		Итог.Заголовок = "Отправлен в ЭДО";
	ИначеЕсли ЭтоОшибка Тогда
		Итог.Заголовок = "Ошибка отправки";
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Гейты, которые человек вправе снять сам: документ старше даты начала работы с оператором,
// документ, уходивший через СБИС, и экземпляр у оператора, не доставленный получателю.
// Во всех трех случаях знает не механизм, а человек, у которого на руках переписка с контрагентом.
Функция ГейтПреодолимОператором(Знач КодПричины) Экспорт

	Возврат КодПричины = "ДатаНачалаОтправки" ИЛИ КодПричины = "ОтправлялсяЧерезСБИС"
		ИЛИ КодПричины = "НедоставленныйЭкземпляр" ИЛИ КодПричины = "ФиксацияПрежнегоЭкземпляра";

КонецФункции

// Текст причины из карточки оператора (квитанции или уведомления в цепочке документа).
// У SENDING_FAILURE_ACK причина лежит в reason ВЕРХНЕГО уровня, а у прочих - в extra.reason.
// Читая только extra.reason, получаешь пустоту ровно там, где причина и нужна.
Функция ПричинаКарточкиОператора(Знач Карточка) Экспорт

	Если ТипЗнч(Карточка) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Если Карточка.Свойство("extra") И ТипЗнч(Карточка.extra) = Тип("Структура")
		И Карточка.extra.Свойство("reason") И Карточка.extra.reason <> Неопределено Тогда
		Значение = СокрЛП(Строка(Карточка.extra.reason));
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Лев(Значение, 500);
		КонецЕсли;
	КонецЕсли;
	Если Карточка.Свойство("reason") И Карточка.reason <> Неопределено Тогда
		Возврат Лев(СокрЛП(Строка(Карточка.reason)), 500);
	КонецЕсли;
	Возврат "";

КонецФункции

// Причины отказа по идентификаторам карточек у оператора.
//
// Причины в самой карточке документа НЕТ вовсе: она лежит в ЦЕПОЧКЕ (document-flows),
// в подчиненных - уведомлении об уточнении от контрагента или квитанции об ошибке ФЛК.
// Возврат: Соответствие (идентификатор строкой -> текст причины). Документ, по которому
// цепочка пришла, но текста в ней нет, попадает с пустой строкой: контрагент отказал
// без объяснений, и это тоже ответ. Неотвеченных в соответствии нет.
Функция ПричиныОтказаПоИдентификаторам(Знач Идентификаторы, Знач Организация = Неопределено) Экспорт

	Итог = Новый Соответствие;
	Если Идентификаторы.Количество() = 0 ИЛИ НЕ ОбеспечитьТокен(Ложь, Организация) Тогда
		Возврат Итог;
	КонецЕсли;

	Соед = СоединениеСОператором();
	// page_size у document-flows не больше 50, иначе HTTP 400.
	РазмерПачки = 50;
	Индекс = 0;
	Пока Индекс < Идентификаторы.Количество() Цикл
		Пачка = Новый Массив;
		Пока Индекс < Идентификаторы.Количество() И Пачка.Количество() < РазмерПачки Цикл
			Пачка.Добавить(СокрЛП(Строка(Идентификаторы[Индекс])));
			Индекс = Индекс + 1;
		КонецЦикла;

		// Две попытки: токен живет 15 минут, и 401 на втором заходе - штатное дело.
		Ответ = Неопределено;
		Для НомерПопытки = 1 По 2 Цикл
			Запрос = Новый HTTPЗапрос(ПутьСервиса("document") + "/public/api/v3/document-flows?id="
				+ СтрСоединить(Пачка, ",") + "&page=0&page_size=" + РазмерПачки);
			Запрос.Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));
			Запрос.Заголовки.Вставить("accept", "application/json;charset=UTF-8");
			Попытка
				Ответ = Соед.Получить(Запрос);
			Исключение
				ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ПричиныОтказаПоИдентификаторам: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
				Ответ = Неопределено;
				Прервать;
			КонецПопытки;
			Если Ответ.КодСостояния = 401 И НомерПопытки = 1 Тогда
				ОбеспечитьТокен(Истина, Организация);
				Продолжить;
			КонецЕсли;
			Прервать;
		КонецЦикла;
		// Причина - подсказка к списку, а не сам список: не ответила пачка - остаемся без нее.
		Если Ответ = Неопределено ИЛИ Ответ.КодСостояния <> 200 Тогда
			Продолжить;
		КонецЕсли;

		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
		Цепочки = ПрочитатьJSON(Чтение, Ложь);
		Чтение.Закрыть();
		Если ТипЗнч(Цепочки) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Цепочка Из Цепочки Цикл
			Если ТипЗнч(Цепочка) <> Тип("Структура") ИЛИ НЕ Цепочка.Свойство("id") Тогда
				Продолжить;
			КонецЕсли;
			// Идентификатор из JSON приходит числом, а Строка() дала бы "172 751 616".
			Ид = ?(ТипЗнч(Цепочка.id) = Тип("Число"), Формат(Цепочка.id, "ЧГ=0"), СокрЛП(Строка(Цепочка.id)));
			ТекстПричины = "";
			Если Цепочка.Свойство("slaves") И ТипЗнч(Цепочка.slaves) = Тип("Массив") Тогда
				Для Каждого Подчиненный Из Цепочка.slaves Цикл
					Найденная = ПричинаКарточкиОператора(Подчиненный);
					Если ЗначениеЗаполнено(Найденная) Тогда
						ТекстПричины = Найденная;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Итог.Вставить(Ид, ТекстПричины);
		КонецЦикла;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Причины отказа по документам базы - через сохраненный идентификатор карточки.
// Возврат: Соответствие (Ссылка -> текст причины); документы без карточки не попадают.
Функция ПричиныОтказаДокументов(Знач МассивСсылок) Экспорт

	Итог = Новый Соответствие;
	СвойствоИд = СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если МассивСсылок.Количество() = 0 ИЛИ СвойствоИд = Неопределено ИЛИ СвойствоИд.Пустая() Тогда
		Возврат Итог;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Ид.Объект КАК Ссылка,
		|	ВЫРАЗИТЬ(Ид.Значение КАК СТРОКА(50)) КАК ИдЭДО
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК Ид
		|ГДЕ
		|	Ид.Свойство = &СвойствоИд
		|	И Ид.Объект В (&Ссылки)");
	Запрос.УстановитьПараметр("СвойствоИд", СвойствоИд);
	Запрос.УстановитьПараметр("Ссылки", МассивСсылок);
	ДокументПоИд = Новый Соответствие;
	Идентификаторы = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ид = СокрЛП(Строка(Выборка.ИдЭДО));
		Если ЗначениеЗаполнено(Ид) И ДокументПоИд.Получить(Ид) = Неопределено Тогда
			ДокументПоИд.Вставить(Ид, Выборка.Ссылка);
			Идентификаторы.Добавить(Ид);
		КонецЕсли;
	КонецЦикла;

	// Спрашивать оператора надо токеном организации документа.
	Если НЕ НесколькоУчетныхЗаписейЭДО() Тогда
		Причины = ПричиныОтказаПоИдентификаторам(Идентификаторы);
	Иначе
		ПоОрганизациям = Новый Соответствие;
		Для Каждого Ид Из Идентификаторы Цикл
			Организация = ОрганизацияДокумента(ДокументПоИд.Получить(Ид));
			Ключ = ?(Организация = Неопределено, "", Организация);
			Группа = ПоОрганизациям.Получить(Ключ);
			Если Группа = Неопределено Тогда
				Группа = Новый Массив;
				ПоОрганизациям.Вставить(Ключ, Группа);
			КонецЕсли;
			Группа.Добавить(Ид);
		КонецЦикла;
		Причины = Новый Соответствие;
		Для Каждого Группа Из ПоОрганизациям Цикл
			Если НЕ ЗначениеЗаполнено(Группа.Ключ) Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Причина Из ПричиныОтказаПоИдентификаторам(Группа.Значение, Группа.Ключ) Цикл
				Причины.Вставить(Причина.Ключ, Причина.Значение);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Для Каждого КлючИЗначение Из Причины Цикл
		Ссылка = ДокументПоИд.Получить(КлючИЗначение.Ключ);
		Если Ссылка <> Неопределено Тогда
			Итог.Вставить(Ссылка, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Доступна ли подпись в серверном контексте (сертификат подписанта виден рабочему процессу).
// Без организации отвечает по всем учетным записям: доступна, когда сертификат найден у каждой.
Функция ПодписьНаСервереДоступна(Знач Организация = Неопределено) Экспорт

	Если ЗначениеЗаполнено(Организация) Тогда
		Возврат СертификатПодписанта(Организация) <> Неопределено;
	КонецЕсли;

	Записи = УчетныеЗаписиЭДО();
	Если Записи.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Запись Из Записи Цикл
		Если СертификатПодписанта(Запись.Организация) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Причина, по которой организация документа не вправе отправлять по ЭДО ("" - вправе).
// Текст называет организацию: при похожих организациях в базе иначе не понять, что не так.
Функция ПричинаЗапретаПоОрганизации(Ссылка) Экспорт

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	Организация = Неопределено;
	Если НЕ ЕстьРеквизитДокумента(Ссылка, "Организация") Тогда
		Возврат "";   // у документа нет реквизита "Организация" - проверять нечего
	КонецЕсли;
	Организация = Ссылка.Организация;
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат "В документе не заполнена организация";
	КонецЕсли;

	Свойство = СвойствоОбъектов("ЭДО_РазрешенаОтправка");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
 // Свойства нет - механизм не настроен. Молча разрешать нельзя, но отказ должен объяснять причину.
		Возврат "Свойство «ЭДО_РазрешенаОтправка» не заведено в базе. Открой обработку «Помощник»"
			+ " - обеспечение свойств заведёт его, затем поставь флаг рабочей организации.";
	КонецЕсли;

	Значение = ЗначениеСвойстваОбъекта(Организация, Свойство);
	Разрешено = Ложь;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Разрешено = Значение;
	ИначеЕсли Значение <> Неопределено Тогда
		Текст = ВРег(СокрЛП(Строка(Значение)));
		Разрешено = (Текст = "ДА" ИЛИ Текст = "ИСТИНА" ИЛИ Текст = "TRUE" ИЛИ Текст = "1");
	КонецЕсли;

	Если Разрешено Тогда
		Возврат "";
	КонецЕсли;
	Возврат "Организация «" + Строка(Организация) + "» не разрешена для отправки по ЭДО."
		+ " Поставь ей флаг «ЭДО_РазрешенаОтправка», если документы этой организации"
		+ " действительно должны уходить контрагентам.";

КонецФункции

// Разрешения, которые оператор дает ручной отправке, ответив на вопрос в карточке.
// Автоматика их не выдает никогда: очередь и регламенты зовут проверку без разрешений.
Функция НовыеРазрешенияОператора() Экспорт

	Возврат Новый Структура("ОтправитьРаньшеДатыНачала, ОтправитьПовторноПослеСБИС, ОтправитьПриНедоставленномЭкземпляре,
		|ОтправитьПриФиксацииПрежнегоЭкземпляра",
		Ложь, Ложь, Ложь, Ложь);

КонецФункции

// Дал ли оператор конкретное послабление. Разрешения могут быть не переданы вовсе -
// это штатный случай (весь автоматический путь), а не ошибка вызова.
Функция РазрешеноОператором(Знач Разрешения, Знач Имя)

	Если ТипЗнч(Разрешения) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Значение = Ложь;
	Возврат Разрешения.Свойство(Имя, Значение) И Значение = Истина;

КонецФункции

// Условия отбора очереди, проверенные поштучно. У отправки два входа - очередь и ручной (карточка,
// вызов ядра из другого кода), отбор видит только первый, поэтому каждый гейт стоит в обоих местах;
// расхождение ловит СверитьГейтыОтбораИПроверки().
// Пометка к отправке сюда не входит намеренно: нажав "Отправить", человек уже решил, что пора.
// Возврат: Строка - причина отказа, "" если условия отбора пройдены.
Функция ПричинаОтказаПоУсловиямОтбора(Ссылка, Знач Разрешения = Неопределено,
	КодПричины = "") Экспорт

	КодПричины = "";

	// Гейты ниже относятся к реализации: у акта сверки нет ни бухучета, ни заказа. У корректировки
	// проверяются бухучет и дата начала отправки. Пустая ссылка отсеивается здесь, иначе ответ
	// "не отражается в бухгалтерском учете" вводил бы в заблуждение.
	ЭтоКорректировка = ТипЗнч(Ссылка) = Тип("ДокументСсылка.КорректировкаРеализации");
	Если НЕ ЗначениеЗаполнено(Ссылка)
		ИЛИ (ТипЗнч(Ссылка) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") И НЕ ЭтоКорректировка) Тогда
		Возврат "";
	КонецЕсли;

	// 1. Отражение в бухгалтерском учете.
	Отражать = Истина;
	Если ЕстьРеквизитДокумента(Ссылка, "ОтражатьВБухгалтерскомУчете") Тогда
		Отражать = Ссылка.ОтражатьВБухгалтерскомУчете;
	КонецЕсли;
	Если НЕ Отражать Тогда
		КодПричины = "БухгалтерскийУчет";
		Возврат "Документ не отражается в бухгалтерском учёте - по ЭДО такие не отправляем";
	КонецЕсли;

	// 2. Абсолютная отсечка: до нее документы ушли прежним оператором, повтор дал бы дубль.
	// Человек вправе ее снять из карточки (контрагент просит переотправить старый документ),
	// для очереди и регламентов это запрет. Дата начала - своя у каждой организации.
	ОрганизацияДок = ОрганизацияДокумента(Ссылка);
	УчЗаписьОрганизации = УчетнаяЗаписьЭДО(ОрганизацияДок);
	Если УчЗаписьОрганизации = Неопределено Тогда
		КодПричины = "НетУчетнойЗаписи";
		Возврат "У организации «" + Строка(ОрганизацияДок) + "» не настроена учетная запись ЭДО"
			+ " - заполните её в настройках расширения";
	КонецЕсли;
	ГраницаАбсолютная = УчЗаписьОрганизации.ДатаНачалаОтправки;
	Если ЗначениеЗаполнено(ГраницаАбсолютная) И Ссылка.Дата < ГраницаАбсолютная Тогда
		Если РазрешеноОператором(Разрешения, "ОтправитьРаньшеДатыНачала") Тогда
			ЗаписьЖР("ЭДО.ОтправкаРаньшеДатыНачала", "Предупреждение", Ссылка.Метаданные(), Ссылка,
				"Документ от " + Формат(Ссылка.Дата, "ДФ=dd.MM.yyyy") + " отправлен раньше даты"
				+ " начала работы с оператором (" + Формат(ГраницаАбсолютная, "ДФ=dd.MM.yyyy")
				+ ") по решению пользователя: он предупреждён о возможном дубле у контрагента");
		Иначе
			КодПричины = "ДатаНачалаОтправки";
			Возврат "Документ от " + Формат(Ссылка.Дата, "ДФ=dd.MM.yyyy") + " старше даты начала"
				+ " отправки через этого оператора (" + Формат(ГраницаАбсолютная, "ДФ=dd.MM.yyyy")
				+ ") - он уходил прежним каналом, повтор дал бы контрагенту дубль";
		КонецЕсли;
	КонецЕсли;

	Если ЭтоКорректировка Тогда
		Возврат "";
	КонецЕсли;

	// 3. Уже ушел через СБИС: отметка осталась от прежнего оператора, занятие документа этого
	// не ловит. Отказ преодолим человеком на тех же условиях, что и отсечка по дате.
	СвСБИС = СвойствоОбъектов("ДокументСБИС_Ид");
	Если СвСБИС <> Неопределено И НЕ СвСБИС.Пустая()
		И ЗначениеЗаполнено(ЗначениеСвойстваОбъекта(Ссылка, СвСБИС)) Тогда
		Если РазрешеноОператором(Разрешения, "ОтправитьПовторноПослеСБИС") Тогда
			ЗаписьЖР("ЭДО.ОтправкаПослеСБИС", "Предупреждение", Ссылка.Метаданные(), Ссылка,
				"Документ отправлен повторно, хотя уходил через СБИС, по решению пользователя:"
				+ " он предупреждён о возможном дубле у контрагента");
		Иначе
			КодПричины = "ОтправлялсяЧерезСБИС";
			Возврат "Документ уже отправлялся через СБИС - повтор дал бы контрагенту дубль";
		КонецЕсли;
	КонецЕсли;

	// 4. Заказ покупателя ещё не в готовом статусе. Гейта нет в конфигурации без заказа
	// или без перечисления статусов - см. ГейтСтатусаЗаказаПрименим().
	Если ГейтСтатусаЗаказаПрименим() Тогда
		Готовые = ГотовыеСтатусыЗаказа();
		Если Готовые.Количество() > 0 Тогда
			З = Новый Запрос;
			З.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1 Тов.ЗаказПокупателя КАК Заказ
				|ИЗ Документ.РеализацияТоваровУслуг.Товары КАК Тов
				|ГДЕ Тов.Ссылка = &Ссылка
				|	И Тов.ЗаказПокупателя <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
				|	И НЕ Тов.ЗаказПокупателя.Статус В (&ГотовыеСтатусы)";
			З.УстановитьПараметр("Ссылка", Ссылка);
			З.УстановитьПараметр("ГотовыеСтатусы", Готовые);
			В = З.Выполнить().Выбрать();
			Если В.Следующий() Тогда
				КодПричины = "СтатусЗаказа";
				Возврат "Заказ покупателя «" + Строка(В.Заказ) + "» ещё не в готовом статусе"
					+ " - отгрузка не завершена";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// 5. Дата отгрузки заказа ещё не наступила: документ уходит не раньше её.
	// Сегодняшняя отгрузка уходит сегодня - сравниваем начала дней, не моменты.
	Если ГейтДатыОтгрузкиПрименим() Тогда
		ЗД = Новый Запрос;
		ЗД.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Тов.ЗаказПокупателя КАК Заказ,
			|	Тов.ЗаказПокупателя.ДатаОтгрузки КАК ДатаОтгрузки
			|ИЗ Документ.РеализацияТоваровУслуг.Товары КАК Тов
			|ГДЕ Тов.Ссылка = &Ссылка
			|	И Тов.ЗаказПокупателя <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
			|	И НАЧАЛОПЕРИОДА(Тов.ЗаказПокупателя.ДатаОтгрузки, ДЕНЬ) > &СегодняНачалоДня
			|УПОРЯДОЧИТЬ ПО ДатаОтгрузки УБЫВ";
		ЗД.УстановитьПараметр("Ссылка", Ссылка);
		ЗД.УстановитьПараметр("СегодняНачалоДня", НачалоДня(ТекущаяДатаСеанса()));
		ВД = ЗД.Выполнить().Выбрать();
		Если ВД.Следующий() Тогда
			КодПричины = "ДатаОтгрузки";
			Возврат "Заказ покупателя «" + Строка(ВД.Заказ) + "» отгружается "
				+ Формат(ВД.ДатаОтгрузки, "ДФ=dd.MM.yyyy") + " - раньше этой даты не отправляем";
		КонецЕсли;
	КонецЕсли;

	Возврат "";

КонецФункции

// Проверка готовности документа к отправке - до любого обращения к API.
// Возврат: Структура (Готов Булево, Причина Строка, ОтправкаНеТребуется Булево, КодПричины Строка).
// ОтправкаНеТребуется = Истина - документ по ЭДО не поедет никогда: это не ошибка, вызывающий
// помечает документ и снимает его с очереди.
Функция ПроверитьГотовностьКОтправке(Ссылка, Знач Разрешения = Неопределено) Экспорт
	// КодПричины нужен вызывающему, чтобы отличить преодолимый отказ от окончательного,
	// не разбирая текст сообщения. Пусто - причина без кода либо документ готов.
	Результат = Новый Структура("Готов, Причина, ОтправкаНеТребуется, КодПричины", Ложь, "", Ложь, "");
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Результат.Причина = "Пустая ссылка на документ";
		Возврат Результат;
	КонецЕсли;

	// Расширение не должно работать в ненастроенной базе: иначе вместо понятной причины
	// будет ошибка платформы.
	Недостающее = НедостающиеНастройкиЭДО();
	Если Недостающее.Количество() > 0 Тогда
		Результат.Причина = "Расширение не настроено - " + СтрСоединить(Недостающее, "; ")
			+ ". Открой настройки ЭДО в обработке «Помощник».";
		Возврат Результат;
	КонецЕсли;
	Если НЕ Ссылка.Проведен Тогда
		Результат.Причина = "Документ не проведён";
		Возврат Результат;
	КонецЕсли;

	// Условия отбора проверяются здесь повторно: документ может уйти мимо очереди (кнопкой
	// из карточки или прямым вызовом ядра).
	КодОтбора = "";
	ПричинаОтбора = ПричинаОтказаПоУсловиямОтбора(Ссылка, Разрешения, КодОтбора);
	Если ЗначениеЗаполнено(ПричинаОтбора) Тогда
		Результат.Причина = ПричинаОтбора;
		Результат.КодПричины = КодОтбора;
		Возврат Результат;
	КонецЕсли;

	// Запрет по организации - страховка на случай отправки МИМО очереди: кнопкой из
	// карточки, прямым вызовом ядра, из другой базы. Отбор очереди такие пути не видит,
	// а дубль контрагенту уходит одинаково.
	ПричинаОрганизации = ПричинаЗапретаПоОрганизации(Ссылка);
	Если ЗначениеЗаполнено(ПричинаОрганизации) Тогда
		Результат.Причина = ПричинаОрганизации;
		Возврат Результат;
	КонецЕсли;
	ИдКонтрагента = ИдентификаторУчастникаЭДО(Ссылка.Контрагент);
	Если НЕ ЗначениеЗаполнено(ИдКонтрагента) Тогда
		Результат.Причина = "У контрагента """ + Строка(Ссылка.Контрагент)
			+ """ не заполнен идентификатор ЭДО";
		Возврат Результат;
	КонецЕсли;

	// Отправитель и получатель не должны совпадать: оператор забракует такой документ, но узнаем
	// мы об этом только из входящей квитанции, когда документ уже отмечен отправленным.
	НеТребуется = Ложь;
	Совпадение = ПроверитьСовпадениеСторон(Ссылка, ИдКонтрагента, НеТребуется);
	Если ЗначениеЗаполнено(Совпадение) Тогда
		Результат.Причина = Совпадение;
		Результат.ОтправкаНеТребуется = НеТребуется;
		Возврат Результат;
	КонецЕсли;

	// Пауза по контрагенту (за месяц ни одной подписи и есть документ, висящий дольше 14 дней):
	// отгрузки прекращаем. Снимается только руками (ВозобновитьОтправкуКонтрагенту), иначе одна
	// подпись задним числом снова открыла бы поток без разбора причины.
	Пауза = ПричинаПаузыКонтрагента(Ссылка.Контрагент);
	Если ЗначениеЗаполнено(Пауза) Тогда
		Результат.Причина = "Отправка контрагенту приостановлена: " + Пауза;
		Возврат Результат;
	КонецЕсли;

	// Адрес закреплен, а роуминг по нему не подтвержден - держим документ. Отправка на другой адрес
	// молча положит документ в чужой ящик, на сам адрес без роуминга - повесит его в AWAIT_CONTACT.
	// Удержание снимается само: ОбновитьСвязиЭДО обновляет статус связи и у закрепленных карточек.
	//
	// Незакрепленный адрес с нерабочей связью держим тоже: отбор очереди берет только ESTABLISHED
	// и DIRECT. Пустой статус - "связь еще не проверяли", его не держим, иначе ручная отправка
	// новому контрагенту встала бы до первого прогона ОбновитьСвязиЭДО.
	// ЩА 20.10.2026 [yan]: связь пары «организация документа - контрагент», как и в отборе очереди.
	СтатусСвязи = СтатусСвязиЭДО(Ссылка.Контрагент, ?(ЕстьРеквизитДокумента(Ссылка, "Организация"), Ссылка.Организация, Неопределено));
	Если ЗначениеЗаполнено(СтатусСвязи)
		И ВРег(СтатусСвязи) <> "ESTABLISHED" И ВРег(СтатусСвязи) <> "DIRECT" Тогда
		Если АдресЭДОЗакреплён(Ссылка.Контрагент) Тогда
			Результат.Причина = "Адрес ЭДО закреплён, но роуминг по нему не подтверждён (связь "
				+ СтатусСвязи + ") - ждём, пока контрагент примет приглашение";
		Иначе
			Результат.Причина = "Связь с контрагентом по адресу " + ИдКонтрагента
				+ " не установлена (связь " + СтатусСвязи + ") - в очередь документ не попадёт,"
				+ " пока связь не появится или адрес не сменится";
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	// Канал вне автовыбора (ЭДО Лайт и подобные) без ручного закрепления не отправляем: канал
	// формально исправен, но читателя за ящиком, как правило, нет, и документ теряется. Гейт стоит
	// здесь, а не только в выборе адреса, чтобы удержать и карточки с таким адресом, записанным раньше.
	Если АдресЭДОВнеАвтовыбора(ИдКонтрагента) И НЕ АдресЭДОЗакреплён(Ссылка.Контрагент) Тогда
		Результат.Причина = "Адрес ЭДО ведет в «" + ИмяКаналаЭДО(ИдКонтрагента) + "» (" + ИдКонтрагента
			+ "), а он не закреплен вручную - отправка удержана до выяснения рабочего канала";
		Возврат Результат;
	КонецЕсли;

	// Без адреса покупателя ФЛК бракует документ (узел СвПокуп/Адрес обязателен при СЧФДОП).
	// Проверяем ту же цепочку, что и маппинг: карточка, затем карточка-тезка по ИНН.
	Если НЕ ЕстьАдресДляЭДО(Ссылка.Контрагент) Тогда
		Результат.Причина = "У контрагента """ + Строка(Ссылка.Контрагент)
			+ """ не заполнен адрес - ни в его карточке, ни в других карточках этого ИНН";
		Возврат Результат;
	КонецЕсли;

	// Маркируемый товар без кодов: УПД уйдет с пустыми НомСредИдентТов, оператор и ГИС МТ его
	// примут, а переход прав в Честном ЗНАКе не зарегистрируется - тихий исход. Коды сканируют
	// на складе после проведения; появятся - следующий прогон отправит.
	БезКодов = ПозицииБезКодовМаркировки(Ссылка);
	Если ЗначениеЗаполнено(БезКодов) Тогда
		Результат.Причина = "Нет кодов маркировки (" + БезКодов + ") - ждём сканирования на складе";
		Результат.КодПричины = "НетКодовМаркировки";
		Возврат Результат;
	КонецЕсли;

	// Пиво и безалкогольное пиво без сведений о перевозке Честный знак не зафиксирует, а оператор
	// без фиксации УПД покупателю не отдаст (см. СведенияОПеревозкеДляФиксации).
	Перевозка = СведенияОПеревозкеДляФиксации(Ссылка);
	Если Перевозка <> Неопределено И ЗначениеЗаполнено(Перевозка.Ошибка) Тогда
		Результат.Причина = Перевозка.Ошибка;
		Возврат Результат;
	КонецЕсли;

	// Корректировка без строк с изменением дала бы УКД с пустой ТаблКСчФ, а строку "до = после"
	// получатель отклоняет. Гейт для любого пути отправки, ручного и регламентного.
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.КорректировкаРеализации")
		И НЕ ЕстьИзмененныеСтрокиКорректировки(Ссылка) Тогда
		Результат.Причина = "В корректировке нет строк, где изменились количество, цена, сумма или НДС,"
			+ " - УКД отправлять нечего";
		Возврат Результат;
	КонецЕсли;

	// Корректировка, отправляемая регламентом: те же гейты, что в отборе корректировок
	// (КандидатыКорректировокКОтправке), включая паузу перед отправкой.
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.КорректировкаРеализации")
		И ТипЗнч(Разрешения) <> Тип("Структура") И ЭтоРегламентныйСеанс() Тогда
		ПричинаКорректировки = ПричинаУдержанияКорректировки(Ссылка);
		Если ЗначениеЗаполнено(ПричинаКорректировки) Тогда
			Результат.Причина = ПричинаКорректировки;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Результат.Готов = Истина;

	// точка расширения 1: дополнительные условия конкретной базы
	Если ПрофильБазыПодключен() Тогда
		Парам = Новый Структура("Ссылка, Готов, Причина, ОтправкаНеТребуется",
			Ссылка, Результат.Готов, Результат.Причина, Результат.ОтправкаНеТребуется);
		ВызватьТочкуПрофиля("ПриПроверкеГотовности", Парам);
		Результат.Готов = Парам.Готов;
		Результат.Причина = Парам.Причина;
		Результат.ОтправкаНеТребуется = Парам.ОтправкаНеТребуется;
	КонецЕсли;

	Возврат Результат;
КонецФункции

// Есть ли адрес, который маппинг сможет выгрузить в СвПокуп/Адрес. Цепочка та же, что в настройке
// выгрузки: юридический, затем фактический адрес карточки, затем непомеченной карточки-тезки
// по ИНН (дубли карточек на один ИНН массовые). Представление КИ неограниченной длины -
// сравнивать только через ПОДСТРОКА. Та же цепочка в ТекстТаблицАдресаПокупателя - менять вместе.
Функция ЕстьАдресДляЭДО(Знач Контрагент)
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Ложь;
	КонецЕсли;
	ВидЮр = НаименованиеВидаКИ("Юридический адрес", Ложь);
	ВидФакт = НаименованиеВидаКИ("Фактический адрес", Ложь);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК Признак
	|ИЗ РегистрСведений.КонтактнаяИнформация КАК КИ
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК К
	|	ПО ВЫРАЗИТЬ(КИ.Объект КАК Справочник.Контрагенты) = К.Ссылка
	|ГДЕ КИ.Вид.Наименование В (&ВидЮр, &ВидФакт)
	|	И НЕ ПОДСТРОКА(КИ.Представление, 1, 1) = """"
	|	И (К.Ссылка = &Контрагент
	|		ИЛИ НЕ К.ПометкаУдаления И НЕ К.ИНН = """" И К.ИНН = &ИНН)";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ИНН", Контрагент.ИНН);
	Запрос.УстановитьПараметр("ВидЮр", ВидЮр);
	Запрос.УстановитьПараметр("ВидФакт", ВидФакт);
	Возврат НЕ Запрос.Выполнить().Пустой();
КонецФункции

// Временные таблицы с цепочкой ЕстьАдресДляЭДО для пакетных запросов: КарточкиСАдресом
// (Контрагент) и ИННСАдресом (ИНН). Адрес есть, если контрагент найден в первой либо его ИНН
// во второй. Параметры запроса ставит УстановитьПараметрыАдресаПокупателя.
Функция ТекстТаблицАдресаПокупателя() Экспорт

	Возврат
	"ВЫБРАТЬ РАЗЛИЧНЫЕ К.Ссылка КАК Контрагент, К.ИНН КАК ИНН, К.ПометкаУдаления КАК Помечен
	|ПОМЕСТИТЬ КарточкиСАдресом
	|ИЗ РегистрСведений.КонтактнаяИнформация КАК КИ
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК К
	|	ПО ВЫРАЗИТЬ(КИ.Объект КАК Справочник.Контрагенты) = К.Ссылка
	|ГДЕ КИ.Вид.Наименование В (&ВидЮр, &ВидФакт)
	|	И НЕ ПОДСТРОКА(КИ.Представление, 1, 1) = """"
	|ИНДЕКСИРОВАТЬ ПО Контрагент
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ Карт.ИНН КАК ИНН
	|ПОМЕСТИТЬ ИННСАдресом
	|ИЗ КарточкиСАдресом КАК Карт
	|ГДЕ НЕ Карт.Помечен И НЕ Карт.ИНН = """"
	|ИНДЕКСИРОВАТЬ ПО ИНН";

КонецФункции

Процедура УстановитьПараметрыАдресаПокупателя(Запрос) Экспорт
	Запрос.УстановитьПараметр("ВидЮр", НаименованиеВидаКИ("Юридический адрес", Ложь));
	Запрос.УстановитьПараметр("ВидФакт", НаименованиеВидаКИ("Фактический адрес", Ложь));
КонецПроцедуры

// Текст колонки для документа, покупателю которого нечего выгрузить в СвПокуп/Адрес.
// Отбор очереди такие документы не берет, и без своего текста колонка обещала бы отправку.
Функция ТекстНетАдресаПокупателя() Экспорт
	Возврат "Не отправлен: нет адреса покупателя";
КонецФункции

// Позиции документа, которым нужны коды маркировки, но кодов у них нет.
// Возврат: строка с перечислением позиций; пустая строка - все обеспечено.
// Маркируемость берем у номенклатуры (ВидПродукцииИС), а не по шапке: шапка не говорит, все ли
// позиции обеспечены кодами. ВидыПродукцииИС - перечисление, не справочник.
Функция ПозицииБезКодовМаркировки(Знач Ссылка)

	// Гейт нетиповой целиком: без ВидПродукцииИС или ТЧ ШтрихкодыУпаковок проверять нечего,
	// документ отправляется как обычно.
	Если Метаданные.Перечисления.Найти("ВидыПродукцииИС") = Неопределено
		ИЛИ Метаданные.Справочники.Номенклатура.Реквизиты.Найти("ВидПродукцииИС") = Неопределено
		ИЛИ Метаданные.Документы.РеализацияТоваровУслуг.ТабличныеЧасти.Найти("ШтрихкодыУпаковок") = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	// Коды обязательны не для любого вида продукции, а только для того, по которому в базе включен
	// учет и уже наступила дата обязательной маркировки (регистр ИС МП). Иначе документ, отгруженный
	// до этой даты или по виду без учета, ждал бы кодов вечно. Регистра нет - прежнее правило.
	СоединениеНастроек = "";
	Регистр = Метаданные.РегистрыСведений.Найти("НастройкиУчетаМаркируемойПродукцииИСМП");
	Если Регистр <> Неопределено
		И Регистр.Измерения.Найти("ВидПродукции") <> Неопределено
		И Регистр.Ресурсы.Найти("ВестиУчетПродукции") <> Неопределено
		И Регистр.Ресурсы.Найти("ДатаОбязательнойМаркировки") <> Неопределено Тогда
		СоединениеНастроек = "
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаМаркируемойПродукцииИСМП КАК Наст
		|	ПО Наст.ВидПродукции = Тов.Номенклатура.ВидПродукцииИС
		|		И Наст.ВестиУчетПродукции
		|		И (Наст.ДатаОбязательнойМаркировки = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ Наст.ДатаОбязательнойМаркировки <= Тов.Ссылка.Дата)";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Тов.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ Маркируемые
	|ИЗ Документ.РеализацияТоваровУслуг.Товары КАК Тов" + СоединениеНастроек + "
	|ГДЕ Тов.Ссылка = &Ссылка
	|	И Тов.Номенклатура.ВидПродукцииИС <> ЗНАЧЕНИЕ(Перечисление.ВидыПродукцииИС.ПустаяСсылка)
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ш.ШтрихкодУпаковки.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ СКодами
	|ИЗ Документ.РеализацияТоваровУслуг.ШтрихкодыУпаковок КАК Ш
	|ГДЕ Ш.Ссылка = &Ссылка
	|;
	|ВЫБРАТЬ
	|	М.Номенклатура КАК Номенклатура
	|ИЗ Маркируемые КАК М
	|	ЛЕВОЕ СОЕДИНЕНИЕ СКодами КАК К ПО К.Номенклатура = М.Номенклатура
	|ГДЕ К.Номенклатура ЕСТЬ NULL";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Имена = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если Имена.Количество() >= 3 Тогда
			Имена.Добавить("…");
			Прервать;
		КонецЕсли;
		Имена.Добавить(Лев(СокрЛП(Строка(Выборка.Номенклатура)), 40));
	КонецЦикла;

	Возврат СтрСоединить(Имена, ", ");

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Фиксация в ГИС МТ («разрешение на отгрузку»): пиво и безалкогольное пиво.
//
// До передачи УПД покупателю Честный знак требует зафиксировать её (документ FIX, п. 99 ПП РФ
// № 2173). FIX формирует и подаёт сам оператор (Платформа: статус AWAIT_FIXATION, затем
// отправка или FIXATION_FAILED), если в УПД есть две вещи:
// 1) флаги имени файла N3 = 1 (маркировка) и N4 = 1 (фиксация): ИдФайл 5.03 кончается
//    "_N2_N3_N4_N5_N6_N7", для пива "_0_1_1_0_0_00" (памятка Минпромторга по пиву: при N3 = 0
//    или N4 = 0 ЧЗ отвечает ошибкой 71; поддержка Платформы: «имя документа не содержит флага
//    товарной группы Пиво»). Движок вендора N4 не ставит вовсе, N3 - только по реквизиту
//    СодержитМаркируемыйТовар, которого во многих конфигурациях нет;
// 2) реквизиты перевозки в ИнфПолФХЖ1 (ТекстИнф): НомерПеревозДок, ДатаПеревозДок, РегНомер,
//    у покупателя-ИП ещё Покупатель_ФиасИД - те же ключи, что кладёт Диадок.
// Пиво ядро определяет по типовому реквизиту Номенклатура.ВидПродукцииИС. Откуда взять перевозку,
// знает только база: необязательная точка профиля ПриПолученииСведенийОПеревозке. Нет точки или
// она ничего не нашла - пивной документ не отправляется, с причиной.
////////////////////////////////////////////////////////////////////////////////

// Виды продукции, отгрузку которых фиксируют в ГИС МТ до передачи УПД. Значения, которых нет
// в перечислении этой базы, пропускаются.
// Безалкогольного пива здесь нет: его правила маркировки (ПП РФ № 678, п. 81) фиксации до отгрузки
// не требуют - УПД, подписанный обеими сторонами, оператор передает в ГИС МТ после приемки.
// FIX на безалкогольное пиво ЧЗ отклоняет, и документ покупателю не уходит (FIXATION_FAILED).
Функция ВидыПродукцииСФиксацией() Экспорт
	Результат = Новый Массив;
	Если Метаданные.Перечисления.Найти("ВидыПродукцииИС") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Значения = Метаданные.Перечисления.ВидыПродукцииИС.ЗначенияПеречисления;
	Для Каждого Имя Из СтрРазделить("Пиво,ПивоВПотребительскихУпаковках", ",") Цикл
		Если Значения.Найти(Имя) <> Неопределено Тогда
			Результат.Добавить(Перечисления["ВидыПродукцииИС"][Имя]);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Есть ли в реализации продукция, отгрузку которой фиксируют в ГИС МТ.
Функция ЕстьПродукцияСФиксацией(Знач Ссылка) Экспорт
	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.РеализацияТоваровУслуг")
		ИЛИ Метаданные.Справочники.Номенклатура.Реквизиты.Найти("ВидПродукцииИС") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Виды = ВидыПродукцииСФиксацией();
	Если Виды.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Тов.Ссылка КАК Ссылка
		|ИЗ Документ.РеализацияТоваровУслуг.Товары КАК Тов
		|ГДЕ Тов.Ссылка = &Ссылка
		|	И Тов.Номенклатура.ВидПродукцииИС В (&Виды)");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Виды", Виды);
	Возврат НЕ Запрос.Выполнить().Пустой();
КонецФункции

// Сведения о перевозке для фиксации.
// Возврат: Неопределено - фиксация документу не нужна; иначе Структура:
//   Поля - Массив структур (Идентиф, Значен) для ИнфПолФХЖ1;
//   КППОтгрузки, КППРазгрузки - КПП мест осуществления деятельности продавца и покупателя-ЮЛ
//     (обособленных подразделений: склада и магазина), пусто - не менять;
//   Ошибка - почему документ отправлять нельзя (пусто - можно).
Функция СведенияОПеревозкеДляФиксации(Знач Ссылка) Экспорт

	Если НЕ ЕстьПродукцияСФиксацией(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура("Поля, КППОтгрузки, КППРазгрузки, Ошибка", Новый Массив, "", "", "");

	// Профиль заполняет: НомерДокумента, ДатаДокумента, ГосНомер - документ перевозки (путевой
	// лист, ТТН) и транспортное средство; ФиасИДПокупателя - код адреса покупателя-ИП;
	// КППОтгрузки, КППРазгрузки - КПП мест деятельности (склада продавца и точки покупателя-ЮЛ):
	// Честный знак находит место деятельности по ИНН и КПП из УПД, и по основному КПП юрлица
	// попадает в головной офис, который в ЕГАИС как место торговли заблокирован (ошибка 189
	// ModIsBlockedInEgais); Ошибка - если сам знает, почему сведений нет.
	Ключи = "Ссылка, НомерДокумента, ДатаДокумента, ГосНомер, ФиасИДПокупателя, КППОтгрузки, КППРазгрузки, Ошибка";
	Парам = Новый Структура(Ключи, Ссылка, "", Дата(1, 1, 1), "", "", "", "", "");
	ВызватьНеобязательнуюТочкуПрофиля("ПриПолученииСведенийОПеревозке", Парам);

	Если ЗначениеЗаполнено(Парам.Ошибка) Тогда
		Результат.Ошибка = Парам.Ошибка;
		Возврат Результат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Парам.НомерДокумента) ИЛИ НЕ ЗначениеЗаполнено(Парам.ДатаДокумента) Тогда
		Результат.Ошибка = "В реализации пиво: нет документа перевозки (номер и дата) - без него Честный знак"
			+ " не зафиксирует УПД. Документ перевозки отдаёт профиль базы (ПриПолученииСведенийОПеревозке)";
		Возврат Результат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Парам.ГосНомер) Тогда
		Результат.Ошибка = "В реализации пиво: в документе перевозки " + СокрЛП(Парам.НомерДокумента)
			+ " не указан государственный номер транспортного средства";
		Возврат Результат;
	КонецЕсли;
	ЭтоИП = (СтрДлина(СокрЛП(Ссылка.Контрагент.ИНН)) = 12);
	Если ЭтоИП И НЕ ЗначениеЗаполнено(Парам.ФиасИДПокупателя) Тогда
		Результат.Ошибка = "В реализации пиво, покупатель - ИП: нет кода ФИАС адреса покупателя";
		Возврат Результат;
	КонецЕсли;

	Результат.Поля.Добавить(Новый Структура("Идентиф, Значен", "НомерПеревозДок", СокрЛП(Парам.НомерДокумента)));
	Результат.Поля.Добавить(Новый Структура("Идентиф, Значен", "ДатаПеревозДок", Формат(Парам.ДатаДокумента, "ДФ=dd.MM.yyyy")));
	Результат.Поля.Добавить(Новый Структура("Идентиф, Значен", "РегНомер", СокрЛП(Парам.ГосНомер)));
	Если ЭтоИП Тогда
		Результат.Поля.Добавить(Новый Структура("Идентиф, Значен", "Покупатель_ФиасИД",
			ЛатиницаВКодеФИАС(Парам.ФиасИДПокупателя)));
	КонецЕсли;
	Результат.КППОтгрузки = СокрЛП(Парам.КППОтгрузки);
	Результат.КППРазгрузки = ?(ЭтоИП, "", СокрЛП(Парам.КППРазгрузки));
	Возврат Результат;

КонецФункции

// Код ФИАС (GUID) часто вводят руками, и кириллические буквы, похожие на латинские, в нём
// встречаются. Заменяем их на латинские.
Функция ЛатиницаВКодеФИАС(Знач Код)
	Код = СокрЛП(Строка(Код));
	Кириллица = "аАВЕеКкМОоРрСсТХх";
	Латиница  = "aABEeKkMOoPpCcTXx";
	Для Номер = 1 По СтрДлина(Кириллица) Цикл
		Код = СтрЗаменить(Код, Сред(Кириллица, Номер, 1), Сред(Латиница, Номер, 1));
	КонецЦикла;
	Возврат Код;
КонецФункции

// Постобработка XML УПД под фиксацию: флаги N3/N4 в ИдФайл и реквизиты перевозки в ИнфПолФХЖ1.
// N3 ставится всякому документу с кодами маркировки (НомСредИдентТов), N4 и перевозка - только
// документу с продукцией, требующей фиксации.
// ОтгрузкаЗарегистрирована - Истина для ИУПД, у исходного экземпляра которого фиксация в ЧЗ уже
// состоялась: N4 не ставится (повторная FIX - ERROR_63 «зарегистрирован ранее»), коды остаются.
Функция ДополнитьXMLДляФиксации(Знач Текст, Знач Ссылка, Знач ОтгрузкаЗарегистрирована = Ложь) Экспорт
	Если СтрНайти(Текст, "<НомСредИдентТов") > 0 Тогда
		Текст = УстановитьФлагИдФайл(Текст, 2);
	КонецЕсли;
	Перевозка = СведенияОПеревозкеДляФиксации(Ссылка);
	Если Перевозка = Неопределено ИЛИ ЗначениеЗаполнено(Перевозка.Ошибка) Тогда
		Возврат Текст;
	КонецЕсли;
	// ++ ЩА 21.10.2026 [yan]: руководство ЦРПТ «ЭДО Лайт» 2.1.1.2.3 - флаг передачи сведений об
	// отгрузке в УПДи необязателен, «убедитесь, что сведения об отгрузке не были зарегистрированы ранее
	// при помощи родительского УПД». Изменения в ГИС МТ передает оператор по подписанному УПДи.
	Если НЕ ОтгрузкаЗарегистрирована Тогда
		Текст = УстановитьФлагИдФайл(Текст, 3);
	КонецЕсли;
	// -- ЩА 21.10.2026 [yan].
	// КПП мест деятельности - так же, как подставляет их Диадок: продавцу и грузоотправителю
	// КПП склада, покупателю и грузополучателю КПП точки.
	Если ЗначениеЗаполнено(Перевозка.КППОтгрузки) Тогда
		Текст = ЗаменитьКППУчастника(Текст, "СвПрод", Перевозка.КППОтгрузки);
		Текст = ЗаменитьКППУчастника(Текст, "ГрузОтпр", Перевозка.КППОтгрузки);
	КонецЕсли;
	Если ЗначениеЗаполнено(Перевозка.КППРазгрузки) Тогда
		Текст = ЗаменитьКППУчастника(Текст, "СвПокуп", Перевозка.КППРазгрузки);
		Текст = ЗаменитьКППУчастника(Текст, "ГрузПолуч", Перевозка.КППРазгрузки);
	КонецЕсли;
	Возврат ДополнитьИнфПолФХЖ1(Текст, Перевозка.Поля);
КонецФункции

// КПП юрлица (СвЮЛУч/@КПП) внутри первого узла с этим именем. Узла нет, он без СвЮЛУч (ИП,
// "ОнЖе") - текст не меняется.
Функция ЗаменитьКППУчастника(Знач Текст, Знач ИмяУзла, Знач КПП)
	ПозУзла = СтрНайти(Текст, "<" + ИмяУзла);
	Если ПозУзла = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Хвост = Сред(Текст, ПозУзла);
	КонецУзла = СтрНайти(Хвост, "</" + ИмяУзла + ">");
	Если КонецУзла = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Узел = Лев(Хвост, КонецУзла - 1);
	ПозЮЛ = СтрНайти(Узел, "<СвЮЛУч");
	Если ПозЮЛ = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	ПозКПП = СтрНайти(Сред(Узел, ПозЮЛ), "КПП=""");
	Если ПозКПП = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Начало = ПозЮЛ + ПозКПП - 1 + СтрДлина("КПП=""");
	Длина = СтрНайти(Сред(Узел, Начало), """") - 1;
	Узел = Лев(Узел, Начало - 1) + КПП + Сред(Узел, Начало + Длина);
	Возврат Лев(Текст, ПозУзла - 1) + Узел + Сред(Хвост, КонецУзла);
КонецФункции

// Флаг в хвосте ИдФайл "_N2_N3_N4_N5_N6_N7" (13 знаков, их же правит движок вендора).
// НомерФлага: 1 = N2 (прослеживаемость), 2 = N3 (маркировка), 3 = N4 (фиксация).
Функция УстановитьФлагИдФайл(Знач Текст, Знач НомерФлага)
	Маркер = "ИдФайл=""";
	Поз = СтрНайти(Текст, Маркер);
	Если Поз = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Начало = Поз + СтрДлина(Маркер);
	Длина = СтрНайти(Сред(Текст, Начало), """") - 1;
	Если Длина < 13 Тогда
		Возврат Текст;
	КонецЕсли;
	ИдФайл = Сред(Текст, Начало, Длина);
	Флаги = Прав(ИдФайл, 13);
	Если Сред(Флаги, 1, 1) <> "_" ИЛИ Сред(Флаги, 3, 1) <> "_" ИЛИ Сред(Флаги, 5, 1) <> "_"
		ИЛИ Сред(Флаги, 7, 1) <> "_" Тогда
		Возврат Текст;
	КонецЕсли;
	ПозФлага = НомерФлага * 2;
	НовыйИдФайл = Лев(ИдФайл, СтрДлина(ИдФайл) - 13) + Лев(Флаги, ПозФлага - 1) + "1" + Сред(Флаги, ПозФлага + 1);
	Возврат Лев(Текст, Начало - 1) + НовыйИдФайл + Сред(Текст, Начало + Длина);
КонецФункции

// Дописывает строки ТекстИнф в ИнфПолФХЖ1 (последний узел СвСчФакт). Узел мог уже создать
// движок (МЧД подписанта-физлица) - тогда строки добавляются внутрь, иначе узел создаётся.
Функция ДополнитьИнфПолФХЖ1(Знач Текст, Знач Поля)
	ПозКонца = СтрНайти(Текст, "</СвСчФакт>");
	Если ПозКонца = 0 ИЛИ Поля.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Строки = "";
	Для Каждого Поле Из Поля Цикл
		Строки = Строки + "<ТекстИнф Идентиф=""" + ЭкранироватьАтрибутXML(Поле.Идентиф)
			+ """ Значен=""" + ЭкранироватьАтрибутXML(Поле.Значен) + """/>";
	КонецЦикла;
	Шапка = Лев(Текст, ПозКонца - 1);
	Хвост = Сред(Текст, ПозКонца);
	ПозУзла = СтрНайти(Шапка, "<ИнфПолФХЖ1");
	Если ПозУзла = 0 Тогда
		Возврат Шапка + "<ИнфПолФХЖ1>" + Строки + "</ИнфПолФХЖ1>" + Хвост;
	КонецЕсли;
	ДоУзла = Лев(Шапка, ПозУзла - 1);
	Узел = Сред(Шапка, ПозУзла);
	КонецТега = СтрНайти(Узел, ">");
	Если КонецТега = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Открывающий = Лев(Узел, КонецТега);
	ПослеТега = Сред(Узел, КонецТега + 1);
	Если Прав(Открывающий, 2) = "/>" Тогда
		Возврат ДоУзла + Лев(Открывающий, СтрДлина(Открывающий) - 2) + ">" + Строки
			+ "</ИнфПолФХЖ1>" + ПослеТега + Хвост;
	КонецЕсли;
	ПозЗакр = СтрНайти(ПослеТега, "</ИнфПолФХЖ1>");
	Если ПозЗакр = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат ДоУзла + Открывающий + Лев(ПослеТега, ПозЗакр - 1) + Строки + Сред(ПослеТега, ПозЗакр) + Хвост;
КонецФункции

// Наш ли это адрес ЭДО. Нужен не только отправке: без него каждый отчет и сторож натыкается
// на собственные карточки и показывает их как проблемных контрагентов.
Функция АдресЭДОНаш(Знач Адрес) Экспорт
	Проверяемый = ВРег(СокрЛП(Адрес));
	Если НЕ ЗначениеЗаполнено(Проверяемый) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Свой Из НашиИдентификаторыЭДО() Цикл
		Если ВРег(СокрЛП(Свой)) = Проверяемый Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Собственный ли это адрес организации-ОТПРАВИТЕЛЯ: ее учетная запись, адрес в карточке организации
// и прочие наши адреса из настройки. В отличие от АдресЭДОНаш, адреса ДРУГИХ организаций базы сюда
// не входят: отгрузка между своими юрлицами с разными ИНН (дистрибьютор - дистрибьютор) - обычная
// отправка, а не "самому себе". Ящики всех организаций приходят в базы обменом, поэтому общий
// список держал бы такие отгрузки как ошибку данных.
Функция АдресЭДООрганизацииОтправителя(Знач Адрес, Знач Организация) Экспорт
	Проверяемый = ВРег(СокрЛП(Адрес));
	Если НЕ ЗначениеЗаполнено(Проверяемый) Тогда
		Возврат Ложь;
	КонецЕсли;
	Свои = Новый Массив;
	Если ЗначениеЗаполнено(Организация) Тогда
		Свои.Добавить(ИдентификаторУчастникаЭДО(Организация));
		Для Каждого Запись Из УчетныеЗаписиЭДО() Цикл
			Если Запись.Организация = Организация И ЗначениеЗаполнено(Запись.ИдентификаторУчастника) Тогда
				Свои.Добавить(Запись.ИдентификаторУчастника);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого Доп Из СтрРазделить(ПрочиеНашиАдресаЭДО(), ",", Ложь) Цикл
		Свои.Добавить(Доп);
	КонецЦикла;
	Для Каждого Свой Из Свои Цикл
		Если ВРег(СокрЛП(Свой)) = Проверяемый Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Причина паузы по контрагенту ("" - паузы нет).
Функция ПричинаПаузыКонтрагента(Знач Контрагент) Экспорт
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат "";
	КонецЕсли;
	СвПауза = СвойствоОбъектов("ЭДО_ОтправкаПриостановлена");
	Если СвПауза = Неопределено ИЛИ СвПауза.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	Значение = ЗначениеСвойстваОбъекта(Контрагент, СвПауза);
	Если НЕ ФлагСвойстваВключён(Значение) Тогда
		Возврат "";
	КонецЕсли;
	СвПричина = СвойствоОбъектов("ЭДО_ПричинаПаузы");
	Причина = "";
	Если СвПричина <> Неопределено И НЕ СвПричина.Пустая() Тогда
		Причина = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Контрагент, СвПричина)));
	КонецЕсли;
	Возврат ?(ЗначениеЗаполнено(Причина), Причина, "причина не указана");
КонецФункции

// Поставить контрагента на паузу. Причина пишется человеческим текстом - её увидит бухгалтерия
// в колонке ЭДО, и по ней же принимается решение о возобновлении.
Процедура ПриостановитьОтправкуКонтрагенту(Знач Контрагент, Знач Причина) Экспорт
	СвПауза = СвойствоОбъектов("ЭДО_ОтправкаПриостановлена");
	СвПричина = СвойствоОбъектов("ЭДО_ПричинаПаузы");
	Если СвПауза = Неопределено ИЛИ СвПауза.Пустая() Тогда
		Возврат;
	КонецЕсли;
	ЗаписатьФлагСвойства(Контрагент, СвПауза, Истина);
	Если СвПричина <> Неопределено И НЕ СвПричина.Пустая() Тогда
		// Дата паузы важнее хвоста причины: при длинном тексте режется причина, а не дата.
		ДатаПаузы = " (" + Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy") + ")";
		ДлинаЗначения = СвПричина.ТипЗначения.КвалификаторыСтроки.Длина;
		ДлинаПричины = ?(ДлинаЗначения = 0, 200, ДлинаЗначения) - СтрДлина(ДатаПаузы);
		ЗаписатьЗначениеСвойства(Контрагент, СвПричина, Лев(СокрЛП(Причина), ДлинаПричины) + ДатаПаузы);
	КонецЕсли;
	ЗаписьЖурналаРегистрации("ЭДО.ПаузаОтправки", УровеньЖурналаРегистрации.Предупреждение, , Контрагент,
		Лев("Отправка приостановлена: " + Причина, 5000));
КонецПроцедуры

// Снять паузу. Только руками - автоматика этого не делает (см. ПроверитьГотовностьКОтправке).
Процедура ВозобновитьОтправкуКонтрагенту(Знач Контрагент) Экспорт
	Для Каждого Имя Из СтрРазделить("ЭДО_ОтправкаПриостановлена,ЭДО_ПричинаПаузы", ",") Цикл
		Свойство = СвойствоОбъектов(СокрЛП(Имя));
		Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
		Набор.Отбор.Объект.Установить(Контрагент);
		Набор.Отбор.Свойство.Установить(Свойство);
		Набор.Записать(Истина);
	КонецЦикла;
	ЗаписьЖурналаРегистрации("ЭДО.ПаузаОтправки", УровеньЖурналаРегистрации.Информация, , Контрагент,
		"Отправка возобновлена вручную");
КонецПроцедуры

// Проверка "отправитель = получатель": пустая строка - все в порядке, иначе текст причины.
// Равенство ИНН сторон (розничная продажа) - норма, взводим ОтправкаНеТребуется. Остальные
// совпадения - ошибка данных (контрагенту записан наш адрес): их чинят, а не гасят статусом.
// Новая проверка по умолчанию считается ошибкой данных; флаг ОтправкаНеТребуется взводит только
// та, что доказывает отсутствие получателя как стороны обмена.
Функция ПроверитьСовпадениеСторон(Ссылка, Знач ИдКонтрагента, ОтправкаНеТребуется = Ложь) Экспорт
	ОтправкаНеТребуется = Ложь;
	ИдКонтрагента = СокрЛП(ИдКонтрагента);
	ИННОрганизации = "";
	Если ЕстьРеквизитДокумента(Ссылка, "Организация") И ЗначениеЗаполнено(Ссылка.Организация) Тогда
		ИННОрганизации = СокрЛП(Строка(Ссылка.Организация.ИНН));
	КонецЕсли;
	ИННКонтрагента = "";
	Если ЕстьРеквизитДокумента(Ссылка, "Контрагент") И ЗначениеЗаполнено(Ссылка.Контрагент) Тогда
		ИННКонтрагента = СокрЛП(Строка(Ссылка.Контрагент.ИНН));
	КонецЕсли;

	// равенство ИНН сторон - контрагент заведён на нас же: розничная продажа,
	// отправлять по ЭДО нечего и некому. Это норма, а не дефект.
	Если ЗначениеЗаполнено(ИННОрганизации) И ИННКонтрагента = ИННОрганизации Тогда
		ОтправкаНеТребуется = Истина;
		Возврат "Отправитель и получатель совпадают: у контрагента " + Строка(Ссылка.Контрагент)
			+ " тот же ИНН, что у организации (" + ИННОрганизации + ")";
	КонецЕсли;

	// адрес контрагента - адрес самой организации-отправителя (ошибка данных). Адреса других наших
	// организаций - законный получатель: отгрузка между своими юрлицами.
	Организация = Неопределено;
	Если ЕстьРеквизитДокумента(Ссылка, "Организация") Тогда
		Организация = Ссылка.Организация;
	КонецЕсли;
	Если АдресЭДООрганизацииОтправителя(ИдКонтрагента, Организация) Тогда
		Возврат "Отправитель и получатель совпадают: контрагенту " + Строка(Ссылка.Контрагент)
			+ " записан НАШ адрес ЭДО " + ИдКонтрагента;
	КонецЕсли;

	// наш ИНН внутри идентификатора контрагента (ошибка данных)
	Если ЗначениеЗаполнено(ИННОрганизации) И СтрНайти(ИдКонтрагента, ИННОрганизации) > 0 Тогда
		Возврат "Отправитель и получатель совпадают: в адресе контрагента " + Строка(Ссылка.Контрагент)
			+ " (" + ИдКонтрагента + ") зашит ИНН нашей организации";
	КонецЕсли;

	Возврат "";
КонецФункции

// Все известные собственные адреса ЭДО: адреса учетных записей, записанные организациям
// и дополнительные из настройки (наши ящики у других операторов в базе больше нигде не хранятся).
Функция НашиИдентификаторыЭДО() Экспорт
	Список = Новый Массив;
	Для Каждого Запись Из УчетныеЗаписиЭДО() Цикл
		Если ЗначениеЗаполнено(Запись.ИдентификаторУчастника) Тогда
			Список.Добавить(Запись.ИдентификаторУчастника);
		КонецЕсли;
	КонецЦикла;
	Свойство = СвойствоОбъектов("ЭДО_АдресКонтрагента");
	Если Свойство <> Неопределено И НЕ Свойство.Пустая() Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ВЫРАЗИТЬ(Р.Значение КАК СТРОКА(150)) КАК Значение
			|ИЗ РегистрСведений.ЗначенияСвойствОбъектов КАК Р
			|ГДЕ Р.Свойство = &Свойство
			|	И ВЫРАЗИТЬ(Р.Объект КАК Справочник.Организации) <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)");
		Запрос.УстановитьПараметр("Свойство", Свойство);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.Значение) Тогда
				Список.Добавить(СокрЛП(Строка(Выборка.Значение)));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого Доп Из СтрРазделить(ПрочиеНашиАдресаЭДО(), ",", Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Доп)) Тогда
			Список.Добавить(СокрЛП(Доп));
		КонецЕсли;
	КонецЦикла;
	Возврат Список;
КонецФункции

// ИНН организаций с учетной записью ЭДО. Соответствие ИНН -> Истина.
// Нужна регламенту связей: карточка контрагента с нашим же ИНН - это розничная продажа,
// абонент по такому ИНН находится НАШ, и записывать карточке наш адрес нельзя.
Функция ИННСвоихОрганизаций() Экспорт
	Результат = Новый Соответствие;
	Для Каждого Запись Из УчетныеЗаписиЭДО() Цикл
		Попытка
			ИННОрганизации = СокрЛП(Строка(Запись.Организация.ИНН));
		Исключение
			ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ИННСвоихОрганизаций: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
			ИННОрганизации = "";
		КонецПопытки;
		Если ЗначениеЗаполнено(ИННОрганизации) Тогда
			Результат.Вставить(ИННОрганизации, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Дополнительные собственные адреса ЭДО, через запятую. Хранятся в общих настройках,
// потому что наши ящики у чужих операторов в самой базе не записаны нигде.
Функция ПрочиеНашиАдресаЭДО() Экспорт
	Возврат НастройкаЭДО("ПрочиеНашиАдресаЭДО");
КонецФункции

// Идентификатор участника ЭДО для объекта (контрагента/организации) из
// РегистрСведений.ЗначенияСвойствОбъектов по свойству ЭДО_АдресКонтрагента.
Функция ИдентификаторУчастникаЭДО(Объект) Экспорт
	Свойство = СвойствоОбъектов("ЭДО_АдресКонтрагента");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Значение КАК Значение
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Объект = &Объект И Свойство = &Свойство");
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Строка(Выборка.Значение));
	КонецЕсли;
	Возврат "";
КонецФункции

// Обеспечить действующий токен авторизации (подпись {ts,nonce}, присоединение, POST oauth).
// Принудительный = Истина - перевыпуск, даже если токен есть (реакция на 401). Подпись и POST
// идут в одном серверном вызове: ts живет секунды (Nonce expired).
Функция ОбеспечитьТокен(Принудительный, Знач Организация = Неопределено) Экспорт
	Если НЕ Принудительный И ЗначениеЗаполнено(ТекущийТокен(Организация)) Тогда
		Возврат Истина;
	КонецЕсли;
	ДанныеJSON = ДанныеАвторизацииJSON();
	ПодписьJSON = ПодписатьДанные(ДанныеJSON, Организация);
	Если ПодписьJSON = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Ответ = ПолучитьТокенПоПодписиАвторизации(ДанныеJSON, ПодписьJSON, Организация);
	Возврат Ответ.Успех;
КонецФункции

// Подпись двоичных данных КЭП подписанта (отсоединённая CMS) в СЕРВЕРНОМ контексте.
// Требует контейнер в реестре учётки службы кластера + сертификат в её личном хранилище.
// Возврат: ДвоичныеДанные подписи либо Неопределено (нет сертификата/ошибка крипто).
Функция ПодписатьДанные(Данные, Знач Организация = Неопределено) Экспорт
	Попытка
		Сертификат = СертификатПодписанта(Организация);
		Если Сертификат = Неопределено Тогда
			// ЩА 20.10.2026 [yan]: без записи в ЖР причина неподписанного документа терялась.
			ЗаписьЖурналаРегистрации("ЭДО.Подпись", УровеньЖурналаРегистрации.Ошибка, , Организация,
				"Сертификат подписанта не найден (учетная запись ЭДО организации, хранилище службы кластера)");
			Возврат Неопределено;
		КонецЕсли;
		МенеджерКриптографии = Новый МенеджерКриптографии("", "", 80); // ГОСТ-2012-256, как в обработке провайдера
		МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = "";
		Возврат МенеджерКриптографии.Подписать(Данные, Сертификат);
	Исключение
		// ЩА 20.10.2026 [yan]: криптография падает молча - пишем причину.
		ЗаписьЖурналаРегистрации("ЭДО.Подпись", УровеньЖурналаРегистрации.Ошибка, , Организация,
			"Подпись не выполнена: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Отпечаток сертификата подписанта (Base64) из учетной записи организации.
Функция ОтпечатокПодписанта(Знач Организация = Неопределено) Экспорт
	// Меняется при каждом перевыпуске КЭП: прежний сертификат УЦ ФНС при перевыпуске отзывается.
	Запись = УчетнаяЗаписьЭДО(Организация);
	Возврат ?(Запись = Неопределено, "", Запись.Отпечаток);
КонецФункции

// Фаза 0b: получить токен авторизации по присоединённой подписи служебного JSON.
// ДанныеJSON, ПодписьJSON - ДвоичныеДанные (JSON {ts,nonce} и его отсоединённая CMS).
// Возврат: Структура (Успех Булево, КодСостояния Число, Ошибка Строка).
Функция ПолучитьТокенПоПодписиАвторизации(ДанныеJSON, ПодписьJSON, Знач Организация = Неопределено) Экспорт
	Результат = Новый Структура("Успех, КодСостояния, Ошибка", Ложь, 0, "");
	Обр = ПодключитьОбработкуЭДО();

	Отказ = Ложь;
	ОписаниеОшибки = "";
	Присоединённая = Обр.ПрисоединитьПодпись(ПодписьJSON, ДанныеJSON, Отказ, ОписаниеОшибки);
	Если Отказ Тогда
		Результат.Ошибка = "Присоединение подписи авторизации: " + ОписаниеОшибки;
		Возврат Результат;
	КонецЕсли;

	B64 = ОчиститьBase64(Base64Строка(Присоединённая));
	СИ = Новый СистемнаяИнформация;
	ПарЗапроса = Обр.ПолучитьШаблонПараметровЗапроса("");
	ПарЗапроса.Параметры.Вставить("<Тело>", "grant_type=signature&signature="
		+ КодироватьСтроку(B64, СпособКодированияСтроки.КодировкаURL));
	ПарЗапроса.Параметры.Вставить("ИдентификаторКлиента", СИ.ИдентификаторКлиента);

	Ответ = Обр.API_ПолучитьТокенАвторизацииПоСертификату(ПарЗапроса);
	Результат.КодСостояния = Ответ.КодСостояния;
	Если Ответ.Ошибка Тогда
		Результат.Ошибка = Лев(Строка(Ответ.Описание), 600);
		Возврат Результат;
	КонецЕсли;

	СохранитьТокен(Ответ.Результат.access_token, Организация);
	Результат.Успех = Истина;
	Возврат Результат;
КонецФункции

// Версия настроек, которую обработка вендора держит в реквизите формы ГлавноеОкно: наша запись
// настроек интеграции должна быть той же формы. Поднимет вендор версию - форма перезапишет сама.
Функция ВерсияНастроекОбработкиВендора() Экспорт
	Возврат "1.0.5.3.4.1";
КонецФункции

// Учетные записи организаций у оператора: у каждой свой сертификат, идентификатор участника,
// токен и дата начала отправки, у подписанта-физлица - своя МЧД. Хранятся в общем хранилище
// настроек (правка без реструктуризации). Нет записи организации - операции по ней отказывают.

Функция НоваяУчетнаяЗаписьЭДО() Экспорт
	Возврат Новый Структура(
		"Организация, Отпечаток, ИдентификаторУчастника, ТипПодписанта, НомерМЧД, ДатаМЧД, ДолжностьПодписанта,
		|Оператор, ДатаНачалаОтправки, Хост",
		Неопределено, "", "", "", "", Дата(1, 1, 1), "",
		"Платформа", Дата(1, 1, 1), "");
КонецФункции

// Учетные записи ровно в том виде, в каком они сохранены: без умолчаний, профиля и
// подстановки общих настроек. Этот список правят формы - записывать обратно дополненный
// нельзя, иначе вычисленные значения становятся заданными.
// Возврат: Массив из структур НоваяУчетнаяЗаписьЭДО().
Функция СохраненныеУчетныеЗаписиЭДО() Экспорт

	Записи = Новый Массив;
	УстановитьПривилегированныйРежим(Истина);
	Сохраненные = ПрочитатьНастройкуХранилища("ЭДО_УчетныеЗаписи", "Организации", "");
	Если ТипЗнч(Сохраненные) <> Тип("Массив") Тогда
		Возврат Записи;
	КонецЕсли;

	Для Каждого Сохраненная Из Сохраненные Цикл
		Запись = НоваяУчетнаяЗаписьЭДО();
		ЗаполнитьЗначенияСвойств(Запись, Сохраненная);
		Если ЗначениеЗаполнено(Запись.Организация) Тогда
			Записи.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;

	Возврат Записи;

КонецФункции

// Учетные записи всех подключенных организаций, уже дополненные значениями по умолчанию
// и профилем базы. Возврат: Массив из структур НоваяУчетнаяЗаписьЭДО().
Функция УчетныеЗаписиЭДО() Экспорт

	Записи = СохраненныеУчетныеЗаписиЭДО();

	Для Каждого Запись Из Записи Цикл
		ДополнитьУчетнуюЗаписьЭДО(Запись);
		Параметры = Новый Структура("УчетнаяЗапись", Запись);
		ВызватьНеобязательнуюТочкуПрофиля("ПриОпределенииУчетнойЗаписи", Параметры);
	КонецЦикла;
	Возврат Записи;

КонецФункции

// Учетная запись организации. Организация не указана - единственная учетная запись базы;
// если их несколько, вызывающий обязан указать организацию.
// Возврат: Структура НоваяУчетнаяЗаписьЭДО() либо Неопределено.
Функция УчетнаяЗаписьЭДО(Знач Организация = Неопределено) Экспорт

	Записи = УчетныеЗаписиЭДО();
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Если Записи.Количество() = 0 Тогда
			Возврат Неопределено;
		ИначеЕсли Записи.Количество() = 1 Тогда
			Возврат Записи[0];
		КонецЕсли;
		ВызватьИсключение "У нескольких организаций есть учетная запись ЭДО, а организация для операции не указана";
	КонецЕсли;

	Для Каждого Запись Из Записи Цикл
		Если Запись.Организация = Организация Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Записать список учетных записей целиком. Хранятся только заданные поля: значения по
// умолчанию вычисляются при чтении, чтобы смена реквизитов организации подхватывалась сама.
Процедура ЗаписатьУчетныеЗаписиЭДО(Записи) Экспорт

	// Модуль вызывается с клиента, а запись идет в привилегированном режиме и заменяет отпечатки и
	// хосты отправки всех организаций: без проверки это мог бы сделать любой пользователь.
	Если НЕ ПравоДоступа("Администрирование", Метаданные) Тогда
		ВызватьИсключение "Недостаточно прав для изменения учетных записей ЭДО: нужно право ""Администрирование"".";
	КонецЕсли;

	Сохраняемые = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Если НЕ ЗначениеЗаполнено(Запись.Организация) Тогда
			Продолжить;
		КонецЕсли;
		Сохраняемая = НоваяУчетнаяЗаписьЭДО();
		ЗаполнитьЗначенияСвойств(Сохраняемая, Запись);
		Сохраняемая.Отпечаток = СокрЛП(Сохраняемая.Отпечаток);
		Сохраняемая.ИдентификаторУчастника = СокрЛП(Сохраняемая.ИдентификаторУчастника);
		Сохраняемая.Оператор = СокрЛП(Сохраняемая.Оператор);
		Сохраняемая.Хост = СокрЛП(Сохраняемая.Хост);
		Сохраняемые.Добавить(Сохраняемая);
	КонецЦикла;

	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить("ЭДО_УчетныеЗаписи", "Организации", Сохраняемые, , "");

КонецПроцедуры

// Разовый перенос прежней схемы в учетные записи: отпечаток, дата начала и хост из общих
// настроек становятся заданными полями записи каждой организации с разрешенной отправкой.
// Уже сохраненные записи не трогаются. Возврат: Строка - свод для человека и журнала.
Функция ПеренестиОбщиеНастройкиВУчетныеЗаписи() Экспорт

	Записи = СохраненныеУчетныеЗаписиЭДО();
	Было = Записи.Количество();

	Отпечаток = НастройкаЭДО("ОтпечатокПодписанта");
	Если НЕ ЗначениеЗаполнено(Отпечаток) Тогда
		Возврат "Переносить нечего: общий отпечаток подписанта не задан.";
	КонецЕсли;

	Организации = ОрганизацииСРазрешеннойОтправкой();
	Если Организации.Количество() = 0 Тогда
		Возврат "Переносить некому: нет организаций с разрешенной отправкой.";
	КонецЕсли;

	Добавленные = Новый Массив;
	Для Каждого Организация Из Организации Цикл
		Существующая = Неопределено;
		Для Каждого Запись Из Записи Цикл
			Если Запись.Организация = Организация Тогда
				Существующая = Запись;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Существующая <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Запись = НоваяУчетнаяЗаписьЭДО();
		Запись.Организация = Организация;
		Запись.Отпечаток = Отпечаток;
		Запись.ДатаНачалаОтправки = НастройкаЭДО("ДатаНачалаОтправки");
		Запись.Хост = НастройкаЭДО("Хост");
		ДополнитьУчетнуюЗаписьЭДО(Запись);
		Записи.Добавить(Запись);
		Добавленные.Добавить(Строка(Организация));
	КонецЦикла;

	Если Добавленные.Количество() = 0 Тогда
		Возврат "Все организации с разрешенной отправкой уже имеют учетные записи, перенос не потребовался.";
	КонецЕсли;

	ЗаписатьУчетныеЗаписиЭДО(Записи);

	Свод = "Перенесено записей: " + Добавленные.Количество() + " (было " + Было + ")."
		+ Символы.ПС + "Организации: " + СтрСоединить(Добавленные, ", ");
	ЗаписьЖР("ЭДО.ПереносНастроекВУчетныеЗаписи", "Информация", , , Свод);
	Возврат Свод;

КонецФункции

// Что мешает работать учетной записи. Возврат: Массив строк, пустой - все в порядке.
Функция НедостаткиУчетнойЗаписиЭДО(Запись) Экспорт

	Претензии = Новый Массив;
	Префикс = "организация «" + Строка(Запись.Организация) + "»: ";

	Сертификат = СостояниеСертификатаПоОтпечатку(Запись.Отпечаток, Ложь);
	Если НЕ Сертификат.Задан Тогда
		Претензии.Добавить(Префикс + "не задан отпечаток сертификата подписанта");
	ИначеЕсли НЕ Сертификат.Найден Тогда
		Претензии.Добавить(Префикс + "сертификат подписанта не установлен у учётки сервера 1С");
	ИначеЕсли Сертификат.Просрочен Тогда
		Претензии.Добавить(Префикс + "сертификат подписанта просрочен "
			+ Формат(Сертификат.ДействителенПо, "ДФ=dd.MM.yyyy"));
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Запись.ИдентификаторУчастника) Тогда
		Претензии.Добавить(Префикс + "не определен идентификатор участника ЭДО");
	КонецЕсли;

	Если Запись.ТипПодписанта = "ФЛ"
		И (НЕ ЗначениеЗаполнено(Запись.НомерМЧД) ИЛИ НЕ ЗначениеЗаполнено(Запись.ДатаМЧД)) Тогда
		Претензии.Добавить(Префикс + "подписант - физлицо, не заданы номер и дата МЧД");
	КонецЕсли;

	// Дата уже прошла через ДополнитьУчетнуюЗаписьЭДО с запасным значением из общей настройки:
	// пусто - значит не задано ни там, ни там.
	Если НЕ ЗначениеЗаполнено(Запись.ДатаНачалаОтправки) Тогда
		Претензии.Добавить(Префикс + "не задана дата начала отправки");
	КонецЕсли;

	Возврат Претензии;

КонецФункции

Функция НесколькоУчетныхЗаписейЭДО() Экспорт
	Возврат УчетныеЗаписиЭДО().Количество() > 1;
КонецФункции

// Организация по ее идентификатору участника ЭДО; Неопределено, если такой учетной записи нет.
Функция ОрганизацияПоИдентификаторуЭДО(Знач Идентификатор) Экспорт
	Для Каждого Запись Из УчетныеЗаписиЭДО() Цикл
		Если ВРег(Запись.ИдентификаторУчастника) = ВРег(СокрЛП(Идентификатор)) Тогда
			Возврат Запись.Организация;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// ЩА 20.10.2026 [yan]: есть ли у документа реквизит - вместо перехвата обращения к нему.
Функция ЕстьРеквизитДокумента(Знач Документ, Знач Имя) Экспорт
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Документ.Метаданные().Реквизиты.Найти(Имя) <> Неопределено;
КонецФункции

// Организация документа; Неопределено, если документа нет или у него нет такого реквизита.
Функция ОрганизацияДокумента(Знач Документ) Экспорт
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ ЕстьРеквизитДокумента(Документ, "Организация") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Документ.Организация;
КонецФункции

// Учетная запись, без которой операция с оператором невозможна: отказ называет организацию.
Функция ОбязательнаяУчетнаяЗаписьЭДО(Знач Организация = Неопределено) Экспорт
	Запись = УчетнаяЗаписьЭДО(Организация);
	Если Запись = Неопределено Тогда
		ВызватьИсключение ?(ЗначениеЗаполнено(Организация),
			"У организации «" + Строка(Организация) + "» нет учетной записи ЭДО",
			"В базе не задана учетная запись ЭДО ни для одной организации");
	КонецЕсли;
	Возврат Запись;
КонецФункции

Функция ОрганизацииСРазрешеннойОтправкой() Экспорт

	Результат = Новый Массив;
	Свойство = СвойствоОбъектов("ЭДО_РазрешенаОтправка");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Организации.Ссылка КАК Ссылка
		|ИЗ Справочник.Организации КАК Организации
		|ГДЕ НЕ Организации.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО Организации.Наименование");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Значение = ЗначениеСвойстваОбъекта(Выборка.Ссылка, Свойство);
		Если ТипЗнч(Значение) = Тип("Булево") Тогда
			Разрешено = Значение;
		Иначе
			Текст = ВРег(СокрЛП(Строка(Значение)));
			Разрешено = (Текст = "ДА" ИЛИ Текст = "ИСТИНА" ИЛИ Текст = "TRUE" ИЛИ Текст = "1");
		КонецЕсли;
		Если Разрешено Тогда
			Результат.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Незаданные поля берутся из организации: идентификатор - из ее свойства ЭДО_АдресКонтрагента
// (его же ставит в файл УПД обработка вендора), иначе по формуле оператора; тип подписанта -
// по длине ИНН.
Процедура ДополнитьУчетнуюЗаписьЭДО(Запись)

	ИНН = СокрЛП(Запись.Организация.ИНН);

	Если НЕ ЗначениеЗаполнено(Запись.ИдентификаторУчастника) Тогда
		Запись.ИдентификаторУчастника = ИдентификаторУчастникаЭДО(Запись.Организация);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Запись.ИдентификаторУчастника) И ЗначениеЗаполнено(ИНН) Тогда
		Если СтрДлина(ИНН) = 10 Тогда
			Запись.ИдентификаторУчастника = "2VO-" + ИНН + "-" + СокрЛП(Запись.Организация.КПП)
				+ "0000000000000000000000";
		Иначе
			Запись.ИдентификаторУчастника = "2VO-" + ИНН + "-00000000000000000000000000000";
		КонецЕсли;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Запись.ТипПодписанта) Тогда
		Запись.ТипПодписанта = ?(СтрДлина(ИНН) = 10, "ЮЛ", "ИП");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Запись.Хост) Тогда
		Запись.Хост = "api.platformaofd.ru";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Запись.Оператор) Тогда
		Запись.Оператор = "Платформа";
	КонецЕсли;

КонецПроцедуры

// Контракт профиля базы, версия 1. Логика конкретной базы живет в общем модуле ЭДО_ПрофильБазы,
// своем у каждой установки; профиля нет - работает типовое.
// Профиль пишется только для того, чего в типовой конфигурации нет вовсе (чужая ТЧ, нетиповой
// реквизит отбора); вариации типовой ядро определяет само (см. ТекстНастройкиРеализации).
//
// Методы профиля принимают одну структуру "Параметры" и меняют ее поля на месте:
// ПриПроверкеГотовности(Параметры) - Ссылка, Готов, Причина, ОтправкаНеТребуется
// ПриФормированииНастройкиКонфигурации(Параметры) - Текст
// ПриФормированииНастройкиРеализации(Параметры) - Текст
// ПриФормированииXML(Параметры) - Ссылка, Текст
// ПриОтбореДокументовКОтправке(Параметры) - фильтрует или собирает очередь отправки
// ПриОпределенииУчетнойЗаписи(Параметры) - УчетнаяЗапись: дополняет учетную запись организации
//   (отпечаток, тип подписанта, МЧД) из мест, где их хранит база. Необязательный метод.
// ПриПроверкеКодовМаркировки(Параметры) - Ссылки, Результат: сверка кодов маркировки документов
//   с Честным знаком по ручной кнопке разбора; ничего не меняет в документах и не влияет
//   на отправку, только показ. Необязательный метод: своего способа обращения в Честный знак
//   у ядра нет вовсе, он есть только у профилей баз с маркировкой.
// ПриИзмененииСостоянияДокумента(Параметры) - Ссылка, КодСостояния, Событие, ИдентификаторДокумента:
//   извещение, что состояние документа у оператора изменилось. Событие: "Отправлен" (документ
//   ушел оператору, КодСостояния "40"), "Аннулирован" (аннулирование завершено у оператора),
//   "СменаСтатуса" (прочая смена при сверке; КодСостояния - текст статуса из колонки ЭДО).
//   Зовется только при реальной смене. Ошибка профиля пишется в журнал и не ломает отправку.
//   Необязательный метод: версию контракта он не меняет, старые профили работают как раньше.
// ПриПолученииСведенийОПеревозке(Параметры) - Ссылка, НомерДокумента, ДатаДокумента, ГосНомер,
//   ФиасИДПокупателя, КППОтгрузки, КППРазгрузки, Ошибка: документ перевозки реализации (путевой лист,
//   ТТН) и госномер ТС для фиксации пива в ГИС МТ, код ФИАС адреса покупателя-ИП, КПП мест
//   деятельности продавца (склад) и покупателя-ЮЛ (точка). Зовется только для реализаций с пивом
//   (Номенклатура.ВидПродукцииИС). Необязательный метод: без него пивные документы не отправляются.
// ПриПроверкеИсходниковУДругогоОператора(Параметры) - Исходники (Массив реализаций), Подписаны
//   (Соответствие: ссылка -> Истина): какие исходники корректировок покупатель подписал у другого
//   оператора ЭДО. Тогда УКД к ним уходит через Платформу и без принятого здесь исходника.
//   Необязательный метод: без него УКД уходит только к исходникам, принятым в Платформе.
// ПриСозданииДокументаПоВходящему(Параметры) - Разбор (см. ЭДО_ВходящиеДокументы.РазобратьУПД),
//   Организация, ИдВходящего, ДокументОбъект, Сообщения (Массив строк), СтандартнаяОбработка:
//   создать документ базы по входящему УПД самому (ДокументОбъект, СтандартнаяОбработка = Ложь)
//   или оставить реализацию по умолчанию (поступление типовой УТ 10.3). Необязательный метод.
// ПередЗаписьюДокументаПоВходящему(Параметры) - те же параметры: донастроить ДокументОбъект
//   перед записью (поля и табличные части базы). Необязательный метод.
// ПриЗаполненииШапкиПоступления(Параметры) - Документ (ДокументОбъект поступления), Пользователь, Валюта,
//   СтандартнаяОбработка: заполнить шапку нового поступления самому (СтандартнаяОбработка = Ложь), если
//   у ЗаполнениеДокументов.ЗаполнитьШапкуДокумента в базе другая сигнатура (КА 1.1 - три параметра).
//   Необязательный метод: без него - вызов УТ 10.3 с видом операции «Покупка».
// ВерсияКонтракта() - число, сверяется с ВерсияКонтрактаПрофиля()

Функция ВерсияКонтрактаПрофиля() Экспорт
	Возврат 1;
КонецФункции

// Имя модуля профиля базы ("" - профиля нет). Ищем новое имя, затем старое ПЭДО_: без старого
// ядро между выкатками двух расширений молча работало бы без профиля, то есть без гейта
// готовности. Старое имя убрать, когда профили всех баз переедут на ЭДО_.
Функция ИмяМодуляПрофиляБазы() Экспорт
	Если Метаданные.ОбщиеМодули.Найти("ЭДО_ПрофильБазы") <> Неопределено Тогда
		Возврат "ЭДО_ПрофильБазы";
	КонецЕсли;
	Если Метаданные.ОбщиеМодули.Найти("ПЭДО_ПрофильБазы") <> Неопределено Тогда
		Возврат "ПЭДО_ПрофильБазы";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ПрофильБазыПодключен() Экспорт
	Возврат ЗначениеЗаполнено(ИмяМодуляПрофиляБазы());
КонецФункции

// Вызов точки расширения. Профиля нет - тихо выходим (это норма). Ошибка внутри профиля
// пробрасывается, а не глушится: молча отправленный не тот XML не откатить.
Процедура ВызватьТочкуПрофиля(Знач Метод, Параметры) Экспорт
	Если НЕ ПрофильБазыПодключен() Тогда
		Возврат;
	КонецЕсли;
	// Именно Выполнить, а не Вычислить: точки профиля - процедуры, а Вычислить оператором модуль
	// не компилирует целиком, и ни сборка, ни /CheckConfig этого не ловят.
	Попытка
		Выполнить(ИмяМодуляПрофиляБазы() + "." + Метод + "(Параметры)");
	Исключение
		ВызватьИсключение "Профиль базы, метод " + Метод + ": " + ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

// Вызов точки, появившейся в контракте позже: профиль, написанный до нее, метода не содержит,
// и это не ошибка. Любая другая ошибка профиля пробрасывается, как у обязательных точек.
Процедура ВызватьНеобязательнуюТочкуПрофиля(Знач Метод, Параметры) Экспорт
	Если НЕ ПрофильБазыПодключен() Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Выполнить(ИмяМодуляПрофиляБазы() + "." + Метод + "(Параметры)");
	Исключение
		Описание = ОписаниеОшибки();
		Если СтрНайти(Описание, "(" + Метод + ")") > 0 И СтрНайти(Описание, "не обнаружен") > 0 Тогда
			Возврат;
		КонецЕсли;
		ВызватьИсключение "Профиль базы, метод " + Метод + ": " + Описание;
	КонецПопытки;
КонецПроцедуры

// Сверка версии контракта - один раз на прогон, из НовыйКонтекстПрогона.
// Профиль под другую редакцию точек молча не подключаем: он либо не будет вызван вовсе,
// либо получит структуру не того состава.
Процедура ПроверитьВерсиюПрофиля()
	Если НЕ ПрофильБазыПодключен() Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ВерсияПрофиля = Вычислить(ИмяМодуляПрофиляБазы() + ".ВерсияКонтракта()");
	Исключение
		ВызватьИсключение "Профиль базы не отвечает на ВерсияКонтракта(): " + ОписаниеОшибки();
	КонецПопытки;
	Если ВерсияПрофиля <> ВерсияКонтрактаПрофиля() Тогда
		ВызватьИсключение "Профиль базы написан под версию контракта " + ВерсияПрофиля
			+ ", ядро ожидает " + ВерсияКонтрактаПрофиля();
	КонецЕсли;
КонецПроцедуры

// Ручная проверка кодов маркировки в Честном знаке - кнопка разбора, ничего не меняет
// в документах и не влияет на отправку, только показ. Как ходить в Честный знак, знает
// только профиль конкретной базы (свой общий модуль интеграции), у ядра такого способа
// нет вовсе - поэтому точка целиком в профиле, а не разложена по параметрам здесь.
// Возврат: Структура(Поддержано Булево, Текст Строка, Всего Число, Ошибок Число).
// Поддержано = Ложь, если профиля нет или он точку не реализует - тогда Текст объясняет,
// почему нечего показывать, а Всего и Ошибок остаются 0.
Функция ПроверитьКодыМаркировки(Знач Ссылки) Экспорт
	Результат = Новый Структура("Поддержано, Текст, Всего, Ошибок",
		Ложь, "Проверка кодов маркировки не поддержана профилем базы", 0, 0);
	Парам = Новый Структура("Ссылки, Результат", Ссылки, Результат);
	// Точка НЕОБЯЗАТЕЛЬНАЯ: профиль без неё просто не тронет Парам.Результат, и умолчание
	// выше так и останется ответом - контракт версии поднимать не нужно, старые профили
	// продолжают работать как раньше, просто без этой кнопки.
	ВызватьНеобязательнуюТочкуПрофиля("ПриПроверкеКодовМаркировки", Парам);
	Возврат Парам.Результат;
КонецФункции

// Контекст прогона отправки: движок вендора и кэш настроек маппинга, собранные ОДИН раз.
// Мотив - замер 28.08.2026 на боевой базе: подключение движка, запись клиентских настроек
// и ШтатныйЗапуск стоят ~125 мс (78 + 46), и раньше это делалось НА КАЖДЫЙ документ -
// на пакете в 500 накладных лишняя минута и 500 записей в ХранилищеОбщихНастроек впустую.
// Переиспользование движка между документами проверено фактом: тела XML пяти документов
// совпали с поштучной сборкой байт в байт. Различается только ИдФайл - там свежий GUID
// на каждую выгрузку, поэтому сравнивать выгрузки целиком нельзя, XML недетерминирован.
Функция НовыйКонтекстПрогона() Экспорт
	ПроверитьВерсиюПрофиля();
	Контекст = Новый Структура("Обработка, Кэш");
	Контекст.Обработка = ПодключитьОбработкуЭДО();
	ЗагрузитьКлиентскиеНастройки();
	ОбеспечитьИнтеграциюОбработки(Контекст.Обработка);
	Контекст.Кэш = Контекст.Обработка.ШтатныйЗапуск();
	Контекст.Кэш.Форматы.Вставить("ON_NSCHFDOPPR", МакетТекст("СхемаУПД"));
	// Схему УКД тоже подкладываем сами: собственный механизм движка достает XSD из zip-макета
	// "Форматы" и падает ("Extra content at the end of the document").
	Контекст.Кэш.Форматы.Вставить("ON_NKORSCHFDOPPR", МакетТекст("СхемаУКД"));
	Контекст.Обработка.ПараметрыПодписанияЯдра = ПараметрыПодписанияДляОбработкиВендора();
	Возврат Контекст;
КонецФункции

// Параметры подписанта-физлица по МЧД для обработки вендора: без них МЧД не попадает в XML УПД.
// Для ИП и юрлица не передаются - вендор тогда берет подписанта из данных 1С, как раньше.
// Возврат: Соответствие (организация -> структура в формате ПараметрыАвторизацииИПодписания вендора).
Функция ПараметрыПодписанияДляОбработкиВендора()

	Результат = Новый Соответствие;
	Для Каждого УчетнаяЗапись Из УчетныеЗаписиЭДО() Цикл
		Если УчетнаяЗапись.ТипПодписанта <> "ФЛ" Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Подписант = ПодписантДляОператора(УчетнаяЗапись.Организация);
		Исключение
			ЗаписьЖР("ЭДО.Подписант", "Предупреждение", , УчетнаяЗапись.Организация,
				"МЧД подписанта не передана в формирование УПД: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;

		// Ключи - те, что вендор читает из субъекта сертификата: фамилия и "имя отчество".
		Субъект = Новый Структура("OID2_5_4_4, OID2_5_4_42", Подписант.ФИО.last,
			СокрЛП(Подписант.ФИО.first + " " + Подписант.ФИО.middle));
		ПараметрыПодписания = Новый Структура("Субъект, ТипСубъекта, МчдGUID, ДатаНачалаДействияМЧД, ДолжностьФизлица",
			Субъект, "ФЛ", СокрЛП(УчетнаяЗапись.НомерМЧД),
			?(ЗначениеЗаполнено(УчетнаяЗапись.ДатаМЧД), Формат(УчетнаяЗапись.ДатаМЧД, "ДФ=yyyy-MM-dd"), ""),
			Подписант.Должность);
		Результат.Вставить(УчетнаяЗапись.Организация,
			Новый Структура("ИспользуетсяПодписание, ПараметрыПодписания", Истина, ПараметрыПодписания));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Настройки интеграции движка вендора: заводятся один раз, если их ещё нет.
Процедура ОбеспечитьИнтеграциюОбработки(Обр)
	Если Обр.ПолучитьИнтеграциюНаСервере() = Неопределено Тогда
 // Писать сюда одно поле "СпособИнтеграции" нельзя: настройка общая для всех, форма ГлавноеОкно
 // читает ту же запись и без ВерсияНастроек падает на открытии ("Поле объекта не обнаружено").
 // Состав ниже повторяет ветку "первый запуск" формы, отличаясь только способом интеграции.
		Интеграция = Новый Структура;
		Интеграция.Вставить("СпособИнтеграции", 2);
		Интеграция.Вставить("КаталогОбмена");
		Интеграция.Вставить("ИспользоватьКриптографию", Ложь);
		Интеграция.Вставить("ИнтерактивноОбновлятьСтатусыДО", Ложь);
		Интеграция.Вставить("ПараметрыАвторизацииИПодписания", Новый Соответствие);
		Интеграция.Вставить("ВерсияНастроек", ВерсияНастроекОбработкиВендора());
		Интеграция.Вставить("МассоваяВыгрузка", Новый Структура);
		Интеграция.Вставить("ЭтоПервыйЗапуск", Ложь);
		Обр.СохранитьИнтеграциюНаСервере(Интеграция);
	КонецЕсли;
КонецПроцедуры

// Фаза 1 без обращения к оператору: XML титула продавца в том виде, в каком он уйдет на ФЛК.
// Исправление - Структура из ИсправлениеУПД (для ИУПД) или Неопределено.
// Возврат: Структура (Статус "ОК" | "Отсеян" | "ОшибкаФормирования", ТекстXML, Сообщение).
Функция СформироватьXMLДокумента(Ссылка, Контекст = Неопределено, Знач Исправление = Неопределено) Экспорт

	Результат = Новый Структура("Статус, ТекстXML, Сообщение", "", "", "");

	// Контекст прогона переиспользуется на весь пакет; при одиночном вызове собирается свой.
	Если Контекст = Неопределено Тогда
		Контекст = НовыйКонтекстПрогона();
	КонецЕсли;
	Обр = Контекст.Обработка;
	Кэш = Контекст.Кэш;

	МассивДокументов = Новый Массив;
	МассивДокументов.Добавить(Ссылка);
	ФорматДокумента = ФорматВыгрузкиДокумента(Ссылка);
	РезВыгрузки = Обр.ВыгрузитьМассивДокументов(МассивДокументов, Ссылка.Организация, "", ФорматДокумента, Кэш, Истина, "");
	Если РезВыгрузки = Неопределено Тогда
		Результат.Статус = "Отсеян";
		Результат.Сообщение = "Документ отсеян условиями отмены выгрузки (ИНН покупателя/ставка НДС 18%/…)";
		Возврат Результат;
	КонецЕсли;
	СтрокаВыгрузки = РезВыгрузки.ВыгрузкаДокументов[0];
	Если СтрокаВыгрузки.ОшибкиФормирования Тогда
		Результат.Статус = "ОшибкаФормирования";
		Результат.Сообщение = Лев(Строка(СтрокаВыгрузки.ОписанияОшибокФормирования), 1000);
		Возврат Результат;
	КонецЕсли;
	// Schematron ФНС требует КрНаимСтрПр рядом с СвДТ/@КодПроисх, а декларативный движок такой
	// элемент не выгружает. Дописываем его постобработкой XML до подписи.
	ТекстXML = ДополнитьКрНаимСтрПр(Строка(СтрокаВыгрузки.Выгрузка));

	// точка расширения 4: то, что декларативный движок не выгружает вовсе
	// (у нас выше - КрНаимСтрПр; у базы с маркировкой здесь дописывается НомСредИдентТов)
	Если ПрофильБазыПодключен() Тогда
		Парам = Новый Структура("Ссылка, Текст", Ссылка, ТекстXML);
		ВызватьТочкуПрофиля("ПриФормированииXML", Парам);
		ТекстXML = Парам.Текст;
	КонецЕсли;

	// Фиксация в ГИС МТ: флаги имени файла и реквизиты перевозки - после профиля, когда коды
	// маркировки (НомСредИдентТов) уже в документе.
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		ТекстXML = ДополнитьXMLДляФиксации(ТекстXML, Ссылка,
			Исправление <> Неопределено И Исправление.ОтгрузкаЗарегистрирована);
	КонецЕсли;

	Если Исправление <> Неопределено Тогда
		Дополнение = ДополнитьИсправлением(ТекстXML, Исправление);
		Если ЗначениеЗаполнено(Дополнение.Ошибка) Тогда
			Результат.Статус = "ОшибкаФормирования";
			Результат.Сообщение = Дополнение.Ошибка;
			Возврат Результат;
		КонецЕсли;
		ТекстXML = Дополнение.Текст;
	КонецЕсли;

	Результат.Статус = "ОК";
	Результат.ТекстXML = ТекстXML;
	Возврат Результат;

КонецФункции

// Фаза 1 и ФЛК оператора (POST создает документ у оператора; до подписи он никуда не уходит).
// Исправление - для ИУПД, см. ИсправлениеУПД.
// Возврат: Структура
// Статус - "ОК" | "Отсеян" | "ОшибкаФормирования" | "НуженТокен" | "ОшибкаHTTP"
// ИдДокумента - id, присвоенный оператором (при "ОК")
// ДвоичныеXML - ДвоичныеДанные титула (windows-1251), для подписи
// Сообщение - текст ошибки/причины
// КодHTTP - код ответа ФЛК
Функция ПодготовитьДокументИФЛК(Ссылка, Контекст = Неопределено, Знач Исправление = Неопределено) Экспорт
	Результат = Новый Структура("Статус, ИдДокумента, ДвоичныеXML, Сообщение, КодHTTP", "", "", Неопределено, "", 0);

	// -- Фаза 1: сборка XML движком обработки ---
	Сборка = СформироватьXMLДокумента(Ссылка, Контекст, Исправление);
	Если Сборка.Статус <> "ОК" Тогда
		Результат.Статус = Сборка.Статус;
		Результат.Сообщение = Сборка.Сообщение;
		Возврат Результат;
	КонецЕсли;
	ТекстXML = Сборка.ТекстXML;

	ДвоичныеXML = ПолучитьДвоичныеДанныеИзСтроки(ТекстXML, "windows-1251", Ложь);
	Результат.ДвоичныеXML = ДвоичныеXML;

	// -- Фаза 2: ФЛК (POST /documents) ---
	Токен = ТекущийТокен(ОрганизацияДокумента(Ссылка));
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		Результат.Статус = "НуженТокен";
		Возврат Результат;
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/xml");
	Заголовки.Вставить("accept", "application/json;charset=UTF-8");
	Заголовки.Вставить("Authorization", "Bearer " + Токен);

	Соединение = HTTPСоединениеЭДО();
	Запрос = Новый HTTPЗапрос(ПутьСервиса("document") + "/public/api/v3/documents", Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(ДвоичныеXML);
	// С этой строки документ мог появиться у оператора. Исключение до нее - ошибка сборки,
	// а не обрыв связи, и повтор дубля не даст (см. ОтправитьПоЭДО, ветка Исключение).
	Контекст.Вставить("ЗапросКОператоруУшел", Истина);
	Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);

	Результат.КодHTTP = Ответ.КодСостояния;
	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	Если Ответ.КодСостояния = 401 Тогда
		Результат.Статус = "НуженТокен";
		Возврат Результат;
	КонецЕсли;
	Если Ответ.КодСостояния <> 200 Тогда
		Результат.Статус = "ОшибкаHTTP";
		ПодсказкаФЛК = ЧеловеческоеОписаниеОшибкиФЛК(ТелоОтвета);
		Результат.Сообщение = ?(ПодсказкаФЛК <> "", ПодсказкаФЛК + ". Подробности: ", "")
			+ "ФЛК HTTP " + Ответ.КодСостояния + ": " + Лев(ТелоОтвета, 800);
		Возврат Результат;
	КонецЕсли;

	ИдДокумента = ИзвлечьИдентификатор(ТелоОтвета);
	Если НЕ ЗначениеЗаполнено(ИдДокумента) Тогда
		Результат.Статус = "ОшибкаHTTP";
		Результат.Сообщение = "ФЛК вернул 200, но id документа не найден: " + Лев(ТелоОтвета, 800);
		Возврат Результат;
	КонецЕсли;

	Результат.Статус = "ОК";
	Результат.ИдДокумента = ИдДокумента;
	Возврат Результат;
КонецФункции

// Фаза 4: присоединение подписи (PUT /signature - отправка стартует сама) + write-back статуса.
// ПодписьДокумента - ДвоичныеДанные (отсоединённая CMS титула).
// Возврат: Структура (Статус "Отправлен"|"НуженТокен"|"ОшибкаHTTP", КодHTTP, Сообщение).
Функция ПрисоединитьПодписьИЗаписать(Ссылка, ИдДокумента, ПодписьДокумента) Экспорт
	Результат = Новый Структура("Статус, КодHTTP, Сообщение", "", 0, "");
	Организация = ОрганизацияДокумента(Ссылка);
	Токен = ТекущийТокен(Организация);
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		Результат.Статус = "НуженТокен";
		Возврат Результат;
	КонецЕсли;

	Тело = ТелоПодписиДокумента(ПодписьДокумента, Организация);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json;charset=UTF-8");
	Заголовки.Вставить("accept", "application/json;charset=UTF-8");
	Заголовки.Вставить("Authorization", "Bearer " + Токен);

	Соединение = HTTPСоединениеЭДО();
	Запрос = Новый HTTPЗапрос(ПутьСервиса("document") + "/public/api/v4/documents/" + ИдДокумента + "/signature", Заголовки);
	Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Ответ = Соединение.ВызватьHTTPМетод("PUT", Запрос);

	Результат.КодHTTP = Ответ.КодСостояния;
	Если Ответ.КодСостояния = 401 Тогда
		Результат.Статус = "НуженТокен";
		Возврат Результат;
	КонецЕсли;
	Если Ответ.КодСостояния <> 200 Тогда
		Результат.Статус = "ОшибкаHTTP";
		Результат.Сообщение = "Присоединение подписи HTTP " + Ответ.КодСостояния + ": "
			+ Лев(Ответ.ПолучитьТелоКакСтроку("UTF-8"), 800);
		Возврат Результат;
	КонецЕсли;

	// отправка стартовала - фиксируем локальный статус 40 (Отправлен) + идентификатор
	ЗаписатьСтатусЭДО(Ссылка, 40, ИдДокумента);
	Результат.Статус = "Отправлен";
	Возврат Результат;
КонецФункции

// Текущий токен из хранилища (пустая строка, если нет).
// Токен выдается пользователю кабинета по сертификату, поэтому хранится по отпечатку и общим
// для всех пользователей базы: регламент и бухгалтер пользуются одним и тем же.
Функция ТекущийТокен(Знач Организация = Неопределено) Экспорт
	Отпечаток = ОтпечатокПодписанта(Организация);
	Если НЕ ЗначениеЗаполнено(Отпечаток) Тогда
		Возврат "";
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Возврат Строка(ПрочитатьНастройкуХранилища("ЭДО_Токены", Отпечаток, ""));
КонецФункции

// Write-back статуса ЭДО и идентификатора документа в РегистрСведений.ЗначенияСвойствОбъектов.
// Статус - Число (карта обработки: 40 Отправлен, 60 Отклонён, 13 Аннулирован, 90 Удалён, 11 Ожидает оплаты).
Процедура ЗаписатьСтатусЭДО(Ссылка, Статус, ИдДокумента) Экспорт
	СвойствоСтатус = СвойствоОбъектов("ЭДО_КодСостояния");
	СвойствоИд     = СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	СтатусХранится = СвойствоСтатус <> Неопределено И НЕ СвойствоСтатус.Пустая();
	// Прежний код читаем только перед записью 40: это единственный код, о котором узнает профиль,
	// и остальные записи (взят, создан, прерван) не должны получать лишний запрос.
	ПрежнийКод = Неопределено;
	Если Статус = 40 И СтатусХранится И ПрофильБазыПодключен() Тогда
		ПрежнийКод = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Ссылка, СвойствоСтатус)));
	КонецЕсли;
	Если СтатусХранится Тогда
		ЗаписатьЗначениеСвойства(Ссылка, СвойствоСтатус, Статус);
	КонецЕсли;
	Если ЗначениеЗаполнено(ИдДокумента) И СвойствоИд <> Неопределено И НЕ СвойствоИд.Пустая() Тогда
		// ЩА 20.10.2026 [yan], ревью Codex 848: новый экземпляр - результат Честного знака прежнего к нему
		// не относится (успех A после аннулирования и отправки B держал бы «Обработан в ЧЗ»). Сбрасываем,
		// сверки спросят ЧЗ уже по новому экземпляру.
		ПрежнийИд = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Ссылка, СвойствоИд)));
		Если ЗначениеЗаполнено(ПрежнийИд) И ПрежнийИд <> СокрЛП(Строка(ИдДокумента)) Тогда
			СброситьСтатусЧЗ(Ссылка);
		КонецЕсли;
		ЗаписатьЗначениеСвойства(Ссылка, СвойствоИд, Строка(ИдДокумента));
		ЗапомнитьОтпечатокОтправки(Ссылка);
	КонецЕсли;
	// Код 40 пишет ПрисоединитьПодписьИЗаписать - единственное место, где документ реально
	// ушел оператору, - а также закрепление найденного у оператора экземпляра. Профиль зовем
	// только при смене кода: повторная запись 40 (сторож, дубль) для него не новость.
	Если ПрежнийКод <> Неопределено И ПрежнийКод <> "40" Тогда
		СообщитьПрофилюОСостоянии(Ссылка, "40", "Отправлен");
	КонецЕсли;
КонецПроцедуры

// Перевести записанный ид документа на другой его экземпляр у оператора (сверка статусов, карточка
// документа). Отпечаток отправки не трогаем: документ заново не отправлялся.
Процедура ЗакрепитьЭкземплярДокумента(Знач Ссылка, Знач ИдЭкземпляра, Знач ПрежнийЭкземпляр, Знач Источник) Экспорт

	СвойствоИд = СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если СвойствоИд.Пустая() ИЛИ НЕ ЗначениеЗаполнено(ИдЭкземпляра) Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьЗначениеСвойства(Ссылка, СвойствоИд, СокрЛП(ИдЭкземпляра));
	ЗаписьЖР("ЭДО.ПересадкаИд", "Информация", Ссылка.Метаданные(), Ссылка,
		"Записанный экземпляр " + ПрежнийЭкземпляр + " заменен на " + СокрЛП(ИдЭкземпляра) + " (" + Источник + ")");

КонецПроцедуры

// Сообщить профилю базы, что состояние документа у оператора изменилось. Точка профиля
// ПриИзмененииСостоянияДокумента необязательна, а сообщение - только извещение: сбой профиля
// пишем в журнал и не пробрасываем, иначе ошибка чужого кода сорвала бы отправку, сверку
// статусов или аннулирование, которые уже сделали свое дело у оператора.
// КодСостояния - то, что ядро записало: для события "Отправлен" код отправки ("40"),
// для остальных текст статуса из колонки ЭДО ("Принят", "Аннулирован" и т.д.).
// Событие: "Отправлен", "Аннулирован" или "СменаСтатуса".
Процедура СообщитьПрофилюОСостоянии(Знач Ссылка, Знач КодСостояния, Знач Событие) Экспорт

	Если НЕ ПрофильБазыПодключен() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Парам = Новый Структура("Ссылка, КодСостояния, Событие, ИдентификаторДокумента",
			Ссылка, КодСостояния, Событие, "");
		СвойствоИд = СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
		Если СвойствоИд <> Неопределено И НЕ СвойствоИд.Пустая() Тогда
			ЗначениеИд = ЗначениеСвойстваОбъекта(Ссылка, СвойствоИд);
			Если ЗначениеЗаполнено(ЗначениеИд) Тогда
				Парам.ИдентификаторДокумента = СокрЛП(Строка(ЗначениеИд));
			КонецЕсли;
		КонецЕсли;
		ВызватьНеобязательнуюТочкуПрофиля("ПриИзмененииСостоянияДокумента", Парам);
	Исключение
		ЗаписьЖР("ЭДО.ПрофильСостояния", "Ошибка", , Ссылка,
			"Профиль базы не принял извещение о состоянии (" + Событие + ", " + КодСостояния + "): "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Какое событие для профиля несет текст статуса, записанный в колонку ЭДО. Пусто - текст
// внутренний (отправляется, причина неотправки, ошибка ФЛК), профиля он не касается.
// Тексты берутся из КартаСтатусовПлатформы: только те, что означают "ушел оператору,
// дошел, подписан, отказан контрагентом" и "аннулирован".
Функция СобытиеПоТекстуСтатуса(Знач Текст)
	Текст = АктуальныйТекстКолонки(Текст);   // ЩА 15.10.2026 [yan]
	Если Текст = ТекстАннулирован() Тогда
		Возврат "Аннулирован";
	КонецЕсли;
	Если Текст = ТекстОтправлен() ИЛИ Текст = ТекстДоставлен() ИЛИ ПодписанПоТекстуКолонки(Текст)
		ИЛИ Текст = ТекстОтклоненКонтрагентом() Тогда
		Возврат "СменаСтатуса";
	КонецЕсли;
	Возврат "";
КонецФункции

// Запомнить, с какой суммой и какому покупателю (ИНН) документ ушел контрагенту. Единственная
// точка, где отпечаток появляется: позже сумму отправки уже не восстановить. Перезаписывается
// при каждой отправке: переотправили исправленный - расхождение исчезает само.
Процедура ЗапомнитьОтпечатокОтправки(Ссылка) Экспорт

	Свойство = СвойствоОбъектов("ЭДО_ОтпечатокОтправки");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ЗаписатьЗначениеСвойства(Ссылка, Свойство, ОтпечатокДокумента(Ссылка));
	Исключение
 // Отпечаток - средство наблюдения, и его отказ не должен рушить саму отправку:
 // документ уже ушёл, откатывать нечего.
		ЗаписьЖР("Отпечаток отправки не записан: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			"Предупреждение", , Ссылка);
	КонецПопытки;

КонецПроцедуры

// ++ ЩА 15.10.2026 [yan]: сумма, с которой документ ушел в ЭДО, - по карточке оператора (invoice.sum).
// Отпечаток отправки для этого не годится: он берется из документа базы и перезаписывается при каждой
// записи идентификатора, в том числе когда сверка привязывает экземпляр уже после правки документа.
// Значение свойства - "<ид экземпляра>|<сумма>": сумма относится только к своему экземпляру, после
// переотправки прежняя не показывается.
Функция ИмяСвойстваСуммыВЭДО() Экспорт
	Возврат "ЭДО_СуммаВЭДО";
КонецФункции

// Сумма с НДС из карточки оператора (Структура или Соответствие); Неопределено - суммы в карточке нет.
Функция СуммаКарточкиОператора(Знач Карточка) Экспорт
	Счет = ПолеКарточкиОператора(Карточка, "invoice");
	Сумма = ?(Счет = Неопределено, Неопределено, ПолеКарточкиОператора(Счет, "sum"));
	Возврат ?(ТипЗнч(Сумма) = Тип("Число"), Сумма, Неопределено);
КонецФункции

Функция ЗначениеСуммыВЭДО(Знач ИдЭкземпляра, Знач Сумма)
	Возврат СокрЛП(ИдЭкземпляра) + "|" + Формат(Сумма, "ЧДЦ=2; ЧРД=.; ЧН=0; ЧГ=0");
КонецФункции

// Сумма из значения свойства, если оно относится к экземпляру ИдЭкземпляра; иначе Неопределено.
Функция СуммаВЭДОЭкземпляра(Знач Значение, Знач ИдЭкземпляра) Экспорт
	ИдЭкземпляра = СокрЛП(ИдЭкземпляра);
	Части = СтрРазделить(СокрЛП(Строка(Значение)), "|");
	Если НЕ ЗначениеЗаполнено(ИдЭкземпляра) ИЛИ Части.Количество() <> 2 ИЛИ Части[0] <> ИдЭкземпляра Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Число(Части[1]);
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "СуммаВЭДОЭкземпляра: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Запомнить у документа сумму экземпляра. Пишет, только если значение изменилось.
// Прежнее - уже прочитанное значение свойства, Неопределено - прочитать здесь.
Процедура ЗапомнитьСуммуВЭДО(Знач Ссылка, Знач ИдЭкземпляра, Знач Сумма, Знач Прежнее = Неопределено) Экспорт
	Если Сумма = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ИдЭкземпляра) Тогда
		Возврат;
	КонецЕсли;
	Свойство = СвойствоОбъектов(ИмяСвойстваСуммыВЭДО());
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат;
	КонецЕсли;
	Если Прежнее = Неопределено Тогда
		Прежнее = ЗначениеСвойстваОбъекта(Ссылка, Свойство);
	КонецЕсли;
	Значение = ЗначениеСуммыВЭДО(ИдЭкземпляра, Сумма);
	Если СокрЛП(Строка(Прежнее)) <> Значение Тогда
		ЗаписатьЗначениеСвойства(Ссылка, Свойство, Значение);
	КонецЕсли;
КонецПроцедуры

// Ход документа у оператора: сам документ и все документы его цепочки (подтверждения оператора,
// подпись или отказ контрагента, аннулирование) со временем, когда оператор их принял.
// Цепочку отдает GET /public/api/v3/document-flows?id=; отдельной истории шагов у оператора нет.
// СпрашиватьЧЗ - Истина добавляет шаги Честного знака; вход в ГИС МТ стоит подписи КЭП на каждый вызов.
// Возврат: Структура (Шаги - Массив структур (Время - местное, Шаг, Тип, Статус); Ошибка - Строка).
Функция ХодДокументаОператора(Знач ИдЭкземпляра, Знач Организация = Неопределено, Знач СпрашиватьЧЗ = Ложь) Экспорт

	Итог = Новый Структура("Шаги, Ошибка", Новый Массив, "");
	ИдЭкземпляра = СокрЛП(ИдЭкземпляра);
	Если НЕ ЗначениеЗаполнено(ИдЭкземпляра) Тогда
		Возврат Итог;
	КонецЕсли;
	Ответ = ЗапросКОператоруЭДО("GET", "/public/api/v3/document-flows?id=" + ИдЭкземпляра, , Организация);
	Если Ответ.Код <> 200 Тогда
		Итог.Ошибка = "Платформа не отдала ход документа (HTTP " + Ответ.Код + ")";
		Возврат Итог;
	КонецЕсли;
	Узлы = ПрочитатьОтветJSON(Ответ.Текст);
	Если ТипЗнч(Узлы) <> Тип("Массив") ИЛИ Узлы.Количество() = 0 Тогда
		Итог.Ошибка = "Платформа не нашла документ " + ИдЭкземпляра;
		Возврат Итог;
	КонецЕсли;
	НашГид = ВРег(ГидОрганизации(Организация));
	Для Каждого Узел Из Узлы Цикл
		ДобавитьШагиХода(Итог.Шаги, Узел, Неопределено, НашГид);
	КонецЦикла;
	Если СпрашиватьЧЗ Тогда
		ДобавитьШагиЧЗ(Итог.Шаги, Узлы[0], ИдЭкземпляра, Организация);   // ЩА 20.10.2026 [yan]
	КонецЕсли;

	// По времени; одновременные - в порядке обхода цепочки (сначала документ, потом ответы на него).
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Шаг");
	Таблица.Колонки.Добавить("Порядок");
	Таблица.Колонки.Добавить("Время");
	Для Каждого Шаг Из Итог.Шаги Цикл
		СтрокаШага = Таблица.Добавить();
		СтрокаШага.Шаг = Шаг;
		СтрокаШага.Время = Шаг.Время;
		СтрокаШага.Порядок = Таблица.Количество();
	КонецЦикла;
	Таблица.Сортировать("Время, Порядок");
	Итог.Шаги = Таблица.ВыгрузитьКолонку("Шаг");
	Возврат Итог;

КонецФункции

// ЩА 20.10.2026 [yan]: шаги Честного знака в ходе документа: обработан или отклонен - по строке на каждую
// ошибку с кодом маркировки, чтобы бухгалтер видел, какие марки не прошли. Сбой запроса - тоже шаг и ЖР.
Процедура ДобавитьШагиЧЗ(Шаги, Знач Узел, Знач ИдЭкземпляра, Знач Организация)
	ИмяФайла = "";
	Если ТипЗнч(Узел) = Тип("Соответствие") Тогда
		ИмяФайла = СокрЛП(Строка(ПолеКарточкиОператора(Узел, "fileId")));
	КонецЕсли;
	Попытка
		Если НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
			ИмяФайла = КарточкаОператораПоИд(ИдЭкземпляра, Организация).ИмяФайла;
		КонецЕсли;
		ВЧЗ = ДокументВЧЗ(ИмяФайла, Организация);
	Исключение
		ТекстСбоя = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ЭДО.ГИСМТ", УровеньЖурналаРегистрации.Ошибка, , ,
			"Ход документа " + ИдЭкземпляра + ": ЧЗ не ответил: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Шаги.Добавить(Новый Структура("Время, Шаг, Тип, Статус", ТекущаяДатаСеанса(),
			"Честный знак: ответа нет - " + Лев(ТекстСбоя, 200), "ЧЗ", "ошибка запроса"));
		Возврат;
	КонецПопытки;
	Если НЕ ВЧЗ.Найден Тогда
		Возврат;   // документа в ЧЗ нет - документ без кодов маркировки
	КонецЕсли;
	Если ВЧЗ.Ошибки.Количество() = 0 Тогда
		Шаги.Добавить(Новый Структура("Время, Шаг, Тип, Статус", ВЧЗ.Получен,
			"Честный знак: " + ?(ВЧЗ.Статус = "CHECKED_OK", "документ обработан", "документ принят, " + НРег(ВЧЗ.Итог)),
			"ЧЗ", ВЧЗ.Статус));
		Возврат;
	КонецЕсли;
	Шаги.Добавить(Новый Структура("Время, Шаг, Тип, Статус", ВЧЗ.Получен,
		"Честный знак: документ отклонен, ошибок " + ВЧЗ.Ошибки.Количество(), "ЧЗ", ВЧЗ.Статус));
	Для Каждого Ошибка Из ВЧЗ.Ошибки Цикл
		Шаги.Добавить(Новый Структура("Время, Шаг, Тип, Статус", ВЧЗ.Получен,
			"  " + Ошибка.Код + " " + Ошибка.КМ + ": " + Ошибка.Текст, "ЧЗ", Ошибка.Код));
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьШагиХода(Шаги, Знач Узел, Знач Родитель, Знач НашГид)

	Если ТипЗнч(Узел) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	Тип = ВРег(СокрЛП(Строка(Узел.Получить("type"))));
	Отправитель = ВРег(СокрЛП(Строка(ПолеКарточкиОператора(Узел.Получить("sender"), "id"))));
	Получатель = ВРег(СокрЛП(Строка(ПолеКарточкиОператора(Узел.Получить("recipient"), "id"))));
	ТипРодителя = ?(Родитель = Неопределено, "", ВРег(СокрЛП(Строка(Родитель.Получить("type")))));
	Шаги.Добавить(Новый Структура("Время, Шаг, Тип, Статус",
		ВремяОператора(Строка(Узел.Получить("created"))),
		ОписаниеШагаХода(Тип, Отправитель, Получатель, ТипРодителя, Родитель = Неопределено, НашГид),
		Тип, СтатусКарточкиОператора(Узел)));
	Подчиненные = Узел.Получить("slaves");
	Если ТипЗнч(Подчиненные) = Тип("Массив") Тогда
		Для Каждого Подчиненный Из Подчиненные Цикл
			ДобавитьШагиХода(Шаги, Подчиненный, Узел, НашГид);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Шаг цепочки простыми словами. Отправитель "2VO" (без ИНН) - сам оператор.
Функция ОписаниеШагаХода(Знач Тип, Знач Отправитель, Знач Получатель, Знач ТипРодителя, Знач ЭтоДокумент, Знач НашГид)

	ОтНас = ЗначениеЗаполнено(НашГид) И Отправитель = НашГид;
	НамАдресовано = ЗначениеЗаполнено(НашГид) И Получатель = НашГид;
	ОтОператора = СтрДлина(Отправитель) <= 3;

	Если ЭтоДокумент Тогда
		Возврат ?(ОтНас, "Документ отправлен контрагенту", "Документ получен от контрагента");
	ИначеЕсли Тип = "DP_PDPOL" Тогда
		Возврат ?(НамАдресовано, "Оператор принял документ", "Оператор подтвердил получение контрагенту");
	ИначеЕсли Тип = "DP_PDOTPR" Тогда
		Если ОтОператора И НЕ НамАдресовано Тогда
			Возврат "Документ доставлен в ящик контрагента";
		КонецЕсли;
		Возврат "Ответ контрагента доставлен нам";
	ИначеЕсли Тип = "DP_IZVPOL" Тогда
		Возврат ?(ОтНас, "Мы подтвердили получение", "Контрагент подтвердил получение");
	ИначеЕсли Тип = "DP_UVUTOCH" Тогда
		Возврат ?(ОтНас, "Мы отказали в подписи (уточнение)", "Контрагент отказал в подписи (уточнение)");
	ИначеЕсли Тип = "DP_PRANNUL" Тогда
		Если ТипРодителя = "DP_PRANNUL" Тогда
			Возврат ?(ОтНас, "Мы согласились на аннулирование", "Контрагент согласился на аннулирование");
		КонецЕсли;
		Возврат ?(ОтНас, "Мы предложили аннулировать", "Контрагент предложил аннулировать");
	ИначеЕсли СтрНачинаетсяС(Тип, "ON_") И СтрНайти(Тип, "POK") > 0 Тогда
		Возврат ?(ОтНас, "Мы подписали документ", "Контрагент подписал документ");
	КонецЕсли;
	Возврат Тип + ?(ОтОператора, " от оператора", ?(ОтНас, " от нас", " от контрагента"));

КонецФункции

// -- ЩА 15.10.2026 [yan]

// Сумма и ИНН покупателя на момент отправки. Формат "сумма|ИНН"; ИНН нужен, чтобы сторож видел
// смену контрагента при той же сумме. Хеша состава нет намеренно: правки после отправки почти
// всегда меняют сумму, а хеш давал бы ложные срабатывания на переименовании номенклатуры.
Функция ОтпечатокДокумента(Знач Ссылка) Экспорт

	Ссылки = Новый Массив;
	Ссылки.Добавить(Ссылка);
	Отпечатки = ОтпечаткиДокументов(Ссылки);
	Значение = Отпечатки.Получить(Ссылка);
	Возврат ?(Значение = Неопределено, "", Значение);

КонецФункции

// Суммы пачкой: одним запросом на все документы сразу.
// Нужно сторожу - поштучное чтение на тысячах документов упирается в число запросов.
// Возврат: Соответствие (ссылка документа -> строка "сумма|ИНН").
Функция ОтпечаткиДокументов(Знач МассивСсылок) Экспорт

	Отпечатки = Новый Соответствие;
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат Отпечатки;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", МассивСсылок);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РТУ.Ссылка КАК Ссылка,
	|	РТУ.СуммаДокумента КАК Сумма,
	|	ЕСТЬNULL(РТУ.Контрагент.ИНН, """") КАК ИНН
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РТУ
	|ГДЕ
	|	РТУ.Ссылка В (&Ссылки)";
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Отпечатки.Вставить(Выборка.Ссылка,
			Формат(Выборка.Сумма, "ЧДЦ=2; ЧГ=0; ЧРД=.") + "|" + СокрЛП(Выборка.ИНН));
	КонецЦикла;

	Возврат Отпечатки;

КонецФункции

// Разобрать отпечаток. Возврат: Структура (Сумма, ИНН, ЕстьИНН, Разобран).
// Отпечатки до 1.5.6.0 хранят только сумму: у них ЕстьИНН = Ложь, и покупатель не сверяется.
Функция РазобратьОтпечаток(Знач Отпечаток) Экспорт

	Результат = Новый Структура("Сумма, ИНН, ЕстьИНН, Разобран", 0, "", Ложь, Ложь);
	Текст = СокрЛП(Строка(Отпечаток));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	Позиция = СтрНайти(Текст, "|");
	Если Позиция > 0 Тогда
		Результат.ИНН = СокрЛП(Сред(Текст, Позиция + 1));
		Результат.ЕстьИНН = Истина;
		Текст = СокрЛП(Лев(Текст, Позиция - 1));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Результат.Сумма = Число(Текст);
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "РазобратьОтпечаток: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат Результат;
	КонецПопытки;
	Результат.Разобран = Истина;

	Возврат Результат;

КонецФункции

// Как отправить акт сверки получателю. Порядок: запрет оператора из таблицы операторов сильнее всего,
// затем флаг контрагента ЭДО_АктыСверкиВPDF, затем способ оператора из таблицы (по умолчанию xml).
// Возврат: Структура (Способ - xml | pdf | запрещено, Оператор - название, Основание - откуда способ).
Функция СпособОтправкиАктаСверки(Знач Контрагент, Знач ИдПолучателя) Экспорт

	Настройка = НастройкаОператораЭДО(ИдПолучателя);
	Итог = Новый Структура("Способ, Оператор, Основание", Настройка.АктСверки, Настройка.Название,
		"настройка оператора " + Настройка.Префикс);
	Если Настройка.АктСверки = ПолитикаАктаСверкиЗапрещено() Тогда
		Возврат Итог;
	КонецЕсли;

	Свойство = СвойствоОбъектов(ИмяСвойстваАктыСверкиВPDF());
	Если ЗначениеЗаполнено(Контрагент) И НЕ Свойство.Пустая()
		И ФлагСвойстваВключён(ЗначениеСвойстваОбъекта(Контрагент, Свойство)) Тогда
		Итог.Способ = ПолитикаАктаСверкиPDF();
		Итог.Основание = "свойство контрагента " + ИмяСвойстваАктыСверкиВPDF();
	КонецЕсли;
	Возврат Итог;

КонецФункции

Функция ТекстОтправкаАктовСверкиНеПоддерживается(Знач НазваниеОператора) Экспорт
	Возврат "Отправка актов сверки оператору " + НазваниеОператора + " не поддерживается";
КонецФункции

// Текст колонки ЭДО для акта, который оператор не отправляет по таблице операторов. Колонка - Строка(50),
// поэтому без названия оператора: оно в сообщении отправки.
Функция ТекстКолонкиАктыСверкиОператоруНеОтправляются() Экспорт
	Возврат "Оператор контрагента не принимает акты";
КонецФункции

// Текст колонки ЭДО для акта, который оператор не доставил: получатель не принимает акты сверки.
Функция ТекстПолучательНеПринимаетАктыСверки() Экспорт
	Возврат "Ошибка: получатель не принимает акты сверки";
КонецФункции

// Отказ отправки из квитанции оператора про то, что получатель не принимает формализованный акт сверки:
// ЭДО Лайт отвечает "...АКТ_СВЕРКИ_ВЗАИМНЫХ_РАСЧЕТОВ_ОТПРАВИТЕЛЬ is unsupported for processing now",
// ящик у другого оператора - "клиент ... не поддерживает обмен АктСверкиВзаимныхРасчетовОтправитель".
Функция ПолучательНеПринимаетАктыСверки(Знач Причина) Экспорт

	Текст = ВРег(СокрЛП(Строка(Причина)));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрНайти(Текст, "АКТ_СВЕРКИ") > 0 И СтрНайти(Текст, "UNSUPPORTED") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат СтрНайти(Текст, "НЕ ПОДДЕРЖИВАЕТ ОБМЕН") > 0 И СтрНайти(Текст, "АКТСВЕРКИ") > 0;

КонецФункции

// Понятный пользователю текст причины, по которой оператор не отправил документ (SENDING_FAILED).
// Незнакомая причина возвращается как есть, укороченной.
Функция ПонятнаяПричинаОтказаОтправки(Знач Причина) Экспорт

	Если ПолучательНеПринимаетАктыСверки(Причина) Тогда
		Возврат "Получатель не принимает акты сверки в электронном виде - отправьте акт другим способом"
			+ " (PDF, почта): отметьте у контрагента свойство " + ИмяСвойстваАктыСверкиВPDF()
			+ " и отправьте акт повторно.";
	КонецЕсли;
	Возврат Лев(СокрЛП(Строка(Причина)), 300);

КонецФункции

// Текст колонки ЭДО для статуса оператора с учетом причины отказа отправки. Причина Неопределено -
// ее не спрашивали: уточненный прежде текст остается, иначе каждая сверка возвращала бы общий.
Функция ТекстКолонкиСУчетомПричиныОтказа(Знач ТекстПоСтатусу, Знач ТекущийТекст, Знач Причина = Неопределено) Экспорт

	Если ТекстПоСтатусу <> ТекстОшибкаОтправкиУОператора() Тогда
		Возврат ТекстПоСтатусу;
	КонецЕсли;
	Если Причина = Неопределено Тогда
		Возврат ?(СокрЛП(ТекущийТекст) = ТекстПолучательНеПринимаетАктыСверки(), ТекстПолучательНеПринимаетАктыСверки(),
			ТекстПоСтатусу);
	КонецЕсли;
	Возврат ?(ПолучательНеПринимаетАктыСверки(Причина), ТекстПолучательНеПринимаетАктыСверки(), ТекстПоСтатусу);

КонецФункции

// Отметка отправки 40 у акта, который оператор не доставил, мешает отправить его заново из списка.
// Снимаем ее, когда колонка говорит об отказе отправки: живой экземпляр у оператора все равно ищет
// ЖивойАктСверкиУОператора, и дубля это не дает.
Процедура СнятьОтметкуНедоставленногоАкта(Ссылка)

	СвойствоКода = СвойствоОбъектов("ЭДО_КодСостояния");
	СвойствоСостояния = СвойствоОбъектов("ЭДО_Состояние");
	Если СвойствоКода.Пустая() ИЛИ СвойствоСостояния.Пустая() Тогда
		Возврат;
	КонецЕсли;
	Состояние = АктуальныйТекстКолонки(СокрЛП(Строка(ЗначениеСвойстваОбъекта(Ссылка, СвойствоСостояния))));
	Если Состояние <> ТекстОшибкаОтправкиУОператора() И Состояние <> ТекстПолучательНеПринимаетАктыСверки() Тогда
		Возврат;
	КонецЕсли;
	Код = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Ссылка, СвойствоКода)));
	Если Код <> "40" Тогда
		Возврат;
	КонецЕсли;

	Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Ссылка);
	Набор.Отбор.Свойство.Установить(СвойствоКода);
	Набор.Записать();

КонецПроцедуры

// Живой экземпляр акта сверки у оператора для того же получателя - формализованный или PDF.
// Неподписанный черновик NEW дублем не считается, но свежий может быть идущей отправкой.
// Возврат: Структура (Опрошено, Причина, Найден Булево, Ид, Статус).
Функция ЖивойАктСверкиУОператора(Ссылка, Организация, Знач ИдПолучателя)

	Результат = Новый Структура("Опрошено, Причина, Найден, Ид, Статус", Ложь, "", Ложь, "", "");

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));
	Опрос = КарточкиДокументаУОператора(СоединениеСОператором(5), Заголовки, ГидОрганизации(Организация),
		ИдПолучателя, СокрЛП(Ссылка.Номер), Ссылка.Дата, Ложь);
	Результат.Опрошено = Опрос.Опрошено;
	Результат.Причина = Опрос.Причина;

	СвежийЧерновик = "";
	Для Каждого Карточка Из Опрос.Карточки Цикл
		ВидКарточки = ВРег(СокрЛП(Карточка.Тип));
		Если НЕ Карточка.Живая ИЛИ (ВидКарточки <> "ON_AKTSVEROTP" И ВидКарточки <> "UNFORMALIZED") Тогда
			Продолжить;
		КонецЕсли;
		Если ВРег(СокрЛП(Карточка.Статус)) = "NEW" Тогда
			Если ЗначениеЗаполнено(Карточка.Создана)
				И ТекущаяУниверсальнаяДата() - Карточка.Создана < ВозрастБрошенногоЧерновика() Тогда
				СвежийЧерновик = Карточка.Ид;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Результат.Найден = Истина;
		Результат.Ид = Карточка.Ид;
		Результат.Статус = Карточка.Статус;
		Прервать;
	КонецЦикла;

	Если НЕ Результат.Найден И ЗначениеЗаполнено(СвежийЧерновик) Тогда
		Результат.Опрошено = Ложь;
		Результат.Причина = "у оператора неподписанный черновик " + СвежийЧерновик + " моложе часа";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Создать у оператора неформализованный документ с печатной формой акта в PDF и загрузить файл.
// Без подписи документ никуда не уходит, поэтому при сбое загрузки черновик удаляется.
// Возврат: Структура (ИдДокумента, Данные, Ошибка).
Функция СоздатьАктСверкиФайлом(Ссылка, Организация, Знач ИдПолучателя)

	Итог = Новый Структура("ИдДокумента, Данные, Ошибка", "", Неопределено, "");
	Итог.Данные = ЭДО_АктСверкиДанные.ПечатнаяФормаPDF(Ссылка);

	Метки = Новый Массив;
	Метки.Добавить("Акт сверки");
	Описание = Новый Структура("senderGid, recipientGid, type, topic, labels, docDate, docNum",
		ГидОрганизации(Организация), ИдПолучателя, "UNFORMALIZED",
		"Акт сверки взаиморасчетов № " + СокрЛП(Ссылка.Номер) + " от " + Формат(Ссылка.Дата, "ДФ=dd.MM.yyyy"),
		Метки, Формат(Ссылка.Дата, "ДФ=dd.MM.yyyy"), СокрЛП(Ссылка.Номер));

	Ответ = ЗапросКОператоруЭДО("POST", "/public/api/v3/documents", СтрокаJSON(Описание), Организация);
	Если Ответ.Код <> 200 Тогда
		Итог.Ошибка = "Создание документа с актом в PDF HTTP " + Ответ.Код + ": " + Лев(Ответ.Текст, 800);
		Возврат Итог;
	КонецЕсли;
	ИдДокумента = ИзвлечьИдентификатор(Ответ.Текст);
	Если НЕ ЗначениеЗаполнено(ИдДокумента) Тогда
		Итог.Ошибка = "Оператор создал документ с актом в PDF, но не вернул id: " + Лев(Ответ.Текст, 800);
		Возврат Итог;
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/pdf");
	Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));
	Запрос = Новый HTTPЗапрос(ПутьСервиса("document") + "/public/api/v3/documents/" + ИдДокумента + "/content", Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(Итог.Данные);
	Загрузка = СоединениеСОператором(60).ВызватьHTTPМетод("POST", Запрос);
	Если Загрузка.КодСостояния <> 200 И Загрузка.КодСостояния <> 204 Тогда
		ЗапросКОператоруЭДО("DELETE", "/public/api/v3/documents/" + ИдДокумента, , Организация);
		Итог.Ошибка = "Файл акта не загружен (HTTP " + Загрузка.КодСостояния + "), черновик у оператора удален: "
			+ Лев(Загрузка.ПолучитьТелоКакСтроку("UTF-8"), 500);
		Возврат Итог;
	КонецЕсли;

	Итог.ИдДокумента = ИдДокумента;
	Возврат Итог;

КонецФункции

// Отправка акта сверки по ЭДО (формализованный ON_AKTSVEROTP 5.01, приказ ФНС ЕД-7-26/405@).
// Путь отдельный от УПД/УКД и не трогает движок вендора: XML собирают ЭДО_АктСверкиДанные
// и ЭДО_ФорматАктСверки. Стороны оператор берет из самого XML, senderGid/recipientGid не передаем.
// Разрешения - как у ОтправитьПоЭДО (НовыеРазрешенияОператора), передает только ручная отправка.
// Возврат: Структура (Ссылка, Статус, ИдДокумента, Сообщение, КодПричины),
// Статус из "Отправлен" | "ТребуетВнимания" | "Отсеян" | "Пропущен" | "Ошибка".
Функция ОтправитьАктСверкиПоЭДО(Ссылка, Знач Разрешения = Неопределено) Экспорт
	Результат = Новый Структура("Ссылка, Статус, ИдДокумента, Сообщение, КодПричины", Ссылка, "", "", "", "");

	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.АктСверкиВзаиморасчетов") Тогда
		Результат.Статус = "Ошибка";
		Результат.Сообщение = "Ожидался акт сверки взаиморасчетов";
		Возврат Результат;
	КонецЕсли;
	Организация = ОрганизацияДокумента(Ссылка);

	// У акта сверки в УТ 10.3 проведение запрещено метаданными, и Проведен у всех актов Ложь.
	// Поэтому судим по виду документа: у непроводимых признак готовности - нет пометки удаления.
	МетаАкт = Метаданные.Документы.АктСверкиВзаиморасчетов;
	ПроведениеРазрешено = (МетаАкт.Проведение <> Метаданные.СвойстваОбъектов.Проведение.Запретить);
	Если ПроведениеРазрешено И НЕ Ссылка.Проведен Тогда
		Результат.Статус = "ТребуетВнимания";
		Результат.Сообщение = "Акт не проведен - отправлять нечего";
		Возврат Результат;
	КонецЕсли;
	Если Ссылка.ПометкаУдаления Тогда
		Результат.Статус = "ТребуетВнимания";
		Результат.Сообщение = "Акт помечен на удаление - отправлять нечего";
		Возврат Результат;
	КонецЕсли;

	// Гейт организации - тот же, что у УПД: умолчание запрет.
	ПричинаОрганизации = ПричинаЗапретаПоОрганизации(Ссылка);
	Если ЗначениеЗаполнено(ПричинаОрганизации) Тогда
		Результат.Статус = "Отсеян";
		Результат.Сообщение = ПричинаОрганизации;
		Возврат Результат;
	КонецЕсли;

	ИдПолучателя = ИдентификаторУчастникаЭДО(Ссылка.Контрагент);
	Если НЕ ЗначениеЗаполнено(ИдПолучателя) Тогда
		Результат.Статус = "ТребуетВнимания";
		Результат.Сообщение = "У контрагента не заполнен адрес ЭДО - акт слать некуда";
		Возврат Результат;
	КонецЕсли;

	// Адрес самой организации у контрагента = отправка самому себе (розничные и служебные карточки).
	// Адрес другой нашей организации - обычный получатель (сверка между своими юрлицами).
	Если АдресЭДООрганизацииОтправителя(ИдПолучателя, Организация) Тогда
		ЗаписатьЧитаемыйСтатус(Ссылка, ТекстСтатусаОтправкаНеТребуется());
		Результат.Статус = "Отсеян";
		Результат.Сообщение = "Адрес получателя - наш собственный, отправка не требуется";
		Возврат Результат;
	КонецЕсли;

	Способ = СпособОтправкиАктаСверки(Ссылка.Контрагент, ИдПолучателя);
	Если Способ.Способ = ПолитикаАктаСверкиЗапрещено() Тогда
		// Колонку акта с экземпляром у оператора ведет сверка статусов - ее не перебиваем.
		Если НЕ ЗначениеЗаполнено(ИдентификаторЭкземпляраДокумента(Ссылка)) Тогда
			ЗаписатьЧитаемыйСтатус(Ссылка, ТекстКолонкиАктыСверкиОператоруНеОтправляются());
		КонецЕсли;
		Результат.Статус = "Отсеян";
		Результат.Сообщение = ТекстОтправкаАктовСверкиНеПоддерживается(Способ.Оператор);
		Возврат Результат;
	КонецЕсли;

	СнятьОтметкуНедоставленногоАкта(Ссылка);

	// Занимаем документ до обращения к API - та же защита от дублей, что у УПД.
	Занятие = ЗанятьДокументКОтправке(Ссылка);
	Если НЕ Занятие.Занят Тогда
		Результат.Статус = "Пропущен";
		Результат.Сообщение = Занятие.Причина;
		Возврат Результат;
	КонецЕсли;

	ИдСозданного = "";
	Попытка

		Если НЕ ОбеспечитьТокен(Ложь, Организация) Тогда
			ОсвободитьДокумент(Ссылка);
			Результат.Статус = "Ошибка";
			Результат.Сообщение = "Не удалось получить токен авторизации (КЭП на сервере/подпись)";
			Возврат Результат;
		КонецЕсли;

		// Занятие защищает от параллельного прогона, но не от переотправки: ручная отправка снимает
		// отметку прежней отправки. Источник правды - карточки оператора, как у УПД.
		Дубль = ЖивойАктСверкиУОператора(Ссылка, Организация, ИдПолучателя);
		Недоставлен = Дубль.Найден И ТипЗнч(Разрешения) = Тип("Структура")
			И ВРег(СокрЛП(Дубль.Статус)) = "SENT";
		Если Недоставлен И РазрешеноОператором(Разрешения, "ОтправитьПриНедоставленномЭкземпляре") Тогда
			ЗаписьЖР("ЭДО.ОтправкаПриНедоставленном", "Предупреждение", Ссылка.Метаданные(), Ссылка,
				"Акт сверки отправлен повторно при недоставленном экземпляре " + Дубль.Ид + " по решению пользователя");
		ИначеЕсли Недоставлен Тогда
			ОсвободитьДокумент(Ссылка);
			Результат.Статус = "ТребуетВнимания";
			Результат.КодПричины = "НедоставленныйЭкземпляр";
			Результат.ИдДокумента = Дубль.Ид;
			Результат.Сообщение = "У оператора уже есть экземпляр этого акта (ид " + Дубль.Ид
				+ "), но получателю он не доставлен: статус SENT";
			Возврат Результат;
		ИначеЕсли Дубль.Найден Тогда
			ЗаписатьСтатусЭДО(Ссылка, 40, Дубль.Ид);
			ЗаписатьЧитаемыйСтатус(Ссылка, "Уже отправлен этому получателю");
			Результат.Статус = "Пропущен";
			Результат.ИдДокумента = Дубль.Ид;
			Результат.Сообщение = "У оператора уже есть экземпляр этого акта для того же получателя (ид "
				+ Дубль.Ид + ", " + Дубль.Статус + ") - повтор дал бы дубль";
			Возврат Результат;
		ИначеЕсли НЕ Дубль.Опрошено Тогда
			ОсвободитьДокумент(Ссылка);
			Результат.Статус = "ТребуетВнимания";
			Результат.Сообщение = "Не удалось проверить у оператора, не отправлялся ли акт ранее"
				+ ?(ЗначениеЗаполнено(Дубль.Причина), " (" + Дубль.Причина + ")", "")
				+ " - отправка отложена";
			Возврат Результат;
		КонецЕсли;

 // -- Сборка XML нашим генератором ---
		Если Способ.Способ = ПолитикаАктаСверкиPDF() Тогда
			Создание = СоздатьАктСверкиФайлом(Ссылка, Организация, ИдПолучателя);
			Если НЕ ЗначениеЗаполнено(Создание.ИдДокумента) Тогда
				ОсвободитьДокумент(Ссылка);
				Результат.Статус = "Ошибка";
				Результат.Сообщение = Создание.Ошибка;
				Возврат Результат;
			КонецЕсли;
			ИдДокумента = Создание.ИдДокумента;
			ДанныеДокумента = Создание.Данные;
		Иначе
			// ОГРНИП контрагента-ИП в формате акта обязателен, а в карточках его часто нет.
			КонтекстАкта = Новый Структура("СверкаЕГРЮЛ, РеестрОператора",
				НоваяСверкаЕГРЮЛ(1), НовыйРеестрОператора(Организация));
			ОбеспечитьРеквизитыИП(Ссылка.Контрагент, КонтекстАкта);
			Сборка = ЭДО_АктСверкиДанные.XMLПоДокументу(Ссылка, ГидОрганизации(Организация), ИдПолучателя);
			Если Сборка.Ошибки.Количество() > 0 Тогда
				ОсвободитьДокумент(Ссылка);
				ТекстОшибок = "";
				Для Каждого СтрокаОшибки Из Сборка.Ошибки Цикл
					ТекстОшибок = ТекстОшибок + ?(ЗначениеЗаполнено(ТекстОшибок), "; ", "") + СтрокаОшибки;
				КонецЦикла;
				Результат.Статус = "ТребуетВнимания";
				Результат.Сообщение = "Акт не собран: " + Лев(ТекстОшибок, 800);
				Возврат Результат;
			КонецЕсли;

			ДвоичныеXML = ПолучитьДвоичныеДанныеИзСтроки(Сборка.ТекстXML, "windows-1251", Ложь);

	 // -- Создание документа у оператора (POST /documents, он же ФЛК) ---
			Заголовки = Новый Соответствие;
			Заголовки.Вставить("Content-Type", "application/xml");
			Заголовки.Вставить("accept", "application/json;charset=UTF-8");
			Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));

			Соединение = HTTPСоединениеЭДО();
			Запрос = Новый HTTPЗапрос(ПутьСервиса("document") + "/public/api/v3/documents", Заголовки);
			Запрос.УстановитьТелоИзДвоичныхДанных(ДвоичныеXML);
			Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
			ТелоОтвета = Ответ.ПолучитьТелоКакСтроку("UTF-8");

	 // один перевыпуск токена по 401 - как в отправке УПД
			Если Ответ.КодСостояния = 401 И ОбеспечитьТокен(Истина, Организация) Тогда
				Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));
				Запрос = Новый HTTPЗапрос(ПутьСервиса("document") + "/public/api/v3/documents", Заголовки);
				Запрос.УстановитьТелоИзДвоичныхДанных(ДвоичныеXML);
				Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
				ТелоОтвета = Ответ.ПолучитьТелоКакСтроку("UTF-8");
			КонецЕсли;

			Если Ответ.КодСостояния <> 200 Тогда
				ОсвободитьДокумент(Ссылка);
				Результат.Статус = "Ошибка";
				ПодсказкаФЛК = ЧеловеческоеОписаниеОшибкиФЛК(ТелоОтвета);
				Результат.Сообщение = ?(ПодсказкаФЛК <> "", ПодсказкаФЛК + ". Подробности: ", "")
					+ "ФЛК HTTP " + Ответ.КодСостояния + ": " + Лев(ТелоОтвета, 800);
				Возврат Результат;
			КонецЕсли;

			ИдДокумента = ИзвлечьИдентификатор(ТелоОтвета);
			Если НЕ ЗначениеЗаполнено(ИдДокумента) Тогда
				ОсвободитьДокумент(Ссылка);
				Результат.Статус = "Ошибка";
				Результат.Сообщение = "ФЛК вернул 200, но id документа не найден: " + Лев(ТелоОтвета, 800);
				Возврат Результат;
			КонецЕсли;
			ДанныеДокумента = ДвоичныеXML;
		КонецЕсли;

 // Документ уже создан у оператора - фиксируем id до подписи, как у УПД: таймаут прилетит
 // исключением мимо записи статуса, и следующий прогон создал бы второй экземпляр.
		ЗаписатьСтатусЭДО(Ссылка, 20, ИдДокумента);
		ИдСозданного = ИдДокумента;
		Результат.ИдДокумента = ИдДокумента;

		ПодписьДокумента = ПодписатьДанные(ДанныеДокумента, Организация);
		Если ПодписьДокумента = Неопределено Тогда
			Результат.Статус = "ТребуетВнимания";
			ЗаписатьЧитаемыйСтатус(Ссылка, "Отправляется");
			Результат.Сообщение = "Акт создан у оператора (id " + ИдДокумента
				+ "), но не подписан КЭП - завершить или удалить вручную";
			Возврат Результат;
		КонецЕсли;

		Присоединение = ПрисоединитьПодписьИЗаписать(Ссылка, ИдДокумента, ПодписьДокумента);
		Если Присоединение.Статус = "НуженТокен" И ОбеспечитьТокен(Истина, Организация) Тогда
			Присоединение = ПрисоединитьПодписьИЗаписать(Ссылка, ИдДокумента, ПодписьДокумента);
		КонецЕсли;

		Если Присоединение.Статус = "Отправлен" Тогда
			Результат.Статус = "Отправлен";
 // Колонку пишем сразу: сверка статусов увидит акт только при следующем полном обходе.
			ЗаписатьЧитаемыйСтатус(Ссылка, "Отправлен");
			ЗаписатьВЖурналОтправку(Ссылка, ИдДокумента);
		Иначе
			ЗаписатьСтатусЭДО(Ссылка, 20, ИдДокумента);
			ЗаписатьЧитаемыйСтатус(Ссылка, "Отправляется");
			Результат.Статус = "Ошибка";
			Результат.Сообщение = ?(Присоединение.Статус = "НуженТокен",
				"Не удалось авторизоваться при присоединении подписи", Присоединение.Сообщение);
		КонецЕсли;

	Исключение
		Если ЗначениеЗаполнено(ИдСозданного) Тогда
			ЗаписатьСтатусЭДО(Ссылка, 20, ИдСозданного);
			ЗаписатьЧитаемыйСтатус(Ссылка, "Отправляется");
			Результат.ИдДокумента = ИдСозданного;
			Результат.Сообщение = "Связь оборвалась после создания акта у оператора (id "
				+ ИдСозданного + "): " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Иначе
			ЗаписатьСтатусЭДО(Ссылка, 10, "");
			Результат.Сообщение = "Отправка прервана связью, состояние у оператора неизвестно -"
				+ " проверить по номеру акта: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецЕсли;
		Результат.Статус = "ТребуетВнимания";
		ЗаписьЖурналаРегистрации("ЭДО.ОтправкаАктаСверки", УровеньЖурналаРегистрации.Ошибка,
			, Ссылка, Результат.Сообщение);
	КонецПопытки;

	Возврат Результат;
КонецФункции


// Состояния ЭДО пачкой: Соответствие (ДокументСсылка - текст состояния) из свойства ЭДО_Состояние,
// того же источника, что у колонки "ЭДО" и карточки. Пачкой - для колонок в формах списков,
// чтобы не читать свойство поштучно на каждую прокрутку.
Функция СостоянияЭДОПоДокументам(Знач МассивСсылок) Экспорт
	Результат = Новый Соответствие;
	Если МассивСсылок = Неопределено ИЛИ МассивСсылок.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Свойство = СвойствоОбъектов("ЭДО_Состояние");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Объект КАК Объект, Значение КАК Значение
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Объект В (&Объекты) И Свойство = &Свойство");
	Запрос.УстановитьПараметр("Объекты", МассивСсылок);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Объект, СокрЛП(Строка(Выборка.Значение)));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Обслуживает ли наш контур этот документ. Серверная копия ЭДО_Клиент.НашКонтурЭДО.
Функция ДокументКонтураЭДО(Знач Ссылка) Экспорт
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	ТипДокумента = ТипЗнч(Ссылка);
	Возврат ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.АктСверкиВзаиморасчетов");
КонецФункции

// Почему акт сверки нельзя перезаписать: он ушел контрагенту, и экземпляр у того действует.
// Подписанный акт - согласованный со второй стороной документ: перезаполненный под тем же номером,
// он расходится с тем, что лежит у контрагента, и никто этого не видит. Другой охват - новый акт.
// Править можно, когда экземпляр мертв или уходит: отказ, аннулирование (в том числе наше, ждущее
// ответа - за ним следует переотправка), ошибка отправки, карточка удалена.
// Возврат: текст для пользователя или пустая строка, если запись разрешена.
Функция ПричинаЗапретаПравкиАкта(Знач Ссылка) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	СвойствоИд = СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если СвойствоИд = Неопределено ИЛИ СвойствоИд.Пустая()
		ИЛИ НЕ ЗначениеЗаполнено(ЗначениеСвойстваОбъекта(Ссылка, СвойствоИд)) Тогда
		Возврат "";
	КонецЕсли;

	СвойствоСостояние = СвойствоОбъектов("ЭДО_Состояние");
	Состояние = "";
	Если СвойствоСостояние <> Неопределено И НЕ СвойствоСостояние.Пустая() Тогда
		Состояние = АктуальныйТекстКолонки(СокрЛП(Строка(ЗначениеСвойстваОбъекта(Ссылка, СвойствоСостояние))));
	КонецЕсли;
	ПравкаРазрешена = Новый Массив;
	ПравкаРазрешена.Добавить(ТекстОтклоненКонтрагентом());
	ПравкаРазрешена.Добавить(ТекстАннулирован());
	ПравкаРазрешена.Добавить(ТекстАннулированиеЖдемОтвета());
	ПравкаРазрешена.Добавить(ТекстОшибкаОтправкиУОператора());
	ПравкаРазрешена.Добавить(ТекстПолучательНеПринимаетАктыСверки());
	ПравкаРазрешена.Добавить(ТекстКолонкиАктыСверкиОператоруНеОтправляются());
	ПравкаРазрешена.Добавить(ТекстКарточкаУдалена());
	Если ПравкаРазрешена.Найти(Состояние) <> Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат "Акт сверки уже отправлен контрагенту по ЭДО" + ?(ЗначениеЗаполнено(Состояние), " (" + Состояние + ")", "")
		+ ", изменять его нельзя: у контрагента останется прежний акт. Для другого периода или состава договоров"
		+ " создайте новый акт сверки.";

КонецФункции

// Текст гиперссылки "Состояние ЭДО" в форме документа: то же, что колонка "ЭДО",
// плюс входящий запрос на аннулирование, если он есть.
Функция ТекстСостоянияДляФормыДокумента(Знач Ссылка) Экспорт

	Ссылки = Новый Массив;
	Ссылки.Добавить(Ссылка);
	Состояние = СостоянияЭДОПоДокументам(Ссылки).Получить(Ссылка);
	Текст = "ЭДО: " + ?(ЗначениеЗаполнено(Состояние), Состояние, "не отправлялся");

	СвойствоЗапрос = СвойствоОбъектов("ЭДО_ЗапросАннулирования");
	Если СвойствоЗапрос <> Неопределено И НЕ СвойствоЗапрос.Пустая() Тогда
		Запрос = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Ссылка, СвойствоЗапрос)));
		Если ЗначениеЗаполнено(Запрос) Тогда
			// Пока запрос открыт, колонка сама пишет ТекстЗапросаАннулирования вместо статуса -
			// тогда статус не повторяем, а дописываем к нему причину.
			Если СокрЛП(Состояние) = ТекстЗапросаАннулирования() Тогда
				Текст = "ЭДО: " + ТекстЗапросаАннулирования() + ": " + Запрос;
			Иначе
				Текст = Текст + ". " + ТекстЗапросаАннулирования() + ": " + Запрос;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Состояние документа человеческим текстом по данным базы, без похода в API оператора -
// запасной путь на случай реальной ошибки открытия карточки.
Функция СводкаСостоянияЭДО(Знач Ссылка) Экспорт
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "Состояние ЭДО: документ не выбран.";
	КонецЕсли;
	Строки = Новый Массив;
	Строки.Добавить(Строка(Ссылка));

	Состояние = "";
	СвойствоСостояния = СвойствоОбъектов("ЭДО_Состояние");
	Если СвойствоСостояния <> Неопределено И НЕ СвойствоСостояния.Пустая() Тогда
		Состояние = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Ссылка, СвойствоСостояния)));
	КонецЕсли;
	Идентификатор = "";
	СвойствоИд = СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если СвойствоИд <> Неопределено И НЕ СвойствоИд.Пустая() Тогда
		Идентификатор = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Ссылка, СвойствоИд)));
	КонецЕсли;

	// Пустое состояние еще не значит "не отправлялся": идентификатор может уже стоять. Писать
	// "не отправлялся" об отправленном документе нельзя - это провоцирует дубль.
	Если НЕ ПустаяСтрока(Состояние) Тогда
		Строки.Добавить("Состояние: " + Состояние);
	ИначеЕсли НЕ ПустаяСтрока(Идентификатор) Тогда
		Строки.Добавить("Состояние: отправлен, ход отправки ещё не получен");
	Иначе
		Строки.Добавить("Состояние: по ЭДО не отправлялся");
	КонецЕсли;
	Если НЕ ПустаяСтрока(Идентификатор) Тогда
		Строки.Добавить("Документ в Платформе: " + Идентификатор);
	КонецЕсли;

	Контрагент = Неопределено;
	Если ЕстьРеквизитДокумента(Ссылка, "Контрагент") Тогда
		Контрагент = Ссылка.Контрагент;
	КонецЕсли;
	Если ЗначениеЗаполнено(Контрагент) Тогда
		Адрес = "";
		СвойствоАдреса = СвойствоОбъектов("ЭДО_АдресКонтрагента");
		Если СвойствоАдреса <> Неопределено И НЕ СвойствоАдреса.Пустая() Тогда
			Адрес = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Контрагент, СвойствоАдреса)));
		КонецЕсли;
		Строки.Добавить("Контрагент: " + Строка(Контрагент));
		Строки.Добавить("Адрес ЭДО: " + ?(ПустаяСтрока(Адрес), "не заполнен - слать некуда", Адрес));
	КонецЕсли;

	Строки.Добавить("");
	Строки.Добавить("Подробности и история отправок - в обработке «Обработка заявок»,");
	Строки.Добавить("карточка «Состояние ЭДО» (открывается в тонком клиенте).");

	Текст = "";
	Для Каждого СтрокаТекста Из Строки Цикл
		Текст = Текст + ?(ПустаяСтрока(Текст) И ПустаяСтрока(СтрокаТекста), "", Символы.ПС) + СтрокаТекста;
	КонецЦикла;
	Возврат СокрЛП(Текст);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сертификат подписанта из личного хранилища учётки, под которой идёт код
// (на сервере - учётка службы кластера). Неопределено, если не найден/крипто недоступно.
Функция СертификатПодписанта(Знач Организация = Неопределено)
	Отпечаток = ОтпечатокПодписанта(Организация);
	Если НЕ ЗначениеЗаполнено(Отпечаток) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		МенеджерКриптографии = Новый МенеджерКриптографии("", "", 80);
		Хранилище = МенеджерКриптографии.ПолучитьХранилищеСертификатов(
			ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
		Возврат Хранилище.НайтиПоОтпечатку(Base64Значение(Отпечаток));
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "СертификатПодписанта: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Служебный JSON авторизации {"ts":<unix>,"nonce":<uuid>} как ДвоичныеДанные (UTF-8).
Функция ДанныеАвторизацииJSON()
	JSON = "{""ts"":" + Формат(УниверсальноеВремя(ТекущаяДатаСеанса()) - Дата(1970, 1, 1), "ЧГ=0")
		+ ",""nonce"":""" + Строка(Новый УникальныйИдентификатор()) + """}";
	Поток = Новый ПотокВПамяти;
	ЗаписьТекста = Новый ЗаписьТекста(Поток, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(JSON);
	ЗаписьТекста.Закрыть();
	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();
КонецФункции

Функция ПодключитьОбработкуЭДО()
	// Движок живет в расширении объектом (Обработка.ЭДО_ПлатформаЭДО), а не файлом в макете:
	// одна копия обслуживает и серверную отправку, и интерфейс, и версии не разъедутся.
	Возврат Обработки.ЭДО_ПлатформаЭДО.Создать();
КонецФункции

// Загрузка комплекта настроек маппинга УТ 10.3 как "клиентских настроек" обработки: они
// перекрывают штатные при сборке кэша. Движок читает их для текущего пользователя, параметр
// позволяет администратору разложить их другому пользователю.
Процедура ЗагрузитьКлиентскиеНастройки(Знач ПользовательНастроек = "") Экспорт
	// ЩА 19.10.2026 [yan]: пишется слот текущего или указанного пользователя, а не общий.
	// Свой комплект кладет каждый (форма вендора при открытии), чужому - только тот, кто вправе
	// менять настройки ЭДО: привилегии ниже иначе позволили бы затереть чужие настройки.
	Пользователь = ?(ЗначениеЗаполнено(ПользовательНастроек), ПользовательНастроек, ИмяПользователя());
	Если Пользователь <> ИмяПользователя() Тогда
		ПроверитьПравоМенятьНастройкиЭДО();
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Массив = Новый Массив;
	Массив.Добавить(Новый Структура(
		"Применять, ИмяНастройки, ИмяФайлаНастройки, ОбъектНастройки, ФорматВыгрузки, ТекстНастройки",
		Истина, "УТ_10_3_Конфигурация", "УТ_10_3_Конфигурация", "Конфигурация", "",
		ТекстНастройкиКонфигурации()));
	Массив.Добавить(Новый Структура(
		"Применять, ИмяНастройки, ИмяФайлаНастройки, ОбъектНастройки, ФорматВыгрузки, ТекстНастройки",
		Истина, "УТ_10_3_РеализацияТоваровУслуг_ON_NSCHFDOPPR", "УТ_10_3_РеализацияТоваровУслуг_ON_NSCHFDOPPR",
		"РеализацияТоваровУслуг", "ON_NSCHFDOPPR",
		ТекстНастройкиРеализации()));
	Массив.Добавить(Новый Структура(
		"Применять, ИмяНастройки, ИмяФайлаНастройки, ОбъектНастройки, ФорматВыгрузки, ТекстНастройки",
		Истина, "УТ_10_3_КорректировкаРеализации_ON_NKORSCHFDOPPR", "УТ_10_3_КорректировкаРеализации_ON_NKORSCHFDOPPR",
		"КорректировкаРеализации", "ON_NKORSCHFDOPPR",
		ТекстНастройкиКорректировки()));
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", "КлиентскиеНастройки", Массив, "клиентские настройки",
		Пользователь);
КонецПроцедуры

Процедура СохранитьТокен(Токен, Знач Организация = Неопределено)
	Отпечаток = ОтпечатокПодписанта(Организация);
	Если НЕ ЗначениеЗаполнено(Отпечаток) Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить("ЭДО_Токены", Отпечаток, Токен, , "");
КонецПроцедуры

// Текст статуса "отправка не требуется" для колонки "ЭДО" в обработке "Обработка заявок".
// Формулировка держится в одном месте: её же ищет отбор очереди в регламенте отправки,
// и расхождение в одну букву вернёт документы в очередь.
Функция ТекстСтатусаОтправкаНеТребуется() Экспорт
	Возврат "Отправка не требуется";
КонецФункции

// Человекочитаемый статус ЭДО (свойство ЭДО_Состояние) - то, что видит бухгалтерия в колонке.
// Не путать с ЭДО_КодСостояния: там числовой код хода отправки.
// Свойства может не быть (заводится не в каждой базе) - тогда молча ничего не пишем.
Процедура ЗаписатьЧитаемыйСтатус(Ссылка, Текст) Экспорт
	Свойство = СвойствоОбъектов("ЭДО_Состояние");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат;
	КонецЕсли;
	НовыйТекст = Лев(Текст, 50);
	// Через эту процедуру проходят все записи статуса оператора: точечная и полная сверка,
	// карточка документа. Поэтому извещение профиля стоит здесь, а не в каждой сверке отдельно.
	// Прежний текст читаем только для статусов оператора и только при подключенном профиле.
	Событие = СобытиеПоТекстуСтатуса(НовыйТекст);
	ПрежнийТекст = Неопределено;
	Если ЗначениеЗаполнено(Событие) И ПрофильБазыПодключен() Тогда
		ПрежнийТекст = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Ссылка, Свойство)));
	КонецЕсли;
	ЗаписатьЗначениеСвойства(Ссылка, Свойство, НовыйТекст);
	Если ПрежнийТекст <> Неопределено И ПрежнийТекст <> НовыйТекст Тогда
		СообщитьПрофилюОСостоянии(Ссылка, НовыйТекст, Событие);
	КонецЕсли;
КонецПроцедуры

// Записать значение свойства объекта. Обёртка для вызова снаружи модуля.
Процедура ЗаписатьСвойствоОбъекта(Объект, Свойство, Знач Значение) Экспорт
	ЗаписатьЗначениеСвойства(Объект, Свойство, Значение);
КонецПроцедуры

// Пустая ссылка свойства - это "свойства нет", а не "свойство без значения": отбор по ней
// находит ноль строк, запись проходит без ошибки, и вызывающий получает "нечего снимать"
// вместо "такого свойства нет".
Процедура ПроверитьСсылкуСвойства(Знач Свойство, Знач Действие)
	Если Свойство = Неопределено Тогда
		ВызватьИсключение "ЭДО: " + Действие + " свойства объекта - свойство не передано (Неопределено)";
	КонецЕсли;
	Если ТипЗнч(Свойство) = Тип("ПланВидовХарактеристикСсылка.СвойстваОбъектов") И Свойство.Пустая() Тогда
		ВызватьИсключение "ЭДО: " + Действие + " свойства объекта по ПУСТОЙ ссылке свойства -"
			+ " такого свойства нет в плане видов характеристик СвойстваОбъектов";
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьЗначениеСвойства(Объект, Свойство, Значение)
	ПроверитьСсылкуСвойства(Свойство, "запись");
	Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Объект);
	Набор.Отбор.Свойство.Установить(Свойство);
	Запись = Набор.Добавить();
	Запись.Объект = Объект;
	Запись.Свойство = Свойство;
	Запись.Значение = Значение;
	Набор.Записать();
КонецПроцедуры

// Дописывает КрНаимСтрПр (краткое наименование страны происхождения) первым дочерним элементом
// ДопСведТов для каждой строки, где движок выгрузил СвДТ/@КодПроисх.
// Требование schematron ФНС: "присутствие КрНаимСтрПр при присутствии КодПроисх".
Функция ДополнитьКрНаимСтрПр(Знач Текст)
	Маркер = "<СвДТ КодПроисх=""";
	КэшСтран = Новый Соответствие;
	Результат = "";
	Остаток = Текст;

	Пока Истина Цикл
		Поз = СтрНайти(Остаток, Маркер);
		Если Поз = 0 Тогда
			Результат = Результат + Остаток;
			Прервать;
		КонецЕсли;

		Голова = Лев(Остаток, Поз - 1) + Маркер;
		Хвост = Сред(Остаток, Поз + СтрДлина(Маркер));

		ПозКавычки = СтрНайти(Хвост, """");
		КодСтраны = ?(ПозКавычки > 1, Лев(Хвост, ПозКавычки - 1), "");
		Наим = КэшСтран[КодСтраны];
		Если Наим = Неопределено Тогда
			СтранаСсылка = Справочники.КлассификаторСтранМира.НайтиПоКоду(КодСтраны);
			Наим = ?(ЗначениеЗаполнено(СтранаСсылка), СокрЛП(СтранаСсылка.Наименование), "");
			КэшСтран.Вставить(КодСтраны, Наим);
		КонецЕсли;

		ПозДоп = СтрНайти(Хвост, "<ДопСведТов");
		Если ЗначениеЗаполнено(Наим) И ПозДоп > 0 Тогда
			ЧастьДо = Лев(Хвост, ПозДоп - 1);
			ОстХвост = Сред(Хвост, ПозДоп);
			КонецТега = СтрНайти(ОстХвост, ">");
			Если КонецТега = 0 Тогда
				Результат = Результат + Голова;
				Остаток = Хвост;
				Продолжить;
			КонецЕсли;
			Открывающий = Лев(ОстХвост, КонецТега);
			ПослеТега = Сред(ОстХвост, КонецТега + 1);
			Элемент = "<КрНаимСтрПр>" + Наим + "</КрНаимСтрПр>";
			Если Прав(Открывающий, 2) = "/>" Тогда
				Открывающий = Лев(Открывающий, СтрДлина(Открывающий) - 2) + ">";
				Элемент = Элемент + "</ДопСведТов>";
			КонецЕсли;
			Результат = Результат + Голова + ЧастьДо + Открывающий + Элемент;
			Остаток = ПослеТега;
		Иначе
			Результат = Результат + Голова;
			Остаток = Хвост;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция HTTPСоединениеЭДО()
	ЗащищённоеСоединение = Новый ЗащищенноеСоединениеOpenSSL(Новый СертификатКлиентаWindows(), Неопределено);
	// Хост - только через ХостAPI(): он согласован с префиксами путей по текущему контуру.
	Возврат Новый HTTPСоединение(ХостAPI(), 443, , , ,
		НастройкаЭДО("ТаймаутHTTPСек"), ЗащищённоеСоединение);
КонецФункции

// Человекочитаемое имя владельца сертификата. Субъект сертификата - Структура, а не Соответствие:
// Получить("CN") падает "Метод объекта не обнаружен", а синтаксический контроль и /CheckConfig
// этого не видят.
Функция ПредставлениеСубъектаСертификата(Сертификат)
	Попытка
		Субъект = Сертификат.Субъект;
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ПредставлениеСубъектаСертификата: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат "";
	КонецПопытки;

	Значение = ПолеСубъектаСертификата(Субъект, "CN");
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Значение = ПолеСубъектаСертификата(Субъект, "O");
	КонецЕсли;

	// У сертификатов УЦ ФНС поля зовутся по OID: ИНН физлица - OID1_2_643_3_131_1_1,
	// ИНН организации - OID1_2_643_100_4.
	ИменаИНН = Новый Массив;
	ИменаИНН.Добавить("ИНН");
	ИменаИНН.Добавить("INN");
	ИменаИНН.Добавить("OID1_2_643_3_131_1_1");
	ИменаИНН.Добавить("OID1_2_643_100_4");
	ИНН = "";
	Для Каждого Имя Из ИменаИНН Цикл
		ИНН = ПолеСубъектаСертификата(Субъект, Имя);
		Если ЗначениеЗаполнено(ИНН) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(ИНН) Тогда
		Значение = Значение + ", ИНН " + ИНН;
	КонецЕсли;

	Возврат Значение;
КонецФункции

// Поле субъекта по имени, без учета регистра. Субъект бывает Структурой, ФиксированнойСтруктурой
// и Соответствием в зависимости от версии платформы - обход циклом работает у всех трех.
Функция ПолеСубъектаСертификата(Субъект, Имя) Экспорт
	Попытка
		Для Каждого Элемент Из Субъект Цикл
			Если ВРег(Строка(Элемент.Ключ)) = ВРег(Имя) Тогда
				Возврат Строка(Элемент.Значение);
			КонецЕсли;
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ПолеСубъектаСертификата: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат "";
	КонецПопытки;
	Возврат "";
КонецФункции

// Все поля субъекта строкой - для диагностики: у разных УЦ состав разный, и когда
// представление вышло пустым, надо видеть, что там вообще есть.
Функция ПоляСубъектаСертификата(Сертификат) Экспорт
	Имена = Новый Массив;
	Попытка
		Для Каждого Элемент Из Сертификат.Субъект Цикл
			Имена.Добавить(Строка(Элемент.Ключ));
		КонецЦикла;
	Исключение
		Возврат "субъект не читается: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат СтрСоединить(Имена, ", ");
КонецФункции

// Говорит ли текст ошибки проверки именно об ОТЗЫВЕ, а не о недоступности УЦ.
// Коды: 0x800B010C - CERT_E_REVOKED (отозван), 0x80092013 - CRYPT_E_REVOCATION_OFFLINE
// (список отзыва недоступен), 0x80092012 - статус отзыва определить не удалось.
// Последние два означают "не знаем", и путать их с отзывом нельзя.
Функция ПризнакОтзываСертификата(Текст)
	Нижний = НРег(Текст);
	Возврат СтрНайти(Нижний, "отозв") > 0
		ИЛИ СтрНайти(Нижний, "revok") > 0
		ИЛИ СтрНайти(Нижний, "800b010c") > 0;
КонецФункции

Функция ОчиститьBase64(Строка)
	Возврат СтрЗаменить(СтрЗаменить(Строка, Символы.ПС, ""), Символы.ВК, "");
КонецФункции

Функция ПрочитатьФайлТекст(Путь)
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат ТекстовыйДокумент.ПолучитьТекст();
КонецФункции

Функция ИзвлечьИдентификатор(ТелоJSON)
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТелоJSON);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
			Значение = Данные.Получить("id");
			Если ТипЗнч(Значение) = Тип("Число") Тогда
 // Строка(Число) вставляет разделители групп - для URL и хранения нужен "ЧГ=0".
				Возврат Формат(Значение, "ЧГ=0");
			ИначеЕсли Значение <> Неопределено Тогда
				Возврат СокрЛП(Строка(Значение));
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ИзвлечьИдентификатор: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат "";
	КонецПопытки;
	Возврат "";
КонецФункции

// Запись в журнал регистрации с уровнем, заданным строкой ("Ошибка", "Предупреждение",
// "Информация", "Примечание"): на клиенте нет ни ЗаписьЖурналаРегистрации, ни перечисления уровней.
// Неизвестное имя уровня не роняет вызывающего: запись почти всегда идет из обработки ошибки.
Процедура ЗаписьЖР(ИмяСобытия, УровеньЖР = "Информация", ОбъектМД = Неопределено,
	Данные = Неопределено, Комментарий = "", РежимТранзакции = Неопределено) Экспорт

	Попытка
		Уровень = УровеньЖурналаРегистрации[УровеньЖР];
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ЗаписьЖР: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Уровень = УровеньЖурналаРегистрации.Информация;
	КонецПопытки;

	Если РежимТранзакции = Неопределено Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, Уровень, ОбъектМД, Данные, Комментарий);
	Иначе
		ЗаписьЖурналаРегистрации(ИмяСобытия, Уровень, ОбъектМД, Данные, Комментарий, РежимТранзакции);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбновлениеСвязейЭДО

// Регламент обновления рабочего адреса ЭДО по принятому приглашению: принятое приглашение само
// ничего не переключает, регламент сверяет связи с оператором и переписывает рабочий адрес.
//
// Правила:
// рабочий адрес уже ESTABLISHED -> не трогаем;
// рабочий пуст или ведет туда, где связи нет, а среди адресов есть ESTABLISHED -> переписываем
// на подтвержденный;
// несколько подтверждений -> тот, где связь установлена раньше (state.lastUpdated),
// при равенстве: прежний адрес -> 2BE -> прочие -> 2VO;
// рабочий адрес BROKEN, замены нет -> снимаем идентификатор, чтобы документы не уходили в никуда.
//
// Кандидаты (адреса контрагента из реестра ФНС) кэшируются в ХранилищеОбщихНастроек: в свойство
// Строка(50) список не влезет, а своя таблица потребовала бы реструктуризации.
//
// Параметры:
// МаксКонтрагентов - Число - ограничение прогона (0 = без ограничения), для обкатки;
// ОбновлятьРеестрДней - Число - как часто перечитывать адреса контрагента из реестра ФНС.
// Возврат: Строка - отчет о прогоне (он же уходит в журнал регистрации).
Функция ОбновитьСвязиЭДО(Знач МаксКонтрагентов = 0, Знач ОбновлятьРеестрДней = 7) Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Лог = Новый Массив;
	Счёт = Новый Структура("Проверено, Переписано, Снято, БезИзменений, НовыхАдресов, Ошибок, УстарелКПП", 0, 0, 0, 0, 0, 0, 0);

	СвИд = СвойствоОбъектов("ЭДО_АдресКонтрагента");
	Если СвИд = Неопределено ИЛИ СвИд.Пустая() Тогда
		Возврат "ОБНОВЛЕНИЕ СВЯЗЕЙ: не найдено свойство ЭДО_АдресКонтрагента";
	КонецЕсли;

	// Статус связи хранится по паре "организация - контрагент": у каждой учетной записи свое
	// свойство. Адрес и закрепление - по-прежнему у контрагента, выбирает их основная запись
	// (первая в списке): у пары адрес пока один.
	// ЩА 20.10.2026 [yan]: свое свойство и у основной записи - заводится здесь при первом прогоне.
	Для Каждого СтрокаИтога Из ОбеспечитьСвойстваСвязиОрганизаций() Цикл
		Лог.Добавить(СтрокаИтога);
	КонецЦикла;
	ОписанияСвязей = СвойстваСвязиОрганизаций();
	Если ОписанияСвязей.Количество() = 0 Тогда
		Возврат "ОБНОВЛЕНИЕ СВЯЗЕЙ: не заведено ни одной учетной записи организации";
	КонецЕсли;
	ОсновноеОписание = ОписанияСвязей[0];
	ОрганизацияСвязей = ?(ЗначениеЗаполнено(ОсновноеОписание.Организация),
		ОсновноеОписание.Организация, Неопределено);
	НашГид = ОсновноеОписание.ИдентификаторУчастника;
	Если НЕ ЗначениеЗаполнено(НашГид) Тогда
		НашГид = ГидОрганизации(ОрганизацияСвязей);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(НашГид) Тогда
		Возврат "ОБНОВЛЕНИЕ СВЯЗЕЙ: не определён идентификатор своей организации";
	КонецЕсли;
	Если ОписанияСвязей.Количество() > 1 Тогда
		Лог.Добавить("учетных записей: " + ОписанияСвязей.Количество()
			+ ", адрес выбирает основная - «" + Строка(ОрганизацияСвязей) + "»");
	КонецЕсли;

	Контрагенты = КонтрагентыДляСверкиСвязей(СвИд, МаксКонтрагентов);

	// Карточка с ИНН нашей организации пропускается только для этой же организации (ниже, в обходе
	// учетных записей): для нее это розничная продажа самой себе, по ее ИНН реестр находит ее же, и
	// карточке записался бы ее собственный адрес. Для другой нашей организации это обычный покупатель
	// (ТД ЛИОН продает Лиону): без проверки статус пары оставался пустым, и документы стояли
	// с «связь еще не проверена».
	СвоиИНН = ИННСвоихОрганизаций();
	СвоихКарточек = 0;
	Для Каждого Стр Из Контрагенты Цикл
		Если СвоиИНН[СокрЛП(Стр.ИНН)] <> Неопределено Тогда
			СвоихКарточек = СвоихКарточек + 1;
		КонецЕсли;
	КонецЦикла;

	Лог.Добавить("контрагентов в обходе: " + Контрагенты.Количество()
		+ ?(СвоихКарточек > 0, ", из них с ИНН наших организаций: " + СвоихКарточек
			+ " (каждая пропускается только для своей организации)", ""));

	Реестр = ЗагрузитьРеестрАдресов();
	Маршруты = ЗагрузитьФактическиеМаршруты();
	Соединение = HTTPСоединениеЭДО();
	Если НЕ ОбеспечитьТокен(Истина, ОрганизацияСвязей) Тогда
		Возврат "ОБНОВЛЕНИЕ СВЯЗЕЙ: не удалось получить токен авторизации";
	КонецЕсли;
	Заголовки = ЗаголовкиАвторизацииЭДО(ОрганизацияСвязей);
	Запросов = 0;
	СверкаЕГРЮЛ = НоваяСверкаЕГРЮЛ(30);

	// -- 1. добираем адреса-кандидаты тем, у кого их нет или кэш протух
	Для Каждого Стр Из Контрагенты Цикл
		ИНН = СокрЛП(Стр.ИНН);
		Если НЕ ЗначениеЗаполнено(ИНН) Тогда
			Продолжить;
		КонецЕсли;
		Запись = Реестр[ИНН];
		Если Запись <> Неопределено
			И (ТекущаяУниверсальнаяДата() - Запись.Обновлён) < ОбновлятьРеестрДней * 86400 Тогда
			Продолжить;
		КонецЕсли;

		Запросов = ПеревыпуститьТокенЭДО(Запросов, Заголовки, ОрганизацияСвязей);
		Найденные = АдресаИзРеестраФНС(Соединение, Заголовки, ИНН, СокрЛП(Стр.КПП), СверкаЕГРЮЛ);
		Запросов = Запросов + Найденные.Запросов;
		Если ЗначениеЗаполнено(Найденные.КППЕГРЮЛ) И Найденные.КППЕГРЮЛ <> ОчиститьКПП(Стр.КПП) Тогда
			Счёт.УстарелКПП = Счёт.УстарелКПП + 1;
			Лог.Добавить("  КПП " + Лев(СокрЛП(Строка(Стр.Контрагент)) + "                              ", 32)
				+ " в карточке " + СокрЛП(Стр.КПП) + ", в ЕГРЮЛ " + Найденные.КППЕГРЮЛ
				+ ", адресов по нему: " + Найденные.Адреса.Количество());
		КонецЕсли;
		Если Найденные.Ошибка Тогда
			Счёт.Ошибок = Счёт.Ошибок + 1;
			Продолжить;
		КонецЕсли;

		НоваяЗапись = Новый Структура("Адреса, Обновлён, Первый",
			Найденные.Адреса, ТекущаяУниверсальнаяДата(), Новый Соответствие);
		Если Запись <> Неопределено Тогда
			НоваяЗапись.Первый = Запись.Первый;
		КонецЕсли;
		Реестр.Вставить(ИНН, НоваяЗапись);
		Счёт.НовыхАдресов = Счёт.НовыхАдресов + Найденные.Адреса.Количество();
	КонецЦикла;

	// -- 2. собираем все интересующие адреса и спрашиваем связи пачками (см. РазмерПачкиСвязей)
	// contacts без gids отдаёт максимум 1000 записей и молча усекает картину.
	ВсеАдреса = Новый Массив;
	Для Каждого Стр Из Контрагенты Цикл
		Запись = Реестр[СокрЛП(Стр.ИНН)];
		Если Запись <> Неопределено Тогда
			Для Каждого Адрес Из Запись.Адреса Цикл
				Если ВсеАдреса.Найти(Адрес) = Неопределено Тогда
					ВсеАдреса.Добавить(Адрес);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ТекАдрес = СокрЛП(Строка(Стр.ТекИд));
		Если ЗначениеЗаполнено(ТекАдрес) И ВсеАдреса.Найти(ТекАдрес) = Неопределено Тогда
			ВсеАдреса.Добавить(ТекАдрес);
		КонецЕсли;
 // фактический маршрут тоже проверяем - у него приоритет при выборе
		ФактАдресСтр = Маршруты[СокрЛП(Стр.ИНН)];
		Если ФактАдресСтр <> Неопределено И ВсеАдреса.Найти(ФактАдресСтр) = Неопределено Тогда
			ВсеАдреса.Добавить(ФактАдресСтр);
		КонецЕсли;
	КонецЦикла;

	// -- 3. обход связей и решения - по каждой учетной записи: у каждой свой идентификатор
	// участника и свой токен. Адресные решения принимает только основная запись, прочие
	// получают лишь статус пары: у контрагента адрес пока один.
	ИтоговыеАдреса = Новый Соответствие;
	Для Каждого Описание Из ОписанияСвязей Цикл

		// ЩА 20.10.2026 [yan]: у двух учетных записей базы один идентификатор участника (так в ЦБ у Ники,
		// Миралко и ТД ЛИОН стоит гид Лиона) - статус второй писал бы в свойство первой своим видением.
		Если Описание.ГидПовторяется Тогда
			Лог.Добавить("ПРОПУСК учетной записи «" + Строка(Описание.Организация) + "»: идентификатор участника "
				+ Описание.ИдентификаторУчастника + " уже у другой учетной записи базы - исправьте учетную запись");
			Продолжить;
		КонецЕсли;
		ОргСвязи = ?(ЗначениеЗаполнено(Описание.Организация), Описание.Организация, Неопределено);
		НашГидОрг = Описание.ИдентификаторУчастника;
		Если НЕ ЗначениеЗаполнено(НашГидОрг) Тогда
			НашГидОрг = ГидОрганизации(ОргСвязи);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НашГидОрг) Тогда
			Лог.Добавить("ПРОПУСК учетной записи «" + Строка(Описание.Организация)
				+ "»: не определён идентификатор участника");
			Продолжить;
		КонецЕсли;
		Если НЕ ОбеспечитьТокен(Истина, ОргСвязи) Тогда
			Если Описание.Основная Тогда
				Возврат "ОБНОВЛЕНИЕ СВЯЗЕЙ: не удалось получить токен авторизации";
			КонецЕсли;
			Лог.Добавить("ПРОПУСК учетной записи «" + Строка(Описание.Организация) + "»: нет токена");
			Продолжить;
		КонецЕсли;
		ЗаголовкиОрг = ЗаголовкиАвторизацииЭДО(ОргСвязи);
		ИННОрг = СокрЛП(Строка(?(ОргСвязи = Неопределено, ОрганизацияСвязей, ОргСвязи).ИНН));

		Запросов = ПеревыпуститьТокенЭДО(Запросов, ЗаголовкиОрг, ОргСвязи);
		Обход = СтатусыСвязейПолно(Соединение, ЗаголовкиОрг, НашГидОрг, ВсеАдреса);
		Связи = Обход.Связи;
		Лог.Добавить(?(ОписанияСвязей.Количество() > 1, "[" + Строка(Описание.Организация) + "] ", "")
			+ "адресов проверено: " + Обход.Проверено + " из " + ВсеАдреса.Количество()
			+ ", связей получено: " + Связи.Количество()
			+ ?(Обход.Неудач > 0, ", НЕ ОПРОШЕНО: " + Обход.Неудач, ""));
		Если Обход.Неудач > 0 Тогда
 // решение по неполным данным опаснее бездействия: контрагента уведёт с рабочего адреса
			Отказ = "не удалось опросить "
				+ Обход.Неудач + " адресов из " + ВсеАдреса.Количество() + ", адреса не менялись"
				+ ОтказыОбходаСтрокой(Обход);
			Если Описание.Основная Тогда
				Итог = "ЭДО, обновление связей: ПРОГОН ОТМЕНЁН - " + Отказ;
				ЗаписьЖурналаРегистрации("ЭДО.ОбновлениеСвязей", УровеньЖурналаРегистрации.Предупреждение, , , Итог);
				Возврат Итог;
			КонецЕсли;
			Лог.Добавить("ПРОПУСК учетной записи «" + Строка(Описание.Организация) + "»");
			ЗаписьЖурналаРегистрации("ЭДО.ОбновлениеСвязей", УровеньЖурналаРегистрации.Предупреждение, , ,
				Строка(Описание.Организация) + ": " + Отказ);
			Продолжить;
		КонецЕсли;

		Для Каждого Стр Из Контрагенты Цикл
		// Карточка самой этой организации: ни адреса, ни статуса пары с собой.
		Если ЗначениеЗаполнено(ИННОрг) И СокрЛП(Стр.ИНН) = ИННОрг Тогда
			Продолжить;
		КонецЕсли;
		ТекАдрес = СокрЛП(Строка(Стр.ТекИд));
		Если Описание.Основная Тогда
		Счёт.Проверено = Счёт.Проверено + 1;
		ИНН = СокрЛП(Стр.ИНН);
		Запись = Реестр[ИНН];
		Кандидаты = ?(Запись = Неопределено, Новый Массив, Запись.Адреса);
		ПервыйУвиден = ?(Запись = Неопределено, Новый Соответствие, Запись.Первый);

 // У контрагента с закрепленным адресом регламент ничего не выбирает: эвристика нужна, пока выбор
 // не сделан, а подтвержденный приемкой документа выбор она способна только испортить.
		Если ЗначениеЗаполнено(ТекАдрес) И АдресЭДОЗакреплён(Стр.Контрагент) Тогда
			СостЗакр = СостояниеСвязи(Связи, ТекАдрес);
			Решение = Новый Структура("Действие, Адрес, Статус, Закрепить, Основание", "оставить", ТекАдрес,
				?(СостЗакр = Неопределено, "", СостЗакр.Статус), Ложь, "");
		Иначе
			Решение = ВыбратьРабочийАдресЭДО(ТекАдрес, Кандидаты, Связи, ПервыйУвиден, Маршруты[ИНН]);
		КонецЕсли;

		Если Решение.Действие = "переписать" Тогда
			ЗаписатьЗначениеСвойства(Стр.Контрагент, СвИд, Решение.Адрес);
			Счёт.Переписано = Счёт.Переписано + 1;
			Лог.Добавить("  -> " + Лев(СокрЛП(Строка(Стр.Контрагент)) + "                              ", 32)
				+ " " + ?(ЗначениеЗаполнено(ТекАдрес), ТекАдрес, "(пусто)") + " => " + Решение.Адрес);
		ИначеЕсли Решение.Действие = "снять" Тогда
			НаборИд = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
			НаборИд.Отбор.Объект.Установить(Стр.Контрагент);
			НаборИд.Отбор.Свойство.Установить(СвИд);
			НаборИд.Записать(Истина);
			Счёт.Снято = Счёт.Снято + 1;
			Лог.Добавить("  X  " + Лев(СокрЛП(Строка(Стр.Контрагент)) + "                              ", 32)
				+ " связь BROKEN, идентификатор снят (" + ТекАдрес + ")");
		Иначе
			Счёт.БезИзменений = Счёт.БезИзменений + 1;
		КонецЕсли;

 // Закрепление фактического маршрута с неподтвержденным роумингом: дальше карточка выходит
 // из-под эвристики, ждем подтверждения.
		Если Решение.Закрепить И НЕ АдресЭДОЗакреплён(Стр.Контрагент) Тогда
			Попытка
				ЗакрепитьАдресЭДО(Стр.Контрагент, Решение.Адрес, Решение.Основание);
				Лог.Добавить("  ЗАКР " + Лев(СокрЛП(Строка(Стр.Контрагент)) + "                              ", 32)
					+ " " + Решение.Адрес + " (" + Решение.Основание + ")");
			Исключение
				Счёт.Ошибок = Счёт.Ошибок + 1;
				Лог.Добавить("  ERR закрепление " + СокрЛП(Строка(Стр.Контрагент)) + ": "
					+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;

		// ЩА 20.10.2026 [yan], ревью Codex 860: статус нового адреса пишется сразу, без удержания прежней связи.
		ЗаписатьСтатусСвязиОрганизации(Стр.Контрагент, Описание, Решение.Статус,
			Решение.Действие <> "оставить" ИЛИ НРег(Решение.Адрес) <> НРег(ТекАдрес));
		Если Решение.Действие <> "оставить" ИЛИ НРег(Решение.Адрес) <> НРег(ТекАдрес) Тогда
			ИтоговыеАдреса.Вставить(Стр.Контрагент, ?(Решение.Действие = "снять", "", Решение.Адрес));
		КонецЕсли;

 // запоминаем момент первого подтверждения - страховка на случай, если оператор
 // перестанет отдавать lastUpdated (поля нет в документации, оно может исчезнуть)
		Если Запись <> Неопределено И ЗначениеЗаполнено(Решение.Адрес)
			И Запись.Первый[Решение.Адрес] = Неопределено Тогда
			Запись.Первый.Вставить(Решение.Адрес, ТекущаяУниверсальнаяДата());
		КонецЕсли;

		Иначе

 // прочие учетные записи адрес не выбирают: пишут только статус пары по итоговому адресу
		АдресПары = ИтоговыеАдреса[Стр.Контрагент];
		Если АдресПары = Неопределено Тогда
			АдресПары = ТекАдрес;
		КонецЕсли;
		СостояниеОрг = СостояниеСвязи(Связи, АдресПары);
		Если СостояниеОрг <> Неопределено Тогда
			СтатусПары = СостояниеОрг.Статус;
		ИначеЕсли ЗначениеЗаполнено(АдресПары) И Лев(АдресПары, 3) = "2VO" Тогда
			СтатусПары = "DIRECT";
		Иначе
			СтатусПары = "NO_CONTACT";
		КонецЕсли;
		ЗаписатьСтатусСвязиОрганизации(Стр.Контрагент, Описание, СтатусПары, ИтоговыеАдреса[Стр.Контрагент] <> Неопределено);

		КонецЕсли;

		Если Описание.СвойствоПроверки <> Неопределено И НЕ Описание.СвойствоПроверки.Пустая() Тогда
			ЗаписатьЗначениеСвойства(Стр.Контрагент, Описание.СвойствоПроверки, ТекущаяДатаСеанса());
		КонецЕсли;

		КонецЦикла;
	КонецЦикла;

	СохранитьРеестрАдресов(Реестр);
	Лог.Добавить("фактических маршрутов в справочнике: " + Маршруты.Количество());

	Секунд = Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000, 1);
	Итог = "ЭДО, обновление связей: проверено " + Счёт.Проверено
		+ ", переписан адрес у " + Счёт.Переписано
		+ ", снято (BROKEN) " + Счёт.Снято
		+ ", без изменений " + Счёт.БезИзменений
		+ ", ошибок реестра " + Счёт.Ошибок
		+ ?(Счёт.УстарелКПП > 0, ", КПП в карточке устарел у " + Счёт.УстарелКПП, "")
		+ ?(СверкаЕГРЮЛ.Капча, ", ЕГРЮЛ потребовал капчу", "")
		+ "; " + Секунд + " c";
	Лог.Вставить(0, Итог);
	Текст = СтрСоединить(Лог, Символы.ПС);

	ЗаписьЖурналаРегистрации("ЭДО.ОбновлениеСвязей",
		?(Счёт.Ошибок > 0, УровеньЖурналаРегистрации.Предупреждение, УровеньЖурналаРегистрации.Информация),
		, , Лев(Текст, 5000));

	Возврат Текст;
КонецФункции

// Выбор рабочего адреса по правилам оператора.
// Возврат: Структура (Действие "оставить"/"переписать"/"снять", Адрес, Статус).
Функция ВыбратьРабочийАдресЭДО(Знач ТекАдрес, Знач Кандидаты, Знач Связи, Знач ПервыйУвиден,
	Знач ФактАдрес = "") Экспорт

	Результат = Новый Структура("Действие, Адрес, Статус, Закрепить, Основание",
		"оставить", ТекАдрес, "", Ложь, "");

	// Фактический маршрут важнее "просто живого" адреса и очередности подтверждений: контрагент
	// читает тот ящик, куда мы слали годами, а на другом его адресе документы могут не смотреть.
	Если ЗначениеЗаполнено(ФактАдрес) И НЕ АдресЭДОВнеАвтовыбора(ФактАдрес) Тогда
		СостФакт = СостояниеСвязи(Связи, ФактАдрес);
		ФактЖивой = (СостФакт <> Неопределено И СостФакт.Статус = "ESTABLISHED");
		Если НЕ ФактЖивой И СостФакт = Неопределено И Лев(ФактАдрес, 3) = "2VO" Тогда
 // Пустой ответ contacts для 2VO - лишь предположение прямой связи внутри Платформы, а не
 // подтверждение: синтетический адрес 2VO есть у многих, кто там не работает. Поэтому уступаем
 // адресу, который контрагент подтвердил явно.
			СостТек = СостояниеСвязи(Связи, ТекАдрес);
			ФактЖивой = НЕ (СостТек <> Неопределено И СостТек.Статус = "ESTABLISHED");
		КонецЕсли;
		Если ФактЖивой Тогда
			Результат.Статус = ?(СостФакт = Неопределено, "DIRECT", "ESTABLISHED");
			Результат.Адрес = ФактАдрес;
			Результат.Действие = ?(НРег(ТекАдрес) = НРег(ФактАдрес), "оставить", "переписать");
			Возврат Результат;
		КонецЕсли;

 // Маршрут известен, а роуминг по нему не подтвержден (AWAIT_APPROVAL) - закрепляем маршрут
 // и держим документы, пока контрагент не примет приглашение: молчаливый уход в чужой ящик хуже
 // задержки. При NO_CONTACT (приглашения не было) поведение прежнее, иначе документы встанут
 // навсегда; рассылку приглашений решает отдельный сценарий.
		Если СостФакт <> Неопределено И СостФакт.Статус = "AWAIT_APPROVAL" Тогда
			Результат.Статус = "AWAIT_APPROVAL";
			Результат.Адрес = ФактАдрес;
			Результат.Действие = ?(НРег(ТекАдрес) = НРег(ФактАдрес), "оставить", "переписать");
			Результат.Закрепить = Истина;
			Результат.Основание = "фактический маршрут, ждём роуминг";
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	ТекСостояние = СостояниеСвязи(Связи, ТекАдрес);

	// Пустой ответ contacts для пары абонентов одного оператора (2VO) - не "связи нет", а "настройка
	// не требуется": адрес рабочий, но только пока нет подтвержденной замены (2VO вне автовыбора).
	Если ЗначениеЗаполнено(ТекАдрес) И ТекСостояние = Неопределено И Лев(ТекАдрес, 3) = "2VO"
		И НЕ ЕстьПодтверждённаяЗамена(Кандидаты, Связи) Тогда
		Результат.Статус = "DIRECT";
		Возврат Результат;
	КонецЕсли;
	// адрес вне автовыбора (2LT) не "удерживает" карточку самим фактом живой связи:
	// ищем замену ниже, а если её нет - идентификатор снимается
	Если ТекСостояние <> Неопределено И ТекСостояние.Статус = "ESTABLISHED"
		И НЕ АдресЭДОВнеАвтовыбора(ТекАдрес) Тогда
		Результат.Статус = "ESTABLISHED";
		Возврат Результат;
	КонецЕсли;

	Подтверждённые = Новый Массив;
	Для Каждого Адрес Из Кандидаты Цикл
		Если АдресЭДОВнеАвтовыбора(Адрес) Тогда
			Продолжить;
		КонецЕсли;
		Состояние = СостояниеСвязи(Связи, Адрес);
		Если Состояние <> Неопределено И Состояние.Статус = "ESTABLISHED" Тогда
			Подтверждённые.Добавить(Адрес);
		КонецЕсли;
	КонецЦикла;

	Если Подтверждённые.Количество() = 0 Тогда
		Если ЗначениеЗаполнено(ТекАдрес) И АдресЭДОСнимаетсяБезЗамены(ТекАдрес) Тогда
 // "пустая запись": отправлять некуда - документы копятся в очереди и видны в разборе
			Результат.Действие = "снять";
			Результат.Адрес = "";
			Результат.Статус = ?(ТекСостояние = Неопределено, "NO_CONTACT", ТекСостояние.Статус);
			Возврат Результат;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекАдрес) И Лев(ТекАдрес, 3) = "2VO" И ТекСостояние = Неопределено Тогда
 // замены нет - ящик Платформы остаётся: доставка там работает, читают её плохо,
 // но пустая карточка остановила бы поток совсем (см. АдресЭДОСнимаетсяБезЗамены)
			Результат.Статус = "DIRECT";
			Возврат Результат;
		КонецЕсли;
		Если ТекСостояние <> Неопределено И ТекСостояние.Статус = "BROKEN" Тогда
			Результат.Действие = "снять";
			Результат.Адрес = "";
			Результат.Статус = "BROKEN";
		ИначеЕсли ТекСостояние <> Неопределено Тогда
			Результат.Статус = ТекСостояние.Статус;
		Иначе
			Результат.Статус = ?(ЗначениеЗаполнено(ТекАдрес), "NO_CONTACT", "");
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Лучший = "";
	ЛучшееВремя = Дата(3999, 12, 31);
	Для Каждого Адрес Из Подтверждённые Цикл
		Состояние = СостояниеСвязи(Связи, Адрес);
		Время = Состояние.Обновлён;
		Если НЕ ЗначениеЗаполнено(Время) Тогда
			Время = ?(ПервыйУвиден[Адрес] = Неопределено, ТекущаяУниверсальнаяДата(), ПервыйУвиден[Адрес]);
		КонецЕсли;
		Заменить = Ложь;
		Если Лучший = "" Тогда
			Заменить = Истина;
		ИначеЕсли Время < ЛучшееВремя Тогда
			Заменить = Истина;
		ИначеЕсли Время = ЛучшееВремя
			И ПриоритетАдресаЭДО(Адрес, ТекАдрес) < ПриоритетАдресаЭДО(Лучший, ТекАдрес) Тогда
			Заменить = Истина;
		КонецЕсли;
		Если Заменить Тогда
			Лучший = Адрес;
			ЛучшееВремя = Время;
		КонецЕсли;
	КонецЦикла;

	Результат.Адрес = Лучший;
	Результат.Статус = "ESTABLISHED";
	// адрес тот же - это не смена маршрута, а подтверждение; в журнал такое писать не за что
	Результат.Действие = ?(ВРег(Лучший) = ВРег(ТекАдрес), "оставить", "переписать");
	Возврат Результат;
КонецФункции

// Есть ли среди кандидатов подтвержденный адрес, годный для автовыбора.
Функция ЕстьПодтверждённаяЗамена(Знач Кандидаты, Знач Связи)
	Для Каждого Адрес Из Кандидаты Цикл
		Если АдресЭДОВнеАвтовыбора(Адрес) Тогда
			Продолжить;
		КонецЕсли;
		Состояние = СостояниеСвязи(Связи, Адрес);
		Если Состояние <> Неопределено И Состояние.Статус = "ESTABLISHED" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Адрес, который автоматика выбирать не вправе - только человек, закреплением: 2LT (ЭДО Лайт),
// 2VO (ящик у Платформы), 2IM (ЕЭТП). Канал доставляет формально (связь ESTABLISHED, квитанции
// подписаны), а читателя за ящиком нет, и вскрывается это только жалобой клиента. Пусть документ
// лучше не уйдет и попадет в разбор; ручное закрепление сильнее этого правила.
Функция АдресЭДОВнеАвтовыбора(Знач Адрес) Экспорт
	Префикс = Лев(СокрЛП(Адрес), 3);
	Возврат Префикс = "2LT" ИЛИ Префикс = "2VO" ИЛИ Префикс = "2IM";
КонецФункции

// Как канал называется для человека: гейт удержания один на все адреса вне автовыбора, а каналы
// разные, и общий текст отправлял бухгалтера разбираться не с тем оператором.
Функция ИмяКаналаЭДО(Знач Адрес) Экспорт
	Префикс = ВРег(Лев(СокрЛП(Адрес), 3));
	Если Префикс = "2LT" Тогда
		Возврат "ЭДО Лайт";
	ИначеЕсли Префикс = "2VO" Тогда
		Возврат "ящик у Платформы ЭДО";
	ИначеЕсли Префикс = "2IM" Тогда
		Возврат "ЕЭТП";
	КонецЕсли;
	Возврат "резервный канал";
КонецФункции

// Имена операторов ЭДО по коду адреса: соответствие "2BM" - "Диадок" и т.д.
// Имени оператора в ответе API нет, таблица кодов лежит в макете "СлужебныеДанные" обработки вендора.
// Макет читать один раз на весь список: чтение на каждую строку стоит секунды.
Функция ОператорыЭДО() Экспорт

	Операторы = Новый Соответствие;
	Попытка
		Макет = Обработки.ЭДО_ПлатформаЭДО.ПолучитьМакет("СлужебныеДанные");
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ОператорыЭДО: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат Операторы;
	КонецПопытки;

	Для НомерСтроки = 1 По Макет.ВысотаТаблицы Цикл
		Код = ВРег(СокрЛП(Макет.Область(НомерСтроки, 1, НомерСтроки, 1).Текст));
		Представление = СокрЛП(Макет.Область(НомерСтроки, 2, НомерСтроки, 2).Текст);
		Если СтрДлина(Код) = 3 И ЗначениеЗаполнено(Представление) Тогда
			Операторы.Вставить(Код, Представление);
		КонецЕсли;
	КонецЦикла;

	// В макете вендора ЕЭТП нет, а адреса 2IM у контрагентов встречаются.
	Если Операторы.Получить("2IM") = Неопределено Тогда
		Операторы.Вставить("2IM", "ЕЭТП");
	КонецЕсли;

	Возврат Операторы;

КонецФункции

// Имя оператора по адресу ЭДО. Операторы - результат ОператорыЭДО(); не передан - макет читается здесь.
Функция ИмяОператораЭДО(Знач Адрес, Знач Операторы = Неопределено) Экспорт

	// Дефиса после кода может не быть: у СБИС адрес выглядит как "2BE140397E1B...",
	// поэтому режем ровно три символа, а не до разделителя.
	Адрес = СокрЛП(Адрес);
	Если СтрДлина(Адрес) < 3 Тогда
		Возврат "";
	КонецЕсли;
	Код = ВРег(Лев(Адрес, 3));

	Если Операторы = Неопределено Тогда
		Операторы = ОператорыЭДО();
	КонецЕсли;
	Если Операторы.Количество() = 0 Тогда
		Возврат Код;
	КонецЕсли;

	Представление = Операторы.Получить(Код);
	Возврат ?(Представление = Неопределено, Код + " (оператор не опознан)", Представление);

КонецФункции

// Из адресов вне автовыбора карточка обнуляется только там, откуда документ заведомо не доходит:
// 2LT закрыт требованием ГИС МТ, и пустая карточка честнее - работа попадает в разбор. 2VO
// доставляет (хотя его плохо читают), и снятие остановило бы поток: он выведен только из выбора.
Функция АдресЭДОСнимаетсяБезЗамены(Знач Адрес) Экспорт
	Возврат Лев(СокрЛП(Адрес), 3) = "2LT";
КонецФункции

// Приоритет адреса при равном времени подтверждения: меньше - лучше. Прежний рабочий адрес
// важнее всего (маршрут не должен переезжать без причины), 2VO и 2IM последние.
Функция ПриоритетАдресаЭДО(Знач Адрес, Знач ПрежнийАдрес) Экспорт
	Если ЗначениеЗаполнено(ПрежнийАдрес) И Адрес = ПрежнийАдрес Тогда
		Возврат 0;
	КонецЕсли;
	Префикс = Лев(Адрес, 3);
	Если Префикс = "2BE" Тогда
		Возврат 1;
	ИначеЕсли Префикс = "2VO" ИЛИ Префикс = "2IM" Тогда
		Возврат 9;
	КонецЕсли;
	Возврат 5;
КонецФункции

// Контрагенты, которых имеет смысл сверять: те, кому уходили приглашения (у них есть отметка
// любого из свойств ЭДО), плюс те, по кому за последние 120 дней были отгрузки.
Функция КонтрагентыДляСверкиСвязей(Знач СвИд, Знач МаксКонтрагентов) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЭДОКонтрагент.Ссылка КАК Контрагент,
	|	ЭДОКонтрагент.ИНН КАК ИНН,
	|	ЭДОКонтрагент.КПП КАК КПП,
	|	МАКСИМУМ(ВЫРАЗИТЬ(ЭДОИд.Значение КАК СТРОКА(50))) КАК ТекИд
	|ИЗ
	|	Справочник.Контрагенты КАК ЭДОКонтрагент
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЭДОИд
	|		ПО ВЫРАЗИТЬ(ЭДОИд.Объект КАК Справочник.Контрагенты) = ЭДОКонтрагент.Ссылка
	|			И ЭДОИд.Свойство = &СвИд
	|ГДЕ
	|	НЕ ЭДОКонтрагент.ПометкаУдаления
	|	И НЕ ЭДОКонтрагент.ЭтоГруппа
	|	И НЕ ПОДСТРОКА(ЭДОКонтрагент.ИНН, 1, 1) = """"
	|	И (ЭДОИд.Значение ЕСТЬ НЕ NULL
	|		ИЛИ ЭДОКонтрагент.Ссылка В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ ЭДОРеализация.Контрагент
	|			 ИЗ Документ.РеализацияТоваровУслуг КАК ЭДОРеализация
	|			 ГДЕ ЭДОРеализация.Проведен
	|				И ЭДОРеализация.ОтражатьВБухгалтерскомУчете
	|				И ЭДОРеализация.Дата >= &ДатаС))
	|СГРУППИРОВАТЬ ПО
	|	ЭДОКонтрагент.Ссылка, ЭДОКонтрагент.ИНН, ЭДОКонтрагент.КПП
	|УПОРЯДОЧИТЬ ПО
	|	ИНН";
	Запрос.УстановитьПараметр("СвИд", СвИд);
	Запрос.УстановитьПараметр("ДатаС", НачалоДня(ТекущаяДатаСеанса() - 120 * 86400));
	Таблица = Запрос.Выполнить().Выгрузить();

	Если МаксКонтрагентов > 0 И Таблица.Количество() > МаксКонтрагентов Тогда
		Урезанная = Таблица.СкопироватьКолонки();
		Для Инд = 0 По МаксКонтрагентов - 1 Цикл
			ЗаполнитьЗначенияСвойств(Урезанная.Добавить(), Таблица[Инд]);
		КонецЦикла;
		Возврат Урезанная;
	КонецЕсли;
	Возврат Таблица;
КонецФункции

// ЩА 23.10.2026 [yan]: адреса одного контрагента из реестра ФНС - для приглашения из Центра управления
// контрагента, которому еще ничего не отгружали: кэш реестра (ЗагрузитьРеестрАдресов) пополняет регламент
// только по контрагентам с отгрузками. Один контрагент - один-два запроса; кэш реестра не пишется.
// Организация - от чьей учетной записи спрашивать; пустая - как у ПригласитьПоСписку.
// Возврат: Структура (Адреса Массив, Ошибка Булево), Ошибка - и при отсутствии токена.
Функция АдресаКонтрагентаИзРеестраФНС(Знач Контрагент, Знач Организация = Неопределено) Экспорт

	ОрганизацияСвязей = Организация;
	Если НЕ ЗначениеЗаполнено(ОрганизацияСвязей) И НесколькоУчетныхЗаписейЭДО() Тогда
		ОрганизацияСвязей = УчетныеЗаписиЭДО()[0].Организация;
	КонецЕсли;
	Если НЕ ОбеспечитьТокен(Ложь, ОрганизацияСвязей) Тогда
		Возврат Новый Структура("Адреса, Ошибка", Новый Массив, Истина);
	КонецЕсли;
	Возврат АдресаИзРеестраФНС(HTTPСоединениеЭДО(), ЗаголовкиАвторизацииЭДО(ОрганизацияСвязей),
		СокрЛП(Строка(Контрагент.ИНН)), СокрЛП(Строка(Контрагент.КПП)), НоваяСверкаЕГРЮЛ(1));

КонецФункции

// Все адреса контрагента в реестре ФНС.
// Для ЮЛ КПП обязателен (без него 400). КПП филиала может дать 404 - тогда пробуем основной КПП
// (первые 4 цифры ИНН + 01001). Если 404 на оба, а КПП в карточке устарел, ищем по КПП из ЕГРЮЛ;
// СверкаЕГРЮЛ - структура из НоваяСверкаЕГРЮЛ, Неопределено - в ЕГРЮЛ не ходить.
// Возврат: Структура (Адреса Массив, Ошибка Булево, Запросов Число, КППЕГРЮЛ Строка).
Функция АдресаИзРеестраФНС(Соединение, Заголовки, Знач ИНН, Знач КПП, СверкаЕГРЮЛ = Неопределено) Экспорт

	Результат = Новый Структура("Адреса, Ошибка, Запросов, КППЕГРЮЛ", Новый Массив, Ложь, 0, "");
	ЮрЛицо = (СтрДлина(ИНН) = 10);
	БылСбой = Ложь;

	Варианты = Новый Массив;
	Если ЮрЛицо Тогда
		ЧистыйКПП = ОчиститьКПП(КПП);
		Если ЗначениеЗаполнено(ЧистыйКПП) Тогда
			Варианты.Добавить(ЧистыйКПП);
		КонецЕсли;
		ОсновнойКПП = Лев(ИНН, 4) + "01001";
		Если Варианты.Найти(ОсновнойКПП) = Неопределено Тогда
			Варианты.Добавить(ОсновнойКПП);
		КонецЕсли;
	Иначе
		Варианты.Добавить("");
	КонецЕсли;

	Для Каждого Вариант Из Варианты Цикл
		КодОтвета = ДобавитьАдресаИзРеестраФНС(Соединение, Заголовки, ИНН, Вариант, Результат);
		Если КодОтвета = 0 Тогда
			Результат.Ошибка = Истина;
			Возврат Результат;
		КонецЕсли;
		// 404 - абонента под этим КПП нет; любой другой код - запрос не выполнен, и пустой список не ответ.
		БылСбой = БылСбой ИЛИ (КодОтвета <> 200 И КодОтвета <> 404);
		Если Результат.Адреса.Количество() > 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ЮрЛицо И НЕ БылСбой И Результат.Адреса.Количество() = 0 И ТипЗнч(СверкаЕГРЮЛ) = Тип("Структура") Тогда
		Результат.КППЕГРЮЛ = ДействующийКППИзЕГРЮЛ(ИНН, СверкаЕГРЮЛ);
		Если ЗначениеЗаполнено(Результат.КППЕГРЮЛ) И Варианты.Найти(Результат.КППЕГРЮЛ) = Неопределено Тогда
			КодОтвета = ДобавитьАдресаИзРеестраФНС(Соединение, Заголовки, ИНН, Результат.КППЕГРЮЛ, Результат);
			БылСбой = (КодОтвета <> 200 И КодОтвета <> 404);
		КонецЕсли;
	КонецЕсли;

	Результат.Ошибка = БылСбой И Результат.Адреса.Количество() = 0;
	Возврат Результат;

КонецФункции

// Один запрос к реестру ФНС по паре ИНН и КПП; найденные адреса дописываются в Результат.Адреса.
// Возврат: код ответа HTTP, 0 - запрос не выполнен.
Функция ДобавитьАдресаИзРеестраФНС(Соединение, Заголовки, Знач ИНН, Знач КПП, Результат)

	Путь = ПутьСервиса("subscriber") + "/public/api/v3/shared-subscribers?inn=" + ИНН
		+ ?(ЗначениеЗаполнено(КПП), "&kpp=" + КПП, "");
	Попытка
		Ответ = Соединение.Получить(Новый HTTPЗапрос(Путь, Заголовки));
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ДобавитьАдресаИзРеестраФНС: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат 0;
	КонецПопытки;
	Результат.Запросов = Результат.Запросов + 1;
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат Ответ.КодСостояния;
	КонецЕсли;

	Тело = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	// смещение ровно 7 - длина ""gid":""; при 8 срезается первый символ идентификатора
	Позиция = СтрНайти(Тело, """gid"":""");
	Пока Позиция > 0 Цикл
		Хвост = Сред(Тело, Позиция + 7);
		Гид = Лев(Хвост, СтрНайти(Хвост, """") - 1);
		Если ЗначениеЗаполнено(Гид) И Результат.Адреса.Найти(Гид) = Неопределено Тогда
			Результат.Адреса.Добавить(Гид);
		КонецЕсли;
		Тело = Хвост;
		Позиция = СтрНайти(Тело, """gid"":""");
	КонецЦикла;
	Возврат Ответ.КодСостояния;

КонецФункции

// Лимит обращений к ЕГРЮЛ на один прогон и пауза между ними: ограничение у ФНС по адресу,
// частые запросы переводят его на капчу.
Функция НоваяСверкаЕГРЮЛ(Знач Лимит = 1) Экспорт

	Возврат Новый Структура("Осталось, Последний, Капча", Лимит, 0, Ложь);

КонецФункции

// Действующий КПП юрлица по ИНН из открытого поиска egrul.nalog.ru.
// Пустая строка - не узнали: лимит прогона исчерпан, сервис потребовал капчу, не ответил или ЮЛ прекращено.
Функция ДействующийКППИзЕГРЮЛ(Знач ИНН, СверкаЕГРЮЛ) Экспорт

	ИНН = СокрЛП(ИНН);
	Если СтрДлина(ИНН) <> 10 Тогда
		Возврат "";
	КонецЕсли;
	Строки = СтрокиЕГРЮЛ(ИНН, СверкаЕГРЮЛ);
	Если Строки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	// Прекращенные ЮЛ и прежние записи приходят с датой прекращения в поле "e".
	Для Каждого Запись Из Строки Цикл
		Если СокрЛП(Строка(Запись.Получить("i"))) = ИНН
			И Строка(Запись.Получить("k")) = "ul" И НЕ ЗначениеЗаполнено(Запись.Получить("e")) Тогда
			Возврат ОчиститьКПП(Строка(Запись.Получить("p")));
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// ФИО и ОГРНИП индивидуального предпринимателя по ИНН из того же поиска ФНС.
// Опрошено = Ложь - ответа нет (лимит, капча, сбой), и "не найден" отсюда выводить нельзя.
// Несколько записей на один ИНН - норма (повторная регистрация, смена фамилии), берется самая
// свежая по дате регистрации. Регистр ФИО в реестре разный: свежие записи заглавными.
// Возврат: Структура (Опрошено, Найден Булево, Фамилия, Имя, Отчество, ОГРНИП Строка).
Функция СведенияИПИзЕГРИП(Знач ИНН, СверкаЕГРЮЛ) Экспорт

	Результат = Новый Структура("Опрошено, Найден, Фамилия, Имя, Отчество, ОГРНИП", Ложь, Ложь, "", "", "", "");
	ИНН = СокрЛП(ИНН);
	Если СтрДлина(ИНН) <> 12 Тогда
		Возврат Результат;
	КонецЕсли;
	Строки = СтрокиЕГРЮЛ(ИНН, СверкаЕГРЮЛ);
	Если Строки = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Опрошено = Истина;

	Свежая = Неопределено;
	ДатаСвежей = Дата(1, 1, 1);
	Для Каждого Запись Из Строки Цикл
		Если СокрЛП(Строка(Запись.Получить("i"))) <> ИНН ИЛИ Строка(Запись.Получить("k")) <> "fl" Тогда
			Продолжить;
		КонецЕсли;
		ДатаЗаписи = ДатаИзДДММГГГГ(Строка(Запись.Получить("r")));
		Если Свежая = Неопределено ИЛИ ДатаЗаписи > ДатаСвежей Тогда
			Свежая = Запись;
			ДатаСвежей = ДатаЗаписи;
		КонецЕсли;
	КонецЦикла;
	Если Свежая = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Части = СтрРазделить(ФИОСЗаглавной(Строка(Свежая.Получить("n"))), " ", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Найден = Истина;
	Результат.Фамилия = Части[0];
	Результат.Имя = Части[1];
	Части.Удалить(1);
	Части.Удалить(0);
	Результат.Отчество = СтрСоединить(Части, " ");
	Результат.ОГРНИП = ОГРНИПИлиПусто(Свежая.Получить("o"));
	Возврат Результат;

КонецФункции

// ОГРНИП из реестра Платформы по ИНН. Номер есть только у абонентов самой Платформы (type SP),
// у абонентов других операторов (ExSP) в details лишь ИНН и наименование.
// Возврат: Строка - ОГРНИП из 15 цифр, "" - не нашли или запрос не выполнен.
Функция ОГРНИПИзРеестраОператора(РеестрОператора, Знач ИНН) Экспорт

	Путь = ПутьСервиса("subscriber") + "/public/api/v3/shared-subscribers?inn=" + ИНН;
	Попытка
		Ответ = РеестрОператора.Соединение.Получить(Новый HTTPЗапрос(Путь, РеестрОператора.Заголовки));
		Если Ответ.КодСостояния = 401 И ОбеспечитьТокен(Истина, РеестрОператора.Организация) Тогда
			РеестрОператора.Заголовки = ЗаголовкиАвторизацииЭДО(РеестрОператора.Организация);
			Ответ = РеестрОператора.Соединение.Получить(Новый HTTPЗапрос(Путь, РеестрОператора.Заголовки));
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ОГРНИПИзРеестраОператора: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат "";
	КонецПопытки;
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		ЧтениеОтвета = Новый ЧтениеJSON;
		ЧтениеОтвета.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
		ДанныеРеестра = ПрочитатьJSON(ЧтениеОтвета, Истина);
		ЧтениеОтвета.Закрыть();
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ОГРНИПИзРеестраОператора: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат "";
	КонецПопытки;
	Если ТипЗнч(ДанныеРеестра) = Тип("Соответствие") Тогда
		ДанныеРеестра = ДанныеРеестра.Получить("content");
	КонецЕсли;
	Если ТипЗнч(ДанныеРеестра) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого АбонентРеестра Из ДанныеРеестра Цикл
		Если ТипЗнч(АбонентРеестра) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		СведенияАбонента = АбонентРеестра.Получить("details");
		Если ТипЗнч(СведенияАбонента) <> Тип("Соответствие")
			ИЛИ СокрЛП(Строка(СведенияАбонента.Получить("inn"))) <> ИНН Тогда
			Продолжить;
		КонецЕсли;
		ОГРНИП = ОГРНИПИлиПусто(СведенияАбонента.Получить("ogrn"));
		Если ЗначениеЗаполнено(ОГРНИП) Тогда
			Возврат ОГРНИП;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Соединение и заголовки к реестру Платформы для ОбеспечитьРеквизитыИП. Неопределено - нет токена.
Функция НовыйРеестрОператора(Знач Организация = Неопределено) Экспорт

	Если НЕ ОбеспечитьТокен(Ложь, Организация) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Соединение, Заголовки, Организация",
		СоединениеСОператором(), ЗаголовкиАвторизацииЭДО(Организация), Организация);

КонецФункции

Функция ОГРНИПИлиПусто(Знач Значение)

	Текст = СокрЛП(Строка(Значение));
	Если СтрДлина(Текст) <> 15 Тогда
		Возврат "";
	КонецЕсли;
	Для Позиция = 1 По 15 Цикл
		Если СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;
	Возврат Текст;

КонецФункции

// "ИВАНОВ-ПЕТРОВ ИВАН" -> "Иванов-Петров Иван": каждая часть, и через дефис тоже.
Функция ФИОСЗаглавной(Знач Текст)

	Слова = Новый Массив;
	Для Каждого Слово Из СтрРазделить(СокрЛП(Текст), " " + Символы.Таб, Ложь) Цикл
		Части = Новый Массив;
		Для Каждого Часть Из СтрРазделить(Слово, "-") Цикл
			Части.Добавить(ВРег(Лев(Часть, 1)) + НРег(Сред(Часть, 2)));
		КонецЦикла;
		Слова.Добавить(СтрСоединить(Части, "-"));
	КонецЦикла;
	Возврат СтрСоединить(Слова, " ");

КонецФункции

// Записи поиска egrul.nalog.ru по ИНН: Массив соответствий (поля i, k, n, p, r, e).
// Неопределено - не спросили или не получили ответа: лимит прогона исчерпан, капча, сбой.
Функция СтрокиЕГРЮЛ(Знач ИНН, СверкаЕГРЮЛ)

	Если СверкаЕГРЮЛ.Капча ИЛИ СверкаЕГРЮЛ.Осталось <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	СверкаЕГРЮЛ.Осталось = СверкаЕГРЮЛ.Осталось - 1;

	ОбозревательДляЕГРЮЛ = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0 Safari/537.36";
	Попытка
		ПодождатьДо(СверкаЕГРЮЛ.Последний + 1500);
		СоединениеЕГРЮЛ = Новый HTTPСоединение("egrul.nalog.ru", 443, , , , 20, Новый ЗащищенноеСоединениеOpenSSL);

		ЗаголовкиПоиска = Новый Соответствие;
		ЗаголовкиПоиска.Вставить("User-Agent", ОбозревательДляЕГРЮЛ);
		ЗаголовкиПоиска.Вставить("X-Requested-With", "XMLHttpRequest");
		ЗаголовкиПоиска.Вставить("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");
		ЗапросПоиска = Новый HTTPЗапрос("/", ЗаголовкиПоиска);
		ЗапросПоиска.УстановитьТелоИзСтроки("vyp3CaptchaToken=&page=&query=" + ИНН + "&region=&PreventChromeAutocomplete=",
			"UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		Ответ = СоединениеЕГРЮЛ.ОтправитьДляОбработки(ЗапросПоиска);
		СверкаЕГРЮЛ.Последний = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Если Ответ.КодСостояния <> 200 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Поиск = ПрочитатьОтветЕГРЮЛ(Ответ);
		Если Поиск.Получить("captchaRequired") = Истина Тогда
			СверкаЕГРЮЛ.Капча = Истина;
			Возврат Неопределено;
		КонецЕсли;
		ТокенПоиска = Строка(Поиск.Получить("t"));
		Если НЕ ЗначениеЗаполнено(ТокенПоиска) Тогда
			Возврат Неопределено;
		КонецЕсли;

		ЗаголовкиРезультата = Новый Соответствие;
		ЗаголовкиРезультата.Вставить("User-Agent", ОбозревательДляЕГРЮЛ);
		ЗаголовкиРезультата.Вставить("X-Requested-With", "XMLHttpRequest");
		Для НомерПопытки = 1 По 3 Цикл
			Если НомерПопытки > 1 Тогда
				ПодождатьДо(ТекущаяУниверсальнаяДатаВМиллисекундах() + 1000);
			КонецЕсли;
			Ответ = СоединениеЕГРЮЛ.Получить(Новый HTTPЗапрос("/search-result/" + ТокенПоиска, ЗаголовкиРезультата));
			СверкаЕГРЮЛ.Последний = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Если Ответ.КодСостояния <> 200 Тогда
				Продолжить;
			КонецЕсли;
			Строки = ПрочитатьОтветЕГРЮЛ(Ответ).Получить("rows");
			Если ТипЗнч(Строки) <> Тип("Массив") Тогда
				Продолжить;
			КонецЕсли;
			Записи = Новый Массив;
			Для Каждого Запись Из Строки Цикл
				Если ТипЗнч(Запись) = Тип("Соответствие") Тогда
					Записи.Добавить(Запись);
				КонецЕсли;
			КонецЦикла;
			Возврат Записи;
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.ЕГРЮЛ", УровеньЖурналаРегистрации.Предупреждение, , ,
			"ИНН " + ИНН + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Неопределено;

КонецФункции

// ФИО и ОГРНИП покупателя-ИП. Без ФИО УПД и УКД уходят запасной веткой СвФЛУч без имени, и получатель
// отклоняет документ; без ОГРНИП акт сверки не проходит ФЛК оператора (ОГРНИПТип).
// ОГРНИП сначала ищется в реестре Платформы (быстро, если в Контексте есть РеестрОператора), потом в ЕГРИП.
// Ненайденный в ЕГРИП (физлицо не ИП) помечается датой проверки и 30 дней не переспрашивается.
// Контекст - контекст прогона: общий лимит и пауза к ЕГРЮЛ на пакет (ключ СверкаЕГРЮЛ).
// Возврат: Структура (ФИО Булево, ОГРНИП Строка - откуда взят, НеНайден Булево,
// ОГРНИПНеЗаполнен Булево - был нужен и остался пустым, Текст Строка).
Функция ОбеспечитьРеквизитыИП(Знач Контрагент, Контекст = Неопределено) Экспорт

	Итог = Новый Структура("ФИО, ОГРНИП, НеНайден, ОГРНИПНеЗаполнен, Текст", Ложь, "", Ложь, Ложь, "");
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Итог;
	КонецЕсли;
	ИНН = СокрЛП(Строка(Контрагент.ИНН));
	Если СтрДлина(ИНН) <> 12 Тогда
		Возврат Итог;
	КонецЕсли;

	СвФам = СвойствоОбъектов("ЭДО_КонтрагентФамилия");
	СвИмя = СвойствоОбъектов("ЭДО_КонтрагентИмя");
	СвОтч = СвойствоОбъектов("ЭДО_КонтрагентОтчество");
	НужноФИО = НЕ (СвФам.Пустая() ИЛИ СвИмя.Пустая() ИЛИ СвОтч.Пустая())
		И НЕ (ЗначениеЗаполнено(ЗначениеСвойстваОбъекта(Контрагент, СвФам))
			И ЗначениеЗаполнено(ЗначениеСвойстваОбъекта(Контрагент, СвИмя)));
	НужноОГРНИП = НЕ ЗначениеЗаполнено(СокрЛП(Контрагент.ОГРН));
	Если НЕ НужноФИО И НЕ НужноОГРНИП Тогда
		Возврат Итог;
	КонецЕсли;
	СвПроверка = СвойствоОбъектов("ЭДО_ЕГРИППроверен");
	Если НЕ СвПроверка.Пустая() Тогда
		Проверен = ДатаИзДДММГГГГ(Строка(ЗначениеСвойстваОбъекта(Контрагент, СвПроверка)));
		Если ЗначениеЗаполнено(Проверен) И ТекущаяДатаСеанса() - Проверен < 30 * 86400 Тогда
			Итог.ОГРНИПНеЗаполнен = НужноОГРНИП;
			Возврат Итог;
		КонецЕсли;
	КонецЕсли;

	Сделано = Новый Массив;
	Если НужноОГРНИП И ТипЗнч(Контекст) = Тип("Структура") И Контекст.Свойство("РеестрОператора")
		И ТипЗнч(Контекст.РеестрОператора) = Тип("Структура") Тогда
		ОГРНИП = ОГРНИПИзРеестраОператора(Контекст.РеестрОператора, ИНН);
		Если ЗначениеЗаполнено(ОГРНИП) И ЗаписатьОГРНКонтрагента(Контрагент, ОГРНИП) Тогда
			НужноОГРНИП = Ложь;
			Итог.ОГРНИП = "Платформа";
			Сделано.Добавить("ОГРНИП из реестра Платформы");
		КонецЕсли;
	КонецЕсли;

	Если НужноФИО ИЛИ НужноОГРНИП Тогда

		Если ТипЗнч(Контекст) = Тип("Структура") Тогда
			Если НЕ Контекст.Свойство("СверкаЕГРЮЛ") Тогда
				Контекст.Вставить("СверкаЕГРЮЛ", НоваяСверкаЕГРЮЛ(20));
			КонецЕсли;
			Сверка = Контекст.СверкаЕГРЮЛ;
		Иначе
			Сверка = НоваяСверкаЕГРЮЛ(1);
		КонецЕсли;

		Сведения = СведенияИПИзЕГРИП(ИНН, Сверка);
		Если НЕ Сведения.Опрошено Тогда
			Итог.ОГРНИПНеЗаполнен = НужноОГРНИП;
			Возврат Итог;
		КонецЕсли;
		Если НЕ Сведения.Найден Тогда
			Если НЕ СвПроверка.Пустая() Тогда
				ЗаписатьЗначениеСвойства(Контрагент, СвПроверка, Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy"));
			КонецЕсли;
			Итог.НеНайден = Истина;
			Итог.ОГРНИПНеЗаполнен = НужноОГРНИП;
			Итог.Текст = "в ЕГРИП не найден";
			Возврат Итог;
		КонецЕсли;

		Если НужноФИО Тогда
			ЗаписатьЗначениеСвойства(Контрагент, СвФам, Сведения.Фамилия);
			ЗаписатьЗначениеСвойства(Контрагент, СвИмя, Сведения.Имя);
			ЗаписатьЗначениеСвойства(Контрагент, СвОтч, Сведения.Отчество);
			Итог.ФИО = Истина;
			Сделано.Добавить("ФИО из ЕГРИП: " + СокрЛП(Сведения.Фамилия + " " + Сведения.Имя + " " + Сведения.Отчество));
		КонецЕсли;
		Если НужноОГРНИП Тогда
			Если ЗначениеЗаполнено(Сведения.ОГРНИП) Тогда
				Если ЗаписатьОГРНКонтрагента(Контрагент, Сведения.ОГРНИП) Тогда
					Итог.ОГРНИП = "ЕГРИП";
					Сделано.Добавить("ОГРНИП из ЕГРИП");
				Иначе
					Итог.ОГРНИПНеЗаполнен = Истина;
				КонецЕсли;
			Иначе
				Итог.ОГРНИПНеЗаполнен = Истина;
				Если НЕ СвПроверка.Пустая() Тогда
					ЗаписатьЗначениеСвойства(Контрагент, СвПроверка, Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy"));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;

	Если Сделано.Количество() > 0 Тогда
		Итог.Текст = СтрСоединить(Сделано, "; ");
		ЗаписьЖурналаРегистрации("ЭДО.ЕГРИП", УровеньЖурналаРегистрации.Информация, , Контрагент, Итог.Текст);
	КонецЕсли;
	Возврат Итог;

КонецФункции

// ОГРН пишется в сам справочник обычной записью, чтобы изменение ушло в обмены.
// Заполненный ОГРН не перезаписывается. Возврат: Истина - записан.
Функция ЗаписатьОГРНКонтрагента(Знач Контрагент, Знач ОГРНИП)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ОбъектКонтрагента = Контрагент.ПолучитьОбъект();
		Если ЗначениеЗаполнено(СокрЛП(ОбъектКонтрагента.ОГРН)) Тогда
			Возврат Ложь;
		КонецЕсли;
		ОбъектКонтрагента.ОГРН = ОГРНИП;
		ОбъектКонтрагента.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.ЕГРИП", УровеньЖурналаРегистрации.Предупреждение, , Контрагент,
			"ОГРНИП не записан: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции

// ++ ЩА 20.10.2026 [yan]
// Почему УПД покупателю-ИП отправлять нельзя: у него нет ФИО, а в ЕГРИП он не отмечен проверенным.
// Отмечен и без ФИО - в ЕГРИП не найден, это физлицо, и ветка СвФЛУч для него правильная.
// Возврат: Строка - причина; пустая - отправлять можно.
Функция ПричинаНетФИОПокупателяИП(Знач Контрагент)
	Если НЕ ЗначениеЗаполнено(Контрагент) ИЛИ СтрДлина(СокрЛП(Строка(Контрагент.ИНН))) <> 12 Тогда
		Возврат "";
	КонецЕсли;
	// Держим, только когда база умеет и заполнить ФИО, и отметить проверку ЕГРИП - те же свойства, что нужны
	// ОбеспечитьРеквизитыИП. Без любого из них ФИО и отметка не появятся никогда, и документ встал бы навсегда:
	// тогда он уходит, как до проверки (СвФЛУч).
	СвФам = СвойствоОбъектов("ЭДО_КонтрагентФамилия");
	СвИмя = СвойствоОбъектов("ЭДО_КонтрагентИмя");
	СвОтч = СвойствоОбъектов("ЭДО_КонтрагентОтчество");
	СвПроверка = СвойствоОбъектов("ЭДО_ЕГРИППроверен");
	Если СвФам.Пустая() ИЛИ СвИмя.Пустая() ИЛИ СвОтч.Пустая() ИЛИ СвПроверка.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗначениеСвойстваОбъекта(Контрагент, СвФам))
		И ЗначениеЗаполнено(ЗначениеСвойстваОбъекта(Контрагент, СвИмя)) Тогда
		Возврат "";
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗначениеСвойстваОбъекта(Контрагент, СвПроверка)) Тогда
		Возврат "";
	КонецЕсли;
	Возврат "Покупатель-ИП без ФИО: ЕГРИП не ответил или кончился лимит запросов прогона. Без ФИО УПД"
		+ " уйдет как физлицу, и Честный знак отклонит фиксацию (ERROR_71 recipientInn). Документ уйдет"
		+ " следующим прогоном; ФИО можно внести в свойства ЭДО_КонтрагентФамилия/Имя/Отчество";
КонецФункции
// -- ЩА 20.10.2026 [yan].

// Разовое дозаполнение ФИО и ОГРНИП покупателей-ИП с отгрузками за последние ДнейНазад дней.
// Лимит - сколько запросов к ЕГРЮЛ можно сделать за прогон. Возврат: Строка - итог прогона.
Функция ДозаполнитьРеквизитыИП(Знач Лимит = 600, Знач ДнейНазад = 365) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Реализация.Контрагент КАК Контрагент,
		|	Реализация.Организация КАК Организация
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Реализация
		|ГДЕ
		|	Реализация.Дата >= &Дата
		|	И Реализация.Проведен
		|	И ДЛИНАСТРОКИ(Реализация.Контрагент.ИНН) = 12");
	Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДатаСеанса()) - ДнейНазад * 86400);
	// ++ ЩА 20.10.2026 [yan]: реестр Платформы - по организации реализации. Без организации в базе
	// с несколькими учетными записями ЭДО НовыйРеестрОператора() падает, и дозаполнение не шло вовсе.
	Контекст = Новый Структура("СверкаЕГРЮЛ, РеестрОператора", НоваяСверкаЕГРЮЛ(Лимит), Неопределено);
	РеестрыОрганизаций = Новый Соответствие;
	Обработанные = Новый Соответствие;
	БезРеестра = Новый Массив;   // ревью Codex 828: итог - по всем организациям, а не по последней строке
	// -- ЩА 20.10.2026 [yan].

	ЗаполненоФИО = 0;
	ОГРНИПИзПлатформы = 0;
	ОГРНИПИзЕГРИП = 0;
	НеНайдено = 0;
	ОсталосьБезОГРНИП = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// ++ ЩА 20.10.2026 [yan]
		Если Обработанные[Выборка.Контрагент] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Обработанные.Вставить(Выборка.Контрагент, Истина);
		Реестр = РеестрыОрганизаций[Выборка.Организация];
		Если Реестр = Неопределено Тогда
			// Перехват обоснован: без реестра одной организации ФИО остальных все равно дозаполняются
			// из ЕГРИП. Причина - в ЖР, организация - в итоговую строку.
			Попытка
				Реестр = НовыйРеестрОператора(Выборка.Организация);
			Исключение
				ЗаписьЖурналаРегистрации("ЭДО.ЕГРИП", УровеньЖурналаРегистрации.Ошибка, , Выборка.Организация,
					"Реестр Платформы для дозаполнения ФИО ИП не получен: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				Реестр = Ложь;
			КонецПопытки;
			Если Реестр = Неопределено Тогда
				Реестр = Ложь;   // без токена реестра нет - помним это, а не запрашиваем снова
			КонецЕсли;
			Если Реестр = Ложь Тогда
				БезРеестра.Добавить(Строка(Выборка.Организация));
			КонецЕсли;
			РеестрыОрганизаций.Вставить(Выборка.Организация, Реестр);
		КонецЕсли;
		Контекст.РеестрОператора = ?(Реестр = Ложь, Неопределено, Реестр);
		// -- ЩА 20.10.2026 [yan].
		Итог = ОбеспечитьРеквизитыИП(Выборка.Контрагент, Контекст);
		ЗаполненоФИО = ЗаполненоФИО + ?(Итог.ФИО, 1, 0);
		ОГРНИПИзПлатформы = ОГРНИПИзПлатформы + ?(Итог.ОГРНИП = "Платформа", 1, 0);
		ОГРНИПИзЕГРИП = ОГРНИПИзЕГРИП + ?(Итог.ОГРНИП = "ЕГРИП", 1, 0);
		НеНайдено = НеНайдено + ?(Итог.НеНайден, 1, 0);
		ОсталосьБезОГРНИП = ОсталосьБезОГРНИП + ?(Итог.ОГРНИПНеЗаполнен, 1, 0);
	КонецЦикла;

	Возврат "ФИО заполнено: " + ЗаполненоФИО + ", ОГРНИП из Платформы: " + ОГРНИПИзПлатформы
		+ ", ОГРНИП из ЕГРИП: " + ОГРНИПИзЕГРИП + ", в ЕГРИП не найдено: " + НеНайдено
		+ ", осталось без ОГРНИП: " + ОсталосьБезОГРНИП
		+ ", запросов к ЕГРЮЛ осталось: " + Контекст.СверкаЕГРЮЛ.Осталось
		+ ?(БезРеестра.Количество() = 0, "", ", реестр Платформы недоступен (нет токена): "
			+ СтрСоединить(БезРеестра, "; "))
		+ ?(Контекст.СверкаЕГРЮЛ.Капча, ", ЕГРЮЛ потребовал капчу", "");

КонецФункции

Функция ПрочитатьОтветЕГРЮЛ(Ответ)

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ПрочитатьОтветЕГРЮЛ: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Данные = Неопределено;
	КонецПопытки;
	Возврат ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные, Новый Соответствие);

КонецФункции

// Ожидание на сервере без внешних средств; годится для пауз в секунды.
Процедура ПодождатьДо(Знач МоментВМиллисекундах)

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < МоментВМиллисекундах Цикл
	КонецЦикла;

КонецПроцедуры

// Статусы связей по списку адресов. Обход пачками по РазмерПачкиСвязей (см. ниже).
// Возврат: Соответствие (адрес -> Структура(Статус, Обновлён, ЖдёмОт)).
Функция СтатусыСвязейЭДО(Соединение, Заголовки, Знач НашГид, Знач Адреса) Экспорт
	Возврат СтатусыСвязейПолно(Соединение, Заголовки, НашГид, Адреса).Связи;
КонецФункции

// Сколько адресов спрашивать у оператора за один запрос contacts. Ответ молча усекается
// до 40 пар (HTTP 200, часть gids просто отсутствует), и потеря читалась бы как "связи нет".
// 25 - с запасом: потолок оператор не документирует и может снизить.
Функция РазмерПачкиСвязей()
	Возврат 25;
КонецФункции

// То же, но честно сообщает о неполноте обхода: сбойная пачка не должна читаться как "связи нет".
// На тысячах адресов токен успевает протухнуть посреди обхода, так что сбой - штатный случай.
// Возврат: Структура (Связи Соответствие, Неудач Число, Проверено Число, Коды, ПервыйОтказ).
Функция СтатусыСвязейПолно(Соединение, Заголовки, Знач НашГид, Знач Адреса) Экспорт

	// Диагностика обязательна: при неудаче пачки код ответа и первое тело собираются здесь
	// и печатаются вызывающим, иначе причину отказа обхода не установить.
	Результат = Новый Структура("Связи, Неудач, Проверено, Коды, ПервыйОтказ",
		Новый Соответствие, 0, 0, Новый Соответствие, "");
	Пачка = Новый Массив;
	Запросов = 0;
	// Организацию определяет наш идентификатор: токен перевыпускается ее учетной записи.
	Организация = ОрганизацияПоИдентификаторуЭДО(НашГид);


	Для Индекс = 0 По Адреса.Количество() - 1 Цикл
		Пачка.Добавить(Адреса[Индекс]);
		Если Пачка.Количество() < РазмерПачкиСвязей() И Индекс < Адреса.Количество() - 1 Тогда
			Продолжить;
		КонецЕсли;

		Запросов = ПеревыпуститьТокенЭДО(Запросов, Заголовки, Организация);
		Путь = ПутьСервиса("roaming") + "/public/api/v3/subscribers/" + НашГид + "/contacts?gids=" + СтрСоединить(Пачка, ",");
		Удалось = Ложь;
		Для Попытка_ = 1 По 3 Цикл
			Попытка
				Ответ = Соединение.Получить(Новый HTTPЗапрос(Путь, Заголовки));
			Исключение
				ОтметитьКодОбхода(Результат, "исключение", ОписаниеОшибки());
				Продолжить;   // сеть моргнула - пробуем еще раз
			КонецПопытки;
			Запросов = Запросов + 1;
			Если Ответ.КодСостояния = 200 Тогда
				РазобратьСвязи(Ответ.ПолучитьТелоКакСтроку("UTF-8"), НашГид, Результат.Связи);
				Удалось = Истина;
				Прервать;
			ИначеЕсли Ответ.КодСостояния = 401 Тогда
				ОтметитьКодОбхода(Результат, "401", "");
				ОбеспечитьТокен(Истина, Организация);
				Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));
			Иначе
				ОтметитьКодОбхода(Результат, Строка(Ответ.КодСостояния),
					Лев(Ответ.ПолучитьТелоКакСтроку("UTF-8"), 300));
			КонецЕсли;
		КонецЦикла;

		Если Удалось Тогда
			Результат.Проверено = Результат.Проверено + Пачка.Количество();
		Иначе
			Результат.Неудач = Результат.Неудач + Пачка.Количество();
		КонецЕсли;
		Пачка.Очистить();
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Копит статистику отказов обхода: сколько каких кодов и текст ПЕРВОГО тела.
// Первое тело, а не последнее: при массовом отказе интересна причина, с которой всё началось.
Процедура ОтметитьКодОбхода(Обход, Знач Ключ, Знач Тело)

	Обход.Коды.Вставить(Ключ, ?(Обход.Коды[Ключ] = Неопределено, 0, Обход.Коды[Ключ]) + 1);
	Если НЕ ЗначениеЗаполнено(Обход.ПервыйОтказ) Тогда
		Обход.ПервыйОтказ = Ключ + ?(ЗначениеЗаполнено(Тело), ": " + Тело, "");
	КонецЕсли;

КонецПроцедуры

// Читаемая сводка отказов обхода - для журнала регистрации.
Функция ОтказыОбходаСтрокой(Знач Обход) Экспорт

	Если Обход.Свойство("Коды") = Ложь ИЛИ Обход.Коды.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Части = Новый Массив;
	Для Каждого КЗ Из Обход.Коды Цикл
		Части.Добавить(КЗ.Ключ + " × " + КЗ.Значение);
	КонецЦикла;
	Возврат "; отказы: " + СтрСоединить(Части, ", ")
		+ ?(ЗначениеЗаполнено(Обход.ПервыйОтказ), "; первый - " + Обход.ПервыйОтказ, "");

КонецФункции

// Разбор ответа contacts. Поле state.lastUpdated (время смены статуса связи) в документации
// оператора не описано, но только оно позволяет выбрать адрес, подтвержденный контрагентом первым.
Процедура РазобратьСвязи(Знач Тело, Знач НашГид, Связи)

	Позиция = СтрНайти(Тело, """parties"":[");
	Пока Позиция > 0 Цикл
		Хвост = Сред(Тело, Позиция + 11);
		КонецБлока = СтрНайти(Хвост, "}");
		Блок = ?(КонецБлока > 0, Лев(Хвост, КонецБлока), Хвост);

 // второй участник пары - не мы
		Адрес = "";
		ПозГид = СтрНайти(Блок, """");
		Остаток = Блок;
		Пока ПозГид > 0 Цикл
			Значение = Сред(Остаток, ПозГид + 1);
			КонецЗначения = СтрНайти(Значение, """");
			Если КонецЗначения = 0 Тогда
				Прервать;
			КонецЕсли;
			Кандидат = Лев(Значение, КонецЗначения - 1);
			Если ЗначениеЗаполнено(Кандидат) И Кандидат <> НашГид И СтрНайти(Кандидат, "-") + СтрДлина(Кандидат) > 5
				И НЕ Кандидат = "status" И НЕ Кандидат = "lastUpdated" И НЕ Кандидат = "fromParty" И НЕ Кандидат = "state" Тогда
				Адрес = Кандидат;
				Прервать;
			КонецЕсли;
			Остаток = Сред(Значение, КонецЗначения + 1);
			ПозГид = СтрНайти(Остаток, """");
		КонецЦикла;

		Статус = ЗначениеПоляJSON(Хвост, "status");
		ВремяСтр = ЗначениеПоляJSON(Хвост, "lastUpdated");
		ЖдёмОт = ЗначениеПоляJSON(Хвост, "fromParty");

		Если ЗначениеЗаполнено(Адрес) И ЗначениеЗаполнено(Статус) Тогда
 // Ключ - всегда в верхнем регистре, читать только через СостояниеСвязи(): оператор отдает адрес
 // заглавными, а в базе он лежит как записали (у СБИС хвост часто строчный), и Соответствие
 // регистрозависимо - промах читался бы как "связи нет".
			Связи.Вставить(ВРег(Адрес), Новый Структура("Статус, Обновлён, ЖдёмОт",
				Статус, ДатаИзISO(ВремяСтр), ЖдёмОт));
		КонецЕсли;

		Тело = Хвост;
		Позиция = СтрНайти(Тело, """parties"":[");
	КонецЦикла;

КонецПроцедуры

// Состояние связи по адресу. Неопределено, если связи нет.
// Единственный законный способ читать соответствие связей: ключи в нём нормализованы к ВРег,
// а адреса приходят из базы и из реестра ФНС в произвольном регистре.
Функция СостояниеСвязи(Знач Связи, Знач Адрес) Экспорт

	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Связи[ВРег(СокрЛП(Адрес))];

КонецФункции

// Значение строкового поля JSON, начиная от текущей позиции. "" если не найдено.
Функция ЗначениеПоляJSON(Знач Текст, Знач Имя)
	Ключ = """" + Имя + """:""";
	Позиция = СтрНайти(Текст, Ключ);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Текст, Позиция + СтрДлина(Ключ));
	Конец = СтрНайти(Хвост, """");
	Возврат ?(Конец > 0, Лев(Хвост, Конец - 1), "");
КонецФункции

// "2026-08-18T03:13:11.911282Z" -> Дата. Пустая дата, если разобрать не удалось.
Функция ДатаИзISO(Знач Строка)
	Если СтрДлина(Строка) < 19 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Возврат Дата(Число(Сред(Строка, 1, 4)), Число(Сред(Строка, 6, 2)), Число(Сред(Строка, 9, 2)),
			Число(Сред(Строка, 12, 2)), Число(Сред(Строка, 15, 2)), Число(Сред(Строка, 18, 2)));
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ДатаИзISO: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат Дата(1, 1, 1);
	КонецПопытки;
КонецФункции

// КПП из справочника встречается с мусором вида "/59020100" - оставляем только 9 цифр.
Функция ОчиститьКПП(Знач КПП)
	Только = "";
	Для Индекс = 1 По СтрДлина(КПП) Цикл
		Символ = Сред(КПП, Индекс, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Только = Только + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(СтрДлина(Только) = 9, Только, "");
КонецФункции

// Идентификатор своей организации у Платформы - из ее учетной записи ЭДО.
Функция ГидОрганизации(Знач Организация = Неопределено) Экспорт
	Запись = УчетнаяЗаписьЭДО(Организация);
	Возврат ?(Запись = Неопределено, "", Запись.ИдентификаторУчастника);
КонецФункции

Функция ЗаголовкиАвторизацииЭДО(Знач Организация = Неопределено)
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));
	Заголовки.Вставить("accept", "application/json;charset=UTF-8");
	Возврат Заголовки;
КонецФункции

// Токен Keycloak живёт 15 минут - в длинном прогоне перевыпускаем превентивно.
Функция ПеревыпуститьТокенЭДО(Знач Запросов, Заголовки, Знач Организация = Неопределено)
	Если Запросов > 0 И Запросов % 150 = 0 Тогда
		ОбеспечитьТокен(Истина, Организация);
		Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));
	КонецЕсли;
	Возврат Запросов;
КонецФункции

// Кэш адресов-кандидатов: ИНН -> Структура(Адреса Массив, Обновлён Дата, Первый Соответствие).
Функция ЗагрузитьРеестрАдресов() Экспорт
	// Общие настройки лежат под пользователем "": для обычного пользователя это чужой слот, без привилегий - «Нарушение прав доступа».
	УстановитьПривилегированныйРежим(Истина);
	// Читать с тем же пользователем, с каким писали (пустое имя): Загрузить без параметра берет
	// текущего пользователя и молча возвращает Неопределено.
	Значение = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", "РеестрАдресов", , "");
	Возврат ?(ТипЗнч(Значение) = Тип("Соответствие"), Значение, Новый Соответствие);
КонецФункции

// ЩА 19.10.2026 [yan]: без Экспорт - пишет только ядро, с клиента кэш не подменить.
Процедура СохранитьРеестрАдресов(Знач Реестр)
	// Общие настройки лежат под пользователем "": для обычного пользователя это чужой слот, без привилегий - «Нарушение прав доступа».
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", "РеестрАдресов", Реестр,
		"кандидаты адресов ЭДО", "");
КонецПроцедуры

#КонецОбласти

#Область КарточкиУОператора

// Живые статусы карточки: экземпляр действует у контрагента и второй такой же будет дублем.
// Мёртвыми считаем только те, где документ у контрагента заведомо не действует.
// Аннулирование учитываем ПО ЗАПРОСУ ТОЖЕ (CANCELLATION_REQUESTED): пока контрагент его
// не подтвердил, экземпляр у него действует, и повторная отправка добавит второй.
Функция КарточкаЖивая(Знач Статус, Знач Состояние) Экспорт

	// FIXATION_FAILED: Честный знак отказал в фиксации, и оператор документ покупателю не передал -
	// исправленный документ (например, с верными КПП мест деятельности) отправляется заново.
	Мёртвые = "SENDING_FAILED,REJECTED,DELETED,CANCELLED,CANCELLATION_REQUESTED,FIXATION_FAILED";
	Если ЗначениеЗаполнено(Состояние) И ВРег(СокрЛП(Состояние)) <> "ACTIVE" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти("," + Мёртвые + ",", "," + ВРег(СокрЛП(Статус)) + ",") = 0;

КонецФункции

// Карточки документа у оператора по паре "мы - получатель" за период от даты документа.
// Единственный способ узнать, ушел ли документ на самом деле: переотправка начинается
// со снятия отметки в базе.
// Спрашивать обязательно парой sender_id + recipient_id: по одному sender_id запрос
// не укладывается и в 30 с, пара отвечает за доли секунды.
// Даты - ISO с временем и "Z" (java.time.Instant); "2026-09-07" отвергается с 400.
// Номер уникален только внутри года - поэтому сверяем пару "номер + дата".
// СверятьДату = Ложь - для акта сверки: в его карточке дата формирования файла, а не дата акта.
//
// Возврат: Структура (Опрошено Булево, Причина Строка, Карточки Массив
// из Структура(Ид, Тип, Статус, Состояние, Живая, Создана - дата UTC)).
Функция КарточкиДокументаУОператора(Соединение, Заголовки, Знач НашГид, Знач ГидПолучателя,
	Знач Номер, Знач ДатаДокумента, Знач СверятьДату = Истина) Экспорт

	Результат = Новый Структура("Опрошено, Причина, Карточки", Ложь, "", Новый Массив);
	// Организацию определяет наш идентификатор: токен перевыпускается ее учетной записи.
	Организация = ОрганизацияПоИдентификаторуЭДО(НашГид);

	Если НЕ ЗначениеЗаполнено(ГидПолучателя) ИЛИ НЕ ЗначениеЗаполнено(Номер) Тогда
		Результат.Причина = "не задан получатель или номер документа";
		Возврат Результат;
	КонецЕсли;

	// Оператор не принимает интервал длиннее 31 дня (HTTP 400) - период обходим окнами.
	// Даты - Instant в UTC, с запасом в сутки в обе стороны: дата документа локальная,
	// а карточка создается позже.
	НачалоПериода = НачалоДня(ДатаДокумента) - 86400;
	КонецПериода = ТекущаяУниверсальнаяДата() + 86400;
	// Ограничение сверху: у документа многолетней давности иначе вышли бы десятки запросов.
	// Год перекрывает любой разумный срок между документом и его отправкой.
	Если КонецПериода - НачалоПериода > 365 * 86400 Тогда
		НачалоПериода = КонецПериода - 365 * 86400;
	КонецЕсли;

	ИскомыйНомер = ВРег(СокрЛП(Номер));
	ИскомаяДата = НачалоДня(ДатаДокумента);
	Результат.Опрошено = Истина;

	// Оператор отдает не дальше 1000 карточек на запрос ((page + 1) * page_size <= 1000, иначе HTTP 400), поэтому
	// окно читается одной страницей на 1000; полная страница - окно делится на недели, неделя - на дни.
	РазмерСтраницы = 1000;
	ШириныОкон = Новый Массив;
	ШириныОкон.Добавить(30 * 86400);
	ШириныОкон.Добавить(6 * 86400);
	ШириныОкон.Добавить(0);
	ОкнаЗапросов = Новый Массив;
	Курсор = НачалоПериода;
	Пока Курсор < КонецПериода Цикл
		ГраницаОкна = Мин(Курсор + ШириныОкон[0], КонецПериода);
		ОкнаЗапросов.Добавить(Новый Структура("Начало, Конец, Уровень", Курсор, ГраницаОкна, 0));
		Курсор = ГраницаОкна + 86400;
	КонецЦикла;

	ИндексОкна = 0;
	Пока ИндексОкна < ОкнаЗапросов.Количество() Цикл
		ОкноЗапроса = ОкнаЗапросов[ИндексОкна];
		ИндексОкна = ИндексОкна + 1;
		Путь = ПутьСервиса("document") + "/public/api/v3/documents"
			+ "?created_from=" + Формат(ОкноЗапроса.Начало, "ДФ=yyyy-MM-dd") + "T00:00:00Z"
			+ "&created_till=" + Формат(ОкноЗапроса.Конец, "ДФ=yyyy-MM-dd") + "T23:59:59Z"
			+ "&sender_id=" + НашГид + "&recipient_id=" + СокрЛП(ГидПолучателя)
			+ "&page=0&page_size=" + Формат(РазмерСтраницы, "ЧГ=0");

		Тело = "";
		ОкноВзято = Ложь;
		Для НомерПопытки = 1 По 3 Цикл
			Попытка
				Ответ = Соединение.Получить(Новый HTTPЗапрос(Путь, Заголовки));
			Исключение
 // Пауза обязательна: у оператора бывают эпизоды, когда метод не отвечает больше 10 с,
 // а следующий запрос проходит мгновенно; попытки вплотную попадают в один эпизод.
				Результат.Причина = "нет ответа: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				ЖдатьПередПовтором(НомерПопытки);
				Продолжить;
			КонецПопытки;
			Если Ответ.КодСостояния = 200 Тогда
				Тело = Ответ.ПолучитьТелоКакСтроку("UTF-8");
				ОкноВзято = Истина;
				Прервать;
			ИначеЕсли Ответ.КодСостояния = 401 Тогда
				ОбеспечитьТокен(Истина, Организация);
				Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));
			Иначе
				Результат.Причина = "HTTP " + Ответ.КодСостояния + " "
					+ Лев(Ответ.ПолучитьТелоКакСтроку("UTF-8"), 200);
 // 4xx (кроме 401) - отказ по существу запроса, а не сбой связи: повтор
 // вернёт ровно то же и только съест время.
				Если Ответ.КодСостояния >= 400 И Ответ.КодСостояния < 500
					И Ответ.КодСостояния <> 429 Тогда
					Прервать;
				КонецЕсли;
				ЖдатьПередПовтором(НомерПопытки);
			КонецЕсли;
		КонецЦикла;

		Если НЕ ОкноВзято Тогда
			Результат.Опрошено = Ложь;
			Возврат Результат;
		КонецЕсли;

		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Тело);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Если ТипЗнч(Данные) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Если Данные.Количество() < РазмерСтраницы Тогда
			НакопитьКарточки(Данные, ИскомыйНомер, ?(СверятьДату, ИскомаяДата, '00010101'), Результат.Карточки);
			Продолжить;
		КонецЕсли;
		// Полная страница - карточки за окном могли не войти: окно делим и читаем заново, эту страницу не берем.
		Если ОкноЗапроса.Уровень = ШириныОкон.ВГраница() Тогда
			Результат.Опрошено = Ложь;
			Результат.Причина = "больше " + Формат(РазмерСтраницы, "ЧГ=0") + " карточек за день "
				+ Формат(ОкноЗапроса.Начало, "ДФ=dd.MM.yyyy");
			Возврат Результат;
		КонецЕсли;
		УровеньЧасти = ОкноЗапроса.Уровень + 1;
		ПозицияЧасти = ИндексОкна;
		Курсор = ОкноЗапроса.Начало;
		Пока НачалоДня(Курсор) <= НачалоДня(ОкноЗапроса.Конец) Цикл
			ГраницаОкна = Мин(Курсор + ШириныОкон[УровеньЧасти], ОкноЗапроса.Конец);
			ОкнаЗапросов.Вставить(ПозицияЧасти, Новый Структура("Начало, Конец, Уровень", Курсор, ГраницаОкна, УровеньЧасти));
			ПозицияЧасти = ПозицияЧасти + 1;
			Курсор = ГраницаОкна + 86400;
		КонецЦикла;
	КонецЦикла;

	Результат.Причина = "";
	Возврат Результат;

КонецФункции

// Отобрать из ответа карточки нужного документа и сложить в накопитель.
// Пустая ИскомаяДата - сверка только по номеру.
Процедура НакопитьКарточки(Знач Данные, Знач ИскомыйНомер, Знач ИскомаяДата, Карточки)

	Для Каждого Карточка Из Данные Цикл
		Счёт = Карточка["invoice"];
		Если ТипЗнч(Счёт) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Если ВРег(СокрЛП(Строка(Счёт["num"]))) <> ИскомыйНомер Тогда
			Продолжить;
		КонецЕсли;
 // Дата в карточке сверяется с допуском в сутки: XML собирается по UTC, и документ, оформленный
 // ночью, уезжает на сутки назад. Номер сверяем точно: в окне поиска он однозначен.
		ДатаКарточки = ДатаИзДДММГГГГ(Строка(Счёт["date"]));
		Если ЗначениеЗаполнено(ДатаКарточки) И ЗначениеЗаполнено(ИскомаяДата)
			И Макс(ДатаКарточки, ИскомаяДата) - Мин(ДатаКарточки, ИскомаяДата) > 86400 Тогда
			Продолжить;
		КонецЕсли;
		Состояние = "";
		Если ТипЗнч(Карточка["documentState"]) = Тип("Соответствие") Тогда
			Состояние = Строка(Карточка["documentState"]["state"]);
		КонецЕсли;
		Статус = Строка(?(Карточка["newStatus"] = Неопределено, Карточка["status"], Карточка["newStatus"]));
 // Ид приходит числом: Строка() форматирует его с разделителями разрядов, и по такому ид
 // карточку потом не найти.
		Карточки.Добавить(Новый Структура("Ид, Тип, Статус, Состояние, Живая, Создана",
			Формат(Карточка["id"], "ЧГ=0"), Строка(Карточка["type"]), Статус, Состояние, КарточкаЖивая(Статус, Состояние),
			ДатаИзМеткиВремени(Строка(Карточка["created"]))));
	КонецЦикла;

КонецПроцедуры

// Дата UTC из строки вида "2026-09-15T13:00:39.063804Z". Пустая дата, если разобрать не удалось.
Функция ДатаИзМеткиВремени(Знач Текст)

	Цифры = СтрЗаменить(СтрЗаменить(СтрЗаменить(Лев(СокрЛП(Текст), 19), "-", ""), ":", ""), "T", "");
	Если СтрДлина(Цифры) < 14 Тогда
		Возврат '00010101';   // ЩА 20.10.2026 [yan]: метки нет - не ошибка, перехват только на битый формат
	КонецЕсли;
	Попытка
		Возврат Дата(Цифры);
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ДатаИзМеткиВремени: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат '00010101';
	КонецПопытки;

КонецФункции

// Дата из строки вида "01.04.2026". Пустая дата, если разобрать не удалось.
Функция ДатаИзДДММГГГГ(Знач Текст)

	Части = СтрРазделить(СокрЛП(Текст), ".", Ложь);
	Если Части.Количество() <> 3 Тогда
		Возврат '00010101';
	КонецЕсли;
	Попытка
		Возврат Дата(Число(Части[2]), Число(Части[1]), Число(Части[0]));
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ДатаИзДДММГГГГ: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // ЩА 20.10.2026 [yan]: не маскировать
		Возврат '00010101';
	КонецПопытки;

КонецФункции

// Есть ли у оператора живой экземпляр этого документа с тем же получателем. Обертка над
// КарточкиДокументаУОператора: сама поднимает соединение, токен и адрес получателя.
// "Не опрошено" - не "дубля нет": при Опрошено = Ложь вызывающий решает сам, считать это
// разрешением на отправку нельзя. Прочие адреса контрагента - см. ЭкземплярНаПрежнемАдресе.
// Возврат: Структура (Опрошено, Причина, Найден Булево, Ид, Статус, Адрес,
// НаПрежнемАдресе - Структура(Ид, Статус, Адрес) или Неопределено).
Функция ЖивойЭкземплярУОператора(Ссылка) Экспорт

	Результат = Новый Структура("Опрошено, Причина, Найден, Ид, Статус, Адрес, НаПрежнемАдресе",
		Ложь, "", Ложь, "", "", "", Неопределено);

	ГидПолучателя = ИдентификаторУчастникаЭДО(Ссылка.Контрагент);
	Если НЕ ЗначениеЗаполнено(ГидПолучателя) Тогда
		Результат.Причина = "у контрагента нет идентификатора ЭДО";
		Возврат Результат;
	КонецЕсли;

	Организация = ОрганизацияДокумента(Ссылка);
	Если НЕ ОбеспечитьТокен(Ложь, Организация) Тогда
		Результат.Причина = "не удалось получить токен";
		Возврат Результат;
	КонецЕсли;
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + ТекущийТокен(Организация));

	// Таймаут короткий принципиально: удачный ответ приходит за доли секунды, а неудачный не приходит
	// вовсе, и лечит только повтор. Штатные 30 с дали бы до полутора минут на документ.
	Соединение = СоединениеСОператором(5);
	НашГид = ГидОрганизации(Организация);
	Опрос = КарточкиДокументаУОператора(Соединение, Заголовки, НашГид,
		ГидПолучателя, СокрЛП(Ссылка.Номер), Ссылка.Дата);
	Результат.Опрошено = Опрос.Опрошено;
	Результат.Причина = Опрос.Причина;
	Результат.Адрес = ВРег(СокрЛП(ГидПолучателя));

	// Неподписанный черновик NEW контрагенту не уходил: дублем он не бывает, а его идентификатор
	// в базе выдал бы документ за отправленный. Свежий черновик может быть отправкой, которая
	// еще идет, поэтому с ним решение откладывается до следующего прогона.
	СвежийЧерновик = "";
	Для Каждого Карточка Из Опрос.Карточки Цикл
		Если НЕ Карточка.Живая Тогда
			Продолжить;
		КонецЕсли;
		Если ВРег(СокрЛП(Карточка.Статус)) = "NEW" Тогда
			Если ЗначениеЗаполнено(Карточка.Создана)
				И ТекущаяУниверсальнаяДата() - Карточка.Создана < ВозрастБрошенногоЧерновика() Тогда
				СвежийЧерновик = Карточка.Ид;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Результат.Найден = Истина;
		Результат.Ид = Карточка.Ид;
		Результат.Статус = Карточка.Статус;
		Прервать;
	КонецЦикла;

	Если НЕ Результат.Найден И ЗначениеЗаполнено(СвежийЧерновик) Тогда
		Результат.Опрошено = Ложь;
		Результат.Причина = "у оператора неподписанный черновик " + СвежийЧерновик + " моложе часа";
	КонецЕсли;

	Если Результат.Опрошено И НЕ Результат.Найден Тогда
		Прежний = ЭкземплярНаПрежнемАдресе(Ссылка, Соединение, Заголовки, НашГид, Результат.Адрес);
		Если Прежний <> Неопределено И ВРег(Прежний.Статус) = "ACCEPTED" Тогда
			Результат.Найден = Истина;
			Результат.Ид = Прежний.Ид;
			Результат.Статус = Прежний.Статус;
			Результат.Адрес = Прежний.Адрес;
		КонецЕсли;
		Результат.НаПрежнемАдресе = Прежний;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Живой экземпляр документа на ДРУГОМ адресе контрагента: из реестра ФНС или фактического маршрута.
// Подписанный (ACCEPTED) экземпляр важнее неподписанного: он у контрагента действует,
// и повтор на новый адрес дал бы дубль. Неподписанный на брошенном ящике дублем не считается -
// переотправка на новый адрес как раз и чинит "ушло не в тот ящик".
// Сбой опроса прежнего адреса отправку не держит: текущий адрес уже проверен.
// Возврат: Структура(Ид, Статус, Адрес) или Неопределено.
Функция ЭкземплярНаПрежнемАдресе(Ссылка, Соединение, Заголовки, Знач НашГид, Знач ТекущийАдрес)

	Найденный = Неопределено;
	Для Каждого Адрес Из ПрочиеАдресаКонтрагента(Ссылка.Контрагент, ТекущийАдрес) Цикл
		Опрос = КарточкиДокументаУОператора(Соединение, Заголовки, НашГид, Адрес,
			СокрЛП(Ссылка.Номер), Ссылка.Дата);
		Если НЕ Опрос.Опрошено Тогда
			ЗаписьЖР("ЭДО.ПроверкаДубля", "Предупреждение", Ссылка.Метаданные(), Ссылка,
				"Не удалось проверить экземпляр на прежнем адресе " + Адрес + ": " + Опрос.Причина);
			Продолжить;
		КонецЕсли;
		Для Каждого Карточка Из Опрос.Карточки Цикл
			Статус = ВРег(СокрЛП(Карточка.Статус));
			Если НЕ Карточка.Живая ИЛИ Статус = "NEW" Тогда
				Продолжить;
			КонецЕсли;
			Если Найденный = Неопределено ИЛИ Статус = "ACCEPTED" Тогда
				Найденный = Новый Структура("Ид, Статус, Адрес", Карточка.Ид, Статус, Адрес);
			КонецЕсли;
			Если Статус = "ACCEPTED" Тогда
				Возврат Найденный;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Найденный;

КонецФункции

// Адреса контрагента, кроме текущего и наших собственных, в верхнем регистре без повторов.
Функция ПрочиеАдресаКонтрагента(Знач Контрагент, Знач ТекущийАдрес)

	Адреса = Новый Массив;
	ИНН = СокрЛП(Строка(Контрагент.ИНН));
	Если НЕ ЗначениеЗаполнено(ИНН) Тогда
		Возврат Адреса;
	КонецЕсли;

	Кандидаты = Новый Массив;
	Реестр = ЗагрузитьРеестрАдресов();
	ЗаписьРеестра = Реестр[ИНН];
	Если ТипЗнч(ЗаписьРеестра) = Тип("Структура") И ЗаписьРеестра.Свойство("Адреса") Тогда
		Для Каждого Адрес Из ЗаписьРеестра.Адреса Цикл
			Кандидаты.Добавить(Адрес);
		КонецЦикла;
	КонецЕсли;
	Кандидаты.Добавить(ФактическийМаршрут(ИНН));

	Для Каждого Кандидат Из Кандидаты Цикл
		Адрес = ВРег(СокрЛП(Кандидат));
		Если НЕ ЗначениеЗаполнено(Адрес) ИЛИ Адрес = ВРег(СокрЛП(ТекущийАдрес))
			ИЛИ Адреса.Найти(Адрес) <> Неопределено ИЛИ АдресЭДОНаш(Адрес) Тогда
			Продолжить;
		КонецЕсли;
		Адреса.Добавить(Адрес);
	КонецЦикла;

	Возврат Адреса;

КонецФункции

// Сколько секунд черновик NEW может быть отправкой в работе. Дольше - брошен.
Функция ВозрастБрошенногоЧерновика() Экспорт
	Возврат 3600;
КонецФункции

// ++ ЩА 20.10.2026 [yan]: код 20 - документ создан у оператора (черновик NEW), подпись не дошла.
// Раньше такой документ навсегда оставался «Отправляется»: очередь документы с идентификатором
// не берет, сторож брошенных отметок разбирал только код 10.

// Поле карточки оператора: карточка приходит то Структурой (ПрочитатьJSON без соответствия),
// то Соответствием. Неопределено, если поля нет.
Функция ПолеКарточкиОператора(Знач Узел, Знач Имя) Экспорт
	Значение = Неопределено;
	Если ТипЗнч(Узел) = Тип("Структура") Тогда
		Узел.Свойство(Имя, Значение);
	ИначеЕсли ТипЗнч(Узел) = Тип("Соответствие") Тогда
		Значение = Узел.Получить(Имя);
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Сколько раз сторож уже снимал брошенный черновик документа. Подпись, которую оператор стабильно не принимает
// (МЧД, подписант), иначе давала бы новый черновик каждый час. Учет - в настройке базы, записи старше 7 дней
// забываются.
Функция ЧерновикОсвобождалсяРаз(Знач Ссылка) Экспорт
	Запись = ОсвобожденияЧерновиков().Получить(Строка(Ссылка.УникальныйИдентификатор()));
	Если ТипЗнч(Запись) <> Тип("Структура") ИЛИ Запись.Когда < ТекущаяДатаСеанса() - 7 * 86400 Тогда
		Возврат 0;   // срок учета истек - автоматика снова может снять черновик
	КонецЕсли;
	Возврат Запись.Раз;
КонецФункции

// Позиция кругового обхода кода 20 сторожем брошенных отметок.
Процедура ЗапомнитьПозициюОбходаКода20(Знач Ид) Экспорт
	ЗаписатьОбщуюНастройкуЭДО("Код20_ОбходПосле", Лев(СокрЛП(Строка(Ид)), 50));
КонецПроцедуры

Функция ОсвобожденияЧерновиков()
	Значение = НастройкаЭДО("ОсвобожденияЧерновиков");
	Возврат ?(ТипЗнч(Значение) = Тип("Соответствие"), Значение, Новый Соответствие);
КонецФункции

Процедура ЗапомнитьОсвобождениеЧерновика(Знач Ссылка)
	Учет = ОсвобожденияЧерновиков();
	Граница = ТекущаяДатаСеанса() - 7 * 86400;
	Устаревшие = Новый Массив;
	Для Каждого Пара Из Учет Цикл
		Если ТипЗнч(Пара.Значение) <> Тип("Структура") ИЛИ Пара.Значение.Когда < Граница Тогда
			Устаревшие.Добавить(Пара.Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Ключ Из Устаревшие Цикл
		Учет.Удалить(Ключ);
	КонецЦикла;
	Ключ = Строка(Ссылка.УникальныйИдентификатор());
	Прежняя = Учет.Получить(Ключ);
	Учет.Вставить(Ключ, Новый Структура("Раз, Когда", ?(ТипЗнч(Прежняя) = Тип("Структура"), Прежняя.Раз, 0) + 1, ТекущаяДатаСеанса()));
	ЗаписатьОбщуюНастройкуЭДО("ОсвобожденияЧерновиков", Учет);
КонецПроцедуры

// Текст колонки «ЭДО» для документа, у которого у оператора остался неподписанный черновик.
Функция ТекстНеПодписан() Экспорт
	Возврат "Не подписан - отправка не прошла";
КонецФункции

// Текст колонки, когда черновик снимали уже дважды, а подпись так и не принимается.
Функция ТекстНеПодписанПовторно() Экспорт
	Возврат "Не подписан повторно - нужен разбор подписи";
КонецФункции

// Текст колонки, когда черновик с кодом 20 удален у оператора: удалить мог человек, чтобы документ не ушел.
Функция ТекстЧерновикУдаленУОператора() Экспорт
	Возврат "Черновик удален у оператора - решает человек";
КонецФункции

// Текст колонки для карточки оператора: NEW старше ВозрастБрошенногоЧерновика - не «Отправляется»,
// а неподписанный черновик. Создан - строка created карточки (UTC).
Функция ТекстКолонкиЧерновика(Знач Текст, Знач СтатусAPI, Знач Создан) Экспорт
	Если ВРег(СокрЛП(Строка(СтатусAPI))) <> "NEW" Тогда
		Возврат Текст;
	КонецЕсли;
	Дата = ДатаИзМеткиВремени(Строка(Создан));
	Если НЕ ЗначениеЗаполнено(Дата) ИЛИ ТекущаяУниверсальнаяДата() - Дата < ВозрастБрошенногоЧерновика() Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат ТекстНеПодписан();
КонецФункции

// Карточка оператора по идентификатору: Структура (Опрошено, Найдена, Статус, Код).
// Опрошено = Ложь - оператор ответил не 200 (код - в Код), решать по ней нельзя. Сбой связи или
// токена не перехватывается: вызывающий получает исключение и пишет его как есть.
Функция КарточкаОператораПоИд(Знач ИдДокумента, Знач Организация) Экспорт
	Итог = Новый Структура("Опрошено, Найдена, Статус, Создана, Код, ИмяФайла", Ложь, Ложь, "", '00010101', 0, "");
	Ответ = ЗапросКОператоруЭДО("GET", "/public/api/v3/documents?id=" + СокрЛП(ИдДокумента), , Организация);
	Итог.Код = Ответ.Код;
	Если Ответ.Код <> 200 Тогда
		Возврат Итог;
	КонецЕсли;
	Карточки = ПрочитатьОтветJSON(Ответ.Текст);
	Если ТипЗнч(Карточки) <> Тип("Массив") Тогда
		Возврат Итог;
	КонецЕсли;
	Итог.Опрошено = Истина;
	Если Карточки.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;
	Итог.Найдена = Истина;
	Итог.Статус = СтатусКарточкиОператора(Карточки[0]);
	Итог.Создана = ДатаИзМеткиВремени(Строка(ПолеКарточкиОператора(Карточки[0], "created")));
	Итог.ИмяФайла = СокрЛП(Строка(ПолеКарточкиОператора(Карточки[0], "fileId")));   // ЩА 20.10.2026 [yan]: номер в ЧЗ
	Возврат Итог;
КонецФункции

// Вернуть документ с брошенным черновиком в очередь: снять код 20 и идентификатор, если они
// все еще те же (под блокировкой). Черновик NEW у оператора дублем не считается
// (ЖивойЭкземплярУОператора), поэтому следующая отправка создаст и подпишет новый.
// Возврат: Истина - снято.
Функция ОсвободитьНеподписанныйЧерновик(Ссылка, Знач ИдДокумента) Экспорт
	СвойствоСтатус = СвойствоОбъектов("ЭДО_КодСостояния");
	СвойствоИд = СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если СвойствоСтатус = Неопределено ИЛИ СвойствоСтатус.Пустая()
		ИЛИ СвойствоИд = Неопределено ИЛИ СвойствоИд.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	Снято = Ложь;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.ЗначенияСвойствОбъектов");
		Элемент.УстановитьЗначение("Объект", Ссылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		Код = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Ссылка, СвойствоСтатус)));
		Ид = СокрЛП(Строка(ЗначениеСвойстваОбъекта(Ссылка, СвойствоИд)));
		Если Код = "20" И Ид = СокрЛП(ИдДокумента) Тогда
			Снимаемые = Новый Массив;
			Снимаемые.Добавить(СвойствоСтатус);
			Снимаемые.Добавить(СвойствоИд);
			Для Каждого Свойство Из Снимаемые Цикл
				Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
				Набор.Отбор.Объект.Установить(Ссылка);
				Набор.Отбор.Свойство.Установить(Свойство);
				Набор.Записать(Истина);
			КонецЦикла;
			Снято = Истина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Если Снято Тогда
		ЗапомнитьОсвобождениеЧерновика(Ссылка);
		ЗаписьЖурналаРегистрации("ЭДО.Отправка", УровеньЖурналаРегистрации.Предупреждение, , Ссылка,
			"Неподписанный черновик у оператора (id " + ИдДокумента + ") брошен: код 20 и идентификатор сняты,"
			+ " документ вернется в очередь");
	КонецЕсли;
	Возврат Снято;
КонецФункции
