// Пауза перед повторной попыткой: 2 с после первой, 5 с после второй. Активным циклом:
// штатного ПриостановитьВыполнение в этой платформе нет; путь редкий, цена приемлема.
Процедура ЖдатьПередПовтором(Знач НомерПопытки)

	Если НомерПопытки >= 3 Тогда
		Возврат;
	КонецЕсли;
	Ждать = ?(НомерПопытки = 1, 2, 5);
	Конец = ТекущаяУниверсальнаяДатаВМиллисекундах() + Ждать * 1000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Конец Цикл
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПриглашенияЭДО

// Почему приглашение на адрес отправлять нельзя; "" - можно.
// Одна проверка на все места, откуда уходит приглашение: регламент и формы обработки вендора.
// Внутри Платформы роуминговой связи не бывает, обмен идет напрямую. На живую связь
// (ESTABLISHED, DIRECT) повторное приглашение ее рвет, у КОРУС безвозвратно.
//
// Параметры:
// НашГид - Строка: идентификатор отправителя приглашения.
// Адрес - Строка: идентификатор получателя.
// Связи - Соответствие из СтатусыСвязейПолно; не передано - связь спрашивается у оператора здесь.
Функция ПричинаЗапретаПриглашения(Знач НашГид, Знач Адрес, Знач Связи = Неопределено) Экспорт

	Адрес = СокрЛП(Адрес);
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат "не указан адрес получателя";
	КонецЕсли;
	Если АдресЭДОНаш(Адрес) Тогда
		Возврат "это наш собственный адрес";
	КонецЕсли;
	Если АдресВнутриПлатформы(НашГид, Адрес) Тогда
		Возврат "адрес внутри Платформы ЭДО (" + ВРег(Лев(Адрес, 3)) + "): связь там не заводится,"
			+ " документы уходят напрямую, приглашение не нужно";
	КонецЕсли;

	Если Связи = Неопределено Тогда
		Связи = СвязиДляПроверкиПриглашения(НашГид, Адрес);
		Если Связи = Неопределено Тогда
			Возврат "не удалось проверить у оператора связь с адресом, без проверки приглашение не отправляется";
		КонецЕсли;
	КонецЕсли;

	СостояниеАдреса = СостояниеСвязи(Связи, Адрес);
	Если СостояниеАдреса = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Статус = ВРег(СокрЛП(СостояниеАдреса.Статус));
	Если Статус = "ESTABLISHED" Тогда
		Возврат "связь с адресом уже установлена (ESTABLISHED), повторное приглашение ее разорвет";
	КонецЕсли;
	Если Статус = "DIRECT" Тогда
		Возврат "обмен с адресом идет напрямую (DIRECT), приглашение не нужно";
	КонецЕсли;

	Возврат "";

КонецФункции

// Адрес у того же оператора, что и мы (у Платформы ЭДО код 2VO).
Функция АдресВнутриПлатформы(Знач НашГид, Знач Адрес)

	Префикс = ВРег(Лев(СокрЛП(Адрес), 3));
	НашПрефикс = ВРег(Лев(СокрЛП(НашГид), 3));
	Возврат Префикс = "2VO" ИЛИ (СтрДлина(НашПрефикс) = 3 И Префикс = НашПрефикс);

КонецФункции

// Связи одного адреса для проверки приглашения. Неопределено - оператор не ответил.
Функция СвязиДляПроверкиПриглашения(Знач НашГид, Знач Адрес)

	Попытка
		Организация = ОрганизацияПоИдентификаторуЭДО(НашГид);
		Если НЕ ОбеспечитьТокен(Истина, Организация) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Адреса = Новый Массив;
		Адреса.Добавить(Адрес);
		Обход = СтатусыСвязейПолно(СоединениеСОператором(20), ЗаголовкиАвторизацииЭДО(Организация),
			СокрЛП(НашГид), Адреса);
	Исключение
		ЗаписьЖР("ЭДО.Приглашения", "Ошибка", , , ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Возврат ?(Обход.Неудач > 0, Неопределено, Обход.Связи);

КонецФункции

// Рассылка приглашений по списку адресов - единственный законный путь звать контрагентов.
// Проверка связи живет здесь, рядом с опросом связей, и обходиться не должна: приглашение туда,
// где связь есть, рвет ее (у КОРУС (2BK) - необратимо). Неудачу опроса нельзя читать как
// "связей нет", адрес сравнивать без учета регистра, а код 204 не значит успех - отказ приходит
// асинхронно. Прогон отменяется целиком, если опрошены не все адреса.
//
// Параметры:
// Адреса - Массив строк (gid контрагентов), кого предполагается позвать.
// ТолькоПроверка - Булево: не слать ничего, вернуть список тех, кого позвали бы.
// Возврат: Структура (Отменено, Причина, Приглашено, Пропущено, Ошибок, Цели Массив, Отказы Массив).
Функция ПригласитьПоАдресам(Соединение, Заголовки, Знач НашГид, Знач Адреса,
	Знач ТолькоПроверка = Ложь) Экспорт

	Свод = Новый Структура("Отменено, Причина, Приглашено, Пропущено, Ошибок, Цели, Отказы",
		Ложь, "", 0, 0, 0, Новый Массив, Новый Массив);

	Если Адреса.Количество() = 0 Тогда
		Возврат Свод;
	КонецЕсли;

	Обход = СтатусыСвязейПолно(Соединение, Заголовки, НашГид, Адреса);
	Если Обход.Неудач > 0 Тогда
		Свод.Отменено = Истина;
		Свод.Причина = "не удалось опросить связи по " + Обход.Неудач + " адресам из "
			+ Адреса.Количество() + ", не приглашён никто" + ОтказыОбходаСтрокой(Обход);
		Возврат Свод;
	КонецЕсли;

	Для Каждого Адрес Из Адреса Цикл
		Если НЕ ЗначениеЗаполнено(Адрес) Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(ПричинаЗапретаПриглашения(НашГид, Адрес, Обход.Связи)) Тогда
			Свод.Пропущено = Свод.Пропущено + 1;
			Продолжить;
		КонецЕсли;

 // Звать можно только туда, где связи нет вовсе или она снята оператором (NO_CONTACT). У живой
 // связи повтор ее рвет, у ждущей не двигает статус, у порванной только переставляет метку разрыва.
		Состояние = СостояниеСвязи(Обход.Связи, Адрес);
		Если Состояние <> Неопределено И ВРег(СокрЛП(Состояние.Статус)) <> "NO_CONTACT" Тогда
			Свод.Пропущено = Свод.Пропущено + 1;
			Продолжить;
		КонецЕсли;

		Свод.Цели.Добавить(Адрес);
		Если ТолькоПроверка Тогда
			Продолжить;
		КонецЕсли;

		Запрос = Новый HTTPЗапрос(ПутьСервиса("subscriber") + "/public/api/v3/subscribers/" + НашГид
			+ "/invitations/" + Адрес + "?type=REQUEST", Заголовки);
		Запрос.УстановитьТелоИзСтроки("{}");
		Попытка
			Ответ = Соединение.ВызватьHTTPМетод("PUT", Запрос);
		Исключение
			Свод.Ошибок = Свод.Ошибок + 1;
			Свод.Отказы.Добавить(Адрес + ": исключение " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		Если Ответ.КодСостояния = 204 ИЛИ Ответ.КодСостояния = 200 Тогда
			Свод.Приглашено = Свод.Приглашено + 1;
		Иначе
			Свод.Ошибок = Свод.Ошибок + 1;
			Свод.Отказы.Добавить(Адрес + ": HTTP " + Ответ.КодСостояния + " "
				+ Лев(Ответ.ПолучитьТелоКакСтроку("UTF-8"), 200));
		КонецЕсли;
	КонецЦикла;

	Возврат Свод;

КонецФункции

// Приглашения новым контрагентам: тем, кому есть что отправлять, а адреса ЭДО нет
// и документы им раньше не уходили. Зовем на все адреса из реестра ФНС, кроме каналов
// вне автовыбора; рабочим станет тот, где примут первым, - его запишет регламент связей.
// Адрес, куда приглашение уже уходило, повторно не зовется.
//
// Параметры:
// ТолькоПроверка - Булево: не слать ничего, показать, кого позвали бы.
// МаксКонтрагентов - Число: сколько контрагентов звать за прогон, 0 - без ограничения.
// Возврат: Строка - свод прогона.
Функция ПригласитьНовыхКонтрагентов(Знач ТолькоПроверка = Ложь, Знач МаксКонтрагентов = 50) Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Лог = Новый Массив;
	Счет = Новый Структура("Кандидатов, СИсторией, Свои, БезАдресов, ЗвалиРанее, Контрагентов",
		0, 0, 0, 0, 0, 0);
	Заголовок = "ЭДО, приглашения новым контрагентам" + ?(ТолькоПроверка, " (проверка)", "");

	СвойствоАдреса = СвойствоОбъектов("ЭДО_АдресКонтрагента");
	Если СвойствоАдреса = Неопределено ИЛИ СвойствоАдреса.Пустая() Тогда
		Возврат Заголовок + ": ОШИБКА - не найдено свойство ЭДО_АдресКонтрагента";
	КонецЕсли;
	СвойствоСостояния = СвойствоОбъектов("ЭДО_Состояние");
	Если СвойствоСостояния = Неопределено Тогда
		СвойствоСостояния = ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка();
	КонецЕсли;

	Организации = ОрганизацииСРазрешеннойОтправкой();
	Если Организации.Количество() = 0 Тогда
		Возврат Заголовок + ": нет организаций с разрешенной отправкой";
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	РТУ.Контрагент КАК Контрагент,
		|	РТУ.Контрагент.ИНН КАК ИНН,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РТУ.Ссылка) КАК Документов
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РТУ
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Адрес
		|		ПО ВЫРАЗИТЬ(Адрес.Объект КАК Справочник.Контрагенты) = РТУ.Контрагент
		|			И Адрес.Свойство = &СвойствоАдреса
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК НеТребуется
		|		ПО ВЫРАЗИТЬ(НеТребуется.Объект КАК Документ.РеализацияТоваровУслуг) = РТУ.Ссылка
		|			И НеТребуется.Свойство = &СвойствоСостояния
		|			И ВЫРАЗИТЬ(НеТребуется.Значение КАК СТРОКА(50)) = &ТекстНеТребуется
		|ГДЕ
		|	РТУ.Проведен
		|	И РТУ.ОтражатьВБухгалтерскомУчете
		|	И РТУ.Дата >= &Дата
		|	И РТУ.Организация В (&Организации)
		|	И НЕ РТУ.Контрагент.ПометкаУдаления
		|	И НЕ ПОДСТРОКА(РТУ.Контрагент.ИНН, 1, 1) = """"
		|	И (Адрес.Значение ЕСТЬ NULL
		|		ИЛИ ВЫРАЗИТЬ(Адрес.Значение КАК СТРОКА(50)) = """")
		|	И НеТребуется.Объект ЕСТЬ NULL
		|СГРУППИРОВАТЬ ПО
		|	РТУ.Контрагент,
		|	РТУ.Контрагент.ИНН
		|УПОРЯДОЧИТЬ ПО
		|	Документов УБЫВ");
	Запрос.УстановитьПараметр("СвойствоАдреса", СвойствоАдреса);
	Запрос.УстановитьПараметр("СвойствоСостояния", СвойствоСостояния);
	Запрос.УстановитьПараметр("ТекстНеТребуется", "Отправка не требуется");
	Запрос.УстановитьПараметр("Дата", НижняяГраницаОтбора());
	Запрос.УстановитьПараметр("Организации", Организации);
	Кандидаты = Запрос.Выполнить().Выгрузить();
	Счет.Кандидатов = Кандидаты.Количество();

	СвоиИНН = Новый Соответствие;
	Для Каждого Запись Из УчетныеЗаписиЭДО() Цикл
		СвоиИНН.Вставить(СокрЛП(Запись.Организация.ИНН), Истина);
	КонецЦикла;
	Реестр = ЗагрузитьРеестрАдресов();
	Маршруты = ЗагрузитьФактическиеМаршруты();

	// Адрес -> контрагент, чтобы в своде было видно, кого позвали.
	КонтрагентАдреса = Новый Соответствие;
	Адреса = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		ИНН = СокрЛП(Кандидат.ИНН);
		Если СвоиИНН[ИНН] <> Неопределено Тогда
			Счет.Свои = Счет.Свои + 1;
			Продолжить;
		КонецЕсли;
		Если Маршруты[ИНН] <> Неопределено Тогда
			Счет.СИсторией = Счет.СИсторией + 1;
			Продолжить;
		КонецЕсли;

		ЗаписьРеестра = Реестр[ИНН];
		АдресовКонтрагента = 0;
		Если ЗаписьРеестра <> Неопределено Тогда
			Для Каждого АдресРеестра Из ЗаписьРеестра.Адреса Цикл
				АдресСтрокой = СокрЛП(АдресРеестра);
				Если АдресЭДОВнеАвтовыбора(АдресСтрокой) ИЛИ АдресЭДОНаш(АдресСтрокой)
					ИЛИ КонтрагентАдреса[ВРег(АдресСтрокой)] <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				КонтрагентАдреса.Вставить(ВРег(АдресСтрокой), Кандидат.Контрагент);
				Адреса.Добавить(АдресСтрокой);
				АдресовКонтрагента = АдресовКонтрагента + 1;
			КонецЦикла;
		КонецЕсли;
		Если АдресовКонтрагента = 0 Тогда
			Счет.БезАдресов = Счет.БезАдресов + 1;
		КонецЕсли;
	КонецЦикла;

	Если Адреса.Количество() = 0 Тогда
		Возврат СводПриглашенийНовым(Заголовок, Счет, Новый Структура("Приглашено, Ошибок", 0, 0), Начало, Лог);
	КонецЕсли;

	// Связь, адрес и пауза хранятся у контрагента, поэтому зовем от первой учетной записи,
	// как и регламент связей.
	ОрганизацияСвязей = Неопределено;
	Если НесколькоУчетныхЗаписейЭДО() Тогда
		ОрганизацияСвязей = УчетныеЗаписиЭДО()[0].Организация;
	КонецЕсли;
	НашГид = ГидОрганизации(ОрганизацияСвязей);
	Если НЕ ЗначениеЗаполнено(НашГид) Тогда
		Возврат Заголовок + ": ОШИБКА - не определен идентификатор своей организации";
	КонецЕсли;
	Если НЕ ОбеспечитьТокен(Истина, ОрганизацияСвязей) Тогда
		Возврат Заголовок + ": ОШИБКА - не удалось получить токен авторизации";
	КонецЕсли;
	Соединение = HTTPСоединениеЭДО();
	Заголовки = ЗаголовкиАвторизацииЭДО(ОрганизацияСвязей);

	// Звали ли раньше. Без ответа оператора адрес пропускаем: лишнее приглашение
	// хуже пропущенного часа.
	Истории = СтатусыПриглашений(Соединение, Заголовки, НашГид, Адреса);
	Новые = Новый Массив;
	Приглашаемые = Новый Соответствие;
	Для Каждого АдресСтрокой Из Адреса Цикл
		История = Истории[ВРег(АдресСтрокой)];
		Если История = Неопределено ИЛИ ЗначениеЗаполнено(История.Ошибка)
			ИЛИ ЗначениеЗаполнено(История.Статус) Тогда
			Счет.ЗвалиРанее = Счет.ЗвалиРанее + 1;
			Продолжить;
		КонецЕсли;
		Контрагент = КонтрагентАдреса[ВРег(АдресСтрокой)];
		Если Приглашаемые[Контрагент] = Неопределено Тогда
			Если МаксКонтрагентов > 0 И Приглашаемые.Количество() >= МаксКонтрагентов Тогда
				Продолжить;
			КонецЕсли;
			Приглашаемые.Вставить(Контрагент, Истина);
		КонецЕсли;
		Новые.Добавить(АдресСтрокой);
	КонецЦикла;
	Счет.Контрагентов = Приглашаемые.Количество();

	Свод = ПригласитьПоАдресам(Соединение, Заголовки, НашГид, Новые, ТолькоПроверка);
	Если Свод.Отменено Тогда
		Возврат Заголовок + ": ПРОГОН ОТМЕНЕН - " + Свод.Причина;
	КонецЕсли;

	Для Каждого АдресСтрокой Из Свод.Цели Цикл
		Лог.Добавить("  " + СокрЛП(Строка(КонтрагентАдреса[ВРег(АдресСтрокой)])) + " -> "
			+ АдресСтрокой);
	КонецЦикла;
	Для Каждого Отказ Из Свод.Отказы Цикл
		Лог.Добавить("  ОТКАЗ " + Отказ);
	КонецЦикла;

	Возврат СводПриглашенийНовым(Заголовок, Счет, Свод, Начало, Лог);

КонецФункции

Функция СводПриглашенийНовым(Знач Заголовок, Знач Счет, Знач Свод, Знач Начало, Знач Лог)

	Секунд = Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000, 1);
	Итог = Заголовок + ": контрагентов без адреса " + Счет.Кандидатов
		+ ", с историей отправок " + Счет.СИсторией
		+ ", свои " + Счет.Свои
		+ ", нет адресов в реестре " + Счет.БезАдресов
		+ ", адресов звали ранее " + Счет.ЗвалиРанее
		+ ", зовем контрагентов " + Счет.Контрагентов
		+ ", приглашений " + Свод.Приглашено
		+ ", ошибок " + Свод.Ошибок
		+ "; " + Секунд + " c";
	Лог.Вставить(0, Итог);
	Возврат СтрСоединить(Лог, Символы.ПС);

КонецФункции

// Статусы приглашений по списку адресов - контроль после рассылки. Код ответа на приглашение
// ничего не доказывает: PUT отдает 204 сразу, а отказ приходит асинхронно примерно через минуту,
// поэтому опрашивать не раньше чем через минуту после рассылки.
// Возврат: Соответствие (адрес в ВРег -> Структура(Статус, Ошибка)).
Функция СтатусыПриглашений(Соединение, Заголовки, Знач НашГид, Знач Адреса) Экспорт

	Результат = Новый Соответствие;
	Запросов = 0;
	// Организацию определяет наш идентификатор: токен перевыпускается ее учетной записи.
	Организация = ОрганизацияПоИдентификаторуЭДО(НашГид);

	Для Каждого Адрес Из Адреса Цикл
		Если НЕ ЗначениеЗаполнено(Адрес) Тогда
			Продолжить;
		КонецЕсли;
		Запросов = ПеревыпуститьТокенЭДО(Запросов, Заголовки, Организация);
		Путь = ПутьСервиса("subscriber") + "/public/api/v3/subscribers/" + НашГид + "/invitations/" + Адрес;
		Попытка
			Ответ = Соединение.Получить(Новый HTTPЗапрос(Путь, Заголовки));
		Исключение
			Результат.Вставить(ВРег(СокрЛП(Адрес)),
				Новый Структура("Статус, Ошибка", "", ОписаниеОшибки()));
			Продолжить;
		КонецПопытки;
		Запросов = Запросов + 1;
		Если Ответ.КодСостояния <> 200 Тогда
			Результат.Вставить(ВРег(СокрЛП(Адрес)),
				Новый Структура("Статус, Ошибка", "", "HTTP " + Ответ.КодСостояния));
			Продолжить;
		КонецЕсли;
 // Оператор отдает массив приглашений (вся история по адресу), свежее - первым; текст отказа
 // лежит в error.originalMessage. Поэтому первое вхождение и есть последнее приглашение.
		Тело = Ответ.ПолучитьТелоКакСтроку("UTF-8");
		Результат.Вставить(ВРег(СокрЛП(Адрес)), Новый Структура("Статус, Ошибка",
			ЗначениеПоляJSON(Тело, "status"), ЗначениеПоляJSON(Тело, "originalMessage")));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Кэш состояний приглашений хранится ПО ОРГАНИЗАЦИИ (внешний Соответствие: ключ - гид нашей
// организации, значение - Соответствие(ключ ВРег(адрес), значение Структура(Состояние, Текст,
// ДатаПриглашения, ДатаОтвета, Обновлен))). Без этого в базе с несколькими организациями связь одной
// организации показывалась бы у другой. Ключ пустого пользователя в хранилище настроек -
// тот же прием, что у ЗагрузитьРеестрАдресов, чтобы кэш не зависел от того, чей сеанс делал
// обновление. Записи прежнего (безорганизационного) формата при чтении по организации не
// найдутся вовсе и будут просто проигнорированы как устаревшие.
Функция ЗагрузитьОбщийКэшПриглашений()
	// Общие настройки лежат под пользователем "": для обычного пользователя это чужой слот, без привилегий - «Нарушение прав доступа».
	УстановитьПривилегированныйРежим(Истина);

	Значение = ХранилищеОбщихНастроек.Загрузить("ЭДО_СостоянияПриглашений", "Адреса", , "");
	Если ТипЗнч(Значение) <> Тип("Соответствие") Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Читает форма центра управления ЭДО (страница "Приглашения") - без единого сетевого запроса,
// актуальность кэша поддерживает ОбновитьСостоянияПриглашений. Организация - тот же отбор,
// что у формы; Неопределено означает "организация по умолчанию" (см. ГидОрганизации).
Функция КэшСостоянийПриглашений(Знач Организация = Неопределено) Экспорт

	ГидОрг = ГидОрганизации(Организация);
	Если НЕ ЗначениеЗаполнено(ГидОрг) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	ПоОрганизации = ЗагрузитьОбщийКэшПриглашений()[ГидОрг];
	Если ТипЗнч(ПоОрганизации) <> Тип("Соответствие") Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	// Записи старше 180 дней при загрузке отбрасываются: статус мог давно смениться (контрагент
	// сменил оператора, роуминг переоформили), и держать его вечно значило бы выдавать
	// устаревшую картину за текущую.
	Граница = ТекущаяУниверсальнаяДата() - 180 * 86400;
	Очищенные = Новый Соответствие;
	Для Каждого КлючЗначение Из ПоОрганизации Цикл
		Попытка
			Если КлючЗначение.Значение.Обновлен >= Граница Тогда
				Очищенные.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("ЭДО.ПриглашениеСостояния", УровеньЖурналаРегистрации.Предупреждение, , ,
				"кэш состояний приглашений: пропущена нечитаемая запись - "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Возврат Очищенные;

КонецФункции

// Записывает кэш состояний ОДНОЙ организации, не трогая записи других организаций - иначе
// каждая запись стирала бы кэш всех остальных.
// ЩА 19.10.2026 [yan]: без Экспорт - пишет только ядро, с клиента кэш не подменить.
Процедура ЗаписатьКэшСостоянийПриглашений(Знач Кэш, Знач Организация = Неопределено)
	// Общие настройки лежат под пользователем "": для обычного пользователя это чужой слот, без привилегий - «Нарушение прав доступа».
	УстановитьПривилегированныйРежим(Истина);

	ГидОрг = ГидОрганизации(Организация);
	Если НЕ ЗначениеЗаполнено(ГидОрг) Тогда
		Возврат;
	КонецЕсли;

	ОбщийКэш = ЗагрузитьОбщийКэшПриглашений();
	ОбщийКэш.Вставить(ГидОрг, Кэш);
	ХранилищеОбщихНастроек.Сохранить("ЭДО_СостоянияПриглашений", "Адреса", ОбщийКэш,
		"кэш состояний приглашений", "");

КонецПроцедуры

// Сколько адресов опрашивать/приглашать за один вызов с формы - иначе вызов сервера
// обрывается по таймауту на середине списка (та же причина, что у МаксДокументовЗаРаз формы).
Функция МаксАдресовПриглашенийЗаРаз() Экспорт

	Возврат 300;

КонецФункции

// Состояния приглашений, в порядке отображения на форме (сверху то, что требует внимания
// меньше всего, снизу - "не звали" как повод позвать прямо со страницы). Экспортная, чтобы
// витрина строила по ней тот же порядок и не дублировала список у себя.
Функция СписокСостоянийПриглашений() Экспорт

	Имена = Новый Массив;
	Имена.Добавить("Связь есть");
	Имена.Добавить("Приглашение отправлено");
	Имена.Добавить("Ждем ответа оператора");
	Имена.Добавить("Отказ");
	Имена.Добавить("Не звали");

	Возврат Имена;

КонецФункции

// Классификация ответа Платформы по приглашению. Статус и текст ошибки - как их возвращает
// СтатусыПриглашений (последнее приглашение по адресу).
//
// Оператор Платформы на приглашение к абоненту, с которым роуминг УЖЕ настроен, отвечает
// статусом FAILED с текстом вида "Для абонентов с ид ... уже настроен активный маршрут". Это НЕ
// отказ: связь есть и документы пойдут, поэтому такой FAILED приравниваем к "Связь есть",
// а не к "Отказ" - иначе форма показывала бы живых контрагентов как отказавшихся.
// Проверено на бою 25.09.2026: у 452 из 1774 контрагентов такой ответ, и прямой опрос связей
// (contacts) по ним дает ESTABLISHED. Без этой проверки история легко потеряется - через
// полгода правило "FAILED бывает успехом" никто не восстановит по коду без комментария.
Функция СостояниеПриглашенияПоОтвету(Знач Статус, Знач ТекстОшибки) Экспорт

	СтатусВРег = ВРег(СокрЛП(Статус));

	Если СтатусВРег = "FAILED"
		И СтрНайти(ВРег(СокрЛП(ТекстОшибки)), ВРег("уже настроен активный маршрут")) > 0 Тогда
		Возврат "Связь есть";
	КонецЕсли;

	Если СтатусВРег = "FAILED" ИЛИ СтатусВРег = "REJECTED" Тогда
		Возврат "Отказ";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СтатусВРег) Тогда
		// PUT отдает 204 сразу и уходит в SENDING, а сам итог (в т.ч. отказ) приходит
		// асинхронно примерно через минуту - до этого статус приглашения у оператора пуст.
		Возврат "Ждем ответа оператора";
	КонецЕсли;

	Возврат "Приглашение отправлено";

КонецФункции

// Обновить состояния приглашений по списку адресов (без Адресов - по всем, что уже есть
// в кэше) и записать свод в кэш. Сеть здесь ЕСТЬ - вызывается только по кнопке формы,
// никогда при открытии страницы.
//
// Связь (contacts) важнее ответа на само приглашение: если оператор уже показывает
// ESTABLISHED/DIRECT, это "Связь есть" независимо от того, что записано в истории
// приглашений - в т.ч. когда истории вовсе нет (адрес пришел из реестра ФНС, а контрагент
// подключился сам, без нашего приглашения).
// Возврат: Строка - свод прогона (сколько адресов опрошено, по состояниям, сколько осталось).
Функция ОбновитьСостоянияПриглашений(Знач Адреса, Знач Организация = Неопределено) Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Кэш = КэшСостоянийПриглашений(Организация);

	Если Адреса = Неопределено ИЛИ Адреса.Количество() = 0 Тогда
		Адреса = Новый Массив;
		Для Каждого КлючЗначение Из Кэш Цикл
			Адреса.Добавить(КлючЗначение.Ключ);
		КонецЦикла;
	КонецЕсли;

	Уникальные = Новый Соответствие;
	Для Каждого Адрес Из Адреса Цикл
		Если ЗначениеЗаполнено(Адрес) Тогда
			Уникальные.Вставить(ВРег(СокрЛП(Адрес)), Истина);
		КонецЕсли;
	КонецЦикла;
	Список = Новый Массив;
	Для Каждого КлючЗначение Из Уникальные Цикл
		Список.Добавить(КлючЗначение.Ключ);
	КонецЦикла;

	Если Список.Количество() = 0 Тогда
		Возврат "Обновление состояний приглашений: адресов для опроса нет";
	КонецЕсли;

	// Порция берется из тех, кого ЕЩЕ НЕ опрашивали: иначе повторное нажатие кнопки крутит
	// одни и те же первые адреса, и до хвоста списка дело не доходит никогда (так и вышло
	// 25.09.2026 на 1 774 адресах: пять вызовов подряд дали один и тот же свод).
	// Свежесть считаем по отметке Обновлен: сутки - срок, за который состояние приглашения
	// не успевает измениться дважды.
	ГраницаСвежести = ТекущаяУниверсальнаяДата() - 86400;
	Неопрошенные = Новый Массив;
	Для Каждого Адрес Из Список Цикл
		ИзКэша = Кэш[Адрес];
		Если ИзКэша <> Неопределено Тогда
			Отметка = Неопределено;
			ИзКэша.Свойство("Обновлен", Отметка);
			Если ЗначениеЗаполнено(Отметка) И Отметка >= ГраницаСвежести Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Неопрошенные.Добавить(Адрес);
	КонецЦикла;

	Если Неопрошенные.Количество() = 0 Тогда
		Возврат "Обновление состояний приглашений: все " + Формат(Список.Количество(), "ЧН=0; ЧГ=0")
			+ " адресов опрошены за последние сутки, повторный опрос не нужен";
	КонецЕсли;
	Список = Неопрошенные;

	Осталось = 0;
	Если Список.Количество() > МаксАдресовПриглашенийЗаРаз() Тогда
		Полный = Список;
		Список = Новый Массив;
		Для Индекс = 0 По МаксАдресовПриглашенийЗаРаз() - 1 Цикл
			Список.Добавить(Полный[Индекс]);
		КонецЦикла;
		Осталось = Полный.Количество() - Список.Количество();
	КонецЕсли;

	ОрганизацияСвязей = Организация;
	Если ОрганизацияСвязей = Неопределено И НесколькоУчетныхЗаписейЭДО() Тогда
		ОрганизацияСвязей = УчетныеЗаписиЭДО()[0].Организация;
	КонецЕсли;
	НашГид = ГидОрганизации(ОрганизацияСвязей);
	Если НЕ ЗначениеЗаполнено(НашГид) Тогда
		Возврат "Обновление состояний приглашений: не определен идентификатор своей организации";
	КонецЕсли;
	Если НЕ ОбеспечитьТокен(Истина, ОрганизацияСвязей) Тогда
		Возврат "Обновление состояний приглашений: не удалось получить токен авторизации";
	КонецЕсли;
	Соединение = HTTPСоединениеЭДО();
	Заголовки = ЗаголовкиАвторизацииЭДО(ОрганизацияСвязей);

	// Связи - пачками (см. РазмерПачкиСвязей), сами приглашения - по одному адресу
	// (см. комментарий у СтатусыПриглашений: другого способа узнать судьбу приглашения нет).
	Обход = СтатусыСвязейПолно(Соединение, Заголовки, НашГид, Список);
	Если Обход.Неудач > 0 Тогда
		ЗаписьЖурналаРегистрации("ЭДО.ПриглашениеСостояния", УровеньЖурналаРегистрации.Предупреждение, , ,
			"не опрошено связей: " + Обход.Неудач + " из " + Список.Количество() + ОтказыОбходаСтрокой(Обход));
	КонецЕсли;
	Приглашения = СтатусыПриглашений(Соединение, Заголовки, НашГид, Список);

	// Обновлен - для сравнения свежести (ГраницаСвежести выше), поэтому ТекущаяУниверсальнаяДата;
	// ДатаОтвета показывается человеку на форме, поэтому ТекущаяДатаСеанса - иначе окно "опрошены
	// за сутки" и колонка с датой ответа считали бы время по разным часовым поясам.
	ОбновленоВ = ТекущаяУниверсальнаяДата();
	ПоказаноВ = ТекущаяДатаСеанса();
	Счетчики = Новый Соответствие;
	Для Каждого Имя Из СписокСостоянийПриглашений() Цикл
		Счетчики.Вставить(Имя, 0);
	КонецЦикла;

	Для Каждого Адрес Из Список Цикл
		Прежняя = Кэш[Адрес];

		СостСвязи = СостояниеСвязи(Обход.Связи, Адрес);
		Если СостСвязи <> Неопределено
			И (ВРег(СокрЛП(СостСвязи.Статус)) = "ESTABLISHED" ИЛИ ВРег(СокрЛП(СостСвязи.Статус)) = "DIRECT") Тогда
			Состояние = "Связь есть";
			Текст = "";
		Иначе
			ИсторияПриглашения = Приглашения[Адрес];
			Если ИсторияПриглашения = Неопределено Тогда
				Состояние = "Не звали";
				Текст = "";
			ИначеЕсли ЗначениеЗаполнено(ИсторияПриглашения.Ошибка) И НЕ ЗначениеЗаполнено(ИсторияПриглашения.Статус) Тогда
				// не удалось опросить САМ статус приглашения (сеть/HTTP при обращении к
				// invitations) - это не ответ оператора, а сбой опроса. Прежнее состояние
				// надежнее, чем "Ждем ответа": иначе временный сбой сети откатывал бы
				// подтвержденную связь обратно в неопределенность на каждый неудачный прогон.
				Если Прежняя <> Неопределено Тогда
					Состояние = Прежняя.Состояние;
					Текст = Прежняя.Текст;
				Иначе
					Состояние = "Ждем ответа оператора";
					Текст = ИсторияПриглашения.Ошибка;
				КонецЕсли;
			Иначе
				Состояние = СостояниеПриглашенияПоОтвету(ИсторияПриглашения.Статус, ИсторияПриглашения.Ошибка);
				Текст = ИсторияПриглашения.Ошибка;
			КонецЕсли;
		КонецЕсли;

		Запись = Новый Структура("Состояние, Текст, ДатаПриглашения, ДатаОтвета, Обновлен",
			Состояние, Текст, '00010101', '00010101', ОбновленоВ);
		Если Прежняя <> Неопределено Тогда
			Запись.ДатаПриглашения = Прежняя.ДатаПриглашения;
		КонецЕсли;
		// ДатаОтвета - когда состояние в последний раз БЫЛО подтверждено обновлением, а не
		// дата самого ответа оператора: такой даты API не отдает.
		Если Состояние <> "Ждем ответа оператора" И Состояние <> "Не звали" Тогда
			Запись.ДатаОтвета = ПоказаноВ;
		КонецЕсли;

		Кэш.Вставить(Адрес, Запись);
		Счетчики[Состояние] = Счетчики[Состояние] + 1;
	КонецЦикла;

	ЗаписатьКэшСостоянийПриглашений(Кэш, Организация);

	Части = Новый Массив;
	Для Каждого Имя Из СписокСостоянийПриглашений() Цикл
		Части.Добавить(Имя + ": " + Счетчики[Имя]);
	КонецЦикла;

	Секунд = Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000, 1);
	Возврат "Обновление состояний приглашений: опрошено " + Список.Количество() + " ("
		+ СтрСоединить(Части, ", ") + ")"
		+ ?(Осталось > 0, "; осталось адресов вне этого вызова: " + Осталось, "")
		+ "; " + Секунд + " c";

КонецФункции

// Пригласить контрагентов по КОНКРЕТНЫМ адресам (в отличие от ПригласитьНовыхКонтрагентов,
// которая сама ищет кандидатов среди контрагентов без адреса). Переиспользует
// ПригласитьПоАдресам: та же защита от повторного приглашения по живой/ждущей связи.
// Возврат: Строка - свод прогона.
Функция ПригласитьПоСписку(Знач Адреса, Знач Организация = Неопределено, Знач ТолькоПроверка = Ложь) Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Уникальные = Новый Соответствие;
	Для Каждого Адрес Из Адреса Цикл
		Если ЗначениеЗаполнено(Адрес) Тогда
			Уникальные.Вставить(ВРег(СокрЛП(Адрес)), Истина);
		КонецЕсли;
	КонецЦикла;
	Список = Новый Массив;
	Для Каждого КлючЗначение Из Уникальные Цикл
		Список.Добавить(КлючЗначение.Ключ);
	КонецЦикла;

	Если Список.Количество() = 0 Тогда
		Возврат "Пригласить: адресов не выбрано";
	КонецЕсли;

	Осталось = 0;
	Если Список.Количество() > МаксАдресовПриглашенийЗаРаз() Тогда
		Полный = Список;
		Список = Новый Массив;
		Для Индекс = 0 По МаксАдресовПриглашенийЗаРаз() - 1 Цикл
			Список.Добавить(Полный[Индекс]);
		КонецЦикла;
		Осталось = Полный.Количество() - Список.Количество();
	КонецЕсли;

	ОрганизацияСвязей = Организация;
	Если ОрганизацияСвязей = Неопределено И НесколькоУчетныхЗаписейЭДО() Тогда
		ОрганизацияСвязей = УчетныеЗаписиЭДО()[0].Организация;
	КонецЕсли;
	НашГид = ГидОрганизации(ОрганизацияСвязей);
	Если НЕ ЗначениеЗаполнено(НашГид) Тогда
		Возврат "Пригласить: не определен идентификатор своей организации";
	КонецЕсли;
	Если НЕ ОбеспечитьТокен(Истина, ОрганизацияСвязей) Тогда
		Возврат "Пригласить: не удалось получить токен авторизации";
	КонецЕсли;
	Соединение = HTTPСоединениеЭДО();
	Заголовки = ЗаголовкиАвторизацииЭДО(ОрганизацияСвязей);

	Свод = ПригласитьПоАдресам(Соединение, Заголовки, НашГид, Список, ТолькоПроверка);
	Если Свод.Отменено Тогда
		Возврат "Пригласить: ПРОГОН ОТМЕНЕН - " + Свод.Причина;
	КонецЕсли;

	Если НЕ ТолькоПроверка Тогда
		// Адреса, для которых сам вызов PUT отказал (см. Свод.Отказы, формат "адрес: текст"),
		// в кэш как "ждем ответа" не пишем - им ничего не ушло, а "ждем ответа" читалось бы
		// как "приглашение в пути".
		ОтказавшиеАдреса = Новый Соответствие;
		Для Каждого Отказ Из Свод.Отказы Цикл
			Позиция = СтрНайти(Отказ, ": ");
			Если Позиция > 0 Тогда
				ОтказавшиеАдреса.Вставить(ВРег(Лев(Отказ, Позиция - 1)), Истина);
			КонецЕсли;
		КонецЦикла;

		Кэш = КэшСостоянийПриглашений(Организация);
		// Обновлен - служебная отметка кэша, ДатаПриглашения показывается человеку на форме:
		// та же причина развести ТекущаяУниверсальнаяДата и ТекущаяДатаСеанса, что и выше.
		ОбновленоВ = ТекущаяУниверсальнаяДата();
		ПоказаноВ = ТекущаяДатаСеанса();
		Для Каждого Адрес Из Свод.Цели Цикл
			Если ОтказавшиеАдреса[Адрес] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Запись = Кэш[Адрес];
			Если Запись = Неопределено ИЛИ ТипЗнч(Запись) <> Тип("Структура") Тогда
				Запись = Новый Структура("Состояние, Текст, ДатаПриглашения, ДатаОтвета, Обновлен");
			КонецЕсли;
			Запись.Состояние = "Ждем ответа оператора";
			Запись.Текст = "";
			Запись.ДатаПриглашения = ПоказаноВ;
			Запись.ДатаОтвета = '00010101';
			Запись.Обновлен = ОбновленоВ;
			Кэш.Вставить(Адрес, Запись);
		КонецЦикла;
		ЗаписатьКэшСостоянийПриглашений(Кэш, Организация);
	КонецЕсли;

	Секунд = Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000, 1);
	Возврат "Пригласить" + ?(ТолькоПроверка, " (проверка)", "") + ": адресов " + Список.Количество()
		+ ", приглашено " + Свод.Приглашено
		+ ", пропущено (уже звали/есть связь) " + Свод.Пропущено
		+ ", ошибок " + Свод.Ошибок
		+ ?(Осталось > 0, "; осталось адресов вне этого вызова: " + Осталось, "")
		+ "; " + Секунд + " c";

КонецФункции

#КонецОбласти

#Область ЗащитаОтПовторнойОтправки

// Признак того, что оператор не знает адреса получателя: контрагент ушёл от своего
// оператора, и записанный у нас gid больше не существует.
// Судим по паре "404 + Subscriber ... not found": просто 404 бывает и по другим поводам.
Функция ОтветГоворитЧтоАдресаНет(Знач Сообщение) Экспорт
	Текст = ВРег(Строка(Сообщение));
	Возврат СтрНайти(Текст, "404") > 0
		И СтрНайти(Текст, "SUBSCRIBER") > 0
		И СтрНайти(Текст, "NOT FOUND") > 0;
КонецФункции

// Снять у контрагента адрес ЭДО, который перестал существовать у оператора.
//
// Снимается и ЗАКРЕПЛЕНИЕ адреса, если оно стояло: закреплённую карточку регламент связей
// намеренно не трогает, и без этого шага контрагент остался бы с мёртвым адресом навсегда.
// Новый адрес подбирает регламент связей - он спрашивает реестр ФНС по ИНН, то есть видит
// переезд контрагента, чего опрос по записанному адресу не умеет.
// Возврат: Строка - что сделано, для сообщения в результате отправки.
Функция СнятьПротухшийАдресКонтрагента(Контрагент) Экспорт

	СвИд = СвойствоОбъектов("ЭДО_АдресКонтрагента");
	Если СвИд = Неопределено ИЛИ СвИд.Пустая() Тогда
		Возврат "Адрес получателя не найден у оператора, но снять его нечем:"
			+ " свойство ЭДО_АдресКонтрагента не заведено";
	КонецЕсли;

	Прежний = Строка(ЗначениеСвойстваОбъекта(Контрагент, СвИд));
	БылоЗакрепление = АдресЭДОЗакреплён(Контрагент);

	Если БылоЗакрепление Тогда
		СнятьЗакреплениеАдресаЭДО(Контрагент);
	КонецЕсли;

	НаборИд = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	НаборИд.Отбор.Объект.Установить(Контрагент);
	НаборИд.Отбор.Свойство.Установить(СвИд);
	НаборИд.Записать(Истина);

 // статус относился к снятому адресу и без него означал бы здоровье несуществующей связи;
 // чистим у всех учетных записей, а не только у основной
	ОписанияСвязей = СвойстваСвязиОрганизаций();
	// ЩА 20.10.2026 [yan]: и прежнее общее ЭДО_СтатусСвязи - его читают старые сборки.
	ОписаниеПустое = Новый Структура("СвойствоСтатуса", СвойствоОбъектов("ЭДО_СтатусСвязи"));
	ОписанияСвязей.Добавить(ОписаниеПустое);
	Для Каждого ОписаниеСвязи Из ОписанияСвязей Цикл
		Если ОписаниеСвязи.СвойствоСтатуса = Неопределено ИЛИ ОписаниеСвязи.СвойствоСтатуса.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		НаборСвязь = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
		НаборСвязь.Отбор.Объект.Установить(Контрагент);
		НаборСвязь.Отбор.Свойство.Установить(ОписаниеСвязи.СвойствоСтатуса);
		НаборСвязь.Записать(Истина);
	КонецЦикла;

	// Кэш кандидатов держится неделю, и в нём лежит тот же мёртвый адрес: без сброса
	// регламент переспросит реестр ФНС нескоро и подобрать будет не из чего.
	ИНН = СокрЛП(Строка(Контрагент.ИНН));
	Если ЗначениеЗаполнено(ИНН) Тогда
		Реестр = ЗагрузитьРеестрАдресов();
		Если Реестр[ИНН] <> Неопределено Тогда
			Реестр.Удалить(ИНН);
			СохранитьРеестрАдресов(Реестр);
		КонецЕсли;
	КонецЕсли;

	Сообщение = "Адреса " + Прежний + " у оператора больше нет - контрагент сменил оператора."
		+ " Адрес снят" + ?(БылоЗакрепление, " вместе с закреплением", "")
		+ ", живой подберёт обновление связей";

	ЗаписьЖурналаРегистрации("ЭДО.Отправка", УровеньЖурналаРегистрации.Предупреждение, , Контрагент,
		Сообщение);

	Возврат Сообщение;

КонецФункции

// Разобрать документ, у которого прошлая отправка оборвалась до получения идентификатора
// (ЭДО_КодСостояния = 10). Сверяем с оператором ровно то, что раньше сверял человек:
// есть ли живой экземпляр этого документа для того же получателя.
//
// Найден - закрепляем идентификатор и снимаем с очереди; не найден - снимаем код, документ
// уходит обычным ходом; оператор молчит - оставляем код и ждём следующего прогона.
// Возврат: Структура (Решено Булево, Ид Строка, Сообщение Строка).
Функция РазобратьПрерваннуюОтправку(Ссылка) Экспорт

	Результат = Новый Структура("Решено, Ид, Сообщение", Ложь, "", "");

	СвойствоКода = СвойствоОбъектов("ЭДО_КодСостояния");
	Если СвойствоКода = Неопределено ИЛИ СвойствоКода.Пустая() Тогда
		Результат.Решено = Истина;
		Возврат Результат;
	КонецЕсли;

	Текущий = ЗначениеСвойстваОбъекта(Ссылка, СвойствоКода);
	Если НЕ ЗначениеЗаполнено(Текущий) ИЛИ Число(Текущий) <> 10 Тогда
		Результат.Решено = Истина;
		Возврат Результат;
	КонецЕсли;

	Дубль = ЖивойЭкземплярУОператора(Ссылка);

	Если НЕ Дубль.Опрошено Тогда
		Результат.Сообщение = "Отправка прерывалась, у оператора не спросить"
			+ ?(ЗначениеЗаполнено(Дубль.Причина), " (" + Дубль.Причина + ")", "")
			+ ", разбор отложен до следующего прогона";
		Возврат Результат;
	КонецЕсли;

	Если Дубль.Найден Тогда
		ЗаписатьСтатусЭДО(Ссылка, 40, Дубль.Ид);
		ЗаписатьЧитаемыйСтатус(Ссылка, "Уже отправлен этому получателю");
		Результат.Решено = Истина;
		Результат.Ид = Дубль.Ид;
		Результат.Сообщение = "Прерванная отправка разобрана: экземпляр у оператора есть"
			+ " (ид " + Дубль.Ид + ", " + Дубль.Статус + ")";
		Возврат Результат;
	КонецЕсли;

	Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Ссылка);
	Набор.Отбор.Свойство.Установить(СвойствоКода);
	Набор.Записать(Истина);

	ЗаписьЖурналаРегистрации("ЭДО.Отправка", УровеньЖурналаРегистрации.Информация, , Ссылка,
		"Прерванная отправка разобрана: экземпляра у оператора нет, документ возвращён в поток");

	Результат.Решено = Истина;
	Возврат Результат;

КонецФункции

// Занять документ под отправку: статус 1 "взят в отправку" до обращения к API, под исключительной
// блокировкой - второй параллельный прогон этот документ уже не возьмет.
// Возврат: Структура (Занят Булево, Причина Строка).
Функция ЗанятьДокументКОтправке(Ссылка) Экспорт

	Результат = Новый Структура("Занят, Причина", Ложь, "");
	СвойствоСтатус = СвойствоОбъектов("ЭДО_КодСостояния");
	Если СвойствоСтатус = Неопределено ИЛИ СвойствоСтатус.Пустая() Тогда
		Результат.Занят = Истина;   // хранить статус негде - работаем как раньше
		Возврат Результат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.ЗначенияСвойствОбъектов");
		Элемент.УстановитьЗначение("Объект", Ссылка);
		Элемент.УстановитьЗначение("Свойство", СвойствоСтатус);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		Запрос = Новый Запрос(
			"ВЫБРАТЬ Значение КАК Значение
			|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
			|ГДЕ Объект = &Объект И Свойство = &Свойство");
		Запрос.УстановитьПараметр("Объект", Ссылка);
		Запрос.УстановитьПараметр("Свойство", СвойствоСтатус);
		Выборка = Запрос.Выполнить().Выбрать();

		Свободен = Истина;
		ТекСтатус = 0;
		Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Значение) Тогда
			Свободен = Ложь;
			ТекСтатус = Число(Выборка.Значение);
		КонецЕсли;
		Если Свободен Тогда
			ЗаписатьЗначениеСвойства(Ссылка, СвойствоСтатус, 1);
		КонецЕсли;
		// Занятый документ ничего не пишет: фиксация лишь снимает блокировку.
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.Причина = "Не удалось занять документ: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Если Свободен Тогда
		Результат.Занят = Истина;
	ИначеЕсли ТекСтатус = 1 Тогда
		Результат.Причина = "Документ уже взят в отправку другим сеансом";
	ИначеЕсли ТекСтатус = 10 Тогда
		// статус 10: связь оборвалась до получения id, и POST мог пройти - повтор без сверки
		// с оператором (РазобратьПрерваннуюОтправку) дал бы дубль.
		Результат.Причина = "Отправка прерывалась, состояние у оператора неизвестно -"
			+ " проверить по номеру накладной и снять статус вручную";
	Иначе
		// Внутренний код состояния пользователю не показываем: он остается в свойстве и в журнале.
		Результат.Причина = "Документ уже отправлялся ранее";
	КонецЕсли;

	Возврат Результат;
КонецФункции

// Освободить документ, если до создания документа у оператора дело не дошло:
// снимаем отметку "взят в отправку", чтобы он вернулся в очередь.
// Вызывать ТОЛЬКО когда у оператора ничего не создано - иначе повтор даст дубль.
Процедура ОсвободитьДокумент(Ссылка) Экспорт

	СвойствоСтатус = СвойствоОбъектов("ЭДО_КодСостояния");
	Если СвойствоСтатус = Неопределено ИЛИ СвойствоСтатус.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Значение КАК Значение
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Объект = &Объект И Свойство = &Свойство");
	Запрос.УстановитьПараметр("Объект", Ссылка);
	Запрос.УстановитьПараметр("Свойство", СвойствоСтатус);
	Выборка = Запрос.Выполнить().Выбрать();
	// снимаем только СВОЮ отметку "взят", чужие статусы не трогаем
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Значение) И Число(Выборка.Значение) <> 1 Тогда
		Возврат;
	КонецЕсли;

	Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Ссылка);
	Набор.Отбор.Свойство.Установить(СвойствоСтатус);
	Набор.Записать(Истина);

КонецПроцедуры

// ЩА 15.10.2026 [yan]: исключение - конфликт управляемых блокировок или таймаут их ожидания (тексты платформы
// на русском и английском), а не другой отказ.
Функция ЭтоКонфликтБлокировки(Знач ТекстОшибки)
	Текст = ВРег(ТекстОшибки);
	Для Каждого Признак Из СтрРазделить("КОНФЛИКТ БЛОКИРОВОК|ВРЕМЯ ОЖИДАНИЯ ПРЕДОСТАВЛЕНИЯ БЛОКИРОВКИ|LOCK CONFLICT|LOCK REQUEST TIMEOUT", "|") Цикл
		Если СтрНайти(Текст, Признак) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Замок на массовый прогон. Живёт 30 минут, продлевается по ходу пакета.
// Возврат: Истина - прогон наш, можно работать.
// Проверка и запись метки идут в одной транзакции под исключительной блокировкой ключа замка:
// иначе два сеанса, стартовавшие одновременно, оба видят пустую метку и оба считают замок своим.
Функция ЗанятьПрогонОтправки() Экспорт
	// Общие настройки лежат под пользователем "": для обычного пользователя это чужой слот, без привилегий - «Нарушение прав доступа».
	УстановитьПривилегированныйРежим(Истина);

	Наш = Ложь;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьКлючЗамкаОтправки();
		Метка = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", "ЗамокОтправки", , "");
		Наш = НЕ ЗамокОтправкиЧужой(Метка);
		Если Наш Тогда
			Новая = Новый Структура("Сеанс, До, Начат",
				НомерСеансаИнформационнойБазы(), ТекущаяУниверсальнаяДата() + 1800, ТекущаяДатаСеанса());
			ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", "ЗамокОтправки", Новая, , "");
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Наш;

КонецФункции

// ++ ЩА 14.10.2026 [yan]: шаг прогона отправки для разбора зависаний. Сеанс, застрявший в ожидании
// внешнего вызова (сеть, криптография), ничего о себе не пишет, а технологический журнал фиксирует
// вызов только по его окончании. Шаг лежит в ОДНОЙ записи хранилища и перезаписывается - журнал
// регистрации не растет; запись в него делает только сторож и только при зависании.
// Пишет лишь сеанс, держащий замок прогона: ручная отправка из карточки отметку не трогает.
// Проверка владельца замка и запись шага - под разделяемой блокировкой ключа замка: смена владельца
// берет исключительную и между ними не вклинится. Задание - идентификатор фонового задания: сторож
// приписывает шаг зависшему экземпляру только при совпадении.
// ЩА 19.10.2026 [yan]: без Экспорт - шаг отмечает только прогон ядра.
Процедура ОтметитьШагОтправки(Знач Шаг, Знач Ссылка = Неопределено)
	// Общие настройки лежат под пользователем "": для обычного пользователя это чужой слот, без привилегий - «Нарушение прав доступа».
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Задание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить("РегистрСведений.ЗначенияСвойствОбъектов");
			Элемент.УстановитьЗначение("Объект", Справочники.Организации.ПустаяСсылка());
			Элемент.УстановитьЗначение("Свойство", ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка());
			Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
			Блокировка.Заблокировать();
			Метка = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", "ЗамокОтправки", , "");
			Если ТипЗнч(Метка) = Тип("Структура") И Метка.Свойство("Сеанс")
				И Метка.Сеанс = НомерСеансаИнформационнойБазы() Тогда
				ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", "ШагОтправки",
					Новый Структура("Сеанс, Задание, Шаг, Документ, Когда", НомерСеансаИнформационнойБазы(),
						?(Задание = Неопределено, "", Строка(Задание.УникальныйИдентификатор)), Шаг,
						?(Ссылка = Неопределено, "", Строка(Ссылка)), ТекущаяДатаСеанса()), , "");
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	Исключение
		// отметка - диагностика: ее сбой не должен останавливать отправку
		ЗаписьЖурналаРегистрации("ЭДО.ШагОтправки", УровеньЖурналаРегистрации.Предупреждение, , ,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

// Последний отмеченный шаг прогона отправки: Структура (Сеанс, Шаг, Документ, Когда) или Неопределено.
Функция ПоследнийШагОтправки() Экспорт
	// Общие настройки лежат под пользователем "": для обычного пользователя это чужой слот, без привилегий - «Нарушение прав доступа».
	УстановитьПривилегированныйРежим(Истина);
	Шаг = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", "ШагОтправки", , "");
	Возврат ?(ТипЗнч(Шаг) = Тип("Структура"), Шаг, Неопределено);
КонецФункции
// -- ЩА 14.10.2026 [yan].

// Метка замка принадлежит другому живому сеансу (срок не истек).
Функция ЗамокОтправкиЧужой(Знач Метка)
	Если ТипЗнч(Метка) <> Тип("Структура") ИЛИ НЕ Метка.Свойство("До") ИЛИ НЕ Метка.Свойство("Сеанс") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Метка.Сеанс <> НомерСеансаИнформационнойБазы() И Метка.До > ТекущаяУниверсальнаяДата();
КонецФункции

// Исключительная блокировка ключа замка прогона. Ключ - несуществующая запись регистра свойств
// (пустые организация и свойство): управляемая блокировка ставится на значения полей, а не на
// строки, поэтому сериализует всех, кто берет замок, не задевая реальные данные.
Процедура ЗаблокироватьКлючЗамкаОтправки()
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.ЗначенияСвойствОбъектов");
	Элемент.УстановитьЗначение("Объект", Справочники.Организации.ПустаяСсылка());
	Элемент.УстановитьЗначение("Свойство", ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка());
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
КонецПроцедуры

// Снимает только СВОЮ метку: чужую (замок другого живого сеанса) не трогает, иначе сторож
// брошенных отметок начнет разбирать документ, который в эту минуту отправляется.
Процедура ОсвободитьПрогонОтправки() Экспорт
	// Общие настройки лежат под пользователем "": для обычного пользователя это чужой слот, без привилегий - «Нарушение прав доступа».
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьКлючЗамкаОтправки();
		Метка = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", "ЗамокОтправки", , "");
		Если ТипЗнч(Метка) = Тип("Структура") И Метка.Свойство("Сеанс")
			И Метка.Сеанс = НомерСеансаИнформационнойБазы() Тогда
			ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", "ЗамокОтправки", Неопределено, , "");
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Освободить документ после сверки с оператором, подтвердившей, что карточки у него нет:
// снимает отметку "взят в отправку" (1) и "состояние неизвестно" (10). Под блокировкой
// перечитывает статус и идентификатор: успели записать идентификатор или сменить статус -
// ничего не трогает. Возврат: Истина - отметка снята.
Функция ОсвободитьПрерваннуюОтправку(Ссылка) Экспорт

	СвойствоСтатус = СвойствоОбъектов("ЭДО_КодСостояния");
	СвойствоИд = СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если СвойствоСтатус = Неопределено ИЛИ СвойствоСтатус.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;

	Снято = Ложь;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.ЗначенияСвойствОбъектов");
		Элемент.УстановитьЗначение("Объект", Ссылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		КодСтатуса = 0;
		Значение = ЗначениеСвойстваОбъекта(Ссылка, СвойствоСтатус);
		Если ЗначениеЗаполнено(Значение) Тогда
			КодСтатуса = Число(Значение);
		КонецЕсли;
		ЕстьИд = СвойствоИд <> Неопределено И НЕ СвойствоИд.Пустая()
			И ЗначениеЗаполнено(СокрЛП(Строка(ЗначениеСвойстваОбъекта(Ссылка, СвойствоИд))));
		Если (КодСтатуса = 1 ИЛИ КодСтатуса = 10) И НЕ ЕстьИд Тогда
			Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
			Набор.Отбор.Объект.Установить(Ссылка);
			Набор.Отбор.Свойство.Установить(СвойствоСтатус);
			Набор.Записать(Истина);
			Снято = Истина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Снято;

КонецФункции

#КонецОбласти

#Область ЗакреплённыйАдрес

// Статус роуминга по адресу из карточки - кэш, который поддерживает ОбновитьСвязиЭДО:
// ESTABLISHED / AWAIT_APPROVAL / BROKEN / NO_CONTACT, для пары абонентов одного оператора -
// DIRECT. Пустая строка - еще не проверяли.
// Статус связи с контрагентом. Организация задана - статус пары "организация - контрагент"
// (свойство ее учетной записи); не задана - прежнее поведение: статус основной учетной записи.
Функция СтатусСвязиЭДО(Контрагент, Знач Организация = Неопределено) Экспорт
	Свойство = СвойствоСтатусаСвязиОрганизации(Организация);
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Значение КАК Значение
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Объект = &Объект И Свойство = &Свойство");
	Запрос.УстановитьПараметр("Объект", Контрагент);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Строка(Выборка.Значение));
	КонецЕсли;
	Возврат "";
КонецФункции

// Ручной статус пары "организация - контрагент": эта организация с контрагентом по ЭДО
// не работает. Ставится только вручную; регламент связей значение не перезаписывает,
// а очередь такую пару не берет - NOT_REQUIRED не входит в отбор ESTABLISHED/DIRECT.
Функция СтатусСвязиНеТребуется() Экспорт
	Возврат "NOT_REQUIRED";
КонецФункции

// Свойства статуса связи всех учетных записей организаций.
// ЩА 20.10.2026 [yan]: свое свойство у КАЖДОЙ учетной записи, включая основную. Свойства и их значения
// ходят в обмене между базами, а основная организация у баз разная (ГХ - Лион, Кудымкар - Ника,
// ЕК - Миралко-Опт): общее ЭДО_СтатусСвязи регламенты разных баз перезаписывали друг другу своим
// видением, и статусы «скакали». Свойство учетной записи - ЭДО_СвязьОрг_<гид> (проверка -
// ЭДО_ПроверкаОрг_<гид>), его ссылка вычисляется из имени: заведенное в двух базах до обмена
// совпадает, а не дублируется. Пока оно не заведено (до первого прогона ОбновитьСвязиЭДО) -
// прежние свойства: основная ЭДО_СтатусСвязи, прочие ЭДО_СтатусСвязи_<гид>.
// Возврат: Массив из Структура (Организация, ИдентификаторУчастника, Основная, ИмяСтатуса, ИмяПроверки,
//   СвойствоСтатуса, СвойствоПроверки, КлючСтатуса, КлючПроверки, ПрежнееИмяСтатуса, ПрежнееИмяПроверки, Удержание,
//   ГидПовторяется - тот же идентификатор участника уже у предыдущей записи: регламент ее пропускает).
Функция СвойстваСвязиОрганизаций() Экспорт

	Описания = Новый Массив;
	Ключи = Новый Массив;
	Гиды = Новый Соответствие;
	Индекс = 0;
	Для Каждого Запись Из УчетныеЗаписиЭДО() Цикл

		Основная = (Индекс = 0);
		Гид = СокрЛП(Запись.ИдентификаторУчастника);
		Описание = Новый Структура("Организация, ИдентификаторУчастника, Основная, ИмяСтатуса, ИмяПроверки,
			|СвойствоСтатуса, СвойствоПроверки, КлючСтатуса, КлючПроверки, ПрежнееИмяСтатуса, ПрежнееИмяПроверки, Удержание,
			|ГидПовторяется");
		Описание.Организация = Запись.Организация;
		Описание.ИдентификаторУчастника = Гид;
		Описание.Основная = Основная;
		Описание.ГидПовторяется = ЗначениеЗаполнено(Гид) И Гиды.Получить(Гид) <> Неопределено;
		Гиды.Вставить(Гид, Истина);
		Описание.ПрежнееИмяСтатуса = "ЭДО_СтатусСвязи" + ?(Основная, "", "_" + Гид);
		Описание.ПрежнееИмяПроверки = "ЭДО_СвязьПроверена" + ?(Основная, "", "_" + Гид);
		Если ЗначениеЗаполнено(Гид) Тогда
			Описание.ИмяСтатуса = Лев("ЭДО_СвязьОрг_" + Гид, ДлинаИмениСвойства());
			Описание.ИмяПроверки = Лев("ЭДО_ПроверкаОрг_" + Гид, ДлинаИмениСвойства());
			Описание.КлючСтатуса = СсылкаСвойстваПоИмени(Описание.ИмяСтатуса);
			Описание.КлючПроверки = СсылкаСвойстваПоИмени(Описание.ИмяПроверки);
			Ключи.Добавить(Описание.КлючСтатуса);
			Ключи.Добавить(Описание.КлючПроверки);
		Иначе
			Описание.ИмяСтатуса = Описание.ПрежнееИмяСтатуса;
			Описание.ИмяПроверки = Описание.ПрежнееИмяПроверки;
		КонецЕсли;
		Описания.Добавить(Описание);
		Индекс = Индекс + 1;

	КонецЦикла;

	// Новое свойство читается, только когда эта база перенесла в него свои значения (ПереносСвязиВыполнен):
	// свойство приезжает по обмену из базы, которая завела его первой, без значений и ручных NOT_REQUIRED этой базы.
	Заведенные = ЗаведенныеСвойства(Ключи);
	Перенесенные = ПереносыСвязиВыполненные();
	Для Каждого Описание Из Описания Цикл
		Если Описание.КлючСтатуса <> Неопределено И Заведенные.Получить(Описание.КлючСтатуса) <> Неопределено
			И Перенесенные.Получить(Строка(Описание.КлючСтатуса.УникальныйИдентификатор())) <> Неопределено Тогда
			Описание.СвойствоСтатуса = Описание.КлючСтатуса;
		Иначе
			Описание.СвойствоСтатуса = СвойствоОбъектов(Описание.ПрежнееИмяСтатуса);
		КонецЕсли;
		Если Описание.КлючПроверки <> Неопределено И Заведенные.Получить(Описание.КлючПроверки) <> Неопределено
			И Перенесенные.Получить(Строка(Описание.КлючПроверки.УникальныйИдентификатор())) <> Неопределено Тогда
			Описание.СвойствоПроверки = Описание.КлючПроверки;
		Иначе
			Описание.СвойствоПроверки = СвойствоОбъектов(Описание.ПрежнееИмяПроверки);
		КонецЕсли;
	КонецЦикла;
	Возврат Описания;

КонецФункции

Функция ДлинаИмениСвойства()
	Возврат Метаданные.ПланыВидовХарактеристик.СвойстваОбъектов.ДлинаНаименования;
КонецФункции

// ЩА 20.10.2026 [yan]: ссылка свойства, вычисленная из имени (MD5 имени как уникальный идентификатор).
// Одинакова во всех базах обмена: свойство, заведенное в двух базах до обмена, не дублируется.
Функция СсылкаСвойстваПоИмени(Знач Имя)
	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеш.Добавить(Имя);
	Ш = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
	Ид = Новый УникальныйИдентификатор(Сред(Ш, 1, 8) + "-" + Сред(Ш, 9, 4) + "-" + Сред(Ш, 13, 4) + "-"
		+ Сред(Ш, 17, 4) + "-" + Сред(Ш, 21, 12));
	Возврат ПланыВидовХарактеристик.СвойстваОбъектов.ПолучитьСсылку(Ид);
КонецФункции

// Свойства связи, в которые эта база уже перенесла свои значения: Соответствие (уникальный идентификатор -> Истина).
// Хранится в настройке базы, а не в данных: по обмену не передается, у каждой базы - свой перенос.
Функция ПереносыСвязиВыполненные()
	Значение = НастройкаЭДО("ПереносСвязиВыполнен");
	Возврат ?(ТипЗнч(Значение) = Тип("Соответствие"), Значение, Новый Соответствие);
КонецФункции

// Какие из ссылок заведены в базе (не помечены на удаление). Возврат: Соответствие (ссылка -> Истина).
Функция ЗаведенныеСвойства(Знач Ссылки)
	Итог = Новый Соответствие;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ С.Ссылка КАК Ссылка
		|ИЗ ПланВидовХарактеристик.СвойстваОбъектов КАК С
		|ГДЕ С.Ссылка В (&Ссылки) И НЕ С.ПометкаУдаления");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Итог.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;
	Возврат Итог;
КонецФункции

// Свойство статуса связи организации; без организации - свойство основной учетной записи.
// Учетных записей нет вовсе - прежнее ЭДО_СтатусСвязи: поведение баз без настроенной записи
// не меняется.
// Описания - уже прочитанный результат СвойстваСвязиОрганизаций, чтобы не читать его повторно.
Функция СвойствоСтатусаСвязиОрганизации(Знач Организация = Неопределено, Знач Описания = Неопределено) Экспорт
	Если Описания = Неопределено Тогда
		Описания = СвойстваСвязиОрганизаций();
	КонецЕсли;
	Для Каждого Описание Из Описания Цикл
		Если ЗначениеЗаполнено(Организация) И Описание.Организация = Организация Тогда
			Возврат Описание.СвойствоСтатуса;
		КонецЕсли;
	КонецЦикла;
	// Организация без учетной записи (или не указана) - как в отборе очереди (ИНАЧЕ &СвСвязь): свойство основной.
	Для Каждого Описание Из Описания Цикл
		Если Описание.Основная Тогда
			Возврат Описание.СвойствоСтатуса;
		КонецЕсли;
	КонецЦикла;
	Возврат СвойствоОбъектов("ЭДО_СтатусСвязи");
КонецФункции

// ЩА 20.10.2026 [yan]: в запросе отбора статус связи берется по организации документа - у каждой
// учетной записи свое свойство. Текст запроса содержит «Связь.Свойство = &СвСвязь»: условие заменяется
// выбором свойства по ПолеОрганизации; при одной учетной записи текст не меняется. &СвСвязь - основная.
Процедура УстановитьСвязьПоОрганизации(Запрос, Знач ПолеОрганизации)
	Описания = СвойстваСвязиОрганизаций();
	Основное = СвойствоСтатусаСвязиОрганизации(, Описания);
	Запрос.УстановитьПараметр("СвСвязь", ?(Основное = Неопределено, ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка(), Основное));
	Ветви = "";
	Для Индекс = 0 По Описания.ВГраница() Цикл
		Описание = Описания[Индекс];
		Если Описание.Основная ИЛИ НЕ ЗначениеЗаполнено(Описание.Организация)
			ИЛИ Описание.СвойствоСтатуса = Неопределено ИЛИ Описание.СвойствоСтатуса.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		Ветви = Ветви + " КОГДА " + ПолеОрганизации + " = &СвСвязьОрг" + Индекс + " ТОГДА &СвСвязьПары" + Индекс;
		Запрос.УстановитьПараметр("СвСвязьОрг" + Индекс, Описание.Организация);
		Запрос.УстановитьПараметр("СвСвязьПары" + Индекс, Описание.СвойствоСтатуса);
	КонецЦикла;
	Если ЗначениеЗаполнено(Ветви) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Связь.Свойство = &СвСвязь",
			"Связь.Свойство = ВЫБОР" + Ветви + " ИНАЧЕ &СвСвязь КОНЕЦ");
	КонецЕсли;
КонецПроцедуры

// ЩА 20.10.2026 [yan]: сколько часов живая связь (ESTABLISHED/DIRECT) держится после первого нерабочего
// ответа оператора. Сбой роуминга у оператора (20.10 13:27 «Калуга Астрал») давал NO_CONTACT одним
// ответом, и регламент снимал связь, останавливая отправку; оператор сам доставит отправленное после
// восстановления.
// Удержание защищает только статус связи, а не решения об адресе: на BROKEN без замены адрес
// снимается сразу, а на NO_CONTACT при другом кандидате с ESTABLISHED контрагента переводят на него
// с первого ответа.
Функция ЧасовУдержанияСвязи()
	Возврат 6;
КонецФункции

// ЩА 23.10.2026 [yan]: статус связи одного контрагента по его текущему адресу - сразу, не дожидаясь часового
// регламента. Нужен после ручного закрепления адреса: статус оставался от прежнего адреса, и отправка стояла
// с «нет связи» до следующего прогона, хотя связь по новому адресу есть (23.10, Жемчужина: закрепили СБИС
// после прогона 10:08, у ТД ЛИОН держался NO_CONTACT от адреса ЭДО-Лайт).
// По одному запросу contacts на учетную запись; правила те же, что у ОбновитьСвязиЭДО: связь у оператора -
// ее статус, нет записи и адрес 2VO - DIRECT, иначе NO_CONTACT; адрес сменился - без удержания прежней
// связи. Запись с ИНН самой организации пропускается. Не ответил оператор - статус этой записи не трогаем.
// Ответ пишется под блокировкой адреса и только если адрес за время запроса не сменился: иначе устаревший
// ответ затер бы статус, уже записанный по новому адресу другим закреплением (ревью Codex 966).
// Возврат: Строка - итог по учетным записям для сообщения, по сохраненному значению, а не по ответу.
Функция ОбновитьСвязьКонтрагента(Знач Контрагент) Экспорт

	Адрес = ИдентификаторУчастникаЭДО(Контрагент);
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат "у контрагента нет адреса ЭДО";
	КонецЕсли;
	ИННКонтрагента = СокрЛП(Строка(Контрагент.ИНН));
	СвойствоАдреса = СвойствоОбъектов("ЭДО_АдресКонтрагента");
	Адреса = Новый Массив;
	Адреса.Добавить(Адрес);
	Соединение = СоединениеСОператором(20);
	Итоги = Новый Массив;
	Для Каждого Описание Из СвойстваСвязиОрганизаций() Цикл
		Если Описание.ГидПовторяется ИЛИ НЕ ЗначениеЗаполнено(Описание.ИдентификаторУчастника) Тогда
			Продолжить;
		КонецЕсли;
		ОргСвязи = ?(ЗначениеЗаполнено(Описание.Организация), Описание.Организация, Неопределено);
		Если ОргСвязи <> Неопределено И СокрЛП(Строка(ОргСвязи.ИНН)) = ИННКонтрагента Тогда
			Продолжить;   // карточка самой организации
		КонецЕсли;
		Если НЕ ОбеспечитьТокен(Ложь, ОргСвязи) Тогда
			Итоги.Добавить(Строка(ОргСвязи) + ": нет токена, статус не обновлен");
			Продолжить;
		КонецЕсли;
		Обход = СтатусыСвязейПолно(Соединение, ЗаголовкиАвторизацииЭДО(ОргСвязи), Описание.ИдентификаторУчастника, Адреса);
		Если Обход.Неудач > 0 Тогда
			Итоги.Добавить(Строка(ОргСвязи) + ": оператор не ответил" + ОтказыОбходаСтрокой(Обход) + ", статус не обновлен");
			Продолжить;
		КонецЕсли;
		Состояние = СостояниеСвязи(Обход.Связи, Адрес);
		Если Состояние <> Неопределено Тогда
			Статус = Состояние.Статус;
		ИначеЕсли Лев(ВРег(Адрес), 3) = "2VO" Тогда
			Статус = "DIRECT";
		Иначе
			Статус = "NO_CONTACT";
		КонецЕсли;
		Итоги.Добавить(Строка(ОргСвязи) + ": " + ЗаписатьСвязьПоАдресу(Контрагент, Описание, Статус, Адрес, СвойствоАдреса));
	КонецЦикла;
	Возврат СтрСоединить(Итоги, "; ");

КонецФункции

// Статус связи из ответа оператора - в карточку контрагента, если его адрес все еще Адрес. Адрес блокируется
// до записи: закрепление другого адреса в это время ждет и пишет свой статус уже после.
// Возврат: Строка - что сохранено (сохраненный статус или почему не записан).
Функция ЗаписатьСвязьПоАдресу(Контрагент, Описание, Знач Статус, Знач Адрес, СвойствоАдреса)

	Если Описание.СвойствоСтатуса = Неопределено ИЛИ Описание.СвойствоСтатуса.Пустая() Тогда
		Возврат "у оператора " + Статус + ", но свойства статуса нет - не записан";
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.ЗначенияСвойствОбъектов");
		Элемент.УстановитьЗначение("Объект", Контрагент);
		Элемент.УстановитьЗначение("Свойство", СвойствоАдреса);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		АдресСейчас = ИдентификаторУчастникаЭДО(Контрагент);
		АдресПрежний = (ВРег(АдресСейчас) = ВРег(Адрес));
		Если АдресПрежний Тогда
			ЗаписатьСтатусСвязиОрганизации(Контрагент, Описание, Статус, Истина);
			Сохранен = ВРег(СокрЛП(Строка(ЗначениеСвойстваОбъекта(Контрагент, Описание.СвойствоСтатуса))));
			Если Сохранен = ВРег(СокрЛП(Статус))
				И Описание.СвойствоПроверки <> Неопределено И НЕ Описание.СвойствоПроверки.Пустая() Тогда
				ЗаписатьЗначениеСвойства(Контрагент, Описание.СвойствоПроверки, ТекущаяДатаСеанса());
			КонецЕсли;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Если НЕ АдресПрежний Тогда
		Возврат "адрес сменился на " + АдресСейчас + " во время запроса - ответ по " + Адрес + " не записан";
	ИначеЕсли Сохранен = ВРег(СокрЛП(Статус)) Тогда
		Возврат Сохранен;
	ИначеЕсли Сохранен = СтатусСвязиНеТребуется() Тогда
		Возврат "у оператора " + Статус + ", сохранен ручной запрет " + Сохранен;
	КонецЕсли;
	Возврат "у оператора " + Статус + ", сохранен " + ?(ЗначениеЗаполнено(Сохранен), Сохранен, "пустой статус");

КонецФункции

// Записать статус связи пары "организация - контрагент" из регламента. Ручной NOT_REQUIRED
// не перезаписывается: регламент не отменяет решение человека.
// ЩА 20.10.2026 [yan]: живая связь снимается, только если нерабочий статус держится ЧасовУдержанияСвязи;
// время первого нерабочего ответа - в общей настройке «СвязьУдержана_<свойство>» (по контрагенту).
// АдресСменился - регламент сменил адрес контрагента: прежняя связь к новому адресу не относится, его статус
// пишется сразу (ревью Codex 860).
Процедура ЗаписатьСтатусСвязиОрганизации(Контрагент, ОписаниеСвойств, Знач Статус, Знач АдресСменился = Ложь)

	СвойствоСтатуса = ОписаниеСвойств.СвойствоСтатуса;
	Если СвойствоСтатуса = Неопределено ИЛИ СвойствоСтатуса.Пустая() ИЛИ НЕ ЗначениеЗаполнено(Статус) Тогда
		Возврат;
	КонецЕсли;

	Текущий = ВРег(СокрЛП(Строка(ЗначениеСвойстваОбъекта(Контрагент, СвойствоСтатуса))));
	Если Текущий = СтатусСвязиНеТребуется() Тогда
		Возврат;
	КонецЕсли;

	НовыйСтатус = ВРег(СокрЛП(Статус));
	ТекущийЖивой = (Текущий = "ESTABLISHED" ИЛИ Текущий = "DIRECT");
	НовыйЖивой = (НовыйСтатус = "ESTABLISHED" ИЛИ НовыйСтатус = "DIRECT");
	Ключ = Строка(Контрагент.УникальныйИдентификатор());
	Удержание = УдержаниеСвязей(ОписаниеСвойств);
	Если ТекущийЖивой И НЕ НовыйЖивой И НЕ АдресСменился Тогда
		Первый = Удержание.Значения.Получить(Ключ);
		Если Первый = Неопределено Тогда
			Удержание.Значения.Вставить(Ключ, ТекущаяДатаСеанса());
			ЗаписатьОбщуюНастройкуЭДО(Удержание.Имя, Удержание.Значения);
			ЗаписьЖурналаРегистрации("ЭДО.Связи", УровеньЖурналаРегистрации.Предупреждение, , Контрагент,
				"Оператор ответил " + НовыйСтатус + " при связи " + Текущий + " (" + СвойствоСтатуса + "): связь держится "
				+ ЧасовУдержанияСвязи() + " ч, снимется, если ответ не изменится");
			Возврат;
		ИначеЕсли ТекущаяДатаСеанса() - Первый < ЧасовУдержанияСвязи() * 3600 Тогда
			Возврат;
		КонецЕсли;
		Удержание.Значения.Удалить(Ключ);
		ЗаписатьОбщуюНастройкуЭДО(Удержание.Имя, Удержание.Значения);
		ЗаписьЖурналаРегистрации("ЭДО.Связи", УровеньЖурналаРегистрации.Предупреждение, , Контрагент,
			"Связь снята: оператор отвечает " + НовыйСтатус + " с " + Формат(Первый, "ДФ='dd.MM HH:mm'") + " (" + СвойствоСтатуса + ")");
	ИначеЕсли Удержание.Значения.Получить(Ключ) <> Неопределено Тогда
		Удержание.Значения.Удалить(Ключ);
		ЗаписатьОбщуюНастройкуЭДО(Удержание.Имя, Удержание.Значения);
		Если НовыйЖивой Тогда
			ЗаписьЖурналаРегистрации("ЭДО.Связи", УровеньЖурналаРегистрации.Информация, , Контрагент,
				"Связь восстановилась до снятия: " + НовыйСтатус + " (" + СвойствоСтатуса + ")");
		ИначеЕсли АдресСменился Тогда
			ЗаписьЖурналаРегистрации("ЭДО.Связи", УровеньЖурналаРегистрации.Информация, , Контрагент,
				"Адрес сменился - удержание прежней связи снято, статус нового адреса " + НовыйСтатус + " (" + СвойствоСтатуса + ")");
		КонецЕсли;
	КонецЕсли;
	Если Текущий <> НовыйСтатус Тогда
		ЗаписатьЗначениеСвойства(Контрагент, СвойствоСтатуса, Лев(Статус, 50));
	КонецЕсли;

КонецПроцедуры

// Удерживаемые связи свойства: Структура (Имя, Значения - Соответствие ключ контрагента -> время первого
// нерабочего ответа). Читается один раз на описание свойств (на прогон регламента).
Функция УдержаниеСвязей(ОписаниеСвойств)
	Если ОписаниеСвойств.Свойство("Удержание") И ТипЗнч(ОписаниеСвойств.Удержание) = Тип("Структура") Тогда
		Возврат ОписаниеСвойств.Удержание;
	КонецЕсли;
	Имя = "СвязьУдержана_" + Строка(ОписаниеСвойств.СвойствоСтатуса.УникальныйИдентификатор());
	Значения = НастройкаЭДО(Имя);
	Если ТипЗнч(Значения) <> Тип("Соответствие") Тогда
		Значения = Новый Соответствие;
	КонецЕсли;
	Итог = Новый Структура("Имя, Значения", Имя, Значения);
	Если ОписаниеСвойств.Свойство("Удержание") Тогда
		ОписаниеСвойств.Удержание = Итог;
	КонецЕсли;
	Возврат Итог;
КонецФункции

// Завести свойства статуса связи учетных записей (у основной тоже). Новое свойство получает ссылку из
// имени (см. СсылкаСвойстваПоИмени), тип и назначение - с прежних ЭДО_СтатусСвязи/ЭДО_СвязьПроверена,
// а значения - с прежнего свойства этой записи: до первого опроса оператора статусы те же, что были.
Функция ОбеспечитьСвойстваСвязиОрганизаций() Экспорт

	Итог = Новый Массив;
	ОбразецСтатуса = СвойствоОбъектов("ЭДО_СтатусСвязи");
	ОбразецПроверки = СвойствоОбъектов("ЭДО_СвязьПроверена");

	Для Каждого Описание Из СвойстваСвязиОрганизаций() Цикл
		Если Описание.КлючСтатуса = Неопределено Тогда
			// без идентификатора участника - прежняя схема
			Если НЕ Описание.Основная Тогда
				ОбеспечитьСвойствоПоОбразцу(Описание.ИмяСтатуса, Описание.СвойствоСтатуса, ОбразецСтатуса, Итог);
				ОбеспечитьСвойствоПоОбразцу(Описание.ИмяПроверки, Описание.СвойствоПроверки, ОбразецПроверки, Итог);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если Описание.СвойствоСтатуса <> Описание.КлючСтатуса Тогда
			ЗавестиСвойствоСПереносом(Описание.ИмяСтатуса, Описание.КлючСтатуса, Описание.СвойствоСтатуса, ОбразецСтатуса, Итог,
				Описание.ПрежнееИмяСтатуса);
		КонецЕсли;
		Если Описание.СвойствоПроверки <> Описание.КлючПроверки Тогда
			ЗавестиСвойствоСПереносом(Описание.ИмяПроверки, Описание.КлючПроверки, Описание.СвойствоПроверки, ОбразецПроверки, Итог,
				Описание.ПрежнееИмяПроверки);
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

// ЩА 20.10.2026 [yan], ревью Codex 860: свойство и перенос всех его значений - одной транзакцией под
// исключительной блокировкой обоих свойств. Читатели переходят на новое свойство по факту его существования
// и не должны увидеть его наполовину пустым (особенно без ручного NOT_REQUIRED). Сбой - откат целиком,
// при следующем прогоне попытка заново; ошибка - в ЖР и в итог.
// Свойство заводится, если его нет; значения переносятся, если эта база их еще не переносила (свойство могло
// приехать по обмену уже заведенным). Признак переноса ставится в той же транзакции.
Процедура ЗавестиСвойствоСПереносом(Знач Имя, Знач Ссылка, Знач Источник, Знач Образец, Итог, Знач ПрежнееИмя = "")
	ИтогПопытки = Новый Массив;
	Если Источник = Ссылка ИЛИ Источник = Неопределено ИЛИ Источник.Пустая() Тогда
		Источник = СвойствоОбъектов(ПрежнееИмя);
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Свойства = Новый Массив;
		Свойства.Добавить(Ссылка);
		Если Источник <> Неопределено И НЕ Источник.Пустая() Тогда
			Свойства.Добавить(Источник);
		КонецЕсли;
		Для Каждого Свойство Из Свойства Цикл
			Элемент = Блокировка.Добавить("РегистрСведений.ЗначенияСвойствОбъектов");
			Элемент.УстановитьЗначение("Свойство", Свойство);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		КонецЦикла;
		Блокировка.Заблокировать();
		ЗавестиСвойствоСоСсылкой(Имя, Ссылка, Образец, ИтогПопытки);
		ПеренестиЗначенияСвойства(Источник, Ссылка, Имя, ИтогПопытки);
		Перенесенные = ПереносыСвязиВыполненные();
		Перенесенные.Вставить(Строка(Ссылка.УникальныйИдентификатор()), ТекущаяДатаСеанса());
		ЗаписатьОбщуюНастройкуЭДО("ПереносСвязиВыполнен", Перенесенные);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации("ЭДО.Связи", УровеньЖурналаРегистрации.Ошибка, , ,
			"Свойство " + Имя + " не заведено (откат вместе с переносом значений): " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Итог.Добавить("НЕ УДАЛОСЬ завести " + Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	Для Каждого СтрокаИтога Из ИтогПопытки Цикл
		Итог.Добавить(СтрокаИтога);
	КонецЦикла;
КонецПроцедуры

// Возврат: Истина - свойство заведено этим вызовом.
Функция ЗавестиСвойствоСоСсылкой(Знач Имя, Знач Ссылка, Знач Образец, Итог)
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект <> Неопределено Тогда
		Если Объект.ПометкаУдаления Тогда
			Объект.УстановитьПометкуУдаления(Ложь);
			Итог.Добавить("снята пометка удаления: " + Имя);
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	Объект = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
	Объект.УстановитьСсылкуНового(Ссылка);
	Объект.Наименование = Имя;
	Если Образец <> Неопределено И НЕ Образец.Пустая() Тогда
		Объект.ТипЗначения = Образец.ТипЗначения;
		Объект.НазначениеСвойства = Образец.НазначениеСвойства;
	Иначе
		Объект.ТипЗначения = ТипСвойстваПоИмени(Имя);
	КонецЕсли;
	Объект.Записать();
	Итог.Добавить("заведено: " + Имя);
	Возврат Истина;
КонецФункции

// Значения прежнего свойства - в новое, где в новом значения еще нет.
Процедура ПеренестиЗначенияСвойства(Знач Источник, Знач Приемник, Знач Имя, Итог)
	Если Источник = Неопределено ИЛИ Источник.Пустая() Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Ист.Объект КАК Объект, Ист.Значение КАК Значение
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов КАК Ист
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Прм
		|	ПО Прм.Объект = Ист.Объект И Прм.Свойство = &Приемник
		|ГДЕ Ист.Свойство = &Источник
		|	И (Прм.Объект ЕСТЬ NULL ИЛИ ВЫРАЗИТЬ(Ист.Значение КАК СТРОКА(50)) = &НеТребуется)");
	Запрос.УстановитьПараметр("НеТребуется", СтатусСвязиНеТребуется());
	Запрос.УстановитьПараметр("Источник", Источник);
	Запрос.УстановитьПараметр("Приемник", Приемник);
	Выборка = Запрос.Выполнить().Выбрать();
	Перенесено = 0;
	Пока Выборка.Следующий() Цикл
		ЗаписатьЗначениеСвойства(Выборка.Объект, Приемник, Выборка.Значение);
		Перенесено = Перенесено + 1;
	КонецЦикла;
	Итог.Добавить(Имя + ": перенесено значений " + Перенесено + " из " + Строка(Источник));
КонецПроцедуры

Процедура ОбеспечитьСвойствоПоОбразцу(Знач Имя, Знач Текущее, Знач Образец, Итог)

	Если Текущее <> Неопределено И НЕ Текущее.Пустая() Тогда
		Возврат;
	КонецЕсли;
	// ЩА 15.10.2026 [yan]: наименование длиннее предела плана видов характеристик (50) записывается
	// обрезанным, и поиск по полному имени его не находит - каждый вызов заводил свойство заново,
	// а учетные записи с одним идентификатором участника давали по дублю на запись. Перед созданием
	// ищем по имени в том виде, в каком оно будет записано.
	ИмяЗаписи = Лев(Имя, Метаданные.ПланыВидовХарактеристик.СвойстваОбъектов.ДлинаНаименования);
	Записанное = СвойствоОбъектов(ИмяЗаписи);
	Если НЕ Записанное.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Объект = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
		Объект.Наименование = Имя;
		Если Образец <> Неопределено И НЕ Образец.Пустая() Тогда
			Объект.ТипЗначения = Образец.ТипЗначения;
			Объект.НазначениеСвойства = Образец.НазначениеСвойства;
		Иначе
			Объект.ТипЗначения = ТипСвойстваПоИмени(Имя);
		КонецЕсли;
		Объект.Записать();
		Итог.Добавить("заведено: " + Имя);
	Исключение
		Итог.Добавить("НЕ УДАЛОСЬ завести " + Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Закреплен ли адрес ЭДО - выбран явно и регламентом не пересматривается. Из нескольких живых
// адресов правильный алгоритмически не выбрать; надежное доказательство - принятый контрагентом
// документ. Фактические маршруты - лишь подсказка для первичного заполнения.
Функция АдресЭДОЗакреплён(Контрагент) Экспорт
	Свойство = СвойствоОбъектов("ЭДО_АдресЗакреплён");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Значение КАК Значение
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Объект = &Объект И Свойство = &Свойство");
	Запрос.УстановитьПараметр("Объект", Контрагент);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение = Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

// Закрепить за контрагентом адрес ЭДО. Пустой Адрес = закрепить тот, что стоит сейчас.
// Основание пишется рядом, чтобы в карточке было видно, откуда взялось решение.
// 50 символов - потолок строкового типа самого ПВХ СвойстваОбъектов, не наш выбор.
Процедура ЗакрепитьАдресЭДО(Контрагент, Знач Адрес = "", Знач Основание = "") Экспорт
	СвФлаг = СвойствоОбъектов("ЭДО_АдресЗакреплён");
	СвОсн  = СвойствоОбъектов("ЭДО_ЗакреплениеОснование");
	СвАдр  = СвойствоОбъектов("ЭДО_АдресКонтрагента");
	Если СвФлаг = Неопределено ИЛИ СвФлаг.Пустая() Тогда
		ВызватьИсключение "Свойство ЭДО_АдресЗакреплён не заведено в базе";
	КонецЕсли;
	Если ЗначениеЗаполнено(Адрес) И СвАдр <> Неопределено И НЕ СвАдр.Пустая() Тогда
		ЗаписатьЗначениеСвойства(Контрагент, СвАдр, ВРег(СокрЛП(Адрес)));
	КонецЕсли;
	ЗаписатьЗначениеСвойства(Контрагент, СвФлаг, Истина);
	Если ЗначениеЗаполнено(Основание) И СвОсн <> Неопределено И НЕ СвОсн.Пустая() Тогда
		ЗаписатьЗначениеСвойства(Контрагент, СвОсн, Лев(Основание, 50));
	КонецЕсли;
КонецПроцедуры

// Снять закрепление - вернуть контрагента под управление регламента.
Процедура СнятьЗакреплениеАдресаЭДО(Контрагент) Экспорт
	СвФлаг = СвойствоОбъектов("ЭДО_АдресЗакреплён");
	Если СвФлаг <> Неопределено И НЕ СвФлаг.Пустая() Тогда
		ЗаписатьЗначениеСвойства(Контрагент, СвФлаг, Ложь);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ФактическиеМаршруты

// Фактический маршрут контрагента - адрес, на который мы реально отправляли через прежнего
// оператора (из локального архива ЭДО). Самый достоверный источник: у контрагента бывает
// несколько адресов, и живая связь может быть не с тем, который он читает.
Функция ФактическийМаршрут(Знач ИНН) Экспорт
	Маршруты = ЗагрузитьФактическиеМаршруты();
	Значение = Маршруты[СокрЛП(ИНН)];
	Возврат ?(Значение = Неопределено, "", Строка(Значение));
КонецФункции

Функция ЗагрузитьФактическиеМаршруты() Экспорт
	// Общие настройки лежат под пользователем "": для обычного пользователя это чужой слот, без привилегий - «Нарушение прав доступа».
	УстановитьПривилегированныйРежим(Истина);
	Значение = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", "ФактическиеМаршруты", , "");
	Возврат ?(ТипЗнч(Значение) = Тип("Соответствие"), Значение, Новый Соответствие);
КонецФункции

// Загрузка справочника маршрутов (ИНН;адрес построчно). Возвращает число принятых строк.
Функция ЗагрузитьМаршрутыИзТекста(Знач Текст) Экспорт
	ПроверитьПравоМенятьНастройкиЭДО();   // ЩА 19.10.2026 [yan]: пишет в общий раздел
	// Общие настройки лежат под пользователем "": для обычного пользователя это чужой слот, без привилегий - «Нарушение прав доступа».
	УстановитьПривилегированныйРежим(Истина);
	Маршруты = Новый Соответствие;
	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС) Цикл
		Части = СтрРазделить(СокрЛП(Строка), ";");
		Если Части.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		ИНН = СокрЛП(Части[0]);
		Адрес = СокрЛП(Части[1]);
		Если ЗначениеЗаполнено(ИНН) И ЗначениеЗаполнено(Адрес) Тогда
			Маршруты.Вставить(ИНН, Адрес);
		КонецЕсли;
	КонецЦикла;
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", "ФактическиеМаршруты", Маршруты, , "");
	Возврат Маршруты.Количество();
КонецФункции

#КонецОбласти

#Область ПричиныНеотправки

// Тексты, которые ЭТОТ механизм ведет в колонке "ЭДО" (свойство ЭДО_Состояние).
// Набор нужен, чтобы отличать свою строку от чужой: ту же колонку пишет PEDO-StatusSync
// (ход отправки по данным Платформы) и сама отправка ("Отправка не требуется").
// Свое значение перезаписываем свободно, чужое не трогаем никогда - иначе механизм,
// задуманный как подсказка, начнет стирать реальный статус документа.
Функция ТекстыПричинНеотправки() Экспорт
	Тексты = Новый Массив;
	Тексты.Добавить("Отправляется");
	Тексты.Добавить("В очереди на отправку");
	Тексты.Добавить(ТекстОтправленДругимОператором());
	Тексты.Добавить("Не отправлен: нет адреса ЭДО");
	Тексты.Добавить("Не отправлен: нет связи с контрагентом");
	Тексты.Добавить("Не отправлен: приглашение не принято");
	Тексты.Добавить("Не отправлен: связь разорвана");
	Тексты.Добавить("Не отправлен: связь ещё не проверена");
	Тексты.Добавить("Взят в отправку, прогон не завершен");
	Тексты.Добавить("Состояние у оператора неизвестно");
	Тексты.Добавить("Не отправлен: не в бухучете");
	Тексты.Добавить("Не отправлен: заказ не отгружен");
	Тексты.Добавить("Не отправлен: ждёт печати или пометки");
	Тексты.Добавить(ТекстЗапретаПоОрганизации());
	Тексты.Добавить(ТекстПаузыКонтрагента());
	Тексты.Добавить(ТекстВнеСпискаАвтоотправки());
	Тексты.Добавить(ТекстНетАдресаПокупателя());
	Для Каждого Канал Из ИменаКаналовВнеАвтовыбора() Цикл
		Тексты.Добавить(ТекстУдержанияКанала(Канал));
	КонецЦикла;
	// корректировки реализации (УКД), см. ОбновитьПричиныНеотправкиКорректировок
	Тексты.Добавить(ТекстИсходникНеОтправлен());
	Тексты.Добавить(ТекстИсходникНеПодписан());
	Тексты.Добавить(ТекстКорректировкаНеУКД());
	Тексты.Добавить(ТекстКорректировкаБезИзменений());
	Тексты.Добавить(ПрефиксОжиданияПроверкиУКД());
	Возврат Тексты;
КонецФункции

// Тексты колонки для корректировки, удержанной гейтами автоотправки УКД. Длиннее 50 символов
// нельзя: колонка - свойство Строка(50). Развернутая причина - в ПричинаУдержанияКорректировки.
Функция ТекстИсходникНеОтправлен() Экспорт
	Возврат "Не отправлен: исходник не отправлен";
КонецФункции

Функция ТекстИсходникНеПодписан() Экспорт
	Возврат "Не отправлен: исходник не подписан";
КонецФункции

Функция ТекстКорректировкаНеУКД() Экспорт
	Возврат "Не отправлен: исправление, вручную";
КонецФункции

Функция ТекстКорректировкаБезИзменений() Экспорт
	Возврат "Не отправлен: нет изменений";
КонецФункции

// Начало текста колонки у корректировки, выжидающей паузу перед автоотправкой. Время окончания
// входит в текст, поэтому свою строку механизм узнает по началу, а не по точному совпадению.
Функция ПрефиксОжиданияПроверкиУКД() Экспорт
	Возврат "Ждет проверки";
КонецФункции

Функция ТекстОжиданияПроверкиУКД(Знач Окончание) Экспорт
	Если НЕ ЗначениеЗаполнено(Окончание) Тогда
		Возврат ПрефиксОжиданияПроверкиУКД();
	КонецЕсли;
	Возврат ПрефиксОжиданияПроверкиУКД() + " до " + Формат(Окончание, "ДФ=HH:mm");
КонецФункции

// Названия каналов вне автовыбора для набора текстов колонки. Текст удержания зависит от
// канала, а набор обязан знать все его варианты: неизвестную строку механизм считает чужой
// и больше не обновляет.
Функция ИменаКаналовВнеАвтовыбора() Экспорт
	Имена = Новый Массив;
	Имена.Добавить(ИмяКаналаЭДО("2LT"));
	Имена.Добавить(ИмяКаналаЭДО("2VO"));
	Имена.Добавить(ИмяКаналаЭДО("2IM"));
	Имена.Добавить(ИмяКаналаЭДО(""));
	Возврат Имена;
КонецФункции

// Текст колонки для документа, удержанного каналом вне автовыбора.
// Свойство ЭДО_Состояние имеет тип Строка(50), поэтому формулировка короткая; развернутая
// причина с адресом остается за ПроверитьГотовностьКОтправке и видна в карточке.
Функция ТекстУдержанияКанала(Знач ИмяКанала) Экспорт
	Возврат Лев("Не отправлен: " + ИмяКанала + " без закрепления", 50);
КонецФункции

// Тексты, которые механизм писал раньше: нужны, чтобы узнать собственную старую строку
// и перезаписать ее актуальной, иначе после смены формулировки она навсегда останется чужой.
Функция УстаревшиеТекстыПричин() Экспорт
	Тексты = Новый Массив;
	Тексты.Добавить("Ждём, пока контрагент примет приглашение");
	Тексты.Добавить("Заказ ещё не отгружен");
	Тексты.Добавить("Не отражается в бухучёте");
	Тексты.Добавить("Взят в отправку, прогон не завершён");
	// ЩА 15.10.2026 [yan]: формулировки до перехода на «Не отправлен: …».
	Для Каждого КЗ Из ПрежниеТекстыПричин() Цикл
		Тексты.Добавить(КЗ.Ключ);
	КонецЦикла;
	Возврат Тексты;
КонецФункции

// Префикс для незнакомого статуса связи: показываем как есть. Проверка "свое ли значение"
// учитывает и его, иначе механизм сочтет собственную строку чужой и перестанет ее обновлять.
Функция ПрефиксПричиныСвязи() Экспорт
	Возврат "Не отправлен: связь ";
КонецФункции

