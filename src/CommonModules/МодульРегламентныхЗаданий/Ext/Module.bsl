// Ключ прогона отправки очереди.
//
// ⚠️🔴 Он передаётся ПАРАМЕТРОМ задания, а не полем «Ключ». Поле «Ключ» экземпляра платформа
//    в обработчик не отдаёт вовсе: задание с пустой коллекцией параметров падает с
//    «Недостаточно фактических параметров для метода фонового задания» (поймано на первом же
//    автосрабатывании 07.09.2026 17:15). ⟹ у экземпляра ОБЯЗАН быть один параметр с этим
//    значением; поле «Ключ» заполняем тем же текстом только ради читаемости в консоли заданий.
// ⚠️ Значение живёт в ДВУХ местах — здесь и в параметре задания в базе. Разойдутся — задание
//    пойдёт типовым путём, не найдёт учётную запись и молча выйдет: ни ошибки, ни отправки.
//    Признак: задание отработало за 0 секунд, а в журнале регистрации нет строки «ЭДО, отправка».
Функция ЭДО_КлючОтправкиОчереди() Экспорт
	Возврат "ЭДО_ОтправкаОчереди";
КонецФункции

// Ключи остальных регламентов ЭДО, висящих на том же носителе.
//
// ⭐🔑 НОСИТЕЛЬ ОДИН НА ВСЕ РЕГЛАМЕНТЫ. Задание не предопределённое, а значит допускает
//    СКОЛЬКО УГОДНО экземпляров (проверено пробой на боевой 07.09.2026: создали второй,
//    увидели оба, удалили). У каждого экземпляра своё расписание, своё наименование
//    и свой параметр ⟹ семь регламентов ЭДО живут на одном перехвате.
// 🎯 Это оказалось не роскошью, а необходимостью: свободных типовых заданий в базе
//    осталось ПЯТЬ на шесть переносимых регламентов, и путь «каждому свой носитель»
//    просто не сходился. Заодно не понадобилось заимствовать ещё модули ради их методов.
// ⚠️ Наименование каждого экземпляра начинается с «ЭДО: » (просьба оператора 07.09.2026):
//    в консоли заданий их 53 штуки, и свои должны быть видны одним взглядом.
Функция ЭДО_КлючиРегламентов() Экспорт
	Ключи = Новый Соответствие;
	Ключи.Вставить("ЭДО_ОтправкаОчереди",   "отправка очереди");
	Ключи.Вставить("ЭДО_СверкаСтатусов",    "сверка статусов у оператора");
	Ключи.Вставить("ЭДО_ОбновлениеСвязей",  "обновление связей и адресов");
	Ключи.Вставить("ЭДО_СторожНеПринятых",  "сторож «доставлено, но не принято»");
	Ключи.Вставить("ЭДО_СторожПаузы",       "сторож паузы по контрагентам");
	Ключи.Вставить("ЭДО_СторожГИСМТ",       "обход ГИС МТ");
	Ключи.Вставить("ЭДО_СторожСвязей",      "утренний контроль связей");
	Возврат Ключи;
КонецФункции

&Вместо("ВыполнитьОбменДаннымиЭлектроннымиДокументами")
Процедура ЭДО_ВыполнитьОбменДаннымиЭлектроннымиДокументами(КодНастройки)

	Ключ = ВРег(СокрЛП(Строка(КодНастройки)));

	// ⚠️🔴 Старый префикс ПЭДО_ принимается НАРАВНЕ с новым. Переименование 07.09.2026 меняет
	//    ключи и в коде, и в семи экземплярах задания в базе, а сделать это одной секундой
	//    нельзя. Без этой строки в промежутке между выкаткой и правкой заданий каждый регламент
	//    уходил бы в ПродолжитьВызов — то есть молча не делал бы НИЧЕГО, включая отправку.
	// 🔑 Убрать, когда ключи заданий в обеих базах переедут на ЭДО_.
	Если Лев(Ключ, 5) = "ПЭДО_" Тогда
		Ключ = "ЭДО_" + Сред(Ключ, 6);
	КонецЕсли;

	Если Ключ = ВРег("ЭДО_ОтправкаОчереди") Тогда
		ЭДО_Регламенты.ОтправитьОчередь();
	ИначеЕсли Ключ = ВРег("ЭДО_СверкаСтатусов") Тогда
		ЭДО_Регламенты.ВыполнитьСверкуСтатусов();
	ИначеЕсли Ключ = ВРег("ЭДО_ОбновлениеСвязей") Тогда
		ЭДО_Регламенты.ВыполнитьОбновлениеСвязей();
	ИначеЕсли Ключ = ВРег("ЭДО_СторожНеПринятых") Тогда
		ЭДО_Сторожа.ВыполнитьСторожНеПринятых();
	ИначеЕсли Ключ = ВРег("ЭДО_СторожПаузы") Тогда
		ЭДО_Сторожа.ВыполнитьСторожПаузы();
	ИначеЕсли Ключ = ВРег("ЭДО_СторожГИСМТ") Тогда
		ЭДО_Сторожа.ВыполнитьСторожГИСМТ();
	ИначеЕсли Ключ = ВРег("ЭДО_СторожСвязей") Тогда
		ЭДО_Сторожа.ВыполнитьСторожСвязей();
	Иначе
		// чужой ключ — типовое поведение нетронуто
		ПродолжитьВызов(КодНастройки);
	КонецЕсли;

	// ⚠️ Разводка написана явными сравнениями, а не вызовом по имени через Вычислить():
	//    опечатка в имени метода тогда падала бы РАНТАЙМНО и только у того регламента,
	//    чей ключ сработал, — то есть в бою и по одному. Здесь её ловит компиляция.

КонецПроцедуры
