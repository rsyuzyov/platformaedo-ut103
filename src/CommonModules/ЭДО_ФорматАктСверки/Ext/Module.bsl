////////////////////////////////////////////////////////////////////////////////
// ЭДО_ФорматАктСверки — формирование XML акта сверки взаимных расчетов
// по формату ФНС (приказ от 13.05.2022 N ЕД-7-26/405@, версия формата 5.01,
// КНД 1110332). Титул отправителя — ON_AKTSVEROTP.
//
// 🔑 Модуль НЕ ЗНАЕТ НИЧЕГО о конфигурации, в которой работает: на входе только
// примитивы и структуры (строки, числа, даты, массивы), на выходе — текст XML.
// Ни одного обращения к метаданным, справочникам и документам здесь быть не должно
// — тогда модуль переносится в любую базу (УТ 10.3, УТ 11, БП, УПП, moroz) как есть,
// а привязка к конкретной конфигурации живёт в отдельном слое-сборщике данных.
//
// Порядок работы:
//   Акт = ЭДО_ФорматАктСверки.НовыйАкт();
//   ... заполнить шапку, участников, договоры/документы/операции ...
//   ЭДО_ФорматАктСверки.ПересчитатьИтоги(Акт);          // сальдо и обороты
//   Ошибки = ЭДО_ФорматАктСверки.ПроверитьЗаполнение(Акт);
//   ТекстXML = ЭДО_ФорматАктСверки.СформироватьXML(Акт);
//
// ⚠️ Схема требует иерархию «договор → документ → операция»: каждая строка акта
//    обязана лежать внутри документа, а документ — внутри договора. Строки без
//    договора собирать в один ДогСв без реквизитов договора.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Пустая структура акта. Заполняется вызывающим кодом.
//
// Возвращаемое значение:
//  Структура - контракт данных формата:
//   * ИдФайл          - Строка - имя файла обмена без расширения (см. ИмяФайлаОбмена)
//   * ВерсПрог        - Строка - версия программы-отправителя, до 40 символов
//   * НомерАкт        - Строка - номер акта
//   * ДатаИнфОтпр     - Дата   - дата и время формирования файла отправителем
//   * ДатаНачПер      - Дата   - начало периода сверки
//   * ДатаОкПер       - Дата   - конец периода сверки
//   * КодОКВ          - Строка - код валюты по ОКВ, 3 цифры (рубль — "643")
//   * Отправитель     - Структура - см. НовыйУчастник
//   * Получатель      - Структура - см. НовыйУчастник
//   * Договоры        - Массив - элементы см. НовыйДоговор
//   * Подписант       - Структура - см. НовыйПодписант
//   * Итоги           - Структура - итоги по акту, заполняет ПересчитатьИтоги
Функция НовыйАкт() Экспорт

	Акт = Новый Структура;
	Акт.Вставить("ИдФайл",      "");
	Акт.Вставить("ВерсПрог",    "1C:Enterprise");
	Акт.Вставить("НомерАкт",    "");
	Акт.Вставить("ДатаИнфОтпр", ТекущаяДата());
	Акт.Вставить("ДатаНачПер",  '00010101');
	Акт.Вставить("ДатаОкПер",   '00010101');
	Акт.Вставить("КодОКВ",      "643");
	Акт.Вставить("Отправитель", НовыйУчастник());
	Акт.Вставить("Получатель",  НовыйУчастник());
	Акт.Вставить("Договоры",    Новый Массив);
	Акт.Вставить("Подписант",   НовыйПодписант());
	Акт.Вставить("Итоги",       НовыеИтоги());

	Возврат Акт;

КонецФункции

// Пустая структура участника (отправителя или получателя).
//
// Возвращаемое значение:
//  Структура:
//   * Вид        - Строка - "ЮЛ" | "ИП" | "ФЛ" | "ИнНеУч" (иностранное лицо, не состоящее на учёте)
//   * НаимОрг    - Строка - наименование, для ЮЛ и ИнНеУч
//   * ИНН        - Строка - 10 цифр для ЮЛ, 12 для ИП и ФЛ
//   * КПП        - Строка - только для ЮЛ
//   * ОГРН       - Строка - только для ЮЛ
//   * ОГРНИП     - Строка - только для ИП
//   * Фамилия, Имя, Отчество - Строка - для ИП и ФЛ
//   * Идентиф    - Строка - идентификатор иностранного лица, для ИнНеУч
//   * ИныеСвед   - Строка - для ИнНеУч
//   * ОКПО, СтруктПодр, ИнфДляУчаст - Строка - необязательные
//   * Телефон, ЭлПочта, ИнКонт      - Строка - необязательные
Функция НовыйУчастник() Экспорт

	Участник = Новый Структура;
	Участник.Вставить("Вид",          "ЮЛ");
	Участник.Вставить("НаимОрг",      "");
	Участник.Вставить("ИНН",          "");
	Участник.Вставить("КПП",          "");
	Участник.Вставить("ОГРН",         "");
	Участник.Вставить("ОГРНИП",       "");
	Участник.Вставить("Фамилия",      "");
	Участник.Вставить("Имя",          "");
	Участник.Вставить("Отчество",     "");
	Участник.Вставить("Идентиф",      "");
	Участник.Вставить("ИныеСвед",     "");
	Участник.Вставить("ОКПО",         "");
	Участник.Вставить("СтруктПодр",   "");
	Участник.Вставить("ИнфДляУчаст",  "");
	Участник.Вставить("Телефон",      "");
	Участник.Вставить("ЭлПочта",      "");
	Участник.Вставить("ИнКонт",       "");

	Возврат Участник;

КонецФункции

// Пустая структура сведений о договоре — верхний уровень таблицы акта.
//
// Возвращаемое значение:
//  Структура:
//   * ИдДог       - Строка - идентификатор договора в системе отправителя
//   * ОписТипДог  - Строка - описание типа договора («Договор поставки»)
//   * НомДог      - Строка - номер договора
//   * ДатаДог     - Дата   - дата договора
//   * Документы   - Массив - элементы см. НовыйДокументРасчетов
//   * Итоги       - Структура - итоги по договору, заполняет ПересчитатьИтоги
Функция НовыйДоговор() Экспорт

	Договор = Новый Структура;
	Договор.Вставить("ИдДог",      "");
	Договор.Вставить("ОписТипДог", "");
	Договор.Вставить("НомДог",     "");
	Договор.Вставить("ДатаДог",    '00010101');
	Договор.Вставить("Документы",  Новый Массив);
	Договор.Вставить("Итоги",      НовыеИтоги());

	Возврат Договор;

КонецФункции

// Пустая структура сведений о документе расчётов.
//
// Возвращаемое значение:
//  Структура:
//   * НаимДок  - Строка - наименование документа («Реализация товаров и услуг»), до 100 символов
//   * НомДок   - Строка - номер документа, до 50 символов
//   * ДатаДок  - Дата   - дата документа
//   * ИдДок    - Строка - идентификатор документа в системе отправителя
//   * ДопИнф   - Строка - дополнительная информация
//   * Операции - Массив - элементы см. НоваяОперация
Функция НовыйДокументРасчетов() Экспорт

	ДокументРасчетов = Новый Структура;
	ДокументРасчетов.Вставить("НаимДок",  "");
	ДокументРасчетов.Вставить("НомДок",   "");
	ДокументРасчетов.Вставить("ДатаДок",  '00010101');
	ДокументРасчетов.Вставить("ИдДок",    "");
	ДокументРасчетов.Вставить("ДопИнф",   "");
	ДокументРасчетов.Вставить("Операции", Новый Массив);

	Возврат ДокументРасчетов;

КонецФункции

// Пустая структура операции — строки акта сверки.
//
// Возвращаемое значение:
//  Структура:
//   * НомСтр    - Число  - номер строки, до 6 разрядов; 0 = проставить сквозной нумерацией
//   * ДатаОпер  - Дата   - дата операции
//   * НаимОпер  - Строка - наименование операции, до 500 символов
//   * СумДебет  - Число  - сумма по дебету
//   * СумКредит - Число  - сумма по кредиту
Функция НоваяОперация() Экспорт

	Операция = Новый Структура;
	Операция.Вставить("НомСтр",    0);
	Операция.Вставить("ДатаОпер",  '00010101');
	Операция.Вставить("НаимОпер",  "");
	Операция.Вставить("СумДебет",  0);
	Операция.Вставить("СумКредит", 0);

	Возврат Операция;

КонецФункции

// Пустая структура подписанта.
//
// Возвращаемое значение:
//  Структура:
//   * Фамилия, Имя, Отчество - Строка
//   * Должн      - Строка - должность
//   * СтатПодп   - Строка - статус подписанта по формату
//   * ТипПодпис  - Строка - тип подписи по формату
//   * ИдСистХран - Строка - идентификатор системы хранения
//   * НомДовер, ДатаНачДовер, ВнНомДовер, ДатаВнРегДовер, СведСистОтм - реквизиты МЧД
Функция НовыйПодписант() Экспорт

	Подписант = Новый Структура;
	Подписант.Вставить("Фамилия",         "");
	Подписант.Вставить("Имя",             "");
	Подписант.Вставить("Отчество",        "");
	Подписант.Вставить("Должн",           "");
	Подписант.Вставить("СтатПодп",        "");
	Подписант.Вставить("ТипПодпис",       "");
	Подписант.Вставить("ИдСистХран",      "");
	Подписант.Вставить("НомДовер",        "");
	Подписант.Вставить("ДатаНачДовер",    '00010101');
	Подписант.Вставить("ВнНомДовер",      "");
	Подписант.Вставить("ДатаВнРегДовер",  '00010101');
	Подписант.Вставить("СведСистОтм",     "");

	Возврат Подписант;

КонецФункции

// Считает итоги по операциям — снизу вверх: сначала по каждому договору, затем по акту.
// Схема требует все шесть показателей на обоих уровнях, поэтому считать их обязательно.
//
// Начальное сальдо берётся из уже заполненного Итоги.СальдоНачДеб / СальдоНачКр
// (его знает только вызывающий код — это остаток на начало периода), обороты и
// конечное сальдо вычисляются здесь.
//
// Параметры:
//  Акт - Структура - см. НовыйАкт, изменяется по ссылке
Процедура ПересчитатьИтоги(Акт) Экспорт

	ОборотДебАкт    = 0;
	ОборотКрАкт     = 0;
	СальдоНачДебАкт = 0;
	СальдоНачКрАкт  = 0;

	Для Каждого Договор Из Акт.Договоры Цикл

		ОборотДеб = 0;
		ОборотКр  = 0;

		Для Каждого ДокументРасчетов Из Договор.Документы Цикл
			Для Каждого Операция Из ДокументРасчетов.Операции Цикл
				ОборотДеб = ОборотДеб + Операция.СумДебет;
				ОборотКр  = ОборотКр  + Операция.СумКредит;
			КонецЦикла;
		КонецЦикла;

		Договор.Итоги.ОборотДеб = ОборотДеб;
		Договор.Итоги.ОборотКр  = ОборотКр;

		// Конечное сальдо сворачивается: показатель остаётся ровно один из двух.
		Остаток = Договор.Итоги.СальдоНачДеб - Договор.Итоги.СальдоНачКр + ОборотДеб - ОборотКр;
		Договор.Итоги.СальдоКонДеб = ?(Остаток > 0, Остаток, 0);
		Договор.Итоги.СальдоКонКр  = ?(Остаток < 0, -Остаток, 0);

		СальдоНачДебАкт = СальдоНачДебАкт + Договор.Итоги.СальдоНачДеб;
		СальдоНачКрАкт  = СальдоНачКрАкт  + Договор.Итоги.СальдоНачКр;
		ОборотДебАкт    = ОборотДебАкт    + ОборотДеб;
		ОборотКрАкт     = ОборотКрАкт     + ОборотКр;

	КонецЦикла;

	// По акту начальное сальдо — сумма договорных, если вызывающий код не задал своё.
	Если Акт.Итоги.СальдоНачДеб = 0 И Акт.Итоги.СальдоНачКр = 0 Тогда
		Акт.Итоги.СальдоНачДеб = СальдоНачДебАкт;
		Акт.Итоги.СальдоНачКр  = СальдоНачКрАкт;
	КонецЕсли;

	Акт.Итоги.ОборотДеб = ОборотДебАкт;
	Акт.Итоги.ОборотКр  = ОборотКрАкт;

	ОстатокАкт = Акт.Итоги.СальдоНачДеб - Акт.Итоги.СальдоНачКр + ОборотДебАкт - ОборотКрАкт;
	Акт.Итоги.СальдоКонДеб = ?(ОстатокАкт > 0, ОстатокАкт, 0);
	Акт.Итоги.СальдоКонКр  = ?(ОстатокАкт < 0, -ОстатокАкт, 0);

КонецПроцедуры

// Проверяет заполнение обязательных по схеме реквизитов.
// Дешевле поймать это здесь, чем получить отказ ФЛК у оператора без внятной причины.
//
// Параметры:
//  Акт - Структура - см. НовыйАкт
//
// Возвращаемое значение:
//  Массив из Строка - описания ошибок; пустой массив = заполнение корректно
Функция ПроверитьЗаполнение(Акт) Экспорт

	Ошибки = Новый Массив;

	Если Не ЗначениеЗаполнено(Акт.НомерАкт) Тогда
		Ошибки.Добавить("Не заполнен номер акта (НомерАкт)");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Акт.ДатаНачПер) Или Не ЗначениеЗаполнено(Акт.ДатаОкПер) Тогда
		Ошибки.Добавить("Не заполнен период сверки (ДатаНачПер / ДатаОкПер)");
	КонецЕсли;
	Если СтрДлина(Акт.КодОКВ) <> 3 Тогда
		Ошибки.Добавить("Код валюты должен быть из трёх цифр, получено: " + Акт.КодОКВ);
	КонецЕсли;

	ПроверитьУчастника(Акт.Отправитель, "отправителя", Ошибки);
	ПроверитьУчастника(Акт.Получатель,  "получателя",  Ошибки);

	Если Акт.Договоры.Количество() = 0 Тогда
		Ошибки.Добавить("В акте нет ни одного договора — таблица акта не может быть пустой");
	КонецЕсли;

	НомерДоговора = 0;
	Для Каждого Договор Из Акт.Договоры Цикл
		НомерДоговора = НомерДоговора + 1;
		Если Договор.Документы.Количество() = 0 Тогда
			Ошибки.Добавить("Договор " + НомерДоговора + ": нет ни одного документа расчётов");
		КонецЕсли;
		Для Каждого ДокументРасчетов Из Договор.Документы Цикл
			Если Не ЗначениеЗаполнено(ДокументРасчетов.НаимДок) Тогда
				Ошибки.Добавить("Договор " + НомерДоговора + ": у документа не заполнено наименование (НаимДок)");
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ДокументРасчетов.НомДок) Тогда
				Ошибки.Добавить("Договор " + НомерДоговора + ": у документа «" + ДокументРасчетов.НаимДок + "» не заполнен номер (НомДок)");
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ДокументРасчетов.ДатаДок) Тогда
				Ошибки.Добавить("Договор " + НомерДоговора + ": у документа «" + ДокументРасчетов.НаимДок + "» не заполнена дата (ДатаДок)");
			КонецЕсли;
			Если ДокументРасчетов.Операции.Количество() = 0 Тогда
				Ошибки.Добавить("Договор " + НомерДоговора + ": у документа «" + ДокументРасчетов.НаимДок + "» нет ни одной операции");
			КонецЕсли;
			Для Каждого Операция Из ДокументРасчетов.Операции Цикл
				Если Не ЗначениеЗаполнено(Операция.НаимОпер) Тогда
					Ошибки.Добавить("Договор " + НомерДоговора + ": у операции не заполнено наименование (НаимОпер)");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(Операция.ДатаОпер) Тогда
					Ошибки.Добавить("Договор " + НомерДоговора + ": у операции «" + Операция.НаимОпер + "» не заполнена дата (ДатаОпер)");
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(Акт.Подписант.Фамилия) Или Не ЗначениеЗаполнено(Акт.Подписант.Имя) Тогда
		Ошибки.Добавить("Не заполнены фамилия и имя подписанта");
	КонецЕсли;

	Возврат Ошибки;

КонецФункции

// Формирует XML титула отправителя акта сверки (ON_AKTSVEROTP, версия формата 5.01).
//
// Параметры:
//  Акт - Структура - см. НовыйАкт
//
// Возвращаемое значение:
//  Строка - текст XML с объявлением кодировки windows-1251; записывать в файл
//           надо той же кодировкой, иначе объявление разойдётся с содержимым
Функция СформироватьXML(Акт) Экспорт

	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку("windows-1251");
	Запись.ЗаписатьОбъявлениеXML();

	Запись.ЗаписатьНачалоЭлемента("Файл");
	Запись.ЗаписатьАтрибут("ИдФайл",   Акт.ИдФайл);
	Запись.ЗаписатьАтрибут("ВерсФорм", ВерсияФормата());
	Запись.ЗаписатьАтрибут("ВерсПрог", Лев(Акт.ВерсПрог, 40));

	Запись.ЗаписатьНачалоЭлемента("Документ");
	Запись.ЗаписатьАтрибут("КНД",          КодФормыПоКНД());
	Запись.ЗаписатьАтрибут("ДатаИнфОтпр",  ДатаСтрокой(Акт.ДатаИнфОтпр));
	Запись.ЗаписатьАтрибут("ВрИнфОтпр",    ВремяСтрокой(Акт.ДатаИнфОтпр));
	Запись.ЗаписатьАтрибут("ДатаНачПер",   ДатаСтрокой(Акт.ДатаНачПер));
	Запись.ЗаписатьАтрибут("ДатаОкПер",    ДатаСтрокой(Акт.ДатаОкПер));
	Запись.ЗаписатьАтрибут("НомерАкт",     Лев(Акт.НомерАкт, 1000));

	// Сведения о сторонах
	Запись.ЗаписатьНачалоЭлемента("СвДокКрАкт");
	Запись.ЗаписатьАтрибут("КодОКВ", Акт.КодОКВ);
	ЗаписатьУчастника(Запись, "СвОтпр", Акт.Отправитель);
	ЗаписатьУчастника(Запись, "СвПол",  Акт.Получатель);
	Запись.ЗаписатьКонецЭлемента();

	// Таблица акта
	Запись.ЗаписатьНачалоЭлемента("ТаблАкт");
	ЗаписатьИтоги(Запись, Акт.Итоги);

	НомерСтроки = 0;
	Для Каждого Договор Из Акт.Договоры Цикл

		Запись.ЗаписатьНачалоЭлемента("ДогСв");
		ЗаписатьАтрибутЕслиЗаполнен(Запись, "ИдДог",      Договор.ИдДог);
		ЗаписатьАтрибутЕслиЗаполнен(Запись, "ОписТипДог", Договор.ОписТипДог);
		ЗаписатьАтрибутЕслиЗаполнен(Запись, "НомДог",     Договор.НомДог);
		Если ЗначениеЗаполнено(Договор.ДатаДог) Тогда
			Запись.ЗаписатьАтрибут("ДатаДог", ДатаСтрокой(Договор.ДатаДог));
		КонецЕсли;
		ЗаписатьИтоги(Запись, Договор.Итоги);

		Для Каждого ДокументРасчетов Из Договор.Документы Цикл

			Запись.ЗаписатьНачалоЭлемента("ДокСв");
			Запись.ЗаписатьАтрибут("НаимДок", Лев(ДокументРасчетов.НаимДок, 100));
			Запись.ЗаписатьАтрибут("НомДок",  Лев(ДокументРасчетов.НомДок, 50));
			Запись.ЗаписатьАтрибут("ДатаДок", ДатаСтрокой(ДокументРасчетов.ДатаДок));
			ЗаписатьАтрибутЕслиЗаполнен(Запись, "ИдДок",  ДокументРасчетов.ИдДок);
			ЗаписатьАтрибутЕслиЗаполнен(Запись, "ДопИнф", ДокументРасчетов.ДопИнф);

			Для Каждого Операция Из ДокументРасчетов.Операции Цикл

				НомерСтроки = НомерСтроки + 1;
				Запись.ЗаписатьНачалоЭлемента("СвОпер");
				Запись.ЗаписатьАтрибут("НомСтр",   Строка(?(Операция.НомСтр > 0, Операция.НомСтр, НомерСтроки)));
				Запись.ЗаписатьАтрибут("ДатаОпер", ДатаСтрокой(Операция.ДатаОпер));
				Запись.ЗаписатьАтрибут("НаимОпер", Лев(Операция.НаимОпер, 500));
				Если Операция.СумДебет <> 0 Тогда
					Запись.ЗаписатьАтрибут("СумДебет", СуммаСтрокой(Операция.СумДебет));
				КонецЕсли;
				Если Операция.СумКредит <> 0 Тогда
					Запись.ЗаписатьАтрибут("СумКредит", СуммаСтрокой(Операция.СумКредит));
				КонецЕсли;
				Запись.ЗаписатьКонецЭлемента();

			КонецЦикла;

			Запись.ЗаписатьКонецЭлемента(); // ДокСв

		КонецЦикла;

		Запись.ЗаписатьКонецЭлемента(); // ДогСв

	КонецЦикла;

	Запись.ЗаписатьКонецЭлемента(); // ТаблАкт

	ЗаписатьПодписанта(Запись, Акт.Подписант);

	Запись.ЗаписатьКонецЭлемента(); // Документ
	Запись.ЗаписатьКонецЭлемента(); // Файл

	Возврат Запись.Закрыть();

КонецФункции

// Собирает имя файла обмена по правилам роуминга:
// ON_AKTSVEROTP_<ид получателя>_<ид отправителя>_<ггггммдд>_<GUID>
//
// Параметры:
//  ИдентификаторПолучателя  - Строка - идентификатор участника ЭДО получателя
//  ИдентификаторОтправителя - Строка - идентификатор участника ЭДО отправителя
//  ДатаФормирования         - Дата   - дата формирования файла
//
// Возвращаемое значение:
//  Строка - имя файла без расширения, не длиннее 255 символов
Функция ИмяФайлаОбмена(ИдентификаторПолучателя, ИдентификаторОтправителя, ДатаФормирования = Неопределено) Экспорт

	ДатаФайла = ?(ДатаФормирования = Неопределено, ТекущаяДата(), ДатаФормирования);

	Имя = "ON_AKTSVEROTP"
		+ "_" + ИдентификаторПолучателя
		+ "_" + ИдентификаторОтправителя
		+ "_" + Формат(ДатаФайла, "ДФ=yyyyMMdd")
		+ "_" + Строка(Новый УникальныйИдентификатор);

	Возврат Лев(Имя, 255);

КонецФункции

// Проверяет текст XML по XSD-схеме формата.
//
// Схема подаётся ПУТЁМ К ФАЙЛУ, а не текстом: `СоздатьФабрикуXDTO` принимает имя файла
// напрямую, и это единственный способ, который работает на нашей платформе. ⚠️🔴 Вариант
// «прочитать схему ПостроителемDOM → ПостроительСхемXML → НаборСхемXML» на 8.5.1.1343
// падает с «Файл не обнаружен 'НаборСхемXML'» — такого типа там нет (проверено 05.09.2026).
// ⟹ вызывающий код сам решает, откуда взялся файл: макет расширения, выгруженный
// во временный каталог, или файл на диске сервера — модуль от этого не зависит.
//
// ⚠️ Проверка по схеме ловит структурные дефекты (порядок, обязательность, шаблоны),
//    но НЕ ловит смысловые: сошлось ли сальдо, тот ли контрагент. Это отдельный слой.
//
// Параметры:
//  ТекстXML    - Строка - проверяемый XML
//  ПутьКСхеме  - Строка - полное имя файла XSD, доступного серверу 1С
//
// Возвращаемое значение:
//  Строка - описание ошибки; пустая строка = ошибок нет
Функция ОшибкиПоСхеме(ТекстXML, ПутьКСхеме) Экспорт

	Попытка

		Фабрика = СоздатьФабрикуXDTO(ПутьКСхеме);

		ЧтениеДанных = Новый ЧтениеXML;
		ЧтениеДанных.УстановитьСтроку(ТекстXML);
		Фабрика.ПрочитатьXML(ЧтениеДанных);
		ЧтениеДанных.Закрыть();

	Исключение
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат "";

КонецФункции

// Версия формата по приказу ЕД-7-26/405@.
Функция ВерсияФормата() Экспорт
	Возврат "5.01";
КонецФункции

// Код формы по КНД для акта сверки взаимных расчетов.
Функция КодФормыПоКНД() Экспорт
	Возврат "1110332";
КонецФункции

// Имя типа документа у оператора «Платформа ЭДО» для титула отправителя.
Функция ТипДокументаОператора() Экспорт
	Возврат "RECONCILIATION_REQUEST";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пустая структура шести показателей, которых требует схема на каждом уровне таблицы.
Функция НовыеИтоги()

	Итоги = Новый Структура;
	Итоги.Вставить("СальдоНачДеб", 0);
	Итоги.Вставить("СальдоНачКр",  0);
	Итоги.Вставить("ОборотДеб",    0);
	Итоги.Вставить("ОборотКр",     0);
	Итоги.Вставить("СальдоКонДеб", 0);
	Итоги.Вставить("СальдоКонКр",  0);

	Возврат Итоги;

КонецФункции

Процедура ЗаписатьИтоги(Запись, Итоги)

	Запись.ЗаписатьАтрибут("СальдоНачДеб", СуммаСтрокой(Итоги.СальдоНачДеб));
	Запись.ЗаписатьАтрибут("СальдоНачКр",  СуммаСтрокой(Итоги.СальдоНачКр));
	Запись.ЗаписатьАтрибут("ОборотДеб",    СуммаСтрокой(Итоги.ОборотДеб));
	Запись.ЗаписатьАтрибут("ОборотКр",     СуммаСтрокой(Итоги.ОборотКр));
	Запись.ЗаписатьАтрибут("СальдоКонДеб", СуммаСтрокой(Итоги.СальдоКонДеб));
	Запись.ЗаписатьАтрибут("СальдоКонКр",  СуммаСтрокой(Итоги.СальдоКонКр));

КонецПроцедуры

Процедура ЗаписатьУчастника(Запись, ИмяЭлемента, Участник)

	Запись.ЗаписатьНачалоЭлемента(ИмяЭлемента);
	ЗаписатьАтрибутЕслиЗаполнен(Запись, "ОКПО",        Участник.ОКПО);
	ЗаписатьАтрибутЕслиЗаполнен(Запись, "СтруктПодр",  Участник.СтруктПодр);
	ЗаписатьАтрибутЕслиЗаполнен(Запись, "ИнфДляУчаст", Участник.ИнфДляУчаст);

	Запись.ЗаписатьНачалоЭлемента("ИдСв");

	Если ВРег(Участник.Вид) = "ИП" Тогда

		Запись.ЗаписатьНачалоЭлемента("СвИП");
		Запись.ЗаписатьАтрибут("ИННФЛ",  Участник.ИНН);
		Запись.ЗаписатьАтрибут("ОГРНИП", Участник.ОГРНИП);
		ЗаписатьФИО(Запись, Участник.Фамилия, Участник.Имя, Участник.Отчество);
		Запись.ЗаписатьКонецЭлемента();

	ИначеЕсли ВРег(Участник.Вид) = "ФЛ" Тогда

		Запись.ЗаписатьНачалоЭлемента("СвФЛ");
		Запись.ЗаписатьАтрибут("ИННФЛ", Участник.ИНН);
		ЗаписатьФИО(Запись, Участник.Фамилия, Участник.Имя, Участник.Отчество);
		Запись.ЗаписатьКонецЭлемента();

	ИначеЕсли ВРег(Участник.Вид) = "ИННЕУЧ" Тогда

		Запись.ЗаписатьНачалоЭлемента("СвИнНеУч");
		Запись.ЗаписатьАтрибут("НаимОрг", Участник.НаимОрг);
		Запись.ЗаписатьАтрибут("Идентиф", Участник.Идентиф);
		ЗаписатьАтрибутЕслиЗаполнен(Запись, "ИныеСвед", Участник.ИныеСвед);
		Запись.ЗаписатьКонецЭлемента();

	Иначе

		Запись.ЗаписатьНачалоЭлемента("СвЮЛУч");
		Запись.ЗаписатьАтрибут("НаимОрг", Участник.НаимОрг);
		Запись.ЗаписатьАтрибут("ИННЮЛ",   Участник.ИНН);
		Запись.ЗаписатьАтрибут("КПП",     Участник.КПП);
		Запись.ЗаписатьАтрибут("ОГРН",    Участник.ОГРН);
		Запись.ЗаписатьКонецЭлемента();

	КонецЕсли;

	Запись.ЗаписатьКонецЭлемента(); // ИдСв

	// Элемент обязателен по схеме, атрибуты внутри — нет.
	Запись.ЗаписатьНачалоЭлемента("Контакт");
	ЗаписатьАтрибутЕслиЗаполнен(Запись, "Тлф",     Участник.Телефон);
	ЗаписатьАтрибутЕслиЗаполнен(Запись, "ЭлПочта", Участник.ЭлПочта);
	ЗаписатьАтрибутЕслиЗаполнен(Запись, "ИнКонт",  Участник.ИнКонт);
	Запись.ЗаписатьКонецЭлемента();

	Запись.ЗаписатьКонецЭлемента(); // СвОтпр / СвПол

КонецПроцедуры

Процедура ЗаписатьПодписанта(Запись, Подписант)

	Запись.ЗаписатьНачалоЭлемента("Подписант");
	ЗаписатьАтрибутЕслиЗаполнен(Запись, "СтатПодп",   Подписант.СтатПодп);
	ЗаписатьАтрибутЕслиЗаполнен(Запись, "ТипПодпис",  Подписант.ТипПодпис);
	ЗаписатьАтрибутЕслиЗаполнен(Запись, "ИдСистХран", Подписант.ИдСистХран);
	ЗаписатьАтрибутЕслиЗаполнен(Запись, "Должн",      Подписант.Должн);

	ЗаписатьФИО(Запись, Подписант.Фамилия, Подписант.Имя, Подписант.Отчество);

	Если ЗначениеЗаполнено(Подписант.НомДовер) Тогда
		Запись.ЗаписатьНачалоЭлемента("СвДовер");
		Запись.ЗаписатьАтрибут("НомДовер", Подписант.НомДовер);
		Если ЗначениеЗаполнено(Подписант.ДатаНачДовер) Тогда
			Запись.ЗаписатьАтрибут("ДатаНач", ДатаСтрокой(Подписант.ДатаНачДовер));
		КонецЕсли;
		ЗаписатьАтрибутЕслиЗаполнен(Запись, "ВнНомДовер", Подписант.ВнНомДовер);
		Если ЗначениеЗаполнено(Подписант.ДатаВнРегДовер) Тогда
			Запись.ЗаписатьАтрибут("ДатаВнРегДовер", ДатаСтрокой(Подписант.ДатаВнРегДовер));
		КонецЕсли;
		ЗаписатьАтрибутЕслиЗаполнен(Запись, "СведСистОтм", Подписант.СведСистОтм);
		Запись.ЗаписатьКонецЭлемента();
	КонецЕсли;

	Запись.ЗаписатьКонецЭлемента();

КонецПроцедуры

Процедура ЗаписатьФИО(Запись, Фамилия, Имя, Отчество)

	Запись.ЗаписатьНачалоЭлемента("ФИО");
	Запись.ЗаписатьАтрибут("Фамилия", Фамилия);
	Запись.ЗаписатьАтрибут("Имя",     Имя);
	ЗаписатьАтрибутЕслиЗаполнен(Запись, "Отчество", Отчество);
	Запись.ЗаписатьКонецЭлемента();

КонецПроцедуры

Процедура ЗаписатьАтрибутЕслиЗаполнен(Запись, ИмяАтрибута, Значение)

	Если ЗначениеЗаполнено(Значение) Тогда
		Запись.ЗаписатьАтрибут(ИмяАтрибута, Строка(Значение));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьУчастника(Участник, Роль, Ошибки)

	Вид = ВРег(Участник.Вид);

	Если Вид = "ИП" Тогда
		Если СтрДлина(Участник.ИНН) <> 12 Тогда
			Ошибки.Добавить("ИНН " + Роль + " (ИП) должен быть из 12 цифр, получено: «" + Участник.ИНН + "»");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Участник.Фамилия) Тогда
			Ошибки.Добавить("Не заполнена фамилия " + Роль + " (ИП)");
		КонецЕсли;
	ИначеЕсли Вид = "ФЛ" Тогда
		Если СтрДлина(Участник.ИНН) <> 12 Тогда
			Ошибки.Добавить("ИНН " + Роль + " (физлицо) должен быть из 12 цифр, получено: «" + Участник.ИНН + "»");
		КонецЕсли;
	ИначеЕсли Вид = "ИННЕУЧ" Тогда
		Если Не ЗначениеЗаполнено(Участник.НаимОрг) Или Не ЗначениеЗаполнено(Участник.Идентиф) Тогда
			Ошибки.Добавить("У " + Роль + " (иностранное лицо) должны быть заполнены наименование и идентификатор");
		КонецЕсли;
	Иначе
		Если Не ЗначениеЗаполнено(Участник.НаимОрг) Тогда
			Ошибки.Добавить("Не заполнено наименование " + Роль);
		КонецЕсли;
		Если СтрДлина(Участник.ИНН) <> 10 Тогда
			Ошибки.Добавить("ИНН " + Роль + " (юрлицо) должен быть из 10 цифр, получено: «" + Участник.ИНН + "»");
		КонецЕсли;
		Если СтрДлина(Участник.КПП) <> 9 Тогда
			Ошибки.Добавить("КПП " + Роль + " должен быть из 9 знаков, получено: «" + Участник.КПП + "»");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Реквизиты, которых формат требует, но которых в базе может не быть.
// ⭐🔴 Вынесены из блокирующей проверки РЕШЕНИЕМ ОПЕРАТОРА (05.09.2026): ОГРН и ОГРНИП
// в справочнике контрагентов заполнены у единиц (16 карточек из 2056), внешний сервис
// ЕГРЮЛ заводить не стали ⟹ отправляем с пустым значением, а не молчим об отправке.
//
// ⚠️🔴 Чем это рискованно и почему всё равно проверяем: сама XSD-схема пустое значение
// в обязательном атрибуте ПРОПУСКАЕТ (проверено на 8.5.1), поэтому валидация тут ничего
// не скажет — а вот ФЛК оператора отвергнуть может. Тогда по этому списку видно, каким
// документам заранее место в PDF-ветке, а не в XML.
//
// Параметры:
//  Акт - Структура - см. НовыйАкт
//
// Возвращаемое значение:
//  Массив из Строка - чего не хватает; пустой массив = реквизиты полны
Функция НеполныеРеквизиты(Акт) Экспорт

	Неполные = Новый Массив;
	ПроверитьПолнотуУчастника(Акт.Отправитель, "отправителя", Неполные);
	ПроверитьПолнотуУчастника(Акт.Получатель,  "получателя",  Неполные);

	Возврат Неполные;

КонецФункции

Процедура ПроверитьПолнотуУчастника(Участник, Роль, Неполные)

	Вид = ВРег(Участник.Вид);

	Если Вид = "ИП" Тогда
		Если СтрДлина(Участник.ОГРНИП) <> 15 Тогда
			Неполные.Добавить("не заполнен ОГРНИП " + Роль);
		КонецЕсли;
	ИначеЕсли Вид <> "ФЛ" И Вид <> "ИННЕУЧ" Тогда
		Если СтрДлина(Участник.ОГРН) <> 13 Тогда
			Неполные.Добавить("не заполнен ОГРН " + Роль);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Дата в формате схемы: ДД.ММ.ГГГГ.
Функция ДатаСтрокой(Значение)
	Возврат Формат(Значение, "ДФ=dd.MM.yyyy");
КонецФункции

// Время в формате схемы: ЧЧ:ММ:СС.
Функция ВремяСтрокой(Значение)
	Возврат Формат(Значение, "ДФ=HH:mm:ss");
КонецФункции

// Сумма в формате схемы: точка как разделитель дробной части, без разделителей групп,
// ровно два знака после запятой.
//
// ⚠️🔴 Две грабли «Формат», обе проверены на боевой 8.5.1 05.09.2026 и обе дают
//    невалидный файл БЕЗ признаков ошибки в коде:
//    1. без «ЧРД=.» разделителем станет запятая по региональным настройкам;
//    2. НОЛЬ форматируется в ПУСТУЮ СТРОКУ — `Формат(0, "ЧДЦ=2; ЧРД=.; ЧГ=0")` = "".
//       А сальдо и обороты по схеме обязательны и почти всегда содержат нули
//       ⟹ файл уходил бы с `СальдоНачКр=""`. Параметр «ЧН=0» тоже не спасает: он даёт
//       ровно "0", без дробной части.
//    ⟹ ноль подставляем строкой сами.
Функция СуммаСтрокой(Значение)

	Если Значение = 0 Тогда
		Возврат "0.00";
	КонецЕсли;

	Возврат Формат(Значение, "ЧДЦ=2; ЧРД=.; ЧГ=0");

КонецФункции

#КонецОбласти
