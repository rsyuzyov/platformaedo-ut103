////////////////////////////////////////////////////////////////////////////////
// Входящие электронные документы: разбор XML титула продавца в структуру, не зависящую
// от конфигурации. Документ базы по этой структуре создает профиль базы (точка
// ПриСозданииДокументаПоВходящему), разбор о базе ничего не знает и проверяется на файлах.
//
// Поддержан УПД/СЧФ/ДОП по приказу ФНС (ON_NSCHFDOPPR) версий 5.01 и 5.03: имена узлов и
// атрибутов, которые в версиях различаются, читаются из обоих вариантов.
////////////////////////////////////////////////////////////////////////////////

#Область РазборУПД

// Разобрать XML титула продавца УПД (ON_NSCHFDOPPR).
// Данные - ДвоичныеДанные файла (кодировку берет из объявления XML) или Строка с текстом XML.
// Возврат: Структура, см. НовыйРазборУПД. Ошибки разбора, при которых документ еще можно
// показать (не сошлась сумма, нет обязательного поля), - в Предупреждения; файл, который
// не является УПД, - исключение.
Функция РазобратьУПД(Знач Данные) Экспорт

	// Документ DOM держим в переменной: без ссылки на него элементы становятся недействительными.
	ДокументDOM = ДокументXML(Данные);
	Корень = ДокументDOM.ЭлементДокумента;
	Если Корень.ИмяЭлемента <> "Файл" Тогда
		ВызватьИсключение "Это не файл документа ФНС: корневой элемент «" + Корень.ИмяЭлемента + "»";
	КонецЕсли;

	Разбор = НовыйРазборУПД();
	Разбор.ИдФайла = Атрибут(Корень, "ИдФайл");
	ЧастиИд = СтрРазделить(Разбор.ИдФайла, "_");
	Если ЧастиИд.Количество() >= 2 Тогда
		Разбор.Формат = ВРег(ЧастиИд[0] + "_" + ЧастиИд[1]);
	КонецЕсли;
	Разбор.ВерсияФормата = Атрибут(Корень, "ВерсФорм");
	Разбор.Программа = Атрибут(Корень, "ВерсПрог");

	Документ = Дочерний(Корень, "Документ");
	Если Документ = Неопределено Тогда
		ВызватьИсключение "В файле нет узла «Документ»";
	КонецЕсли;
	Разбор.Функция = Атрибут(Документ, "Функция");

	СвСчФакт = Дочерний(Документ, "СвСчФакт");
	Если СвСчФакт = Неопределено Тогда
		ВызватьИсключение "В файле нет узла «СвСчФакт»: это не титул продавца УПД";
	КонецЕсли;
	// 5.03: НомерДок/ДатаДок; 5.01: НомерСчФ/ДатаСчФ.
	Разбор.Номер = ПервыйНепустой(Атрибут(СвСчФакт, "НомерДок"), Атрибут(СвСчФакт, "НомерСчФ"));
	Разбор.Дата = ДатаИзСтроки(ПервыйНепустой(Атрибут(СвСчФакт, "ДатаДок"), Атрибут(СвСчФакт, "ДатаСчФ")));
	Разбор.Валюта = ПервыйНепустой(Атрибут(Дочерний(СвСчФакт, "ДенИзм"), "КодОКВ"), Атрибут(СвСчФакт, "КодОКВ"));

	// 5.03: ИспрДок; 5.01: ИспрСчФ.
	Испр = Дочерний(СвСчФакт, "ИспрДок");
	Если Испр = Неопределено Тогда
		Испр = Дочерний(СвСчФакт, "ИспрСчФ");
	КонецЕсли;
	Если Испр <> Неопределено Тогда
		Разбор.НомерИсправления = ПервыйНепустой(Атрибут(Испр, "НомИспр"), Атрибут(Испр, "НомИспрСчФ"));
		Разбор.ДатаИсправления = ДатаИзСтроки(ПервыйНепустой(Атрибут(Испр, "ДатаИспр"), Атрибут(Испр, "ДатаИспрСчФ")));
	КонецЕсли;

	Разбор.Продавец = Участник(Дочерний(СвСчФакт, "СвПрод"));
	Разбор.Покупатель = Участник(Дочерний(СвСчФакт, "СвПокуп"));
	Разбор.Грузополучатель = Участник(Дочерний(СвСчФакт, "ГрузПолуч"));
	ГрузОт = Дочерний(СвСчФакт, "ГрузОт");
	Если ГрузОт <> Неопределено Тогда
		Если Дочерний(ГрузОт, "ОнЖе") <> Неопределено Тогда
			Разбор.ГрузоотправительОнЖе = Истина;
		Иначе
			Разбор.Грузоотправитель = Участник(Дочерний(ГрузОт, "ГрузОтпр"));
		КонецЕсли;
	КонецЕсли;

	// 5.03: ДокПодтвОтгрНом (Рекв*); 5.01: ДокПодтвОтгр (НаимДокОтгр/НомДокОтгр/ДатаДокОтгр).
	Для Каждого Узел Из Дочерние(СвСчФакт, "ДокПодтвОтгрНом") Цикл
		Разбор.ДокументыОтгрузки.Добавить(РеквизитыДокумента(Узел));
	КонецЦикла;
	Для Каждого Узел Из Дочерние(СвСчФакт, "ДокПодтвОтгр") Цикл
		Разбор.ДокументыОтгрузки.Добавить(Новый Структура("Наименование, Номер, Дата",
			Атрибут(Узел, "НаимДокОтгр"), Атрибут(Узел, "НомДокОтгр"), ДатаИзСтроки(Атрибут(Узел, "ДатаДокОтгр"))));
	КонецЦикла;
	ПрочитатьИнфПоля(Дочерний(СвСчФакт, "ИнфПолФХЖ1"), Разбор.ИнфПоля);

	ПрочитатьСведенияОПередаче(Документ, Разбор);

	Таблица = Дочерний(Документ, "ТаблСчФакт");
	Если Таблица = Неопределено Тогда
		Разбор.Предупреждения.Добавить("В документе нет таблицы товаров (ТаблСчФакт)");
		Возврат Разбор;
	КонецЕсли;
	Для Каждого СведТов Из Дочерние(Таблица, "СведТов") Цикл
		Разбор.Строки.Добавить(СтрокаТовара(СведТов, Разбор.Предупреждения));
	КонецЦикла;

	Всего = Дочерний(Таблица, "ВсегоОпл");
	Если Всего <> Неопределено Тогда
		Разбор.СуммаБезНДС = ЧислоИзСтроки(Атрибут(Всего, "СтТовБезНДСВсего"));
		Разбор.СуммаСНДС = ЧислоИзСтроки(Атрибут(Всего, "СтТовУчНалВсего"));
		Разбор.СуммаНДС = СуммаНалога(Дочерний(Всего, "СумНалВсего"));
	КонецЕсли;
	ПроверитьИтоги(Разбор);

	Возврат Разбор;

КонецФункции

// Пустая структура разбора. Строки - Массив структур, см. НоваяСтрокаТовара.
Функция НовыйРазборУПД() Экспорт

	Разбор = Новый Структура;
	Разбор.Вставить("Формат", "");              // ON_NSCHFDOPPR
	Разбор.Вставить("ВерсияФормата", "");       // 5.03
	Разбор.Вставить("Программа", "");           // ВерсПрог отправителя
	Разбор.Вставить("ИдФайла", "");
	Разбор.Вставить("Функция", "");             // СЧФ, СЧФДОП, ДОП
	Разбор.Вставить("Номер", "");
	Разбор.Вставить("Дата", '00010101');
	Разбор.Вставить("НомерИсправления", "");
	Разбор.Вставить("ДатаИсправления", '00010101');
	Разбор.Вставить("Валюта", "");              // код ОКВ, 643 - рубль
	Разбор.Вставить("Продавец", Неопределено);   // см. Участник
	Разбор.Вставить("Покупатель", Неопределено);
	Разбор.Вставить("Грузоотправитель", Неопределено);
	Разбор.Вставить("ГрузоотправительОнЖе", Ложь);
	Разбор.Вставить("Грузополучатель", Неопределено);
	Разбор.Вставить("ДокументыОтгрузки", Новый Массив);   // Структура (Наименование, Номер, Дата)
	Разбор.Вставить("Основания", Новый Массив);           // Структура (Наименование, Номер, Дата)
	Разбор.Вставить("ДатаОтгрузки", '00010101');
	Разбор.Вставить("СодержаниеОперации", "");
	Разбор.Вставить("ИнфПоля", Новый Соответствие);       // ИнфПолФХЖ1: Идентиф -> Значен
	Разбор.Вставить("СуммаБезНДС", 0);
	Разбор.Вставить("СуммаНДС", 0);
	Разбор.Вставить("СуммаСНДС", 0);
	Разбор.Вставить("Строки", Новый Массив);
	Разбор.Вставить("Предупреждения", Новый Массив);
	Возврат Разбор;

КонецФункции

// Пустая строка товара. Коды маркировки лежат и как в файле - группами НомСредИдентТов
// (у группы бывает транспортная упаковка и количество), и плоскими списками по видам:
// КИЗ - коды единиц, Упаковки - групповые упаковки (НомУпак), ТранспортныеУпаковки -
// ИдентТрансУпак. Раскрыть упаковку до единиц может только получатель (через Честный знак).
Функция НоваяСтрокаТовара() Экспорт

	Товар = Новый Структура;
	Товар.Вставить("НомерСтроки", 0);
	Товар.Вставить("Наименование", "");
	Товар.Вставить("КраткоеНаименование", "");
	Товар.Вставить("КодОКЕИ", "");
	Товар.Вставить("ЕдиницаИзмерения", "");
	Товар.Вставить("Количество", 0);
	Товар.Вставить("Цена", 0);
	Товар.Вставить("СуммаБезНДС", 0);
	Товар.Вставить("СтавкаНДС", "");           // как в файле: 22%, 10%, 0%, без НДС, 22/122 ...
	Товар.Вставить("СуммаНДС", 0);
	Товар.Вставить("СуммаСНДС", 0);
	Товар.Вставить("СуммаАкциза", 0);
	Товар.Вставить("КодТовара", "");           // КодТов: код номенклатуры продавца
	Товар.Вставить("Артикул", "");
	Товар.Вставить("GTIN", "");
	Товар.Вставить("КодВидаТовара", "");       // КодВидТов: ТН ВЭД
	Товар.Вставить("ПризнакТовара", "");       // ПрТовРаб: 1 товар, 2 работа, 3 услуга ...
	Товар.Вставить("СтранаПроисхождения", "");
	Товар.Вставить("НомерДТ", "");
	Товар.Вставить("ИнфПоля", Новый Соответствие);   // ИнфПолФХЖ2: Идентиф -> Значен
	Товар.Вставить("ГруппыМаркировки", Новый Массив); // Структура (ТранспортнаяУпаковка, Количество, КИЗ, Упаковки)
	Товар.Вставить("КИЗ", Новый Массив);
	Товар.Вставить("Упаковки", Новый Массив);
	Товар.Вставить("ТранспортныеУпаковки", Новый Массив);
	Возврат Товар;

КонецФункции

Функция СтрокаТовара(Знач СведТов, Предупреждения)

	Товар = НоваяСтрокаТовара();
	Товар.НомерСтроки = ЧислоИзСтроки(Атрибут(СведТов, "НомСтр"));
	Товар.Наименование = Атрибут(СведТов, "НаимТов");
	Товар.КодОКЕИ = Атрибут(СведТов, "ОКЕИ_Тов");
	Товар.ЕдиницаИзмерения = Атрибут(СведТов, "НаимЕдИзм");
	Товар.Количество = ЧислоИзСтроки(Атрибут(СведТов, "КолТов"));
	Товар.Цена = ЧислоИзСтроки(Атрибут(СведТов, "ЦенаТов"));
	Товар.СуммаБезНДС = ЧислоИзСтроки(Атрибут(СведТов, "СтТовБезНДС"));
	Товар.СтавкаНДС = Атрибут(СведТов, "НалСт");
	Товар.СуммаСНДС = ЧислоИзСтроки(Атрибут(СведТов, "СтТовУчНал"));
	Товар.СуммаНДС = СуммаНалога(Дочерний(СведТов, "СумНал"));
	Товар.СуммаАкциза = ЧислоИзСтроки(ТекстЭлемента(Дочерний(Дочерний(СведТов, "Акциз"), "СумАкциз")));

	Доп = Дочерний(СведТов, "ДопСведТов");
	Если Доп <> Неопределено Тогда
		Товар.КодТовара = Атрибут(Доп, "КодТов");
		Товар.Артикул = Атрибут(Доп, "АртикулТов");
		Товар.GTIN = Атрибут(Доп, "ГТИН");
		Товар.КодВидаТовара = Атрибут(Доп, "КодВидТов");
		Товар.ПризнакТовара = Атрибут(Доп, "ПрТовРаб");
		Товар.КраткоеНаименование = ТекстЭлемента(Дочерний(Доп, "КрНаимСтрПр"));
		Если НЕ ЗначениеЗаполнено(Товар.ЕдиницаИзмерения) Тогда
			Товар.ЕдиницаИзмерения = Атрибут(Доп, "НаимЕдИзм");   // 5.01
		КонецЕсли;
		Для Каждого Группа Из Дочерние(Доп, "НомСредИдентТов") Цикл
			ДобавитьГруппуМаркировки(Товар, Группа);
		КонецЦикла;
	КонецЕсли;

	// 5.03: СвДТ (НомерДТ); 5.01: СвТД (НомерТД).
	Для Каждого ИмяУзла Из СтрРазделить("СвДТ,СвТД", ",") Цикл
		Для Каждого Узел Из Дочерние(СведТов, ИмяУзла) Цикл
			Товар.СтранаПроисхождения = ПервыйНепустой(Товар.СтранаПроисхождения, Атрибут(Узел, "КодПроисх"));
			Товар.НомерДТ = ПервыйНепустой(Товар.НомерДТ, Атрибут(Узел, "НомерДТ"), Атрибут(Узел, "НомерТД"));
		КонецЦикла;
	КонецЦикла;

	Для Каждого Узел Из Дочерние(СведТов, "ИнфПолФХЖ2") Цикл
		ДобавитьИнфПоле(Товар.ИнфПоля, Узел);
	КонецЦикла;

	Возврат Товар;

КонецФункции

Процедура ДобавитьГруппуМаркировки(Товар, Знач Узел)

	Группа = Новый Структура("ТранспортнаяУпаковка, Количество, КИЗ, Упаковки",
		Атрибут(Узел, "ИдентТрансУпак"), ЧислоИзСтроки(Атрибут(Узел, "КолВедМарк")), Новый Массив, Новый Массив);
	Для Каждого Код Из Дочерние(Узел, "КИЗ") Цикл
		Группа.КИЗ.Добавить(ТекстЭлемента(Код));
		Товар.КИЗ.Добавить(ТекстЭлемента(Код));
	КонецЦикла;
	Для Каждого Код Из Дочерние(Узел, "НомУпак") Цикл
		Группа.Упаковки.Добавить(ТекстЭлемента(Код));
		Товар.Упаковки.Добавить(ТекстЭлемента(Код));
	КонецЦикла;
	Если ЗначениеЗаполнено(Группа.ТранспортнаяУпаковка) Тогда
		Товар.ТранспортныеУпаковки.Добавить(Группа.ТранспортнаяУпаковка);
	КонецЕсли;
	Товар.ГруппыМаркировки.Добавить(Группа);

КонецПроцедуры

Процедура ПрочитатьСведенияОПередаче(Знач Документ, Разбор)

	СвПер = Дочерний(Дочерний(Документ, "СвПродПер"), "СвПер");
	Если СвПер = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Разбор.ДатаОтгрузки = ДатаИзСтроки(Атрибут(СвПер, "ДатаПер"));
	Разбор.СодержаниеОперации = Атрибут(СвПер, "СодОпер");
	Для Каждого Осн Из Дочерние(СвПер, "ОснПер") Цикл
		Если Осн.ЕстьАтрибут("РеквНаимДок") Тогда
			Разбор.Основания.Добавить(РеквизитыДокумента(Осн));                    // 5.03
		Иначе
			Разбор.Основания.Добавить(Новый Структура("Наименование, Номер, Дата",     // 5.01
				Атрибут(Осн, "НаимОсн"), Атрибут(Осн, "НомОсн"), ДатаИзСтроки(Атрибут(Осн, "ДатаОсн"))));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьИтоги(Разбор)

	СуммаСтрок = 0;
	Для Каждого СтрокаУПД Из Разбор.Строки Цикл
		СуммаСтрок = СуммаСтрок + СтрокаУПД.СуммаСНДС;
	КонецЦикла;
	Если Разбор.СуммаСНДС <> 0 И СуммаСтрок <> Разбор.СуммаСНДС Тогда
		Разбор.Предупреждения.Добавить("Сумма строк (" + Формат(СуммаСтрок, "ЧДЦ=2; ЧГ=0")
			+ ") не равна итогу документа (" + Формат(Разбор.СуммаСНДС, "ЧДЦ=2; ЧГ=0") + ")");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Разбор.Номер) Тогда
		Разбор.Предупреждения.Добавить("В документе нет номера");
	КонецЕсли;
	Если Разбор.Продавец = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Разбор.Продавец.ИНН) Тогда
		Разбор.Предупреждения.Добавить("Не указан ИНН продавца");
	КонецЕсли;

КонецПроцедуры

// Участник (продавец, покупатель, грузоотправитель, грузополучатель): узел с ИдСв внутри.
// Возврат: Структура (ИНН, КПП, Наименование, ЭтоИП, Иностранный) или Неопределено.
Функция Участник(Знач Узел)

	Если Узел = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура("ИНН, КПП, Наименование, ЭтоИП, Иностранный", "", "", "", Ложь, Ложь);
	ИдСв = Дочерний(Узел, "ИдСв");
	Если ИдСв = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ЮЛ = Дочерний(ИдСв, "СвЮЛУч");
	ИП = Дочерний(ИдСв, "СвИП");
	Ин = Дочерний(ИдСв, "СвИнНеУч");
	Если ЮЛ <> Неопределено Тогда
		Результат.ИНН = Атрибут(ЮЛ, "ИННЮЛ");
		Результат.КПП = Атрибут(ЮЛ, "КПП");
		Результат.Наименование = Атрибут(ЮЛ, "НаимОрг");
	ИначеЕсли ИП <> Неопределено Тогда
		Результат.ЭтоИП = Истина;
		Результат.ИНН = Атрибут(ИП, "ИННФЛ");
		ФИО = Дочерний(ИП, "ФИО");
		Результат.Наименование = СокрЛП("ИП " + Атрибут(ФИО, "Фамилия") + " " + Атрибут(ФИО, "Имя") + " " + Атрибут(ФИО, "Отчество"));
	ИначеЕсли Ин <> Неопределено Тогда
		Результат.Иностранный = Истина;
		Результат.Наименование = Атрибут(Ин, "НаимОрг");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция РеквизитыДокумента(Знач Узел)
	Возврат Новый Структура("Наименование, Номер, Дата",
		Атрибут(Узел, "РеквНаимДок"), Атрибут(Узел, "РеквНомерДок"), ДатаИзСтроки(Атрибут(Узел, "РеквДатаДок")));
КонецФункции

Процедура ПрочитатьИнфПоля(Знач Узел, Поля)
	Если Узел = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Текст Из Дочерние(Узел, "ТекстИнф") Цикл
		ДобавитьИнфПоле(Поля, Текст);
	КонецЦикла;
КонецПроцедуры

// Повтор идентификатора (бывает у ИнфПолФХЖ2, например несколько штрихкодов) - значения
// через запятую: так их читает и подключаемый модуль Диадока («Для1С_Штрихкод»).
Процедура ДобавитьИнфПоле(Поля, Знач Узел)
	Ключ = Атрибут(Узел, "Идентиф");
	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат;
	КонецЕсли;
	Значение = Атрибут(Узел, "Значен");
	Было = Поля.Получить(Ключ);
	Поля.Вставить(Ключ, ?(Было = Неопределено, Значение, Было + "," + Значение));
КонецПроцедуры

// СумНал: число или «без НДС» (БезНДС) - тогда 0.
Функция СуммаНалога(Знач Узел)
	Если Узел = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Возврат ЧислоИзСтроки(ТекстЭлемента(Дочерний(Узел, "СумНал")));
КонецФункции

#КонецОбласти

#Область XML

Функция ДокументXML(Знач Данные)

	Чтение = Новый ЧтениеXML;
	Если ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
		Чтение.ОткрытьПоток(Данные.ОткрытьПотокДляЧтения());
	Иначе
		Чтение.УстановитьСтроку(Данные);
	КонецЕсли;
	Построитель = Новый ПостроительDOM;
	ДокументDOM = Построитель.Прочитать(Чтение);
	Чтение.Закрыть();
	Возврат ДокументDOM;

КонецФункции

// Первый дочерний элемент с именем; Неопределено, если нет (в том числе у Неопределено).
Функция Дочерний(Знач Элемент, Знач Имя)
	Если Элемент = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Узел = Элемент.ПервыйДочерний;
	Пока Узел <> Неопределено Цикл
		Если Узел.ТипУзла = ТипУзлаDOM.Элемент И Узел.ИмяЭлемента = Имя Тогда
			Возврат Узел;
		КонецЕсли;
		Узел = Узел.СледующийСоседний;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция Дочерние(Знач Элемент, Знач Имя)
	Результат = Новый Массив;
	Если Элемент = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Узел = Элемент.ПервыйДочерний;
	Пока Узел <> Неопределено Цикл
		Если Узел.ТипУзла = ТипУзлаDOM.Элемент И Узел.ИмяЭлемента = Имя Тогда
			Результат.Добавить(Узел);
		КонецЕсли;
		Узел = Узел.СледующийСоседний;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Атрибут(Знач Элемент, Знач Имя)
	Если Элемент = Неопределено ИЛИ НЕ Элемент.ЕстьАтрибут(Имя) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Элемент.ПолучитьАтрибут(Имя));
КонецФункции

Функция ТекстЭлемента(Знач Элемент)
	Если Элемент = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Элемент.ТекстовоеСодержимое);
КонецФункции

#КонецОбласти

#Область Преобразования

Функция ПервыйНепустой(Знач Значение1, Знач Значение2, Знач Значение3 = "")
	Если ЗначениеЗаполнено(Значение1) Тогда
		Возврат Значение1;
	ИначеЕсли ЗначениеЗаполнено(Значение2) Тогда
		Возврат Значение2;
	КонецЕсли;
	Возврат Значение3;
КонецФункции

// Число из атрибута ФНС: разделитель - точка, бывает запятая и пробелы. Пустое или
// нечисловое (например «-» у БезНДС) - 0.
Функция ЧислоИзСтроки(Знач Текст)
	Текст = СтрЗаменить(СтрЗаменить(СокрЛП(Текст), " ", ""), ",", ".");
	// Прочерк (сумма «без НДС» в схеме ФНС) и пустое значение - штатный ноль, а не ошибка разбора.
	Если НЕ ЗначениеЗаполнено(Текст) ИЛИ Текст = "-" Тогда
		Возврат 0;
	КонецЕсли;
	ОписаниеЧисла = Новый ОписаниеТипов("Число");
	Попытка
		Возврат ОписаниеЧисла.ПривестиЗначение(Число(Текст));
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Предупреждение, , , "ЧислоИзСтроки: «" + Текст + "» не число");
		Возврат 0;
	КонецПопытки;
КонецФункции

// Дата ФНС «ДД.ММ.ГГГГ». Неразборчивая - пустая дата.
Функция ДатаИзСтроки(Знач Текст)
	Части = СтрРазделить(СокрЛП(Текст), ".", Ложь);
	Если Части.Количество() <> 3 Тогда
		Возврат '00010101';
	КонецЕсли;
	Попытка
		Возврат Дата(Число(Части[2]), Число(Части[1]), Число(Части[0]));
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Предупреждение, , , "ДатаИзСтроки: «" + Текст + "» не дата");
		Возврат '00010101';
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область ПоступлениеПоУмолчанию

// Реализация по умолчанию для типовой УТ 10.3: поступление товаров и услуг по разобранному УПД.
// Документ не записывается - его пишет ядро после точки ПередЗаписьюДокументаПоВходящему.
// Параметры - см. ЭДО_Сервер.СоздатьДокументПоXML: Разбор, Организация, ДокументОбъект, Сообщения.
// Не найдены контрагент или номенклатура хоть одной строки - документ не создается (список
// несопоставленных строк - в Сообщения); не найден договор - создается с пустым договором.
Процедура ЗаполнитьПоступлениеПоУмолчанию(Параметры) Экспорт

	Если Метаданные.Документы.Найти("ПоступлениеТоваровУслуг") = Неопределено Тогда
		Параметры.Сообщения.Добавить("В конфигурации нет документа «Поступление товаров и услуг»: нужна точка профиля ПриСозданииДокументаПоВходящему");
		Возврат;
	КонецЕсли;
	Разбор = Параметры.Разбор;
	Если Разбор.Продавец = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Разбор.Продавец.ИНН) Тогда
		Параметры.Сообщения.Добавить("В документе не указан ИНН продавца");
		Возврат;
	КонецЕсли;
	// Документ в валюте не рубль загрузка по умолчанию не ведет: курс и пересчет - решение человека.
	Если ЗначениеЗаполнено(Разбор.Валюта) И Разбор.Валюта <> "643" Тогда
		Параметры.Сообщения.Добавить("УПД в валюте с кодом " + Разбор.Валюта + ": загрузка поддерживает только рубли (643)");
		Возврат;
	КонецЕсли;
	// ++ ЩА 13.10.2026 [yan]: поступление ставится на организацию-поставщика, а не на ее подразделение
	//    (решение владельца 13.10). КПП в УПД - часто КПП обособленного подразделения продавца (ТД ЛИОН:
	//    590445001 в СвПрод, головной 590601001 в документе нет вовсе), поэтому единственная карточка с
	//    ИНН продавца берется и при другом КПП - с замечанием. КПП выбирает только между несколькими
	//    карточками одного ИНН; не выбрал - отказ с перечнем (СсылкаПоИНН).
	КандидатСДругимКПП = Неопределено;
	Контрагент = КонтрагентПоИНН(Разбор.Продавец.ИНН, Разбор.Продавец.КПП, Параметры.Сообщения, КандидатСДругимКПП);
	Если НЕ ЗначениеЗаполнено(Контрагент) И КандидатСДругимКПП <> Неопределено Тогда
		Контрагент = КандидатСДругимКПП;
		Параметры.Сообщения.Добавить("КПП поставщика в документе " + Разбор.Продавец.КПП + " (подразделение), карточка "
			+ Строка(Контрагент) + " - КПП " + Контрагент.КПП + ": поступление на организацию по ИНН");
	КонецЕсли;
	// -- ЩА 13.10.2026 [yan].
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Параметры.Сообщения.Добавить("Не найден контрагент с ИНН " + Разбор.Продавец.ИНН + " (" + Разбор.Продавец.Наименование + ")");
		Возврат;
	КонецЕсли;

	// Строку без номенклатуры конфигурация не записывает (модуль документа читает объект номенклатуры
	// каждой строки), поэтому несопоставленные строки останавливают создание целиком.
	ПродавецНаш = ЕстьОрганизацияСИНН(Разбор.Продавец.ИНН);   // ЩА 12.10.2026 [yan]
	Неоднозначные = Новый Соответствие;
	ЕдиницыПоставщика = Новый Соответствие;
	Сопоставление = СопоставитьНоменклатуру(Разбор.Строки, Контрагент, ПродавецНаш, Неоднозначные, ЕдиницыПоставщика);
	Единицы = ЕдиницыСтрок(Разбор.Строки, Сопоставление, ЕдиницыПоставщика);
	ЕстьУслуги = Метаданные.Справочники.Номенклатура.Реквизиты.Найти("Услуга") <> Неопределено;
	Несопоставленные = 0;
	Номер = 0;
	Для Каждого СтрокаУПД Из Разбор.Строки Цикл
		Номер = Номер + 1;
		Описание = "Строка " + СтрокаУПД.НомерСтроки + " «" + СтрокаУПД.Наименование + "»";
		Кандидаты = Неоднозначные.Получить(Номер);
		Если Кандидаты <> Неопределено Тогда
			Несопоставленные = Несопоставленные + 1;
			Представления = Новый Массив;
			Для Каждого Кандидат Из Кандидаты Цикл
				Представления.Добавить(Строка(Кандидат));
			КонецЦикла;
			Параметры.Сообщения.Добавить(Описание + ": подходят несколько товаров (" + СтрСоединить(Представления, "; ")
				+ ") - оставьте в соответствии номенклатуры поставщика один");
		ИначеЕсли Сопоставление.Получить(Номер) = Неопределено Тогда
			Несопоставленные = Несопоставленные + 1;
			Параметры.Сообщения.Добавить(Описание + ": номенклатура не сопоставлена (код " + СтрокаУПД.КодТовара
				+ ?(ЗначениеЗаполнено(СтрокаУПД.GTIN), ", GTIN " + СтрокаУПД.GTIN, "") + ")");
		// ++ ЩА 12.10.2026 [yan], ревью Codex 528: услуги загрузка не заполняет (таблица товаров их не
		//    примет при проведении) - отказ до записи, документ оформляют вручную.
		ИначеЕсли ЕстьУслуги И Сопоставление.Получить(Номер).Услуга Тогда
			Несопоставленные = Несопоставленные + 1;
			Параметры.Сообщения.Добавить(Описание + ": сопоставлена услуга " + Строка(Сопоставление.Получить(Номер))
				+ " - загрузка создает поступление только по товарам, оформите документ вручную");
		// -- ЩА 12.10.2026 [yan].
		ИначеЕсли ТипЗнч(Единицы.Получить(Номер)) = Тип("Строка") Тогда
			Несопоставленные = Несопоставленные + 1;
			Параметры.Сообщения.Добавить(Описание + ": " + Единицы.Получить(Номер));
		КонецЕсли;
	КонецЦикла;
	Если Несопоставленные > 0 Тогда
		Параметры.Сообщения.Добавить("Не сопоставлено строк: " + Несопоставленные + " из " + Разбор.Строки.Количество()
			+ ". Заполните соответствие номенклатуры поставщика и загрузите документ снова");
		Возврат;
	КонецЕсли;

	Документ = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Организация = Параметры.Организация;
	Документ.Контрагент = Контрагент;
	Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	ЗаполнитьШапкуПоступления(Документ, Валюта, Параметры.Сообщения);
	Договор = ДоговорПоставщика(Контрагент, Параметры.Организация, Параметры.Сообщения);
	Документ.ДоговорКонтрагента = Договор;
	Если ЗначениеЗаполнено(Договор) И НЕ ЗначениеЗаполнено(Документ.ТипЦен) Тогда
		Документ.ТипЦен = Договор.ТипЦен;
	КонецЕсли;
	Если ЗначениеЗаполнено(Договор) И ЗначениеЗаполнено(Договор.ВалютаВзаиморасчетов) И Договор.ВалютаВзаиморасчетов <> Валюта Тогда
		Параметры.Сообщения.Добавить("Договор " + Строка(Договор) + " в валюте " + Строка(Договор.ВалютаВзаиморасчетов)
			+ ": загрузка поддерживает только рублевые договоры");
		Возврат;
	КонецЕсли;
	Документ.ВалютаДокумента = Валюта;
	Документ.КурсВзаиморасчетов = 1;
	Документ.КратностьВзаиморасчетов = 1;
	Документ.УчитыватьНДС = Истина;
	Документ.СуммаВключаетНДС = Истина;   // в УПД стоимость с налогом дана по строке точно
	Документ.НомерВходящегоДокумента = Лев(Разбор.Номер, Метаданные.Документы.ПоступлениеТоваровУслуг.Реквизиты.НомерВходящегоДокумента.Тип.КвалификаторыСтроки.Длина);
	Документ.ДатаВходящегоДокумента = Разбор.Дата;
	ЗаполнитьКакВПрошлыйРаз(Документ, Параметры.Сообщения);
	Документ.Комментарий = СокрЛП("Загружено из Платформы ЭДО: УПД № " + Разбор.Номер + " от "
		+ Формат(Разбор.Дата, "ДФ=dd.MM.yyyy") + ". " + Документ.Комментарий);

	МетаданныеДокумента = Метаданные.Документы.ПоступлениеТоваровУслуг;
	ЕстьШтрихкодыУпаковок = МетаданныеДокумента.ТабличныеЧасти.Найти("ШтрихкодыУпаковок") <> Неопределено;
	ЕстьАкциз = МетаданныеДокумента.ТабличныеЧасти.Товары.Реквизиты.Найти("СуммаАкциза") <> Неопределено;
	Ключ = 0;
	Сумма = 0;
	Для Каждого СтрокаУПД Из Разбор.Строки Цикл
		Ключ = Ключ + 1;
		Номенклатура = Сопоставление.Получить(Ключ);
		Товар = Документ.Товары.Добавить();
		Товар.Номенклатура = Номенклатура;
		Единица = Единицы.Получить(Ключ);
		Товар.ЕдиницаИзмерения = Единица.Единица;
		Товар.Коэффициент = Единица.Коэффициент;
		Товар.Количество = СтрокаУПД.Количество;
		Товар.Сумма = СтрокаУПД.СуммаСНДС;
		Товар.СуммаНДС = СтрокаУПД.СуммаНДС;
		Товар.Цена = ?(СтрокаУПД.Количество = 0, 0, Окр(СтрокаУПД.СуммаСНДС / СтрокаУПД.Количество, 2));
		Товар.СтавкаНДС = СтавкаНДСПоТексту(СтрокаУПД.СтавкаНДС);
		Если ЕстьАкциз Тогда
			Товар.СуммаАкциза = СтрокаУПД.СуммаАкциза;
		КонецЕсли;
		Товар.КлючСвязи = Ключ;
		Сумма = Сумма + СтрокаУПД.СуммаСНДС;
		Если ЕстьШтрихкодыУпаковок Тогда
			ДобавитьКодыМаркировки(Документ, СтрокаУПД);
		КонецЕсли;
	КонецЦикла;
	Документ.СуммаДокумента = Сумма;
	Параметры.ДокументОбъект = Документ;

КонецПроцедуры

// ЩА 15.10.2026 [yan]: шапка нового поступления так же, как ее заполняет форма нового документа
// (ЗаполнениеДокументов.ЗаполнитьШапкуДокумента): ответственный, флаги учета, вид поступления, склад
// и подразделение - из настроек пользователя. Документ.Заполнить(Неопределено) этого не делает:
// ОбработкаЗаполнения при пустом основании сразу выходит.
// У служебного пользователя регламента настроек может не быть - тогда флаги учета как у ручного
// поступления (управленческий - да, регламентированный - по организации), ответственный - он сам.
Процедура ЗаполнитьШапкуПоступления(Документ, Знач Валюта, Сообщения)

	Пользователь = ПараметрыСеанса.ТекущийПользователь;
	// ЩА 15.10.2026 [yan]: конфигурации расходятся в сигнатуре ЗаполнитьШапкуДокумента (УТ 10.3 - с видом
	// операции, КА 1.1 - без него, лишний параметр падает при выполнении): профиль может заполнить шапку сам.
	ПараметрыШапки = Новый Структура("Документ, Пользователь, Валюта, СтандартнаяОбработка",
		Документ, Пользователь, Валюта, Истина);
	ЭДО_Сервер.ВызватьНеобязательнуюТочкуПрофиля("ПриЗаполненииШапкиПоступления", ПараметрыШапки);
	Если ПараметрыШапки.СтандартнаяОбработка Тогда
		ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(Документ, Пользователь, Валюта, "Покупка");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Документ.ВидПоступления) Тогда
		Документ.ВидПоступления = Перечисления.ВидыПоступленияТоваров.НаСклад;
	КонецЕсли;
	Если НЕ Документ.ОтражатьВУправленческомУчете И НЕ Документ.ОтражатьВБухгалтерскомУчете Тогда
		Документ.ОтражатьВУправленческомУчете = Истина;
		Регл = Документ.Организация.ОтражатьВРегламентированномУчете;
		Документ.ОтражатьВБухгалтерскомУчете = Регл;
		Документ.ОтражатьВНалоговомУчете = Регл;
		Сообщения.Добавить("У пользователя не заданы флаги учета по умолчанию - поступление отражено"
			+ " в управленческом учете" + ?(Регл, ", бухгалтерском и налоговом", "") + " - проверьте");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Документ.Ответственный) Тогда
		Документ.Ответственный = Пользователь;
	КонецЕсли;

КонецПроцедуры

// Склад и подразделение, которые не подставились из настроек пользователя (у пользователя
// регламента или служебного пользователя их нет), - из последнего поступления этой организации
// от этого поставщика, а если его нет - из последнего поступления организации.
Процедура ЗаполнитьКакВПрошлыйРаз(Документ, Сообщения)

	Если ЗначениеЗаполнено(Документ.СкладОрдер) И ЗначениеЗаполнено(Документ.Подразделение) Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Поступление.СкладОрдер КАК СкладОрдер,
		|	Поступление.Подразделение КАК Подразделение,
		|	ВЫБОР КОГДА Поступление.Контрагент = &Контрагент ТОГДА 0 ИНАЧЕ 1 КОНЕЦ КАК Порядок
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК Поступление
		|ГДЕ
		|	Поступление.Проведен
		|	И Поступление.Организация = &Организация
		|	И Поступление.Дата > &Граница
		|УПОРЯДОЧИТЬ ПО
		|	Порядок,
		|	Поступление.Дата УБЫВ");
	Запрос.УстановитьПараметр("Организация", Документ.Организация);
	Запрос.УстановитьПараметр("Контрагент", Документ.Контрагент);
	Запрос.УстановитьПараметр("Граница", ДобавитьМесяц(ТекущаяДатаСеанса(), -6));
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Сообщения.Добавить("Не заполнен склад: нет поступлений организации за полгода, укажите склад");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Документ.СкладОрдер) Тогда
		Документ.СкладОрдер = Выборка.СкладОрдер;
		Сообщения.Добавить("Склад взят из прошлого поступления: " + Строка(Выборка.СкладОрдер) + " - проверьте");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Документ.Подразделение) Тогда
		Документ.Подразделение = Выборка.Подразделение;
	КонецЕсли;

КонецПроцедуры

// Коды маркировки строки как пришли в УПД: КИЗ, групповые и транспортные упаковки. Раскрыть
// упаковку до единиц и связать коды со строками - работа базы (обработки маркировки).
Процедура ДобавитьКодыМаркировки(Документ, Знач СтрокаУПД)
	Для Каждого ИмяСписка Из СтрРазделить("КИЗ,Упаковки,ТранспортныеУпаковки", ",") Цикл
		Для Каждого Код Из СтрокаУПД[ИмяСписка] Цикл
			Документ.ШтрихкодыУпаковок.Добавить().ЗначениеШтрихкода = Код;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Организация базы по ИНН (и КПП, если по ИНН их несколько). Пустая ссылка - не наша.
// ЩА 12.10.2026 [yan]: есть ли в базе организация с этим ИНН (сколько бы карточек ни было).
// ЩА 20.10.2026 [yan]: поступления базы, уже заведенные по тем же УПД (склад создал по ТТН ЕГАИС раньше,
// чем пришел УПД), - чтобы не заводить второе, а привязать входящий к имеющемуся.
// Входящие - Массив структур (Ид, Организация, ИННПродавца, Номер, Дата).
// ПоНомеру = Истина - с номером входящего документа, равным номеру УПД, за 45 дней от даты УПД;
// Ложь - все от поставщика (по ИНН) за 10 дней вокруг даты УПД.
// Свойство - ЭДО_ВходящийИдентификатор: документы, уже связанные с входящими, не предлагаются.
// Возврат: Соответствие (Ид -> Массив ссылок, новые сверху).
Функция ПоступленияПоВходящим(Знач Входящие, Знач ПоНомеру, Знач Свойство) Экспорт

	Итог = Новый Соответствие;
	МетаПоступления = Метаданные.Документы.Найти("ПоступлениеТоваровУслуг");
	Если МетаПоступления = Неопределено ИЛИ Входящие.Количество() = 0
		ИЛИ (ПоНомеру И МетаПоступления.Реквизиты.Найти("НомерВходящегоДокумента") = Неопределено) Тогда
		Возврат Итог;
	КонецЕсли;
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Ид", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Таблица.Колонки.Добавить("ИННПродавца", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(12)));
	Таблица.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Начало", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("Конец", Новый ОписаниеТипов("Дата"));
	Окно = ?(ПоНомеру, 45, 10) * 86400;
	Для Каждого Входящий Из Входящие Цикл
		Если НЕ ЗначениеЗаполнено(Входящий.ИННПродавца) ИЛИ НЕ ЗначениеЗаполнено(Входящий.Организация)
			ИЛИ НЕ ЗначениеЗаполнено(Входящий.Дата) ИЛИ (ПоНомеру И НЕ ЗначениеЗаполнено(Входящий.Номер)) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаВходящего = Таблица.Добавить();
		СтрокаВходящего.Ид = СокрЛП(Входящий.Ид);
		СтрокаВходящего.Организация = Входящий.Организация;
		СтрокаВходящего.ИННПродавца = СокрЛП(Входящий.ИННПродавца);
		СтрокаВходящего.Номер = СокрЛП(Входящий.Номер);
		СтрокаВходящего.Начало = НачалоДня(Входящий.Дата) - Окно;
		СтрокаВходящего.Конец = КонецДня(Входящий.Дата) + Окно;
	КонецЦикла;
	Если Таблица.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.Ид КАК Ид,
		|	Т.Организация КАК Организация,
		|	Т.ИННПродавца КАК ИННПродавца,
		|	Т.Номер КАК Номер,
		|	Т.Начало КАК Начало,
		|	Т.Конец КАК Конец
		|ПОМЕСТИТЬ Вх
		|ИЗ
		|	&Входящие КАК Т
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Вх.Ид КАК Ид,
		|	П.Ссылка КАК Ссылка,
		|	П.Дата КАК Дата
		|ИЗ
		|	Вх КАК Вх
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК П
		|		ПО (П.Организация = Вх.Организация)
		|			И (П.Контрагент.ИНН = Вх.ИННПродавца)
		|			И (П.Дата МЕЖДУ Вх.Начало И Вх.Конец)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Связь
		|		ПО (Связь.Объект = П.Ссылка)
		|			И (Связь.Свойство = &Свойство)
		|ГДЕ
		|	НЕ П.ПометкаУдаления
		|	И Связь.Объект ЕСТЬ NULL" + ?(ПоНомеру, "
		|	И П.НомерВходящегоДокумента = Вх.Номер", "") + "
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ");
	Запрос.УстановитьПараметр("Входящие", Таблица);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Найденные = Итог.Получить(Выборка.Ид);
		Если Найденные = Неопределено Тогда
			Найденные = Новый Массив;
			Итог.Вставить(Выборка.Ид, Найденные);
		КонецЕсли;
		Найденные.Добавить(Выборка.Ссылка);
	КонецЦикла;
	Возврат Итог;

КонецФункции

Функция ЕстьОрганизацияСИНН(Знач ИНН) Экспорт
	Если НЕ ЗначениеЗаполнено(СокрЛП(ИНН)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Орг.Ссылка ИЗ Справочник.Организации КАК Орг ГДЕ Орг.ИНН = &ИНН И НЕ Орг.ПометкаУдаления");
	Запрос.УстановитьПараметр("ИНН", СокрЛП(ИНН));
	Возврат НЕ Запрос.Выполнить().Пустой();
КонецФункции

// ЩА 13.10.2026 [yan]: единственная организация с ИНН покупателя берется и при КПП ее обособленного
// подразделения (филиала) - учет ведется на организацию (решение владельца 13.10), с замечанием.
Функция ОрганизацияПоИНН(Знач ИНН, Знач КПП, Сообщения = Неопределено) Экспорт
	КандидатСДругимКПП = Неопределено;
	Итог = СсылкаПоИНН("Организации", ИНН, КПП, Сообщения, КандидатСДругимКПП);
	Если КандидатСДругимКПП <> Неопределено Тогда
		Итог = КандидатСДругимКПП;
		Если Сообщения <> Неопределено Тогда
			Сообщения.Добавить("КПП покупателя в документе " + КПП + " (подразделение), у организации " + Строка(Итог)
				+ " - " + Итог.КПП + ": организация по ИНН");
		КонецЕсли;
	КонецЕсли;
	Возврат Итог;
КонецФункции

// КандидатСДругимКПП - единственная карточка с ИНН, чей КПП не совпал с КПП документа (сама не возвращается:
// брать ли ее, решает вызывающий).
Функция КонтрагентПоИНН(Знач ИНН, Знач КПП, Сообщения = Неопределено, КандидатСДругимКПП = Неопределено) Экспорт
	Возврат СсылкаПоИНН("Контрагенты", ИНН, КПП, Сообщения, КандидатСДругимКПП);
КонецФункции

// Карточка справочника по ИНН и КПП - только однозначная. Несколько подходящих - Неопределено и
// перечень в Сообщения. Единственная карточка с другим КПП - Неопределено, а сама она - в
// КандидатСДругимКПП: брать ли ее, решает вызывающий.
Функция СсылкаПоИНН(Знач ИмяСправочника, Знач ИНН, Знач КПП, Сообщения = Неопределено, КандидатСДругимКПП = Неопределено)

	ИНН = СокрЛП(ИНН);
	Если НЕ ЗначениеЗаполнено(ИНН) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЕстьГруппы = Метаданные.Справочники[ИмяСправочника].Иерархический;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Спр.Ссылка КАК Ссылка,
		|	Спр.КПП КАК КПП
		|ИЗ
		|	Справочник." + ИмяСправочника + " КАК Спр
		|ГДЕ
		|	Спр.ИНН = &ИНН
		|	И НЕ Спр.ПометкаУдаления" + ?(ЕстьГруппы, "
		|	И НЕ Спр.ЭтоГруппа", "") + "
		|УПОРЯДОЧИТЬ ПО
		|	Спр.Код");
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	// ++ ЩА 12.10.2026 [yan], ревью Codex 525, 528: только однозначная карточка. Несколько с тем же ИНН
	//    (и КПП) или КПП не совпал при нескольких - отказ с перечнем; единственная с другим КПП -
	//    кандидат на подтверждение, сама не берется.
	Подходящие = ?(ЗначениеЗаполнено(КПП), Таблица.НайтиСтроки(Новый Структура("КПП", СокрЛП(КПП))), Новый Массив);
	Если Подходящие.Количество() = 1 Тогда
		Возврат Подходящие[0].Ссылка;
	КонецЕсли;
	Если Таблица.Количество() = 1 И Подходящие.Количество() = 0 Тогда
		Если ЗначениеЗаполнено(КПП) Тогда
			КандидатСДругимКПП = Таблица[0].Ссылка;
			Возврат Неопределено;
		КонецЕсли;
		Возврат Таблица[0].Ссылка;
	КонецЕсли;
	Если Сообщения <> Неопределено Тогда
		Кандидаты = Новый Массив;
		Для Каждого Стр Из ?(Подходящие.Количество() > 1, Подходящие, Таблица) Цикл
			Кандидаты.Добавить(Строка(Стр.Ссылка) + " (КПП " + Стр.КПП + ")");
		КонецЦикла;
		Сообщения.Добавить("По ИНН " + ИНН + ?(ЗначениеЗаполнено(КПП), " и КПП " + КПП, "")
			+ " карточка не выбирается однозначно: " + СтрСоединить(Кандидаты, "; "));
	КонецЕсли;
	Возврат Неопределено;
	// -- ЩА 12.10.2026 [yan].

КонецФункции

// Договор с поставщиком: основной договор контрагента, если он подходит, иначе единственный,
// иначе последний по дате - с замечанием, что выбран не однозначно.
Функция ДоговорПоставщика(Знач Контрагент, Знач Организация, Сообщения)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Договоры.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Договоры
		|ГДЕ
		|	Договоры.Владелец = &Контрагент
		|	И Договоры.Организация = &Организация
		|	И Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком)
		|	И НЕ Договоры.ПометкаУдаления
		|	И НЕ Договоры.ЭтоГруппа
		|УПОРЯДОЧИТЬ ПО
		|	Договоры.Дата УБЫВ");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Договоры = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Если Договоры.Количество() = 0 Тогда
		Сообщения.Добавить("Нет договора с поставщиком " + Строка(Контрагент) + " у организации " + Строка(Организация));
		Возврат Неопределено;
	КонецЕсли;
	Основной = Контрагент.ОсновнойДоговорКонтрагента;
	Если Договоры.Найти(Основной) <> Неопределено Тогда
		Возврат Основной;
	КонецЕсли;
	Если Договоры.Количество() > 1 Тогда
		Сообщения.Добавить("У поставщика несколько договоров, выбран " + Строка(Договоры[0]) + " - проверьте");
	КонецЕсли;
	Возврат Договоры[0];

КонецФункции

// Номенклатура строк УПД, одним пакетом запросов на документ. Порядок поиска: соответствие
// номенклатуры контрагента (код, идентификатор, артикул, штрихкод, наименование), штрихкоды
// базы (GTIN и «Для1С_Штрихкод» из ИнфПолФХЖ2), а если продавец - своя организация, код
// номенклатуры (КодТов в нашем же УПД - наш код).
// На лучшем для строки уровне поиска несколько разных товаров - строка не сопоставлена, кандидаты
// уходят в Неоднозначные (номер строки -> Массив): молча взять первый значит ошибиться товаром.
// Возврат: Соответствие (номер строки по порядку, с 1 -> номенклатура). Не найденных нет в ответе.
// ЕдиницыПоставщика (необязательно, Соответствие) - заполняется единицей из соответствия поставщика
// для выбранного товара (номер строки -> единица или Строка - причина отказа).
Функция СопоставитьНоменклатуру(Знач СтрокиУПД, Знач Контрагент, Знач ПродавецНаш, Неоднозначные = Неопределено,
	ЕдиницыПоставщика = Неопределено) Экспорт

	Итог = Новый Соответствие;
	Ключи = Новый ТаблицаЗначений;
	Ключи.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Число"));
	Ключи.Колонки.Добавить("Приоритет", Новый ОписаниеТипов("Число"));
	Ключи.Колонки.Добавить("Поле", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Ключи.Колонки.Добавить("Значение", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Номер = 0;
	Для Каждого СтрокаУПД Из СтрокиУПД Цикл
		Номер = Номер + 1;
		Приоритет = 0;
		Для Каждого Поиск Из ПоляПоискаНоменклатурыКонтрагента(СтрокаУПД) Цикл
			Приоритет = Приоритет + 1;
			Если ЗначениеЗаполнено(Поиск.Значение) Тогда
				НоваяСтрока = Ключи.Добавить();
				НоваяСтрока.Ключ = Номер;
				НоваяСтрока.Приоритет = Приоритет;
				НоваяСтрока.Поле = Поиск.Поле;
				НоваяСтрока.Значение = Поиск.Значение;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Код Из ШтрихкодыСтроки(СтрокаУПД) Цикл
			НоваяСтрока = Ключи.Добавить();
			НоваяСтрока.Ключ = Номер;
			НоваяСтрока.Приоритет = 10;
			НоваяСтрока.Поле = "Штрихкод";
			НоваяСтрока.Значение = Код;
		КонецЦикла;
		Если ПродавецНаш И ЗначениеЗаполнено(СтрокаУПД.КодТовара) Тогда
			НоваяСтрока = Ключи.Добавить();
			НоваяСтрока.Ключ = Номер;
			// ЩА 12.10.2026 [yan]: у своего продавца КодТов - код нашей же номенклатуры, он точнее
			// соответствий контрагента и наименования (те находили 2+ похожих товара) - ищем первым.
			НоваяСтрока.Приоритет = 0;
			НоваяСтрока.Поле = "Код";
			НоваяСтрока.Значение = СтрокаУПД.КодТовара;
		КонецЕсли;
	КонецЦикла;
	Если Ключи.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;

	Части = Новый Массив;
	РС = Метаданные.РегистрыСведений.Найти("НоменклатураКонтрагентов");
	Если РС <> Неопределено Тогда
		Поля = Новый Соответствие;
		ПолеЕдиницы = ?(РС.Ресурсы.Найти("ЕдиницаИзмерения") <> Неопределено, "Соответствие.ЕдиницаИзмерения", "NULL");
		Для Каждого Поиск Из ПоляПоискаНоменклатурыКонтрагента(СтрокиУПД[0]) Цикл
			Если РС.Ресурсы.Найти(Поиск.Поле) <> Неопределено И Поля.Получить(Поиск.Поле) = Неопределено Тогда
				Поля.Вставить(Поиск.Поле, Истина);
				Части.Добавить(
					"ВЫБРАТЬ К.Ключ КАК Ключ, К.Приоритет КАК Приоритет, Соответствие.Номенклатура КАК Номенклатура,
					|	" + ПолеЕдиницы + " КАК Единица
					|ИЗ ВТКлючи КАК К
					|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоменклатураКонтрагентов КАК Соответствие
					|	ПО Соответствие.Контрагент = &Контрагент
					|		И К.Поле = """ + Поиск.Поле + """
					|		И ВЫРАЗИТЬ(Соответствие." + Поиск.Поле + " КАК СТРОКА(250)) = К.Значение
					|ГДЕ Соответствие.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Метаданные.РегистрыСведений.Найти("Штрихкоды") <> Неопределено Тогда
		Части.Добавить(
			"ВЫБРАТЬ К.Ключ КАК Ключ, К.Приоритет КАК Приоритет, ВЫРАЗИТЬ(Штрихкоды.Владелец КАК Справочник.Номенклатура) КАК Номенклатура, NULL КАК Единица
			|ИЗ ВТКлючи КАК К
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Штрихкоды
			|	ПО К.Поле = ""Штрихкод""
			|		И Штрихкоды.Штрихкод = К.Значение
			|		И Штрихкоды.Владелец ССЫЛКА Справочник.Номенклатура");
	КонецЕсли;
	Части.Добавить(
		"ВЫБРАТЬ К.Ключ КАК Ключ, К.Приоритет КАК Приоритет, Спр.Ссылка КАК Номенклатура, NULL КАК Единица
		|ИЗ ВТКлючи КАК К
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Спр
		|	ПО К.Поле = ""Код""
		|		И Спр.Код = К.Значение
		|ГДЕ НЕ Спр.ЭтоГруппа И НЕ Спр.ПометкаУдаления");

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Ключи.Ключ КАК Ключ, Ключи.Приоритет КАК Приоритет, Ключи.Поле КАК Поле, Ключи.Значение КАК Значение
		|ПОМЕСТИТЬ ВТКлючи
		|ИЗ &Ключи КАК Ключи
		|;
		|ВЫБРАТЬ Найденные.Ключ КАК Ключ, Найденные.Приоритет КАК Приоритет, Найденные.Номенклатура КАК Номенклатура,
		|	Найденные.Единица КАК Единица
		|ИЗ (" + СтрСоединить(Части, "
		|ОБЪЕДИНИТЬ ВСЕ
		|") + ") КАК Найденные
		|УПОРЯДОЧИТЬ ПО Ключ, Приоритет");
	Запрос.УстановитьПараметр("Ключи", Ключи);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	// По каждой строке - найденные номенклатуры по приоритетам (0 - код своего продавца).
	ПоСтрокам = Новый Соответствие;   // ключ -> Соответствие (приоритет -> Массив номенклатур)
	ЕдиницыПоСоответствию = Новый Соответствие;   // ключ -> Соответствие (номенклатура -> Соответствие (приоритет -> Массив единиц))
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		ПоПриоритетам = ПоСтрокам.Получить(Выборка.Ключ);
		Если ПоПриоритетам = Неопределено Тогда
			ПоПриоритетам = Новый Соответствие;
			ПоСтрокам.Вставить(Выборка.Ключ, ПоПриоритетам);
		КонецЕсли;
		Набор = ПоПриоритетам.Получить(Выборка.Приоритет);
		Если Набор = Неопределено Тогда
			Набор = Новый Массив;
			ПоПриоритетам.Вставить(Выборка.Приоритет, Набор);
		КонецЕсли;
		Если Набор.Найти(Выборка.Номенклатура) = Неопределено Тогда
			Набор.Добавить(Выборка.Номенклатура);
		КонецЕсли;
		// ЩА 12.10.2026 [yan], ревью Codex 528, 530: единицы по товарам строки с уровнем поиска - единица
		// берется только с того уровня, который определил товар (уровень без единицы тоже запоминается).
		Если Выборка.Приоритет > 0 Тогда
			ПоТоварам = ЕдиницыПоСоответствию.Получить(Выборка.Ключ);
			Если ПоТоварам = Неопределено Тогда
				ПоТоварам = Новый Соответствие;
				ЕдиницыПоСоответствию.Вставить(Выборка.Ключ, ПоТоварам);
			КонецЕсли;
			ПоУровням = ПоТоварам.Получить(Выборка.Номенклатура);
			Если ПоУровням = Неопределено Тогда
				ПоУровням = Новый Соответствие;
				ПоТоварам.Вставить(Выборка.Номенклатура, ПоУровням);
			КонецЕсли;
			Единицы = ПоУровням.Получить(Выборка.Приоритет);
			Если Единицы = Неопределено Тогда
				Единицы = Новый Массив;
				ПоУровням.Вставить(Выборка.Приоритет, Единицы);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.Единица) И Единицы.Найти(Выборка.Единица) = Неопределено Тогда
				Единицы.Добавить(Выборка.Единица);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Пара Из ПоСтрокам Цикл
		// ++ ЩА 12.10.2026 [yan], ревью Codex 525: код своего продавца (приоритет 0) не означает общий
		//    справочник товаров. Принимаем его, только если наименование номенклатуры совпало с НаимТов
		//    и не противоречит соответствию поставщика или штрихкоду; иначе решают прочие источники,
		//    а код остается последним доводом, как было до переноса в приоритет 0.
		ПоКоду = Пара.Значение.Получить(0);
		Прочие = Неопределено;
		ЛучшийПрочий = Неопределено;
		Для Каждого ПП Из Пара.Значение Цикл
			Если ПП.Ключ > 0 И (ЛучшийПрочий = Неопределено ИЛИ ПП.Ключ < ЛучшийПрочий) Тогда
				ЛучшийПрочий = ПП.Ключ;
				Прочие = ПП.Значение;
			КонецЕсли;
		КонецЦикла;
		Подтвержденные = ?(ПоКоду = Неопределено, Новый Массив,
			КандидатыПоНаименованию(ПоКоду, СтрокиУПД[Пара.Ключ - 1].Наименование));
		Если Подтвержденные.Количество() = 1 Тогда
			Если Прочие <> Неопределено И Прочие.Найти(Подтвержденные[0]) = Неопределено Тогда
				Конфликт = Новый Массив;
				Конфликт.Добавить(Подтвержденные[0]);
				Для Каждого Н Из Прочие Цикл
					Конфликт.Добавить(Н);
				КонецЦикла;
				Если Неоднозначные <> Неопределено Тогда
					Неоднозначные.Вставить(Пара.Ключ, Конфликт);   // код и соответствие поставщика расходятся
				КонецЕсли;
			Иначе
				Итог.Вставить(Пара.Ключ, Подтвержденные[0]);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		// ++ ЩА 12.10.2026 [yan], ревью Codex 528: код без подтверждения наименованием товар не определяет -
		//    совпадение кода с чужим товаром базы случайно; без соответствия поставщика и штрихкода строка
		//    остается несопоставленной.
		Если Прочие <> Неопределено Тогда
			Кандидаты = Прочие;
		ИначеЕсли Подтвержденные.Количество() > 1 Тогда
			Кандидаты = Подтвержденные;
		Иначе
			Продолжить;
		КонецЕсли;
		// -- ЩА 12.10.2026 [yan].
		Если Кандидаты.Количество() = 1 Тогда
			Итог.Вставить(Пара.Ключ, Кандидаты[0]);
		ИначеЕсли Неоднозначные <> Неопределено Тогда
			Неоднозначные.Вставить(Пара.Ключ, Кандидаты);
		КонецЕсли;
	КонецЦикла;
	// ++ ЩА 12.10.2026 [yan], ревью Codex 528, 530: единица из соответствия поставщика для выбранного
	//    товара - с лучшего уровня поиска, на котором этот товар нашелся (для товара по подтвержденному коду
	//    - лучший уровень соответствий). Нет единицы на этом уровне - подбор по ОКЕИ; несколько - отказ.
	Если ЕдиницыПоставщика <> Неопределено Тогда
		Для Каждого Пара Из Итог Цикл
			ПоТоварам = ЕдиницыПоСоответствию.Получить(Пара.Ключ);
			ПоУровням = ?(ПоТоварам = Неопределено, Неопределено, ПоТоварам.Получить(Пара.Значение));
			Если ПоУровням = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ЛучшийУровень = Неопределено;
			Для Каждого Уровень Из ПоУровням Цикл
				Если ЛучшийУровень = Неопределено ИЛИ Уровень.Ключ < ЛучшийУровень Тогда
					ЛучшийУровень = Уровень.Ключ;
				КонецЕсли;
			КонецЦикла;
			Единицы = ПоУровням.Получить(ЛучшийУровень);
			Если Единицы.Количество() = 0 Тогда
				Продолжить;
			ИначеЕсли Единицы.Количество() = 1 Тогда
				ЕдиницыПоставщика.Вставить(Пара.Ключ, Единицы[0]);
			Иначе
				ЕдиницыПоставщика.Вставить(Пара.Ключ, "в соответствии номенклатуры поставщика у товара несколько единиц"
					+ " на одном уровне поиска - оставьте одну");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// -- ЩА 12.10.2026 [yan].
	Возврат Итог;

КонецФункции

// Единица строки по ОКЕИ из УПД (штука 796 и бутылка 868 считаются одним - так их ведут поставщики
// напитков). Единица из соответствия поставщика (ЕдиницыПоставщика) берется первой, если ее код
// совпадает с ОКЕИ строки. Иначе - все единицы товара с этим кодом, включая единицу хранения: одна
// или несколько с одинаковым коэффициентом - берется она (единица хранения первой); разные
// коэффициенты или ни одной - строка не принимается: коробка по 12, принятая как 1 штука по цене
// коробки, хуже отказа.
// Возврат: Соответствие (номер строки -> Структура (Единица, Коэффициент) или Строка - причина отказа).
Функция ЕдиницыСтрок(Знач СтрокиУПД, Знач Сопоставление, Знач ЕдиницыПоставщика = Неопределено) Экспорт

	Итог = Новый Соответствие;
	МетаЕдиниц = Метаданные.Справочники.Найти("ЕдиницыИзмерения");
	ЕстьКлассификатор = МетаЕдиниц <> Неопределено И МетаЕдиниц.Реквизиты.Найти("ЕдиницаПоКлассификатору") <> Неопределено
		И МетаЕдиниц.Реквизиты.Найти("Коэффициент") <> Неопределено;
	Пары = Новый ТаблицаЗначений;
	Пары.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Число"));
	Пары.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Пары.Колонки.Добавить("ОКЕИ", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(10)));
	Номер = 0;
	Для Каждого СтрокаУПД Из СтрокиУПД Цикл
		Номер = Номер + 1;
		Номенклатура = Сопоставление.Получить(Номер);
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		ОКЕИ = ОКЕИДляСравнения(СтрокаУПД.КодОКЕИ);
		// ++ ЩА 12.10.2026 [yan], ревью Codex 528: единица из соответствия поставщика.
		ЕдиницаПоставщика = ?(ЕдиницыПоставщика = Неопределено, Неопределено, ЕдиницыПоставщика.Получить(Номер));
		Если ТипЗнч(ЕдиницаПоставщика) = Тип("Строка") Тогда
			Итог.Вставить(Номер, ЕдиницаПоставщика);
			Продолжить;
		ИначеЕсли ЗначениеЗаполнено(ЕдиницаПоставщика) И ЕстьКлассификатор Тогда
			Если ЕдиницаПоставщика.Владелец <> Номенклатура
				И ЕдиницаПоставщика <> Номенклатура.ЕдиницаХраненияОстатков Тогда
				Итог.Вставить(Номер, "единица " + Строка(ЕдиницаПоставщика) + " из соответствия поставщика не принадлежит товару");
			ИначеЕсли ЗначениеЗаполнено(ОКЕИ)
				И ОКЕИДляСравнения(ЕдиницаПоставщика.ЕдиницаПоКлассификатору.Код) <> ОКЕИ Тогда
				Итог.Вставить(Номер, "в соответствии поставщика единица " + Строка(ЕдиницаПоставщика) + " (ОКЕИ "
					+ СокрЛП(ЕдиницаПоставщика.ЕдиницаПоКлассификатору.Код) + "), а в УПД ОКЕИ " + СтрокаУПД.КодОКЕИ);
			Иначе
				Итог.Вставить(Номер, Новый Структура("Единица, Коэффициент", ЕдиницаПоставщика,
					?(ЗначениеЗаполнено(ЕдиницаПоставщика.Коэффициент), ЕдиницаПоставщика.Коэффициент, 1)));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		// -- ЩА 12.10.2026 [yan].
		Пара = Пары.Добавить();
		Пара.Ключ = Номер;
		Пара.Номенклатура = Номенклатура;
		Пара.ОКЕИ = ОКЕИ;
	КонецЦикла;
	Если Пары.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;
	Если НЕ ЕстьКлассификатор Тогда
		Для Каждого Пара Из Пары Цикл
			Итог.Вставить(Пара.Ключ, Новый Структура("Единица, Коэффициент", Пара.Номенклатура.ЕдиницаХраненияОстатков, 1));
		КонецЦикла;
		Возврат Итог;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Пары.Ключ КАК Ключ, Пары.Номенклатура КАК Номенклатура, Пары.ОКЕИ КАК ОКЕИ
		|ПОМЕСТИТЬ ВТПары
		|ИЗ &Пары КАК Пары
		|;
		|ВЫБРАТЬ
		|	П.Ключ КАК Ключ,
		|	П.ОКЕИ КАК ОКЕИ,
		|	Хранения.Ссылка КАК ЕдиницаХранения,
		|	Хранения.Коэффициент КАК КоэффициентХранения,
		|	ЕСТЬNULL(Хранения.ЕдиницаПоКлассификатору.Код, """") КАК КодХранения,
		|	Подходящая.Ссылка КАК Подходящая,
		|	Подходящая.Коэффициент КАК КоэффициентПодходящей
		|ИЗ ВТПары КАК П
		|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК Хранения
		|	ПО Хранения.Ссылка = П.Номенклатура.ЕдиницаХраненияОстатков
		|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК Подходящая
		|	ПО Подходящая.Владелец = П.Номенклатура
		|		И НЕ Подходящая.ПометкаУдаления
		|		И (Подходящая.ЕдиницаПоКлассификатору.Код = П.ОКЕИ
		|			ИЛИ П.ОКЕИ = ""796"" И Подходящая.ЕдиницаПоКлассификатору.Код = ""868"")
		|УПОРЯДОЧИТЬ ПО Ключ");
	Запрос.УстановитьПараметр("Пары", Пары);
	// ++ ЩА 12.10.2026 [yan], ревью Codex 528: сначала все подходящие единицы строки (и единица хранения,
	//    если ее код совпал), потом выбор - разные коэффициенты дают отказ и для единицы хранения.
	ПоСтрокам = Новый Соответствие;   // ключ -> Структура (ОКЕИ, КодХранения, Подходящие - Массив Структура (Единица, Коэффициент))
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Данные = ПоСтрокам.Получить(Выборка.Ключ);
		Если Данные = Неопределено Тогда
			Данные = Новый Структура("ОКЕИ, КодХранения, Подходящие", Выборка.ОКЕИ, СокрЛП(Выборка.КодХранения), Новый Массив);
			ПоСтрокам.Вставить(Выборка.Ключ, Данные);
			Если НЕ ЗначениеЗаполнено(Выборка.ОКЕИ) ИЛИ ОКЕИДляСравнения(Выборка.КодХранения) = Выборка.ОКЕИ Тогда
				ДобавитьЕдиницуСтроки(Данные.Подходящие, Выборка.ЕдиницаХранения, Выборка.КоэффициентХранения);
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ОКЕИ) И ЗначениеЗаполнено(Выборка.Подходящая) Тогда
			ДобавитьЕдиницуСтроки(Данные.Подходящие, Выборка.Подходящая, Выборка.КоэффициентПодходящей);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Пара Из ПоСтрокам Цикл
		Данные = Пара.Значение;
		Если Данные.Подходящие.Количество() = 0 Тогда
			Итог.Вставить(Пара.Ключ, "у товара нет единицы с кодом ОКЕИ " + Данные.ОКЕИ
				+ " (единица хранения - код " + Данные.КодХранения + ")");
			Продолжить;
		КонецЕсли;
		Коэффициенты = Новый Массив;
		Представления = Новый Массив;
		Для Каждого Подходящая Из Данные.Подходящие Цикл
			Представления.Добавить(Строка(Подходящая.Единица) + " x" + Подходящая.Коэффициент);
			Если Коэффициенты.Найти(Подходящая.Коэффициент) = Неопределено Тогда
				Коэффициенты.Добавить(Подходящая.Коэффициент);
			КонецЕсли;
		КонецЦикла;
		Если Коэффициенты.Количество() > 1 Тогда
			Итог.Вставить(Пара.Ключ, "у товара несколько единиц с кодом ОКЕИ " + Данные.ОКЕИ + " и разными коэффициентами ("
				+ СтрСоединить(Представления, "; ") + ") - укажите единицу в соответствии номенклатуры поставщика");
		Иначе
			Итог.Вставить(Пара.Ключ, Данные.Подходящие[0]);
		КонецЕсли;
	КонецЦикла;
	// -- ЩА 12.10.2026 [yan].
	Возврат Итог;

КонецФункции

// ЩА 12.10.2026 [yan]: единица в список подходящих строки без повторов; пустой коэффициент - 1.
Процедура ДобавитьЕдиницуСтроки(Подходящие, Знач Единица, Знач Коэффициент)
	Для Каждого Подходящая Из Подходящие Цикл
		Если Подходящая.Единица = Единица Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Подходящие.Добавить(Новый Структура("Единица, Коэффициент", Единица, ?(ЗначениеЗаполнено(Коэффициент), Коэффициент, 1)));
КонецПроцедуры

// Штука (796) и бутылка (868) - одна единица учета для напитков; прочие коды как есть.
Функция ОКЕИДляСравнения(Знач Код)
	Код = СокрЛП(Код);
	Возврат ?(Код = "868", "796", Код);
КонецФункции

// ++ ЩА 12.10.2026 [yan]
// Кандидаты, у которых Наименование или НаименованиеПолное совпадает с наименованием из УПД
// без учета регистра и пробелов.
Функция КандидатыПоНаименованию(Знач Кандидаты, Знач НаименованиеУПД)
	Итог = Новый Массив;
	Образец = НормализованноеНаименование(НаименованиеУПД);
	Если НЕ ЗначениеЗаполнено(Образец) Тогда
		Возврат Итог;
	КонецЕсли;
	ЕстьПолное = Метаданные.Справочники.Номенклатура.Реквизиты.Найти("НаименованиеПолное") <> Неопределено;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если НормализованноеНаименование(Кандидат.Наименование) = Образец
			ИЛИ ЕстьПолное И НормализованноеНаименование(Кандидат.НаименованиеПолное) = Образец Тогда
			Итог.Добавить(Кандидат);
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;
КонецФункции

Функция НормализованноеНаименование(Знач Текст)
	Возврат НРег(СтрЗаменить(СтрЗаменить(СокрЛП(Текст), " ", ""), Символы.НПП, ""));
КонецФункции
// -- ЩА 12.10.2026 [yan].

Функция ПоляПоискаНоменклатурыКонтрагента(Знач СтрокаУПД)
	Поля = Новый Массив;
	// Идентификатор, который пишут модули ЭДО (Контур.Диадок): наименование заглавными без
	// пробелов, «##», код, «#». Он точнее одного кода: у поставщика код бывает привязан к разным
	// товарам нашей базы.
	Если ЗначениеЗаполнено(СтрокаУПД.Наименование) Тогда
		Поля.Добавить(Новый Структура("Поле, Значение", "Идентификатор",
			ВРег(СтрЗаменить(СтрокаУПД.Наименование, " ", "")) + "##" + СтрокаУПД.КодТовара + "#"));
	КонецЕсли;
	Поля.Добавить(Новый Структура("Поле, Значение", "КодНоменклатурыКонтрагента", СтрокаУПД.КодТовара));
	Поля.Добавить(Новый Структура("Поле, Значение", "Идентификатор", СтрокаУПД.КодТовара));
	Поля.Добавить(Новый Структура("Поле, Значение", "АртикулНоменклатурыКонтрагента", СтрокаУПД.Артикул));
	Поля.Добавить(Новый Структура("Поле, Значение", "ШтрихКодНоменклатурыКонтрагента", СтрокаУПД.GTIN));
	Поля.Добавить(Новый Структура("Поле, Значение", "НаименованиеНоменклатурыКонтрагента", СтрокаУПД.Наименование));
	Возврат Поля;
КонецФункции

// Штрихкоды строки для поиска: GTIN (и без ведущих нулей - в базе EAN-13 хранят 13 знаков)
// и значения ИнфПолФХЖ2 «Для1С_Штрихкод» через запятую.
Функция ШтрихкодыСтроки(Знач СтрокаУПД)
	Коды = Новый Массив;
	Если ЗначениеЗаполнено(СтрокаУПД.GTIN) Тогда
		Коды.Добавить(СтрокаУПД.GTIN);
		Если СтрДлина(СтрокаУПД.GTIN) = 14 И Лев(СтрокаУПД.GTIN, 1) = "0" Тогда
			Коды.Добавить(Сред(СтрокаУПД.GTIN, 2));
		КонецЕсли;
	КонецЕсли;
	Значение = СтрокаУПД.ИнфПоля.Получить("Для1С_Штрихкод");
	Если ЗначениеЗаполнено(Значение) Тогда
		Для Каждого Код Из СтрРазделить(Значение, ",", Ложь) Цикл
			Коды.Добавить(СокрЛП(Код));
		КонецЦикла;
	КонецЕсли;
	Возврат Коды;
КонецФункции

// Ставка НДС по тексту УПД: «22%» - НДС22, «22/122» - НДС22_122, «без НДС» - БезНДС.
// Ставки, которой нет в перечислении базы, - пустая (заполнит человек).
Функция СтавкаНДСПоТексту(Знач Текст) Экспорт
	Текст = НРег(СтрЗаменить(СокрЛП(Текст), " ", ""));
	Если СтрНайти(Текст, "без") > 0 Тогда
		Имя = "БезНДС";
	ИначеЕсли СтрНайти(Текст, "/") > 0 Тогда
		Имя = "НДС" + СтрЗаменить(СтрЗаменить(Текст, "%", ""), "/", "_");
	Иначе
		Имя = "НДС" + СтрЗаменить(Текст, "%", "");
	КонецЕсли;
	Если Метаданные.Перечисления.СтавкиНДС.ЗначенияПеречисления.Найти(Имя) = Неопределено Тогда
		Возврат Перечисления.СтавкиНДС.ПустаяСсылка();
	КонецЕсли;
	Возврат Перечисления.СтавкиНДС[Имя];
КонецФункции

#КонецОбласти
