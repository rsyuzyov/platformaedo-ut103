////////////////////////////////////////////////////////////////////////////////
// Перехват типовых точек входа БЭД, из которых состоит меню "ЭДО" в форме документа.
//
// Зачем: типовой контур ЭДО (подсистема БЭД) у нас НЕ работает - обмен идёт через
// "Платформу ЭДО" своим механизмом. Пользователь про это знать не обязан: он стоит
// на накладной и жмёт привычный пункт меню. Раньше эти пункты уводили в мёртвый
// контур, а до карточки "Состояние ЭДО" из документа дойти было нельзя вовсе.
//
// Перехватываются КЛИЕНТСКИЕ процедуры общего модуля, а не форма: форма документа
// в УТ 10.3 обычная (Form.bin), расширением она не заимствуется. Проверено фактом -
// меню в форме РТУ зовёт именно эти четыре процедуры (и СоздатьЭтРННаОсновании
// из ОбменСГИСЭПДКлиентПереопределяемый).
//
// Каждый перехват действует ТОЛЬКО для документов нашего контура
// (ЭДО_Клиент.НашКонтурЭДО) и для всего остального зовёт ПродолжитьВызов: эти же
// процедуры используют банковский обмен, МЧД и присоединённые файлы, и глухая
// подмена сломала бы места, к "Платформе ЭДО" отношения не имеющие.
//
// Для ФУНКЦИЙ общего модуля &После платформа отвергает молча (только
// ConfigExtensionApplyError в ЖР), но здесь все пять - процедуры, поэтому &Вместо.
////////////////////////////////////////////////////////////////////////////////

// Пункт "Сформировать, подписать и отправить" наша отправка через "Платформу ЭДО".
&Вместо("СформироватьПодписатьОтправитьЭД")
Процедура ЭДО_СформироватьПодписатьОтправитьЭД(ПараметрКоманды, ЭД = Неопределено)
	Если НЕ ЭДО_Клиент.НашКонтурЭДО(ПараметрКоманды) Тогда
		ПродолжитьВызов(ПараметрКоманды, ЭД);
		Возврат;
	КонецЕсли;
	ЭДО_Клиент.ОтправитьИнтерактивно(ПараметрКоманды);
КонецПроцедуры

// Пункт "Открыть актуальный электронный документ" карточка "Состояние ЭДО".
&Вместо("ОткрытьАктуальныйЭД")
Процедура ЭДО_ОткрытьАктуальныйЭД(ПараметрКоманды, Источник = Неопределено, ПараметрыОткрытия = Неопределено)
	Если НЕ ЭДО_Клиент.НашКонтурЭДО(ПараметрКоманды) Тогда
		ПродолжитьВызов(ПараметрКоманды, Источник, ПараметрыОткрытия);
		Возврат;
	КонецЕсли;
	ЭДО_Клиент.ОткрытьКарточкуСостоянияЭДО(ПараметрКоманды, Источник);
КонецПроцедуры

// Пункт "Сформировать новый электронный документ" заглушён: у нас формирование
// и отправка идут одним действием, отдельный "черновик ЭД" типовой подсистемы не ведётся.
&Вместо("СформироватьНовыйЭД")
Процедура ЭДО_СформироватьНовыйЭД(ПараметрКоманды, Показывать = Истина)
	Если НЕ ЭДО_Клиент.НашКонтурЭДО(ПараметрКоманды) Тогда
		ПродолжитьВызов(ПараметрКоманды, Показывать);
		Возврат;
	КонецЕсли;
	ЭДО_Клиент.СообщитьПунктОтключен(
		"Отдельный электронный документ у нас не формируется."
		+ Символы.ПС + "Документ собирается и уходит контрагенту одним действием —"
		+ " пункт «Сформировать, подписать и отправить».");
КонецПроцедуры

// Пункт "Список электронных документов" заглушён: журнал типовой подсистемы пуст,
// история отправок живёт в карточке "Состояние ЭДО" и у оператора.
&Вместо("ОткрытьДеревоЭД")
Процедура ЭДО_ОткрытьДеревоЭД(СсылкаНаОбъект, ПараметрыОткрытия = Неопределено, ЭД = Неопределено)
	Если НЕ ЭДО_Клиент.НашКонтурЭДО(СсылкаНаОбъект) Тогда
		ПродолжитьВызов(СсылкаНаОбъект, ПараметрыОткрытия, ЭД);
		Возврат;
	КонецЕсли;
	ЭДО_Клиент.СообщитьПунктОтключен(
		"Список электронных документов типовой подсистемы у нас не ведётся."
		+ Символы.ПС + "История отправок по документу — пункт «Открыть актуальный"
		+ " электронный документ» (карточка «Состояние ЭДО»).");
КонецПроцедуры
