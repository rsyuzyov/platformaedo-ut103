// Регламенты ЭДО, живущие ВНУТРИ расширения.
//
// Зачем модуль появился (решение оператора 04.09.2026, подтверждено 07.09.2026).
// До сих пор регламенты были задачами планировщика Windows: `.ps1`-обёртка с кредами fastex
// слала `.bsl`-файл в базу по HTTP. Из этого следовало всё, на чём мы спотыкались:
// - логика жила ВНЕ репозитория - переименование свойств 03.09.2026 до неё не доехало,
// и отправка встала в обеих базах на сутки (147 и 110 документов), а лог писал
// "в очереди 0 ... ошибок 0" и планировщик рапортовал успех;
// - у каждой базы свой экземпляр файла - 07.09.2026 боевой send-queue.bsl на dev-rds1
// оказался ВЕРСИЕЙ ОТ 04.09 со своим запросом отбора, а в репозитории с 02.09 лежала
// версия, зовущая ядро. Разошлись молча;
// - креды лежали на диске, а расписание не было видно из 1С.
// код регламента обязан жить там же, где ядро, и правиться вместе с ним одной выкаткой.
//
// КОД ВОЗВРАТА НЕ ДОКАЗЫВАЕТ РЕЗУЛЬТАТ. Класс, всплывший 07.09.2026 трижды за день:
// задача планировщика вернула 0, а скрипт внутри упал; DESIGNER вернул 0, не сделав ничего;
// выкатка сменила версию, а отправка стояла. - каждый прогон здесь пишет в журнал
// регистрации СВОД С ЧИСЛАМИ, а не факт запуска, и отличает "очередь пуста" от
// "отбор сломан" - см. ПризнакиСломанногоОтбора().
Процедура ОтправитьОчередь() Экспорт

	ВыполнитьПрогонОтправки();

КонецПроцедуры

// Прогон отправки очереди. Возврат: Строка - свод для журнала и для ручного запуска.
Функция ВыполнитьПрогонОтправки() Экспорт

	Детали = Новый Массив;
	Свод = "";

	Попытка
 // Параметры отбора живут в НАСТРОЙКАХ БАЗЫ, а не в тексте: правятся формой настроек,
 // одинаково видны отправке и регламенту, переживают выкатку расширения.
		ЛимитДокументов = Число(ЭДО_Сервер.НастройкаЭДО("ЛимитДокументовЗаПрогон"));
		НижняяГраница = ЭДО_Сервер.НижняяГраницаОтбора();

 // Замок прогона: 17.08.2026 две параллельные отправки задвоили 593 накладные.
 // Регламент крутит СВОЙ цикл по ОтправитьПоЭДО и потому проходит мимо защит
 // фасада ОтправитьМассивПоЭДО - замок берём здесь явно.
 // СнятьБрошенныеЗанятия() здесь НЕ зовём, хотя соблазн велик. Статус 1 ставится
 // ДО POST, и прогон может умереть уже ПОСЛЕ создания карточки у оператора - снятие
 // отметки без сверки разрешает повтор и плодит дубли. Поймано 22.08.2026 в moroz.
 // Сирот разбирает отдельный сторож СО СВЕРКОЙ по номеру и дате накладной.
		ЗамокНаш = ЭДО_Сервер.ЗанятьПрогонОтправки();
		ЗамокДержим = ЗамокНаш;

 // Отбор целиком в ядре: типовые условия знает ядро, нетиповой признак готовности
 // добавляет профиль базы (точка ПриОтбореДокументовКОтправке).
		Т = ЭДО_Сервер.ДокументыКОтправке();
		Всего = Т.Количество();

 // чужой прогон идёт - ничего не берём, но сводку по очереди всё равно печатаем
		Обработать = ?(ЗамокНаш, Мин(ЛимитДокументов, Всего), 0);
		Успешно = 0;
		Ошибок = 0;
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

		Для Инд = 0 По Обработать - 1 Цикл
			Стр = Т[Инд];
			Попытка
				Рез = ЭДО_Сервер.ОтправитьПоЭДО(Стр.Ссылка);
				Если ЗначениеЗаполнено(Рез.ИдДокумента) Тогда
					Успешно = Успешно + 1;
				Иначе
					Ошибок = Ошибок + 1;
					Детали.Добавить("ERR " + СокрЛП(Стр.Номер) + " -> " + Строка(Рез.Статус)
						+ ": " + Лев(Строка(Рез.Сообщение), 160));
				КонецЕсли;
			Исключение
				Ошибок = Ошибок + 1;
				Детали.Добавить("EXC " + СокрЛП(Стр.Номер) + ": " + Лев(ОписаниеОшибки(), 160));
			КонецПопытки;
 // замок живёт 30 минут, а прогон на аварии Платформы шёл 27 - продлеваем по ходу
			Если (Инд + 1) % 25 = 0 Тогда
				ЭДО_Сервер.ЗанятьПрогонОтправки();
			КонецЕсли;
		КонецЦикла;

		Секунд = Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000, 1);
 // отправка закончена - замок дальше не нужен, остальное только читает
		Если ЗамокДержим Тогда
			ЭДО_Сервер.ОсвободитьПрогонОтправки();
			ЗамокДержим = Ложь;
		КонецЕсли;

		Свод = "ЭДО, отправка: в очереди " + Всего + ", взято " + Обработать
			+ ", отправлено " + Успешно + ", ошибок " + Ошибок + "; " + Секунд + " c"
			+ "; окно с " + Формат(НижняяГраница, "ДФ=dd.MM.yyyy");
		Если НЕ ЗамокНаш Тогда
			Свод = Свод + "; ПРОПУЩЕН: прогон уже идёт в другом сеансе";
		КонецЕсли;
		Если Всего > Обработать Тогда
			Свод = Свод + " (остаток " + (Всего - Обработать) + " уйдёт следующим прогоном)";
		КонецЕсли;

 // -- пустая очередь: "пусто" или "отбор сломан"? --------------------------
 // Ровно этого не хватило 03-04.09.2026: отбор искал свойства по старым именам,
 // НайтиПоНаименованию отдавала пустую ссылку, запрос давал ноль строк - и лог
 // писал "в очереди 0, ошибок 0". Сутки все считали, что отправлять просто нечего.
		Если Всего = 0 Тогда
			Поломки = ПризнакиСломанногоОтбора();
			Если Поломки.Количество() > 0 Тогда
				Свод = Свод + "; ОШИБКА: очередь пуста, но отбор сломан — "
					+ СтрСоединить(Поломки, "; ");
			Иначе
				Свод = Свод + "; очередь пуста штатно (отбор исправен)";
			КонецЕсли;
		КонецЕсли;

 // -- расхождение гейтов отбора и проверки ---------------------------------
 // Под Попытка: страховка не имеет права уронить прогон отправки.
		Попытка
			Сверка = ЭДО_Сервер.СверитьГейтыОтбораИПроверки();
			Если Сверка.Расхождений > 0 Тогда
				Свод = Свод + "; ОШИБКА: гейты разошлись у " + Сверка.Расхождений
					+ " из " + Сверка.Проверено + " (отбор берёт, проверка держит)";
				Для Каждого С Из Сверка.Строки Цикл
					Детали.Добавить(С);
				КонецЦикла;
			КонецЕсли;
		Исключение
			Детали.Добавить("сверка гейтов не отработала: " + Лев(ОписаниеОшибки(), 120));
		КонецПопытки;

 // -- причина неотправки в колонку "ЭДО" -----------------------------------
 // Документ, не прошедший отбор, раньше не получал в колонку НИЧЕГО, и оператор не
 // отличал "ещё не ушло" от "не уйдёт никогда" (23.08.2026: 474 молчащих документа).
		Попытка
			Причины = ЭДО_Сервер.ОбновитьПричиныНеотправки();
			Если Причины.Записано > 0 Тогда
				Свод = Свод + "; колонка ЭДО: обновлено " + Причины.Записано
					+ " (" + Причины.Сводка + ")";
			КонецЕсли;
		Исключение
			Детали.Добавить("причины неотправки не проставлены: " + Лев(ОписаниеОшибки(), 120));
		КонецПопытки;

		Детали.Вставить(0, Свод);
		Результат = СтрСоединить(Детали, Символы.ПС);
		ЗаписатьВЖурнал(Результат, СтрНайти(Свод, "ОШИБКА") > 0, "ЭДО.Регламент.Отправка");

	Исключение
 // замок не должен пережить падение прогона: иначе следующий запуск пропущен целиком
		Попытка
			ЭДО_Сервер.ОсвободитьПрогонОтправки();
		Исключение
		КонецПопытки;
		Результат = "ЭДО, отправка — ОШИБКА: " + ОписаниеОшибки();
		ЗаписатьВЖурнал(Результат, Истина, "ЭДО.Регламент.Отправка");
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Почему отбор мог отдать ноль строк не потому, что отправлять нечего.
//
// Смысл функции - отличить ТИШИНУ от ПОЛОМКИ. Отбор построен на свойствах, которые
// ищутся ПО НАИМЕНОВАНИЮ: НайтиПоНаименованию не находит - возвращается пустая ссылка,
// соединение не даёт строк, запрос отрабатывает без единой ошибки и отдаёт ноль.
// переименование, опечатка или незаведённое свойство выглядят как "сегодня нет отгрузок".
// Так и было 03-04.09.2026 в обеих базах.
//
// Возврат: Массив строк-претензий (пустой - отбор исправен).
Функция ПризнакиСломанногоОтбора() Экспорт

	Претензии = Новый Массив;

	// 1. Свойства, без которых отбор пуст по построению.
	Обязательные = "ЭДО_АдресКонтрагента,ЭДО_СтатусСвязи,ЭДО_ИдентификаторДокумента,"
		+ "ЭДО_Состояние,ЭДО_РазрешенаОтправка";
	Отсутствуют = Новый Массив;
	Для Каждого Имя Из СтрРазделить(Обязательные, ",") Цикл
		Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(СокрЛП(Имя));
		Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
			Отсутствуют.Добавить(СокрЛП(Имя));
		КонецЕсли;
	КонецЦикла;
	Если Отсутствуют.Количество() > 0 Тогда
		Претензии.Добавить("не заведены свойства: " + СтрСоединить(Отсутствуют, ", "));
	КонецЕсли;

	// 2. Настройки, без которых отправка невозможна вовсе.
	Недостающее = ЭДО_Сервер.НедостающиеНастройкиЭДО();
	Если Недостающее.Количество() > 0 Тогда
		Претензии.Добавить("расширение не настроено: " + СтрСоединить(Недостающее, ", "));
	КонецЕсли;

	// 3. Ни одной разрешённой организации - отбор пуст при любом количестве отгрузок.
	// Умолчание механизма "ЭДО_РазрешенаОтправка" - ЗАПРЕТ (правило оператора 06.09.2026),
	// поэтому забытый флаг у новой базы даёт ровно пустую очередь без ошибок.
	СвРазр = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_РазрешенаОтправка");
	Если СвРазр <> Неопределено И НЕ СвРазр.Пустая() Тогда
		З = Новый Запрос;
		З.Текст =
			"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Сколько
			|ИЗ РегистрСведений.ЗначенияСвойствОбъектов КАК Р
			|ГДЕ Р.Свойство = &Св
			|	И (ВЫРАЗИТЬ(Р.Значение КАК БУЛЕВО) = ИСТИНА
			|		ИЛИ ВЫРАЗИТЬ(Р.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1""))";
		З.УстановитьПараметр("Св", СвРазр);
		В = З.Выполнить().Выбрать();
		Если В.Следующий() И В.Сколько = 0 Тогда
			Претензии.Добавить("ни одной организации не разрешена отправка"
				+ " (свойство «ЭДО_РазрешенаОтправка» не проставлено никому)");
		КонецЕсли;
	КонецЕсли;

	// 4. Отгрузки за окно есть, а очередь пуста - это ещё не поломка, но повод сказать вслух.
	Нижняя = ЭДО_Сервер.НижняяГраницаОтбора();
	ЗД = Новый Запрос;
	ЗД.Текст =
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Сколько
		|ИЗ Документ.РеализацияТоваровУслуг КАК РТУ
		|ГДЕ РТУ.Проведен И РТУ.Дата >= &Дата И РТУ.ОтражатьВБухгалтерскомУчете";
	ЗД.УстановитьПараметр("Дата", Нижняя);
	ВД = ЗД.Выполнить().Выбрать();
	Если ВД.Следующий() И ВД.Сколько > 0 И Претензии.Количество() > 0 Тогда
		Претензии.Добавить("при этом проведённых реализаций за окно: " + ВД.Сколько);
	КонецЕсли;

	Возврат Претензии;

КонецФункции

// Свод прогона в журнал регистрации.
//
// Единственный способ увидеть падение регламента снаружи. Задача планировщика возвращала
// ноль при упавшем скрипте, и StatusSync падал ТРОЕ СУТОК незамеченным (03-07.09.2026,
// 80 падений в prodline и 74 в moroz). - судим по строке в журнале, а не по коду возврата:
// смотрим её свежесть и уровень.
Процедура ЗаписатьВЖурнал(Знач Текст, Знач ЭтоОшибка = Ложь,
	Знач Событие = "ЭДО.Регламент") Экспорт

	Попытка
		ЗаписьЖурналаРегистрации(Событие,
			?(ЭтоОшибка, УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Информация),
			, , Лев(Текст, 5000));
	Исключение
 // журнал недоступен - прогон ронять нельзя
	КонецПопытки;

КонецПроцедуры

// Сверка статусов у оператора и возврат недошедших документов в очередь.
// Перенесено из `C:\ProgramData\pedo\status-sync.bsl` 07.09.2026 дословно: тело скрипта
// не переписывалось, изменился только отступ. Разбор и чистка - отдельно.
// PEDO-StatusSync - сверка статусов у оператора "Платформа ЭДО" и возврат недошедших
// документов в очередь отправки.
// С 07.09.2026 скрипт НЕ пишет колонку "ЭДО" (`ЭДО_Состояние`) - её ведёт ядро.
// Здесь она только читается, чтобы видеть расхождение. Единственная запись этого
// скрипта - снятие отметки отправки в блоке 5.
// Это источник колонки "ЭДО" в обработке "Обработка заявок": в УТ хранится РОВНО ОДНО значение -
// человекочитаемый статус последней отправки. Идентификаторы, полные причины и история отправок
// в базе НЕ хранятся: они живут в Платформе и дозапрашиваются точечно по конкретному документу.
//
// Вендорское `ЭДО_КодСостояния` (Число, 40 = "Отправлен") означает "отправляли",
// а не "дошло": его пишет расширение в момент приёма подписи оператором. Не путать
// с `ЭДО_Состояние` - имена похожи, смысл разный.
// С 01.09.2026 скрипт его ВСЁ-ТАКИ трогает, но ровно в одном случае - снимает 40, когда
// оператор вернул `SENDING_FAILED` и живого экземпляра у документа нет (см. блок 5).
// Причина: пока отметка 40 стоит, `ЗанятьДокументКОтправке` отвечает "Документ уже
// отправлялся", и упавший документ НЕ переотправить ничем, кроме ручной правки регистра.
//
// "Последняя отправка": у документа в Платформе бывает НЕСКОЛЬКО экземпляров (переотправка
// создаёт новый, старый остаётся в своём статусе - например ACCEPTED). Актуальным считается
// экземпляр с максимальным `created`; предыдущие игнорируются.
// Сопоставление 1С Платформа - по `invoice.num` + `invoice.date` из карточки.
// Номер накладной НЕ уникален (повторяется по годам) - ключ обязан включать дату.
//
// И НЕЛЬЗЯ заводить переменные с именами, занятыми обработчиком fastex: `Выполнить(Код)`
// в `fe_fastex_v1.Service_Do` делит область имён с самим методом, у которого в локальных
// лежат `ЗапросHTTP`, `Код` и `ВходящиеПараметры`. Своя переменная `ЗапросHTTP` затирает
// служебный HTTP-запрос, и ответ падает с "Поле объекта не обнаружено (ПараметрыURL)"
// УЖЕ ПОСЛЕ того, как код отработал и данные записались: HTTP 500 при выполненной работе.
// Поэтому запрос к Платформе зовётся `ЗапросПлатформы` (прецедент 21.08.2026).
// Фрагмент исполняется через fastex - объявлять процедуры и функции здесь НЕЛЬЗЯ,
// вся логика инлайном. Результат кладётся в переменную `Результат`.
// Здоровый API отвечает за ~0,2 с - окно в две недели стоит секунды. Если прогон вдруг идёт
// минутами - это не объём, а авария Платформы: смотри счётчик `таймаутов` в сводке.
Функция ВыполнитьСверкуСтатусов() Экспорт

	Попытка
 // окно обхода по дате создания карточки - настройка расширения
		ГлубинаДней = ЭДО_Сервер.НастройкаЭДО("ГлубинаДнейСинхронизацииСтатусов");
		ПоказатьМакс = 30;     // потолок списка проблемных в логе
		ПорогСвежестиДней = 3; // отказ старше — в очередь не возвращаем, нужен разбор человеком
 // Префиксы операторов, куда отправка не проходит по внешней причине (настройка расширения).
 // В moroz это "2LT": ЭДО Лайт пускает формализованные документы только между участниками
 // ГИС МТ, а ИП там не зарегистрирован. Без этого гейта синхронизация возвращала бы в очередь
 // полторы сотни заведомо мёртвых отправок каждые сутки (замер 01.09.2026).
		НерабочиеПрефиксы = Новый Массив;
		Для Каждого Кусок Из СтрРазделить(ЭДО_Сервер.НастройкаЭДО("НерабочиеПрефиксыЭДО"), ",", Ложь) Цикл
			Если ЗначениеЗаполнено(СокрЛП(Кусок)) Тогда
				НерабочиеПрефиксы.Добавить(ВРег(СокрЛП(Кусок)));
			КонецЕсли;
		КонецЦикла;

		СвойствоСтатус = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_Состояние");
		Если СвойствоСтатус = Неопределено ИЛИ СвойствоСтатус.Пустая() Тогда
			ВызватьИсключение "Не заведено свойство ЭДО_Состояние в ПВХ СвойстваОбъектов";
		КонецЕсли;
 // отметка отправки расширения - её снимаем у документов, до контрагента не дошедших
		СвойствоОтправки = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_КодСостояния");
 // Снять одну отметку 40 НЕДОСТАТОЧНО: очередь отбирает документы условием
 // "идентификатор Платформы ПУСТ" (`Плат.Объект ЕСТЬ NULL` в send-queue.bsl), поэтому
 // документ с чужим ид в очередь не попадёт вообще. Проверено 01.09.2026: после сброса
 // 191 отметки очередь взяла 8 документов - те, у кого ид не было. Снимаем обе.
 // Ссылка на упавший экземпляр при этом теряется - он всё равно в SENDING_FAILED,
 // и найти его можно по номеру накладной; в лог идентификатор пишется.
		СвойствоИдПлатформы = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("ЭДО_ИдентификаторДокумента");

 // Статусы, при которых экземпляр ЖИВОЙ: он либо в пути, либо уже у контрагента.
 // Наличие ХОТЯ БЫ ОДНОГО такого экземпляра запрещает переотправку, даже если самый
 // свежий - отказной. Прецедент 31.08.2026 (prodline): из 46 документов с "Отказом
 // контрагента" 35 на деле ПРИНЯТЫ - контрагент отклонил лишний дубль, а нужный подписал,
 // и в карточку попал статус последней квитанции. Сброс по одному лишь верхнему статусу
 // отправил бы им третий экземпляр.
		ЖивыеСтатусы = Новый Соответствие;
		ЖивыеСтатусы.Вставить("NEW", Истина);
		ЖивыеСтатусы.Вставить("AWAIT_PAYMENT", Истина);
		ЖивыеСтатусы.Вставить("SENT_TO_OPERATOR", Истина);
		ЖивыеСтатусы.Вставить("SENT", Истина);
		ЖивыеСтатусы.Вставить("DELIVERED", Истина);
		ЖивыеСтатусы.Вставить("ACCEPTED", Истина);
		ЖивыеСтатусы.Вставить("CANCELLATION_REQUESTED", Истина);

 // Карта статусов Платформы -> текст колонки. Конвенция унаследована от СБИС:
 // в одном поле либо состояние, либо "Ошибка: ..."; длиннее 50 символов не влезает.
		КартаСтатусов = Новый Соответствие;
		КартаСтатусов.Вставить("NEW",                     "Отправляется");
		КартаСтатусов.Вставить("AWAIT_PAYMENT",           "Отправляется");
		КартаСтатусов.Вставить("SENT_TO_OPERATOR",        "Отправляется");
		КартаСтатусов.Вставить("SENT",                    "Отправлен");
		КартаСтатусов.Вставить("DELIVERED",               "Доставлен");
		КартаСтатусов.Вставить("ACCEPTED",                "Принят");
		КартаСтатусов.Вставить("REJECTED",                "Отказ контрагента");
		КартаСтатусов.Вставить("SENDING_FAILED",          "Ошибка: не отправлен");
		КартаСтатусов.Вставить("CANCELLED",               "Аннулирован");
		КартаСтатусов.Вставить("CANCELLATION_REQUESTED",  "Запрошено аннулирование");

 // -- 1. Токен и соединение -------------------------------------------------------------
		Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Истина) Тогда
			ВызватьИсключение "Не удалось получить токен Платформы";
		КонецЕсли;
		Токен = ЭДО_Сервер.ТекущийТокен();
		ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Гид = ЭДО_Сервер.ГидОрганизации();
 // Таймаут держать небольшим: здоровый ответ приходит за 0,25 с, а во время аварии
 // Платформы (прецедент 21.08: треть запросов виснет) он умножается на ретраи и вешает
 // прогон. Значение - настройка расширения "Таймаут HTTP, секунд".
		Соед = ЭДО_Сервер.СоединениеСОператором();

 // -- 2. Карта базы: "номер|дата" -> ссылка на реализацию --------------------------------
 // Запас в 3 дня: карточка Платформы может быть создана позже даты самой накладной.
		ГраницаДок = НачалоДня(ТекущаяДата()) - (ГлубинаДней + 3) * 86400;
		ЗапросБаза = Новый Запрос(
			"ВЫБРАТЬ
			|	Реализация.Ссылка КАК Ссылка,
			|	Реализация.Номер КАК Номер,
			|	Реализация.Дата КАК Дата,
			|	ЕСТЬNULL(Статусы.Значение, """") КАК ТекущийСтатус,
			|	ЕСТЬNULL(Отправки.Значение, """") КАК ОтметкаОтправки
			|ИЗ
			|	Документ.РеализацияТоваровУслуг КАК Реализация
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Статусы
			|		ПО Реализация.Ссылка = Статусы.Объект
			|			И Статусы.Свойство = &СвойствоСтатус
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Отправки
			|		ПО Реализация.Ссылка = Отправки.Объект
			|			И Отправки.Свойство = &СвойствоОтправки
			|ГДЕ
			|	Реализация.Дата >= &Граница
			|	И Реализация.Проведен");
		ЗапросБаза.УстановитьПараметр("СвойствоСтатус", СвойствоСтатус);
		ЗапросБаза.УстановитьПараметр("СвойствоОтправки", СвойствоОтправки);
		ЗапросБаза.УстановитьПараметр("Граница", ГраницаДок);
		ВыборкаБаза = ЗапросБаза.Выполнить().Выбрать();
		КартаБазы = Новый Соответствие;      // "номер|дд.ММ.гггг" -> Структура(Ссылка, ТекущийСтатус)
		Пока ВыборкаБаза.Следующий() Цикл
			КлючБазы = СокрЛП(ВыборкаБаза.Номер) + "|" + Формат(ВыборкаБаза.Дата, "ДФ=dd.MM.yyyy");
			КартаБазы.Вставить(КлючБазы, Новый Структура("Ссылка, ТекущийСтатус, ОтметкаОтправки",
				ВыборкаБаза.Ссылка, СокрЛП(Строка(ВыборкаБаза.ТекущийСтатус)),
				СокрЛП(Строка(ВыборкаБаза.ОтметкаОтправки))));
		КонецЦикла;

 // -- 3. Обход исходящих карточек интервалами --------------------------------------------
 // Обход СУТКАМИ терял отправленные документы молча. У выдачи два потолка сразу:
 // page_size = 100 и page = 9 (page=10 отвечает HTTP 400) - из дня видно РОВНО 1000
 // карточек, а в дни массовых отправок их больше: 17.08 и 20.08.2026 - по 1000+
 // (вскрыто 23.08: у 440 документов ид Платформы есть, документ SENT, колонка "ЭДО"
 // пуста, а лог рапортует "таймаутов 0, ошибок нет").
 // Лечится сужением окна, а не листанием дальше: интервал, упёршийся в потолок,
 // делится пополам и обходится заново. Повторный обход безопасен - Экземпляры
 // складываются по ключу "номер|дата", перекрытие даёт то же самое значение.
		Экземпляры = Новый Соответствие;     // "номер|дата" -> Структура(Ид, Создан, Статус, Получатель)
		Запросов = 0;
		ВсегоКарточек = 0;
		Ошибки = "";
		Таймаутов = 0;
		Разбиений = 0;
		Финиш = НачалоДня(ТекущаяУниверсальнаяДата());
		Интервалы = Новый Массив;            // очередь: Структура(Нач, Кон) в универсальном времени
		День = Финиш - (ГлубинаДней - 1) * 86400;
		Пока День <= Финиш Цикл
			Интервалы.Добавить(Новый Структура("Нач, Кон", День, День + 86399));
			День = День + 86400;
		КонецЦикла;
 // потолок на случай аварии выдачи: без него деление могло бы плодить интервалы бесконечно
		МаксИнтервалов = ГлубинаДней * 32;
		ИндексИнтервала = 0;
		Пока ИндексИнтервала < Интервалы.Количество() Цикл
			Интервал = Интервалы[ИндексИнтервала];
			ИндексИнтервала = ИндексИнтервала + 1;
			ОтДата = Формат(Интервал.Нач, "ДФ=yyyy-MM-dd") + "T" + Формат(Интервал.Нач, "ДФ=HH:mm:ss") + ".000Z";
			ДоДата = Формат(Интервал.Кон, "ДФ=yyyy-MM-dd") + "T" + Формат(Интервал.Кон, "ДФ=HH:mm:ss") + ".000Z";
			ИнтервалПереполнен = Ложь;
			Для Страница = 0 По 9 Цикл
 // Токен Keycloak живёт 15 минут, и перевыпуск считается ПО ВРЕМЕНИ, а не по числу
 // запросов. Счётчик "каждые 30 запросов" неверен: при таймаутах один запрос стоит
 // 20 с, тридцать растягиваются дольше жизни токена, и приходит 401 - на прогоне
 // 21.08 так потерялись два самых свежих дня (31 таймаут из 58 запросов).
				Если ТекущаяУниверсальнаяДатаВМиллисекундах() - ТокенПолучен > 600000 Тогда
					ЭДО_Сервер.ОбеспечитьТокен(Истина);
					Токен = ЭДО_Сервер.ТекущийТокен();
					ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
				КонецЕсли;
				Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/documents?created_from=" + ОтДата + "&created_till=" + ДоДата
					+ "&sender_id=" + Гид + "&page=" + Страница + "&page_size=100";
 // Одиночный таймаут НЕ должен убивать прогон: у Платформы бывают аварии, когда
 // до 40 % запросов виснут, а остальные отвечают за 0,18 с (прецедент 21.08.2026).
 // Без ретрая один такой запрос обнулял бы весь обход и статусы молча протухали бы.
 // Попыток пять, а не три: 21.08 замер показал ТРИ таймаута подряд на одной странице -
 // при трёх попытках день выпадал целиком. Пять попыток по 20 с = 100 с на худшую страницу,
 // что для 14 дней укладывается в 50-минутный лимит задачи планировщика.
				МассивКарточек = Неопределено;
				Для НомерПопытки = 1 По 5 Цикл
					ЗапросПлатформы = Новый HTTPЗапрос(Путь);
					ЗапросПлатформы.Заголовки.Вставить("Authorization", "Bearer " + Токен);
					ЗапросПлатформы.Заголовки.Вставить("accept", "application/json;charset=UTF-8");
					Запросов = Запросов + 1;
					Попытка
						ОтветHTTP = Соед.Получить(ЗапросПлатформы);
					Исключение
						Таймаутов = Таймаутов + 1;
						Если НомерПопытки = 5 Тогда
							Ошибки = Ошибки + Формат(Интервал.Нач, "ДФ=dd.MM HH:mm") + " стр." + Страница + ": таймаут x5; ";
						КонецЕсли;
						Продолжить;
					КонецПопытки;
					Если ОтветHTTP.КодСостояния = 401 Тогда
 // токен протух между попытками - перевыпустить и повторить ЭТУ ЖЕ страницу,
 // иначе день молча выпадает из обхода целиком
						ЭДО_Сервер.ОбеспечитьТокен(Истина);
						Токен = ЭДО_Сервер.ТекущийТокен();
						ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
						Если НомерПопытки = 5 Тогда
							Ошибки = Ошибки + Формат(Интервал.Нач, "ДФ=dd.MM HH:mm") + " стр." + Страница + ": 401 x5; ";
						КонецЕсли;
						Продолжить;
					КонецЕсли;
					Если ОтветHTTP.КодСостояния <> 200 Тогда
						Ошибки = Ошибки + Формат(Интервал.Нач, "ДФ=dd.MM HH:mm") + " стр." + Страница + ": HTTP " + ОтветHTTP.КодСостояния + "; ";
						Прервать;
					КонецЕсли;
					Чтение = Новый ЧтениеJSON;
					Чтение.УстановитьСтроку(ОтветHTTP.ПолучитьТелоКакСтроку("UTF-8"));
					МассивКарточек = ПрочитатьJSON(Чтение, Ложь);
					Чтение.Закрыть();
					Прервать;
				КонецЦикла;
				Если МассивКарточек = Неопределено Тогда
 // страницу взять не удалось - день считаем неполным и идём дальше
					Прервать;
				КонецЕсли;
				Для Каждого Карточка Из МассивКарточек Цикл
					ВсегоКарточек = ВсегоКарточек + 1;
					КлючКарт = "";
					Если Карточка.Свойство("invoice") И Карточка.invoice <> Неопределено Тогда
						Если Карточка.invoice.Свойство("num") И Карточка.invoice.Свойство("date") Тогда
							КлючКарт = СокрЛП(Строка(Карточка.invoice.num)) + "|" + СокрЛП(Строка(Карточка.invoice.date));
						КонецЕсли;
					КонецЕсли;
					Если КлючКарт = "" Тогда
						Продолжить;
					КонецЕсли;
					Получатель = "";
					Если Карточка.Свойство("recipient") И Карточка.recipient <> Неопределено Тогда
						Получатель = Строка(Карточка.recipient.id);
					КонецЕсли;
 // живой экземпляр запоминаем ОТДЕЛЬНО от актуального: для колонки нужен
 // самый свежий статус, а для решения "можно ли слать заново" - есть ли
 // ХОТЯ БЫ ОДИН экземпляр в пути или у контрагента.
					ЭтотЖивой = (ЖивыеСтатусы.Получить(Строка(Карточка.status)) <> Неопределено);
					ЭтотУпал = (Строка(Карточка.status) = "SENDING_FAILED");
					Текущий = Экземпляры.Получить(КлючКарт);
 // актуален экземпляр с максимальным created - остальные это прошлые отправки
					Если Текущий = Неопределено ИЛИ Строка(Карточка.created) > Текущий.Создан Тогда
						БылЖивой = ?(Текущий = Неопределено, Ложь, Текущий.ЕстьЖивой);
						БылоПадений = ?(Текущий = Неопределено, 0, Текущий.Падений);
						Экземпляры.Вставить(КлючКарт, Новый Структура("Ид, Создан, Статус, Получатель, ЕстьЖивой, Падений",
							Строка(Карточка.id), Строка(Карточка.created), Строка(Карточка.status), Получатель,
							БылЖивой ИЛИ ЭтотЖивой, БылоПадений + ?(ЭтотУпал, 1, 0)));
					Иначе
						Если ЭтотЖивой Тогда
							Текущий.ЕстьЖивой = Истина;
						КонецЕсли;
						Если ЭтотУпал Тогда
							Текущий.Падений = Текущий.Падений + 1;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				Если МассивКарточек.Количество() < 100 Тогда
					Прервать;
				КонецЕсли;
				Если Страница = 9 Тогда
 // последняя доступная страница пришла ПОЛНОЙ - выдача обрезана потолком
					ИнтервалПереполнен = Истина;
				КонецЕсли;
			КонецЦикла;
			Если ИнтервалПереполнен Тогда
				Длительность = Интервал.Кон - Интервал.Нач;
				Если Длительность <= 59 ИЛИ Интервалы.Количество() >= МаксИнтервалов Тогда
 // минута с 1000+ карточек либо разросшаяся очередь - дальше не дробим, но
 // молчать об этом нельзя: именно молчание и было главной бедой прежнего обхода
					Ошибки = Ошибки + Формат(Интервал.Нач, "ДФ=dd.MM HH:mm") + "–"
						+ Формат(Интервал.Кон, "ДФ=HH:mm") + ": выдача обрезана потолком; ";
				Иначе
					Середина = Интервал.Нач + Цел(Длительность / 2);
					Интервалы.Добавить(Новый Структура("Нач, Кон", Интервал.Нач, Середина));
					Интервалы.Добавить(Новый Структура("Нач, Кон", Середина + 1, Интервал.Кон));
					Разбиений = Разбиений + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

 // -- 4. Запись статуса --------------------------------------------------------------------
		Обновлено = 0;
		БезПары = 0;
		Сброшено = 0;
		КандидатыОтказа = Новый Массив;   // REJECTED — решает человек, автосброса нет (см. блок 5)
		Проблемные = Новый Массив;
		Для Каждого Пара Из Экземпляры Цикл
			ДанныеБазы = КартаБазы.Получить(Пара.Ключ);
			Если ДанныеБазы = Неопределено Тогда
				БезПары = БезПары + 1;
				Продолжить;
			КонецЕсли;
			СтатусAPI = Пара.Значение.Статус;
			НовыйСтатус = КартаСтатусов.Получить(СтатусAPI);
			Если НовыйСтатус = Неопределено Тогда
				НовыйСтатус = СтатусAPI;   // незнакомый статус показываем как есть, а не прячем
			КонецЕсли;
			НовыйСтатус = Лев(НовыйСтатус, 50);   // ресурс Значение — Строка(50), как у СБИС
 // Блок 5 (сброс отметки) идёт ДАЖЕ когда текст статуса не изменился: документ мог
 // висеть в "Ошибка: не отправлен" со вчера - колонка та же, а вернуть его в очередь
 // всё равно надо.
 // РЕШЕНИЕ ОПЕРАТОРА 07.09.2026: колонку "ЭДО" этот скрипт больше НЕ пишет.
 // Её с 24.08.2026 ведёт ядро (ЭДО_Сервер.ОбновитьПричиныНеотправки), у которого есть
 // механизм "своё/чужое". Два писателя одного поля затирали бы друг друга: наше значение -
 // следующим прогоном ядра, а чужое значение останавливало бы обновление подсказок.
 // здесь остаётся только ЧТЕНИЕ текущего текста; работа скрипта - блок 5 ниже.
 // Счётчик оставлен диагностикой: сколько документов, где наш взгляд на статус
 // расходится с колонкой. Ничего не меняет.
			Если НовыйСтатус <> ДанныеБазы.ТекущийСтатус Тогда
				Обновлено = Обновлено + 1;
			КонецЕсли;

 // -- 5. Сброс отметки отправки у документов, до контрагента НЕ дошедших --------------
 // Пока `ЭДО_КодСостояния` = 40, `ЗанятьДокументКОтправке` отвечает "Документ
 // уже отправлялся" и переотправить нечем. 01.09.2026 пять накладных moroz, упавших
 // накануне с отозванным КЭП, пришлось возвращать в очередь ручной правкой регистра.
			Если СвойствоОтправки <> Неопределено И НЕ СвойствоОтправки.Пустая()
				И СокрЛП(ДанныеБазы.ОтметкаОтправки) = "40"
				И НЕ Пара.Значение.ЕстьЖивой Тогда

				Если СтатусAPI = "SENDING_FAILED" Тогда
 // оператор документ не отправил - у контрагента его нет ни в каком виде,
 // дубля быть не может, содержимое менять не требуется.
 //
 // Но возвращать в очередь ВСЁ подряд нельзя. Замер 01.09.2026 на moroz:
 // под сброс попадало 1 873 документа, из них 1 541 - получатели с префиксом
 // 2LT (ЭДО Лайт). Они падают не из-за нас, а потому что ИП не зарегистрирован
 // в ГИС МТ, и повтор будет падать вечно: очередь каждый час гоняла бы полторы
 // тысячи заведомо мёртвых отправок и маскировала настоящие ошибки.
 // Два гейта, оба про "повтор имеет смысл":
 // свежесть - авария лечится в тот же день-два, застарелое падение лечится
 // не повтором, а разбором;
 // одна попытка - если экземпляр падал уже дважды, причина системная.
					ДатаОтказа = '00010101';
					Попытка
						ДатаОтказа = Дата(Сред(Пара.Значение.Создан, 1, 4) + Сред(Пара.Значение.Создан, 6, 2)
							+ Сред(Пара.Значение.Создан, 9, 2));
					Исключение
					КонецПопытки;
					Свежий = ЗначениеЗаполнено(ДатаОтказа)
						И (НачалоДня(ТекущаяУниверсальнаяДата()) - ДатаОтказа) <= ПорогСвежестиДней * 86400;
					Мёртвый = Ложь;
					Для Каждого Преф Из НерабочиеПрефиксы Цикл
						Если СтрНачинаетсяС(ВРег(Пара.Значение.Получатель), Преф) Тогда
							Мёртвый = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если Мёртвый Тогда
						Продолжить;   // молча: это не проблема документа, а закрытый канал
					КонецЕсли;
					Если НЕ Свежий ИЛИ Пара.Значение.Падений > 1 Тогда
						Если КандидатыОтказа.Количество() < ПоказатьМакс Тогда
							КандидатыОтказа.Добавить("не возвращён в очередь (" + ?(Свежий, "падал " + Пара.Значение.Падений + " раза", "застарелый отказ")
								+ "): " + Пара.Ключ);
						КонецЕсли;
						Продолжить;
					КонецЕсли;
					НаборОтпр = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
					НаборОтпр.Отбор.Объект.Установить(ДанныеБазы.Ссылка);
					НаборОтпр.Отбор.Свойство.Установить(СвойствоОтправки);
					НаборОтпр.Записать();   // пустой набор = снятие отметки
					Если СвойствоИдПлатформы <> Неопределено И НЕ СвойствоИдПлатформы.Пустая() Тогда
						НаборИд = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
						НаборИд.Отбор.Объект.Установить(ДанныеБазы.Ссылка);
						НаборИд.Отбор.Свойство.Установить(СвойствоИдПлатформы);
						НаборИд.Записать();
					КонецЕсли;
					Сброшено = Сброшено + 1;
					Если Проблемные.Количество() < ПоказатьМакс Тогда
						Проблемные.Добавить("возвращён в очередь: " + Пара.Ключ + " (был ид " + Пара.Значение.Ид + ")");
					КонецЕсли;

				ИначеЕсли СтатусAPI = "REJECTED" Тогда
 // Отказ КОНТРАГЕНТА автоматически не сбрасываем. Отправлять то же самое
 // заново бессмысленно - он откажет снова; слать надо только исправленный
 // документ, а признака "исправлен" у РТУ нет. Сверка суммы базы с invoice.sum
 // отправленного экземпляра сейчас НЕ годится как такой признак: маппинг
 // округляет КолТов до целого и сам расходится с базой на 1 832 документах
 // из 5 168 за август (вскрыто 01.09.2026) - гейт по сумме давал бы ложные
 // переотправки. Пока маппинг не починен - только список в лог, решает человек.
					Если КандидатыОтказа.Количество() < ПоказатьМакс Тогда
						КандидатыОтказа.Добавить(Пара.Ключ + " (ид " + Пара.Значение.Ид + ")");
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;

			Если НовыйСтатус = ДанныеБазы.ТекущийСтатус Тогда
				Продолжить;   // текст колонки не менялся — в списки проблемных не добавляем
			КонецЕсли;
			Если СтатусAPI = "REJECTED" ИЛИ СтатусAPI = "SENDING_FAILED" Тогда
				Если Проблемные.Количество() < ПоказатьМакс Тогда
					Проблемные.Добавить(Пара.Ключ + " -> " + СтатусAPI + " (ид " + Пара.Значение.Ид + ")");
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		Свод = "PEDO-StatusSync: окно " + ГлубинаДней + " дн., интервалов " + Интервалы.Количество()
			+ " (разбиений " + Разбиений + "), запросов " + Запросов
			+ ", карточек " + ВсегоКарточек + ", документов " + Экземпляры.Количество()
			+ ", расхождений с колонкой " + Обновлено + ", сброшено отметок " + Сброшено
			+ ", без пары в базе " + БезПары + ", таймаутов " + Таймаутов;
		Если Ошибки <> "" Тогда
			Свод = Свод + " | ОШИБКИ: " + Ошибки;
		КонецЕсли;
		Для Каждого Строчка Из Проблемные Цикл
			Свод = Свод + Символы.ПС + "  " + Строчка;
		КонецЦикла;
		Если КандидатыОтказа.Количество() > 0 Тогда
			Свод = Свод + Символы.ПС + "  отказ контрагента, ждут решения человека:";
			Для Каждого Строчка Из КандидатыОтказа Цикл
				Свод = Свод + Символы.ПС + "    " + Строчка;
			КонецЦикла;
		КонецЕсли;
		Результат = Свод;
	Исключение
		Результат = "PEDO-StatusSync ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Строка(Результат)), "ОШИБКА") > 0,
		"ЭДО.Регламент.СверкаСтатусов");
	Возврат Результат;

КонецФункции

