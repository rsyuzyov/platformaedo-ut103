// Регламенты ЭДО внутри расширения: код регламента живет вместе с ядром и едет одной выкаткой.
// Задачи планировщика с файлами на хосте расходились с репозиторием молча.
////////////////////////////////////////////////////////////////////////////////

// Разводка регламентов по ключу - единственное место, где ключ превращается в вызов.
// Носители расписания (перехват типового задания ядра, задание из профиля базы) - тонкие
// обертки над ней: новый регламент добавляется только сюда и в КлючиРегламентов().
// Явные сравнения, а не вызов по имени через Вычислить(): там опечатка в имени метода
// падала бы только в работе и только у сработавшего ключа.
//
// Возврат: Истина - ключ наш и регламент выполнен; Ложь - ключ чужой, носитель обязан
// отдать вызов типовому поведению (ПродолжитьВызов).
Функция ВыполнитьРегламентПоКлючу(Знач КодНастройки) Экспорт

	Ключ = ВРег(СокрЛП(Строка(КодНастройки)));

	// Старый префикс ПЭДО_ принимается наравне с ЭДО_: задание со старым ключом иначе уходит
	// в типовой путь и молча ничего не делает. Убрать, когда ключи заданий в базах переедут на ЭДО_.
	Если Лев(Ключ, 5) = "ПЭДО_" Тогда
		Ключ = "ЭДО_" + Сред(Ключ, 6);
	КонецЕсли;

	Если Ключ = ВРег("ЭДО_ОтправкаОчереди") Тогда
		ОтправитьОчередь();
	ИначеЕсли Ключ = ВРег("ЭДО_СверкаСтатусов") Тогда
		ВыполнитьСверкуСтатусов();
		// Следом - сверка по идентификаторам без окна: полный обход видит только карточки за глубину
		// синхронизации, и поздние подпись и отказ иначе не доезжают до колонки.
		ВыполнитьТочечнуюСверку(0);
	ИначеЕсли Ключ = ВРег("ЭДО_ТочечнаяСверка") Тогда
		ВыполнитьТочечнуюСверку();
	ИначеЕсли Ключ = ВРег("ЭДО_ОбновлениеСвязей") Тогда
		ВыполнитьОбновлениеСвязей();
	ИначеЕсли Ключ = ВРег("ЭДО_СторожНеПринятых") Тогда
		ЭДО_Сторожа.ВыполнитьСторожНеПринятых();
	ИначеЕсли Ключ = ВРег("ЭДО_СторожПаузы") Тогда
		ЭДО_Сторожа.ВыполнитьСторожПаузы();
	ИначеЕсли Ключ = ВРег("ЭДО_СторожГИСМТ") Тогда
		ЭДО_Сторожа.ВыполнитьСторожГИСМТ();
	ИначеЕсли Ключ = ВРег("ЭДО_СторожБрошенных") Тогда
		ЭДО_Сторожа.ВыполнитьСторожБрошенныхОтметок();
	ИначеЕсли Ключ = ВРег("ЭДО_СторожРасхождений") Тогда
		ЭДО_Сторожа.ВыполнитьСторожРасхождений();
	ИначеЕсли Ключ = ВРег("ЭДО_СторожЗапросовАннулирования") Тогда
		ЭДО_Сторожа.ВыполнитьСторожЗапросовАннулирования();
		// Следом - наши ПОА без ответа контрагента для центра управления, тем же заданием.
		ЭДО_Сторожа.ВыполнитьСторожНашихАннулирований();
	ИначеЕсли Ключ = ВРег("ЭДО_СторожАдресовПолучателя") Тогда
		ЭДО_Сторожа.ВыполнитьСторожАдресовПолучателя();
	ИначеЕсли Ключ = ВРег("ЭДО_АвтоматическоеПринятиеУПД") Тогда
		ЭДО_Сервер.ВыполнитьАвтоматическоеПринятиеУПД();
	ИначеЕсли Ключ = ВРег("ЭДО_ПриглашенияНовымКонтрагентам") Тогда
		ВыполнитьПриглашенияНовымКонтрагентам();
	ИначеЕсли Ключ = ВРег("ЭДО_АннулированиеЛишнихЭкземпляров") Тогда
		ЭДО_Сторожа.ВыполнитьАннулированиеЛишнихЭкземпляров();
	ИначеЕсли Ключ = ВРег("ЭДО_АннулированиеЛишнихЭкземпляровПроверка") Тогда
		ЭДО_Сторожа.ВыполнитьАннулированиеЛишнихЭкземпляров(Истина);
	Иначе
		Возврат Ложь;   // чужой ключ - носитель отдает вызов типовому поведению
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Ключ прогона отправки очереди. Платформа не передает в обработчик поле "Ключ" экземпляра,
// поэтому у экземпляра задания обязан быть один параметр с этим значением, иначе задание падает
// "Недостаточно фактических параметров". Поле "Ключ" заполняется тем же текстом для консоли.
Функция КлючОтправкиОчереди() Экспорт
	Возврат "ЭДО_ОтправкаОчереди";
КонецФункции

// Ключи всех регламентов ЭДО: Соответствие "ключ параметра задания" -> "что делает".
// Список один на все носители. Наименование экземпляра задания начинается с "ЭДО: ",
// чтобы свои задания были видны в консоли одним взглядом.
Функция КлючиРегламентов() Экспорт
	Ключи = Новый Соответствие;
	Ключи.Вставить("ЭДО_ОтправкаОчереди",   "отправка очереди");
	Ключи.Вставить("ЭДО_СверкаСтатусов",    "сверка статусов у оператора");
	Ключи.Вставить("ЭДО_ТочечнаяСверка",    "точечная сверка статусов");
	Ключи.Вставить("ЭДО_ОбновлениеСвязей",  "обновление связей и адресов");
	Ключи.Вставить("ЭДО_СторожНеПринятых",  "сторож «доставлено, но не принято»");
	Ключи.Вставить("ЭДО_СторожПаузы",       "сторож паузы по контрагентам");
	Ключи.Вставить("ЭДО_СторожГИСМТ",       "обход ГИС МТ");
	Ключи.Вставить("ЭДО_СторожБрошенных",   "сторож брошенных отметок отправки");
	Ключи.Вставить("ЭДО_СторожРасхождений", "сторож расхождений с отправленным");
	Ключи.Вставить("ЭДО_СторожЗапросовАннулирования", "входящие запросы на аннулирование");
	Ключи.Вставить("ЭДО_СторожАдресовПолучателя", "сторож адреса получателя");
	Ключи.Вставить("ЭДО_АвтоматическоеПринятиеУПД", "автоматическое принятие УПД");
	Ключи.Вставить("ЭДО_ПриглашенияНовымКонтрагентам", "приглашения новым контрагентам");
	Ключи.Вставить("ЭДО_АннулированиеЛишнихЭкземпляров", "аннулирование лишних экземпляров");
	Ключи.Вставить("ЭДО_АннулированиеЛишнихЭкземпляровПроверка", "лишние экземпляры, только журнал");
	Возврат Ключи;
КонецФункции

// Регламент отправки очереди. Прогон пишет в журнал регистрации свод с числами, а не факт
// запуска, и отличает "очередь пуста" от "отбор сломан" (ПризнакиСломанногоОтбора).
Процедура ОтправитьОчередь() Экспорт

	ВыполнитьПрогонОтправки();

КонецПроцедуры

// Прогон отправки очереди. Возврат: Строка - свод для журнала и для ручного запуска.
Функция ВыполнитьПрогонОтправки() Экспорт

	Детали = Новый Массив;
	Свод = "";

	Попытка
		// Параметры отбора живут в НАСТРОЙКАХ БАЗЫ, а не в тексте: правятся формой настроек,
		// одинаково видны отправке и регламенту, переживают выкатку расширения.
		ЛимитДокументов = Число(ЭДО_Сервер.НастройкаЭДО("ЛимитДокументовЗаПрогон"));
		НижняяГраница = ЭДО_Сервер.НижняяГраницаОтбора();

		// Замок прогона берем явно: свой цикл по ОтправитьПоЭДО идет мимо защит фасада
		// ОтправитьМассивПоЭДО, а параллельные прогоны задваивают отправку.
		// СнятьБрошенныеЗанятия() здесь НЕ звать: отметка ставится до POST, и снятие без сверки
		// с оператором плодит дубли. Брошенные отметки разбирает сторож со сверкой.
		ЗамокНаш = ЭДО_Сервер.ЗанятьПрогонОтправки();
		ЗамокДержим = ЗамокНаш;

		// Выкатка версии с новым обязательным свойством иначе держит всю очередь,
		// пока свойство не заведут руками.
		Самопочинка = "";
		Если ЗамокНаш Тогда
			Самопочинка = ЭДО_Сервер.ЗавестиНедостающиеСвойстваОбъектов();
		КонецЕсли;

		// Отсчет паузы перед автоотправкой УКД ставится ДО отбора: сам отбор только читает,
		// его зовет и сверка гейтов. Сбой здесь задерживает УКД, но не отправку реализаций.
		ОтмеченоУКД = 0;
		ОшибкаОтметкиУКД = "";
		Если ЗамокНаш Тогда
			Попытка
				ОтмеченоУКД = ЭДО_Сервер.ОтметитьКорректировкиНаПроверке();
			Исключение
				ОшибкаОтметкиУКД = Лев(ОписаниеОшибки(), 160);
			КонецПопытки;
		КонецЕсли;

		// Отбор целиком в ядре: типовые условия знает ядро, нетиповой признак готовности
		// добавляет профиль базы (точка ПриОтбореДокументовКОтправке).
		Т = ЭДО_Сервер.ДокументыКОтправке();
		Всего = Т.Количество();

		// чужой прогон идет - ничего не берем, но сводку по очереди все равно печатаем
		Обработать = ?(ЗамокНаш, Мин(ЛимитДокументов, Всего), 0);
		Успешно = 0;
		Ошибок = 0;
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

		Для Инд = 0 По Обработать - 1 Цикл
			Стр = Т[Инд];
			Попытка
				Рез = ЭДО_Сервер.ОтправитьПоЭДО(Стр.Ссылка);
				Если ЗначениеЗаполнено(Рез.ИдДокумента) Тогда
					Успешно = Успешно + 1;
				Иначе
					Ошибок = Ошибок + 1;
					Детали.Добавить("ERR " + СокрЛП(Стр.Номер) + " -> " + Строка(Рез.Статус)
						+ ": " + Лев(Строка(Рез.Сообщение), 160));
				КонецЕсли;
			Исключение
				Ошибок = Ошибок + 1;
				Детали.Добавить("EXC " + СокрЛП(Стр.Номер) + ": " + Лев(ОписаниеОшибки(), 160));
			КонецПопытки;
			// замок живет 30 минут, а прогон при аварии оператора идет почти столько же - продлеваем
			Если (Инд + 1) % 25 = 0 Тогда
				ЭДО_Сервер.ЗанятьПрогонОтправки();
			КонецЕсли;
		КонецЦикла;

		Секунд = Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000, 1);
		// отправка закончена - замок дальше не нужен, остальное только читает
		Если ЗамокДержим Тогда
			ЭДО_Сервер.ОсвободитьПрогонОтправки();
			ЗамокДержим = Ложь;
		КонецЕсли;

		Свод = "ЭДО, отправка: в очереди " + Всего + ", взято " + Обработать
			+ ", отправлено " + Успешно + ", ошибок " + Ошибок + "; " + Секунд + " c"
			+ "; окно с " + Формат(НижняяГраница, "ДФ=dd.MM.yyyy");
		Если НЕ ЗамокНаш Тогда
			Свод = Свод + "; ПРОПУЩЕН: прогон уже идёт в другом сеансе";
		КонецЕсли;
		Если ЗначениеЗаполнено(Самопочинка) Тогда
			Свод = Свод + "; " + Самопочинка;
		КонецЕсли;
		Если ОтмеченоУКД > 0 Тогда
			Свод = Свод + "; УКД поставлено на паузу перед отправкой: " + ОтмеченоУКД;
		КонецЕсли;
		Если ЗначениеЗаполнено(ОшибкаОтметкиУКД) Тогда
			Свод = Свод + "; ОШИБКА: пауза УКД не поставлена - " + ОшибкаОтметкиУКД;
		КонецЕсли;
		Если Всего > Обработать Тогда
			Свод = Свод + " (остаток " + (Всего - Обработать) + " уйдёт следующим прогоном)";
		КонецЕсли;

		// Пустая очередь: "пусто" или "отбор сломан"? Сломанный отбор тоже дает ноль строк без ошибок.
		Если Всего = 0 Тогда
			Поломки = ПризнакиСломанногоОтбора();
			Если Поломки.Количество() > 0 Тогда
				Свод = Свод + "; ОШИБКА: очередь пуста, но отбор сломан — "
					+ СтрСоединить(Поломки, "; ");
			Иначе
				Свод = Свод + "; очередь пуста штатно (отбор исправен)";
			КонецЕсли;
		КонецЕсли;

		// Расхождение гейтов отбора и проверки. Под Попытка: страховка не должна уронить прогон.
		Попытка
			Сверка = ЭДО_Сервер.СверитьГейтыОтбораИПроверки();
			Если Сверка.Расхождений > 0 Тогда
				Свод = Свод + "; ОШИБКА: гейты разошлись у " + Сверка.Расхождений
					+ " из " + Сверка.Проверено + " (отбор берёт, проверка держит)";
				Для Каждого С Из Сверка.Строки Цикл
					Детали.Добавить(С);
				КонецЦикла;
			КонецЕсли;
		Исключение
			Детали.Добавить("сверка гейтов не отработала: " + Лев(ОписаниеОшибки(), 120));
		КонецПопытки;

		// Причина неотправки в колонку "ЭДО": без нее не отличить "еще не ушло" от "не уйдет никогда".
		Попытка
			Причины = ЭДО_Сервер.ОбновитьПричиныНеотправки();
			Если Причины.Записано > 0 Тогда
				Свод = Свод + "; колонка ЭДО: обновлено " + Причины.Записано
					+ " (" + Причины.Сводка + ")";
			КонецЕсли;
		Исключение
			Детали.Добавить("причины неотправки не проставлены: " + Лев(ОписаниеОшибки(), 120));
		КонецПопытки;

		Детали.Вставить(0, Свод);
		Результат = СтрСоединить(Детали, Символы.ПС);
		ЗаписатьВЖурнал(Результат, СтрНайти(Свод, "ОШИБКА") > 0, "ЭДО.Регламент.Отправка");

	Исключение
		// замок не должен пережить падение прогона: иначе следующий запуск пропущен целиком
		Попытка
			ЭДО_Сервер.ОсвободитьПрогонОтправки();
		Исключение
		КонецПопытки;
		Результат = "ЭДО, отправка — ОШИБКА: " + ОписаниеОшибки();
		ЗаписатьВЖурнал(Результат, Истина, "ЭДО.Регламент.Отправка");
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Почему отбор мог отдать ноль строк не потому, что отправлять нечего. Свойства отбора ищутся
// по наименованию: переименованное или незаведенное свойство дает пустую ссылку, и запрос
// без единой ошибки возвращает ноль - как будто сегодня нет отгрузок.
//
// Возврат: Массив строк-претензий (пустой - отбор исправен).
Функция ПризнакиСломанногоОтбора() Экспорт

	Претензии = Новый Массив;

	// 1. Свойства, без которых отбор пуст по построению.
	Обязательные = "ЭДО_АдресКонтрагента,ЭДО_СтатусСвязи,ЭДО_ИдентификаторДокумента,"
		+ "ЭДО_Состояние,ЭДО_РазрешенаОтправка";
	Отсутствуют = Новый Массив;
	Для Каждого Имя Из СтрРазделить(Обязательные, ",") Цикл
		Свойство = ЭДО_Сервер.СвойствоОбъектов(СокрЛП(Имя));
		Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
			Отсутствуют.Добавить(СокрЛП(Имя));
		КонецЕсли;
	КонецЦикла;
	Если Отсутствуют.Количество() > 0 Тогда
		Претензии.Добавить("не заведены свойства: " + СтрСоединить(Отсутствуют, ", "));
	КонецЕсли;

	// 2. Настройки, без которых отправка невозможна вовсе.
	Недостающее = ЭДО_Сервер.НедостающиеНастройкиЭДО();
	Если Недостающее.Количество() > 0 Тогда
		Претензии.Добавить("расширение не настроено: " + СтрСоединить(Недостающее, ", "));
	КонецЕсли;

	// 3. Ни одной разрешенной организации - отбор пуст при любом количестве отгрузок.
	// По умолчанию ЭДО_РазрешенаОтправка - запрет, и забытый флаг у новой базы дает пустую очередь.
	СвРазр = ЭДО_Сервер.СвойствоОбъектов("ЭДО_РазрешенаОтправка");
	Если СвРазр <> Неопределено И НЕ СвРазр.Пустая() Тогда
		З = Новый Запрос;
		З.Текст =
			"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Сколько
			|ИЗ РегистрСведений.ЗначенияСвойствОбъектов КАК Р
			|ГДЕ Р.Свойство = &Св
			|	И (ВЫРАЗИТЬ(Р.Значение КАК БУЛЕВО) = ИСТИНА
			|		ИЛИ ВЫРАЗИТЬ(Р.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1""))";
		З.УстановитьПараметр("Св", СвРазр);
		В = З.Выполнить().Выбрать();
		Если В.Следующий() И В.Сколько = 0 Тогда
			Претензии.Добавить("ни одной организации не разрешена отправка"
				+ " (свойство «ЭДО_РазрешенаОтправка» не проставлено никому)");
		КонецЕсли;
	КонецЕсли;

	// 4. Отгрузки за окно есть, а очередь пуста - это еще не поломка, но повод сказать вслух.
	Нижняя = ЭДО_Сервер.НижняяГраницаОтбора();
	ЗД = Новый Запрос;
	ЗД.Текст =
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Сколько
		|ИЗ Документ.РеализацияТоваровУслуг КАК РТУ
		|ГДЕ РТУ.Проведен И РТУ.Дата >= &Дата И РТУ.ОтражатьВБухгалтерскомУчете";
	ЗД.УстановитьПараметр("Дата", Нижняя);
	ВД = ЗД.Выполнить().Выбрать();
	Если ВД.Следующий() И ВД.Сколько > 0 И Претензии.Количество() > 0 Тогда
		Претензии.Добавить("при этом проведённых реализаций за окно: " + ВД.Сколько);
	КонецЕсли;

	Возврат Претензии;

КонецФункции

// Свод прогона в журнал регистрации. Результат регламента судят по этой строке (свежесть
// и уровень), а не по коду возврата: код возврата не доказывает, что работа сделана.
Процедура ЗаписатьВЖурнал(Знач Текст, Знач ЭтоОшибка = Ложь,
	Знач Событие = "ЭДО.Регламент") Экспорт

	Попытка
		ЗаписьЖурналаРегистрации(Событие,
			?(ЭтоОшибка, УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Информация),
			, , Лев(Текст, 5000));
	Исключение
	// журнал недоступен - прогон ронять нельзя
	КонецПопытки;

КонецПроцедуры

// Карта статусов Платформы -> текст колонки "ЭДО": в поле либо состояние, либо "Ошибка: ...",
// не длиннее 50 символов. Карта одна на полную и точечную сверку и карточку документа:
// механизмы узнают свои строки точным сравнением, и две карты разошлись бы.
Функция КартаСтатусовПлатформы() Экспорт

	Карта = Новый Соответствие;
	Карта.Вставить("NEW",                     "Отправляется");
	Карта.Вставить("AWAIT_PAYMENT",           "Отправляется");
	Карта.Вставить("SENT_TO_OPERATOR",        "Отправляется");
	Карта.Вставить("SENT",                    "Отправлен");
	Карта.Вставить("DELIVERED",               "Доставлен");
	Карта.Вставить("ACCEPTED",                "Принят");
	Карта.Вставить("REJECTED",                "Отказ контрагента");
	Карта.Вставить("SENDING_FAILED",          "Ошибка: не отправлен");
	Карта.Вставить("CANCELLED",               "Аннулирован");
	Карта.Вставить("CANCELLATION_REQUESTED",  "Запрошено аннулирование");
	// Карточку удалил отправитель: так уходят только неподписанные черновики (NEW),
	// контрагенту документ не доставлялся.
	Карта.Вставить("DELETED",                 ЭДО_Сервер.ТекстКарточкаУдалена());
	Возврат Карта;

КонецФункции

// Состояния, после которых документ дальше сам не двигается. Точечная сверка их не
// опрашивает: аннулирование принятого документа и переход отказа в другое состояние
// бывают, но редко, и их подбирает часовой полный обход.
Функция ФинальныеСостоянияКолонки() Экспорт

	Тексты = Новый Массив;
	Тексты.Добавить("Принят");
	Тексты.Добавить("Отказ контрагента");
	Тексты.Добавить("Аннулирован");
	Тексты.Добавить(ЭДО_Сервер.ТекстКарточкаУдалена());   // удаленная карточка не оживает
	Тексты.Добавить(ЭДО_Сервер.ТекстСтатусаОтправкаНеТребуется());
	Возврат Тексты;

КонецФункции

// Идентификатор документа у оператора - строкой, годной для сравнения. JSON отдает id числом,
// а Строка(<число>) вставляет неразрывные пробелы между группами, и сравнение молча не совпадает.
Функция ИдентификаторСтрокой(Знач Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Точечная сверка статусов - дешевый частый прогон: спрашивает у оператора ровно документы
// с нефинальным статусом формой "documents?id=<a>&id=<b>", без интервала дат.
// Полный обход (ВыполнитьСверкуСтатусов) остается: только он видит карточки без пары в базе
// и изменения документов старше окна и уже финальных.
//
// Возврат: Строка - свод для журнала и для ручного запуска.
Функция ВыполнитьТочечнуюСверку(Знач ОкноДней = 7, Знач Организация = Неопределено) Экспорт

	Если Организация = Неопределено И ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Своды = Новый Массив;
		Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
			Своды.Добавить(ВыполнитьТочечнуюСверку(ОкноДней, УчетнаяЗапись.Организация));
		КонецЦикла;
		Возврат СтрСоединить(Своды, Символы.ПС);
	КонецЕсли;

	Свод = "";
	Метка = ?(Организация = Неопределено, "", " [" + Строка(Организация) + "]");

	Попытка
		РазмерПачки = 100;   // 100 идентификаторов дают URL около 1,4 КБ - в лимиты укладывается
		ПоказатьМакс = 30;

		СвойствоСтатус = ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние");
		СвойствоИд = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
		Если СвойствоСтатус = Неопределено ИЛИ СвойствоСтатус.Пустая()
			ИЛИ СвойствоИд = Неопределено ИЛИ СвойствоИд.Пустая() Тогда
			ВызватьИсключение "Не заведены свойства ЭДО_Состояние или ЭДО_ИдентификаторДокумента";
		КонецЕсли;

		// Берем документы с карточкой у оператора и нефинальным состоянием. Пустое состояние
		// тоже берем: это документ, отправленный только что, и он как раз интереснее всех.
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Реализация.Ссылка КАК Ссылка,
			|	Реализация.Номер КАК Номер,
			|	ВЫРАЗИТЬ(Ид.Значение КАК СТРОКА(50)) КАК ИдЭДО,
			|	ЕСТЬNULL(ВЫРАЗИТЬ(Статусы.Значение КАК СТРОКА(50)), """") КАК ТекущийСтатус
			|ИЗ
			|	Документ.РеализацияТоваровУслуг КАК Реализация
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Ид
			|		ПО Ид.Объект = Реализация.Ссылка
			|			И Ид.Свойство = &СвойствоИд
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Статусы
			|		ПО Статусы.Объект = Реализация.Ссылка
			|			И Статусы.Свойство = &СвойствоСтатус
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗапросАн
			|		ПО ЗапросАн.Объект = Реализация.Ссылка
			|			И ЗапросАн.Свойство = &СвойствоЗапросАн
			|ГДЕ
			|	Реализация.Проведен
			|	И (&ВсеОрганизации ИЛИ Реализация.Организация.ИНН = &ИННОрганизации)
			|	И (Реализация.Дата >= &Граница
			|			И НЕ ЕСТЬNULL(ВЫРАЗИТЬ(Статусы.Значение КАК СТРОКА(50)), """") В (&Финальные)
			|		ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(ЗапросАн.Значение КАК СТРОКА(50)), """") <> """"
			|		ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Статусы.Значение КАК СТРОКА(50)), """") = &ТекстЗапросаАн)";
		Запрос.УстановитьПараметр("СвойствоИд", СвойствоИд);
		Запрос.УстановитьПараметр("ВсеОрганизации", Организация = Неопределено);
		Запрос.УстановитьПараметр("ИННОрганизации", ?(Организация = Неопределено, "", СокрЛП(Организация.ИНН)));
		Запрос.УстановитьПараметр("СвойствоСтатус", СвойствоСтатус);
		Запрос.УстановитьПараметр("Граница", НачалоДня(ТекущаяДата()) - ОкноДней * 86400);
		Запрос.УстановитьПараметр("Финальные", ФинальныеСостоянияКолонки());
		// Запрос контрагента на аннулирование приходит и по старым документам: их берем без оглядки
		// на окно, пока запрос открыт, и еще раз после закрытия, чтобы колонка вернулась к статусу.
		СвойствоЗапросАн = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ЗапросАннулирования");
		Запрос.УстановитьПараметр("СвойствоЗапросАн", ?(СвойствоЗапросАн = Неопределено,
			ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка(), СвойствоЗапросАн));
		Запрос.УстановитьПараметр("ТекстЗапросаАн", ЭДО_Сервер.ТекстЗапросаАннулирования());

		// ОкноДней = 0 - сверка без окна: все документы любого вида с карточкой у оператора
		// и нефинальным состоянием. Сверки с окном теряют подписи и отказы, пришедшие позже окна,
		// а акты сверки и корректировки не сверяют вовсе.
		// Идем от регистра, а не от документа: видов документов несколько. Отбор по организации
		// через составной Объект дал бы соединение со всеми типами, поэтому он ниже, в коде.
		Если ОкноДней = 0 Тогда
			Запрос.Текст =
				"ВЫБРАТЬ
				|	Ид.Объект КАК Ссылка,
				|	ПРЕДСТАВЛЕНИЕ(Ид.Объект) КАК Номер,
				|	ВЫРАЗИТЬ(Ид.Значение КАК СТРОКА(50)) КАК ИдЭДО,
				|	ЕСТЬNULL(ВЫРАЗИТЬ(Статусы.Значение КАК СТРОКА(50)), """") КАК ТекущийСтатус
				|ИЗ
				|	РегистрСведений.ЗначенияСвойствОбъектов КАК Ид
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Статусы
				|		ПО Статусы.Объект = Ид.Объект
				|			И Статусы.Свойство = &СвойствоСтатус
				|ГДЕ
				|	Ид.Свойство = &СвойствоИд
				|	И НЕ ЕСТЬNULL(ВЫРАЗИТЬ(Статусы.Значение КАК СТРОКА(50)), """") В (&Финальные)";
		КонецЕсли;
		Таблица = Запрос.Выполнить().Выгрузить();
		Если ОкноДней = 0 И Организация <> Неопределено Тогда
			ИННОтбора = СокрЛП(Организация.ИНН);
			Чужие = Новый Массив;
			Для Каждого Строчка Из Таблица Цикл
				ИННДокумента = "";
				Попытка
					ИННДокумента = СокрЛП(Строчка.Ссылка.Организация.ИНН);
				Исключение
				КонецПопытки;
				Если ИННДокумента <> ИННОтбора Тогда
					Чужие.Добавить(Строчка);
				КонецЕсли;
			КонецЦикла;
			Для Каждого Строчка Из Чужие Цикл
				Таблица.Удалить(Строчка);
			КонецЦикла;
		КонецЕсли;
		ОписаниеОкна = ?(ОкноДней = 0, "без окна", "окно " + ОкноДней + " дн.");

		Если Таблица.Количество() = 0 Тогда
			Свод = "ЭДО, точечная сверка" + Метка + ": нечего спрашивать (" + ОписаниеОкна + ")";
			ЗаписатьВЖурнал(Свод, Ложь, "ЭДО.Регламент.ТочечнаяСверка");
			Возврат Свод;
		КонецЕсли;

		КартаИд = Новый Соответствие;   // идентификатор у оператора -> Структура(Ссылка, ТекущийСтатус)
		Идентификаторы = Новый Массив;
		Для Каждого Строчка Из Таблица Цикл
			Ид = СокрЛП(Строка(Строчка.ИдЭДО));
			Если НЕ ЗначениеЗаполнено(Ид) ИЛИ КартаИд.Получить(Ид) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			КартаИд.Вставить(Ид, Новый Структура("Ссылка, ТекущийСтатус, Номер",
				Строчка.Ссылка, СокрЛП(Строка(Строчка.ТекущийСтатус)), СокрЛП(Строка(Строчка.Номер))));
			Идентификаторы.Добавить(Ид);
		КонецЦикла;

		Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация) Тогда
			ВызватьИсключение "Не удалось получить токен Платформы";
		КонецЕсли;
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
		Заголовки.Вставить("accept", "application/json;charset=UTF-8");
		Соед = ЭДО_Сервер.СоединениеСОператором();
		КартаСтатусов = КартаСтатусовПлатформы();
		ЗапросыАннулирования = ЭДО_Сервер.ДокументыСЗапросомАннулирования();

		Запросов = 0;
		Отвечено = 0;
		Записано = 0;
		Ошибки = "";
		Изменения = Новый Массив;
		СтрокиОтказов = Новый Соответствие;

		Индекс = 0;
		Пока Индекс < Идентификаторы.Количество() Цикл
			Пачка = Новый Массив;
			Пока Индекс < Идентификаторы.Количество() И Пачка.Количество() < РазмерПачки Цикл
				Пачка.Добавить("id=" + Идентификаторы[Индекс]);
				Индекс = Индекс + 1;
			КонецЦикла;

			// page_size обязателен и при запросе по идентификаторам: без него выдача молча режется
			// до 20 записей (HTTP 200, без ошибок).
			Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/documents?"
				+ СтрСоединить(Пачка, "&") + "&page_size=" + РазмерПачки;
			Ответ = Неопределено;
			Попытка
				Ответ = Соед.Получить(Новый HTTPЗапрос(Путь, Заголовки));
			Исключение
				// таймаут прилетает исключением - пачку пропускаем, ее возьмет следующий прогон
				Ошибки = Ошибки + "пачка не отвечена: " + Лев(ОписаниеОшибки(), 80) + "; ";
				Продолжить;
			КонецПопытки;
			Запросов = Запросов + 1;
			Если Ответ.КодСостояния <> 200 Тогда
				Ошибки = Ошибки + "HTTP " + Ответ.КодСостояния + "; ";
				Продолжить;
			КонецЕсли;

			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
			МассивОтвета = ПрочитатьJSON(Чтение, Ложь);
			Чтение.Закрыть();
			Если ТипЗнч(МассивОтвета) <> Тип("Массив") Тогда
				Продолжить;
			КонецЕсли;

			Для Каждого Карточка Из МассивОтвета Цикл
				Отвечено = Отвечено + 1;
				Данные = КартаИд.Получить(ИдентификаторСтрокой(Карточка.id));
				Если Данные = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				СтатусAPI = Строка(Карточка.status);
				НовыйСтатус = КартаСтатусов.Получить(СтатусAPI);
				Если НовыйСтатус = Неопределено Тогда
					НовыйСтатус = СтатусAPI;   // незнакомый статус показываем как есть
				КонецЕсли;
				НовыйСтатус = ЭДО_Сервер.ТекстКолонкиСУчетомЗапросаАннулирования(Данные.Ссылка,
					Лев(НовыйСтатус, 50), ЗапросыАннулирования);
				Если НовыйСтатус = Данные.ТекущийСтатус Тогда
					Продолжить;
				КонецЕсли;
				Попытка
					ЭДО_Сервер.ЗаписатьЧитаемыйСтатус(Данные.Ссылка, НовыйСтатус);
					Записано = Записано + 1;
					Если Изменения.Количество() < ПоказатьМакс Тогда
						Изменения.Добавить(Данные.Номер + ": " + ?(ЗначениеЗаполнено(Данные.ТекущийСтатус),
							Данные.ТекущийСтатус, "(пусто)") + " -> " + НовыйСтатус);
						Если СтатусAPI = "REJECTED" ИЛИ СтатусAPI = "SENDING_FAILED" Тогда
							СтрокиОтказов.Вставить(ИдентификаторСтрокой(Карточка.id), Изменения.ВГраница());
						КонецЕсли;
					КонецЕсли;
				Исключение
					Ошибки = Ошибки + Данные.Номер + ": " + Лев(ОписаниеОшибки(), 80) + "; ";
				КонецПопытки;
			КонецЦикла;
		КонецЦикла;
		ДописатьПричиныОтказов(Изменения, СтрокиОтказов, Организация);

		Свод = "ЭДО, точечная сверка" + Метка + ": " + ОписаниеОкна + ", спрошено " + Идентификаторы.Количество()
			+ ", запросов " + Запросов + ", отвечено " + Отвечено + ", обновлено " + Записано;
		Если Ошибки <> "" Тогда
			Свод = Свод + " | ОШИБКА: " + Лев(Ошибки, 400);
		КонецЕсли;
		Для Каждого Строчка Из Изменения Цикл
			Свод = Свод + Символы.ПС + "  " + Строчка;
		КонецЦикла;

		// В журнал пишем только когда что-то изменилось или сломалось: прогон раз в пять минут
		// иначе забьет журнал регистрации сотней пустых строк в сутки.
		Если Записано > 0 ИЛИ Ошибки <> "" Тогда
			ЗаписатьВЖурнал(Свод, Ошибки <> "", "ЭДО.Регламент.ТочечнаяСверка");
		КонецЕсли;

	Исключение
		Свод = "ЭДО, точечная сверка" + Метка + " — ОШИБКА: " + ОписаниеОшибки();
		ЗаписатьВЖурнал(Свод, Истина, "ЭДО.Регламент.ТочечнаяСверка");
	КонецПопытки;

	Возврат Свод;

КонецФункции

// Дописывает к строкам журнала причину отказа контрагента или падения отправки.
// Причина лежит не в карточке, а в цепочке документа, поэтому без отдельного запроса журнал
// сообщает, что отказали, но не почему.
//
// Параметры:
//   Строки - Массив - строки журнала, дополняются на месте.
//   СтрокиОтказов - Соответствие - идентификатор карточки строкой -> индекс строки в Строки.
//   Организация - СправочникСсылка.Организации, Неопределено - чья учетная запись спрашивает.
Процедура ДописатьПричиныОтказов(Строки, Знач СтрокиОтказов, Знач Организация)

	Если СтрокиОтказов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Идентификаторы = Новый Массив;
	Для Каждого Пара Из СтрокиОтказов Цикл
		Идентификаторы.Добавить(Пара.Ключ);
	КонецЦикла;

	// Причина - подсказка к строке: не получили ее - сверка все равно состоялась.
	Попытка
		Причины = ЭДО_Сервер.ПричиныОтказаПоИдентификаторам(Идентификаторы, Организация);
	Исключение
		Возврат;
	КонецПопытки;

	Для Каждого Пара Из СтрокиОтказов Цикл
		Причина = Причины.Получить(Пара.Ключ);
		Если ЗначениеЗаполнено(Причина) Тогда
			Строки[Пара.Значение] = Строки[Пара.Значение] + ": "
				+ Лев(СтрЗаменить(Причина, Символы.ПС, " "), 200);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Сверка статусов у оператора: пишет колонку "ЭДО" документам с карточкой у оператора
// и возвращает в очередь документы, до контрагента не дошедшие.
//
// У документа у оператора бывает несколько экземпляров: переотправка создает новый, старый
// остается в своем статусе. Актуальным считается экземпляр с максимальным created.
// Сопоставление с базой - по invoice.num + invoice.date: номер накладной повторяется по годам.
//
// ЭДО_КодСостояния = 40 означает "отправляли", а не "дошло"; не путать с ЭДО_Состояние
// (текст колонки). Пока отметка 40 стоит, документ не переотправить, поэтому блок 5 снимает
// ее у упавших документов без живого экземпляра.
//
// Здоровый API отвечает за доли секунды; прогон на минуты - признак аварии оператора,
// смотри счетчик таймаутов в своде.
Функция ВыполнитьСверкуСтатусов(Знач Организация = Неопределено) Экспорт

	Если Организация = Неопределено И ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Своды = Новый Массив;
		Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
			Своды.Добавить(ВыполнитьСверкуСтатусов(УчетнаяЗапись.Организация));
		КонецЦикла;
		Возврат СтрСоединить(Своды, Символы.ПС);
	КонецЕсли;

	Попытка
		// окно обхода по дате создания карточки - настройка расширения
		ГлубинаДней = ЭДО_Сервер.НастройкаЭДО("ГлубинаДнейСинхронизацииСтатусов");
		ПоказатьМакс = 30;     // потолок списка проблемных в логе
		ПорогСвежестиДней = 3; // отказ старше - в очередь не возвращаем, нужен разбор человеком
		// Префиксы операторов, куда отправка не проходит по внешней причине (настройка расширения):
		// повтор таким получателям бесполезен, в очередь их не возвращаем.
		НерабочиеПрефиксы = Новый Массив;
		Для Каждого Кусок Из СтрРазделить(ЭДО_Сервер.НастройкаЭДО("НерабочиеПрефиксыЭДО"), ",", Ложь) Цикл
			Если ЗначениеЗаполнено(СокрЛП(Кусок)) Тогда
				НерабочиеПрефиксы.Добавить(ВРег(СокрЛП(Кусок)));
			КонецЕсли;
		КонецЦикла;

		СвойствоСтатус = ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние");
		Если СвойствоСтатус = Неопределено ИЛИ СвойствоСтатус.Пустая() Тогда
			ВызватьИсключение "Не заведено свойство ЭДО_Состояние в ПВХ СвойстваОбъектов";
		КонецЕсли;
		// отметка отправки расширения - ее снимаем у документов, до контрагента не дошедших
		СвойствоОтправки = ЭДО_Сервер.СвойствоОбъектов("ЭДО_КодСостояния");
		// Снять одну отметку 40 недостаточно: очередь берет только документы без идентификатора
		// оператора, поэтому снимаем и его. Упавший экземпляр находится по номеру накладной,
		// его идентификатор пишется в журнал.
		СвойствоИдПлатформы = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента");

		// Статусы живого экземпляра: в пути или уже у контрагента. Хотя бы один живой экземпляр
		// запрещает переотправку, даже если самый свежий - отказной: контрагент мог отклонить
		// лишний дубль и подписать нужный.
		ЖивыеСтатусы = Новый Соответствие;
		ЖивыеСтатусы.Вставить("NEW", Истина);
		ЖивыеСтатусы.Вставить("AWAIT_PAYMENT", Истина);
		ЖивыеСтатусы.Вставить("SENT_TO_OPERATOR", Истина);
		ЖивыеСтатусы.Вставить("SENT", Истина);
		ЖивыеСтатусы.Вставить("DELIVERED", Истина);
		ЖивыеСтатусы.Вставить("ACCEPTED", Истина);
		ЖивыеСтатусы.Вставить("CANCELLATION_REQUESTED", Истина);

		КартаСтатусов = КартаСтатусовПлатформы();
		ЗапросыАннулирования = ЭДО_Сервер.ДокументыСЗапросомАннулирования();

		// -- 1. Токен и соединение -------------------------------------------------------------
		Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация) Тогда
			ВызватьИсключение "Не удалось получить токен Платформы";
		КонецЕсли;
		Токен = ЭДО_Сервер.ТекущийТокен(Организация);
		ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Гид = ЭДО_Сервер.ГидОрганизации(Организация);
		// Таймаут - настройка расширения "Таймаут HTTP, секунд". Держать небольшим: при аварии
		// оператора он умножается на повторы и вешает прогон.
		Соед = ЭДО_Сервер.СоединениеСОператором();

		// -- 2. Карта базы: "номер|дата" -> ссылка на реализацию --------------------------------
		// Запас в 3 дня: карточка Платформы может быть создана позже даты самой накладной.
		ГраницаДок = НачалоДня(ТекущаяДата()) - (ГлубинаДней + 3) * 86400;
		ЗапросБаза = Новый Запрос(
			"ВЫБРАТЬ
			|	Реализация.Ссылка КАК Ссылка,
			|	Реализация.Номер КАК Номер,
			|	Реализация.Дата КАК Дата,
			|	ЕСТЬNULL(Статусы.Значение, """") КАК ТекущийСтатус,
			|	ЕСТЬNULL(Отправки.Значение, """") КАК ОтметкаОтправки
			|ИЗ
			|	Документ.РеализацияТоваровУслуг КАК Реализация
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Статусы
			|		ПО Реализация.Ссылка = Статусы.Объект
			|			И Статусы.Свойство = &СвойствоСтатус
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Отправки
			|		ПО Реализация.Ссылка = Отправки.Объект
			|			И Отправки.Свойство = &СвойствоОтправки
			|ГДЕ
			|	Реализация.Дата >= &Граница
			|	И Реализация.Проведен
			|	И (&ВсеОрганизации ИЛИ Реализация.Организация.ИНН = &ИННОрганизации)");
		ЗапросБаза.УстановитьПараметр("СвойствоСтатус", СвойствоСтатус);
		ЗапросБаза.УстановитьПараметр("СвойствоОтправки", СвойствоОтправки);
		ЗапросБаза.УстановитьПараметр("Граница", ГраницаДок);
		ЗапросБаза.УстановитьПараметр("ВсеОрганизации", Организация = Неопределено);
		ЗапросБаза.УстановитьПараметр("ИННОрганизации", ?(Организация = Неопределено, "", СокрЛП(Организация.ИНН)));
		ВыборкаБаза = ЗапросБаза.Выполнить().Выбрать();
		КартаБазы = Новый Соответствие;      // "номер|дд.ММ.гггг" -> Структура(Ссылка, ТекущийСтатус)
		Пока ВыборкаБаза.Следующий() Цикл
			КлючБазы = СокрЛП(ВыборкаБаза.Номер) + "|" + Формат(ВыборкаБаза.Дата, "ДФ=dd.MM.yyyy");
			КартаБазы.Вставить(КлючБазы, Новый Структура("Ссылка, ТекущийСтатус, ОтметкаОтправки",
				ВыборкаБаза.Ссылка, СокрЛП(Строка(ВыборкаБаза.ТекущийСтатус)),
				СокрЛП(Строка(ВыборкаБаза.ОтметкаОтправки))));
		КонецЦикла;

		// -- 3. Обход исходящих карточек интервалами --------------------------------------------
		// У выдачи два потолка: page_size = 100 и page = 9 (page=10 - HTTP 400), из интервала видно
		// не больше 1000 карточек, остальные теряются молча. Интервал, упершийся в потолок, делится
		// пополам и обходится заново; повтор безопасен - экземпляры складываются по ключу "номер|дата".
		Экземпляры = Новый Соответствие;     // "номер|дата" -> Структура(Ид, Создан, Статус, Получатель)
		Запросов = 0;
		ВсегоКарточек = 0;
		Ошибки = "";
		Таймаутов = 0;
		Разбиений = 0;
		Финиш = НачалоДня(ТекущаяУниверсальнаяДата());
		Интервалы = Новый Массив;            // очередь: Структура(Нач, Кон) в универсальном времени
		День = Финиш - (ГлубинаДней - 1) * 86400;
		Пока День <= Финиш Цикл
			Интервалы.Добавить(Новый Структура("Нач, Кон", День, День + 86399));
			День = День + 86400;
		КонецЦикла;
		// потолок на случай аварии выдачи: без него деление могло бы плодить интервалы бесконечно
		МаксИнтервалов = ГлубинаДней * 32;
		ИндексИнтервала = 0;
		Пока ИндексИнтервала < Интервалы.Количество() Цикл
			Интервал = Интервалы[ИндексИнтервала];
			ИндексИнтервала = ИндексИнтервала + 1;
			ОтДата = Формат(Интервал.Нач, "ДФ=yyyy-MM-dd") + "T" + Формат(Интервал.Нач, "ДФ=HH:mm:ss") + ".000Z";
			ДоДата = Формат(Интервал.Кон, "ДФ=yyyy-MM-dd") + "T" + Формат(Интервал.Кон, "ДФ=HH:mm:ss") + ".000Z";
			ИнтервалПереполнен = Ложь;
			Для Страница = 0 По 9 Цикл
				// Токен Keycloak живет 15 минут; перевыпуск - по времени, а не по числу запросов:
				// при таймаутах запросы растягиваются дольше жизни токена.
				Если ТекущаяУниверсальнаяДатаВМиллисекундах() - ТокенПолучен > 600000 Тогда
					ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
					Токен = ЭДО_Сервер.ТекущийТокен(Организация);
					ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
				КонецЕсли;
				Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/documents?created_from=" + ОтДата + "&created_till=" + ДоДата
					+ "&sender_id=" + Гид + "&page=" + Страница + "&page_size=100";
				// Одиночный таймаут не должен убивать прогон: при аварии оператора виснет часть запросов,
				// остальные отвечают быстро. Попыток пять: три таймаута подряд на одной странице бывали.
				МассивКарточек = Неопределено;
				Для НомерПопытки = 1 По 5 Цикл
					ЗапросПлатформы = Новый HTTPЗапрос(Путь);
					ЗапросПлатформы.Заголовки.Вставить("Authorization", "Bearer " + Токен);
					ЗапросПлатформы.Заголовки.Вставить("accept", "application/json;charset=UTF-8");
					Запросов = Запросов + 1;
					Попытка
						ОтветHTTP = Соед.Получить(ЗапросПлатформы);
					Исключение
						Таймаутов = Таймаутов + 1;
						Если НомерПопытки = 5 Тогда
							Ошибки = Ошибки + Формат(Интервал.Нач, "ДФ=dd.MM HH:mm") + " стр." + Страница + ": таймаут x5; ";
						КонецЕсли;
						Продолжить;
					КонецПопытки;
					Если ОтветHTTP.КодСостояния = 401 Тогда
						// токен протух между попытками - перевыпустить и повторить ЭТУ ЖЕ страницу,
						// иначе день молча выпадает из обхода целиком
						ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
						Токен = ЭДО_Сервер.ТекущийТокен(Организация);
						ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
						Если НомерПопытки = 5 Тогда
							Ошибки = Ошибки + Формат(Интервал.Нач, "ДФ=dd.MM HH:mm") + " стр." + Страница + ": 401 x5; ";
						КонецЕсли;
						Продолжить;
					КонецЕсли;
					Если ОтветHTTP.КодСостояния <> 200 Тогда
						Ошибки = Ошибки + Формат(Интервал.Нач, "ДФ=dd.MM HH:mm") + " стр." + Страница + ": HTTP " + ОтветHTTP.КодСостояния + "; ";
						Прервать;
					КонецЕсли;
					Чтение = Новый ЧтениеJSON;
					Чтение.УстановитьСтроку(ОтветHTTP.ПолучитьТелоКакСтроку("UTF-8"));
					МассивКарточек = ПрочитатьJSON(Чтение, Ложь);
					Чтение.Закрыть();
					Прервать;
				КонецЦикла;
				Если МассивКарточек = Неопределено Тогда
					// страницу взять не удалось - день считаем неполным и идем дальше
					Прервать;
				КонецЕсли;
				Для Каждого Карточка Из МассивКарточек Цикл
					ВсегоКарточек = ВсегоКарточек + 1;
					КлючКарт = "";
					Если Карточка.Свойство("invoice") И Карточка.invoice <> Неопределено Тогда
						Если Карточка.invoice.Свойство("num") И Карточка.invoice.Свойство("date") Тогда
							КлючКарт = СокрЛП(Строка(Карточка.invoice.num)) + "|" + СокрЛП(Строка(Карточка.invoice.date));
						КонецЕсли;
					КонецЕсли;
					Если КлючКарт = "" Тогда
						Продолжить;
					КонецЕсли;
					Получатель = "";
					Если Карточка.Свойство("recipient") И Карточка.recipient <> Неопределено Тогда
						Получатель = Строка(Карточка.recipient.id);
					КонецЕсли;
					// живой экземпляр запоминаем ОТДЕЛЬНО от актуального: для колонки нужен
					// самый свежий статус, а для решения "можно ли слать заново" - есть ли
					// ХОТЯ БЫ ОДИН экземпляр в пути или у контрагента.
					ЭтотЖивой = (ЖивыеСтатусы.Получить(Строка(Карточка.status)) <> Неопределено);
					ЭтотУпал = (Строка(Карточка.status) = "SENDING_FAILED");
					Текущий = Экземпляры.Получить(КлючКарт);
					// актуален экземпляр с максимальным created - остальные это прошлые отправки
					Если Текущий = Неопределено ИЛИ Строка(Карточка.created) > Текущий.Создан Тогда
						БылЖивой = ?(Текущий = Неопределено, Ложь, Текущий.ЕстьЖивой);
						БылоПадений = ?(Текущий = Неопределено, 0, Текущий.Падений);
						Экземпляры.Вставить(КлючКарт, Новый Структура("Ид, Создан, Статус, Получатель, ЕстьЖивой, Падений",
							ИдентификаторСтрокой(Карточка.id), Строка(Карточка.created), Строка(Карточка.status), Получатель,
							БылЖивой ИЛИ ЭтотЖивой, БылоПадений + ?(ЭтотУпал, 1, 0)));
					Иначе
						Если ЭтотЖивой Тогда
							Текущий.ЕстьЖивой = Истина;
						КонецЕсли;
						Если ЭтотУпал Тогда
							Текущий.Падений = Текущий.Падений + 1;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				Если МассивКарточек.Количество() < 100 Тогда
					Прервать;
				КонецЕсли;
				Если Страница = 9 Тогда
					// последняя доступная страница пришла ПОЛНОЙ - выдача обрезана потолком
					ИнтервалПереполнен = Истина;
				КонецЕсли;
			КонецЦикла;
			Если ИнтервалПереполнен Тогда
				Длительность = Интервал.Кон - Интервал.Нач;
				Если Длительность <= 59 ИЛИ Интервалы.Количество() >= МаксИнтервалов Тогда
					// минута с 1000+ карточек либо разросшаяся очередь - дальше не дробим, но пишем в свод
					Ошибки = Ошибки + Формат(Интервал.Нач, "ДФ=dd.MM HH:mm") + "–"
						+ Формат(Интервал.Кон, "ДФ=HH:mm") + ": выдача обрезана потолком; ";
				Иначе
					Середина = Интервал.Нач + Цел(Длительность / 2);
					Интервалы.Добавить(Новый Структура("Нач, Кон", Интервал.Нач, Середина));
					Интервалы.Добавить(Новый Структура("Нач, Кон", Середина + 1, Интервал.Кон));
					Разбиений = Разбиений + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		// -- 4. Запись статуса --------------------------------------------------------------------
		Обновлено = 0;
		Записано = 0;
		БезПары = 0;
		Сброшено = 0;
		КандидатыОтказа = Новый Массив;   // REJECTED - решает человек, автосброса нет (см. блок 5)
		Проблемные = Новый Массив;
		СтрокиОтказов = Новый Соответствие;
		Для Каждого Пара Из Экземпляры Цикл
			ДанныеБазы = КартаБазы.Получить(Пара.Ключ);
			Если ДанныеБазы = Неопределено Тогда
				БезПары = БезПары + 1;
				Продолжить;
			КонецЕсли;
			СтатусAPI = Пара.Значение.Статус;
			НовыйСтатус = КартаСтатусов.Получить(СтатусAPI);
			Если НовыйСтатус = Неопределено Тогда
				НовыйСтатус = СтатусAPI;   // незнакомый статус показываем как есть, а не прячем
			КонецЕсли;
			НовыйСтатус = Лев(НовыйСтатус, 50);   // ресурс Значение - Строка(50), как у СБИС
			НовыйСтатус = ЭДО_Сервер.ТекстКолонкиСУчетомЗапросаАннулирования(ДанныеБазы.Ссылка,
				НовыйСтатус, ЗапросыАннулирования);
			// Блок 5 (сброс отметки) идет и тогда, когда текст статуса не изменился: документ мог
			// со вчера висеть в "Ошибка: не отправлен", а вернуть в очередь его все равно надо.
			// Писатели колонки разделены: ядро (ОбновитьПричиныНеотправки) ведет документы без карточки
			// у оператора и считает своими только тексты причин, сверка - документы с карточкой.
			Если НовыйСтатус <> ДанныеБазы.ТекущийСтатус Тогда
				Обновлено = Обновлено + 1;
				// "Отправка не требуется" не трогаем никогда: этот текст служит фильтром отбора
				// очереди, и его перезапись вернула бы документ в отправку.
				Если ДанныеБазы.ТекущийСтатус <> ЭДО_Сервер.ТекстСтатусаОтправкаНеТребуется() Тогда
					Попытка
						ЭДО_Сервер.ЗаписатьЧитаемыйСтатус(ДанныеБазы.Ссылка, НовыйСтатус);
						Записано = Записано + 1;
					Исключение
						Если Проблемные.Количество() < ПоказатьМакс Тогда
							Проблемные.Добавить("не записан статус " + Пара.Ключ + ": "
								+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
						КонецЕсли;
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;

			// -- 5. Сброс отметки отправки у документов, до контрагента НЕ дошедших --------------
			// Пока ЭДО_КодСостояния = 40, документ не переотправить ничем, кроме правки регистра.
			Если СвойствоОтправки <> Неопределено И НЕ СвойствоОтправки.Пустая()
				И СокрЛП(ДанныеБазы.ОтметкаОтправки) = "40"
				И НЕ Пара.Значение.ЕстьЖивой Тогда

				Если СтатусAPI = "SENDING_FAILED" Тогда
					// Оператор документ не отправил: у контрагента его нет, дубля быть не может.
					// Но в очередь возвращаем, только если повтор имеет смысл:
					// - получатель не на нерабочем префиксе - там повтор падает вечно;
					// - отказ свежий - авария лечится за день-два, застарелое падение лечится разбором;
					// - экземпляр падал не больше раза - иначе причина системная.
					ДатаОтказа = '00010101';
					Попытка
						ДатаОтказа = Дата(Сред(Пара.Значение.Создан, 1, 4) + Сред(Пара.Значение.Создан, 6, 2)
							+ Сред(Пара.Значение.Создан, 9, 2));
					Исключение
					КонецПопытки;
					Свежий = ЗначениеЗаполнено(ДатаОтказа)
						И (НачалоДня(ТекущаяУниверсальнаяДата()) - ДатаОтказа) <= ПорогСвежестиДней * 86400;
					Мёртвый = Ложь;
					Для Каждого Преф Из НерабочиеПрефиксы Цикл
						Если СтрНачинаетсяС(ВРег(Пара.Значение.Получатель), Преф) Тогда
							Мёртвый = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если Мёртвый Тогда
						Продолжить;   // молча: это не проблема документа, а закрытый канал
					КонецЕсли;
					Если НЕ Свежий ИЛИ Пара.Значение.Падений > 1 Тогда
						Если КандидатыОтказа.Количество() < ПоказатьМакс Тогда
							КандидатыОтказа.Добавить("не возвращён в очередь (" + ?(Свежий, "падал " + Пара.Значение.Падений + " раза", "застарелый отказ")
								+ "): " + Пара.Ключ);
						КонецЕсли;
						Продолжить;
					КонецЕсли;
					НаборОтпр = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
					НаборОтпр.Отбор.Объект.Установить(ДанныеБазы.Ссылка);
					НаборОтпр.Отбор.Свойство.Установить(СвойствоОтправки);
					НаборОтпр.Записать();   // пустой набор = снятие отметки
					Если СвойствоИдПлатформы <> Неопределено И НЕ СвойствоИдПлатформы.Пустая() Тогда
						НаборИд = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
						НаборИд.Отбор.Объект.Установить(ДанныеБазы.Ссылка);
						НаборИд.Отбор.Свойство.Установить(СвойствоИдПлатформы);
						НаборИд.Записать();
					КонецЕсли;
					Сброшено = Сброшено + 1;
					Если Проблемные.Количество() < ПоказатьМакс Тогда
						Проблемные.Добавить("возвращён в очередь: " + Пара.Ключ + " (был ид " + Пара.Значение.Ид + ")");
					КонецЕсли;

				ИначеЕсли СтатусAPI = "REJECTED" Тогда
					// Отказ контрагента автоматически не сбрасываем: то же самое он отклонит снова, а признака
					// "документ исправлен" у реализации нет (сверка суммы с invoice.sum не годится - маппинг
					// округляет количество и сам расходится с базой). Только список в журнал, решает человек.
					Если КандидатыОтказа.Количество() < ПоказатьМакс Тогда
						КандидатыОтказа.Добавить(Пара.Ключ + " (ид " + Пара.Значение.Ид + ")");
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;

			Если НовыйСтатус = ДанныеБазы.ТекущийСтатус Тогда
				Продолжить;   // текст колонки не менялся - в списки проблемных не добавляем
			КонецЕсли;
			Если СтатусAPI = "REJECTED" ИЛИ СтатусAPI = "SENDING_FAILED" Тогда
				Если Проблемные.Количество() < ПоказатьМакс Тогда
					Проблемные.Добавить(Пара.Ключ + " -> " + СтатусAPI + " (ид " + Пара.Значение.Ид + ")");
					СтрокиОтказов.Вставить(Пара.Значение.Ид, Проблемные.ВГраница());
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		ДописатьПричиныОтказов(Проблемные, СтрокиОтказов, Организация);

		Свод = "PEDO-StatusSync: окно " + ГлубинаДней + " дн., интервалов " + Интервалы.Количество()
			+ " (разбиений " + Разбиений + "), запросов " + Запросов
			+ ", карточек " + ВсегоКарточек + ", документов " + Экземпляры.Количество()
			+ ", расхождений с колонкой " + Обновлено + " (записано " + Записано + ")"
			+ ", сброшено отметок " + Сброшено
			+ ", без пары в базе " + БезПары + ", таймаутов " + Таймаутов;
		Если Ошибки <> "" Тогда
			Свод = Свод + " | ОШИБКИ: " + Ошибки;
		КонецЕсли;
		Для Каждого Строчка Из Проблемные Цикл
			Свод = Свод + Символы.ПС + "  " + Строчка;
		КонецЦикла;
		Если КандидатыОтказа.Количество() > 0 Тогда
			Свод = Свод + Символы.ПС + "  отказ контрагента, ждут решения человека:";
			Для Каждого Строчка Из КандидатыОтказа Цикл
				Свод = Свод + Символы.ПС + "    " + Строчка;
			КонецЦикла;
		КонецЕсли;
		Результат = Свод;
	Исключение
		Результат = "PEDO-StatusSync ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	Результат = ?(Организация = Неопределено, "", "[" + Строка(Организация) + "] ") + Результат;
	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Строка(Результат)), "ОШИБКА") > 0,
		"ЭДО.Регламент.СверкаСтатусов");
	Возврат Результат;

КонецФункции

// Обновление связей ЭДО: адреса контрагентов и статусы приглашений.
Функция ВыполнитьОбновлениеСвязей() Экспорт

	Попытка
		Результат = ЭДО_Сервер.ОбновитьСвязиЭДО(0);
	Исключение
		Результат = "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Строка(Результат)), "ОШИБКА") > 0,
		"ЭДО.Регламент.ОбновлениеСвязей");
	Возврат Результат;

КонецФункции

// Приглашения к обмену контрагентам, которым есть что отправить, а адреса ЭДО нет.
Функция ВыполнитьПриглашенияНовымКонтрагентам() Экспорт

	Попытка
		Результат = ЭДО_Сервер.ПригласитьНовыхКонтрагентов();
	Исключение
		Результат = "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Строка(Результат)), "ОШИБКА") > 0,
		"ЭДО.Регламент.ПриглашенияНовымКонтрагентам");
	Возврат Результат;

КонецФункции
