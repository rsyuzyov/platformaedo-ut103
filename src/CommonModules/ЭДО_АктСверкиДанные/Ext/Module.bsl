////////////////////////////////////////////////////////////////////////////////
// ЭДО_АктСверкиДанные - сборка данных акта сверки из УТ 10.3.
//
// Это ЕДИНСТВЕННОЕ место, знающее конкретную конфигурацию. Модуль читает
// Документ.АктСверкиВзаиморасчетов и складывает из него структуры, которые понимает
// ЭДО_ФорматАктСверки - тот про метаданные не знает вовсе.
// перенос на другую конфигурацию (moroz, УТ 11, БП, УПП) = переписать ТОЛЬКО этот модуль.
//
// Разделение ответственности:
// ЭДО_АктСверкиДанные - "где в базе лежат номер, период, стороны и строки"
// ЭДО_ФорматАктСверки - "как из этого сделать XML по приказу ЕД-7-26/405@"
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Собирает данные акта сверки для формирования XML.
//
// Параметры:
// СсылкаНаАкт - ДокументСсылка.АктСверкиВзаиморасчетов
//
// Возвращаемое значение:
// Структура - готовая к передаче в ЭДО_ФорматАктСверки.СформироватьXML, плюс два поля:
// * ОшибкиСборки - Массив из Строка - что помешало собрать данные
// * НеполныеДанные - Массив из Строка - чего не хватает по формату (ОГРН и т.п.)
Функция ДанныеАкта(СсылкаНаАкт) Экспорт

	Акт = ЭДО_ФорматАктСверки.НовыйАкт();
	Акт.Вставить("ОшибкиСборки",   Новый Массив);
	Акт.Вставить("НеполныеДанные", Новый Массив);

	Реквизиты = ОбщиеРеквизитыАкта(СсылкаНаАкт);
	Если Реквизиты = Неопределено Тогда
		Акт.ОшибкиСборки.Добавить("Документ не найден или недоступен");
		Возврат Акт;
	КонецЕсли;

	Акт.НомерАкт    = СокрЛП(Реквизиты.Номер);
	Акт.ДатаИнфОтпр = ТекущаяДата();
	Акт.ДатаНачПер  = НачалоДня(Реквизиты.ДатаНачала);
	Акт.ДатаОкПер   = НачалоДня(Реквизиты.ДатаОкончания);
	Акт.ВерсПрог    = "1С:Предприятие 8";

	// Код валюты по ОКВ хранится прямо в коде справочника ("643" = рубль).
	Если ЗначениеЗаполнено(Реквизиты.ВалютаДокумента) Тогда
		Акт.КодОКВ = СокрЛП(Реквизиты.ВалютаДокумента.Код);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Акт.ДатаНачПер) Или Не ЗначениеЗаполнено(Акт.ДатаОкПер) Тогда
		Акт.ОшибкиСборки.Добавить("В акте не заполнен период сверки");
	КонецЕсли;

	ЗаполнитьУчастника(Акт.Отправитель, Реквизиты.Организация, Истина,  Акт.НеполныеДанные);
	ЗаполнитьУчастника(Акт.Получатель,  Реквизиты.Контрагент,  Ложь,    Акт.НеполныеДанные);
	ЗаполнитьПодписанта(Акт.Подписант, Реквизиты, Акт.НеполныеДанные);

	ЗаполнитьТаблицу(Акт, СсылкаНаАкт, Реквизиты);

	ЭДО_ФорматАктСверки.ПересчитатьИтоги(Акт);

	Для Каждого Строка Из ЭДО_ФорматАктСверки.НеполныеРеквизиты(Акт) Цикл
		Акт.НеполныеДанные.Добавить(Строка);
	КонецЦикла;

	Возврат Акт;

КонецФункции

// Формирует XML акта сверки по документу - один вызов вместо двух.
//
// Параметры:
// СсылкаНаАкт - ДокументСсылка.АктСверкиВзаиморасчетов
//
// Возвращаемое значение:
// Структура:
// * ТекстXML - Строка - пустая, если собрать не удалось
// * ИмяФайла - Строка - имя файла обмена без расширения
// * Ошибки - Массив из Строка - блокирующие
// * НеполныеДанные - Массив из Строка - непустой список = кандидат в PDF-ветку
Функция XMLПоДокументу(СсылкаНаАкт, ИдентификаторОтправителя = "", ИдентификаторПолучателя = "") Экспорт

	Результат = Новый Структура("ТекстXML, ИмяФайла, Ошибки, НеполныеДанные", "", "", Новый Массив, Новый Массив);

	Акт = ДанныеАкта(СсылкаНаАкт);

	Для Каждого Строка Из Акт.ОшибкиСборки Цикл
		Результат.Ошибки.Добавить(Строка);
	КонецЦикла;
	Для Каждого Строка Из ЭДО_ФорматАктСверки.ПроверитьЗаполнение(Акт) Цикл
		Результат.Ошибки.Добавить(Строка);
	КонецЦикла;
	Результат.НеполныеДанные = Акт.НеполныеДанные;

	Если Результат.Ошибки.Количество() > 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.ИмяФайла = ЭДО_ФорматАктСверки.ИмяФайлаОбмена(
		ИдентификаторПолучателя, ИдентификаторОтправителя, Акт.ДатаИнфОтпр);
	Акт.ИдФайл = Результат.ИмяФайла;

	Попытка
		Результат.ТекстXML = ЭДО_ФорматАктСверки.СформироватьXML(Акт);
	Исключение
		Результат.Ошибки.Добавить("Ошибка формирования XML: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбщиеРеквизитыАкта(СсылкаНаАкт)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Акт.Номер КАК Номер,
		|	Акт.Дата КАК Дата,
		|	Акт.Организация КАК Организация,
		|	Акт.Контрагент КАК Контрагент,
		|	Акт.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	Акт.ДатаНачала КАК ДатаНачала,
		|	Акт.ДатаОкончания КАК ДатаОкончания,
		|	Акт.ВалютаДокумента КАК ВалютаДокумента,
		|	Акт.ОстатокНаНачало КАК ОстатокНаНачало,
		|	Акт.ПредставительОрганизации КАК ПредставительОрганизации
		|ИЗ
		|	Документ.АктСверкиВзаиморасчетов КАК Акт
		|ГДЕ
		|	Акт.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаАкт);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Реквизиты = Новый Структура;
	Для Каждого Колонка Из Выборка.Владелец().Колонки Цикл
		Реквизиты.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
	КонецЦикла;

	Возврат Реквизиты;

КонецФункции

// Заполняет сторону документооборота из справочника Организации либо Контрагенты.
//
// ФИО предпринимателя в УТ 10.3 отдельными реквизитами НЕ хранятся - в карточке
// одна строка наименования вида "Антипина Любовь Дмитриевна ИП кр. опт(Бастракова)".
// Разбирать её на Фамилию/Имя/Отчество нельзя: там и форма собственности, и пометки
// менеджера. - ФИО берём из свойств ЭДО_КонтрагентФамилия/Имя/Отчество, которые ведёт
// расширение; если не заполнены - это в НеполныеДанные, а не в догадки.
Процедура ЗаполнитьУчастника(Участник, Объект, ЭтоОрганизация, Неполные)

	Если Не ЗначениеЗаполнено(Объект) Тогда
		Неполные.Добавить(?(ЭтоОрганизация, "не указана организация", "не указан контрагент"));
		Возврат;
	КонецЕсли;

	Роль = ?(ЭтоОрганизация, "организации", "контрагента");

	Участник.НаимОрг = СокрЛП(?(ЗначениеЗаполнено(Объект.НаименованиеПолное),
		Объект.НаименованиеПолное, Объект.Наименование));
	Участник.ИНН  = ОчиститьЦифры(Объект.ИНН);
	Участник.КПП  = СокрЛП(Объект.КПП);
	Участник.ОКПО = СокрЛП(Объект.КодПоОКПО);

	// Вид стороны определяем по длине ИНН, а не по реквизиту ЮрФизЛицо: в карточках
	// он проставлен не всегда, а длина ИНН у ИП и физлица всегда 12, у юрлица - 10.
	Если СтрДлина(Участник.ИНН) = 12 Тогда

		Участник.Вид    = "ИП";
		Участник.ОГРНИП = ОчиститьЦифры(Объект.ОГРН);

		Если ЭтоОрганизация Тогда
			Участник.Фамилия  = ЗначениеСвойства(Объект, "ЭДО_ПодписантФамилия");
			Участник.Имя      = ЗначениеСвойства(Объект, "ЭДО_ПодписантИмя");
			Участник.Отчество = ЗначениеСвойства(Объект, "ЭДО_ПодписантОтчество");
		Иначе
			Участник.Фамилия  = ЗначениеСвойства(Объект, "ЭДО_КонтрагентФамилия");
			Участник.Имя      = ЗначениеСвойства(Объект, "ЭДО_КонтрагентИмя");
			Участник.Отчество = ЗначениеСвойства(Объект, "ЭДО_КонтрагентОтчество");
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Участник.Фамилия) Или Не ЗначениеЗаполнено(Участник.Имя) Тогда
			Неполные.Добавить("не заполнены ФИО " + Роль + " (ИП): наименование карточки для формата не годится");
		КонецЕсли;

	Иначе

		Участник.Вид  = "ЮЛ";
		Участник.ОГРН = ОчиститьЦифры(Объект.ОГРН);

	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьПодписанта(Подписант, Реквизиты, Неполные)

	Организация = Реквизиты.Организация;

	Подписант.Фамилия  = ЗначениеСвойства(Организация, "ЭДО_ПодписантФамилия");
	Подписант.Имя      = ЗначениеСвойства(Организация, "ЭДО_ПодписантИмя");
	Подписант.Отчество = ЗначениеСвойства(Организация, "ЭДО_ПодписантОтчество");

	// Представитель организации из самого документа - запасной источник: реквизит
	// заполняют не всегда, а подписант ЭДО задаётся настройкой и совпадает с владельцем КЭП.
	Если Не ЗначениеЗаполнено(Подписант.Фамилия) И ЗначениеЗаполнено(Реквизиты.ПредставительОрганизации) Тогда
		Части = СтрРазделить(СокрЛП(Строка(Реквизиты.ПредставительОрганизации)), " ", Ложь);
		Если Части.Количество() > 0 Тогда Подписант.Фамилия  = Части[0]; КонецЕсли;
		Если Части.Количество() > 1 Тогда Подписант.Имя      = Части[1]; КонецЕсли;
		Если Части.Количество() > 2 Тогда Подписант.Отчество = Части[2]; КонецЕсли;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Подписант.Фамилия) Тогда
		Неполные.Добавить("не заполнены ФИО подписанта");
	КонецЕсли;

КонецПроцедуры

// Раскладывает строки "по данным организации" в иерархию формата: договор документ операция.
//
// Схема требует именно такую вложенность, а в акте УТ 10.3 договор у строки часто пуст
// (сверка идёт по контрагенту целиком) - такие строки собираем в ОДИН договор без реквизитов.
Процедура ЗаполнитьТаблицу(Акт, СсылкаНаАкт, Реквизиты)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Строки.НомерСтроки КАК НомерСтроки,
		|	Строки.Дата КАК Дата,
		|	Строки.ДоговорКонтрагента КАК Договор,
		|	Строки.ДокументРегистратор КАК Регистратор,
		|	Строки.Представление КАК Представление,
		|	Строки.Дебет КАК Дебет,
		|	Строки.Кредит КАК Кредит
		|ИЗ
		|	Документ.АктСверкиВзаиморасчетов.ПоДаннымОрганизации КАК Строки
		|ГДЕ
		|	Строки.Ссылка = &Ссылка
		|УПОРЯДОЧИТЬ ПО
		|	Строки.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаАкт);
	Выборка = Запрос.Выполнить().Выбрать();

	ДоговорыПоКлючу = Новый Соответствие;

	Пока Выборка.Следующий() Цикл

		КлючДоговора = ?(ЗначениеЗаполнено(Выборка.Договор), Строка(Выборка.Договор), "");
		Договор = ДоговорыПоКлючу[КлючДоговора];

		Если Договор = Неопределено Тогда
			Договор = ЭДО_ФорматАктСверки.НовыйДоговор();
			Если ЗначениеЗаполнено(Выборка.Договор) Тогда
				Договор.ИдДог      = Строка(Выборка.Договор.УникальныйИдентификатор());
				Договор.НомДог     = СокрЛП(Выборка.Договор.Номер);
				Договор.ДатаДог    = НачалоДня(Выборка.Договор.Дата);
				Договор.ОписТипДог = СокрЛП(Строка(Выборка.Договор.ВидДоговора));
			КонецЕсли;
			Договор.Вставить("ДокументыПоКлючу", Новый Соответствие);
			ДоговорыПоКлючу.Вставить(КлючДоговора, Договор);
			Акт.Договоры.Добавить(Договор);
		КонецЕсли;

		КлючДокумента = ?(ЗначениеЗаполнено(Выборка.Регистратор), Строка(Выборка.Регистратор), "б/н " + Формат(Выборка.Дата, "ДФ=yyyyMMdd"));
		ДокументРасчетов = Договор.ДокументыПоКлючу[КлючДокумента];

		Если ДокументРасчетов = Неопределено Тогда
			ДокументРасчетов = ЭДО_ФорматАктСверки.НовыйДокументРасчетов();
			ЗаполнитьДокументРасчетов(ДокументРасчетов, Выборка);
			Договор.ДокументыПоКлючу.Вставить(КлючДокумента, ДокументРасчетов);
			Договор.Документы.Добавить(ДокументРасчетов);
		КонецЕсли;

		Операция = ЭДО_ФорматАктСверки.НоваяОперация();
		Операция.НомСтр    = Выборка.НомерСтроки;
		Операция.ДатаОпер  = НачалоДня(Выборка.Дата);
		Операция.НаимОпер  = ?(ЗначениеЗаполнено(Выборка.Представление),
			СокрЛП(Выборка.Представление), ДокументРасчетов.НаимДок);
		Операция.СумДебет  = Выборка.Дебет;
		Операция.СумКредит = Выборка.Кредит;
		ДокументРасчетов.Операции.Добавить(Операция);

	КонецЦикла;

	// Служебный ключ в XML не уедет, но и держать его в структуре после сборки незачем.
	Для Каждого Договор Из Акт.Договоры Цикл
		Договор.Удалить("ДокументыПоКлючу");
	КонецЦикла;

	РазложитьНачальноеСальдо(Акт, Реквизиты.ОстатокНаНачало);

КонецПроцедуры

Процедура ЗаполнитьДокументРасчетов(ДокументРасчетов, Выборка)

	Если Не ЗначениеЗаполнено(Выборка.Регистратор) Тогда
 // Строка без документа-основания (ручная корректировка, ввод остатков без регистратора).
		ДокументРасчетов.НаимДок = "Расчёты с контрагентом";
		ДокументРасчетов.НомДок  = "б/н";
		ДокументРасчетов.ДатаДок = НачалоДня(Выборка.Дата);
		Возврат;
	КонецЕсли;

	ОписаниеТипа = Метаданные.НайтиПоТипу(ТипЗнч(Выборка.Регистратор));
	ДокументРасчетов.НаимДок = ?(ОписаниеТипа = Неопределено, "Документ расчётов", ОписаниеТипа.Синоним);

	Попытка
		ДокументРасчетов.НомДок  = СокрЛП(Выборка.Регистратор.Номер);
		ДокументРасчетов.ДатаДок = НачалоДня(Выборка.Регистратор.Дата);
	Исключение
		ДокументРасчетов.НомДок  = "б/н";
		ДокументРасчетов.ДатаДок = НачалоДня(Выборка.Дата);
	КонецПопытки;

	Если Не ЗначениеЗаполнено(ДокументРасчетов.НомДок) Тогда
		ДокументРасчетов.НомДок = "б/н";
	КонецЕсли;

	ДокументРасчетов.ИдДок = Строка(Выборка.Регистратор.УникальныйИдентификатор());

КонецПроцедуры

// Кладёт остаток на начало периода в таблицу акта.
//
// Знак реквизита задаёт сторону: плюс - долг контрагента (дебет), минус - наш долг (кредит).
// Проверено на шести живых актах: ОстатокНаНачало + Дебет Кредит даёт остаток на конец.
//
// Разложить остаток ПО ДОГОВОРАМ база не даёт - он хранится один на документ. Поэтому
// целиком кладём его в первый договор: тогда сумма договорных показателей сходится с итогом
// акта, чего и ждёт принимающая сторона. При сверке по одному договору (обычный случай)
// это к тому же просто верно.
Процедура РазложитьНачальноеСальдо(Акт, ОстатокНаНачало)

	Если Акт.Договоры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Итоги = Акт.Договоры[0].Итоги;
	Итоги.СальдоНачДеб = ?(ОстатокНаНачало > 0,  ОстатокНаНачало, 0);
	Итоги.СальдоНачКр  = ?(ОстатокНаНачало < 0, -ОстатокНаНачало, 0);

КонецПроцедуры

Функция ЗначениеСвойства(Объект, ИмяСвойства)

	Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(ИмяСвойства);
	Если Не ЗначениеЗаполнено(Свойство) Тогда
		Возврат "";
	КонецЕсли;

	Значение = ЭДО_Сервер.ЗначениеСвойстваОбъекта(Объект, Свойство);

	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));

КонецФункции

// Оставляет в строке только цифры: в карточках ИНН и ОГРН встречаются с пробелами
// и дефисами, а схема проверяет их шаблоном по цифрам.
Функция ОчиститьЦифры(Знач Значение)

	Результат = "";
	Строка = СокрЛП(Строка(Значение));

	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
